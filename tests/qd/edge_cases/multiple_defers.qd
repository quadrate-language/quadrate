struct Point {
	x:f64
	y:f64
}

fn main( -- ) {
	Point {
		x: 1.0
		y: 2.0
	} -> p1
	defer {
		"Defer p1" . nl
	}

	Point {
		x: 3.0
		y: 4.0
	} -> p2
	defer {
		"Defer p2" . nl
	}

	Point {
		x: 5.0
		y: 6.0
	} -> p3
	defer {
		"Defer p3" . nl
	}

	"Main work" . nl
	// Defers execute in reverse order at end of scope
}
