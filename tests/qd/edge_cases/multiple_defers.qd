struct Point {
  x:f64
  y:f64
}

fn main( -- ) {
  1.0 2.0 Point -> p1
  defer { "Defer p1" prints nl }

  3.0 4.0 Point -> p2
  defer { "Defer p2" prints nl }

  5.0 6.0 Point -> p3
  defer { "Defer p3" prints nl }

  "Main work" prints nl
  // Structs are automatically released at end of scope
}
