struct Point {
	x:f64
	y:f64
}

fn process_point( -- ) {
	Point {
		x = 1.0
		y = 2.0
	} -> p
	// Struct is auto-released at end of function
	0 5 1 for it {
		it 3 lt
		if {
			p @x print nl
		} else {
			p @y print nl
		}
	}
}

fn main( -- ) {
	0 10 1 for it {
		it 2 mod 0 eq
		if {
			process_point
		} else {
			"Odd" print nl
		}
	}
}
