// Test: Struct with many fields
struct LargeStruct {
	f1:f64
	f2:f64
	f3:f64
	f4:f64
	f5:f64
	f6:f64
	f7:f64
	f8:f64
	f9:f64
	f10:f64
	f11:f64
	f12:f64
	f13:f64
	f14:f64
	f15:f64
	f16:f64
	f17:f64
	f18:f64
	f19:f64
	f20:f64
}

fn main() {
	LargeStruct {
		f1 = 1.0
		f2 = 2.0
		f3 = 3.0
		f4 = 4.0
		f5 = 5.0
		f6 = 6.0
		f7 = 7.0
		f8 = 8.0
		f9 = 9.0
		f10 = 10.0
		f11 = 11.0
		f12 = 12.0
		f13 = 13.0
		f14 = 14.0
		f15 = 15.0
		f16 = 16.0
		f17 = 17.0
		f18 = 18.0
		f19 = 19.0
		f20 = 20.0
	} -> s

	s @f1 print nl
	s @f10 print nl
	s @f20 print nl
}
