// Test: null in struct pointer fields
struct Item {
	value:i64
	next:*Item
}

fn main() {
	// null as pointer field
	Item { value = 10 next = null } -> a
	a <<value print nl

	// Chain structs
	Item { value = 20 next = a } -> b
	b <<value print nl

	// Access through pointer field
	b <<next <<value print nl

	// Three-deep chain
	Item { value = 30 next = b } -> c
	c <<next <<next <<value print nl
}
