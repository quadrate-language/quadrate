// Test: null keyword as a value
fn main() {
	// null equals zero
	null 0 == if {
		"null equals zero" print nl
	}

	// null in local variable
	null -> p
	p 0 == if {
		"p is null" print nl
	}

	// null neq non-zero
	42 -> x
	x null neq if {
		"42 is not null" print nl
	}

	// null prints as 0
	null print nl
}
