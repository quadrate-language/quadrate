use math

fn main() {
	// Test basic trig functions with 0
	0.0 math::sin print nl
	// Should print nl = 0
	0.0 math::cos print nl
	// Should print nl = 1
	0.0 math::tan print nl
	// Should print nl = 0
	// Test with π/2 approximation (1.5708)
	1.5708 math::sin print nl
	// Should print nl: ~1
	1.5708 math::cos print nl
	// Should print nl: ~0
	// Test inverse trig functions
	0.0 math::asin print nl
	// Should print nl = 0
	1.0 math::acos print nl
	// Should print nl = 0
	0.0 math::atan print nl
	// Should print nl = 0
	// Test sin of 30 degrees (0.5236 radians)
	0.5236 math::sin print nl
	// Should print nl: ~0.5
}
