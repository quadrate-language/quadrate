// Test Vec3 math functions
use math

fn approx_eq(a:f64 b:f64 -- result:i64) {
	a b - math::abs 0.0001 <
}

fn main() {
	// Constructors
	"=== Vec3 Constructors ===" print nl
	math::vec3_zero -> z
	z <<x 0.0 approx_eq print nl                    // 1
	z <<y 0.0 approx_eq print nl                    // 1
	z <<z 0.0 approx_eq print nl                    // 1
	math::vec3_one -> o
	o <<x 1.0 approx_eq print nl                    // 1
	o <<y 1.0 approx_eq print nl                    // 1
	o <<z 1.0 approx_eq print nl                    // 1
	math::vec3_unit_x <<x 1.0 approx_eq print nl    // 1
	math::vec3_unit_y <<y 1.0 approx_eq print nl    // 1
	math::vec3_unit_z <<z 1.0 approx_eq print nl    // 1

	// Basic operations
	"=== Vec3 Basic Ops ===" print nl
	math::Vec3 { x = 1.0 y = 2.0 z = 3.0 } -> v1
	math::Vec3 { x = 4.0 y = 5.0 z = 6.0 } -> v2

	v2 v1 add -> sum
	sum <<x 5.0 approx_eq print nl                  // 1
	sum <<y 7.0 approx_eq print nl                  // 1
	sum <<z 9.0 approx_eq print nl                  // 1

	v2 v1 subtract -> diff                         // v2 - v1 = (4-1, 5-2, 6-3) = (3, 3, 3)
	diff <<x 3.0 approx_eq print nl                 // 1
	diff <<y 3.0 approx_eq print nl                 // 1
	diff <<z 3.0 approx_eq print nl                 // 1

	v1 2.0 scale -> scaled
	scaled <<x 2.0 approx_eq print nl               // 1
	scaled <<y 4.0 approx_eq print nl               // 1
	scaled <<z 6.0 approx_eq print nl               // 1

	// Dot and cross
	"=== Vec3 Dot/Cross ===" print nl
	v2 v1 dot 32.0 approx_eq print nl              // 1 (1*4 + 2*5 + 3*6 = 32)

	math::vec3_unit_x math::vec3_unit_y cross -> cross_xy
	cross_xy <<x 0.0 approx_eq print nl             // 1
	cross_xy <<y 0.0 approx_eq print nl             // 1
	cross_xy <<z 1.0 approx_eq print nl             // 1 (x cross y = z)

	// Length
	"=== Vec3 Length ===" print nl
	math::Vec3 { x = 2.0 y = 3.0 z = 6.0 } -> len_v
	len_v length 7.0 approx_eq print nl            // 1 (sqrt(4+9+36) = 7)
	len_v length_sq 49.0 approx_eq print nl        // 1

	// Normalize
	"=== Vec3 Normalize ===" print nl
	len_v normalize -> unit
	unit length 1.0 approx_eq print nl             // 1
	unit <<x 0.2857 approx_eq print nl              // 1 (2/7)
	unit <<y 0.4286 approx_eq print nl              // 1 (3/7)
	unit <<z 0.8571 approx_eq print nl              // 1 (6/7)

	// Neg
	"=== Vec3 Neg ===" print nl
	v1 neg -> neg_v
	neg_v <<x -1.0 approx_eq print nl               // 1
	neg_v <<y -2.0 approx_eq print nl               // 1
	neg_v <<z -3.0 approx_eq print nl               // 1

	// Lerp
	"=== Vec3 Lerp ===" print nl
	math::Vec3 { x = 0.0 y = 0.0 z = 0.0 } -> a
	math::Vec3 { x = 10.0 y = 20.0 z = 30.0 } -> b
	a b 0.5 lerp -> mid
	mid <<x 5.0 approx_eq print nl                  // 1
	mid <<y 10.0 approx_eq print nl                 // 1
	mid <<z 15.0 approx_eq print nl                 // 1

	// Distance
	"=== Vec3 Distance ===" print nl
	math::Vec3 { x = 0.0 y = 0.0 z = 0.0 } -> p1
	math::Vec3 { x = 2.0 y = 3.0 z = 6.0 } -> p2
	p2 p1 distance 7.0 approx_eq print nl          // 1

	// Angle between
	"=== Vec3 Angle Between ===" print nl
	math::vec3_unit_x math::vec3_unit_y angle_between math::Pi 2.0 / approx_eq print nl  // 1 (90°)
	math::vec3_unit_x math::vec3_unit_x angle_between 0.0 approx_eq print nl             // 1 (0°)

	// Reflect
	"=== Vec3 Reflect ===" print nl
	math::Vec3 { x = 1.0 y = -1.0 z = 0.0 } -> incident
	math::Vec3 { x = 0.0 y = 1.0 z = 0.0 } -> normal
	incident normal reflect -> reflected          // reflect incident around normal
	reflected <<x 1.0 approx_eq print nl            // 1
	reflected <<y 1.0 approx_eq print nl            // 1 (bounced up)

	"done" print nl
}
