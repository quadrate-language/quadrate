// Test Vec2 math functions
use math

fn approx_eq(a:f64 b:f64 -- result:i64) {
	-> b -> a
	a b - math::abs 0.0001 <
}

fn main() {
	// Constructors
	"=== Vec2 Constructors ===" print nl
	math::vec2_zero -> z
	z @x 0.0 approx_eq print nl                    // 1
	z @y 0.0 approx_eq print nl                    // 1
	math::vec2_one -> o
	o @x 1.0 approx_eq print nl                    // 1
	o @y 1.0 approx_eq print nl                    // 1

	// Basic operations
	"=== Vec2 Basic Ops ===" print nl
	math::Vec2 { x = 3.0 y = 4.0 } -> v1
	math::Vec2 { x = 1.0 y = 2.0 } -> v2

	v2 v1 add -> sum
	sum @x 4.0 approx_eq print nl                  // 1
	sum @y 6.0 approx_eq print nl                  // 1

	v1 v2 subtract -> diff                         // v1 - v2 = (3-1, 4-2) = (2, 2)
	diff @x 2.0 approx_eq print nl                 // 1
	diff @y 2.0 approx_eq print nl                 // 1

	v1 2.0 scale -> scaled
	scaled @x 6.0 approx_eq print nl               // 1
	scaled @y 8.0 approx_eq print nl               // 1

	// Dot product
	"=== Vec2 Dot ===" print nl
	v2 v1 dot 11.0 approx_eq print nl              // 1 (3*1 + 4*2 = 11)

	// Length
	"=== Vec2 Length ===" print nl
	v1 length 5.0 approx_eq print nl               // 1 (sqrt(9+16) = 5)
	v1 length_sq 25.0 approx_eq print nl           // 1 (9+16 = 25)

	// Normalize
	"=== Vec2 Normalize ===" print nl
	v1 normalize -> unit
	unit @x 0.6 approx_eq print nl                 // 1 (3/5 = 0.6)
	unit @y 0.8 approx_eq print nl                 // 1 (4/5 = 0.8)
	unit length 1.0 approx_eq print nl             // 1

	// Neg
	"=== Vec2 Neg ===" print nl
	v1 neg -> neg_v
	neg_v @x -3.0 approx_eq print nl               // 1
	neg_v @y -4.0 approx_eq print nl               // 1

	// Lerp
	"=== Vec2 Lerp ===" print nl
	math::Vec2 { x = 0.0 y = 0.0 } -> a
	math::Vec2 { x = 10.0 y = 20.0 } -> b
	a b 0.5 lerp -> mid
	mid @x 5.0 approx_eq print nl                  // 1
	mid @y 10.0 approx_eq print nl                 // 1

	// Distance
	"=== Vec2 Distance ===" print nl
	math::Vec2 { x = 0.0 y = 0.0 } -> p1
	math::Vec2 { x = 3.0 y = 4.0 } -> p2
	p2 p1 distance 5.0 approx_eq print nl          // 1

	// Angle
	"=== Vec2 Angle ===" print nl
	math::Vec2 { x = 1.0 y = 0.0 } angle 0.0 approx_eq print nl       // 1 (pointing right)
	math::Vec2 { x = 0.0 y = 1.0 } angle 1.5708 approx_eq print nl    // 1 (pointing up, π/2)
	math::Vec2 { x = 1.0 y = 1.0 } angle 0.7854 approx_eq print nl    // 1 (45°, π/4)

	// Rotate
	"=== Vec2 Rotate ===" print nl
	math::Vec2 { x = 1.0 y = 0.0 } -> right
	right math::Pi 2.0 / rotate -> up_rot           // rotate by 90°
	up_rot @x 0.0 approx_eq print nl               // 1
	up_rot @y 1.0 approx_eq print nl               // 1

	// Perpendicular
	"=== Vec2 Perpendicular ===" print nl
	math::Vec2 { x = 3.0 y = 4.0 } perpendicular -> perp
	perp @x -4.0 approx_eq print nl                // 1
	perp @y 3.0 approx_eq print nl                 // 1

	"done" print nl
}
