// Test round-trip conversions: format then parse should return original value
use strconv

fn main( -- ) {
	// Binary round-trips
	0 2 strconv::format_int 2 strconv::parse_int print nl
	1 2 strconv::format_int 2 strconv::parse_int print nl
	127 2 strconv::format_int 2 strconv::parse_int print nl
	255 2 strconv::format_int 2 strconv::parse_int print nl
	-128 2 strconv::format_int 2 strconv::parse_int print nl

	// Octal round-trips
	0 8 strconv::format_int 8 strconv::parse_int print nl
	7 8 strconv::format_int 8 strconv::parse_int print nl
	64 8 strconv::format_int 8 strconv::parse_int print nl
	511 8 strconv::format_int 8 strconv::parse_int print nl
	-64 8 strconv::format_int 8 strconv::parse_int print nl

	// Decimal round-trips
	0 10 strconv::format_int 10 strconv::parse_int print nl
	9 10 strconv::format_int 10 strconv::parse_int print nl
	999 10 strconv::format_int 10 strconv::parse_int print nl
	-999 10 strconv::format_int 10 strconv::parse_int print nl

	// Hex round-trips
	0 16 strconv::format_int 16 strconv::parse_int print nl
	15 16 strconv::format_int 16 strconv::parse_int print nl
	255 16 strconv::format_int 16 strconv::parse_int print nl
	4095 16 strconv::format_int 16 strconv::parse_int print nl
	-255 16 strconv::format_int 16 strconv::parse_int print nl

	// Base 36 round-trips
	0 36 strconv::format_int 36 strconv::parse_int print nl
	35 36 strconv::format_int 36 strconv::parse_int print nl
	1295 36 strconv::format_int 36 strconv::parse_int print nl
	-1295 36 strconv::format_int 36 strconv::parse_int print nl

	// Large numbers round-trip
	1000000 10 strconv::format_int 10 strconv::parse_int print nl
	-1000000 10 strconv::format_int 10 strconv::parse_int print nl
	65535 16 strconv::format_int 16 strconv::parse_int print nl
}
