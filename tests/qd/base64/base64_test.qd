// Test base64 encoding and decoding
use base64
use str

fn main( -- ) {
	// Test 1: Simple string "Hello"
	"Hello" base64::encode -> encoded1
	encoded1 . nl

	// Decode and verify
	encoded1 base64::decode -> decoded1
	decoded1 . nl

	// Test 2: "Hello World!"
	"Hello World!" base64::encode -> encoded2
	encoded2 . nl

	encoded2 base64::decode -> decoded2
	decoded2 . nl

	// Test 3: Single character "A"
	"A" base64::encode -> encoded3
	encoded3 . nl

	encoded3 base64::decode -> decoded3
	decoded3 . nl

	// Test 4: Two characters "AB"
	"AB" base64::encode -> encoded4
	encoded4 . nl

	encoded4 base64::decode -> decoded4
	decoded4 . nl

	// Test 5: Empty string
	"" base64::encode -> encoded5
	encoded5 str::len . nl  // Should be 0
}
