// Test programmatic error handling with error codes
use io
use str

fn main() {
	// Test 1: File not found returns ErrNotFound
	"/nonexistent/path/file.txt" io::Read io::open switch {
		Ok {
			-> f
			"FAIL: file should not exist" print nl
			f io::close
		}
		_ {
			err -> code -> msg
			code io::ErrNotFound == if {
				"err_not_found_ok" print nl
			} else {
				"FAIL: expected ErrNotFound, got " print code print nl
			}
		}
	}

	// Test 2: Permission error (try to write to root-owned directory)
	// Skip this test as it depends on system permissions

	// Test 3: Invalid seek on closed file
	"/tmp/test_error_codes.txt" "test data\n" io::write_file switch {
		Ok {
			// Now open and test seek on closed file
			"/tmp/test_error_codes.txt" io::Read io::open switch {
				Ok {
					-> f
					f io::close
					// f is now invalid, but we can't easily test this
					// Just verify we got here
					"file_ops_ok" print nl
				}
				_ {
					"FAIL: could not open test file" print nl
				}
			}
		}
		_ {
			err -> code -> msg
			"FAIL: could not write test file: " print msg print nl
		}
	}

	// Test 4: String error codes
	"hello" 100 str::char_at switch {
		Ok {
			-> ch
			"FAIL: should be out of bounds" print nl
		}
		_ {
			err -> code -> msg
			code str::ErrOutOfBounds == if {
				"str_out_of_bounds_ok" print nl
			} else {
				"FAIL: expected ErrOutOfBounds, got " print code print nl
			}
		}
	}

	// Test 5: Error message content
	"/another/nonexistent/file" io::Read io::open switch {
		Ok {
			-> f
			f io::close
		}
		_ {
			err -> code -> msg
			// Check that error message is non-empty
			msg str::len 0 > if {
				"err_msg_ok" print nl
			} else {
				"FAIL: error message empty" print nl
			}
		}
	}

	"all_tests_complete" print nl
}
