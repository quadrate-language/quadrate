// Test: basic
fn main() {
	// Test dup - duplicate top element
	5 dup print nl print nl
	// Should print nl = 5 5
	// Test swap - swap top 2 elements
	10 20 swap print nl print nl
	// Should print nl = 10 20
	// Test over - copy second element to top
	1 2 over print nl print nl print nl
	// Should print nl = 1 2 1
	// Test drop - remove top element
	10 20 30 drop print nl print nl
	// Should print nl = 20 10
	// Test rot - rotate top 3 elements
	1 2 3 rot print nl print nl print nl
	// Should print nl = 1 3 2
	// Test nip - remove second element
	100 200 nip print nl
	// Should print nl = 200
}
