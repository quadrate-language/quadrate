// Test swapd (swap second and third): ( a b c -- b a c )
fn main() {
	// Test with integers
	10 20 30 swapd
	// Stack = 20 10 30
	print nl   // 30
	print nl   // 10
	print nl   // 20

	// Test with different values
	100 200 300 swapd
	// Stack = 200 100 300
	print nl   // 300
	print nl   // 100
	print nl   // 200
}
