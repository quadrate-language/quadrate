// Test: overd (copy third to second position): ( a b c -- a b a c )
fn main() {
	// Test with integers
	10 20 30 overd
	// Stack = 10 20 10 30
	print nl   // 30
	print nl   // 10
	print nl   // 20
	print nl   // 10

	// Test with different values
	100 200 300 overd
	// Stack = 100 200 100 300
	print nl   // 300
	print nl   // 100
	print nl   // 200
	print nl   // 100
}
