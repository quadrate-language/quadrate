// Test: advanced
fn main() {
	// Test pick - copy the third value to the top: ( x y z -- x y z x )
	100 200 300 pick
	-> d -> c -> b -> a
	a print " " print b print " " print c print " " print d print nl
	// pick reads the three values below the top wherever they came from
	1 2 3 4 pick
	-> e -> d -> c -> b -> a
	a print " " print b print " " print c print " " print d print " " print e print nl
}
