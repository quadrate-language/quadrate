fn main() {
	// Test tuck - insert copy of top below second
	10 20 tuck
	prints
	clear
	// Test pick - copy nth element to top (0-indexed)
	100 200 300 400 2 pick
	// Copy element at index 2 (which is 200)
	prints
	clear
	// Test roll - move index n to top (0-based)
	10 20 30 40 3 roll
	// Move index 3 (10) to top: 20 30 40 10
	prints
}
