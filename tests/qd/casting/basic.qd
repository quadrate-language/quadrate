// Test: basic type casting operations
fn main() {
	// Test cast<i64> - cast float to int (truncates)
	3.14 cast<i64> print nl

	// Test cast<i64> - cast string to int
	"42" cast<i64> print nl

	// Test cast<i64> - negative float
	-5.9 cast<i64> print nl

	// Test cast<f64> - cast int to float
	10 cast<f64> print nl

	// Test cast<f64> - cast string to float
	"2.5" cast<f64> print nl

	// Test cast<f64> - negative int
	-7 cast<f64> print nl

	// Test cast<str> - cast int to string
	100 cast<str> print nl

	// Test cast<str> - cast float to string
	3.14159 cast<str> print nl

	// Test cast<str> - negative int
	-50 cast<str> print nl

	// Test chaining: int -> float -> string
	42 cast<f64> cast<str> print nl
}
