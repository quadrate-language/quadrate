// Test: `call ok if { ... }` with no else. The call leaves its result whichever way it went,
// so the `if` takes only the flag and the result is dropped after it.
def divide(a:i64 b:i64 -- result:i64)! {
	b 0 == if {
		"division by zero" -1 panic
	}
	a b /
}

fn try_all( -- success_count:i64) {
	0 -> count
	10 2 divide ok if {
		count ++ -> count
	} drop
	10 5 divide ok if {
		count ++ -> count
	} drop
	10 0 divide ok if {
		count ++ -> count
	} drop
	count
}

fn main() {
	try_all print nl
}
