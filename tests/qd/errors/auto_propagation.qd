// Test: error propagation patterns
// Shows the difference between ! (abort) and if/else (catch and propagate)

def validate(x:i64 -- result:i64)! {
	x 0 < if {
		"negative input" 1 panic
	}
	x 10 +
}

def transform(x:i64 -- result:i64)! {
	x 100 > if {
		"too large" 2 panic
	}
	x 2 *
}

// Chain with if/else - catches and re-panics to propagate errors
def pipeline(x:i64 -- result:i64)! {
	x validate ok if {
		transform ok if {
			// success - result on stack
		} else {
			"transform failed" 2 panic
		}
	} else {
		"validate failed" 1 panic
	}
}

fn main() {
	"=== Error propagation ===" print nl

	// Success: 5 -> 15 -> 30
	5 pipeline ok if {
		-> r
		"5 -> " print r print nl
	} else {
		drop
		"5 failed" print nl
	}

	// Fail in validate (negative)
	-5 pipeline ok if {
		drop
		"unexpected" print nl
	} else {
		drop
		"-5 caught (validate)" print nl
	}

	// Fail in transform (95 + 10 = 105 > 100)
	95 pipeline ok if {
		drop
		"unexpected" print nl
	} else {
		drop
		"95 caught (transform)" print nl
	}

	"done" print nl
}
