// Test: custom error messages and codes
fn divide(i64 i64 -- i64)! {
	dup 0 eq if {
		drop drop
		0  // Return dummy value before error
		"Division by zero" 100 panic
	} else {
		/
	}
}

fn main() {
	"Test 1: 10 / 2" print nl
	10 2 divide if {
		"Result: " print print nl
	} else {
		"Error" print nl
	}

	"Test 2: 10 / 0" print nl
	10 0 divide if {
		"Result: " print print nl
	} else {
		"Error (expected)" print nl
	}
}
