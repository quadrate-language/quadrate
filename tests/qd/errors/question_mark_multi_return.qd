// Test: ? with functions that have multiple return values
fn divmod(a:i64 b:i64 -- quot:i64 rem:i64)! {
	b 0 == if { "division by zero" 1 panic }
	a b / a b mod
}

fn compute(a:i64 b:i64 -- result:i64)! {
	a b divmod?
	-> rem -> quot
	quot 100 * rem +
}

fn main() {
	17 5 compute switch {
		Ok { "17/5 -> " print print nl }
		_ { "compute failed" print nl }
	}
	10 0 compute switch {
		Ok { "10/0 -> " print print nl }
		_ { "compute div by zero" print nl }
	}
}
