// Test: a status of 0 is Ok, so a `panic` carrying code 0 would read as a success to every
// caller that tests it. A literal 0 is rejected when compiling (compile_errors/
// panic_code_zero_literal); a code that only turns out to be 0 at run time stops the program.
def panics_with(code:i64 -- v:i64)! {
	"boom" code panic
	99
}

fn main() {
	5 5 - panics_with switch {
		Ok { "WRONG: read as success" print nl drop }
		_ { drop "WRONG: read as a failure" print nl }
	}
}
