// Test: with multiple outputs
fn add_and_sub(i64 i64 -- i64 i64)! {
	swap dup rot dup rot add rot rot sub
}

fn divide_and_double(i64 i64 -- i64 i64)! {
	dup 0 > if {
		/ dup 2 mul
	} else {
		drop drop
		0 0
		"Error occurred" 1 panic
	}
}

fn main() {
	"5 add_and_sub 3:" print nl
	5 3 add_and_sub if {
		"  Difference: " print print nl
		"  Sum: " print print nl
	} else {
		"  Error" print nl
	}

	"20 divide_and_double 4:" print nl
	20 4 divide_and_double if {
		"  Doubled: " print print nl
		"  Quotient: " print print nl
	} else {
		"  Error" print nl
	}

	"10 divide_and_double 0:" print nl
	10 0 divide_and_double if {
		"  Doubled: " print print nl
		"  Quotient: " print print nl
	} else {
		"  Error (expected)" print nl
	}
}
