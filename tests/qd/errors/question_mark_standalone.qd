// Test: ? as standalone token (space before ?) - same as func?
fn might_fail(x:i64 -- result:i64)! {
	x 0 < if { "negative" 1 panic }
	x 10 +
}

fn wrapper(x:i64 -- result:i64)! {
	x might_fail ?
	3 *
}

fn main() {
	5 wrapper switch {
		Ok { "5 -> " print print nl }
		_ { "failed" print nl }
	}
	-1 wrapper switch {
		Ok { "-1 -> " print print nl }
		_ { "error propagated" print nl }
	}
}
