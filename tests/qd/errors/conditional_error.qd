fn process(i64 i64 -- i64)! {
	dup 0 > if {
		add
	} else {
		drop drop
		-1
		"Error occurred" 1 panic
	}
}

fn main() {
	"5 + 3 = " print
	5 3 process if {
		print nl
	} else {
		"Error" print nl
	}

	"10 + 0 = " print
	10 0 process if {
		print nl
	} else {
		drop "Error (b was zero)" print nl
	}

	"7 + 2 = " print
	7 2 process if {
		print nl
	} else {
		"Error" print nl
	}
}
