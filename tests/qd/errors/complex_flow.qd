// Test: complex flow
fn parse_number(i64 -- i64)! {
	dup 0 < if {
		0
		"Error occurred" 1 panic
	}
}

fn validate_range(i64 -- i64)! {
	dup 100 > if {
		0
		"Error occurred" 1 panic
	}
}

fn compute(i64 -- i64)! {
	dup 50 > if {
		10 +
	} else {
		5 +
	}
}

fn main() {
	"Input: 30" print nl
	30 parse_number ok if {
		validate_range ok if {
			compute ok if {
				"Result: " print print nl
			} else {
				drop
				"Compute failed" print nl
			}
		} else {
			drop
			"Range validation failed" print nl
		}
	} else {
		drop
		"Parse failed" print nl
	}

	"Input: -5" print nl
	-5 parse_number ok if {
		validate_range ok if {
			compute ok if {
				"Result: " print print nl
			} else {
				drop
				"Compute failed" print nl
			}
		} else {
			drop
			"Range validation failed" print nl
		}
	} else {
		drop
		"Parse failed" print nl
	}

	"Input: 150" print nl
	150 parse_number ok if {
		validate_range ok if {
			compute ok if {
				"Result: " print print nl
			} else {
				drop
				"Compute failed" print nl
			}
		} else {
			drop
			"Range validation failed" print nl
		}
	} else {
		drop
		"Parse failed" print nl
	}

	"Input: 60" print nl
	60 parse_number ok if {
		validate_range ok if {
			compute ok if {
				"Result: " print print nl
			} else {
				drop
				"Compute failed" print nl
			}
		} else {
			drop
			"Range validation failed" print nl
		}
	} else {
		drop
		"Parse failed" print nl
	}
}
