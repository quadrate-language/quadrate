fn parse_number(a:i64 -- result:i64)! {
	dup 0 < if {
		0
		"Error occurred" 1 panic
	}
}

fn validate_range(a:i64 -- result:i64)! {
	dup 100 > if {
		0
		"Error occurred" 1 panic
	}
}

fn compute(a:i64 -- result:i64)! {
	dup 50 > if {
		10 add
	} else {
		5 add
	}
}

fn main() {
	"Input: 30" print nl
	30 parse_number if {
		validate_range if {
			compute if {
				"Result: " print print nl
			} else {
				"Compute failed" print nl
			}
		} else {
			"Range validation failed" print nl
		}
	} else {
		"Parse failed" print nl
	}

	"Input: -5" print nl
	-5 parse_number if {
		validate_range if {
			compute if {
				"Result: " print print nl
			} else {
				"Compute failed" print nl
			}
		} else {
			"Range validation failed" print nl
		}
	} else {
		"Parse failed" print nl
	}

	"Input: 150" print nl
	150 parse_number if {
		validate_range if {
			compute if {
				"Result: " print print nl
			} else {
				"Compute failed" print nl
			}
		} else {
			"Range validation failed" print nl
		}
	} else {
		"Parse failed" print nl
	}

	"Input: 60" print nl
	60 parse_number if {
		validate_range if {
			compute if {
				"Result: " print print nl
			} else {
				"Compute failed" print nl
			}
		} else {
			"Range validation failed" print nl
		}
	} else {
		"Parse failed" print nl
	}
}
