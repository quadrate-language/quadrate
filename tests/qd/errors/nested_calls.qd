// Test: nested calls
fn validate(i64 -- i64)! {
	dup 0 < if {
		0
		"Error occurred" 1 panic
	}
}

fn process(i64 -- i64)! {
	validate ok if {
		2 *
	} else {
		-1
		"Error occurred" 1 panic
	}
}

fn main() {
	"Processing 5: " print
	5 process ok if {
		print nl
	} else {
		drop
		"Failed" print nl
	}

	"Processing -3: " print
	-3 process ok if {
		print nl
	} else {
		drop
		"Failed" print nl
	}

	"Processing 10: " print
	10 process ok if {
		print nl
	} else {
		drop
		"Failed" print nl
	}
}
