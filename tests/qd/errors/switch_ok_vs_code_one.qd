// Test: in a switch after a fallible call, `Ok` (0) is the success arm and a literal `1` is the
// error-code arm. Every arm starts with the call's result; on failure it is a zero
// placeholder, which the failure arms drop.
def fails_with(code:i64 -- v:i64)! {
	code 0 != if {
		"boom" code panic
	}
	99
}

fn main() {
	1 fails_with switch {
		Ok { "ok " print print nl }
		1 { drop "code 1" print nl }
		_ { drop "other" print nl }
	}
	0 fails_with switch {
		Ok { "ok " print print nl }
		1 { drop "code 1" print nl }
		_ { drop "other" print nl }
	}
}
