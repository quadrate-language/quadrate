// Test: error propagation through multiple function calls
def step1(val:i64 -- result:i64)! {
	val 0 < if {
		0 "step1: negative input" 1 panic
	}
	val 10 +
}

def step2(val:i64 -- result:i64)! {
	val 100 > if {
		0 "step2: too large" 1 panic
	}
	val 2 *
}

def step3(val:i64 -- result:i64)! {
	val 50 % 0 == if {
		0 "step3: divisible by 50" 1 panic
	}
	val 1 +
}

def pipeline(val:i64 -- result:i64)! {
	val step1 ok if {
		step2 ok if {
			step3 ok if {
				// success
			} else {
				0 "pipeline: step3 failed" 1 panic
			}
		} else {
			0 "pipeline: step2 failed" 1 panic
		}
	} else {
		0 "pipeline: step1 failed" 1 panic
	}
}

fn main() {
	// Test successful pipeline
	"=== Pipeline tests ===" print nl
	5 pipeline ok if {
		"5 -> " print print nl
	} else {
		drop
		"5 failed" print nl
	}

	// Test step1 failure (negative)
	-5 pipeline ok if {
		"-5 -> " print print nl
	} else {
		drop
		"-5 failed (step1)" print nl
	}

	// Test step2 failure (too large after step1)
	95 pipeline ok if {
		"95 -> " print print nl
	} else {
		drop
		"95 failed (step2)" print nl
	}

	// Test step3 failure (divisible by 50)
	15 pipeline ok if {
		"15 -> " print print nl
	} else {
		drop
		"15 failed (step3)" print nl
	}

	"done" print nl
}
