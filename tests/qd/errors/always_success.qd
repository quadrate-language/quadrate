fn always_ok(a:i64 -- result:i64)! {
	dup
}

fn main() {
	"Test 1: " print
	42 always_ok if {
		print nl
	} else {
		drop "Failed" print nl
	}

	"Test 2: " print
	0 always_ok if {
		print nl
	} else {
		drop "Failed" print nl
	}

	"Test 3: " print
	-5 always_ok if {
		print nl
	} else {
		drop "Failed" print nl
	}
}
