fn validate_positive(a:i64 -- result:i64)! {
	dup 0 > if {
		dup
	} else {
		0
		"Error occurred" 1 panic
	}
}

fn double_value(a:i64 -- result:i64)! {
	2 mul
}

fn main() {
	"Test 1: 5 validated and doubled = " print
	5 validate_positive if {
		double_value if {
			print nl
		} else {
			"Double failed" print nl
		}
	} else {
		"Validation failed" print nl
	}

	"Test 2: -3 validated and doubled = " print
	-3 validate_positive if {
		double_value if {
			print nl
		} else {
			"Double failed" print nl
		}
	} else {
		"Validation failed" print nl
	}
}
