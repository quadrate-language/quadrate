// Test: basic ? operator for error propagation
fn might_fail(x:i64 -- result:i64)! {
	-> x
	x 0 < if { "negative input" 1 panic }
	x 10 +
}

fn wrapper(x:i64 -- result:i64)! {
	-> x
	x might_fail?
}

fn main() {
	// Success path
	5 wrapper switch {
		Ok { "5 -> " print print nl }
		_ { err -> c -> m "error: " print m print nl }
	}
	// Error path
	-3 wrapper switch {
		Ok { "-3 -> " print print nl }
		_ { err -> c -> m "error: " print m print nl }
	}
}
