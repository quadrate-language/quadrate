use ct

fn main() {
	// ====== Box<T> Tests ======
	"=== Box<i64> ===" print nl
	42 ct::box -> b1
	b1 unwrap print nl  // 42

	// Box with another integer
	"=== Box<i64> 2 ===" print nl
	314 ct::box -> b2
	b2 unwrap print nl  // 314

	// Box map
	"=== Box map ===" print nl
	10 ct::box -> b3
	fn (x:i64 -- y:i64) { 2 * } b3 map -> b4
	b4 unwrap print nl  // 20

	// ====== Pair<T, U> Tests ======
	"=== Pair<i64, i64> ===" print nl
	100 200 ct::pair -> p1
	p1 fst print nl  // 100
	p1 snd print nl  // 200

	// Pair unpack
	"=== Pair unpack ===" print nl
	p1 unpack -> y -> x
	x print nl  // 100
	y print nl  // 200

	// Pair swap
	"=== Pair swap ===" print nl
	p1 swap_pair -> p2
	p2 fst print nl  // 200
	p2 snd print nl  // 100

	// Pair with different integers
	"=== Pair<i64, i64> 2 ===" print nl
	15 999 ct::pair -> p3
	p3 fst print nl  // 15
	p3 snd print nl  // 999

	// Pair map_both
	"=== Pair map_both ===" print nl
	5 10 ct::pair -> p4
	fn (x:i64 -- y:i64) { 3 * } p4 map_both -> p5
	p5 fst print nl  // 15
	p5 snd print nl  // 30

	// ====== Option<T> Tests ======
	"=== Option<i64> some ===" print nl
	77 ct::some -> opt1
	opt1 is_some print nl  // 1
	opt1 is_none print nl  // 0
	0 opt1 unwrap_or print nl  // 77

	"=== Option<i64> none ===" print nl
	ct::none -> opt2
	opt2 is_some print nl  // 0
	opt2 is_none print nl  // 1
	-999 opt2 unwrap_or print nl  // -999

	// Option map_opt
	"=== Option map_opt ===" print nl
	50 ct::some -> opt3
	fn (x:i64 -- y:i64) { 2 + } opt3 map_opt -> opt4
	0 opt4 unwrap_or print nl  // 52

	// Option map_opt on none
	"=== Option map_opt none ===" print nl
	ct::none -> opt5
	fn (x:i64 -- y:i64) { 100 + } opt5 map_opt -> opt6
	-1 opt6 unwrap_or print nl  // -1 (unchanged because none)

	// Multiple method calls on single type
	"=== Method chaining ===" print nl
	10 20 ct::pair swap_pair swap_pair -> p6
	p6 fst print nl  // 10 (swapped twice = original)
	p6 snd print nl  // 20

	"=== Done ===" print nl
}
