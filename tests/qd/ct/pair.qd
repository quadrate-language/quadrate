use ct

fn main() {
	// Test Box
	42 ct::box -> b
	b unwrap print nl

	// Test Pair creation
	10 20 ct::pair -> p

	// Access elements
	p first print nl
	p second print nl

	// Unpack
	p unpack -> y -> x
	x print nl
	y print nl

	// Test Option - Some
	100 ct::some -> opt_some
	opt_some is_some print nl
	opt_some is_none print nl
	0 opt_some unwrap_or print nl

	// Test Option - None
	ct::none -> opt_none
	opt_none is_some print nl
	opt_none is_none print nl
	-1 opt_none unwrap_or print nl
}
