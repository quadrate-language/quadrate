use ct

fn main() {
	// Test that the hashmap grows when load factor exceeds 70%
	// Initial capacity is 8, so we need 6+ entries to trigger growth
	HashMap<i64> { keys = 0 values = 0 states = 0 len = 0 cap = 0 } -> m

	// Insert 10 entries to force growth
	m "k1" 1 insert! -> m
	m "k2" 2 insert! -> m
	m "k3" 3 insert! -> m
	m "k4" 4 insert! -> m
	m "k5" 5 insert! -> m
	m "k6" 6 insert! -> m
	"after 6 inserts: len=" print m length print " cap=" print m @cap print nl

	m "k7" 7 insert! -> m
	m "k8" 8 insert! -> m
	m "k9" 9 insert! -> m
	m "k10" 10 insert! -> m
	"after 10 inserts: len=" print m length print " cap=" print m @cap print nl

	// Verify all values still accessible after growth
	"k1: " print m "k1" get! print nl
	"k5: " print m "k5" get! print nl
	"k10: " print m "k10" get! print nl

	// Verify has still works
	m "k1" has if { "has k1: yes" print nl }
	m "k10" has if { "has k10: yes" print nl }
	m "missing" has if { "has missing: yes" print nl } else { "has missing: no" print nl }

	m release
	"done" print nl
}
