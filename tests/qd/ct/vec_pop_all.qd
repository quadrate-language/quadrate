// Test Vec<T> pop until empty
use ct

fn main() {
	Vec<i64> { data = 0 len = 0 cap = 0 } -> v

	// Push 5 elements
	v 10 push! -> v
	v 20 push! -> v
	v 30 push! -> v
	v 40 push! -> v
	v 50 push! -> v

	// Pop all elements and verify values
	v pop! -> v -> a
	a 50 == if { "pop1_ok" print nl }

	v pop! -> v -> b
	b 40 == if { "pop2_ok" print nl }

	v pop! -> v -> c
	c 30 == if { "pop3_ok" print nl }

	v pop! -> v -> d
	d 20 == if { "pop4_ok" print nl }

	v pop! -> v -> e
	e 10 == if { "pop5_ok" print nl }

	// Verify empty
	v is_empty if { "empty_ok" print nl }

	v release
	"done" print nl
}
