// Mutating a struct global via `>>!` writes through to the underlying
// heap struct. Subsequent reads see the new values. This is the main
// reason to use `var` rather than `const` for structs.

struct Counter {
	value:i64
}

var tally = Counter { value = 0 }

fn bump() {
	tally tally <<value 1 + >>value!
}

fn main() {
	tally <<value print nl      // 0

	bump bump bump
	tally <<value print nl      // 3

	// Direct mutation from main.
	tally 42 >>value!
	tally <<value print nl      // 42

	// Reassign the whole struct with a fresh instance.
	Counter { value = 999 } -> tally
	tally <<value print nl      // 999
}
