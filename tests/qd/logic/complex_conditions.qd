// Test: complex logical conditions
fn main() {
	// Test: (true AND true) OR false = true
	1 1 and 0 or print nl

	// Test: (false OR true) AND true = true
	0 1 or 1 and print nl

	// Test: NOT (true AND false) = -1 (bitwise NOT of 0; truthy)
	1 0 and not print nl

	// Test: (true OR false) AND (false OR true) = true
	1 0 or 0 1 or and print nl

	// Test: NOT (false OR false) = -1 (bitwise NOT of 0; truthy)
	0 0 or not print nl

	// Test: (10 > 5) AND (3 < 7) = true
	10 5 gt 3 7 lt and print nl

	// Test: (10 == 10) OR (5 > 10) = true
	10 10 eq 5 10 gt or print nl

	// Test: (5 < 3) AND (10 == 10) = false
	5 3 lt 10 10 eq and print nl
}
