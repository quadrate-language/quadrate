use rand

fn main() {
	// Test range function produces values in [min, max)
	777 rand::with_seed -> rng
	1 -> all_valid

	// Generate values in range [10, 20)
	0 10 1 for it {
		rng 10 20 rand::range -> rng -> n
		n 10 < if {
			0 -> all_valid
		}
		n 20 >= if {
			0 -> all_valid
		}
	}

	all_valid if {
		"PASS: All values in range [10, 20)"
	} else {
		"FAIL: Value out of range"
	}
	. nl

	// Test negative range
	888 rand::with_seed -> rng2
	1 -> neg_valid
	0 10 1 for it {
		rng2 -50 -40 rand::range -> rng2 -> m
		m -50 < if {
			0 -> neg_valid
		}
		m -40 >= if {
			0 -> neg_valid
		}
	}

	neg_valid if {
		"PASS: All values in range [-50, -40)"
	} else {
		"FAIL: Value out of negative range"
	}
	. nl
}
