// sort test
use strings
use sort
use testing

// --- sort::ints ---

test "sort::ints ascending" {
	[5 2 8 1 9] -> arr

	arr sort::ints

	arr 0 nth 1 testing::assert_eq
	arr 1 nth 2 testing::assert_eq
	arr 2 nth 5 testing::assert_eq
	arr 3 nth 8 testing::assert_eq
	arr 4 nth 9 testing::assert_eq

	arr free
}

test "sort::ints already sorted" {
	[1 2 3] -> arr

	arr sort::ints

	arr 0 nth 1 testing::assert_eq
	arr 1 nth 2 testing::assert_eq
	arr 2 nth 3 testing::assert_eq

	arr free
}

test "sort::ints reverse sorted" {
	[4 3 2 1] -> arr

	arr sort::ints

	arr 0 nth 1 testing::assert_eq
	arr 1 nth 2 testing::assert_eq
	arr 2 nth 3 testing::assert_eq
	arr 3 nth 4 testing::assert_eq

	arr free
}

test "sort::ints single element" {
	[42] -> arr

	arr sort::ints

	arr 0 nth 42 testing::assert_eq

	arr free
}

test "sort::ints with duplicates" {
	[3 1 3 2 1] -> arr

	arr sort::ints

	arr 0 nth 1 testing::assert_eq
	arr 1 nth 1 testing::assert_eq
	arr 2 nth 2 testing::assert_eq
	arr 3 nth 3 testing::assert_eq
	arr 4 nth 3 testing::assert_eq

	arr free
}

test "sort::ints with negatives" {
	[-5 3 -1 0] -> arr

	arr sort::ints

	arr 0 nth -5 testing::assert_eq
	arr 1 nth -1 testing::assert_eq
	arr 2 nth 0 testing::assert_eq
	arr 3 nth 3 testing::assert_eq

	arr free
}

test "sort::ints all same value" {
	[7 7 7] -> arr

	arr sort::ints

	arr 0 nth 7 testing::assert_eq
	arr 1 nth 7 testing::assert_eq
	arr 2 nth 7 testing::assert_eq

	arr free
}

// --- sort::ints_desc ---

test "sort::ints_desc descending" {
	[5 2 8 1 9] -> arr

	arr sort::ints_desc

	arr 0 nth 9 testing::assert_eq
	arr 1 nth 8 testing::assert_eq
	arr 2 nth 5 testing::assert_eq
	arr 3 nth 2 testing::assert_eq
	arr 4 nth 1 testing::assert_eq

	arr free
}

test "sort::ints_desc with negatives" {
	[-5 3 -1 0] -> arr

	arr sort::ints_desc

	arr 0 nth 3 testing::assert_eq
	arr 1 nth 0 testing::assert_eq
	arr 2 nth -1 testing::assert_eq
	arr 3 nth -5 testing::assert_eq

	arr free
}

// --- sort::min ---

test "sort::min" {
	[5 2 8] -> arr

	arr sort::min 2 testing::assert_eq

	arr free
}

test "sort::min with negatives" {
	[3 -10 5 -2] -> arr

	arr sort::min -10 testing::assert_eq

	arr free
}

test "sort::min single element" {
	[42] -> arr

	arr sort::min 42 testing::assert_eq

	arr free
}

test "sort::min first element is min" {
	[1 5 3] -> arr

	arr sort::min 1 testing::assert_eq

	arr free
}

test "sort::min last element is min" {
	[5 3 1] -> arr

	arr sort::min 1 testing::assert_eq

	arr free
}

// --- sort::max ---

test "sort::max" {
	[5 2 8] -> arr

	arr sort::max 8 testing::assert_eq

	arr free
}

test "sort::max with negatives" {
	[-5 -2 -8] -> arr

	arr sort::max -2 testing::assert_eq

	arr free
}

// --- sort::search ---

test "sort::search finds element" {
	[1 2 5 8 9] -> arr

	arr 5 sort::search 2 testing::assert_eq
	arr 1 sort::search 0 testing::assert_eq
	arr 9 sort::search 4 testing::assert_eq

	arr free
}

test "sort::search not found" {
	[1 2 5 8 9] -> arr

	arr 3 sort::search -1 testing::assert_eq
	arr 0 sort::search -1 testing::assert_eq
	arr 10 sort::search -1 testing::assert_eq

	arr free
}

test "sort::search single element found" {
	[42] -> arr

	arr 42 sort::search 0 testing::assert_eq

	arr free
}

test "sort::search single element not found" {
	[42] -> arr

	arr 99 sort::search -1 testing::assert_eq

	arr free
}

// --- sort::is_sorted ---

test "sort::is_sorted true" {
	[1 2 3] -> arr

	arr sort::is_sorted testing::assert_true

	arr free
}

test "sort::is_sorted false" {
	[3 1 2] -> arr

	arr sort::is_sorted testing::assert_false

	arr free
}

test "sort::is_sorted single element" {
	[42] -> arr

	arr sort::is_sorted testing::assert_true

	arr free
}

test "sort::is_sorted with equal elements" {
	[5 5 5] -> arr

	arr sort::is_sorted testing::assert_true

	arr free
}

test "sort::is_sorted after sort" {
	[9 1 5 3] -> arr

	arr sort::is_sorted testing::assert_false
	arr sort::ints
	arr sort::is_sorted testing::assert_true

	arr free
}

// --- sort::reverse ---

test "sort::reverse" {
	[1 2 3 4] -> arr

	arr sort::reverse

	arr 0 nth 4 testing::assert_eq
	arr 1 nth 3 testing::assert_eq
	arr 2 nth 2 testing::assert_eq
	arr 3 nth 1 testing::assert_eq

	arr free
}

test "sort::reverse odd count" {
	[10 20 30] -> arr

	arr sort::reverse

	arr 0 nth 30 testing::assert_eq
	arr 1 nth 20 testing::assert_eq
	arr 2 nth 10 testing::assert_eq

	arr free
}

test "sort::reverse single element" {
	[42] -> arr

	arr sort::reverse

	arr 0 nth 42 testing::assert_eq

	arr free
}

test "sort::reverse twice restores original" {
	[1 2 3] -> arr

	arr sort::reverse
	arr sort::reverse

	arr 0 nth 1 testing::assert_eq
	arr 1 nth 2 testing::assert_eq
	arr 2 nth 3 testing::assert_eq

	arr free
}

// --- sort::strings ---

// --- sort + reverse combo ---

test "sort::ints then reverse gives descending" {
	[3 1 4 2] -> arr

	arr sort::ints
	arr sort::reverse

	arr 0 nth 4 testing::assert_eq
	arr 1 nth 3 testing::assert_eq
	arr 2 nth 2 testing::assert_eq
	arr 3 nth 1 testing::assert_eq

	arr free
}

// --- sort + search combo ---

test "sort then search" {
	[50 10 30 40 20] -> arr

	arr sort::ints
	arr 30 sort::search 2 testing::assert_eq
	arr 10 sort::search 0 testing::assert_eq
	arr 50 sort::search 4 testing::assert_eq
	arr 25 sort::search -1 testing::assert_eq

	arr free
}

test "sort::strings sorts a string array" {
	"c,a,b" "," strings::split! -> arr
	arr sort::strings
	arr 0 nth "a" testing::assert_eq
	arr 1 nth "b" testing::assert_eq
	arr 2 nth "c" testing::assert_eq
}

test "sort::strings_desc sorts a string array" {
	"a,c,b" "," strings::split! -> arr
	arr sort::strings_desc
	arr 0 nth "c" testing::assert_eq
	arr 2 nth "a" testing::assert_eq
}

// --- comparator-ordered sort -----------------------------------------------------------

fn cmp_desc(a:i64 b:i64 -- r:i64) {
	b a -
}

fn cmp_by_last_digit(a:i64 b:i64 -- r:i64) {
	a 10 % b 10 % -
}

fn cmp_asc(a:i64 b:i64 -- r:i64) {
	a b -
}

test "sort::by orders with a caller-supplied comparator" {
	[31 12 45 27 6] -> arr

	arr &cmp_desc sort::by
	arr 0 nth 45 testing::assert_eq
	arr 4 nth 6 testing::assert_eq
	arr &cmp_desc sort::is_sorted_by testing::assert_true

	// A comparator can order by a key rather than the value: 31 12 45 6 27
	arr &cmp_by_last_digit sort::by
	arr 0 nth 31 testing::assert_eq
	arr 1 nth 12 testing::assert_eq
	arr 4 nth 27 testing::assert_eq
	arr &cmp_by_last_digit sort::is_sorted_by testing::assert_true

	arr free
}

test "sort::by handles empty, single and already-sorted input" {
	[7] -> one
	one &cmp_asc sort::by
	one &cmp_asc sort::by
	one 0 nth 7 testing::assert_eq
	one &cmp_asc sort::is_sorted_by testing::assert_true
	one free
}

test "sort::by sorts a partition larger than the insertion-sort threshold" {
	// 16 is the cutoff between insertion sort and quicksort; 40 exercises both paths
	[40]i64 -> arr
	0 40 1 for i {
		arr i 40 i - set
	}
	arr &cmp_asc sort::by
	arr 0 nth 1 testing::assert_eq
	arr 39 nth 40 testing::assert_eq
	arr &cmp_asc sort::is_sorted_by testing::assert_true
	arr free
}

test "sort::is_sorted_by reports unsorted input" {
	[1 9 4] -> arr
	arr &cmp_asc sort::is_sorted_by testing::assert_false
	arr free
}

test "sort::lower_bound_by locates the insertion point" {
	[5]i64 -> arr
	0 5 1 for i {
		arr i i 2 * set
	}
	// 0 2 4 6 8
	arr 4 &cmp_asc sort::lower_bound_by 2 testing::assert_eq
	arr 5 &cmp_asc sort::lower_bound_by 3 testing::assert_eq
	arr 0 &cmp_asc sort::lower_bound_by 0 testing::assert_eq
	arr 99 &cmp_asc sort::lower_bound_by 5 testing::assert_eq
	arr free
}

test "sort::ints sorts reverse-sorted input of every length" {
	// The partition bounded its left scan by j rather than by hi. The scan could then stop on
	// an element that still sorted before the pivot, and the pivot swap that follows put the
	// pivot to the left of it. Reverse-sorted input of even length 18 or more came back
	// unsorted -- silently, since nothing checked.
	0 -> failures
	2 61 1 for n {
		[n]i64 -> arr
		0 n 1 for i {
			arr i n i - set
		}
		arr sort::ints
		arr sort::is_sorted 0 == if {
			failures 1 + -> failures
		}
		arr free
	}
	failures 0 testing::assert_eq
}

test "sort::floats sorts reverse-sorted input of every length" {
	0 -> failures
	2 61 1 for n {
		[n]f64 -> arr
		0 n 1 for i {
			arr i n i - cast<f64> set
		}
		arr sort::floats
		arr sort::is_sorted_floats 0 == if {
			failures 1 + -> failures
		}
		arr free
	}
	failures 0 testing::assert_eq
}

test "sort::by sorts reverse-sorted input of every length" {
	0 -> failures
	2 61 1 for n {
		[n]i64 -> arr
		0 n 1 for i {
			arr i n i - set
		}
		arr &cmp_asc sort::by
		arr &cmp_asc sort::is_sorted_by 0 == if {
			failures 1 + -> failures
		}
		arr free
	}
	failures 0 testing::assert_eq
}
