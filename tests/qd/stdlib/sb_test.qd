// Unit tests for the sb (StringBuilder) module
use sb
use strings
use testing

test "sb::new and build" {
	sb::new -> builder
	builder sb::build "" testing::assert_eq
	builder sb::free
}

test "sb::append single string" {
	sb::new -> builder
	builder "hello" sb::append -> builder
	builder sb::build "hello" testing::assert_eq
	builder sb::free
}

test "sb::append multiple strings" {
	sb::new -> builder
	builder "hello" sb::append -> builder
	builder " " sb::append -> builder
	builder "world" sb::append -> builder
	builder sb::build "hello world" testing::assert_eq
	builder sb::free
}

test "sb::append_char" {
	sb::new -> builder
	builder 65 sb::append_char -> builder
	builder 66 sb::append_char -> builder
	builder 67 sb::append_char -> builder
	builder sb::build "ABC" testing::assert_eq
	builder sb::free
}

test "sb::append_int" {
	sb::new -> builder
	builder 42 sb::append_int -> builder
	builder sb::build "42" testing::assert_eq
	builder sb::free
}

test "sb::append_int negative" {
	sb::new -> builder
	builder -123 sb::append_int -> builder
	builder sb::build "-123" testing::assert_eq
	builder sb::free
}

test "sb::append_int zero" {
	sb::new -> builder
	builder 0 sb::append_int -> builder
	builder sb::build "0" testing::assert_eq
	builder sb::free
}

test "sb::len" {
	sb::new -> builder
	builder sb::len 0 testing::assert_eq
	builder "hello" sb::append -> builder
	builder sb::len 5 testing::assert_eq
	builder " world" sb::append -> builder
	builder sb::len 11 testing::assert_eq
	builder sb::free
}

test "sb::with_capacity" {
	1024 sb::with_capacity -> builder
	builder "test" sb::append -> builder
	builder sb::build "test" testing::assert_eq
	builder sb::free
}

test "sb::finish" {
	sb::new -> builder
	builder "result" sb::append -> builder
	builder sb::finish -> result
	result "result" testing::assert_eq
}

test "sb mixed append" {
	sb::new -> builder
	builder "count: " sb::append -> builder
	builder 100 sb::append_int -> builder
	builder sb::finish -> result
	result "count: 100" testing::assert_eq
}

test "sb::capacity" {
	1024 sb::with_capacity -> builder
	builder sb::capacity 1024 testing::assert_eq
	builder sb::free
}

test "sb::is_empty" {
	sb::new -> builder
	builder sb::is_empty testing::assert_true
	builder "x" sb::append -> builder
	builder sb::is_empty testing::assert_false
	builder sb::free
}

test "sb::newline" {
	sb::new -> builder
	builder "line1" sb::append -> builder
	builder sb::newline -> builder
	builder "line2" sb::append -> builder
	builder sb::finish -> result
	result "line1\nline2" testing::assert_eq
}

test "sb::space" {
	sb::new -> builder
	builder "hello" sb::append -> builder
	builder sb::space -> builder
	builder "world" sb::append -> builder
	builder sb::finish -> result
	result "hello world" testing::assert_eq
}

test "sb::append copies bytes, not characters" {
	// strings::len counts codepoints, so appending by that measure copied four bytes of a
	// five-byte string: "héllo" came back as "héll", cut inside a character.
	sb::new -> builder
	builder "héllo" sb::append -> builder
	builder sb::len 6 testing::assert_eq
	builder sb::finish -> result
	result "héllo" testing::assert_eq
	result strings::len 5 testing::assert_eq
	result strings::byte_len 6 testing::assert_eq
}

test "sb::append_char encodes a codepoint as UTF-8" {
	// It used to write the low byte and call that a character, so anything above 127
	// produced a lone lead or continuation byte -- not the character, and not valid UTF-8.
	sb::new -> builder
	builder 233 sb::append_char -> builder
	builder 20013 sb::append_char -> builder
	builder 128512 sb::append_char -> builder
	builder 65 sb::append_char -> builder
	builder sb::finish -> result
	result "é中😀A" testing::assert_eq
	result strings::len 4 testing::assert_eq
	result strings::byte_len 10 testing::assert_eq
}

test "sb::append mixes scripts without losing bytes" {
	sb::new -> builder
	builder "αβγ" sb::append -> builder
	builder " " sb::append -> builder
	builder "日本語" sb::append -> builder
	builder sb::finish -> result
	result "αβγ 日本語" testing::assert_eq
	result strings::len 7 testing::assert_eq
}
