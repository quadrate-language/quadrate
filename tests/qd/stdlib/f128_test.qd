// Unit tests for the f128 module. Expected values are the exact decimal128 results -- each is
// the true value correctly rounded to 34 digits -- so an equality is the whole check.
use f128
use testing

test "f128 constants" {
	f128::pi 3.141592653589793238462643383279503q testing::assert_eq
	f128::e 2.718281828459045235360287471352662q testing::assert_eq
	f128::inf f128::is_inf testing::assert_true
	f128::nan f128::is_nan testing::assert_true
}

test "f128::sqrt is correctly rounded" {
	2q f128::sqrt 1.414213562373095048801688724209698q testing::assert_eq
	9q f128::sqrt 3q testing::assert_eq
	0.01q f128::sqrt 0.1q testing::assert_eq
	-1q f128::sqrt f128::is_nan testing::assert_true
	-0q f128::sqrt f128::is_signed testing::assert_true
}

test "f128 exp, ln, log10 and pow" {
	1q f128::exp 2.718281828459045235360287471352662q testing::assert_eq
	10q f128::ln 2.302585092994045684017991454684364q testing::assert_eq
	1000q f128::log10 3q testing::assert_eq
	2q 10q f128::pow 1024q testing::assert_eq
	2q 0.5q f128::pow 1.414213562373095048801688724209698q testing::assert_eq
	0q f128::ln f128::is_inf testing::assert_true
}

test "f128 trigonometry" {
	1q f128::sin 0.8414709848078965066525023216302990q testing::assert_eq
	1q f128::cos 0.5403023058681397174009366074429766q testing::assert_eq
	1q f128::tan 1.557407724654902230506974807458360q testing::assert_eq
	// sin(1e22) is the classic argument-reduction trap; decimal128's range goes much further
	1e22q f128::sin -0.8522008497671888017727058937530294q testing::assert_eq
	355q f128::sin -0.00003014435335948844921433028000865010q testing::assert_eq
	-0q f128::sin f128::is_signed testing::assert_true
	f128::inf f128::sin f128::is_nan testing::assert_true
}

test "f128 inverse trigonometry" {
	1q f128::atan 0.7853981633974483096156608458198757q testing::assert_eq
	0.5q f128::asin 0.5235987755982988730771072305465838q testing::assert_eq
	0.5q f128::acos 1.047197551196597746154214461093168q testing::assert_eq
	-1q f128::acos f128::pi testing::assert_eq
	1q f128::acos 0q testing::assert_eq
	2q f128::asin f128::is_nan testing::assert_true
	1q -1q f128::atan2 2.356194490192344928846982537459627q testing::assert_eq
	-0q -1q f128::atan2 f128::pi neg testing::assert_eq
	0q 0q f128::atan2 0q testing::assert_eq
}

test "f128 fma rounds once" {
	2q 3q 1q f128::fma 7q testing::assert_eq
	// (1 + 1e-33)^2 - 1 is 2e-33 + 1e-66: separate rounding of the product loses the 1e-66
	1.000000000000000000000000000000001q -> x
	x x -1q f128::fma 2.000000000000000000000000000000001e-33q testing::assert_eq
	x x * -1q + 2e-33q testing::assert_eq
}

test "f128 remainders" {
	10q 3q f128::remainder 1q testing::assert_eq
	11q 3q f128::remainder -1q testing::assert_eq
	-7q 2q f128::fmod -1q testing::assert_eq
	7.5q 2q f128::fmod 1.5q testing::assert_eq
}

test "f128 sign operations" {
	-2.5q f128::abs 2.5q testing::assert_eq
	-0q f128::abs f128::is_signed testing::assert_false
	3q -1q f128::copysign -3q testing::assert_eq
	-0q f128::is_signed testing::assert_true
	0q f128::is_signed testing::assert_false
}

test "f128 min and max prefer a number to NaN" {
	3q 7q f128::min 3q testing::assert_eq
	3q 7q f128::max 7q testing::assert_eq
	f128::nan 1q f128::min 1q testing::assert_eq
	1q f128::nan f128::max 1q testing::assert_eq
}

test "f128 rounding to an integer" {
	2.5q f128::round_even 2q testing::assert_eq
	3.5q f128::round_even 4q testing::assert_eq
	2.5q f128::round 3q testing::assert_eq
	-2.5q f128::round -3q testing::assert_eq
	-2.7q f128::trunc -2q testing::assert_eq
	-2.1q f128::floor -3q testing::assert_eq
	2.1q f128::ceil 3q testing::assert_eq
}

test "f128 exponent and digits" {
	2.34567q 0.01q f128::quantize cast<str> "2.35" testing::assert_eq
	1.500q f128::reduce cast<str> "1.5" testing::assert_eq
	1.5q 3 f128::scaleb 1500q testing::assert_eq
	1234q f128::logb 3q testing::assert_eq
	1q f128::next_up 1.000000000000000000000000000000001q testing::assert_eq
	1q f128::next_down 0.9999999999999999999999999999999999q testing::assert_eq
}

test "f128 classification" {
	1q f128::is_finite testing::assert_true
	1q 0q / f128::is_finite testing::assert_false
	-0q f128::is_zero testing::assert_true
	1q f128::is_normal testing::assert_true
	1e-6150q f128::is_subnormal testing::assert_true
	1e-6150q f128::is_normal testing::assert_false
}

test "f128 totalOrder" {
	-0q 0q f128::total_order -1 testing::assert_eq
	1.00q 1.0q f128::total_order -1 testing::assert_eq
	1q 1q f128::total_order 0 testing::assert_eq
	1q f128::nan f128::total_order -1 testing::assert_eq
}
