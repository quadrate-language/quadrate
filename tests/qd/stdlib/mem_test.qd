// Unit tests for the mem module
use bits
use mem
use testing

fn test_alloc_and_free( -- result:i64) {
	1024 mem::alloc! -> buf
	buf mem::is_null bits::not -> ok
	buf mem::free
	ok
}

fn test_set_get_byte( -- result:i64) {
	16 mem::alloc! -> buf
	65 buf 0 mem::set_byte
	buf 0 mem::get_byte -> val
	buf mem::free
	val 65 eq
}

fn test_set_get_i64( -- result:i64) {
	16 mem::alloc! -> buf
	12345678 buf 0 mem::set_i64
	buf 0 mem::get_i64 -> val
	buf mem::free
	val 12345678 eq
}

fn test_set_get_f64( -- result:i64) {
	16 mem::alloc! -> buf
	3.14159 buf 0 mem::set_f64
	buf 0 mem::get_f64 -> val
	buf mem::free
	val 3.14 > val 3.15 < and
}

fn test_mem_zero( -- result:i64) {
	16 mem::alloc! -> buf
	255 buf 0 mem::set_byte
	255 buf 1 mem::set_byte
	buf 16 mem::zero
	buf 0 mem::get_byte -> b0
	buf 1 mem::get_byte -> b1
	buf mem::free
	b0 0 eq b1 0 eq bits::and
}

fn test_mem_fill( -- result:i64) {
	16 mem::alloc! -> buf
	0xAB buf 16 mem::fill
	buf 0 mem::get_byte -> b0
	buf 15 mem::get_byte -> b15
	buf mem::free
	b0 0xAB eq b15 0xAB eq bits::and
}

fn test_mem_copy( -- result:i64) {
	16 mem::alloc! -> src
	16 mem::alloc! -> dst
	0xAB src 16 mem::fill
	dst src 16 mem::copy
	dst 0 mem::get_byte -> b0
	dst 15 mem::get_byte -> b15
	src mem::free
	dst mem::free
	b0 0xAB eq b15 0xAB eq bits::and
}

fn test_to_from_string( -- result:i64) {
	"hello" mem::from_string -> len -> buf
	len 5 eq -> len_ok
	buf len mem::to_string -> s
	buf mem::free
	s "hello" eq len_ok bits::and
}

test "mem::alloc and free" {
	test_alloc_and_free testing::assert_true
}

test "mem::set_byte and get_byte" {
	test_set_get_byte testing::assert_true
}

test "mem::set_i64 and get_i64" {
	test_set_get_i64 testing::assert_true
}

test "mem::set_f64 and get_f64" {
	test_set_get_f64 testing::assert_true
}

test "mem::zero" {
	test_mem_zero testing::assert_true
}

test "mem::fill" {
	test_mem_fill testing::assert_true
}

test "mem::copy" {
	test_mem_copy testing::assert_true
}

test "mem::to_string and from_string" {
	test_to_from_string testing::assert_true
}

test "mem::is_null" {
	0 mem::is_null testing::assert_true
}

fn test_is_not_null( -- result:i64) {
	16 mem::alloc! -> buf
	buf mem::is_not_null -> ok
	buf mem::free
	ok
}

test "mem::is_not_null" {
	test_is_not_null testing::assert_true
	0 mem::is_not_null testing::assert_false
}

fn test_alloc_aligned_16( -- result:i64) {
	16 1024 mem::alloc_aligned! -> buf
	buf mem::is_not_null -> ok
	buf mem::free
	ok
}

fn test_alloc_aligned_64( -- result:i64) {
	64 256 mem::alloc_aligned! -> buf
	buf mem::is_not_null -> ok
	buf mem::free
	ok
}

test "mem::alloc_aligned 16-byte" {
	test_alloc_aligned_16 testing::assert_true
}

test "mem::alloc_aligned 64-byte" {
	test_alloc_aligned_64 testing::assert_true
}

// ============================================================
// Tagged slots
// ============================================================

struct Held {
	n: i64
}

test "mem::set_any and get_any keep the type" {
	4 mem::AnySize * mem::alloc! -> buf
	buf 4 mem::AnySize * mem::zero

	42 buf 0 mem::set_any
	1.5 buf mem::AnySize mem::set_any
	"héllo" buf 2 mem::AnySize * mem::set_any
	Held { n = 9 } buf 3 mem::AnySize * mem::set_any

	buf 0 mem::get_any 42 testing::assert_eq
	buf mem::AnySize mem::get_any 1.5 0.0 testing::assert_approx_eq
	buf 2 mem::AnySize * mem::get_any "héllo" testing::assert_eq
	buf 3 mem::AnySize * mem::get_any <<n 9 testing::assert_eq

	// Reading does not empty the slot
	buf 2 mem::AnySize * mem::get_any "héllo" testing::assert_eq

	buf mem::free
}

test "mem::set_any over a slot replaces what was there" {
	mem::AnySize mem::alloc! -> buf
	buf mem::AnySize mem::zero

	"first" buf 0 mem::set_any
	buf 0 mem::get_any "first" testing::assert_eq
	"second" buf 0 mem::set_any
	buf 0 mem::get_any "second" testing::assert_eq
	7 buf 0 mem::set_any
	buf 0 mem::get_any 7 testing::assert_eq

	buf mem::free
}

test "mem::clear_any empties a slot" {
	mem::AnySize mem::alloc! -> buf
	buf mem::AnySize mem::zero

	"held" buf 0 mem::set_any
	buf 0 mem::clear_any
	// A cleared slot reads as the integer 0, the same as a freshly zeroed one
	buf 0 mem::get_any 0 testing::assert_eq

	buf mem::free
}

test "a zeroed slot reads as zero" {
	2 mem::AnySize * mem::alloc! -> buf
	buf 2 mem::AnySize * mem::zero
	buf 0 mem::get_any 0 testing::assert_eq
	buf mem::AnySize mem::get_any 0 testing::assert_eq
	buf mem::free
}
