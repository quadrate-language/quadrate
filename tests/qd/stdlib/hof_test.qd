// Unit tests for the hof (higher-order functions) module
use hof
use testing
use strings

test "hof::apply" {
	5 stack fn (i64 -- i64) { 2 * } hof::apply 10 testing::assert_eq
	10 stack fn (i64 -- i64) { 3 + } hof::apply 13 testing::assert_eq
	7 stack fn (i64 -- i64) { dup * } hof::apply 49 testing::assert_eq
}

test "hof::bi" {
	5 stack fn (i64 -- i64) { 1 + } stack fn (i64 -- i64) { 2 * } hof::bi
	-> b -> a
	a 6 testing::assert_eq
	b 10 testing::assert_eq
}

test "hof::both" {
	3 4 stack fn (i64 -- i64) { 2 * } hof::both
	-> b -> a
	a 6 testing::assert_eq
	b 8 testing::assert_eq
}

test "hof::dip" {
	3 4 stack fn (i64 -- i64) { 10 + } hof::dip
	-> top -> below
	below 13 testing::assert_eq
	top 4 testing::assert_eq
}

test "hof::keep" {
	5 stack fn (i64 -- i64) { 2 * } hof::keep
	-> orig -> result
	result 10 testing::assert_eq
	orig 5 testing::assert_eq
}

test "hof::times" {
	0 5 stack fn (i64 -- i64) { 1 + } hof::times 5 testing::assert_eq
	1 4 stack fn (i64 -- i64) { 2 * } hof::times 16 testing::assert_eq
}

test "hof::when" {
	5 1 stack fn (i64 -- i64) { 10 + } hof::when 15 testing::assert_eq
	5 0 stack fn (i64 -- i64) { 10 + } hof::when 5 testing::assert_eq
}

test "hof::unless" {
	5 0 stack fn (i64 -- i64) { 10 + } hof::unless 15 testing::assert_eq
	5 1 stack fn (i64 -- i64) { 10 + } hof::unless 5 testing::assert_eq
}

test "hof::fold" {
	0 make<i64> 1 append 2 append 3 append 4 append 5 append -> arr
	arr 0 fn (acc:i64 x:i64 -- r:i64) { acc x + } hof::fold 15 testing::assert_eq
	arr free
}

test "hof::tri" {
	10 stack fn (i64 -- i64) { 1 + } stack fn (i64 -- i64) { 2 * } stack fn (i64 -- i64) { 3 - } hof::tri
	-> c -> b -> a
	a 11 testing::assert_eq
	b 20 testing::assert_eq
	c 7 testing::assert_eq
}

test "hof::bi_star" {
	// bi_star applies different functions to two values
	3 4 stack fn (i64 -- i64) { 1 + } stack fn (i64 -- i64) { 2 * } hof::bi_star
	-> b -> a
	a 4 testing::assert_eq   // 3 + 1 = 4
	b 8 testing::assert_eq   // 4 * 2 = 8
}

test "hof::fold_right" {
	// fold_right: fold from the right side
	0 make<i64> 1 append 2 append 3 append -> arr
	// Subtraction to show right-to-left: 1 - (2 - (3 - 0)) = 1 - (2 - 3) = 1 - (-1) = 2
	arr 0 fn (elem:i64 acc:i64 -- r:i64) { elem acc - } hof::fold_right 2 testing::assert_eq
	arr free
}

test "hof::map" {
	// map: apply function to each element
	0 make<i64> 1 append 2 append 3 append -> arr
	arr stack fn (i64 -- i64) { 2 * } hof::map -> result
	result len 3 testing::assert_eq
	result 0 nth cast<i64> 2 testing::assert_eq   // 1 * 2
	result 1 nth cast<i64> 4 testing::assert_eq   // 2 * 2
	result 2 nth cast<i64> 6 testing::assert_eq   // 3 * 2
	result free
	arr free
}

test "hof::filter" {
	// filter: keep elements matching predicate
	0 make<i64> 1 append 2 append 3 append 4 append 5 append -> arr
	arr stack fn (i64 -- i64) { 2 % 0 == } hof::filter -> result
	result len 2 testing::assert_eq  // 2 and 4 are even
	result 0 nth cast<i64> 2 testing::assert_eq
	result 1 nth cast<i64> 4 testing::assert_eq
	result free
	arr free
}

test "hof::any" {
	// any: check if any element matches predicate
	0 make<i64> 1 append 3 append 5 append -> odds
	0 make<i64> 2 append 4 append 6 append -> evens

	// Check if any odd number is even (should be false)
	odds stack fn (i64 -- i64) { 2 % 0 == } hof::any testing::assert_false

	// Check if any even number is even (should be true)
	evens stack fn (i64 -- i64) { 2 % 0 == } hof::any testing::assert_true

	odds free
	evens free
}

test "hof::all" {
	// all: check if all elements match predicate
	0 make<i64> 2 append 4 append 6 append -> evens
	0 make<i64> 2 append 3 append 4 append -> mixed

	// Check if all are even
	evens stack fn (i64 -- i64) { 2 % 0 == } hof::all testing::assert_true
	mixed stack fn (i64 -- i64) { 2 % 0 == } hof::all testing::assert_false

	evens free
	mixed free
}

test "hof::find" {
	// find: find first element matching predicate
	0 make<i64> 1 append 2 append 3 append 4 append -> arr

	// Find first even number
	arr stack fn (i64 -- i64) { 2 % 0 == } hof::find -> found -> elem
	found testing::assert_true
	elem 2 testing::assert_eq

	// Find number greater than 10 (not found)
	arr stack fn (i64 -- i64) { 10 > } hof::find -> found -> elem
	found testing::assert_false

	arr free
}

// --- generic combinators ----------------------------------------------------------------
//
// Every combinator was fixed to fn(i64 -- i64) until generic function-pointer parameters
// started unifying. The tests above all use i64 and still pass unchanged; these cover the
// types that were impossible to use before.

fn halve(x:f64 -- r:f64) {
	x 2.0 /
}

fn tag(s:str -- r:str) {
	s "!" strings::concat
}

fn length_of(s:str -- n:i64) {
	s strings::len
}

fn is_short(s:str -- b:i64) {
	s strings::len 2 <=
}

fn join_two(acc:str x:str -- r:str) {
	acc x strings::concat
}

test "hof::apply over f64 and str" {
	8.0 &halve hof::apply 4.0 0.001 testing::assert_approx_eq
	"hi" &tag hof::apply "hi!" testing::assert_eq
}

test "hof::map changes the element type" {
	"a,bbb" "," strings::split! -> count -> arr
	arr &length_of hof::map -> lens
	lens 0 nth 1 testing::assert_eq
	lens 1 nth 3 testing::assert_eq
	lens free
}

test "hof::filter and find over strings" {
	"a,bbb,cc" "," strings::split! -> count -> arr
	arr &is_short hof::filter -> shorts
	shorts len 2 testing::assert_eq
	shorts 0 nth "a" testing::assert_eq

	arr &is_short hof::find -> found -> elem
	found testing::assert_true
	elem "a" testing::assert_eq
	shorts free
}

test "hof::fold over strings" {
	"a,b,c" "," strings::split! -> count -> arr
	arr "" &join_two hof::fold "abc" testing::assert_eq
}

test "hof::any and all over strings" {
	"a,bbb" "," strings::split! -> count -> arr
	arr &is_short hof::any testing::assert_true
	arr &is_short hof::all testing::assert_false
}
