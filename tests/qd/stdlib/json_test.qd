// Unit tests for the json module
use json
use strings
use strconv
use testing

// Helper to build JSON strings (since Quadrate doesn't support \" escape)
// q = 34 (double quote character)
fn make_json_string(key:str val:str -- json:str) {
	34 -> q
	"{" q strings::from_char strings::concat key strings::concat q strings::from_char strings::concat ": " strings::concat
		q strings::from_char strings::concat val strings::concat q strings::from_char strings::concat "}" strings::concat
}

fn make_json_int(key:str val:i64 -- json:str) {
	34 -> q
	"{" q strings::from_char strings::concat key strings::concat q strings::from_char strings::concat ": " strings::concat
		val strconv::itoa strings::concat "}" strings::concat
}

fn make_json_bool(key:str val:i64 -- json:str) {
	34 -> q
	"{" q strings::from_char strings::concat key strings::concat q strings::from_char strings::concat ": " strings::concat
		val if { "true" } else { "false" } strings::concat "}" strings::concat
}

test "json::get_string" {
	"name" "Alice" make_json_string "name" json::get_string -> found -> val
	found testing::assert_true
	val "Alice" testing::assert_eq
}

test "json::get_string missing key" {
	"name" "Alice" make_json_string "missing" json::get_string -> found -> val
	found testing::assert_false
}

test "json::get_int" {
	"count" 42 make_json_int "count" json::get_int -> found -> val
	found testing::assert_true
	val 42 testing::assert_eq
}

test "json::get_int missing key" {
	"count" 42 make_json_int "missing" json::get_int -> found -> val
	found testing::assert_false
}

test "json::get_bool true" {
	"active" 1 make_json_bool "active" json::get_bool -> found -> val
	found testing::assert_true
	val testing::assert_true
}

test "json::get_bool false" {
	"active" 0 make_json_bool "active" json::get_bool -> found -> val
	found testing::assert_true
	val testing::assert_false
}

test "json::has_key" {
	34 -> q
	"{" q strings::from_char strings::concat "name" strings::concat q strings::from_char strings::concat ": " strings::concat
		q strings::from_char strings::concat "test" strings::concat q strings::from_char strings::concat ", " strings::concat
		q strings::from_char strings::concat "value" strings::concat q strings::from_char strings::concat ": 123}" strings::concat
	-> j
	j "name" json::has_key testing::assert_true
	j "value" json::has_key testing::assert_true
	j "missing" json::has_key testing::assert_false
}

test "json::array_len" {
	"[1, 2, 3]" json::array_len 3 testing::assert_eq
	"[]" json::array_len 0 testing::assert_eq
	"[1]" json::array_len 1 testing::assert_eq
	"[1, 2, 3, 4, 5]" json::array_len 5 testing::assert_eq
}

test "json::array_get_int" {
	"[10, 20, 30]" 0 json::array_get_int -> found -> val
	found testing::assert_true
	val 10 testing::assert_eq
	"[10, 20, 30]" 1 json::array_get_int -> found -> val
	found testing::assert_true
	val 20 testing::assert_eq
	"[10, 20, 30]" 2 json::array_get_int -> found -> val
	found testing::assert_true
	val 30 testing::assert_eq
}

test "json::array_get_int out of bounds" {
	"[10, 20, 30]" 5 json::array_get_int -> found -> val
	found testing::assert_false
}

test "json::array_get_int negative" {
	"[-5, 0, 5]" 0 json::array_get_int -> found -> val
	found testing::assert_true
	val -5 testing::assert_eq
}

test "json::array_get_string" {
	34 -> q
	"[" q strings::from_char strings::concat "a" strings::concat q strings::from_char strings::concat ", " strings::concat
	q strings::from_char strings::concat "b" strings::concat q strings::from_char strings::concat ", " strings::concat
	q strings::from_char strings::concat "c" strings::concat q strings::from_char strings::concat "]" strings::concat
	-> json_arr
	json_arr 0 json::array_get_string -> found -> val
	found testing::assert_true
	val "a" testing::assert_eq
	json_arr 1 json::array_get_string -> found -> val
	found testing::assert_true
	val "b" testing::assert_eq
}

test "json type constants" {
	json::Null 0 testing::assert_eq
	json::Bool 1 testing::assert_eq
	json::Number 2 testing::assert_eq
	json::String 3 testing::assert_eq
	json::Array 4 testing::assert_eq
	json::Object 5 testing::assert_eq
}

test "json::get_float" {
	34 -> q
	"{" q strings::from_char strings::concat "value" strings::concat q strings::from_char strings::concat ": 3.14}" strings::concat
	-> j
	j "value" json::get_float -> found -> val
	found testing::assert_true
	val 3.14 - 0.001 < testing::assert_true
}

test "json::get_float negative" {
	34 -> q
	"{" q strings::from_char strings::concat "temp" strings::concat q strings::from_char strings::concat ": -273.15}" strings::concat
	-> j
	j "temp" json::get_float -> found -> val
	found testing::assert_true
	val -273.15 - 0.001 < testing::assert_true
}

test "json::array_get_float" {
	"[1.1, 2.2, 3.3]" 0 json::array_get_float -> found -> val
	found testing::assert_true
	val 1.1 - 0.001 < testing::assert_true

	"[1.1, 2.2, 3.3]" 1 json::array_get_float -> found -> val
	found testing::assert_true
	val 2.2 - 0.001 < testing::assert_true
}

test "json::get_object" {
	34 -> q
	// {"outer": {"inner": 42}}
	"{" q strings::from_char strings::concat "outer" strings::concat q strings::from_char strings::concat ": {" strings::concat
		q strings::from_char strings::concat "inner" strings::concat q strings::from_char strings::concat ": 42}}" strings::concat
	-> j
	j "outer" json::get_object -> found -> json_obj
	found testing::assert_true
	json_obj "inner" json::get_int -> found -> val
	found testing::assert_true
	val 42 testing::assert_eq
}

test "json::get_array" {
	34 -> q
	// {"items": [1, 2, 3]}
	"{" q strings::from_char strings::concat "items" strings::concat q strings::from_char strings::concat ": [1, 2, 3]}" strings::concat
	-> j
	j "items" json::get_array -> found -> json_arr
	found testing::assert_true
	json_arr json::array_len 3 testing::assert_eq
	json_arr 0 json::array_get_int -> found -> val
	found testing::assert_true
	val 1 testing::assert_eq
}

// ============================================================
// JSON Building Tests
// ============================================================

test "json::encode quotes string" {
	34 -> q
	"hello" json::encode -> result
	q strings::from_char "hello" strings::concat q strings::from_char strings::concat -> expected
	result expected testing::assert_eq
}

test "json::kv builds key-value" {
	34 -> q
	"name" "Bob" json::kv -> result
	// Expected: "name":"Bob"
	q strings::from_char "name" strings::concat q strings::from_char strings::concat ":" strings::concat
		q strings::from_char strings::concat "Bob" strings::concat q strings::from_char strings::concat -> expected
	result expected testing::assert_eq
}

test "json::kv_int builds key-int" {
	34 -> q
	"age" 42 json::kv_int -> result
	// Expected: "age":42
	q strings::from_char "age" strings::concat q strings::from_char strings::concat ":42" strings::concat -> expected
	result expected testing::assert_eq
}

test "json::kv_int negative" {
	34 -> q
	"temp" -10 json::kv_int -> result
	// Expected: "temp":-10
	q strings::from_char "temp" strings::concat q strings::from_char strings::concat ":-10" strings::concat -> expected
	result expected testing::assert_eq
}

test "json::kv_int zero" {
	34 -> q
	"count" 0 json::kv_int -> result
	// Expected: "count":0
	q strings::from_char "count" strings::concat q strings::from_char strings::concat ":0" strings::concat -> expected
	result expected testing::assert_eq
}

test "json::kv_bool true" {
	34 -> q
	"active" 1 json::kv_bool -> result
	// Expected: "active":true
	q strings::from_char "active" strings::concat q strings::from_char strings::concat ":true" strings::concat -> expected
	result expected testing::assert_eq
}

test "json::kv_bool false" {
	34 -> q
	"active" 0 json::kv_bool -> result
	// Expected: "active":false
	q strings::from_char "active" strings::concat q strings::from_char strings::concat ":false" strings::concat -> expected
	result expected testing::assert_eq
}

test "json::kv_raw builds key-raw" {
	34 -> q
	"data" "{}" json::kv_raw -> result
	// Expected: "data":{}
	q strings::from_char "data" strings::concat q strings::from_char strings::concat ":{}" strings::concat -> expected
	result expected testing::assert_eq
}

test "json::obj builds object" {
	34 -> q
	"a" "1" json::kv -> kv1
	kv1 json::obj -> result
	// Expected: {"a":"1"}
	"{" q strings::from_char strings::concat "a" strings::concat q strings::from_char strings::concat ":" strings::concat
		q strings::from_char strings::concat "1" strings::concat q strings::from_char strings::concat "}" strings::concat -> expected
	result expected testing::assert_eq
}

test "json::empty_obj" {
	json::empty_obj "{}" testing::assert_eq
}

test "json::arr builds array" {
	"1,2,3" json::arr -> result
	result "[1,2,3]" testing::assert_eq
}

test "json::empty_arr" {
	json::empty_arr "[]" testing::assert_eq
}

test "json::join" {
	34 -> q
	"a" 1 json::kv_int -> kv1
	"b" 2 json::kv_int -> kv2
	kv1 kv2 json::join -> result
	// Expected: "a":1,"b":2
	q strings::from_char "a" strings::concat q strings::from_char strings::concat ":1," strings::concat
		q strings::from_char strings::concat "b" strings::concat q strings::from_char strings::concat ":2" strings::concat -> expected
	result expected testing::assert_eq
}

test "json build full object" {
	// Build {"name":"Alice","age":30}
	"name" "Alice" json::kv -> kv1
	"age" 30 json::kv_int -> kv2
	kv1 kv2 json::join json::obj -> result

	// Parse it back to verify
	result "name" json::get_string -> found -> val
	found testing::assert_true
	val "Alice" testing::assert_eq

	result "age" json::get_int -> found -> val
	found testing::assert_true
	val 30 testing::assert_eq
}

test "json::get_float survives a malformed number" {
	// find_num_end accepts anything number-shaped, so tokens like `-`, `.` and
	// `e5` reached strconv::parse_float!, which aborted -- a JSON parser dying on
	// untrusted input. `found = 0` is the channel this function already had.
	"{\"a\": -}" "a" json::get_float -> found -> _
	found 0 testing::assert_eq

	"{\"a\": .}" "a" json::get_float -> found2 -> _
	found2 0 testing::assert_eq

	"{\"a\": e5}" "a" json::get_float -> found3 -> _
	found3 0 testing::assert_eq

	// A valid number is still a valid number.
	"{\"a\": 1.5}" "a" json::get_float -> found4 -> val4
	found4 1 testing::assert_eq
	val4 1.5 testing::assert_eq
}

test "json::array_get_float survives a malformed element" {
	"[1.5, -, 2.5]" 0 json::array_get_float -> f0 -> v0
	f0 1 testing::assert_eq
	v0 1.5 testing::assert_eq

	"[1.5, -, 2.5]" 1 json::array_get_float -> f1 -> _
	f1 0 testing::assert_eq
}

test "json survives a document that ends on its comma" {
	// strings::char_at was fallible, so every scanner called it with `!` and a single
	// missing bounds check killed the host process: get_int on {"a":1, aborted before
	// returning. char_at is total now and NotAChar ends the scan.
	"{\"a\":1," "a" json::get_int -> found -> val
	found 1 testing::assert_eq
	val 1 testing::assert_eq

	"{\"a\":1," "b" json::get_int -> found2 -> _
	found2 0 testing::assert_eq

	"{\"=a\":," "a" json::get_string -> found3 -> _
	found3 0 testing::assert_eq

	"{\"a\":" "a" json::get_bool -> found4 -> _
	found4 0 testing::assert_eq

	"{\"a\":" "a" json::get_object -> found5 -> _
	found5 0 testing::assert_eq

	"{\"a\":" "a" json::get_array -> found6 -> _
	found6 0 testing::assert_eq

	"[," 0 json::array_get_object -> found7 -> _
	found7 0 testing::assert_eq
}

test "json::array_len counts no phantom element after a trailing comma" {
	"[1," json::array_len 1 testing::assert_eq
	"[1,2," json::array_len 2 testing::assert_eq
	"[1,2]" json::array_len 2 testing::assert_eq
	"[]" json::array_len 0 testing::assert_eq
}

test "json terminates on a value-less character" {
	// type_at reports Number for anything it does not recognise, so a stray '}' left
	// skip_value where it started and array_len spun forever on the document [}.
	"[}" json::array_len 1 testing::assert_eq
	"[{" json::array_len 1 testing::assert_eq
	"[,]" json::array_len 0 testing::assert_eq

	"[,]" 0 json::array_get_string -> found -> _
	found 0 testing::assert_eq
}


// ============================================================
// Value tree: json::parse and friends
// ============================================================

test "json::parse reads scalars" {
	"42" json::parse! -> v
	v json::is_number testing::assert_true
	v json::as_int! 42 testing::assert_eq
	v json::as_float! 42.0 0.0 testing::assert_approx_eq

	"-1.5e2" json::parse! -> f
	f json::as_float! -150.0 0.0 testing::assert_approx_eq
	f json::as_int! -150 testing::assert_eq

	"true" json::parse! -> t
	t json::is_bool testing::assert_true
	t json::as_bool! 1 testing::assert_eq

	"false" json::parse! json::as_bool! 0 testing::assert_eq

	"null" json::parse! json::is_null testing::assert_true

	"\"hi\"" json::parse! -> s
	s json::is_string testing::assert_true
	s json::as_str! "hi" testing::assert_eq
}

test "json::parse ignores whitespace around a value" {
	" \t\r\n 7 \n" json::parse! json::as_int! 7 testing::assert_eq
}

test "json::parse reads arrays" {
	"[1, 2, 3]" json::parse! -> v
	v json::is_array testing::assert_true
	v json::len 3 testing::assert_eq
	v 0 json::at! json::as_int! 1 testing::assert_eq
	v 2 json::at! json::as_int! 3 testing::assert_eq
	"[]" json::parse! json::len 0 testing::assert_eq
}

test "json::parse reads objects" {
	"{\"a\": 1, \"b\": \"x\"}" json::parse! -> v
	v json::is_object testing::assert_true
	v json::len 2 testing::assert_eq
	v "a" json::has testing::assert_true
	v "q" json::has testing::assert_false
	v "a" json::get! json::as_int! 1 testing::assert_eq
	v "b" json::get! json::as_str! "x" testing::assert_eq
	"{}" json::parse! json::len 0 testing::assert_eq
}

test "json::parse nests" {
	"{\"a\":{\"b\":[1,{\"c\":null}]}}" json::parse! -> v
	v "a" json::get! "b" json::get! -> arr
	arr json::len 2 testing::assert_eq
	arr 1 json::at! "c" json::get! json::is_null testing::assert_true
}

test "json::parse decodes escapes" {
	"\"a\\nb\\tc\\\"d\\\\e\\/f\"" json::parse! json::as_str! -> s
	s strings::len 11 testing::assert_eq
	s 1 strings::char_at 10 testing::assert_eq
	s 3 strings::char_at 9 testing::assert_eq
	s 5 strings::char_at 34 testing::assert_eq
	s 7 strings::char_at 92 testing::assert_eq
	s 9 strings::char_at 47 testing::assert_eq
	"\"\\b\\f\\r\"" json::parse! json::as_str! -> c
	c 0 strings::char_at 8 testing::assert_eq
	c 1 strings::char_at 12 testing::assert_eq
	c 2 strings::char_at 13 testing::assert_eq
}

test "json::parse decodes unicode escapes" {
	// One codepoint each: Latin-1, CJK, and an astral character written as a
	// surrogate pair. strings::len counts codepoints, so each of these is 1.
	"\"\\u00e9\"" json::parse! json::as_str! -> a
	a strings::len 1 testing::assert_eq
	a 0 strings::char_at 233 testing::assert_eq

	"\"\\u4e2d\"" json::parse! json::as_str! 0 strings::char_at 20013 testing::assert_eq

	"\"\\ud83d\\ude00\"" json::parse! json::as_str! -> e
	e strings::len 1 testing::assert_eq
	e 0 strings::char_at 128512 testing::assert_eq

	// A surrogate with no partner stands for no character: U+FFFD.
	"\"\\ud83d\"" json::parse! json::as_str! 0 strings::char_at 65533 testing::assert_eq
}

test "json::parse passes UTF-8 through unchanged" {
	"\"héllo\"" json::parse! json::as_str! "héllo" testing::assert_eq
}

test "json::parse keeps the last of two members with the same name" {
	"{\"a\":1,\"b\":2,\"a\":3}" json::parse! -> v
	v json::len 2 testing::assert_eq
	v "a" json::get! json::as_int! 3 testing::assert_eq
}

test "json::parse rejects malformed documents" {
	"" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	"1 2" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	"01" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	"[1,]" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	"{\"a\" 1}" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	"\"abc" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	"\"\\q\"" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	"tru" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	".5" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
	"-" json::parse if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrSyntax testing::assert_eq }
}

test "json::parse reports the offset of the error" {
	"[1, x]" json::parse if { drop "expected a failure" testing::fail } else { err -> _ -> msg msg "offset 4" testing::assert_contains }
}

test "json::parse stops at MaxDepth" {
	"" -> deep
	0 json::MaxDepth 1 + 1 for i {
		deep "[" strings::concat -> deep
	}
	deep json::parse if {
		drop "expected a failure" testing::fail
	} else {
		err -> code -> _ code json::ErrDepth testing::assert_eq
	}
}

test "json accessors report the wrong type rather than guessing" {
	"{\"a\":1}" json::parse! -> v
	v json::as_int if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrType testing::assert_eq }
	v json::as_str if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrType testing::assert_eq }
	v "nope" json::get if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrKey testing::assert_eq }
	"[1]" json::parse! 3 json::at if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrIndex testing::assert_eq }
}

test "json::first and json::next walk children in order" {
	"{\"a\":1,\"b\":2,\"c\":3}" json::parse! -> v
	v json::first! -> c
	"" -> keys
	0 -> sum
	loop {
		keys c json::name strings::concat -> keys
		c json::as_int! sum + -> sum
		c json::has_next 0 == if {
			break
		}
		c json::next! -> c
	}
	keys "abc" testing::assert_eq
	sum 6 testing::assert_eq
}

test "json::stringify round-trips a document" {
	"{\"a\":1,\"b\":[1,2.5,true,null,\"x\"],\"c\":{}}" -> text
	text json::parse! json::stringify text testing::assert_eq
}

test "json::stringify escapes what has to be escaped" {
	// Tab, quote and backslash by name; other control characters as \u00XX.
	"\"a\\tb\"" json::parse! json::stringify "\"a\\tb\"" testing::assert_eq
	"\"\\u0001\"" json::parse! json::stringify "\"\\u0001\"" testing::assert_eq
	"héllo" json::new_string json::stringify "\"héllo\"" testing::assert_eq
}

test "json::stringify writes numbers that read back the same" {
	"0.1" json::parse! json::stringify "0.1" testing::assert_eq
	"1e21" json::parse! json::stringify -> big
	big json::parse! json::as_float! 1.0e21 0.0 testing::assert_approx_eq
	"3" json::parse! json::stringify "3" testing::assert_eq
	"-0.5" json::parse! json::stringify "-0.5" testing::assert_eq
}

test "json::pretty indents one element to a line" {
	"{\"a\":[1],\"b\":{},\"c\":[]}" json::parse! 2 json::pretty -> out
	out "{\n  \"a\": [\n    1\n  ],\n  \"b\": {},\n  \"c\": []\n}" testing::assert_eq
}

test "json builds a document from nothing" {
	json::new_object -> o
	o "n" 42 json::new_int json::put! -> o
	o "f" 0.5 json::new_float json::put! -> o
	o "s" "x" json::new_string json::put! -> o
	o "t" 1 json::new_bool json::put! -> o
	o "z" json::new_null json::put! -> o
	json::new_array -> a
	a 1 json::new_int json::push! -> a
	a 2 json::new_int json::push! -> a
	o "a" a json::put! -> o
	o json::stringify "{\"n\":42,\"f\":0.5,\"s\":\"x\",\"t\":true,\"z\":null,\"a\":[1,2]}" testing::assert_eq
}

test "json::put replaces a member in place" {
	json::new_object -> o
	o "a" 1 json::new_int json::put! -> o
	o "b" 2 json::new_int json::put! -> o
	o "a" 9 json::new_int json::put! -> o
	o json::len 2 testing::assert_eq
	o json::stringify "{\"a\":9,\"b\":2}" testing::assert_eq

	// Replacing the last member keeps the end of the list intact.
	o "b" 8 json::new_int json::put! -> o
	o "c" 7 json::new_int json::put! -> o
	o json::stringify "{\"a\":9,\"b\":8,\"c\":7}" testing::assert_eq
}

test "json::push and json::put refuse the wrong container" {
	json::new_object -> o
	o 1 json::new_int json::push if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrType testing::assert_eq }
	json::new_array -> a
	a "k" 1 json::new_int json::put if { drop "expected a failure" testing::fail } else { err -> code -> _ code json::ErrType testing::assert_eq }
}
