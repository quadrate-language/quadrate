use str
use json

fn main( -- ) {
	34 -> q

	// Test empty object
	"{}" "anything" json::has_key . nl

	// Test empty array
	"[]" json::array_len . nl

	// Test whitespace handling
	"  {  }  " "anything" json::has_key . nl
	"  [  ]  " json::array_len . nl

	// Test large number
	"{" q str::from_char str::concat "big" str::concat q str::from_char str::concat ": 999999999}" str::concat
	-> json1
	json1 "big" json::get_int -> found -> val
	val . nl
	found . nl

	// Test negative number
	"{" q str::from_char str::concat "neg" str::concat q str::from_char str::concat ": -42}" str::concat
	-> json2
	json2 "neg" json::get_int -> found -> val
	val . nl
	found . nl

	// Test zero
	"{" q str::from_char str::concat "zero" str::concat q str::from_char str::concat ": 0}" str::concat
	-> json3
	json3 "zero" json::get_int -> found -> val
	val . nl
	found . nl

	// Test single element array
	"[42]" 0 json::array_get_int -> found -> val
	val . nl
	found . nl
	"[42]" json::array_len . nl

	// Test array with whitespace
	"[ 1 , 2 , 3 ]" json::array_len . nl
	"[ 1 , 2 , 3 ]" 0 json::array_get_int -> found -> val
	val . nl
	"[ 1 , 2 , 3 ]" 2 json::array_get_int -> found -> val
	val . nl
}
