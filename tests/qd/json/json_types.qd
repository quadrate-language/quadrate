use json
use str

fn main( -- ) {
	34 -> q

	// Test type_at - object
	"{}" 0 json::type_at . nl

	// Test type_at - array
	"[]" 0 json::type_at . nl

	// Test type_at - string
	q str::from_char "test" str::concat q str::from_char str::concat -> str_val
	str_val 0 json::type_at . nl

	// Test type_at - number
	"123" 0 json::type_at . nl

	// Test type_at - true
	"true" 0 json::type_at . nl

	// Test type_at - false
	"false" 0 json::type_at . nl

	// Test type_at - null
	"null" 0 json::type_at . nl

	// Test is_null_at
	"null" 0 json::is_null_at . nl
	"123" 0 json::is_null_at . nl
	"true" 0 json::is_null_at . nl

	// Type constants
	json::Null . nl
	json::Bool . nl
	json::Number . nl
	json::String . nl
	json::Array . nl
	json::Object . nl
}
