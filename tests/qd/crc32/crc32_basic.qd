// Test CRC32 basic functionality
use crc32

fn main() {
	// Standard test vector: "123456789" = 0xCBF43926
	"123456789" crc32::checksum print nl

	// Empty string
	"" crc32::checksum print nl

	// Single character
	"a" crc32::checksum print nl

	// Known values
	"Hello" crc32::checksum print nl
	"hello" crc32::checksum print nl

	// Hex output
	"123456789" crc32::checksum_hex print nl
	"Hello" crc32::checksum_hex print nl
}
