// Test file logging
use log
use io

fn main() {
	log::new! -> logger

	// Disable stdout, log to file
	logger disable_stdout
	logger "/tmp/test_log_output.log" add_file!

	// Log messages
	logger "file log test" info
	logger "another message" warn

	logger free

	// Read and print the log file
	"/tmp/test_log_output.log" io::read_file! -> content

	// Just print that we got content
	content "" neq if {
		"log file has content" print nl
	}
}
