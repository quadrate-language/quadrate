// Test logging messages with special characters
use log
use io
use str

fn main() {
	log::new! -> logger
	logger disable_stdout
	logger "/tmp/test_log_special.log" add_file!

	// Various special characters
	logger "message with quotes: test" info
	logger "message with colon: value" info
	logger "message with equals=sign" info
	logger "message with tabs	here" info
	logger "unicode: hello" info
	logger "brackets [test] {data}" info

	logger free

	// Verify special chars preserved
	"/tmp/test_log_special.log" io::read_file! -> content

	content "quotes" str::contains if {
		"quotes preserved: ok" print nl
	}
	content "colon" str::contains if {
		"colon preserved: ok" print nl
	}
	content "brackets" str::contains if {
		"brackets preserved: ok" print nl
	}
}
