// Test rapid logging (stress test)
use log
use io
use str

fn main() {
	log::new! -> logger
	logger disable_stdout
	logger "/tmp/test_log_rapid.log" add_file!

	// Log many messages rapidly
	0 1000 1 for i {
		logger "rapid message" info
	}

	logger flush
	logger free

	// Verify all messages were logged
	"/tmp/test_log_rapid.log" io::read_file! -> content
	content "rapid" str::contains if {
		"rapid logging: ok" print nl
	}
}
