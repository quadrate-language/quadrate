// Test all log levels work correctly
use log
use io
use str

fn main() {
	log::new! -> logger
	logger disable_stdout
	logger "/tmp/test_log_all_levels.log" add_file!
	logger log::LevelDebug set_level

	// Log at all levels
	logger "debug msg" debug
	logger "info msg" info
	logger "warn msg" warn
	logger "error msg" error

	logger free

	// Verify all levels present
	"/tmp/test_log_all_levels.log" io::read_file! -> content

	content "DEBUG" str::contains if {
		"DEBUG level: ok" print nl
	}
	content "INFO" str::contains if {
		"INFO level: ok" print nl
	}
	content "WARN" str::contains if {
		"WARN level: ok" print nl
	}
	content "ERROR" str::contains if {
		"ERROR level: ok" print nl
	}
}
