// Test multiple independent loggers
use log
use io
use str

fn main() {
	// Create two loggers with different configs
	log::new! -> logger1
	log::new! -> logger2

	logger1 disable_stdout
	logger2 disable_stdout

	logger1 "/tmp/test_log_multi1.log" add_file!
	logger2 "/tmp/test_log_multi2.log" add_file!

	// Different levels
	logger1 log::LevelDebug set_level
	logger2 log::LevelError set_level

	// Log to both
	logger1 "debug from logger1" debug
	logger1 "info from logger1" info
	logger2 "debug from logger2" debug
	logger2 "error from logger2" error

	logger1 free
	logger2 free

	// Verify logger1 has debug message
	"/tmp/test_log_multi1.log" io::read_file! -> content1
	content1 "debug" str::contains if {
		"logger1 has debug: ok" print nl
	}

	// Verify logger2 only has error (debug filtered)
	"/tmp/test_log_multi2.log" io::read_file! -> content2
	content2 "debug" str::contains not if {
		"logger2 filtered debug: ok" print nl
	}
	content2 "error" str::contains if {
		"logger2 has error: ok" print nl
	}
}
