// Test log level filtering
use log
use io
use str

fn main() {
	log::new! -> logger

	// Disable stdout, log to file for deterministic testing
	logger disable_stdout
	logger "/tmp/test_log_levels.log" add_file!

	// Set level to WARN - only WARN and ERROR should show
	logger log::LevelWarn set_level

	// These should NOT appear
	logger "debug message" debug
	logger "info message" info

	// These SHOULD appear
	logger "warn message" warn
	logger "error message" error

	logger free

	// Read log file and check contents
	"/tmp/test_log_levels.log" io::read_file! -> content

	// Check that debug/info are NOT present
	content "debug" str::contains not if {
		"debug filtered: ok" print nl
	}
	content "info" str::contains not if {
		"info filtered: ok" print nl
	}

	// Check that warn/error ARE present
	content "warn" str::contains if {
		"warn present: ok" print nl
	}
	content "error" str::contains if {
		"error present: ok" print nl
	}
}
