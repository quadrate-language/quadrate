// Test LevelOff disables all logging
use log
use io

fn main() {
	log::new! -> logger
	logger disable_stdout
	logger "/tmp/test_log_off.log" add_file!

	// Set level to OFF
	logger log::LevelOff set_level

	// Try to log at all levels
	logger "debug msg" debug
	logger "info msg" info
	logger "warn msg" warn
	logger "error msg" error

	logger free

	// File should be empty or not contain any messages
	"/tmp/test_log_off.log" io::read_file! -> content
	content "" eq if {
		"level off blocks all: ok" print nl
	}
}
