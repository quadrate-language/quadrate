// Test changing log level dynamically
use log
use io
use str

fn main() {
	log::new! -> logger
	logger disable_stdout
	logger "/tmp/test_log_level_change.log" add_file!

	// Start with DEBUG level
	logger log::LevelDebug set_level
	logger "debug1" debug
	logger "info1" info

	// Change to ERROR level
	logger log::LevelError set_level
	logger "debug2" debug
	logger "info2" info
	logger "error1" error

	// Back to INFO level
	logger log::LevelInfo set_level
	logger "info3" info

	logger free

	// Verify content
	"/tmp/test_log_level_change.log" io::read_file! -> content

	// debug1 should be present (level was DEBUG)
	content "debug1" str::contains if {
		"debug1 present: ok" print nl
	}

	// debug2 should NOT be present (level was ERROR)
	content "debug2" str::contains not if {
		"debug2 filtered: ok" print nl
	}

	// error1 should be present
	content "error1" str::contains if {
		"error1 present: ok" print nl
	}

	// info3 should be present (level back to INFO)
	content "info3" str::contains if {
		"info3 present: ok" print nl
	}
}
