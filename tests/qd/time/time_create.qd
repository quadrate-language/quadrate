use time

fn main() {
	// Create date and verify
	2024 1 15 12 30 0 time::date -> ts

	// Verify components
	ts time::year . nl
	ts time::month . nl
	ts time::day . nl
	ts time::hour . nl
	ts time::minute . nl

	// Round-trip: 1970-01-01 00:00:00 = 0
	1970 1 1 0 0 0 time::date . nl

	// Add days
	ts 7 time::add_days time::day . nl

	// Comparison
	ts ts 1 + time::before . nl
	ts ts 1 - time::after . nl
}
