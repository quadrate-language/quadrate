use time

fn main() {
	// Create date and verify
	2024 1 15 12 30 0 time::date -> ts

	// Verify components
	ts time::year print nl
	ts time::month print nl
	ts time::day print nl
	ts time::hour print nl
	ts time::minute print nl

	// Round-trip: 1970-01-01 00:00:00 = 0
	1970 1 1 0 0 0 time::date print nl

	// Add 7 days (ts is in seconds, so multiply days by 86400)
	ts 86400 7 * time::add time::day print nl

	// Comparison
	ts ts 1 + time::before print nl
	ts ts 1 - time::after print nl
}
