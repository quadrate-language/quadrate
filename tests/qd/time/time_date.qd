use time

fn main() {
	// Test known date: 2024-01-15 12:30:00 UTC = 1705321800
	1705321800 -> ts

	// Extract components
	ts time::year print nl
	ts time::month print nl
	ts time::day print nl
	ts time::hour print nl
	ts time::minute print nl
	ts time::second print nl

	// Weekday (Monday = 1)
	ts time::weekday print nl

	// Year day
	ts time::year_day print nl
}
