// Regression: Fix < operator bug (fbd0a29)
// The < token was being misinterpreted as generic type args when used
// as a comparison operator with PascalCase identifiers.
// The fix checks that '<' is immediately adjacent (no whitespace) for generics.

fn main() {
	// PascalCase variable with < comparison (NOT a generic)
	10 -> Count
	Count 20 lt if {
		"Count < 20: true" print nl
	} else {
		"Count < 20: false" print nl
	}

	// PascalCase variable compared against another value
	5 -> Max
	Max 3 gt if {
		"Max > 3: true" print nl
	} else {
		"Max > 3: false" print nl
	}

	// Multiple comparisons with PascalCase names
	100 -> Total
	50 -> Half
	Total Half gt if {
		"Total > Half: true" print nl
	} else {
		"Total > Half: false" print nl
	}

	Half Total lt if {
		"Half < Total: true" print nl
	} else {
		"Half < Total: false" print nl
	}

	// Equality check
	42 -> Value
	Value 42 eq if {
		"Value == 42: true" print nl
	} else {
		"Value == 42: false" print nl
	}

	"done" print nl
}
