// Regression: Thorough test of all comparison operators
// Ensures eq, neq, lt, gt, lteq, gteq all work correctly

fn main() {
	// eq
	"=== eq ===" print nl
	5 5 eq print nl      // 1
	5 6 eq print nl      // 0
	-1 -1 eq print nl    // 1
	0 0 eq print nl      // 1

	// neq
	"=== neq ===" print nl
	5 6 neq print nl     // 1
	5 5 neq print nl     // 0
	0 1 neq print nl     // 1

	// lt
	"=== lt ===" print nl
	3 5 lt print nl      // 1
	5 3 lt print nl      // 0
	5 5 lt print nl      // 0
	-1 0 lt print nl     // 1
	-5 -3 lt print nl    // 1

	// gt
	"=== gt ===" print nl
	5 3 gt print nl      // 1
	3 5 gt print nl      // 0
	5 5 gt print nl      // 0
	0 -1 gt print nl     // 1
	-3 -5 gt print nl    // 1

	// lte
	"=== lte ===" print nl
	3 5 lte print nl     // 1
	5 5 lte print nl     // 1
	6 5 lte print nl     // 0

	// gte
	"=== gte ===" print nl
	5 3 gte print nl     // 1
	5 5 gte print nl     // 1
	3 5 gte print nl     // 0

	"done" print nl
}
