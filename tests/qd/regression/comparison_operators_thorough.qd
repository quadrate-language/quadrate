// Test: Regression: Thorough test of all comparison operators
// Ensures eq, neq, lt, gt, lteq, gteq all work correctly

fn main() {
	// eq
	"=== eq ===" print nl
	5 5 == print nl      // 1
	5 6 == print nl      // 0
	-1 -1 == print nl    // 1
	0 0 == print nl      // 1

	// neq
	"=== neq ===" print nl
	5 6 != print nl     // 1
	5 5 != print nl     // 0
	0 1 != print nl     // 1

	// lt
	"=== lt ===" print nl
	3 5 < print nl      // 1
	5 3 < print nl      // 0
	5 5 < print nl      // 0
	-1 0 < print nl     // 1
	-5 -3 < print nl    // 1

	// gt
	"=== gt ===" print nl
	5 3 > print nl      // 1
	3 5 > print nl      // 0
	5 5 > print nl      // 0
	0 -1 > print nl     // 1
	-3 -5 > print nl    // 1

	// lte
	"=== lte ===" print nl
	3 5 <= print nl     // 1
	5 5 <= print nl     // 1
	6 5 <= print nl     // 0

	// gte
	"=== gte ===" print nl
	5 3 >= print nl     // 1
	5 5 >= print nl     // 1
	3 5 >= print nl     // 0

	"done" print nl
}
