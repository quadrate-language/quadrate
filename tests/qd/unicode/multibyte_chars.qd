// Test: multi-byte UTF-8 character handling.
// str is UTF-8 and counts codepoints, so a character costs one regardless of its encoding.
use strings

fn main() {
	// Length is in characters, whatever each one costs in bytes
	"=== Character lengths ===" print nl
	"A" strings::len print nl        // 1 (ASCII, 1 byte)
	"é" strings::len print nl        // 1 (Latin-1 Supplement, 2 bytes)
	"世" strings::len print nl       // 1 (CJK, 3 bytes)
	"🌍" strings::len print nl       // 1 (emoji, 4 bytes)

	// String with mixed byte-width characters
	"=== Mixed byte-widths ===" print nl
	"Aé世🌍" strings::len print nl   // 4 characters, 10 bytes
	"hello世界" strings::len print nl // 7 characters, 11 bytes

	// Comparison with multi-byte
	"=== Multi-byte comparison ===" print nl
	"世界" "世" strings::starts_with print nl    // 1
	"世界" "界" strings::ends_with print nl      // 1

	// Substring with multi-byte
	"=== Multi-byte contains ===" print nl
	"hello世界goodbye" "世界" strings::contains print nl  // 1
	"Привет мир" "вет" strings::contains print nl        // 1

	// Empty string edge cases
	"=== Empty string ===" print nl
	"" strings::len print nl              // 0
	"" "世" strings::contains print nl    // 0
	"世" "" strings::contains print nl    // 1

	"done" print nl
}
