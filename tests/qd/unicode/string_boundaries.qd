// Test: string boundary conditions
use strings

fn main() {
	// Very long strings
	"=== Long strings ===" print nl
	"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" len print nl  // 50
	"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" len print nl  // 100

	// Single character strings
	"=== Single char ===" print nl
	"a" print nl
	"Z" print nl
	"0" print nl
	" " len print nl   // 1 (print length instead of char)
	"!" print nl

	// Only whitespace
	"=== Whitespace only ===" print nl
	" " len print nl
	"  " len print nl
	"\t" len print nl
	"\n" len print nl
	"   " strings::trim len print nl  // 0 after trim

	// String with all special chars
	"=== Special chars ===" print nl
	"!@#$%^&*()" len print nl
	"<>[]{}|\\" len print nl
	".,;:!?'" len print nl

	// Repeated patterns
	"=== Patterns ===" print nl
	"abcabcabc" "abc" strings::contains print nl
	"abcabcabc" "abc" strings::starts_with print nl
	"abcabcabc" "abc" strings::ends_with print nl

	"done" print nl
}
