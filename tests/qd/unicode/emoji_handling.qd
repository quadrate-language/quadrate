// Test: emoji characters in strings
use strings

fn main() {
	// Basic emoji in strings
	"=== Basic emoji ===" print nl
	"Hello 🌍" print nl
	"🎉 Party!" print nl
	"👍" print nl

	// An emoji is one character, though it takes 4 bytes in UTF-8
	"=== Emoji lengths ===" print nl
	"🌍" strings::len print nl         // 1
	"🎉" strings::len print nl         // 1
	"👍" strings::len print nl         // 1

	// Strings with multiple emoji
	"=== Multiple emoji ===" print nl
	"🌍🎉👍" strings::len print nl     // 3
	"🌍🎉👍" print nl

	// Mixed emoji and ASCII
	"=== Mixed emoji and text ===" print nl
	"Hi 🌍!" strings::len print nl     // 5 characters, 8 bytes
	"A🎉B" strings::len print nl       // 3 characters, 6 bytes

	// Contains with emoji
	"=== Contains emoji ===" print nl
	"Hello 🌍 world" "🌍" strings::contains print nl   // 1
	"Hello world" "🌍" strings::contains print nl       // 0

	// Starts/ends with emoji
	"=== Starts/ends with emoji ===" print nl
	"🌍 Earth" "🌍" strings::starts_with print nl      // 1
	"Earth 🌍" "🌍" strings::ends_with print nl        // 1

	"done" print nl
}
