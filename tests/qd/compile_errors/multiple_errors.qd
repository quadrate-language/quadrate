// Test: compiler should report multiple errors at once
fn safe_div(i64 i64 -- i64)! {
	/
}

fn normal_func(i64 -- i64) {
	++
}

// Error 1: undefined function. In a function of its own, since past an unresolved name the
// checker stops trusting that function's stack model and would not report Error 4.
fn calls_undefined() {
	undefined_func
}

fn main() {
	// Error 2: a bare fallible call's status tested by `if` without `ok`
	10 5 safe_div if {
		print nl
	} else {
		drop
	}

	// Error 3: ! on non-fallible
	10 normal_func!
	print nl

	// Error 4: stack underflow
	*
}
