// Test: compiler should report multiple errors at once
fn safe_div(i64 i64 -- i64)! {
	/
}

fn normal_func(i64 -- i64) {
	++
}

fn main() {
	// Error 1: undefined function
	undefined_func

	// Error 2: fallible without if
	10 5 safe_div
	print nl

	// Error 3: ! on non-fallible
	10 normal_func!
	print nl

	// Error 4: stack underflow
	mul
}
