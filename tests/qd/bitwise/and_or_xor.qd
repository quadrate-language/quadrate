// Test: bitwise AND, OR, XOR operators
use bits

fn main() {
	// AND tests
	"=== AND ===" print nl
	10 12 bits::and print nl          // 1010 & 1100 = 1000 = 8
	255 15 bits::and print nl         // 0xFF & 0x0F = 15
	0 255 bits::and print nl          // 0
	255 255 bits::and print nl        // 255
	-1 255 bits::and print nl         // all 1s AND 0xFF = 255

	// OR tests
	"=== OR ===" print nl
	10 5 bits::or print nl            // 1010 | 0101 = 1111 = 15
	240 15 bits::or print nl          // 0xF0 | 0x0F = 0xFF = 255
	0 255 bits::or print nl           // 255
	0 0 bits::or print nl             // 0

	// XOR tests
	"=== XOR ===" print nl
	10 12 bits::xor print nl          // 1010 ^ 1100 = 0110 = 6
	255 255 bits::xor print nl        // 0 (same values cancel)
	255 0 bits::xor print nl          // 255
	15 10 bits::xor print nl          // 1111 ^ 1010 = 0101 = 5

	// Combined operations
	"=== Combined ===" print nl
	10 12 bits::and 3 bits::or print nl     // (8 | 3) = 11
	255 170 bits::xor 85 bits::and print nl // (0x55 & 0x55) = 85
}
