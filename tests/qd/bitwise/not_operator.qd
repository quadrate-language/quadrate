// Test: bitwise NOT operator
use bits

fn main() {
	// Basic NOT
	0 bits::not print nl              // -1 (all 1s)
	-1 bits::not print nl             // 0
	1 bits::not print nl              // -2

	// NOT with masks to see specific bits
	255 bits::not 255 bits::and print nl    // 0 (bottom 8 bits of ~0xFF)
	240 bits::not 255 bits::and print nl    // 0x0F = 15
	15 bits::not 255 bits::and print nl     // 0xF0 = 240

	// Double NOT is identity
	42 bits::not bits::not print nl         // 42
	-100 bits::not bits::not print nl       // -100

	// NOT combined with other ops
	10 bits::not 15 bits::and print nl      // ~1010 & 1111 = 0101 = 5
}
