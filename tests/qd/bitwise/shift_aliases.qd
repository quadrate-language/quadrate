// Test: shl and shr shift operations
use bits

fn main() {
	// Basic shift left with shl
	1 4 bits::shl print nl  // 16

	// Basic shift right with shr
	16 2 bits::shr print nl  // 4

	// Chain operations
	1 8 bits::shl 4 bits::shr print nl  // 16 ((1 shl 8) shr 4 = 256 shr 4)

	// Same using word forms
	1 4 bits::shl print nl  // 16
	16 2 bits::shr print nl  // 4

	// Larger values
	255 8 bits::shl print nl  // 65280
	65280 8 bits::shr print nl  // 255

	// Zero shifts
	42 0 bits::shl print nl  // 42
	42 0 bits::shr print nl  // 42
}
