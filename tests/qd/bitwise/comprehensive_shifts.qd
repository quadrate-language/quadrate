// Test: Comprehensive bit shift tests
use bits

fn main() {
	// Left shift basics
	"=== Left shift ===" print nl
	1 0 bits::shl print nl      // 1
	1 1 bits::shl print nl      // 2
	1 2 bits::shl print nl      // 4
	1 3 bits::shl print nl      // 8
	1 4 bits::shl print nl      // 16
	1 8 bits::shl print nl      // 256
	1 16 bits::shl print nl     // 65536
	1 31 bits::shl print nl     // 2147483648

	// Right shift basics
	"=== Right shift ===" print nl
	256 0 bits::shr print nl    // 256
	256 1 bits::shr print nl    // 128
	256 2 bits::shr print nl    // 64
	256 4 bits::shr print nl    // 16
	256 8 bits::shr print nl    // 1
	256 9 bits::shr print nl    // 0

	// Shift multiple bits
	"=== Multi-bit values ===" print nl
	255 1 bits::shl print nl    // 510
	255 4 bits::shl print nl    // 4080
	4080 4 bits::shr print nl   // 255

	// Shift and mask patterns
	"=== Shift and mask ===" print nl
	0xABCD 8 bits::shr print nl         // 0xAB = 171
	0xABCD 8 bits::shl print nl         // 0xABCD00 = 11259136
	0xABCD 0xFF bits::and print nl      // 0xCD = 205
	0xABCD 8 bits::shr 0xFF bits::and print nl // 0xAB = 171

	// Edge cases
	"=== Edge cases ===" print nl
	0 10 bits::shl print nl     // 0
	0 10 bits::shr print nl     // 0
	-1 1 bits::shr print nl     // arithmetic or logical shift?

	"done" print nl
}
