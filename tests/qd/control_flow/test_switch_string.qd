fn main() {
	// Test string switch
	"hello" switch {
		"hello" {
			"Matched hello" print nl
		}
		"world" {
			"Matched world" print nl
		}
		_ {
			"No match" print nl
		}
	}

	// Test with different value
	"world" switch {
		"hello" {
			"Matched hello" print nl
		}
		"world" {
			"Matched world" print nl
		}
		_ {
			"No match" print nl
		}
	}

	// Test default case
	"other" switch {
		"hello" {
			"Matched hello" print nl
		}
		"world" {
			"Matched world" print nl
		}
		_ {
			"Matched default" print nl
		}
	}
}
