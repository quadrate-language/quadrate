// Test: Regression: fallible switch Ok branch must properly consume result value
use io

def read_or_default(path:str -- content:str) {
	"" -> content
	path io::read_file switch {
		Ok { -> content }
		_ { drop "fallback" -> content }
	}
	content
}

fn main() {
	"/tmp/nonexistent_file_12345" read_or_default print nl
}
