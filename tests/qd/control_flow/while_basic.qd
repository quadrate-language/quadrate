// Test: `loop { cond while ... }` -- `while` takes a flag and leaves the loop when it is
// false. Zero-trip, break/continue, calls and nesting all covered.
fn is_small(n:i64 -- r:i64) {
	n 3 <
}

fn main() {
	0 -> i
	loop {
		i 5 < while
		i print nl
		i 1 + -> i
	}

	// A condition that is false to begin with runs the body no times.
	0 -> z
	loop {
		z 0 > while
		"never" print nl
	}
	"zero-trip" print nl

	// break and continue
	0 -> j
	loop {
		j 10 < while
		j 1 + -> j
		j 3 == if { continue }
		j 6 > if { break }
		j print nl
	}

	// a call in the condition
	0 -> k
	loop {
		k is_small while
		"k=" print k print nl
		k 1 + -> k
	}

	// a compound condition
	0 -> m
	loop {
		m 2 + 5 < while
		m 1 + -> m
	}
	"m=" print m print nl

	// nesting
	0 -> a
	loop {
		a 2 < while
		0 -> b
		loop {
			b 2 < while
			a print "," print b print nl
			b 1 + -> b
		}
		a 1 + -> a
	}

	// A statement before the loop runs once: the condition is what precedes `while` inside
	// the loop, nothing outside it.
	0 -> p
	"before" print nl
	loop {
		p 3 < while
		p 1 + -> p
	}
	"p=" print p print nl

	// A value pending on the stack under the loop is left alone.
	0 -> q
	42
	loop {
		q 3 < while
		q 1 + -> q
	}
	"pending=" print print nl
}
