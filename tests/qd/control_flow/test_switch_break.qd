// Test: break inside switch case blocks exits the enclosing loop, not the case.
// When there is no enclosing loop, break is a no-op and execution continues.
fn main() {
	// break with no enclosing loop is a no-op — 200 still prints
	5 switch {
		5 {
			100 print nl
			break
			200 print nl
		}
		_ {
			999 print nl
		}
	}

	// Same for default case — 400 still prints
	10 switch {
		1 {
			10 print nl
		}
		_ {
			300 print nl
			break
			400 print nl
		}
	}

	// Without break, both 500 and 600 print as expected
	7 switch {
		7 {
			500 print nl
			600 print nl
		}
		_ {
			999 print nl
		}
	}
}
