use regex

fn main() {
	// Multiple quantifiers
	"a+b+c+" "abc" regex::is_match print nl
	"a+b+c+" "aaabbbccc" regex::is_match print nl
	"a*b*c*" "" regex::is_match print nl
	"a*b*c*" "abc" regex::is_match print nl

	// Quantifier on char class
	"[a-z]+[0-9]+" "abc123" regex::is_match print nl
	"[a-z]+[0-9]+" "123abc" regex::is_match print nl

	// Multiple alternations
	"a|b|c" "a" regex::is_match print nl
	"a|b|c" "b" regex::is_match print nl
	"a|b|c" "c" regex::is_match print nl
	"a|b|c" "d" regex::is_match print nl

	// Dot with quantifiers
	".*" "" regex::is_match print nl
	".*" "anything" regex::is_match print nl
	".+" "x" regex::is_match print nl
	".+" "" regex::is_match print nl

	// Mixed patterns
	"[a-z]+@[a-z]+\\.[a-z]+" "user@example.com" regex::is_match print nl
	"[0-9]+\\.[0-9]+" "3.14" regex::is_match print nl
}
