use regex

fn main() {
	// Empty pattern matches empty string
	"" "" regex::test print nl

	// Empty pattern doesn't match non-empty
	"" "x" regex::test print nl

	// Single character patterns
	"a" "a" regex::test print nl
	"a" "b" regex::test print nl
	"a" "" regex::test print nl

	// Long patterns
	"abcdefghij" "abcdefghij" regex::test print nl
	"abcdefghij" "abcdefghix" regex::test print nl

	// Repeated same char
	"aaa" "aaa" regex::test print nl
	"aaa" "aa" regex::test print nl
	"aaa" "aaaa" regex::test print nl

	// Star edge cases
	"a*" "" regex::test print nl
	"a*" "a" regex::test print nl
	"a*" "aaaa" regex::test print nl

	// Question edge cases
	"a?" "" regex::test print nl
	"a?" "a" regex::test print nl
	"a?" "aa" regex::test print nl
}
