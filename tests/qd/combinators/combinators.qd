// Test: the combinators, with the function value written in place (inlined) and held in a
// local (called)
struct Point {
	x: i64
	y: i64
}

def longest<T>(arr:[]T first:T -- r:T) {
	arr first fn { swap drop } fold
}

def twice_each(arr:[]i64 -- r:[]i64) {
	arr fn { 2 * } map
}

fn main() {
	// In place
	10 20 fn { 1 + } dip print " " print print nl              // 20 11
	1 2 3 fn { + } dip print " " print print nl                // 3 3
	2 fn { dup * } keep print " " print print nl               // 2 4
	5 fn { 1 + } fn { 2 * } bi print " " print print nl        // 10 6
	5 fn { 1 + } fn { 2 * } fn { 3 - } tri print " " print print " " print print nl   // 2 10 6
	3 4 fn { 10 * } both print " " print print nl              // 40 30
	1 3 fn { 2 * } times print nl                              // 8
	0 [1 2 3] fn { + } each print nl                           // 6
	[1 2 3] fn { dup * } map 2 nth print nl                    // 9
	[1 2 3 4] fn { 2 % 0 == } filter len print nl            // 2
	[1 2 3 4] 0 fn { + } fold print nl                         // 10

	// Held in a local
	fn { 100 + } -> add100
	1 2 add100 dip print " " print print nl                    // 2 101
	[1 2] add100 map 1 nth print nl                            // 102
	3 add100 keep print " " print print nl                     // 3 103
	0 2 add100 times print nl                                  // 200

	// A capture, and a body with a loop of its own
	3 -> k
	[1 2 3] fn { k * } map 2 nth print nl                      // 9
	[1 2 3] fn { -> v 0 0 v 1 for i { 1 + } } map 1 nth print nl   // 2

	// Nested, and inside a loop
	[[1 2] [3 4]] fn { 0 swap fn { + } each } map 1 nth print nl   // 7
	0 0 3 1 for i { i fn { 10 * } dip + } print nl             // 12

	// Generic, and in a function of its own
	["a" "bb"] "" longest print nl                              // bb
	[5 6] twice_each 1 nth print nl                            // 12

	// Struct elements keep their type
	[Point { x = 1 y = 2 } Point { x = 3 y = 4 }] fn { <<y } map 1 nth print nl   // 4
	[Point { x = 1 y = 2 } Point { x = 3 y = 4 }] fn { <<x 1 > } filter 0 nth <<y print nl   // 4

	// Strings
	["a" "bb" "ccc"] "" fn { swap drop } fold print nl         // ccc
}
