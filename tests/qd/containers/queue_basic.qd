use ct

fn main() {
	// Create empty queue
	Queue<i64> { data = 0 head = 0 tail = 0 len = 0 cap = 0 } -> q

	// Test is_empty
	q is_empty if { "empty: yes" print nl }

	// Enqueue elements (FIFO: first in, first out)
	q 1 enqueue! -> q
	q 2 enqueue! -> q
	q 3 enqueue! -> q

	"length: " print q length print nl

	// Peek (should be 1, first enqueued)
	"peek: " print q peek! print nl

	// Dequeue (should come out in order 1, 2, 3)
	q dequeue! -> q -> val
	"dequeue 1: " print val print nl

	q dequeue! -> q -> val
	"dequeue 2: " print val print nl

	"remaining: " print q length print nl

	// Peek remaining
	"peek after: " print q peek! print nl

	q dequeue! -> q -> val
	"dequeue 3: " print val print nl

	q is_empty if { "now empty: yes" print nl }

	q release
	"done" print nl
}
