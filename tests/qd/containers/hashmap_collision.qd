use ct

fn main() {
	// Test collision handling and removal with tombstones
	HashMap<i64> { keys = 0 values = 0 states = 0 len = 0 cap = 0 } -> m

	// Insert several items
	m "a" 1 insert! -> m
	m "b" 2 insert! -> m
	m "c" 3 insert! -> m
	m "d" 4 insert! -> m
	m "e" 5 insert! -> m

	"initial: len=" print m length print nl

	// Remove middle items (creates tombstones)
	m "b" remove! -> m
	m "d" remove! -> m
	"after removing b,d: len=" print m length print nl

	// Verify remaining items
	"a: " print m "a" get! print nl
	"c: " print m "c" get! print nl
	"e: " print m "e" get! print nl

	// Insert new items (should reuse tombstone slots)
	m "f" 6 insert! -> m
	m "g" 7 insert! -> m
	"after adding f,g: len=" print m length print nl

	// Verify all items
	"a: " print m "a" get! print nl
	"c: " print m "c" get! print nl
	"e: " print m "e" get! print nl
	"f: " print m "f" get! print nl
	"g: " print m "g" get! print nl

	// Verify removed items not found
	m "b" has if { "b found (ERROR)" print nl } else { "b not found (OK)" print nl }
	m "d" has if { "d found (ERROR)" print nl } else { "d not found (OK)" print nl }

	m release
	"done" print nl
}
