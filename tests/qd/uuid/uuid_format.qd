use str
use uuid

fn main() {
	// Generate seeded UUID and verify format
	42 uuid::v4_seeded -> id
	id . nl

	// Check version nibble (position 14 should be '4')
	id 14 str::char_at . nl

	// Check dash positions (8, 13, 18, 23)
	id 8 str::char_at . nl
	id 13 str::char_at . nl
	id 18 str::char_at . nl
	id 23 str::char_at . nl

	// Different seeds produce different UUIDs (just print them)
	1 uuid::v4_seeded . nl
	2 uuid::v4_seeded . nl
}
