// Test SQLite type affinity and coercion
use sqlite

fn main() {
	":memory:" sqlite::open! -> db

	// SQLite is dynamically typed - column type is just a hint
	"CREATE TABLE flexible (id INTEGER PRIMARY KEY, val)" db sqlite::exec!

	// Insert different types into same column
	"INSERT INTO flexible (val) VALUES (42)" db sqlite::exec!
	"INSERT INTO flexible (val) VALUES (3.14)" db sqlite::exec!
	"INSERT INTO flexible (val) VALUES ('hello')" db sqlite::exec!
	"INSERT INTO flexible (val) VALUES (NULL)" db sqlite::exec!

	// Query and check actual types
	"SELECT id, val, typeof(val) FROM flexible ORDER BY id" db sqlite::prepare! -> q

	loop {
		q sqlite::step! 0 == if { break }
		0 q sqlite::column_int -> id
		1 q sqlite::column_type -> typ

		id print ": type=" print typ print " val=" print

		// Read as appropriate type
		typ 1 == if {  // INTEGER
			1 q sqlite::column_int print
		}
		typ 2 == if {  // FLOAT
			1 q sqlite::column_float print
		}
		typ 3 == if {  // TEXT
			1 q sqlite::column_text print
		}
		typ 5 == if {  // NULL
			"NULL" print
		}

		nl
	}

	q sqlite::finalize

	// Test reading int as float
	"SELECT val FROM flexible WHERE id = 1" db sqlite::prepare! -> q2
	q2 sqlite::step! drop
	0 q2 sqlite::column_float -> as_float
	"int as float: " print as_float print nl
	q2 sqlite::finalize

	// Test reading float as int (truncates)
	"SELECT val FROM flexible WHERE id = 2" db sqlite::prepare! -> q3
	q3 sqlite::step! drop
	0 q3 sqlite::column_int -> as_int
	"float as int: " print as_int print nl
	q3 sqlite::finalize

	db sqlite::close
}
