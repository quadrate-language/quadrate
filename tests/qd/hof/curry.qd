// Test: Currying (partial application)
use hof

fn main( -- ) {
	// curry: fix first argument
	// add5 = curry(5, +)
	5 fn (a:i64 b:i64 -- r:i64) { -> b -> a a b + } hof::curry -> add5
	10 add5 call print nl  // 15
	20 add5 call print nl  // 25

	// curry_right: fix second argument
	// half = curry_right(2, /)
	2 fn (a:i64 b:i64 -- r:i64) { -> b -> a a b / } hof::curry_right -> half
	10 half call print nl  // 5
	100 half call print nl  // 50

	// subtract3 = curry_right(3, -)
	3 fn (a:i64 b:i64 -- r:i64) { -> b -> a a b - } hof::curry_right -> sub3
	10 sub3 call print nl  // 7
}
