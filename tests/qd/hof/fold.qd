// Test: Fold/reduce operations
use hof

fn main( -- ) {
	// Create array [1, 2, 3, 4, 5]
	0 make<i64> 1 append 2 append 3 append 4 append 5 append -> arr

	// fold: sum (1+2+3+4+5 = 15)
	arr 5 0 fn (acc:i64 x:i64 -- r:i64) { -> x -> acc acc x + } hof::fold print nl

	// fold: product (1*2*3*4*5 = 120)
	arr 5 1 fn (acc:i64 x:i64 -- r:i64) { -> x -> acc acc x * } hof::fold print nl

	// fold_right: same result for commutative operations
	arr 5 0 fn (x:i64 acc:i64 -- r:i64) { -> acc -> x x acc + } hof::fold_right print nl

	arr free
}
