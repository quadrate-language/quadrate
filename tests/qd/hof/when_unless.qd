use hof

fn main() {
    // when applies only if condition true
    5 1 fn (x:i64 -- r:i64) { 2 * } hof::when print nl
    5 0 fn (x:i64 -- r:i64) { 2 * } hof::when print nl

    // unless applies only if condition false
    5 0 fn (x:i64 -- r:i64) { 2 * } hof::unless print nl
    5 1 fn (x:i64 -- r:i64) { 2 * } hof::unless print nl
}
