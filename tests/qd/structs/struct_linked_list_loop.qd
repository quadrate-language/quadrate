// Traverse linked list with a loop
struct Item {
	value:i64
	next:*Item
}

fn list_sum(cur:ptr -- total:i64) {
	0 -> sum
	loop {
		cur null eq if { break }
		sum cur @value + -> sum
		cur @next -> cur
	}
	sum
}

fn list_len(cur:ptr -- n:i64) {
	0 -> count
	loop {
		cur null eq if { break }
		count 1 + -> count
		cur @next -> cur
	}
	count
}

fn main() {
	Item { value = 10 next = null } -> a
	Item { value = 20 next = a } -> b
	Item { value = 30 next = b } -> c
	Item { value = 40 next = c } -> d

	d list_len print nl
	d list_sum print nl

	// Empty list
	null list_len print nl
	null list_sum print nl
}
