// Test type error when passing wrong struct type to a struct field
struct Point {
	x:f64
	y:f64
}

struct Color {
	r:i64
	g:i64
	b:i64
}

struct Rectangle {
	origin:Point
	width:f64
	height:f64
}

fn main( -- ) {
	// Create a Color (wrong type)
	Color {
		r = 255
		g = 128
		b = 64
	} -> c

	// Try to use Color where Point is expected - should error
	Rectangle {
		origin = c
		width = 10.0
		height = 5.0
	} -> rect
}
