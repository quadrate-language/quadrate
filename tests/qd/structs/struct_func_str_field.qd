// Test function accessing str field
struct Person {
	name:str
	age:f64
}

fn get_age(p:ptr -- age:f64) {
	-> person
	person @age
}

fn test_str_field( -- ) {
	Person {
		name: "Alice"
		age: 25.0
	} -> p1
	p1 get_age . nl

	Person {
		name: "Bob"
		age: 30.0
	} -> p2
	p2 get_age . nl
}

fn main( -- ) {
	test_str_field
}
