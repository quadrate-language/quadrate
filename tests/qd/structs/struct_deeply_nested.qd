// Test: deeply nested structs
struct Point {
	x:f64
	y:f64
}

struct Size {
	width:f64
	height:f64
}

struct Rect {
	origin:Point
	size:Size
}

struct Window {
	title:str
	bounds:Rect
}

fn main() {
	// Build the nested structure using named field syntax
	Window { title = "Hello" bounds = Rect { origin = Point { x = 10.0 y = 20.0 } size = Size { width = 100.0 height = 50.0 } }
	}
	-> win

	// Access deeply nested fields using chained access
	win <<bounds <<origin <<x print nl
	win <<bounds <<origin <<y print nl
	win <<bounds <<size <<width print nl
	win <<bounds <<size <<height print nl
}
