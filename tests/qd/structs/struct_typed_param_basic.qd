// Test: basic typed struct parameter syntax
use math

struct Point {
	x:f64
	y:f64
}

// Function with typed struct parameter
def magnitude(p:Point -- result:f64) {
	p <<x dup * p <<y dup * + math::sqrt
}

// Function with typed struct parameter that modifies nothing
def print_point(p:Point -- ) {
	"Point(" print p <<x print ", " print p <<y print ")" print nl
}

fn main() {
	Point {
		x = 3.0
		y = 4.0
	} -> pt
	pt print_point
	"Magnitude: " print pt magnitude print nl
}
