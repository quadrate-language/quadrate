// Test cross-module typed struct parameters
use geometry

fn main() {
	// Create a Vec2 using the module's struct
	3.0 4.0 new geometry::Vec2 -> v1

	// Call function with typed parameter
	"Length of (3,4): " print v1 geometry::length print nl

	// Create another and add them
	1.0 2.0 new geometry::Vec2 -> v2
	v1 v2 geometry::add -> v3
	"Added (3,4) + (1,2): (" print v3 <<x print ", " print v3 <<y print ")" print nl
	"Length of sum: " print v3 geometry::length print nl

	// Scale a vector
	v1 2.0 geometry::scale -> v4
	"Scaled (3,4) by 2: (" print v4 <<x print ", " print v4 <<y print ")" print nl
}
