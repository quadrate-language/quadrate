// Test: `[n]T` works as a struct-construction field value.
//
// It used to be parsed only in expression position, so the field-value parser built the
// instruction without its type parameter and the backend lowered it to a `qd_make` that
// does not exist -- a link failure, not a compile error.
struct Cell { v: i64 = 0 }

struct Grid {
	cells: []Cell
	n:     i64
}

fn main() {
	Grid { cells = [4]Cell n = 2 } -> g
	g <<cells 0 Cell { v = 42 } set
	g <<cells 0 nth -> c
	c <<v print nl
	g <<n print nl

	// and the qualified form still parses in expression position
	[3]Cell -> arr
	arr len print nl
}
