// Test: Negative test: struct missing multiple required fields
struct Point {
	x:f64
	y:f64
}

struct Color {
	r:f64
	g:f64
	b:f64
}

def distance_from_origin(point:Point -- d:f64) {
	point <<x point <<x *
	point <<y point <<y *
	+ sqrt
}

fn main() {
	Color {
		r = 1.0
		g = 0.5
		b = 0.0
	} -> c
	c distance_from_origin print nl  // ERROR: Color missing x and y fields
}
