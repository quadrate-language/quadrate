// Test multiple typed struct parameters in one function
use math

struct Point {
    x:f64
    y:f64
}

// Function with two of the same typed struct parameters
// Parameters are bound in reverse stack order (last param = top of stack)
fn distance(p1:Point p2:Point -- result:f64) {
    -> p2 -> p1
    p1 @x p2 @x - dup *
    p1 @y p2 @y - dup *
    + math::sqrt
}

// Function with two typed parameters plus a primitive
fn weighted_midpoint(p1:Point p2:Point weight:f64 -- result:ptr) {
    -> weight -> p2 -> p1
    p1 @x weight * p2 @x 1.0 weight - * +
    p1 @y weight * p2 @y 1.0 weight - * +
    new Point
}

// Function to add two points
fn add_points(a:Point b:Point -- result:ptr) {
    -> b -> a
    a @x b @x +
    a @y b @y +
    new Point
}

fn main( -- ) {
    // Create test structs
    0.0 0.0 new Point -> origin
    3.0 4.0 new Point -> pt1
    6.0 8.0 new Point -> pt2

    // Test distance between two points
    pt1 pt2 distance -> d
    "Distance from (3,4) to (6,8): " . d . nl

    // Test distance from origin
    origin pt1 distance -> d2
    "Distance from origin to (3,4): " . d2 . nl

    // Test add_points
    pt1 pt2 add_points -> sum
    "Sum of (3,4) + (6,8): (" . sum @x . ", " . sum @y . ")" . nl

    // Test weighted midpoint (0.5 = regular midpoint)
    pt1 pt2 0.5 weighted_midpoint -> mid
    "Midpoint: (" . mid @x . ", " . mid @y . ")" . nl

    // Test weighted more towards pt1
    pt1 pt2 0.75 weighted_midpoint -> w1
    "75% towards pt1: (" . w1 @x . ", " . w1 @y . ")" . nl

    // Structs are automatically released at end of scope
}
