struct Point {
	x:f64
	y:f64
}

fn test_nested_access() {
	// Test multiple accesses from same struct
	Point {
		x = 5.0
		y = 10.0
	} -> p

	// Access x twice
	p @x print nl
	p @x print nl

	// Access y
	p @y print nl

	// Access x and y separately (adding field access results doesn't work due to type checker limitation)
	p @x print nl
	p @y print nl
}

fn main() {
	test_nested_access
}
