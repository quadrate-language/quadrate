// Test mixing typed struct params with regular ptr and other types

struct Point {
    x:f64
    y:f64
}

struct Config {
    scale:f64
    enabled:i64
}

// Mix typed struct with primitives
// Binding order is reversed (last param = top of stack)
fn scale_point(p:Point factor:f64 -- result:ptr) {
    -> factor -> p
    p @x factor *
    p @y factor *
    Point
}

// Mix typed struct with untyped ptr (legacy compatibility)
fn copy_to(src:Point dest:ptr -- ) {
    -> dest -> src
    // Just demonstrate both work - src is typed, dest is generic ptr
    "Copying from typed Point" . nl
}

// Mix multiple types - simpler version
fn apply_scale(p:Point c:Config -- result:f64) {
    -> c -> p
    c @enabled if {
        p @x c @scale * p @y c @scale * +
    } else {
        0.0
    }
}

// Typed first, primitives after
fn offset_point(p:Point dx:f64 dy:f64 -- result:ptr) {
    -> dy -> dx -> p
    p @x dx +
    p @y dy +
    Point
}

fn main( -- ) {
    // Test scale_point
    3.0 4.0 Point -> pt
    pt 2.0 scale_point -> scaled
    "Scaled (3,4) by 2: (" . scaled @x . ", " . scaled @y . ")" . nl

    // Test apply_scale
    2.0 1 Config -> cfg
    "Apply scale enabled: " . pt cfg apply_scale . nl

    0.0 0 Config -> cfg_disabled
    "Apply scale disabled: " . pt cfg_disabled apply_scale . nl

    // Test offset
    pt 10.0 20.0 offset_point -> offset
    "Offset: (" . offset @x . ", " . offset @y . ")" . nl
}
