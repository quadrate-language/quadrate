// Test: mixing typed struct params with regular ptr and other types
struct Point {
	x:f64
	y:f64
}

struct Config {
	scale:f64
	enabled:i64
}

// Mix typed struct with primitives
// Binding order is reversed (last param = top of stack)
fn scale_point(p:Point factor:f64 -- result:Point) {
	Point {
		x = p <<x factor *
		y = p <<y factor *
	}
}

// Mix typed struct with another struct
fn copy_to(src:Point dest:Point -- ) {
	// Just demonstrate both work - src is typed, dest is generic ptr
	"Copying from typed Point" print nl
}

// Mix multiple types - simpler version
fn apply_scale(p:Point c:Config -- result:f64) {
	c <<enabled if {
		p <<x c <<scale * p <<y c <<scale * +
	} else {
		0.0
	}
}

// Typed first, primitives after
fn offset_point(p:Point dx:f64 dy:f64 -- result:Point) {
	Point {
		x = p <<x dx +
		y = p <<y dy +
	}
}

fn main() {
	// Test scale_point
	Point {
		x = 3.0
		y = 4.0
	} -> pt
	pt 2.0 scale_point -> scaled
	"Scaled (3,4) by 2: (" print scaled <<x print ", " print scaled <<y print ")" print nl

	// Test apply_scale
	Config {
		scale = 2.0
		enabled = 1
	} -> cfg
	"Apply scale enabled: " print pt cfg apply_scale print nl

	Config {
		scale = 0.0
		enabled = 0
	} -> cfg_disabled
	"Apply scale disabled: " print pt cfg_disabled apply_scale print nl

	// Test offset
	pt 10.0 20.0 offset_point -> offset
	"Offset: (" print offset <<x print ", " print offset <<y print ")" print nl
}
