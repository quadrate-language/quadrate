// Negative test: str vs ptr type mismatch
struct WithStr {
	data:str
	name:str
}

struct WithPtr {
	data:ptr
}

fn use_str_field(x:WithStr -- ) {
	x <<data drop  // Expects str field
	x <<name drop  // Expects name field (unique to WithStr)
}

fn main() {
	// Pass WithPtr to function expecting WithStr - type mismatch!
	WithPtr { data = null } -> p
	p use_str_field
}
