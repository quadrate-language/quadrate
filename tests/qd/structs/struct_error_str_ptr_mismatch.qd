// Negative test: str vs ptr type mismatch
struct WithStr {
  data:str
  name:str
}

struct WithPtr {
  data:ptr
}

fn use_str_field( obj:ptr -- ) {
  -> x
  x @data drop  // Expects str field
  x @name drop  // Expects name field (unique to WithStr)
}

fn main( -- ) {
  // Pass new WithPtr to function expecting new WithStr - type mismatch!
  0 new WithPtr -> p
  p use_str_field
}
