// Test: struct multiple
struct Vec2 {
	x:f64
	y:f64
}

struct Vec3 {
	x:f64
	y:f64
	z:f64
}

fn test_multiple() {
	// Test Vec2
	Vec2 {
		x = 1.0
		y = 2.0
	} -> v2
	v2 <<x print nl
	v2 <<y print nl

	// Test Vec3
	Vec3 {
		x = 10.0
		y = 20.0
		z = 30.0
	} -> v3
	v3 <<x print nl
	v3 <<y print nl
	v3 <<z print nl
}

fn main() {
	test_multiple
}
