// Test nested module struct with basic field access
// Ensures Vec3 from math module can be stored in struct and accessed
use math

struct State {
	pos:math::Vec3
	vel:math::Vec3
	mass:f64
}

fn main() {
	// Create Vec3 values
	math::Vec3 { x = 3.0 y = 4.0 z = 0.0 } -> p
	math::Vec3 { x = 100.0 y = 200.0 z = 300.0 } -> v

	// Create state with nested Vec3
	State { pos = p vel = v mass = 42.0 } -> s

	// Access scalar field
	s @mass print nl

	// Access nested Vec3 and use its fields
	s @pos -> pos
	pos @x print nl
	pos @y print nl
	pos @z print nl

	// Chained access
	s @vel @x print nl
	s @vel @y print nl
	s @vel @z print nl
}
