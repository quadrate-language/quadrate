// Test: `>>field drop` — writes the field and discards the struct, leaving nothing
struct Counter { value: i64 }

fn bump(c:Counter -- ) {
	c c <<value 1 + >>value drop
}

fn reset(c:Counter -- ) {
	c 0 >>value drop
}

fn main() {
	Counter { value = 0 } -> c

	// >>field drop in function with no outputs
	c bump
	c <<value print nl   // 1

	c bump
	c bump
	c <<value print nl   // 3

	c reset
	c <<value print nl   // 0

	// >>field drop inline
	c 42 >>value drop
	c <<value print nl   // 42
}
