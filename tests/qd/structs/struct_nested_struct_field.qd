// Test struct with nested struct field (custom datatype)
struct Point {
	x:f64
	y:f64
}

struct Rectangle {
	origin:Point
	width:f64
	height:f64
}

fn main() {
	// Create a rectangle with nested Point as origin field
	Rectangle {
		origin = Point { x = 1.0 y = 2.0 }
		width = 10.0
		height = 5.0
	} -> rect

	// Access nested struct fields using chained access
	rect @origin @x print nl
	rect @origin @y print nl
	rect @width print nl
	rect @height print nl
}
