// Test nested function calls with typed struct parameters
use math

struct Point {
	x:f64
	y:f64
}

// Helper to get magnitude
fn magnitude(v:Point -- result:f64) {
	v <<x dup * v <<y dup * + math::sqrt
}

// Helper to get x component
fn get_x(v:Point -- result:f64) {
	v <<x
}

// Helper to get y component
fn get_y(v:Point -- result:f64) {
	v <<y
}

// Function that calls other typed functions
fn sum_components(v:Point -- result:f64) {
	v get_x v get_y +
}

// Chain of nested calls
fn double_sum(v:Point -- result:f64) {
	v sum_components 2.0 *
}

// Call different functions on same parameter
fn describe_vec(v:Point -- ) {
	"Vector: x=" print v get_x print
	" y=" print v get_y print
	" magnitude=" print v magnitude print
	" sum=" print v sum_components print nl
}

fn main() {
	Point {
		x = 3.0
		y = 4.0
	} -> v

	"Components:" print nl
	"  x: " print v get_x print nl
	"  y: " print v get_y print nl
	"  magnitude: " print v magnitude print nl
	"  sum: " print v sum_components print nl
	"  double_sum: " print v double_sum print nl

	v describe_vec
}
