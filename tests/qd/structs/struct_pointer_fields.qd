struct Inner {
	value:f64
}

struct Outer {
	inner:*Inner
	scale:f64
}

fn test_pointer_fields() {
	// Create inner struct
	Inner { value = 42.0 } -> i

	// Create outer struct with pointer to inner
	Outer {
		inner = i
		scale = 2.0
	} -> o

	// Access the scale from outer
	o <<scale print nl

	// Access the inner pointer from outer
	o <<inner -> inner_ptr

	// Access value from inner via pointer
	inner_ptr <<value print nl
}

fn main() {
	test_pointer_fields
}
