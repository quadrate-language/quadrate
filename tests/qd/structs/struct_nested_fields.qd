// Test: multiple field accesses on same struct
struct Rectangle {
	width:f64
	height:f64
}

def area(rect:Rectangle -- a:f64) {
	rect <<width rect <<height *
}

def perimeter(rect:Rectangle -- p:f64) {
	rect <<width rect <<height + 2.0 *
}

fn test_rectangle() {
	Rectangle {
		width = 5.0
		height = 3.0
	} -> r
	r area print nl
	r perimeter print nl
}

fn main() {
	test_rectangle
}
