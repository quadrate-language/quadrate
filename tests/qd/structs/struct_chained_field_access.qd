// Test chained field access (rect <<origin <<x or rect <<origin <<x)
struct Point {
	x:f64
	y:f64
}

struct Rectangle {
	origin:Point
	width:f64
	height:f64
}

fn main() {
	// Create rectangle with nested Point
	Rectangle {
		origin = Point { x = 3.0 y = 4.0 }
		width = 100.0
		height = 50.0
	} -> rect

	// Chained field access with spaces
	rect <<origin <<x print nl
	rect <<origin <<y print nl

	// Compact syntax without spaces
	rect <<origin <<x print nl
	rect <<origin <<y print nl

	// Regular field access
	rect <<width print nl
	rect <<height print nl
}
