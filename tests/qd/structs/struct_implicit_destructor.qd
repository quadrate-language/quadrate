// Test implicit destructors for nested structs and strings
// When freeing a struct, nested struct fields and string fields are automatically freed

struct Inner {
  value:i64
  name:str
}

struct Outer {
  inner:Inner
  data:i64
}

fn main( -- ) {
  // Create inner struct with string field
  42 "hello" Inner -> i

  // Create outer struct containing inner
  i 100 Outer -> o
  // i's ownership transfers to o

  // Access nested fields
  o @inner @value . nl
  o @inner @name . nl
  o @data . nl
  // Auto-released - implicit destructor frees inner and string
}
