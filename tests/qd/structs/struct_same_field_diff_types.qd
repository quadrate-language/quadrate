// Test: Edge case: same field name in different structs with compatible types
struct PersonWithFloat {
	value:f64
}

struct PersonWithInt {
	value:i64
}

def get_float_value(obj:PersonWithFloat -- v:f64) {
	obj <<value
}

def get_int_value(obj:PersonWithInt -- v:i64) {
	obj <<value
}

fn test_same_field() {
	// Float version - exact match
	PersonWithFloat { value = 3.14 } -> p1
	p1 get_float_value print nl

	// Int version - the parameter type says which struct
	PersonWithInt { value = 42 } -> p2
	p2 get_int_value print nl
}

fn main() {
	test_same_field
}
