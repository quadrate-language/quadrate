// Test: that typed parameters correctly disambiguate same-named fields
struct Circle {
	x:f64
	y:f64
	radius:f64
}

struct Rectangle {
	x:f64
	y:f64
	width:f64
	height:f64
}

// Both have x and y, but typed parameter scopes correctly
fn get_circle_x(c:Circle -- result:f64) {
	c <<x
}

fn get_rect_x(r:Rectangle -- result:f64) {
	r <<x
}

// This should error because Circle has no 'width' field
fn get_circle_width(c:Circle -- result:f64) {
	c <<width
}

fn main() {
	Circle {
		x = 0.0
		y = 0.0
		radius = 5.0
	} -> circ
	Rectangle {
		x = 10.0
		y = 20.0
		width = 100.0
		height = 50.0
	} -> rect

	"Circle x: " print circ get_circle_x print nl
	"Rect x: " print rect get_rect_x print nl
}
