// Test error when accessing field that doesn't exist on declared struct type

struct Point {
    x:f64
    y:f64
}

struct Rectangle {
    width:f64
    height:f64
}

// Function declares new Point but tries to access width (Rectangle field)
fn bad_function(p:Point -- result:f64) {
    -> p
    p @width  // ERROR: new Point has no field 'width'
}

fn main( -- ) {
    3.0 4.0 new Point -> pt
    pt bad_function . nl
}
