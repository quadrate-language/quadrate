// Test bytes operations (copy, fill, compare)
use bytes
use mem

fn main( -- ) {
	16 mem::alloc -> buf1
	16 mem::alloc -> buf2

	// Fill buf1 with 'A' (65)
	buf1 0 4 65 bytes::fill
	buf1 0 mem::get_byte print nl
	buf1 3 mem::get_byte print nl

	// Copy from buf1 to buf2 (dst, dst_off, src, src_off, count)
	buf2 0 buf1 0 4 bytes::copy
	buf2 0 mem::get_byte print nl
	buf2 3 mem::get_byte print nl

	// Compare equal
	buf1 0 buf2 0 4 bytes::compare print nl

	// Modify buf1[0] to 'B' (66) - now buf1 > buf2
	buf1 0 66 mem::set_byte
	buf1 0 buf2 0 4 bytes::compare print nl

	// Modify buf2[0] to 'C' (67) - now buf1 < buf2
	buf2 0 67 mem::set_byte
	buf1 0 buf2 0 4 bytes::compare print nl

	// Zero length compare
	buf1 0 buf2 0 0 bytes::compare print nl

	buf1 mem::free
	buf2 mem::free
}
