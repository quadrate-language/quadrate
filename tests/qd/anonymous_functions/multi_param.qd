// Test: anonymous function with multiple parameters
fn main() {
    // Anonymous function with two inputs
    fn (i64 i64 -- i64) { + } -> add_fn
    3 4 add_fn call print nl

    // Anonymous function with more operations
    fn (i64 i64 -- i64) { + 10 * } -> add_mul
    2 3 add_mul call print nl
}
