// Test: HTTP GET request
use http

fn main( -- ) {
	"https://example.com" http::get switch {
		Ok {
			-> resp
			resp <<status 200 ==
			if {
				"status ok" print nl
			}
			"body length:" print resp <<body len print nl
			resp http::close
		}
		_ {
			-> err
			"error:" print err print nl
		}
	}
}
