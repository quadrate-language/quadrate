// Test: HTTP with invalid URL
use http

def check(url:str -- ) {
	url http::get switch {
		Ok {
			-> resp
			"unexpected success" print nl
			resp http::close
		}
		6 {
			drop
			"invalid url error" print nl
		}
		_ {
			drop
			"other error" print nl
		}
	}
}

fn main( -- ) {
	// Invalid URL (no scheme) - error code 6 = ErrInvalidUrl
	"invalid-url" check
	// A line break in the path would inject headers or a second request
	"http://127.0.0.1/a HTTP/1.1\r\nX-Injected: 1\r\n\r\nGET /b" check
	// The host must be a plain hostname or IP
	"http://exa mple.com/" check
}
