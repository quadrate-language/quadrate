// Test: sibling file defines functions that operate on struct from main file

struct Counter {
	value:i64
}

fn main() {
	Counter { value = 10 } -> c

	// Use function defined in sibling file
	c counter_increment -> c2
	c2 <<value print nl

	c2 counter_increment -> c3
	c3 counter_increment -> c3
	c3 <<value print nl

	// Use another function from sibling
	c3 counter_double -> c4
	c4 <<value print nl
}
