// Test: method calls from sibling files using external module types
use math

struct State {
	pos:math::Vec3
}

// Test calling method that returns f64 (works correctly)
fn get_magnitude(s:State -- mag:f64) {
	s <<pos -> p
	p length
}

// Test calling method that returns f64
fn get_dot(s:State other:math::Vec3 -- d:f64) {
	s <<pos -> p
	p other dot
}
