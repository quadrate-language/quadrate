// Test: stack evaluation order
fn main() {
	// Basic stack order (left to right)
	"=== Basic stack order ===" print nl
	1 2 3 + + print nl        // 1 + (2 + 3) = 6
	1 2 + 3 + print nl        // (1 + 2) + 3 = 6
	10 2 3 * - print nl       // 10 - (2 * 3) = 4
	10 2 - 3 * print nl       // (10 - 2) * 3 = 24

	// Division and subtraction (non-commutative)
	"=== Non-commutative ops ===" print nl
	20 4 / print nl           // 5
	20 4 2 / / print nl       // 20 / (4 / 2) = 10
	20 4 / 2 / print nl       // (20 / 4) / 2 = 2
	10 3 - print nl           // 7
	10 3 2 - - print nl       // 10 - (3 - 2) = 9
	10 3 - 2 - print nl       // (10 - 3) - 2 = 5

	// Mixed operations
	"=== Mixed operations ===" print nl
	2 3 + 4 * print nl        // (2 + 3) * 4 = 20
	2 3 4 * + print nl        // 2 + (3 * 4) = 14
	2 3 4 + * print nl        // 2 * (3 + 4) = 14
	100 10 / 5 - print nl     // (100 / 10) - 5 = 5
	100 10 5 - / print nl     // 100 / (10 - 5) = 20

	// Comparison chains
	"=== Comparison chains ===" print nl
	5 3 > 1 eq print nl       // (5 > 3) == 1 -> true
	5 3 + 8 eq print nl       // (5 + 3) == 8 -> true
	5 3 > 4 2 > and print nl  // (5>3) && (4>2) -> true

	"done" print nl
}
