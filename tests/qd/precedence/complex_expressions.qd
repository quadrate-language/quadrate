// Test complex expression evaluation
fn main() {
	// Chained arithmetic
	"=== Chained arithmetic ===" print nl
	1 2 + 3 + 4 + 5 + print nl    // 15
	2 2 * 2 * 2 * 2 * print nl    // 32
	100 2 / 2 / 2 / print nl      // 12

	// Mix of all operations
	"=== All operations ===" print nl
	10 5 + 3 * 2 / print nl       // ((10+5)*3)/2 = 22
	20 4 2 + / 3 * print nl       // (20/(4+2))*3 = 9
	100 50 - 10 / 2 + print nl    // ((100-50)/10)+2 = 7

	// Comparison with arithmetic
	"=== Comparison with arithmetic ===" print nl
	5 3 + 10 2 - eq print nl      // (5+3) == (10-2) -> true
	10 2 * 5 4 * gt print nl      // (10*2) > (5*4) -> false
	100 10 / 5 2 + lt print nl    // (100/10) < (5+2) -> false

	// Logical with comparison
	"=== Logical with comparison ===" print nl
	5 3 gt 4 2 gt and print nl    // (5>3) && (4>2) -> true
	5 3 lt 4 2 gt or print nl     // (5<3) || (4>2) -> true
	1 0 neq print nl              // 1 != 0 -> true

	// Deeply nested
	"=== Deeply nested ===" print nl
	2 3 4 5 + + + print nl        // 2+3+4+5 = 14
	2 3 4 5 * * * print nl        // 2*3*4*5 = 120
	1 2 3 4 5 + + + + print nl    // 15

	"done" print nl
}
