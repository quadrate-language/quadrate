use compress
use str

fn main() {
	// Test gzip compression and decompression
	"Hello, World! This is a test of the compression library." -> original

	"Testing gzip:" print nl
	original compress::gzip! -> compressed
	compressed compress::gunzip! -> decompressed
	"  Original: " print original print nl
	"  Decompressed: " print decompressed print nl

	// Verify round-trip
	original decompressed str::compare 0 == if {
		"  Round-trip: PASS" print nl
	} else {
		"  Round-trip: FAIL" print nl
	}

	// Test gzip with compression level
	"Testing gzip_level:" print nl
	original compress::LevelBest compress::gzip_level! -> compressed_best
	compressed_best compress::gunzip! -> decompressed_best
	original decompressed_best str::compare 0 == if {
		"  Level 9 round-trip: PASS" print nl
	} else {
		"  Level 9 round-trip: FAIL" print nl
	}

	// Test raw deflate/inflate
	"Testing deflate/inflate:" print nl
	original compress::deflate! -> deflated
	deflated compress::inflate! -> inflated
	original inflated str::compare 0 == if {
		"  Deflate round-trip: PASS" print nl
	} else {
		"  Deflate round-trip: FAIL" print nl
	}

	// Test empty string
	"Testing empty string:" print nl
	"" compress::gzip! -> empty_compressed
	empty_compressed compress::gunzip! -> empty_decompressed
	"" empty_decompressed str::compare 0 == if {
		"  Empty string: PASS" print nl
	} else {
		"  Empty string: FAIL" print nl
	}

	// Test larger data (320 bytes)
	"Testing larger data:" print nl
	"ABCDEFGHIJ" -> chunk
	chunk chunk str::concat -> data
	data data str::concat -> data
	data data str::concat -> data
	data data str::concat -> data
	data data str::concat -> data

	data compress::gzip! -> large_compressed
	large_compressed compress::gunzip! -> large_decompressed
	data large_decompressed str::compare 0 == if {
		"  Large data round-trip: PASS" print nl
	} else {
		"  Large data round-trip: FAIL" print nl
	}

	"done" print nl
}
