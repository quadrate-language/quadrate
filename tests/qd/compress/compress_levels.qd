use compress
use str

fn main() {
	// Test all compression levels
	"The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog." -> text

	"Testing all compression levels:" print nl

	// Level 1 (fastest)
	text compress::LevelFast compress::gzip_level! -> c1
	c1 compress::gunzip! -> d1
	text d1 str::compare 0 == if {
		"  Level 1 (fast): PASS" print nl
	} else {
		"  Level 1 (fast): FAIL" print nl
	}

	// Level 6 (default)
	text compress::LevelDefault compress::gzip_level! -> c6
	c6 compress::gunzip! -> d6
	text d6 str::compare 0 == if {
		"  Level 6 (default): PASS" print nl
	} else {
		"  Level 6 (default): FAIL" print nl
	}

	// Level 9 (best)
	text compress::LevelBest compress::gzip_level! -> c9
	c9 compress::gunzip! -> d9
	text d9 str::compare 0 == if {
		"  Level 9 (best): PASS" print nl
	} else {
		"  Level 9 (best): FAIL" print nl
	}

	// Test edge level values (0 and 10 should clamp)
	text 0 compress::gzip_level! -> c0
	c0 compress::gunzip! -> d0
	text d0 str::compare 0 == if {
		"  Level 0 (clamped): PASS" print nl
	} else {
		"  Level 0 (clamped): FAIL" print nl
	}

	text 10 compress::gzip_level! -> c10
	c10 compress::gunzip! -> d10
	text d10 str::compare 0 == if {
		"  Level 10 (clamped): PASS" print nl
	} else {
		"  Level 10 (clamped): FAIL" print nl
	}

	"done" print nl
}
