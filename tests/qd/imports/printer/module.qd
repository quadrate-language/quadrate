// Test: Module that uses imports internally
import "libfmt.a" as "fmt" {
	fn printf(format:str -- )
}

pub fn print_number(i64 -- ) {
	"Number: %d\n" fmt::printf
}

pub fn print_message(str -- ) {
	"Message: %s\n" fmt::printf
}

pub fn main() {
	123 print_number
	"Testing printer module" print_message
}
