// Test signal module - signal constants and basic operations
use signal

fn main() {
	"=== Signal constants ===" print nl
	signal::SigHup 0 > print nl
	signal::SigInt 0 > print nl
	signal::SigQuit 0 > print nl
	signal::SigKill 0 > print nl
	signal::SigTerm 0 > print nl
	signal::SigUsr1 0 > print nl
	signal::SigUsr2 0 > print nl

	"=== trap and pending ===" print nl
	signal::SigUsr1 signal::trap
	signal::SigUsr1 signal::pending print nl

	"=== clear ===" print nl
	signal::SigUsr1 signal::clear
	signal::SigUsr1 signal::pending print nl

	"=== reset ===" print nl
	signal::SigUsr1 signal::reset
	signal::SigUsr1 signal::pending print nl

	"=== ignore ===" print nl
	signal::SigPipe signal::ignore

	"done" print nl
}
