// Test: rt module - runtime version information
use rt
use strings

fn main() {
	"=== version ===" print nl
	rt::version len 0 > print nl
	rt::version "." strings::contains print nl

	"=== version_api ===" print nl
	rt::version_api 0 > print nl
	rt::version_api 10000 >= print nl

	"done" print nl
}
