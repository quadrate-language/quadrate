// Test: os module - operating system interface
use os
use strings

fn main() {
	"=== Error constants ===" print nl
	os::ErrNotFound print nl
	os::ErrPermission print nl
	os::ErrExists print nl
	os::ErrNotDirectory print nl
	os::ExitSuccess print nl
	os::ExitFailure print nl

	"=== exists ===" print nl
	"/tmp" os::exists print nl
	"/" os::exists print nl
	"/nonexistent_path_12345" os::exists print nl

	"=== is_dir ===" print nl
	"/tmp" os::is_dir print nl
	"/" os::is_dir print nl

	"=== is_file ===" print nl
	"/etc/passwd" os::is_file print nl
	"/tmp" os::is_file print nl

	"=== getenv ===" print nl
	"HOME" os::getenv strings::len 0 gt print nl
	"PATH" os::getenv strings::len 0 gt print nl
	"NONEXISTENT_VAR_12345" os::getenv strings::len 0 eq print nl

	"=== getpid ===" print nl
	os::getpid 0 gt print nl

	"=== cwd ===" print nl
	os::cwd! strings::len 0 gt print nl

	"=== exec ===" print nl
	"echo hello" os::exec! -> exitcode -> output
	exitcode print nl
	output strings::trim print nl

	"=== mktemp and rmdir ===" print nl
	os::mktemp! -> tmpdir
	tmpdir os::exists print nl
	tmpdir os::is_dir print nl
	tmpdir os::rmdir!
	tmpdir os::exists print nl

	"done" print nl
}
