// Test flag module - command-line flag parsing
use flag

fn main() {
	"=== Error constants ===" print nl
	flag::ErrNotFound print nl
	flag::ErrNoValue print nl
	flag::ErrInvalidValue print nl

	"=== Manual Flag struct ===" print nl
	// Manually create a Flag with test data
	// argv format is "\narg1\narg2\n..."
	flag::Flag {
		argc = 4
		argv = "\n--verbose\n--name\ntest\n--count\n42\n"
	} -> f

	"=== boolean ===" print nl
	f "--verbose" flag::boolean print nl
	f "--missing" flag::boolean print nl

	"=== string ===" print nl
	f "--name" flag::string if {
		print nl
	} else {
		drop "error" print nl
	}

	"=== int ===" print nl
	f "--count" flag::int if {
		print nl
	} else {
		drop "error" print nl
	}

	f flag::destroy

	"done" print nl
}
