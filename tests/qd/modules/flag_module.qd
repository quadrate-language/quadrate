// Test: flag module - command-line flag parsing
use flag

fn main() {
	"=== Error constants ===" print nl
	flag::ErrNotFound print nl
	flag::ErrNoValue print nl
	flag::ErrInvalidValue print nl

	"=== Parsed flags ===" print nl
	// Parse test data via flag::parse
	"--verbose" "--name" "test" "--count" "42" 5 flag::parse -> f

	"=== boolean ===" print nl
	f "--verbose" flag::boolean print nl
	f "--missing" flag::boolean print nl

	"=== string ===" print nl
	f "--name" flag::string if {
		print nl
	} else {
		drop "error" print nl
	}

	"=== int ===" print nl
	f "--count" flag::int if {
		print nl
	} else {
		drop "error" print nl
	}

	f flag::destroy

	"done" print nl
}
