// Test: flag module - command-line flag parsing
use flag

fn main() {
	"=== Error constants ===" print nl
	flag::ErrNotFound print nl
	flag::ErrNoValue print nl
	flag::ErrInvalidValue print nl

	"=== Parsed flags ===" print nl
	// Parse test data via flag::parse. `parse` takes the argument array that
	// os::args returns, so a test builds one by hand.
	5 makes -> argv
	argv 0 "--verbose" set
	argv 1 "--name" set
	argv 2 "test" set
	argv 3 "--count" set
	argv 4 "42" set
	argv flag::parse -> f
	argv free

	"=== boolean ===" print nl
	f "--verbose" flag::boolean print nl
	f "--missing" flag::boolean print nl

	"=== string ===" print nl
	f "--name" flag::string if {
		print nl
	} else {
		"error" print nl
	}

	"=== int ===" print nl
	f "--count" flag::int if {
		print nl
	} else {
		"error" print nl
	}

	f flag::destroy

	"done" print nl
}
