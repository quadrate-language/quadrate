// Control flow operations in modules
pub fn sign(f64 -- f64) {
	dup 0.0 >
	if {
		drop 1.0
	} else {
		dup 0.0 <
		if {
			drop -1.0
		} else {
			drop 0.0
		}
	}
}

pub fn sum_to_n(f64 -- f64) {
	0.0
	swap
	1.0 swap 1.0
	for it {
		it +
	}
}

pub fn count_evens(f64 -- f64) {
	0.0
	swap
	0.0 swap 2.0
	for it {
		1.0 +
	}
}
