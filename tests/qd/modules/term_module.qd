// Test: term module - ANSI escape codes
use term

fn main() {
	"=== Basic colors exist ===" print nl
	term::Red len 0 > print nl
	term::Green len 0 > print nl
	term::Blue len 0 > print nl
	term::Reset len 0 > print nl

	"=== Formatting codes exist ===" print nl
	term::Bold len 0 > print nl
	term::Dim len 0 > print nl
	term::Italic len 0 > print nl
	term::Underline len 0 > print nl

	"=== Background colors exist ===" print nl
	term::BgRed len 0 > print nl
	term::BgGreen len 0 > print nl
	term::BgBlue len 0 > print nl

	"=== Bright colors exist ===" print nl
	term::BrightRed len 0 > print nl
	term::BrightGreen len 0 > print nl
	term::BrightBlue len 0 > print nl

	"=== All constants are non-empty ===" print nl
	term::Black len 0 > print nl
	term::White len 0 > print nl
	term::Yellow len 0 > print nl
	term::Cyan len 0 > print nl
	term::Magenta len 0 > print nl

	"done" print nl
}
