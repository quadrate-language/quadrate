// Test file append mode
use io
use mem

fn main() {
	// Write initial content
	"Line 1\n" mem::from_string
	-> len1
	-> buf1

	"/tmp/test_append.txt" io::Write io::open switch {
		Ok {
			-> file
			file buf1 len1 io::write switch {
				Ok {
					drop
					file io::close
				}
				_ { file io::close }
			}
		}
		_ { }
	}

	buf1 mem::free

	// Append more content
	"Line 2\n" mem::from_string
	-> len2
	-> buf2

	"/tmp/test_append.txt" io::Append io::open switch {
		Ok {
			-> file
			file buf2 len2 io::write switch {
				Ok {
					drop
					file io::close
				}
				_ { file io::close }
			}
		}
		_ { }
	}

	buf2 mem::free

	// Read all content
	100 mem::alloc! -> read_buf

	"/tmp/test_append.txt" io::Read io::open switch {
		Ok {
			-> file
			file read_buf 100 io::read switch {
				Ok {
					-> bytes_read
					file io::close
					read_buf bytes_read mem::to_string
					prints       // Print string (non-destructive)
				}
				_ { file io::close }
			}
		}
		_ { }
	}

	read_buf mem::free
}
