// Test io::write_file - write string to file
use io
use os
use str

fn main() {
	// Create a temp directory for test
	os::mktemp! -> tmpdir
	tmpdir "/test.txt" str::concat -> path

	// Write to file
	path "Hello, world!\nLine 2\n" io::write_file!
	"Written" print nl

	// Read it back
	path io::read_file! -> contents
	contents print

	// Clean up
	path os::delete!
	tmpdir os::rmdir!
	"Done" print nl
}
