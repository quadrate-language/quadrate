// Test file seek operations
use io
use mem

fn main() {
	// Create a test file with known content
	"0123456789" mem::from_string
	-> write_len
	-> write_buf

	"/tmp/test_seek.txt" io::Write io::open switch {
		Ok {
			-> file
			file write_buf write_len io::write switch {
				Ok {
					drop
					file io::close
				}
				_ { file io::close }
			}
		}
		_ { }
	}

	write_buf mem::free

	// Open for reading, seek and read
	10 mem::alloc! -> read_buf

	"/tmp/test_seek.txt" io::Read io::open switch {
		Ok {
			-> file
			file 5 io::SeekSet io::seek switch {
				Ok {
					drop                    // Drop position
					file read_buf 3 io::read switch {
						Ok {
							-> bytes_read       // Get bytes_read
							file io::close
							read_buf bytes_read mem::to_string
							print             // Print string (destructive - frees it)
							nl                // Print newline
						}
						_ { file io::close }
					}
				}
				_ { file io::close }
			}
		}
		_ { }
	}

	read_buf mem::free
}
