// Test basic file read
use io
use mem

fn main() {
	// Create a small file
	"ABC" mem::from_string
	-> write_len
	-> write_buf

	"/tmp/test_eof.txt" io::Write io::open switch {
		Ok {
			-> file
			file write_buf write_len io::write switch {
				Ok {
					drop
					file io::close
				}
				_ { file io::close }
			}
		}
		_ { }
	}

	write_buf mem::free

	// Open and read
	10 mem::alloc! -> read_buf

	"/tmp/test_eof.txt" io::Read io::open switch {
		Ok {
			-> file
			file read_buf 3 io::read switch {
				Ok {
					-> bytes_read
					file io::close
					read_buf bytes_read mem::to_string
					print             // Print string (destructive - frees it)
					nl                // Print newline
				}
				_ { file io::close }
			}
		}
		_ { }
	}

	read_buf mem::free
}
