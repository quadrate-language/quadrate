// Test io::read_file function
use io
use mem

fn main() {
	// First write a test file
	"Test content for read_file\n" mem::from_string
	-> write_len
	-> write_buf

	"/tmp/test_read_file.txt" io::Write io::open switch {
		Ok {
			-> file
			file write_buf write_len io::write switch {
				Ok {
					drop
					file io::close
				}
				_ { file io::close }
			}
		}
		_ { }
	}

	write_buf mem::free

	// Now test read_file
	"/tmp/test_read_file.txt" io::read_file switch {
		Ok {
			-> contents
			"read_file success: " print contents print
		}
		_ {
			"read_file failed" print nl
		}
	}

	// Test error case - nonexistent file
	"/tmp/nonexistent_file_12345.txt" io::read_file switch {
		Ok {
			drop
			"should not reach here" print nl
		}
		io::ErrNotFound {
			"not found error: OK" print nl
		}
		_ {
			"unexpected error" print nl
		}
	}
}
