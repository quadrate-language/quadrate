// Test generic function with multiple type parameters

fn pair<A B>(a:A b:B -- a:A b:B) {
	-> second
	-> first
	first second
}

fn main() {
	// Test with int and string
	1 "one" pair
	-> s
	-> n
	n print " " print s print nl

	// Test with float and int
	3.14 42 pair
	-> i
	-> f
	f print " " print i print nl
}
