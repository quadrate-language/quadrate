// Test Quat construction and basic operations
use math

fn main() {
	// Test identity
	math::quat_identity -> id
	"identity:" print nl
	id @w print nl
	id @x print nl
	id @y print nl
	id @z print nl

	// Test struct literal constructor
	Quat { w = 1.0 x = 0.0 y = 0.0 z = 0.0 } -> q
	"quat:" print nl
	q @w print nl
	q @x print nl
	q @y print nl
	q @z print nl

	// Test conjugate (method syntax: receiver method)
	// conjugate of (1,2,3,4) is (1,-2,-3,-4)
	Quat { w = 1.0 x = 2.0 y = 3.0 z = 4.0 } -> q2
	q2 conjugate -> conj  // q2.conjugate()
	"conjugate:" print nl
	conj @w print nl
	conj @x print nl
	conj @y print nl
	conj @z print nl

	// Test dot (method syntax: param receiver method)
	// (1,0,0,0) dot (1,0,0,0) = 1
	math::quat_identity -> id1
	math::quat_identity -> id2
	id2 id1 dot -> dot_result  // id1.dot(id2)
	"dot identity:" print nl
	dot_result print nl

	// (1,2,3,4) dot (1,2,3,4) = 1+4+9+16 = 30
	Quat { w = 1.0 x = 2.0 y = 3.0 z = 4.0 } -> q3
	Quat { w = 1.0 x = 2.0 y = 3.0 z = 4.0 } -> q4
	q4 q3 dot -> dot2  // q3.dot(q4)
	"dot:" print nl
	dot2 print nl

	// Test mul (method syntax: param receiver method)
	// identity * identity = identity
	math::quat_identity -> id3
	math::quat_identity -> id4
	id4 id3 mul -> prod  // id3.mul(id4)
	"mul identity:" print nl
	prod @w print nl
	prod @x print nl
	prod @y print nl
	prod @z print nl
}
