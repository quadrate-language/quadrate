// Test vector length and normalization
use math

fn main() {
	// Test vec2 length with 3-4-5 triangle (length = 5) - method syntax
	Vec2 { x = 3.0 y = 4.0 } -> v2
	v2 length -> len2
	"vec2_len (3,4):" print nl
	len2 print nl

	// Test vec2 length_sq - method syntax
	v2 length_sq -> len2sq
	"vec2_len_sq (3,4):" print nl
	len2sq print nl

	// Test vec3 length with 3-4-5 and z=0 (method syntax)
	Vec3 { x = 3.0 y = 4.0 z = 0.0 } -> v3a
	v3a length -> len3a  // v3a.length()
	"vec3_len (3,4,0):" print nl
	len3a print nl

	// Test vec3 length_sq (method syntax)
	v3a length_sq -> len3asq  // v3a.length_sq()
	"vec3_len_sq (3,4,0):" print nl
	len3asq print nl

	// Test vec4 length with unit vector (method syntax)
	Vec4 { x = 1.0 y = 0.0 z = 0.0 w = 0.0 } -> v4a
	v4a length -> len4  // v4a.length()
	"vec4_len (1,0,0,0):" print nl
	len4 print nl

	// Test vec2 normalize - unit vector stays the same (method syntax)
	Vec2 { x = 1.0 y = 0.0 } -> unit2
	unit2 normalize -> norm2
	"vec2_normalize (1,0):" print nl
	norm2 @x print nl
	norm2 @y print nl

	// Test vec3 normalize (method syntax)
	Vec3 { x = 1.0 y = 0.0 z = 0.0 } -> unit3
	unit3 normalize -> norm3  // unit3.normalize()
	"vec3_normalize (1,0,0):" print nl
	norm3 @x print nl
	norm3 @y print nl
	norm3 @z print nl

	// Test quat length of identity = 1 (method syntax)
	math::quat_identity -> qid
	qid length -> qlen  // qid.length()
	"quat_len identity:" print nl
	qlen print nl
}
