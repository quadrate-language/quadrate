// Test Vec3 construction and basic operations
use math

fn main() {
	// Test struct literal constructor
	Vec3 { x = 1.0 y = 2.0 z = 3.0 } -> v
	"vec3:" print nl
	v @x print nl
	v @y print nl
	v @z print nl

	// Test zero
	math::vec3_zero -> z
	"zero:" print nl
	z @x print nl
	z @y print nl
	z @z print nl

	// Test one
	math::vec3_one -> o
	"one:" print nl
	o @x print nl
	o @y print nl
	o @z print nl

	// Test unit vectors
	math::vec3_unit_x -> ux
	"unit_x:" print nl
	ux @x print nl
	ux @y print nl
	ux @z print nl

	math::vec3_unit_y -> uy
	"unit_y:" print nl
	uy @x print nl
	uy @y print nl
	uy @z print nl

	math::vec3_unit_z -> uz
	"unit_z:" print nl
	uz @x print nl
	uz @y print nl
	uz @z print nl

	// Test add (method syntax: receiver param method)
	Vec3 { x = 1.0 y = 2.0 z = 3.0 } -> a
	Vec3 { x = 4.0 y = 5.0 z = 6.0 } -> b
	a b add -> c  // a.add(b) = a + b
	"add:" print nl
	c @x print nl
	c @y print nl
	c @z print nl

	// Test subtract (method syntax: receiver param method)
	Vec3 { x = 5.0 y = 7.0 z = 9.0 } -> d
	Vec3 { x = 2.0 y = 3.0 z = 4.0 } -> e
	d e subtract -> f  // d.subtract(e) = d - e
	"sub:" print nl
	f @x print nl
	f @y print nl
	f @z print nl

	// Test scale (method syntax: receiver param method)
	Vec3 { x = 2.0 y = 3.0 z = 4.0 } -> g
	g 2.0 scale -> h  // g.scale(2.0)
	"scale:" print nl
	h @x print nl
	h @y print nl
	h @z print nl

	// Test dot (method syntax: receiver param method)
	Vec3 { x = 1.0 y = 2.0 z = 3.0 } -> i
	Vec3 { x = 4.0 y = 5.0 z = 6.0 } -> j
	i j dot -> dot_result  // i.dot(j)
	"dot:" print nl
	dot_result print nl

	// Test neg (method syntax)
	Vec3 { x = 3.0 y = 4.0 z = 5.0 } -> k
	k neg -> l  // k.neg()
	"neg:" print nl
	l @x print nl
	l @y print nl
	l @z print nl
}
