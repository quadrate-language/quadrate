// Test Mat4 construction and basic operations
use math

fn main() {
	// Test identity
	math::mat4_identity -> id
	"identity diagonal:" print nl
	id @m00 print nl
	id @m11 print nl
	id @m22 print nl
	id @m33 print nl
	"identity off-diagonal:" print nl
	id @m01 print nl
	id @m10 print nl
	id @m23 print nl
	id @m32 print nl

	// Test zero
	math::mat4_zero -> z
	"zero:" print nl
	z @m00 print nl
	z @m11 print nl
	z @m22 print nl
	z @m33 print nl

	// Test translation
	1.0 2.0 3.0 math::mat4_translation -> t
	"translation:" print nl
	t @m30 print nl
	t @m31 print nl
	t @m32 print nl
	"translation diagonal:" print nl
	t @m00 print nl
	t @m11 print nl
	t @m22 print nl
	t @m33 print nl

	// Test scaling
	2.0 3.0 4.0 math::mat4_scaling -> s
	"scaling:" print nl
	s @m00 print nl
	s @m11 print nl
	s @m22 print nl
	s @m33 print nl

	// Test transpose (method syntax: receiver method)
	math::mat4_identity -> id2
	id2 transpose -> transposed  // id2.transpose()
	"transpose identity (should be same):" print nl
	transposed @m00 print nl
	transposed @m11 print nl
	transposed @m22 print nl
	transposed @m33 print nl
}
