// Benchmark test for pure Quadrate math implementations
use math

fn main() {
	// Test sq
	5.0 math::sq print nl

	// Test cb
	3.0 math::cb print nl

	// Test abs
	-10.5 math::abs print nl
	10.5 math::abs print nl

	// Test inv
	2.0 math::inv print nl

	// Test fac
	5 math::fac print nl

	// Test min
	10.0 5.0 math::min print nl

	// Test max
	10.0 5.0 math::max print nl

	// Test clamp
	15.0 0.0 10.0 math::clamp print nl
	5.0 0.0 10.0 math::clamp print nl
	-5.0 0.0 10.0 math::clamp print nl
}
