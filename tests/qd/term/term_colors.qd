// Test term module - terminal colors
use term
use str

fn main() {
	// Test that constants have correct escape sequences
	term::Reset "\x1b[0m" str::compare 0 eq print nl
	term::Red "\x1b[31m" str::compare 0 eq print nl
	term::Green "\x1b[32m" str::compare 0 eq print nl
	term::Yellow "\x1b[33m" str::compare 0 eq print nl
	term::Blue "\x1b[34m" str::compare 0 eq print nl

	// Test usage pattern
	term::Green print "PASS" print term::Reset print nl
}
