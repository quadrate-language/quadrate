use signal

fn main() {
    // Test that we can trap SigInt
    signal::SigInt signal::trap
    "Trapped SigInt" print nl

    // Check it's not pending initially
    signal::SigInt signal::pending if {
        "ERROR: SigInt should not be pending" print nl
    } else {
        "OK: SigInt not pending initially" print nl
    }

    // Test ignore
    signal::SigPipe signal::ignore
    "Ignored SigPipe" print nl

    // Test reset
    signal::SigPipe signal::reset
    "Reset SigPipe" print nl

    // Test clear (should be safe even if not pending)
    signal::SigInt signal::clear
    "Cleared SigInt" print nl

    "All basic signal tests passed!" print nl
}
