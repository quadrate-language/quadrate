// Test signal constants are accessible and have expected values
use signal

fn main() {
	// Common signals
	"=== Common signals ===" print nl
	"SigInt: " print signal::SigInt print nl
	"SigTerm: " print signal::SigTerm print nl
	"SigKill: " print signal::SigKill print nl
	"SigHup: " print signal::SigHup print nl

	// User signals
	"=== User signals ===" print nl
	"SigUsr1: " print signal::SigUsr1 print nl
	"SigUsr2: " print signal::SigUsr2 print nl

	// Job control
	"=== Job control ===" print nl
	"SigStop: " print signal::SigStop print nl
	"SigCont: " print signal::SigCont print nl
	"SigTstp: " print signal::SigTstp print nl

	// Error signals
	"=== Error signals ===" print nl
	"SigSegv: " print signal::SigSegv print nl
	"SigFpe: " print signal::SigFpe print nl
	"SigIll: " print signal::SigIll print nl
	"SigAbrt: " print signal::SigAbrt print nl
}
