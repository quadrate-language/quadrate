// Test: flag parsing module
use flag

// flag::parse takes the argument array os::args returns; these build one by hand.
fn args0( -- args:[]str) {
	[]str
}

fn args1(a:str -- args:[]str) {
	[1]str -> r
	r 0 a set
	r
}

fn args2(a:str b:str -- args:[]str) {
	[2]str -> r
	r 0 a set
	r 1 b set
	r
}

fn main() {
	// Test boolean - flag not present
	args0 -> a1  a1 flag::parse -> f1  a1 free
	f1 "--verbose" flag::boolean print nl
	f1 flag::destroy

	// Test boolean - flag present
	"--verbose" args1 -> a2  a2 flag::parse -> f2  a2 free
	f2 "--verbose" flag::boolean print nl
	f2 flag::destroy

	// Test string - flag not present
	args0 -> a3  a3 flag::parse -> f3  a3 free
	f3 "--name" flag::string if {
		print nl
	} else {
		"default" print nl
	}
	f3 flag::destroy

	// Test string - flag present
	"--name" "Alice" args2 -> a4  a4 flag::parse -> f4  a4 free
	f4 "--name" flag::string if {
		print nl
	} else {
		"default" print nl
	}
	f4 flag::destroy

	// Test int - flag not present (use default)
	args0 -> a5  a5 flag::parse -> f5  a5 free
	f5 "--count" flag::int if {
		print nl
	} else {
		10 print nl
	}
	f5 flag::destroy

	// Test int - flag present
	"--count" "42" args2 -> a6  a6 flag::parse -> f6  a6 free
	f6 "--count" flag::int if {
		print nl
	} else {
		10 print nl
	}
	f6 flag::destroy

	// Test float - flag present
	"--pi" "3.14" args2 -> a7  a7 flag::parse -> f7  a7 free
	f7 "--pi" flag::float if {
		print nl
	} else {
		0.0 print nl
	}
	f7 flag::destroy

	// Test positional arguments
	"file.txt" args1 -> a8  a8 flag::parse -> f8  a8 free
	f8 0 flag::positional if {
		print nl
	} else {
		"no file" print nl
	}
	f8 flag::destroy
}
