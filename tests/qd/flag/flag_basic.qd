// Test flag parsing module
use flag

fn main( -- ) {
	// Test boolean - flag not present
	"" 0 flag::parse -> f1
	f1 "--verbose" flag::boolean print nl
	f1 flag::destroy

	// Test boolean - flag present
	"--verbose" 1 flag::parse -> f2
	f2 "--verbose" flag::boolean print nl
	f2 flag::destroy

	// Test string - flag not present
	"" 0 flag::parse -> f3
	f3 "--name" flag::string if {
		print nl
	} else {
		"default" print nl
	}
	f3 flag::destroy

	// Test string - flag present
	"--name" "Alice" 2 flag::parse -> f4
	f4 "--name" flag::string if {
		print nl
	} else {
		"default" print nl
	}
	f4 flag::destroy

	// Test int - flag not present (use default)
	"" 0 flag::parse -> f5
	f5 "--count" flag::int if {
		print nl
	} else {
		10 print nl
	}
	f5 flag::destroy

	// Test int - flag present
	"--count" "42" 2 flag::parse -> f6
	f6 "--count" flag::int if {
		print nl
	} else {
		10 print nl
	}
	f6 flag::destroy

	// Test float - flag present
	"--pi" "3.14" 2 flag::parse -> f7
	f7 "--pi" flag::float if {
		print nl
	} else {
		0.0 print nl
	}
	f7 flag::destroy

	// Test positional (not implemented yet)
	"file.txt" 1 flag::parse -> f8
	f8 0 flag::positional if {
		print nl
	} else {
		"no file" print nl
	}
	f8 flag::destroy
}
