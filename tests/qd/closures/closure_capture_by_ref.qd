// Test: Captures are by reference - modifying original affects captured
fn main() {
    10 -> x
    fn ( -- r:i64) { x } -> get_x

    // Modify x after closure creation
    99 -> x

    // Closure should return updated value (99) with by-reference semantics
    get_x call print nl

    // Verify x was actually modified
    x print nl
}
