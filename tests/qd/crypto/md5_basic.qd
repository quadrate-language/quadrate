// Test MD5 basic functionality
use crypto
use str

fn main() {
	// Test one-shot MD5
	"hello" crypto::md5! -> hash
	hash print nl

	// Verify against known value
	hash "5d41402abc4b2a76b9719d911017c592" str::compare 0 == if {
		"md5_hello_ok" print nl
	}

	// Test another known value
	"abc" crypto::md5! -> hash2
	hash2 "900150983cd24fb0d6963f7d28e17f72" str::compare 0 == if {
		"md5_abc_ok" print nl
	}
}
