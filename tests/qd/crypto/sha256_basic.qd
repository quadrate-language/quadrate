// Test SHA-256 basic functionality
use crypto
use str

fn main() {
	// Test one-shot SHA-256 (fallible)
	"Hello" crypto::sha256! -> hash
	hash print nl

	// Verify against known value
	hash "185f8db32271fe25f561a6fc938b2e264306ec304eda518007d1764826381969" str::compare 0 == if {
		"sha256_hello_ok" print nl
	}

	// Test second hash to verify consistency
	"hello" crypto::sha256! -> hash2
	hash2 "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" str::compare 0 == if {
		"sha256_lower_ok" print nl
	}
}
