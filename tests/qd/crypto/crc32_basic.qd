// Test CRC32 basic functionality
use crypto

fn main() {
	// Test one-shot CRC32
	"Hello" crypto::crc32 -> crc
	crc 4157704578 == if { "crc32_hello_ok" print nl }

	// Test empty string
	"" crypto::crc32 -> empty_crc
	empty_crc 0 == if { "crc32_empty_ok" print nl }

	// Test hex output
	"Hello" crypto::crc32_hex -> hex
	hex print nl

	// Test verify function
	"Hello" 4157704578 crypto::crc32_verify 1 == if { "verify_ok" print nl }
	"Hello" 12345 crypto::crc32_verify 0 == if { "verify_fail_ok" print nl }
}
