use fmt
use str

fn main() {
	// Use sprintf result with str operations
	"world" "hello %s" fmt::sprintf str::len print nl

	// Chain sprintf with concat
	"hello" " " "world" str::concat "%s%s" fmt::sprintf print nl

	// Use sprintf result as argument to another sprintf
	"inner" "(%s)" fmt::sprintf "Outer: %s" fmt::sprintf print nl

	// Store and reuse
	42 "Value: %d" fmt::sprintf
	dup print nl
	str::len print nl
}
