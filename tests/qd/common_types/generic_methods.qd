use ct

fn main() {
	// ====== Pair<T, U> Tests ======
	"=== Pair<i64, i64> ===" print nl
	ct::Pair<i64, i64> { first = 100 second = 200 } -> p1
	p1 first print nl  // 100
	p1 second print nl  // 200

	// Pair unpack
	"=== Pair unpack ===" print nl
	p1 unpack -> y -> x
	x print nl  // 100
	y print nl  // 200

	// Pair with different integers
	"=== Pair<i64, i64> 2 ===" print nl
	ct::Pair<i64, i64> { first = 15 second = 999 } -> p3
	p3 first print nl  // 15
	p3 second print nl  // 999

	"=== Done ===" print nl
}
