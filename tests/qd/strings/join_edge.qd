// Test: strings::join edge cases
use strings
use os
use mem
use io

fn main() {
	// Test 1: Single element
	os::mktemp! -> tmpdir
	tmpdir "/only.txt" strings::concat "x" io::write_file!
	tmpdir os::list! drop -> entries
	entries "," strings::join! print nl

	// Test 2: Empty delimiter
	entries "" strings::join! print nl

	entries free
	tmpdir "/only.txt" strings::concat os::delete!
	tmpdir os::rmdir!

	// Test 3: Two elements
	os::mktemp! -> tmpdir2
	tmpdir2 "/a.txt" strings::concat "a" io::write_file!
	tmpdir2 "/b.txt" strings::concat "b" io::write_file!
	tmpdir2 os::list! drop -> entries2
	entries2 strings::sort
	entries2 " - " strings::join! print nl

	entries2 free
	tmpdir2 "/a.txt" strings::concat os::delete!
	tmpdir2 "/b.txt" strings::concat os::delete!
	tmpdir2 os::rmdir!

	// Test 4: Empty array -- the length comes off the array, so there is nothing to
	// disagree with it
	[]str -> empty_arr
	empty_arr "," strings::join! -> empty_result
	"[" print empty_result print "]" print nl
}
