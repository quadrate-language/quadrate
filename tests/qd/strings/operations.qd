fn main() {
	// Test printing strings with print (.)
	"Basic print test" print nl
	// Test multiple strings on stack
	"First" "Second" "Third" print nl
	// Should print nl "Third" and leave First and Second on stack
	print nl print nl
	// Should print nl "Second" then "First"
	// Test empty strings
	"" print nl "Not empty" print nl "" print nl
	// Test strings with numbers
	"Number: 42" print nl "Pi: 3.14159" print nl
	// Test strings with various whitespace
	"Tab	here" print nl "Multiple   spaces" print nl "Leading whitespace" print nl "Trailing whitespace " print nl
	// Test very long string
	"This is a very long string that tests whether the string handling can deal with longer text content without any issues whatsoever." print nl
	// Test strings with repeated characters
	"aaaaaaaaaa" print nl "1111111111" print nl "          " print nl
	// Test single character strings (ASCII and Unicode)
	"a" print nl "Z" print nl "0" print nl "!" print nl "ä" print nl "世" print nl "🎉" print nl
}
