// Test strings::compare
use strings

fn main() {
	"=== compare equal ===" print nl
	"abc" "abc" strings::compare print nl
	"" "" strings::compare print nl
	"hello" "hello" strings::compare print nl

	"=== compare less ===" print nl
	"abc" "abd" strings::compare 0 < print nl
	"a" "b" strings::compare 0 < print nl
	"apple" "banana" strings::compare 0 < print nl
	"" "a" strings::compare 0 < print nl
	"aaa" "aaaa" strings::compare 0 < print nl

	"=== compare greater ===" print nl
	"abd" "abc" strings::compare 0 > print nl
	"z" "a" strings::compare 0 > print nl
	"banana" "apple" strings::compare 0 > print nl
	"a" "" strings::compare 0 > print nl
	"aaaa" "aaa" strings::compare 0 > print nl

	"done" print nl
}
