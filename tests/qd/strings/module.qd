// Test: module
use strings

fn main() {
	// Test len with various strings
	"hello" strings::len print nl
	"" strings::len print nl
	"a" strings::len print nl
	"hello world!" strings::len print nl

	// Test concat with multiple strings
	"hello" " " strings::concat print nl
	"hello" " " strings::concat "world" strings::concat print nl
	"" "test" strings::concat print nl
	"test" "" strings::concat print nl

	// Test contains
	"hello world" "world" strings::contains print nl
	"hello world" "foo" strings::contains print nl
	"hello world" "" strings::contains print nl
	"" "test" strings::contains print nl

	// Test starts_with
	"hello world" "hello" strings::starts_with print nl
	"hello world" "world" strings::starts_with print nl
	"hello world" "" strings::starts_with print nl
	"" "test" strings::starts_with print nl

	// Test ends_with
	"hello world" "world" strings::ends_with print nl
	"hello world" "hello" strings::ends_with print nl
	"hello world" "" strings::ends_with print nl
	"" "test" strings::ends_with print nl

	// Test upper
	"hello" strings::upper print nl
	"HELLO" strings::upper print nl
	"HeLLo WoRLd" strings::upper print nl
	"123 abc!" strings::upper print nl

	// Test lower
	"HELLO" strings::lower print nl
	"hello" strings::lower print nl
	"HeLLo WoRLd" strings::lower print nl
	"123 ABC!" strings::lower print nl

	// Test trim
	"  hello  " strings::trim print nl
	"hello" strings::trim print nl
	"  hello" strings::trim print nl
	"hello  " strings::trim print nl
	"   " strings::trim print nl
	"	hello	" strings::trim print nl
}
