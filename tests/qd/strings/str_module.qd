use str

fn main() {
	// Test len with various strings
	"hello" str::len print nl
	"" str::len print nl
	"a" str::len print nl
	"hello world!" str::len print nl

	// Test concat with multiple strings
	"hello" " " str::concat print nl
	"hello" " " str::concat "world" str::concat print nl
	"" "test" str::concat print nl
	"test" "" str::concat print nl

	// Test contains
	"hello world" "world" str::contains print nl
	"hello world" "foo" str::contains print nl
	"hello world" "" str::contains print nl
	"" "test" str::contains print nl

	// Test starts_with
	"hello world" "hello" str::starts_with print nl
	"hello world" "world" str::starts_with print nl
	"hello world" "" str::starts_with print nl
	"" "test" str::starts_with print nl

	// Test ends_with
	"hello world" "world" str::ends_with print nl
	"hello world" "hello" str::ends_with print nl
	"hello world" "" str::ends_with print nl
	"" "test" str::ends_with print nl

	// Test upper
	"hello" str::upper print nl
	"HELLO" str::upper print nl
	"HeLLo WoRLd" str::upper print nl
	"123 abc!" str::upper print nl

	// Test lower
	"HELLO" str::lower print nl
	"hello" str::lower print nl
	"HeLLo WoRLd" str::lower print nl
	"123 ABC!" str::lower print nl

	// Test trim
	"  hello  " str::trim print nl
	"hello" str::trim print nl
	"  hello" str::trim print nl
	"hello  " str::trim print nl
	"   " str::trim print nl
	"	hello	" str::trim print nl
}
