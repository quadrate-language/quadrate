// Comprehensive string module tests
use strings

fn main() {
	// Test 1: strings::len
	"Hello" strings::len print nl

	// Test 2: strings::concat
	"Hello" " World" strings::concat prints nl

	// Test 3: strings::contains
	"Hello World" "World" strings::contains print nl
	"Hello World" "Foo" strings::contains print nl

	// Test 4: strings::starts_with
	"Hello World" "Hello" strings::starts_with print nl
	"Hello World" "World" strings::starts_with print nl

	// Test 5: strings::ends_with
	"Hello World" "World" strings::ends_with print nl
	"Hello World" "Hello" strings::ends_with print nl

	// Test 6: strings::upper
	"hello world" strings::upper prints nl

	// Test 7: strings::lower
	"HELLO WORLD" strings::lower prints nl

	// Test 8: strings::trim
	"  hello world  " strings::trim prints nl
	"hello" strings::trim prints nl

	// Test 9: strings::substring
	"Hello World" 0 5 strings::substring! prints nl
	"Hello World" 6 5 strings::substring! prints nl

	// Test 10: strings::replace
	"Hello World World" "World" "Universe" strings::replace! prints nl
	"abc abc abc" "abc" "xyz" strings::replace! prints nl

	// Test 11: strings::compare
	"aaa" "bbb" strings::compare print nl
	"bbb" "aaa" strings::compare print nl
	"aaa" "aaa" strings::compare print nl

	// Test 12: Empty string tests
	"" strings::len print nl
	"" "" strings::concat strings::len print nl
	"test" "" strings::contains print nl

	// Test 13: Single character tests
	"a" strings::len print nl
	"a" "b" strings::concat prints nl
}
