// Test Vec2 construction and basic operations
use math

fn main() {
	// Test struct literal constructor
	Vec2 { x = 1.0 y = 2.0 } -> v
	"vec2:" print nl
	v @x print nl
	v @y print nl

	// Test zero
	math::vec2_zero -> z
	"zero:" print nl
	z @x print nl
	z @y print nl

	// Test one
	math::vec2_one -> o
	"one:" print nl
	o @x print nl
	o @y print nl

	// Test add (method syntax: param receiver method)
	Vec2 { x = 1.0 y = 2.0 } -> a
	Vec2 { x = 3.0 y = 4.0 } -> b
	b a add -> c  // a.add(b) = a + b
	"add:" print nl
	c @x print nl
	c @y print nl

	// Test subtract (method syntax: param receiver method)
	Vec2 { x = 5.0 y = 7.0 } -> d
	Vec2 { x = 2.0 y = 3.0 } -> e
	e d subtract -> f  // d.subtract(e) = d - e
	"sub:" print nl
	f @x print nl
	f @y print nl

	// Test scale (method syntax: param receiver method)
	Vec2 { x = 2.0 y = 3.0 } -> g
	2.0 g scale -> h  // g.scale(2.0)
	"scale:" print nl
	h @x print nl
	h @y print nl

	// Test dot (method syntax: param receiver method)
	Vec2 { x = 1.0 y = 2.0 } -> i
	Vec2 { x = 3.0 y = 4.0 } -> j
	j i dot -> dot_result  // i.dot(j)
	"dot:" print nl
	dot_result print nl

	// Test neg (method syntax: receiver method)
	Vec2 { x = 3.0 y = 4.0 } -> k
	k neg -> l  // k.neg()
	"neg:" print nl
	l @x print nl
	l @y print nl

	// Test length (method syntax: receiver method)
	Vec2 { x = 3.0 y = 4.0 } -> m
	m length -> len  // m.length() = 5
	"length:" print nl
	len print nl

	// Test normalize (method syntax: receiver method)
	Vec2 { x = 3.0 y = 4.0 } -> n
	n normalize -> norm  // n.normalize()
	"normalize:" print nl
	norm @x print nl
	norm @y print nl
}
