// Test Vec2 construction and basic operations
use vec2

fn main() {
	// Test struct literal constructor
	Vec2 { x = 1.0 y = 2.0 } -> v
	"vec2:" print nl
	v @x print nl
	v @y print nl

	// Test zero
	vec2::zero -> z
	"zero:" print nl
	z @x print nl
	z @y print nl

	// Test one
	vec2::one -> o
	"one:" print nl
	o @x print nl
	o @y print nl

	// Test add
	Vec2 { x = 1.0 y = 2.0 } -> a
	Vec2 { x = 3.0 y = 4.0 } -> b
	a b vec2::add -> c
	"add:" print nl
	c @x print nl
	c @y print nl

	// Test subtract
	Vec2 { x = 5.0 y = 7.0 } -> d
	Vec2 { x = 2.0 y = 3.0 } -> e
	d e vec2::subtract -> f
	"sub:" print nl
	f @x print nl
	f @y print nl

	// Test scale
	Vec2 { x = 2.0 y = 3.0 } -> g
	g 2.0 vec2::scale -> h
	"scale:" print nl
	h @x print nl
	h @y print nl

	// Test dot
	Vec2 { x = 1.0 y = 2.0 } -> i
	Vec2 { x = 3.0 y = 4.0 } -> j
	i j vec2::dot -> dot
	"dot:" print nl
	dot print nl

	// Test neg
	Vec2 { x = 3.0 y = 4.0 } -> k
	k vec2::neg -> l
	"neg:" print nl
	l @x print nl
	l @y print nl
}
