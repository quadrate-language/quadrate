// Test vector length and normalization
use vec2
use vec3
use vec4
use quat

fn main() {
	// Test vec2::length with 3-4-5 triangle (length = 5)
	Vec2 { x = 3.0 y = 4.0 } -> v2
	v2 vec2::length -> len2
	"vec2_len (3,4):" print nl
	len2 print nl

	// Test vec2::length_sq
	v2 vec2::length_sq -> len2sq
	"vec2_len_sq (3,4):" print nl
	len2sq print nl

	// Test vec3::length with 3-4-5 and z=0
	Vec3 { x = 3.0 y = 4.0 z = 0.0 } -> v3a
	v3a vec3::length -> len3a
	"vec3_len (3,4,0):" print nl
	len3a print nl

	// Test vec3::length_sq
	v3a vec3::length_sq -> len3asq
	"vec3_len_sq (3,4,0):" print nl
	len3asq print nl

	// Test vec4::length with unit vector
	Vec4 { x = 1.0 y = 0.0 z = 0.0 w = 0.0 } -> v4a
	v4a vec4::length -> len4
	"vec4_len (1,0,0,0):" print nl
	len4 print nl

	// Test vec2::normalize - unit vector stays the same
	Vec2 { x = 1.0 y = 0.0 } -> unit2
	unit2 vec2::normalize -> norm2
	"vec2_normalize (1,0):" print nl
	norm2 @x print nl
	norm2 @y print nl

	// Test vec3::normalize
	Vec3 { x = 1.0 y = 0.0 z = 0.0 } -> unit3
	unit3 vec3::normalize -> norm3
	"vec3_normalize (1,0,0):" print nl
	norm3 @x print nl
	norm3 @y print nl
	norm3 @z print nl

	// Test quat::length of identity = 1
	quat::identity -> qid
	qid quat::length -> qlen
	"quat_len identity:" print nl
	qlen print nl
}
