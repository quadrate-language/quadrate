// Test Vec3 construction and basic operations
use vec3

fn main() {
	// Test struct literal constructor
	Vec3 { x = 1.0 y = 2.0 z = 3.0 } -> v
	"vec3:" print nl
	v @x print nl
	v @y print nl
	v @z print nl

	// Test zero
	vec3::zero -> z
	"zero:" print nl
	z @x print nl
	z @y print nl
	z @z print nl

	// Test one
	vec3::one -> o
	"one:" print nl
	o @x print nl
	o @y print nl
	o @z print nl

	// Test unit vectors
	vec3::unit_x -> ux
	"unit_x:" print nl
	ux @x print nl
	ux @y print nl
	ux @z print nl

	vec3::unit_y -> uy
	"unit_y:" print nl
	uy @x print nl
	uy @y print nl
	uy @z print nl

	vec3::unit_z -> uz
	"unit_z:" print nl
	uz @x print nl
	uz @y print nl
	uz @z print nl

	// Test add
	Vec3 { x = 1.0 y = 2.0 z = 3.0 } -> a
	Vec3 { x = 4.0 y = 5.0 z = 6.0 } -> b
	a b vec3::add -> c
	"add:" print nl
	c @x print nl
	c @y print nl
	c @z print nl

	// Test subtract
	Vec3 { x = 5.0 y = 7.0 z = 9.0 } -> d
	Vec3 { x = 2.0 y = 3.0 z = 4.0 } -> e
	d e vec3::subtract -> f
	"sub:" print nl
	f @x print nl
	f @y print nl
	f @z print nl

	// Test scale
	Vec3 { x = 2.0 y = 3.0 z = 4.0 } -> g
	g 2.0 vec3::scale -> h
	"scale:" print nl
	h @x print nl
	h @y print nl
	h @z print nl

	// Test dot
	Vec3 { x = 1.0 y = 2.0 z = 3.0 } -> i
	Vec3 { x = 4.0 y = 5.0 z = 6.0 } -> j
	i j vec3::dot -> dot
	"dot:" print nl
	dot print nl

	// Test neg
	Vec3 { x = 3.0 y = 4.0 z = 5.0 } -> k
	k vec3::neg -> l
	"neg:" print nl
	l @x print nl
	l @y print nl
	l @z print nl
}
