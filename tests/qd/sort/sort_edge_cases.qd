use mem
use sort

fn main() {
	// Single element array
	1 8 * mem::alloc! -> arr1
	42 arr1 0 mem::set_i64
	arr1 1 sort::ints
	arr1 0 mem::get_i64 print nl
	arr1 mem::free

	// Already sorted
	3 8 * mem::alloc! -> arr2
	1 arr2 0 mem::set_i64
	2 arr2 8 mem::set_i64
	3 arr2 16 mem::set_i64
	arr2 3 sort::is_sorted print nl
	arr2 mem::free

	// Reverse sorted
	3 8 * mem::alloc! -> arr3
	3 arr3 0 mem::set_i64
	2 arr3 8 mem::set_i64
	1 arr3 16 mem::set_i64
	arr3 3 sort::is_sorted print nl
	arr3 3 sort::ints
	arr3 3 sort::is_sorted print nl
	arr3 mem::free

	// All duplicates
	4 8 * mem::alloc! -> arr4
	5 arr4 0 mem::set_i64
	5 arr4 8 mem::set_i64
	5 arr4 16 mem::set_i64
	5 arr4 24 mem::set_i64
	arr4 4 sort::ints
	arr4 4 sort::is_sorted print nl
	arr4 0 mem::get_i64 print nl
	arr4 mem::free

	// Reverse test
	3 8 * mem::alloc! -> arr5
	1 arr5 0 mem::set_i64
	2 arr5 8 mem::set_i64
	3 arr5 16 mem::set_i64
	arr5 3 sort::reverse
	arr5 0 mem::get_i64 print nl
	arr5 8 mem::get_i64 print nl
	arr5 16 mem::get_i64 print nl
	arr5 mem::free

	// Negative numbers
	3 8 * mem::alloc! -> arr6
	-5 arr6 0 mem::set_i64
	0 arr6 8 mem::set_i64
	5 arr6 16 mem::set_i64
	arr6 3 sort::min print nl
	arr6 3 sort::max print nl
	arr6 mem::free
}
