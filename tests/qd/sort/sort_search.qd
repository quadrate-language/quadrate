use mem
use sort

fn main() {
	// Create sorted array [1, 2, 3, 4, 5]
	5 8 * mem::alloc! -> arr
	1 arr 0 mem::set_i64
	2 arr 8 mem::set_i64
	3 arr 16 mem::set_i64
	4 arr 24 mem::set_i64
	5 arr 32 mem::set_i64

	// Search for existing values
	arr 5 1 sort::search print nl
	arr 5 3 sort::search print nl
	arr 5 5 sort::search print nl

	// Search for non-existing values
	arr 5 0 sort::search print nl
	arr 5 6 sort::search print nl

	arr mem::free
}
