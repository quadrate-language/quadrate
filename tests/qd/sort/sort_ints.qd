use mem
use sort

fn main() {
	// Create array [5, 2, 8, 1, 9]
	5 8 * mem::alloc! -> arr
	5 arr 0 mem::set_i64
	2 arr 8 mem::set_i64
	8 arr 16 mem::set_i64
	1 arr 24 mem::set_i64
	9 arr 32 mem::set_i64

	// Sort ascending
	arr 5 sort::ints

	// Print sorted
	0 5 1 for it {
		it -> i
		arr i 8 * mem::get_i64 print " " print
	}
	nl

	// Sort descending
	arr 5 sort::ints_desc

	// Print sorted descending
	0 5 1 for it {
		it -> i
		arr i 8 * mem::get_i64 print " " print
	}
	nl

	arr mem::free
}
