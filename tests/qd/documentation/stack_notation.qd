// This test demonstrates Quadrate's stack notation in function declarations
// Format: fn name(inputs -- outputs)
// Where inputs and outputs have name:type annotations
use math

// Basic arithmetic with stack notation
fn add_numbers(i64 i64 -- i64) {
	// a and b are consumed from stack, result is produced
	+
}

fn multiply_then_add(i64 i64 i64 -- i64) {
	// Stack is [a, b, c] with c on top
	// Computes (b * c) + a
	* +
}

// Functions with float parameters
fn multiply_floats(f64 f64 -- f64) {
	*
}

fn divide_floats(f64 f64 -- f64) {
	/
}

// Stack manipulation operations
fn swap_values(i64 i64 -- i64 i64) {
	swap
}

// Functions demonstrating stack effects
fn square_and_double(i64 -- i64 i64) {
	// Returns x*x and x*2
	dup
	dup mul swap
	2 *
}

// Min/max operations with stack notation
fn triple_min(i64 i64 i64 -- i64) {
	math::min
	math::min
}

fn triple_max(i64 i64 i64 -- i64) {
	math::max
	math::max
}

// Logical operations
fn bitwise_and_or(i64 i64 i64 -- i64) {
	and
	or
}

// Functions demonstrating drop
fn keep_first(i64 i64 -- i64) {
	drop
}

fn keep_first_of_four(i64 i64 i64 i64 -- i64) {
	drop2
	drop
}

// Rotation example
fn rotate_three(i64 i64 i64 -- i64 i64 i64) {
	rot
}

// Mixed types
fn int_to_float_calc(i64 f64 -- f64) {
	// Integer is automatically promoted to float
	+
}

// Demonstrate stack notation with no parameters
fn get_answer( -- answer:i64) {
	42
}

// Consume but produce nothing
fn consume_two(i64 i64 -- ) {
	drop
	drop
}

fn main() {
	// Test basic arithmetic
	5 3 add_numbers print nl
	// Should print nl 8
	2 3 4 multiply_then_add print nl
	// Should print nl 14 ((3*4)+2)
	// Test float operations
	3.5 2.0 multiply_floats print nl
	// Should print nl 7.000000
	10.0 4.0 divide_floats print nl
	// Should print nl 2.500000
	// Test stack manipulation
	10 20 swap_values print nl print nl
	// Should print nl 10, 20
	// Test multiple outputs
	5 square_and_double print nl print nl
	// Should print nl 10, 25
	// Test triple min/max
	5 3 8 triple_min print nl
	// Should print nl 3
	5 3 8 triple_max print nl
	// Should print nl 8
	// Test logical operations
	12 10 3 bitwise_and_or print nl
	// Should print nl 14 ((10 & 3) | 12 = 2 | 12)
	// Test drop operations
	100 200 keep_first print nl
	// Should print nl 100
	1 2 3 4 keep_first_of_four print nl
	// Should print nl 1
	// Test rotation
	1 2 3 rotate_three print nl print nl print nl
	// Should print nl 1, 3, 2
	// Test mixed types
	5 3.5 int_to_float_calc print nl
	// Should print nl 8.500000
	// Test function with no inputs
	get_answer print nl
	// Should print nl 42
	// Test function with no outputs
	99 88 consume_two
	// Consumes but prints nothing
	// Test negation with clear stack effect
	42 neg print nl
	// Should print nl -42
	// Test modulo
	17 5 mod print nl
	// Should print nl 2
	// Demonstrate inline stack notation as comments
	// (a b -- min max) Pattern: get both min and max
	// We can't use dup2 on parameters yet, so we use explicit values
	7 13 dup2
	math::min
	rot
	rot
	math::max print nl print nl
	// Should print nl 13, 7
}
