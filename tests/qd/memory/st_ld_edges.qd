// Test: edge cases for st/ld builtins: byte access, max values, overwrite
use mem

fn main() {
	64 mem::alloc! -> buf

	// Byte-level access within a 16-bit store (little-endian)
	buf 0 0x4142 st16
	buf 0 ld8 print nl
	buf 1 ld8 print nl

	// Multiple values at different offsets
	buf 0 10 st8
	buf 1 20 st8
	buf 2 30 st8
	buf 0 ld8 print nl
	buf 1 ld8 print nl
	buf 2 ld8 print nl

	// Overwrite and re-read
	buf 0 255 st8
	buf 0 ld8 print nl

	// Zero value
	buf 0 0 st64
	buf 0 ld64 print nl

	// Max u8
	buf 0 255 st8
	buf 0 ld8 print nl

	// Max u16
	buf 0 65535 st16
	buf 0 ld16 print nl

	// Max u32
	buf 0 4294967295 st32
	buf 0 ld32 print nl

	buf free
	"done" print nl
}
