// Test hex validation functions
use hex

fn main() {
	// Valid hex strings
	"" hex::is_valid print nl
	"00" hex::is_valid print nl
	"48656C6C6F" hex::is_valid print nl
	"48656c6c6f" hex::is_valid print nl
	"ABCDEF" hex::is_valid print nl
	"abcdef" hex::is_valid print nl
	"0123456789ABCDEFabcdef" hex::is_valid print nl

	// Invalid hex strings
	"0" hex::is_valid print nl
	"123" hex::is_valid print nl
	"GG" hex::is_valid print nl
	"ZZ" hex::is_valid print nl
	"4G" hex::is_valid print nl
	" 00" hex::is_valid print nl

	// Length checks
	"Hello" hex::encoded_len print nl
	"48656C6C6F" hex::decoded_len print nl
	"123" hex::decoded_len print nl
}
