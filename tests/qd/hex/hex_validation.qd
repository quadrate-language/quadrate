// Test hex validation functions
use hex

fn main( -- ) {
	// Valid hex strings
	"" hex::is_valid . nl
	"00" hex::is_valid . nl
	"48656C6C6F" hex::is_valid . nl
	"48656c6c6f" hex::is_valid . nl
	"ABCDEF" hex::is_valid . nl
	"abcdef" hex::is_valid . nl
	"0123456789ABCDEFabcdef" hex::is_valid . nl

	// Invalid hex strings
	"0" hex::is_valid . nl
	"123" hex::is_valid . nl
	"GG" hex::is_valid . nl
	"ZZ" hex::is_valid . nl
	"4G" hex::is_valid . nl
	" 00" hex::is_valid . nl

	// Length checks
	"Hello" hex::encoded_len . nl
	"48656C6C6F" hex::decoded_len . nl
	"123" hex::decoded_len . nl
}
