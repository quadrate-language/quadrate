// Test hex encode functions
use hex

fn main( -- ) {
	// Basic encoding (uppercase)
	"Hello" hex::encode print nl
	"A" hex::encode print nl
	"" hex::encode print nl

	// Lowercase encoding
	"Hello" hex::encode_lower print nl
	"ABC" hex::encode_lower print nl

	// Special characters
	" " hex::encode print nl

	// Numbers
	"0123456789" hex::encode print nl

	// Mixed case letters
	"AaBbCc" hex::encode print nl
}
