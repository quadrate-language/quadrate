// Test hex edge cases
use hex

fn main() {
	// Large value for encode_byte (should be clamped to 255)
	256 hex::encode_byte print nl
	1000 hex::encode_byte print nl

	// Decode with invalid characters (pairs are skipped)
	"48GG65" hex::decode print nl
	"ZZZZ" hex::decode print nl

	// Very long hex string
	"414141414141414141414141414141414141414141" hex::decode print nl

	// Empty roundtrip
	"" hex::encode print nl
	"" hex::decode print nl
}
