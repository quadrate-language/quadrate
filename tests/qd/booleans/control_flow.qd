// Test booleans in control flow
fn main() {
	// Simple if with true/false
	"=== Simple if ===" print nl
	true if { "true branch" print nl }
	false if { "false branch" print nl }
	"after false if" print nl

	// If-else with booleans
	"=== If-else ===" print nl
	true if { "A" } else { "B" } print nl
	false if { "A" } else { "B" } print nl

	// Comparison results in if
	"=== Comparison in if ===" print nl
	5 3 gt if { "5 > 3" print nl }
	3 5 gt if { "3 > 5" print nl }
	"done" print nl

	// Boolean in loop with condition check
	"=== While loop ===" print nl
	5 -> i
	loop {
		i 0 <= if { break }
		i print " " print
		i -- -> i
	}
	nl

	// Nested conditions
	"=== Nested ===" print nl
	true if {
		false if {
			"inner" print nl
		}
		"outer" print nl
	}
}
