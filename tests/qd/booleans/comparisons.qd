// Test: boolean comparisons
fn main() {
	// Equality
	"=== Equality ===" print nl
	1 1 == print nl      // 1 (true)
	1 2 == print nl      // 0 (false)
	0 0 == print nl      // 1 (true)

	// Inequality
	"=== Inequality ===" print nl
	1 1 != print nl     // 0 (false)
	1 2 != print nl     // 1 (true)

	// Less than
	"=== Less than ===" print nl
	1 2 < print nl      // 1
	2 1 < print nl      // 0
	1 1 < print nl      // 0

	// Greater than
	"=== Greater than ===" print nl
	2 1 > print nl      // 1
	1 2 > print nl      // 0
	1 1 > print nl      // 0

	// Less than or equal
	"=== Less or equal ===" print nl
	1 2 <= print nl     // 1
	2 1 <= print nl     // 0
	1 1 <= print nl     // 1

	// Greater than or equal
	"=== Greater or equal ===" print nl
	2 1 >= print nl     // 1
	1 2 >= print nl     // 0
	1 1 >= print nl     // 1

	// With floats
	"=== Float comparisons ===" print nl
	1.5 2.5 < print nl  // 1
	2.5 1.5 > print nl  // 1
	1.0 1.0 == print nl  // 1
}
