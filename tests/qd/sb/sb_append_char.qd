// Test StringBuilder append_char
use sb

fn main( -- ) {
	// Test single char
	sb::new -> builder
	builder 65 sb::append_char -> builder  // 'A'
	builder sb::finish -> result
	result print nl

	// Test multiple chars
	sb::new -> builder
	builder 72 sb::append_char -> builder  // H
	builder 101 sb::append_char -> builder // e
	builder 108 sb::append_char -> builder // l
	builder 108 sb::append_char -> builder // l
	builder 111 sb::append_char -> builder // o
	builder sb::finish -> result
	result print nl

	// Test mixed with strings
	sb::new -> builder
	builder "[" sb::append -> builder
	builder 88 sb::append_char -> builder  // X
	builder "]" sb::append -> builder
	builder sb::finish -> result
	result print nl
}
