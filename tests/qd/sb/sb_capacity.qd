// Test StringBuilder with_capacity
use sb

fn main() {
	// Test with small capacity (should work and grow)
	8 sb::with_capacity -> builder
	builder "Hello, World! This is a longer string." sb::append -> builder
	builder sb::finish -> result
	result print nl

	// Test with large capacity
	1024 sb::with_capacity -> builder
	builder "Short" sb::append -> builder
	builder sb::finish -> result
	result print nl
}
