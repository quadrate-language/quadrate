// Test basic StringBuilder operations
use sb
use str

fn main() {
	// Test 1: Create and build empty
	sb::new -> builder
	builder sb::build -> result
	result str::len print nl
	builder sb::free

	// Test 2: Append single string
	sb::new -> builder
	builder "Hello" sb::append -> builder
	builder sb::build -> result
	result print nl
	builder sb::free

	// Test 3: Append multiple strings (using finish which frees)
	sb::new -> builder
	builder "Hello" sb::append -> builder
	builder ", " sb::append -> builder
	builder "World!" sb::append -> builder
	builder sb::finish -> result
	result print nl
}
