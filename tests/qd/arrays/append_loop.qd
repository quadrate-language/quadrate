// Test: building array in a loop
fn main() {
	0 makei -> arr
	0 5 1 for it {
		arr it append -> arr
	}
	arr len print nl          // Should print = 5
	arr 0 nth print nl        // Should print = 0
	arr 1 nth print nl        // Should print = 1
	arr 2 nth print nl        // Should print = 2
	arr 3 nth print nl        // Should print = 3
	arr 4 nth print nl        // Should print = 4
}
