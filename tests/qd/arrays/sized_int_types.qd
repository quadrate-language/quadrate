// Test: [n]T with various integer types
fn main() {
	// All these should map to qd_makei
	[2]i32 -> arr1
	arr1 0 100 set
	arr1 0 nth print nl       // Should print = 100

	[2]u64 -> arr2
	arr2 0 200 set
	arr2 0 nth print nl       // Should print = 200

	[2]i8 -> arr3
	arr3 0 50 set
	arr3 0 nth print nl       // Should print = 50

	[2]u8 -> arr4
	arr4 0 25 set
	arr4 0 nth print nl       // Should print = 25
}
