// Test make<T> with expression for size
fn main( -- ) {
	// Size from expression
	3 2 * make<i64> -> arr    // 6 elements
	arr len print nl          // Should print = 6

	// Size from variable
	5 -> n
	n make<f64> -> floats
	floats len print nl       // Should print = 5

	// Size from function result
	get_size make<i64> -> arr2
	arr2 len print nl         // Should print = 4
}

fn get_size( -- n:i64) {
	4
}
