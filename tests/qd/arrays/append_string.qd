// Test append with string array
fn main( -- ) {
	// Create empty array and append strings
	0 makes "hello" append "world" append "test" append -> arr
	arr len print nl          // Should print = 3
	arr 0 nth print nl        // Should print: hello
	arr 1 nth print nl        // Should print: world
	arr 2 nth print nl        // Should print: test
}
