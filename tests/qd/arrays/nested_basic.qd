// Test: basic nested arrays (array of arrays)

fn main() {
	// Create outer array to hold 1 inner array
	[1][]i64 -> outer

	// Create inner array
	[4]i64 -> arr
	arr 0 100 set
	arr 1 200 set
	arr 2 300 set
	arr 3 400 set

	// Store inner array
	outer 0 arr set

	// Access and print elements (an element is an array, read with nth again)
	"arr[0]: " print outer 0 nth 0 nth print nl
	"arr[1]: " print outer 0 nth 1 nth print nl
	"arr[2]: " print outer 0 nth 2 nth print nl
	"arr[3]: " print outer 0 nth 3 nth print nl

	// Print length
	"arr len: " print outer 0 nth len print nl

	// Free outer array (should recursively free inner array)
	outer free
}
