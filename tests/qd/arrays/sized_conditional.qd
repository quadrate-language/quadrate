// Test: [n]T inside conditionals
fn main() {
	1 -> use_floats

	use_floats if {
		[3]f64 -> arr
		arr 0 1.5 set
		arr 0 nth print nl    // Should print = 1.5
	} else {
		[3]i64 -> arr
		arr 0 42 set
		arr 0 nth print nl
	}

	// Nested conditional
	0 -> flag
	flag if {
		"not reached" print nl
	} else {
		[2]i64 -> inner
		inner 0 99 set
		inner 0 nth print nl  // Should print = 99
	}
}
