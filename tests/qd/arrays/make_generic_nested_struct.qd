// Test: make<T> with nested structs
struct Container {
	value:i64
	data:ptr
}

fn main() {
	// Create array of Container structs
	2 make<Container> -> containers

	// Create inner arrays
	3 make<i64> -> arr1
	arr1 0 10 set
	arr1 1 20 set
	arr1 2 30 set

	2 make<i64> -> arr2
	arr2 0 100 set
	arr2 1 200 set

	// Create containers and store
	Container { value = 1 data = arr1 } -> c1
	Container { value = 2 data = arr2 } -> c2

	containers 0 c1 set
	containers 1 c2 set

	// Verify
	containers 0 nth <<value print nl      // Should print = 1
	containers 1 nth <<value print nl      // Should print = 2

	// Access inner arrays
	containers 0 nth <<data 1 nth print nl // Should print = 20
	containers 1 nth <<data 0 nth print nl // Should print = 100

	// Free inner arrays and container array
	arr1 free
	arr2 free
	containers free
}
