// Test set with string array
fn main( -- ) {
	// Create string array and set elements
	3 makes -> arr
	arr 0 "first" set
	arr 1 "second" set
	arr 2 "third" set
	arr 0 nth print nl        // Should print: first
	arr 1 nth print nl        // Should print: second
	arr 2 nth print nl        // Should print: third
}
