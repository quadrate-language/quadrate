// Test: [n]T with an expression for the size
fn main() {
	// Size from expression
	[3 2 *]i64 -> arr    // 6 elements
	arr len print nl          // Should print = 6

	// Size from variable
	5 -> n
	[n]f64 -> floats
	floats len print nl       // Should print = 5

	// Size from function result
	[get_size]i64 -> arr2
	arr2 len print nl         // Should print = 4
}

fn get_size( -- n:i64) {
	4
}
