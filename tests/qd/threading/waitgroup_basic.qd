// Test: basic WaitGroup operations
use thread

fn main() {
	// Test WaitGroup creation
	thread::wg_new! -> wg
	"created" print nl

	// Test add/done/wait cycle
	wg 2 add
	wg done
	wg done
	wg wait!
	"waited" print nl

	// Test another cycle
	wg 1 add
	wg done
	wg wait!
	"done" print nl

	wg free
}
