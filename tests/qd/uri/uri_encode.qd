// Test URI encoding
use uri

fn main() {
	// Basic encoding
	"hello world" uri::encode print nl
	"foo=bar" uri::encode print nl
	"a&b" uri::encode print nl

	// Safe characters pass through
	"hello-world_test.txt~" uri::encode print nl
	"ABCxyz012" uri::encode print nl

	// Empty string
	"" uri::encode print nl
}
