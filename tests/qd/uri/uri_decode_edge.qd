// Test URI decode edge cases
use uri

fn main() {
	// Incomplete percent at end
	"test%" uri::decode print nl
	"test%2" uri::decode print nl

	// Invalid hex digits
	"test%GG" uri::decode print nl
	"test%ZZ" uri::decode print nl

	// Consecutive percents
	"%%20" uri::decode print nl

	// Mixed valid/invalid
	"%41%ZZ%42" uri::decode print nl

	// Just percent
	"%" uri::decode print nl

	// Multiple valid
	"%48%65%6C%6C%6F" uri::decode print nl
}
