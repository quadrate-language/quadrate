// Test URI decode edge cases
use uri

fn main( -- ) {
	// Incomplete percent at end
	"test%" uri::decode . nl
	"test%2" uri::decode . nl

	// Invalid hex digits
	"test%GG" uri::decode . nl
	"test%ZZ" uri::decode . nl

	// Consecutive percents
	"%%20" uri::decode . nl

	// Mixed valid/invalid
	"%41%ZZ%42" uri::decode . nl

	// Just percent
	"%" uri::decode . nl

	// Multiple valid
	"%48%65%6C%6C%6F" uri::decode . nl
}
