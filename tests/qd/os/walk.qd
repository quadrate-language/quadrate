// Test: os::walk function (walk directory tree recursively)
use os

fn main() {
	// Cleanup from previous run
	"/tmp/qd_walk_test" os::exists
	if {
		"/tmp/qd_walk_test" os::rmdir!
	}

	// Setup: Create a directory tree
	"/tmp/qd_walk_test/a/b" os::mkdir!
	"/tmp/qd_walk_test/c" os::mkdir!
	"/tmp/qd_walk_test/d/e/f" os::mkdir!

	// Test: Walk the tree - callback receives (path:str is_dir:i64 depth:i64)
	// Count entries at each depth (filesystem walk order varies by platform)
	// Expected: depth0=3 (a,c,d), depth1=2 (b,e), depth2=1 (f)
	0 -> count0
	0 -> count1
	0 -> count2
	"/tmp/qd_walk_test" fn (path:str isdir:i64 depth:i64 -- ) {
		depth 0 == if { count0 1 + -> count0 }
		depth 1 == if { count1 1 + -> count1 }
		depth 2 == if { count2 1 + -> count2 }
	} os::walk!

	// Print counts for each depth
	"depth0=" print count0 print nl
	"depth1=" print count1 print nl
	"depth2=" print count2 print nl

	// Cleanup
	"/tmp/qd_walk_test" os::rmdir!

	"PASS" print nl
}
