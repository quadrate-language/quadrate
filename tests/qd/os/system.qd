// Test: os::system function
use os

fn main() {
	// Test simple echo command
	"echo 'Hello from os::system'" os::system
	print nl  // Should print 0 (success)

	// Test true command
	"true" os::system
	print nl  // Should print 0 (success)

	// The command's exit status, not the wait status: `false` used to give 256
	"false" os::system
	print nl  // 1

	"exit 3" os::system
	print nl  // 3
}
