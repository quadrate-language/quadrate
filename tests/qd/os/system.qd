// Test: os::system function
use os

fn main() {
	// Test simple echo command
	"echo 'Hello from os::system'" os::system
	print nl  // Should print 0 (success)

	// Test true command
	"true" os::system
	print nl  // Should print 0 (success)

	// Test false command (exits with non-zero)
	// Return value varies by platform (1 on some, 256 on others), so check non-zero
	"false" os::system
	0 != if { "non-zero" } else { "zero" } print nl
}
