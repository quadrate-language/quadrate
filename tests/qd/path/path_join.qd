use path

fn main() {
	// Test join
	"/home" "user" path::join . nl
	"/home/" "user" path::join . nl
	"" "user" path::join . nl
	"/home" "/absolute" path::join . nl

	// Test is_absolute
	"/home" path::is_absolute . nl
	"home" path::is_absolute . nl
	"/" path::is_absolute . nl
	"" path::is_absolute . nl
}
