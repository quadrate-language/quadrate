use path

fn main() {
	// Test ext
	"file.txt" path::ext print nl
	"file.tar.gz" path::ext print nl
	"file" path::ext print nl
	".hidden" path::ext print nl
	"/path/to/file.txt" path::ext print nl

	// Test stem
	"file.txt" path::stem print nl
	"file.tar.gz" path::stem print nl
	"file" path::stem print nl
	".hidden" path::stem print nl
	"/path/to/file.txt" path::stem print nl
}
