// Test: method returns
use math

struct Point2D {
	x:f64
	y:f64
}

fn (v:Point2D) length( -- len:f64) {
	v <<x dup * v <<y dup * + math::sqrt
}

fn (v:Point2D) lengthSquared( -- len2:f64) {
	v <<x dup * v <<y dup * +
}

fn main() {
	Point2D { x = 3.0 y = 4.0 } -> v
	v length print nl
	v lengthSquared print nl
}
