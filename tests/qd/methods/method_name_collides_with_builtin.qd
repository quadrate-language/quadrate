// Test: Regression: methods whose names collide with builtin instruction names
// (e.g. `dup`, `over`, `len`) must still dispatch correctly.
// Previously, the parser produced an AstNodeInstruction for these names,
// and the llvmgen instruction path constructed the function name via
// string concatenation without the module prefix, so the method call
// looked up a symbol that didn't exist.

struct Stack {
	top: i64
}

fn (s:Stack) dup( -- n:i64) {
	s <<top 2 *
}

fn (s:Stack) over( -- n:i64) {
	s <<top 0 *
}

fn (s:Stack) len( -- n:i64) {
	s <<top
}

fn main() {
	Stack { top = 21 } -> s
	s dup print nl
	s over print nl
	s len print nl
}
