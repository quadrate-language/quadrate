// cast<f128>, and casting an f128 to the other types.
use strconv

fn main() {
	// From an integer: exact, all 64 bits of it
	42 cast<f128> print nl
	-9223372036854775807 1 - cast<f128> print nl

	// From an f64: the binary value, correctly rounded to 34 digits -- which is why an f128
	// literal is written with a q rather than converted from an f64 one
	0.1 cast<f128> print nl
	0.5 cast<f128> print nl
	1.0 cast<f128> print nl
	1024.0 cast<f128> print nl
	-0.0 cast<f128> print nl

	// To an integer: toward zero, saturating, and total
	2.9q cast<i64> print nl
	-2.9q cast<i64> print nl
	1e30q cast<i64> print nl
	-1e30q cast<i64> print nl
	0q 0q / cast<i64> print nl

	// To an f64: the nearest one
	0.1q cast<f64> print nl
	2.5q cast<f64> 2.0 * print nl

	// To a string: the to-scientific-string form
	1.10q cast<str> print nl
	1.5e+40q cast<str> print nl
	0.000001q cast<str> print nl
	0.0000001q cast<str> print nl
	1q 0q / cast<str> print nl

	// An f128 is already one
	7.25q cast<f128> print nl

	// Interpolation spells it the same way
	19.99q -> price
	price 2q * -> twice
	$"price {price}, twice {twice}" print nl

	// Parsing is fallible, and takes the whole string or nothing
	"0.1" strconv::parse_f128! print nl
	"-1.5e-3" strconv::parse_f128! print nl
	"Infinity" strconv::parse_f128! print nl
	"1.5x" strconv::parse_f128 if { print nl } else { "rejected 1.5x" print nl }
	" 1" strconv::parse_f128 if { print nl } else { "rejected leading space" print nl }
}
