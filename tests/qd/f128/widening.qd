// An i64 widens to an f128 exactly -- it has at most 19 digits of the 34 -- in arithmetic,
// in comparisons, and as an argument to an f128 parameter. An f64 does not; see
// compile_errors/f128_mixed_float.

use f128

fn half(x:f128 -- y:f128) {
	x 2 /
}

// Each argument where it lies: the deepest and the top widen, the middle one stays an i64
fn mix(a:f128 b:i64 c:f128 -- r:f128) {
	a b + c *
}

// The same for f64, whose casts go through the same place. The deepest one used to be
// swapped to the top and back, which for anything below second place left it uncast:
// 1 / 2 as integers, 0.
fn halff(a:f64 b:i64 c:f64 -- r:f64) {
	a 2 /
}

fn main() {
	// Both orders, every operator
	2 1.5q + print nl
	1.5q 2 + print nl
	7 0.5q - print nl
	0.1q 3 * print nl
	1 3q / print nl
	10q 4 / print nl

	// Comparisons
	2 2.0q == print nl
	1 1.5q < print nl
	3q 2 > print nl
	2 2.000q != print nl

	// The whole range of an i64, exactly
	9223372036854775807 0q + print nl
	-9223372036854775808 1q - print nl
	9223372036854775807 1q + print nl

	// Arguments
	7 half print nl
	2 f128::sqrt print nl
	1 2 3 mix print nl
	1 7 3 halff print nl

	// An accumulation that starts from an integer
	0 -> total
	1 4 1 for i {
		total i 0.25q * + -> total
	}
	total print nl
}
