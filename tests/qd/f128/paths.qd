// An f128 is sixteen bytes held wherever it lives. Every path a value can take is driven
// here with values whose two words both matter -- 34 digits, an exponent far from zero, a
// leading 8 or 9, either sign -- so a copy that kept only the first word could not print
// back what went in.

const Far = 1.234567890123456789012345678901234e+6000q

var held:f128 = -9.876543210987654321098765432109876e-4321q

struct Pair {
	tag:str
	a:f128
	b:f128
}

struct Cell<T> {
	value:T
}

fn cell<T>(x:T -- c:Cell<T>) {
	Cell<T> { value = x }
}

fn twice<T>(x:T -- xs:[]T) {
	[2]T -> xs
	xs 0 x set
	xs 1 x set
	xs
}

fn pass(x:f128 -- y:f128) {
	x -> y
	y
}

fn swapped(a:f128 b:f128 -- c:f128 d:f128) {
	b a
}

fn keeper(x:f128 -- k:ptr) {
	x -> v
	fn( -- r:f128) { v }
}

fn show_kept(x:f128 -- ) {
	x keeper -> k
	k call print nl
}

fn kind(x:f128 -- ) {
	x switch {
		Far { "far" print nl }
		8.888888888888888888888888888888888q { "eights" print nl }
		_ { "other" print nl }
	}
}

fn deferred(x:f128 -- ) {
	defer { x print nl }
	"before" print nl
}

fn main() {
	-9.876543210987654321098765432109876e-4321q -> b
	8.888888888888888888888888888888888q -> c

	// Locals, parameters and results
	"locals" print nl
	Far -> a
	a print nl
	b print nl
	a pass print nl
	a b swapped print nl print nl
	0 3 1 for i {
		c -> a
	}
	a print nl

	// Stack shuffles
	"shuffles" print nl
	Far b c rot print nl print nl print nl
	Far b over print nl print nl print nl
	Far b swap print nl print nl
	Far dup print nl print nl

	// A global, read and written
	"global" print nl
	held print nl
	Far -> held
	held print nl

	// Struct fields, on construction, after a set, and in a clone
	"struct" print nl
	Pair { tag = "p" a = Far b = b } -> p
	p <<a print nl
	p <<b print nl
	p c >>a drop
	p clone -> q
	q <<a print nl
	q <<b print nl

	// A generic field
	"generic" print nl
	b cell -> box
	box <<value print nl
	box Far >>value drop
	box clone -> other
	other <<value print nl

	// Arrays: a literal, a sized one, and an untyped one widened by set
	"arrays" print nl
	[Far b] -> xs
	xs 1 nth print nl
	xs c append -> xs
	xs 2 nth print nl
	[2]f128 -> zs
	zs 0 nth print nl
	zs 1 b set
	zs 1 nth print nl
	c twice -> ws
	ws 1 nth print nl

	// Closures: captured, and escaped from the frame that made them
	"closures" print nl
	fn( -- r:f128) { b } -> f
	f call print nl
	b show_kept
	Far show_kept

	// switch, defer and casts
	"switch" print nl
	Far kind
	c kind
	b kind
	b deferred
	b cast<str> print nl
	c cast<f64> print nl
}
