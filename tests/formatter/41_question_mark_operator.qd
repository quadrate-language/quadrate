use strconv

fn may_fail(x:i64 -- result:i64)! {
	x 0 < if { "negative" 1 panic }
	x
}

fn propagate(x:i64 -- result:i64)! {
	x may_fail?
	2 *
}

fn parse_and_add(a:str b:str -- sum:i64)! {
	-> b -> a
	a strconv::atoi? -> x
	b strconv::atoi? -> y
	x y +
}

fn caller() {
	5 propagate switch {
		Ok { -> val val print nl }
		_ { "failed" print nl }
	}
	"10" "20" parse_and_add switch {
		Ok { -> val val print nl }
		_ { "parse failed" print nl }
	}
}
