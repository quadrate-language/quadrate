// Test: a def that only pushes its inputs back in order could be a fn
def sum(a:i64 b:i64 -- s:i64) {
	a b +
}

// Not flagged: an input is used twice
def square(x:i64 -- y:i64) {
	x x *
}

// Not flagged: the inputs come back out of order
def less(a:i64 b:i64 -- r:i64) {
	b a <
}

// Not flagged: only some of the inputs are pushed first
def scale(x:i64 k:i64 -- y:i64) {
	x 2 * k *
}

// Not flagged: a later use of the name
def twice(x:i64 -- a:i64 b:i64) {
	x 1 + x
}

// Not flagged: already a fn
fn plus(a:i64 b:i64 -- s:i64) {
	+
}

fn main() {
	1 2 sum 3 square 4 5 less 6 7 scale 8 twice plus plus plus plus plus print nl
	// The anonymous form too
	1 def (n:i64 -- r:i64) { n 1 + } call print nl
	2 def (n:i64 -- r:i64) { n n * } call print nl
}
