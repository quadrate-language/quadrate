# Standard library modules with a C backend. The pure-Quadrate ones carry no
# meson.build and are installed from their qd/ directory by the Makefile.

# math is not here: an embedder linking lib/interp wants its words without the
# rest of this, so the top-level meson.build adds it whether or not the standard
# library is being built.
subdir('fmt')
subdir('io')
subdir('mem')
subdir('net')
subdir('os')
subdir('signal')
subdir('strings')
subdir('strconv')
subdir('testing')
subdir('time')
subdir('thread')
subdir('tty')
subdir('tls')
subdir('http')
subdir('log')
