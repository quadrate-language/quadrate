/// Regular expression matching using Thompson NFA.
/// Supports . * + ? | () [] [^] [a-z] ^ $ and escapes.
/// Note: Nested groups and alternation inside groups not yet supported.
/// doccheck: page-context
use bits
use mem
use sb
use strings
use unicode

// NFA state types
enum StateType {
	Char
	Any
	Split
	Match
	Cclass
	Ncclass
	Bol
	Eol
}

// One NFA state. Which fields carry meaning depends on `kind`:
//   Char            -- ch, out1
//   Any, Bol, Eol   -- out1
//   Split           -- out1 and out2
//   Cclass, Ncclass -- cclass, out1
//   Match           -- none of them
// The language cannot express that, so every state carries every field and the rule
// lives in this comment; `kind` is checked in the places a match on a variant type
// would have been.
struct State {
	kind:   i64
	ch:     i64
	out1:   i64
	out2:   i64
	cclass: i64
}

// The compiled machine, held by the public Regex above.
struct Nfa {
	states:   []State
	nstates:  i64
	start:    i64
	cclasses: ptr
	ncclass:  i64
}

// Parser state
struct Parser {
	pat: ptr
	pos: i64
	len: i64
	nfa: Nfa
}

/// Compiled regular expression.
/// @field re Nfa Internal NFA state
pub struct Regex {
	re: Nfa
}

// Max states and character classes
const MAX_STATES = 256
const MAX_CCLASS = 32

// Allocate a new regex structure
fn regex_new( -- re:Nfa) {
	MAX_CCLASS 8 * mem::alloc! -> cclasses
	Nfa {
		states = []State
		nstates = 0
		start = 0
		cclasses = cclasses
		ncclass = 0
	}
}

// The state at an index. Typed, so the field names used on the result are checked
// against State rather than against every struct in the program.
fn state_at(re:Nfa idx:i64 -- s:State) {
	re <<states idx nth
}

// Add a state to the regex, returns state index
fn add_state(re:Nfa stype:i64 -- idx:i64) {
	re <<nstates -> n
	n MAX_STATES >= if {
		-1  // overflow
	} else {
		State {
			kind = stype
			ch = 0
			out1 = -1
			out2 = -1
			cclass = -1
		} -> s
		// States are only ever added at the end, so this is an append. It used to preallocate
		// MAX_STATES null slots and `set` into them, which cost 256 slots for every regex and
		// left the unfilled ones as nulls a field access would have walked into.
		re <<states s append drop
		re n 1 + >>nstates drop
		n
	}
}

// Create character class bitmap (32 bytes = 256 bits)
fn cclass_new( -- cc:ptr) {
	32 mem::alloc! -> cc
	cc 32 mem::zero
	cc
}

// Add cclass to regex, returns cclass index
fn add_cclass(re:Nfa cc:ptr -- idx:i64) {
	re <<ncclass -> n
	n MAX_CCLASS >= if {
		cc mem::free
		-1
	} else {
		cc re <<cclasses n 8 * mem::set_ptr
		re n 1 + >>ncclass drop
		n
	}
}

// Get cclass pointer by index
fn get_cclass(re:Nfa idx:i64 -- cc:ptr) {
	idx -1 == if {
		null
	} else {
		re <<cclasses idx 8 * mem::get_ptr
	}
}

// Set bit in character class
fn cclass_set(cc:ptr c:i64 -- ) {
	c 255 bits::and -> c
	c 8 / -> byte_idx
	c 8 % -> bit_idx
	cc byte_idx mem::get_byte -> b
	1 bit_idx shl b bits::or -> b
	b cc byte_idx mem::set_byte
}

// Test bit in character class
fn cclass_test(cc:ptr c:i64 -- result:i64) {
	c 255 bits::and -> c
	c 8 / -> byte_idx
	c 8 % -> bit_idx
	cc byte_idx mem::get_byte -> b
	b bit_idx shr 1 bits::and
}

// Parser: create parser state
fn parser_new(pattern:str re:Nfa -- ps:Parser) {
	pattern mem::from_string -> plen -> pbuf
	Parser {
		pat = pbuf
		pos = 0
		len = plen
		nfa = re
	}
}

// Parser: free
fn parser_free(ps:Parser -- ) {
	ps <<pat mem::free
}

// Parser: peek current char (or -1 if at end)
fn parser_peek(ps:Parser -- c:i64) {
	ps <<pos -> pos
	ps <<len -> plen
	pos plen >= if {
		-1
	} else {
		ps <<pat pos mem::get_byte
	}
}

// Parser: advance and return current char
fn parser_next(ps:Parser -- c:i64) {
	ps parser_peek -> c
	c -1 != if {
		ps ps <<pos 1 + >>pos drop
	}
	c
}

// Parse escape sequence, returns character
fn parse_escape(ps:Parser -- c:i64) {
	ps parser_next -> c
	c switch {
		unicode::n {
			unicode::newline -> c
		}
		unicode::t {
			unicode::tab -> c
		}
		unicode::r {
			unicode::cr -> c
		}
		unicode::digit0 {
			unicode::nul -> c
		}
	}
	c
}

// Parse character class [...], returns state index
fn parse_cclass(ps:Parser -- start:i64) {
	ps <<nfa -> re

	// Check for negation
	0 -> negated
	ps parser_peek unicode::caret == if {
		ps parser_next drop
		1 -> negated
	}

	cclass_new -> cc

	// Parse characters until ]
	loop {
		ps parser_peek -> c
		c -1 == c unicode::rbracket == or if {
			break
		}

		ps parser_next drop

		c unicode::backslash == if {
			ps parse_escape -> c
		}

		// Check for range
		ps parser_peek unicode::minus == if {
			ps parser_next drop
			ps parser_peek -> end_c
			end_c unicode::rbracket == end_c -1 == or if {
				cc c cclass_set
				cc unicode::minus cclass_set
			} else {
				ps parser_next drop
				end_c unicode::backslash == if {
					ps parse_escape -> end_c
				}
				c -> i
				loop {
					i end_c > if {
						break
					}
					cc i cclass_set
					i 1 + -> i
				}
			}
		} else {
			cc c cclass_set
		}
	}

	ps parser_peek unicode::rbracket == if {
		ps parser_next drop
	}

	negated if {
		StateType::Ncclass
	} else {
		StateType::Cclass
	}
	-> stype
	re stype add_state -> start
	re cc add_cclass -> ccidx
	re start state_at ccidx >>cclass drop
	start
}

// Parse atom: char, ., (), [], ^, $
fn parse_atom(ps:Parser -- start:i64 end:i64) {
	ps <<nfa -> re
	ps parser_peek -> c

	c switch {
		unicode::lparen {
			// (
			ps parser_next drop
			// Parse content - simplified, just parse sequence of atoms
			-1 -> gstart
			-1 -> gend
			loop {
				ps parser_peek -> nc
				nc -1 == nc unicode::rparen == or if {
					break
				}
				// Parse single atom - skip meta chars
				nc -1 != nc unicode::pipe != and nc unicode::rparen != and
				nc unicode::asterisk != and nc unicode::plus != and nc unicode::question != and if {
					ps parser_next drop
					re StateType::Char add_state -> nstate
					re nstate state_at nc >>ch drop
					gstart -1 == if {
						nstate -> gstart
						nstate -> gend
					} else {
						re gend state_at nstate >>out1 drop
						nstate -> gend
					}
				} else {
					break
				}
			}
			ps parser_peek unicode::rparen == if {
				ps parser_next drop
			}
			gstart -1 == if {
				-1 -1
			} else {
				gend gstart
			}
		}
		unicode::lbracket {
			// [
			ps parser_next drop
			ps parse_cclass -> start
			start start
		}
		unicode::dot {
			// .
			ps parser_next drop
			re StateType::Any add_state -> start
			start start
		}
		unicode::caret {
			// ^
			ps parser_next drop
			re StateType::Bol add_state -> start
			start start
		}
		unicode::dollar {
			// $
			ps parser_next drop
			re StateType::Eol add_state -> start
			start start
		}
		unicode::backslash {
			// \
			ps parser_next drop
			ps parse_escape -> c
			re StateType::Char add_state -> start
			re start state_at c >>ch drop
			start start
		}
		_ {
			// Regular character (not a metachar)
			c -1 != c unicode::pipe != and c unicode::rparen != and
			c unicode::asterisk != and c unicode::plus != and c unicode::question != and if {
				ps parser_next drop
				re StateType::Char add_state -> start
				re start state_at c >>ch drop
				start start
			} else {
				-1 -1
			}
		}
	}
}

// Helper: connect state to next, using OUT2 for SPLIT states
fn connect_state(re:Nfa sidx:i64 next:i64 -- ) {
	re sidx state_at <<kind StateType::Split == if {
		re sidx state_at next >>out2 drop
	} else {
		re sidx state_at next >>out1 drop
	}
}

// Parse repeat: atom*, atom+, atom?
fn parse_repeat(ps:Parser -- start:i64 end:i64) {
	ps <<nfa -> re
	ps parse_atom -> astart -> aend

	astart -1 == if {
		-1 -1
	} else {
		ps parser_peek switch {
			unicode::asterisk {
				// *
				ps parser_next drop
				re StateType::Split add_state -> split
				re split state_at astart >>out1 drop
				re aend state_at split >>out1 drop
				split split
			}
			unicode::plus {
				// +
				ps parser_next drop
				re StateType::Split add_state -> split
				re aend state_at split >>out1 drop
				re split state_at astart >>out1 drop
				split astart
			}
			unicode::question {
				// ?
				ps parser_next drop
				re StateType::Split add_state -> split
				re split state_at astart >>out1 drop
				re StateType::Split add_state -> join
				re aend state_at join >>out1 drop
				re split state_at join >>out2 drop
				join split
			}
			_ {
				aend astart
			}
		}
	}
}

// Parse concatenation
fn parse_concat(ps:Parser -- start:i64 end:i64) {
	ps <<nfa -> re
	ps parse_repeat -> start -> end

	start -1 == if {
		-1 -1
	} else {
		loop {
			ps parse_repeat -> nstart -> nend
			nstart -1 == if {
				break
			}
			re end nstart connect_state
			nend -> end
		}
		// Return order: push end first, then start (start pops first)
		end start
	}
}

// Parse alternation
fn parse_alt(ps:Parser -- start:i64 end:i64) {
	ps <<nfa -> re
	ps parse_concat -> start -> end

	start -1 == if {
		-1 -1
	} else {
		loop {
			ps parser_peek unicode::pipe != if {
				break
			}
			ps parser_next drop
			ps parse_concat -> astart -> aend
			astart -1 == if {
				break
			}

			re StateType::Split add_state -> split
			re split state_at start >>out1 drop
			re split state_at astart >>out2 drop

			re StateType::Split add_state -> join
			re end join connect_state
			re aend join connect_state

			split -> start
			join -> end
		}
		// Return order: push end first, then start (start pops first)
		end start
	}
}

/// Compile a regex pattern.
/// @param pattern str Regular expression pattern
/// @return re Regex Compiled regex
/// @example "[0-9]+" regex::compile -> re
pub fn compile(pattern:str -- re:Regex) {
	regex_new -> raw
	pattern raw parser_new -> ps

	ps parse_alt -> start -> end

	raw StateType::Match add_state -> match_state
	end -1 != if {
		raw end match_state connect_state
	}
	start -1 != if {
		raw start >>start drop
	}

	ps parser_free
	Regex {
		re = raw
	}
}

/// Free a compiled regex.
/// @example "a+" regex::compile regex::release
pub fn (self:Regex) release() {
	self <<re -> re
	// Free character classes
	re <<ncclass -> n
	0 -> i
	loop {
		i n >= if {
			break
		}
		re <<cclasses i 8 * mem::get_ptr mem::free
		i 1 + -> i
	}
	re <<cclasses mem::free
	// The state array and the Nfa itself are refcounted values, not raw allocations.
}

// Add state to set with epsilon closure (visited is separate array)
fn addstate(re:Nfa states:ptr visited:ptr idx:i64 listid:i64 -- ) {
	idx -1 == if {
	} else {
		// Check if already visited for this listid
		visited idx 8 * mem::get_i64 -> mark
		mark listid == if {
		} else {
			listid visited idx 8 * mem::set_i64

			// Add to states array
			states 0 mem::get_i64 -> n
			idx states n 1 + 8 * mem::set_i64
			n 1 + states 0 mem::set_i64

			// Follow epsilon transitions
			re idx state_at <<kind -> stype
			stype StateType::Split == if {
				re idx state_at <<out1 -> out1
				re idx state_at <<out2 -> out2
				re states visited out1 listid addstate
				re states visited out2 listid addstate
			}
		}
	}
}

// Check if state matches character
fn state_matches(re:Nfa idx:i64 c:i64 -- result:i64) {
	re idx state_at <<kind -> stype
	stype StateType::Char == if {
		re idx state_at <<ch c ==
	} else {
		stype StateType::Any == if {
			c -1 !=
		} else {
			stype StateType::Cclass == if {
				c -1 != if {
					re idx state_at <<cclass -> ccidx
					re ccidx get_cclass c cclass_test
				} else {
					0
				}
			} else {
				stype StateType::Ncclass == if {
					c -1 != if {
						re idx state_at <<cclass -> ccidx
						re ccidx get_cclass c cclass_test 0 ==
					} else {
						0
					}
				} else {
					0
				}
			}
		}
	}
}

/// Test if a string matches a compiled regex (full match).
/// @param s str String to match
/// @return result i64 1 if matches, 0 otherwise
pub fn (self:Regex) matches(s:str -- result:i64) {
	self <<re -> re
	s strings::len -> slen
	re <<nstates -> nstates

	// Allocate state sets and visited array
	nstates 1 + 8 * mem::alloc! -> clist
	nstates 1 + 8 * mem::alloc! -> nlist
	nstates 8 * mem::alloc! -> visited
	visited nstates 8 * mem::zero

	// Unique ID for epsilon closure
	1 -> listid

	// Start with initial state
	0 clist 0 mem::set_i64
	re clist visited re <<start listid addstate

	// Process each character
	0 -> pos
	loop {
		pos slen >= if {
			break
		}

		s pos strings::char_at -> c
		listid 1 + -> listid

		// Build next state set
		0 nlist 0 mem::set_i64
		clist 0 mem::get_i64 -> n
		0 -> i
		loop {
			i n >= if {
				break
			}
			clist i 1 + 8 * mem::get_i64 -> sidx
			re sidx c state_matches if {
				re sidx state_at <<out1 -> out
				re nlist visited out listid addstate
			}
			i 1 + -> i
		}

		// Swap lists
		clist -> tmp
		nlist -> clist
		tmp -> nlist

		pos 1 + -> pos
	}

	// Check for match state
	0 -> result
	clist 0 mem::get_i64 -> n
	0 -> i
	loop {
		i n >= result bits::or if {
			break
		}
		clist i 1 + 8 * mem::get_i64 -> sidx
		re sidx state_at <<kind StateType::Match == if {
			1 -> result
		}
		i 1 + -> i
	}

	clist mem::free
	nlist mem::free
	visited mem::free

	result
}

/// Compile and test if pattern matches string.
/// @param pattern str Regex pattern
/// @param s str String to match
/// @return result i64 1 if matches, 0 otherwise
/// @example "hello.*" "hello world" regex::is_match -> result
pub fn is_match(pattern:str s:str -- result:i64) {
	pattern compile -> re
	re s matches -> result
	re release
	result
}

// Internal: unwrap Regex for internal functions that take raw ptr
stack fn unwrap_re(self:Regex -- re:Nfa) {
	<<re
}

// Internal: find first match of compiled regex starting at or after 'from'.
// Returns start/end indices (end is exclusive), or -1/-1 if no match.
// This works by trying the NFA from each start position.
fn find_from(re:Nfa s:str from:i64 -- start:i64 end:i64) {
	s strings::len -> slen
	re <<nstates -> nstates

	nstates 1 + 8 * mem::alloc! -> clist
	nstates 1 + 8 * mem::alloc! -> nlist
	nstates 8 * mem::alloc! -> visited
	visited nstates 8 * mem::zero

	-1 -> mstart
	-1 -> mend
	1 -> listid

	from -> trypos
	loop {
		trypos slen > mstart -1 != or if {
			break
		}

		// Seed NFA at this start position
		listid 1 + -> listid
		0 clist 0 mem::set_i64
		re clist visited re <<start listid addstate

		// Check if start state already matches (zero-width)
		clist 0 mem::get_i64 -> n
		0 -> i
		loop {
			i n >= if { break }
			clist i 1 + 8 * mem::get_i64 -> sidx
			re sidx state_at <<kind StateType::Match == if {
				trypos -> mstart
				trypos -> mend
			}
			i 1 + -> i
		}

		// Walk characters from trypos
		trypos -> pos
		loop {
			pos slen >= if { break }
			clist 0 mem::get_i64 -> cn
			cn 0 == if { break }

			s pos strings::char_at -> c
			listid 1 + -> listid

			0 nlist 0 mem::set_i64
			0 -> i
			loop {
				i cn >= if { break }
				clist i 1 + 8 * mem::get_i64 -> sidx
				re sidx c state_matches if {
					re sidx state_at <<out1 -> out
					re nlist visited out listid addstate
				}
				i 1 + -> i
			}

			// Swap
			clist -> tmp
			nlist -> clist
			tmp -> nlist

			pos 1 + -> pos

			// Check for match in new state set
			clist 0 mem::get_i64 -> n2
			0 -> i
			loop {
				i n2 >= if { break }
				clist i 1 + 8 * mem::get_i64 -> sidx
				re sidx state_at <<kind StateType::Match == if {
					mstart -1 == if {
						trypos -> mstart
					}
					pos -> mend
				}
				i 1 + -> i
			}
		}

		mstart -1 != if {
			break
		}

		trypos 1 + -> trypos
	}

	clist mem::free
	nlist mem::free
	visited mem::free

	mend mstart
}

/// Find first match in string. Returns start and end (exclusive) indices.
/// Returns -1 -1 if no match found.
/// @param s str String to search
/// @return start i64 Start index of match (-1 if none)
/// @return end i64 End index of match, exclusive (-1 if none)
/// @example "[0-9]+" regex::compile -> re  re "abc123def" regex::find -> end -> start
pub fn (self:Regex) find(s:str -- start:i64 end:i64) {
	self <<re s 0 find_from
}

/// Find all non-overlapping matches. Returns array of start/end pairs and count.
/// Caller must free the returned array with mem::free.
/// @param s str String to search
/// @param max i64 Maximum matches to find (-1 for unlimited)
/// @return results ptr Array of i64 pairs [start0, end0, start1, end1, ...]
/// @return count i64 Number of matches found
/// @example "[0-9]+" regex::compile -> re  re "a1b22c333" -1 regex::find_all -> count -> results
pub fn (self:Regex) find_all(s:str max:i64 -- results:ptr count:i64) {
	self <<re -> re
	// Allocate initial results array (grow as needed)
	64 -> cap
	cap 2 * 8 * mem::alloc! -> results
	0 -> count
	0 -> pos

	loop {
		max -1 != count max >= and if { break }

		re s pos find_from -> fstart -> fend
		fstart -1 == if { break }

		// Grow if needed
		count cap >= if {
			cap 2 * -> cap
			cap 2 * 8 * -> newsize
			newsize mem::alloc! -> newbuf
			results newbuf count 2 * 8 * mem::copy
			results mem::free
			newbuf -> results
		}

		fstart results count 2 * 8 * mem::set_i64
		fend results count 2 * 1 + 8 * mem::set_i64
		count 1 + -> count

		// Advance past this match (at least 1 char to avoid infinite loop on zero-width)
		fend pos == if {
			fend 1 + -> pos
		} else {
			fend -> pos
		}
	}

	results count
}

/// Replace all matches with replacement string.
/// @param s str Input string
/// @param repl str Replacement string
/// @return result str String with all matches replaced
/// @example "[0-9]+" regex::compile -> re  re "abc123def456" "#" regex::replace -> result
pub fn (self:Regex) replace(s:str repl:str -- result:str) {
	self <<re -> re
	s strings::len -> slen
	sb::new -> out
	0 -> pos

	loop {
		re s pos find_from -> fstart -> fend
		fstart -1 == if {
			// Append remaining
			pos slen < if {
				s pos slen pos - strings::substring! -> tail
				out tail sb::append -> out
			}
			break
		}

		// Append text before match
		fstart pos > if {
			s pos fstart pos - strings::substring! -> before
			out before sb::append -> out
		}

		// Append replacement
		out repl sb::append -> out

		// Advance past match
		fend pos == if {
			// Zero-width match: copy one char and advance
			pos slen < if {
				s pos 1 strings::substring! -> ch
				out ch sb::append -> out
			}
			fend 1 + -> pos
		} else {
			fend -> pos
		}

		pos slen > if { break }
	}

	out sb::finish -> result
	result
}

/// Count non-overlapping matches in string.
/// @param s str String to search
/// @return count i64 Number of matches
/// @example "[0-9]+" regex::compile -> re  re "a1b22c333" regex::match_count -> n
pub fn (self:Regex) match_count(s:str -- count:i64) {
	self <<re -> re
	0 -> count
	0 -> pos

	loop {
		re s pos find_from -> fstart -> fend
		fstart -1 == if { break }
		count 1 + -> count
		fend pos == if {
			fend 1 + -> pos
		} else {
			fend -> pos
		}
		pos s strings::len > if { break }
	}

	count
}
