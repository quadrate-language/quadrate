/// Map<V> - A String-Keyed Hash Map
/// ====================================
///
/// Map stores key-value pairs with O(1) average lookup time.
/// Keys are strings, values can be any type V.
///
/// ## Creating a Map
///
/// Create an empty map with a struct literal:
///
///     Map<i64> { keys = 0 values = 0 states = 0 len = 0 cap = 0 } -> m
///
/// ## Basic Operations
///
/// Insert a key-value pair (map is returned, must be captured):
///
///     m "alice" 42 insert! -> m
///
/// Get a value by key (returns error if not found):
///
///     m "alice" get! -> age
///
/// Check if key exists:
///
///     m "alice" has -> exists
///
/// Remove a key:
///
///     m "alice" remove! -> m
///
/// ## Memory Management
///
/// Always call release when done to free memory:
///
///     m release

use mem
use strings

/// Hash map with string keys and values of any type V -- i64, f64, str, ptr or a struct. A
/// value lives in a tagged slot (mem::set_any), so it reads back as what was inserted, and the
/// map holds a reference to a string or a struct for as long as the entry is in it.
///
/// Fields:
///   keys   - Array of string key pointers
///   values - Array of V values
///   states - Array of slot states (0=empty, 1=occupied, 2=deleted)
///   len    - Number of entries
///   cap    - Allocated capacity
pub struct Map<V> {
	keys:   ptr
	values: ptr
	states: ptr
	len:    i64
	cap:    i64
}

// Internal: DJB2 hash a string key to an index
fn hash_key(key:str cap:i64 -- idx:i64) {
	key mem::from_string -> klen -> buf
	5381 -> hash
	0 klen 1 for i {
		hash 33 * buf i mem::get_byte + -> hash
	}
	buf mem::free
	hash cap mod -> idx
	// Ensure positive index
	idx 0 < if {
		idx cap + -> idx
	}
	idx
}

// Internal: Find slot for key (for insertion or lookup)
// Returns: slot index, and whether key was found (1) or empty slot (0)
fn find_slot(keys:ptr states:ptr cap:i64 key:str -- slot:i64 found:i64) {
	key cap hash_key -> start
	start -> idx
	-1 -> first_deleted

	loop {
		states idx 8 * mem::get_i64 -> state

		state 0 == if {
			// Empty slot - key not found
			first_deleted 0 >= if {
				first_deleted 0
			} else {
				idx 0
			}
			break
		}

		state 2 == if {
			// Deleted slot - remember for insertion
			first_deleted 0 < if {
				idx -> first_deleted
			}
		} else {
			// Occupied slot - check key
			keys idx 8 * mem::get_ptr strings::from_ptr -> existing_key
			existing_key key eq if {
				// Found the key
				idx 1
				break
			}
		}

		// Linear probing
		idx 1 + cap mod -> idx
		idx start == if {
			// Wrapped around - table full or key not found
			first_deleted 0 >= if {
				first_deleted 0
			} else {
				-1 0  // Should not happen if load factor is maintained
			}
			break
		}
	}
}

// Internal: Rehash all entries into new arrays of given capacity.
// Returns new_keys, new_values, new_states pointers.
fn rehash(old_keys:ptr old_values:ptr old_states:ptr old_cap:i64 new_cap:i64 -- new_keys:ptr new_values:ptr new_states:ptr)! {
	new_cap 8 * mem::alloc? -> new_keys
	new_cap mem::AnySize * mem::alloc? -> new_values
	new_cap 8 * mem::alloc? -> new_states

	// Initialize states to 0 (empty), and the value slots with them: set_any reads the slot it
	// is about to overwrite to release what was there, and a zeroed slot holds nothing.
	new_states new_cap 8 * mem::zero
	new_values new_cap mem::AnySize * mem::zero

	// Rehash existing entries
	old_cap 0 > if {
		0 -> i
		loop {
			i old_cap >= if { break }

			old_states i 8 * mem::get_i64 1 == if {
				// Occupied slot - rehash
				old_keys i 8 * mem::get_ptr -> key_ptr
				old_values i mem::AnySize * mem::get_any -> value

				key_ptr strings::from_ptr -> key
				new_keys new_states new_cap key find_slot -> found -> slot

				key_ptr new_keys slot 8 * mem::set_ptr
				value new_values slot mem::AnySize * mem::set_any
				old_values i mem::AnySize * mem::clear_any
				1 new_states slot 8 * mem::set_i64
			}

			i 1 + -> i
		}

		// Free old arrays
		old_keys mem::free
		old_values mem::free
		old_states mem::free
	}

	new_keys new_values new_states
}

/// Insert a key-value pair into the map.
///
/// If the key already exists, the value is updated.
/// Returns the updated map which must be captured.
///
/// Example:
///     m "alice" 42 insert! -> m
///
/// Stack: (m key value -- m2)
pub fn (m:Map<V>) insert<V>(key:str value:V -- m2:Map<V>)! {
	m <<keys -> keys
	m <<values -> values
	m <<states -> states
	m <<len -> len
	m <<cap -> cap

	// Check load factor and grow if needed (threshold: 70%)
	len 10 * cap 7 * >= cap 0 == or if {
		// Double capacity (or start at 8)
		8 -> new_cap
		cap 0 > if {
			cap 2 * -> new_cap
		}
		keys values states cap new_cap rehash? -> states -> values -> keys
		new_cap -> cap
	}

	keys states cap key find_slot -> found -> slot

	slot 0 < if {
		"insert: hash table is full" 1 panic
	}

	found 0 == if {
		// New key - allocate null-terminated copy and store
		// Bytes, not characters: strings::len counts codepoints, so a key with any non-ASCII
		// character in it was copied short and truncated mid-character.
		key strings::byte_len -> klen
		klen 1 + mem::alloc? -> key_buf
		key mem::from_string -> tmplen -> tmpbuf
		key_buf tmpbuf klen mem::copy
		0 key_buf klen mem::set_byte  // null terminate
		tmpbuf mem::free
		key_buf keys slot 8 * mem::set_ptr
		len 1 + -> len
	}

	// Store value and mark occupied
	value values slot mem::AnySize * mem::set_any
	1 states slot 8 * mem::set_i64

	// Written through the receiver, and the receiver is what comes back: a container is a
	// reference (3.2.1), and a fresh struct over the same buffer leaves every earlier copy
	// live and pointing at a buffer the next grow reallocates and `release` frees.
	m keys >>keys values >>values states >>states len >>len cap >>cap
}

/// Get the value for a key.
///
/// Returns an error if the key is not found.
///
/// Example:
///     m "alice" get! -> age
///
/// Stack: (m key -- value)
pub fn (m:Map<V>) get<V>(key:str -- value:V)! {
	m <<values -> values
	m <<keys -> keys
	m <<states -> states
	m <<cap -> cap

	cap 0 == if {
		"get: map is empty" 1 panic
	}

	keys states cap key find_slot -> found -> slot

	found 0 == if {
		"get: key not found" 1 panic
	}

	values slot mem::AnySize * mem::get_any
}

/// Check if a key exists in the map.
///
/// Example:
///     m "alice" has if { "found!" print nl }
///
/// Stack: (m key -- exists)
pub fn (m:Map<V>) has<V>(key:str -- exists:i64) {
	m <<cap -> cap

	cap 0 == if {
		0
	} else {
		m <<keys -> keys
		m <<states -> states
		keys states cap key find_slot -> found -> slot
		// slot is unused, found indicates if key exists
		found
	}
}

/// Remove a key from the map.
///
/// Returns error if the key is not found.
/// Returns the updated map which must be captured.
///
/// Example:
///     m "alice" remove! -> m
///
/// Stack: (m key -- m2)
pub fn (m:Map<V>) remove<V>(key:str -- m2:Map<V>)! {
	m <<keys -> keys
	m <<values -> values
	m <<states -> states
	m <<len -> len
	m <<cap -> cap

	cap 0 == if {
		"remove: map is empty" 1 panic
	}

	keys states cap key find_slot -> found -> slot

	found 0 == if {
		"remove: key not found" 1 panic
	}

	// Free the key string and let go of the value
	keys slot 8 * mem::get_ptr mem::free
	values slot mem::AnySize * mem::clear_any

	// Mark as deleted (tombstone)
	2 states slot 8 * mem::set_i64

	m len 1 - >>len
}

/// Get the number of entries in the map.
///
/// Example:
///     m length -> n
///
/// Stack: (m -- n)
pub fn (m:Map<V>) length<V>( -- n:i64) {
	m <<len
}

/// Check if the map is empty.
///
/// Example:
///     m is_empty if { "empty!" print nl }
///
/// Stack: (m -- bool)
pub fn (m:Map<V>) is_empty<V>( -- b:i64) {
	m <<len 0 ==
}

/// Free the map's memory.
///
/// IMPORTANT: Always call this when done with a map
/// to prevent memory leaks. After calling release,
/// the map should not be used.
///
/// Example:
///     m release
///
/// Stack: (m --)
pub fn (m:Map<V>) release<V>() {
	m <<keys -> keys
	m <<values -> values
	m <<states -> states
	m <<cap -> cap

	// Free key strings
	cap 0 > if {
		0 -> i
		loop {
			i cap >= if { break }

			states i 8 * mem::get_i64 1 == if {
				keys i 8 * mem::get_ptr mem::free
				values i mem::AnySize * mem::clear_any
			}

			i 1 + -> i
		}
	}

	// Free arrays
	keys 0 neq if { keys mem::free }
	values 0 neq if { values mem::free }
	states 0 neq if { states mem::free }

	// Cleared so a second `release` is a no-op rather than a double free: nothing stops a
	// caller holding two names for one container, and the freed buffer is what both hold.
	m null >>keys null >>values null >>states 0 >>len 0 >>cap drop
}
