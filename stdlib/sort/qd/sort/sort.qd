/// Sorting algorithms for arrays.
/// Every entry point takes a `[]T` -- `[]i64`, `[]f64` or `[]str` -- and nothing takes a count
/// beside it: the array carries its length, and saying it twice is a chance to say it wrong.
/// The sorts reorder in place; `min`, `max`, `search` and the `is_sorted` pair only read.
/// doccheck: page-context
/// doccheck: page-context fn by_length(a:i64 b:i64 -- order:i64) { a b - }
/// doccheck: page-context fn ascending(a:i64 b:i64 -- order:i64) { a b - }
/// doccheck: page-setup [5 2 8 1] -> arr
/// doccheck: page-setup [5.0 2.0 8.0 1.0] -> farr
/// doccheck: page-setup ["b" "a" "c" "d"] -> strs
use strings

// --- Internal quicksort helpers ---

// Swap two i64 elements in array
fn swap_i64(arr:[]i64 a:i64 b:i64 -- ) {
	arr a nth -> va
	arr b nth -> vb
	arr a vb set
	arr b va set
}

// Median-of-three pivot selection for i64
fn median3_i64(arr:[]i64 lo:i64 hi:i64 -- pivot:i64) {
	lo hi + 2 / -> mid
	arr lo nth -> a
	arr mid nth -> b
	arr hi nth -> c
	a b <= if {
		b c <= if { mid } else {
			a c <= if { hi } else { lo }
		}
	} else {
		a c <= if { lo } else {
			b c <= if { hi } else { mid }
		}
	}
}

// Insertion sort for small i64 partitions
fn isort_i64(arr:[]i64 lo:i64 hi:i64 -- ) {
	lo 1 + -> i
	loop {
		i hi > if { break }
		arr i nth -> key
		i 1 - -> j
		loop {
			j lo < if { break }
			arr j nth -> jval
			jval key <= if { break }
			arr j 1 + jval set
			j 1 - -> j
		}
		arr j 1 + key set
		i 1 + -> i
	}
}

// Quicksort for i64 ascending
fn qsort_i64_asc(arr:[]i64 lo:i64 hi:i64 -- ) {
	hi lo - 1 + -> n
	n 16 <= if {
		arr lo hi isort_i64
	} else {
		// Median-of-three pivot
		arr lo hi median3_i64 -> pivotIdx
		arr pivotIdx hi swap_i64
		arr hi nth -> pivot

		lo -> i
		hi 1 - -> j
		loop {
			// Find element >= pivot from left
			loop {
				// Bounded by hi, not j: the pivot sits at hi and stops this scan. Bounding it by j
				// let the scan stop on an element that still sorts *before* the pivot, and the
				// final swap below then placed the pivot to the left of it -- leaving the array
				// unsorted for every reverse-sorted input of even length 18 or more.
				i hi >= if { break }
				arr i nth pivot >= if { break }
				i 1 + -> i
			}
			// Find element <= pivot from right
			loop {
				j i <= if { break }
				arr j nth pivot <= if { break }
				j 1 - -> j
			}
			i j >= if { break }
			arr i j swap_i64
			i 1 + -> i
			j 1 - -> j
		}
		arr i hi swap_i64

		i 1 - lo >= if {
			arr lo i 1 - qsort_i64_asc
		}
		i 1 + hi <= if {
			arr i 1 + hi qsort_i64_asc
		}
	}
}

// Insertion sort for small i64 partitions (descending)
fn isort_i64_desc(arr:[]i64 lo:i64 hi:i64 -- ) {
	lo 1 + -> i
	loop {
		i hi > if { break }
		arr i nth -> key
		i 1 - -> j
		loop {
			j lo < if { break }
			arr j nth -> jval
			jval key >= if { break }
			arr j 1 + jval set
			j 1 - -> j
		}
		arr j 1 + key set
		i 1 + -> i
	}
}

// Quicksort for i64 descending
fn qsort_i64_desc(arr:[]i64 lo:i64 hi:i64 -- ) {
	hi lo - 1 + -> n
	n 16 <= if {
		arr lo hi isort_i64_desc
	} else {
		arr lo hi median3_i64 -> pivotIdx
		arr pivotIdx hi swap_i64
		arr hi nth -> pivot

		lo -> i
		hi 1 - -> j
		loop {
			loop {
				// Bounded by hi, not j: the pivot sits at hi and stops this scan. Bounding it by j
				// let the scan stop on an element that still sorts *before* the pivot, and the
				// final swap below then placed the pivot to the left of it -- leaving the array
				// unsorted for every reverse-sorted input of even length 18 or more.
				i hi >= if { break }
				arr i nth pivot <= if { break }
				i 1 + -> i
			}
			loop {
				j i <= if { break }
				arr j nth pivot >= if { break }
				j 1 - -> j
			}
			i j >= if { break }
			arr i j swap_i64
			i 1 + -> i
			j 1 - -> j
		}
		arr i hi swap_i64

		i 1 - lo >= if {
			arr lo i 1 - qsort_i64_desc
		}
		i 1 + hi <= if {
			arr i 1 + hi qsort_i64_desc
		}
	}
}

// --- Float quicksort helpers ---

fn swap_f64(arr:[]f64 a:i64 b:i64 -- ) {
	arr a nth -> va
	arr b nth -> vb
	arr a vb set
	arr b va set
}

fn isort_f64_asc(arr:[]f64 lo:i64 hi:i64 -- ) {
	lo 1 + -> i
	loop {
		i hi > if { break }
		arr i nth -> key
		i 1 - -> j
		loop {
			j lo < if { break }
			arr j nth -> jval
			jval key <= if { break }
			arr j 1 + jval set
			j 1 - -> j
		}
		arr j 1 + key set
		i 1 + -> i
	}
}

fn qsort_f64_asc(arr:[]f64 lo:i64 hi:i64 -- ) {
	hi lo - 1 + -> n
	n 16 <= if {
		arr lo hi isort_f64_asc
	} else {
		lo hi + 2 / -> mid
		// Median-of-three for f64
		arr lo nth -> a
		arr mid nth -> b
		arr hi nth -> c
		a b <= if {
			b c <= if { mid } else {
				a c <= if { hi } else { lo }
			}
		} else {
			a c <= if { lo } else {
				b c <= if { hi } else { mid }
			}
		} -> pivotIdx

		arr pivotIdx hi swap_f64
		arr hi nth -> pivot

		lo -> i
		hi 1 - -> j
		loop {
			loop {
				// Bounded by hi, not j: the pivot sits at hi and stops this scan. Bounding it by j
				// let the scan stop on an element that still sorts *before* the pivot, and the
				// final swap below then placed the pivot to the left of it -- leaving the array
				// unsorted for every reverse-sorted input of even length 18 or more.
				i hi >= if { break }
				arr i nth pivot >= if { break }
				i 1 + -> i
			}
			loop {
				j i <= if { break }
				arr j nth pivot <= if { break }
				j 1 - -> j
			}
			i j >= if { break }
			arr i j swap_f64
			i 1 + -> i
			j 1 - -> j
		}
		arr i hi swap_f64

		i 1 - lo >= if {
			arr lo i 1 - qsort_f64_asc
		}
		i 1 + hi <= if {
			arr i 1 + hi qsort_f64_asc
		}
	}
}

fn isort_f64_desc(arr:[]f64 lo:i64 hi:i64 -- ) {
	lo 1 + -> i
	loop {
		i hi > if { break }
		arr i nth -> key
		i 1 - -> j
		loop {
			j lo < if { break }
			arr j nth -> jval
			jval key >= if { break }
			arr j 1 + jval set
			j 1 - -> j
		}
		arr j 1 + key set
		i 1 + -> i
	}
}

fn qsort_f64_desc(arr:[]f64 lo:i64 hi:i64 -- ) {
	hi lo - 1 + -> n
	n 16 <= if {
		arr lo hi isort_f64_desc
	} else {
		lo hi + 2 / -> mid
		arr lo nth -> a
		arr mid nth -> b
		arr hi nth -> c
		a b <= if {
			b c <= if { mid } else {
				a c <= if { hi } else { lo }
			}
		} else {
			a c <= if { lo } else {
				b c <= if { hi } else { mid }
			}
		} -> pivotIdx

		arr pivotIdx hi swap_f64
		arr hi nth -> pivot

		lo -> i
		hi 1 - -> j
		loop {
			loop {
				// Bounded by hi, not j: the pivot sits at hi and stops this scan. Bounding it by j
				// let the scan stop on an element that still sorts *before* the pivot, and the
				// final swap below then placed the pivot to the left of it -- leaving the array
				// unsorted for every reverse-sorted input of even length 18 or more.
				i hi >= if { break }
				arr i nth pivot <= if { break }
				i 1 + -> i
			}
			loop {
				j i <= if { break }
				arr j nth pivot >= if { break }
				j 1 - -> j
			}
			i j >= if { break }
			arr i j swap_f64
			i 1 + -> i
			j 1 - -> j
		}
		arr i hi swap_f64

		i 1 - lo >= if {
			arr lo i 1 - qsort_f64_desc
		}
		i 1 + hi <= if {
			arr i 1 + hi qsort_f64_desc
		}
	}
}

// --- Public API ---

/// Sort an array of i64 in ascending order (quicksort).
/// @param arr []i64 Array of i64 values
/// @example arr sort::ints
pub fn ints(arr:[]i64 -- ) {
	arr len -> count
	count 2 < if {
	} else {
		arr 0 count 1 - qsort_i64_asc
	}
}

// --- Comparator-ordered sort -------------------------------------------------------------
//
// The six entry points above each fix both the element type and the direction, because a
// function could not take a comparator: a `fn(...)` parameter was compared to the argument's
// type as a string, so no caller could ever satisfy one. These three work for any order the
// caller can express, including by a key, by several fields, or descending.

// Insertion sort for small partitions, ordered by `cmp`
fn isort_cmp(arr:[]i64 lo:i64 hi:i64 cmp:fn(i64 i64 -- i64) -- ) {
	lo 1 + -> i
	loop {
		i hi > if { break }
		arr i nth -> key
		i 1 - -> j
		loop {
			j lo < if { break }
			arr j nth -> jval
			jval key cmp call 0 <= if { break }
			arr j 1 + jval set
			j 1 - -> j
		}
		arr j 1 + key set
		i 1 + -> i
	}
}

// Median-of-three pivot selection, ordered by `cmp`
fn median3_cmp(arr:[]i64 lo:i64 hi:i64 cmp:fn(i64 i64 -- i64) -- pivot:i64) {
	lo hi + 2 / -> mid
	arr lo nth -> a
	arr mid nth -> b
	arr hi nth -> c
	a b cmp call 0 <= if {
		b c cmp call 0 <= if { mid } else {
			a c cmp call 0 <= if { hi } else { lo }
		}
	} else {
		a c cmp call 0 <= if { lo } else {
			b c cmp call 0 <= if { hi } else { mid }
		}
	}
}

fn qsort_cmp(arr:[]i64 lo:i64 hi:i64 cmp:fn(i64 i64 -- i64) -- ) {
	hi lo - 1 + -> n
	n 16 <= if {
		arr lo hi cmp isort_cmp
	} else {
		arr lo hi cmp median3_cmp -> pivotIdx
		arr pivotIdx hi swap_i64
		arr hi nth -> pivot

		lo -> i
		hi 1 - -> j
		loop {
			loop {
				// Bounded by hi, not j: the pivot sits at hi and stops this scan. Bounding it by j
				// let the scan stop on an element that still sorts *before* the pivot, and the
				// final swap below then placed the pivot to the left of it -- leaving the array
				// unsorted for every reverse-sorted input of even length 18 or more.
				i hi >= if { break }
				arr i nth pivot cmp call 0 >= if { break }
				i 1 + -> i
			}
			loop {
				j i <= if { break }
				arr j nth pivot cmp call 0 <= if { break }
				j 1 - -> j
			}
			i j >= if { break }
			arr i j swap_i64
			i 1 + -> i
			j 1 - -> j
		}
		arr i hi swap_i64

		i 1 - lo >= if {
			arr lo i 1 - cmp qsort_cmp
		}
		i 1 + hi <= if {
			arr i 1 + hi cmp qsort_cmp
		}
	}
}

/// Sort an array of i64 by a comparator (quicksort).
/// The comparator returns a negative value if `a` sorts before `b`, zero if they tie, and a
/// positive value if `a` sorts after `b` -- the same convention as C's `qsort`. Sorting by a
/// key, by several fields, or in descending order are all just comparators. Not stable.
/// @param arr []i64 Array of i64 values
/// @param cmp fn Comparator (a b -- ordering)
/// @example arr &by_length sort::by
pub fn by(arr:[]i64 cmp:fn(i64 i64 -- i64) -- ) {
	arr len -> count
	count 2 < if {
	} else {
		arr 0 count 1 - cmp qsort_cmp
	}
}

/// Whether an array of i64 is sorted according to a comparator.
/// @param arr []i64 Array of i64 values
/// @param cmp fn Comparator (a b -- ordering)
/// @return sorted i64 1 if sorted, 0 otherwise
/// @example arr &by_length sort::is_sorted_by print nl
pub fn is_sorted_by(arr:[]i64 cmp:fn(i64 i64 -- i64) -- sorted:i64) {
	arr len -> count
	1 -> result
	1 -> i
	loop {
		i count >= if { break }
		arr i 1 - nth -> prev
		arr i nth -> cur
		prev cur cmp call 0 > if {
			0 -> result
			break
		}
		i 1 + -> i
	}
	result
}

/// Find the index of the first element not ordered before `needle` (binary search lower bound).
/// The array must already be sorted by the same comparator. Returns `count` when every element
/// sorts before `needle`.
/// @param arr []i64 Array of i64 values, sorted by `cmp`
/// @param needle i64 Value to locate
/// @param cmp fn Comparator (a b -- ordering)
/// @return idx i64 Index of the first element not ordered before `needle`
/// @example arr 42 &ascending sort::lower_bound_by print nl
pub fn lower_bound_by(arr:[]i64 needle:i64 cmp:fn(i64 i64 -- i64) -- idx:i64) {
	arr len -> count
	0 -> lo
	count -> hi
	loop {
		lo hi >= if { break }
		lo hi + 2 / -> mid
		arr mid nth needle cmp call 0 < if {
			mid 1 + -> lo
		} else {
			mid -> hi
		}
	}
	lo
}

/// Sort an array of i64 in descending order (quicksort).
/// @param arr []i64 Array of i64 values
/// @example arr sort::ints_desc
pub fn ints_desc(arr:[]i64 -- ) {
	arr len -> count
	count 2 < if {
	} else {
		arr 0 count 1 - qsort_i64_desc
	}
}

/// Sort an array of f64 in ascending order (quicksort).
/// @param arr []f64 Array of f64 values
/// @example farr sort::floats
pub fn floats(arr:[]f64 -- ) {
	arr len -> count
	count 2 < if {
	} else {
		arr 0 count 1 - qsort_f64_asc
	}
}

/// Sort an array of f64 in descending order (quicksort).
/// @param arr []f64 Array of f64 values
/// @example farr sort::floats_desc
pub fn floats_desc(arr:[]f64 -- ) {
	arr len -> count
	count 2 < if {
	} else {
		arr 0 count 1 - qsort_f64_desc
	}
}

/// Find minimum value in array.
/// @param arr []i64 Array of i64 values (must not be empty)
/// @return minval i64 Minimum value
/// @example arr sort::min -> val
pub fn min(arr:[]i64 -- minval:i64) {
	arr len -> count
	arr 0 nth -> result
	1 count 1 for it {
		it -> i
		arr i nth -> val
		val result < if {
			val -> result
		}
	}
	result
}

/// Find maximum value in array.
/// @param arr []i64 Array of i64 values (must not be empty)
/// @return maxval i64 Maximum value
/// @example arr sort::max -> val
pub fn max(arr:[]i64 -- maxval:i64) {
	arr len -> count
	arr 0 nth -> result
	1 count 1 for it {
		it -> i
		arr i nth -> val
		val result > if {
			val -> result
		}
	}
	result
}

/// Check if array of i64 is sorted in ascending order.
/// @param arr []i64 Array of i64 values
/// @return sorted i64 1 if sorted, 0 otherwise
/// @example arr sort::is_sorted -> result
pub fn is_sorted(arr:[]i64 -- sorted:i64) {
	arr len -> count
	1 -> result
	count 2 < if {
		result
	} else {
		1 count 1 for it {
			it -> i
			arr i 1 - nth -> prev
			arr i nth -> curr
			prev curr > if {
				0 -> result
				break
			}
		}
		result
	}
}

/// Check if array of f64 is sorted in ascending order.
/// @param arr []f64 Array of f64 values
/// @return sorted i64 1 if sorted, 0 otherwise
/// @example farr sort::is_sorted_floats -> result
pub fn is_sorted_floats(arr:[]f64 -- sorted:i64) {
	arr len -> count
	1 -> result
	count 2 < if {
		result
	} else {
		1 count 1 for it {
			it -> i
			arr i 1 - nth -> prev
			arr i nth -> curr
			prev curr > if {
				0 -> result
				break
			}
		}
		result
	}
}

/// Reverse an array in place.
/// @param arr []i64 Array of i64 values
/// @example arr sort::reverse
pub fn reverse(arr:[]i64 -- ) {
	arr len -> count
	0 -> left
	count 1 - -> right
	loop {
		left right >= if {
			break
		}
		arr left nth -> lval
		arr right nth -> rval
		arr left rval set
		arr right lval set
		left 1 + -> left
		right 1 - -> right
	}
}

/// Binary search for value in sorted array.
/// @param arr []i64 Sorted array of i64 values
/// @param needle i64 Value to find
/// @return idx i64 Index if found, -1 otherwise
/// @example arr 42 sort::search -> idx
pub fn search(arr:[]i64 needle:i64 -- idx:i64) {
	arr len -> count
	0 -> left
	count -> right
	-1 -> result
	loop {
		left right >= if {
			break
		}
		left right + 2 / -> mid
		arr mid nth -> midval
		midval needle == if {
			mid -> result
			break
		}
		midval needle < if {
			mid 1 + -> left
		} else {
			mid -> right
		}
	}
	result
}

/// Remove adjacent duplicate i64 values in-place (array must be sorted).
/// @param arr []i64 Sorted array of i64 values
/// @return new_count i64 Number of unique elements
/// @example arr sort::unique -> new_count
pub fn unique(arr:[]i64 -- new_count:i64) {
	arr len -> count
	count 2 < if {
		count
	} else {
		1 -> write_idx
		1 count 1 for it {
			it -> i
			arr i nth -> curr
			arr write_idx 1 - nth -> prev
			curr prev != if {
				arr write_idx curr set
				write_idx 1 + -> write_idx
			}
		}
		write_idx
	}
}

/// Sort an array of strings in ascending alphabetical order (insertion sort).
/// @param arr []str Array of strings
/// @example strs sort::strings
pub fn strings(arr:[]str -- ) {
	arr len -> count
	1 count 1 for it {
		it -> i
		arr i nth -> key
		i 1 - -> j
		loop {
			j 0 < if {
				break
			}
			arr j nth -> jval
			jval key strings::compare 0 <= if {
				break
			}
			arr j 1 + jval set
			j 1 - -> j
		}
		arr j 1 + key set
	}
}

/// Sort an array of strings in descending alphabetical order.
/// @param arr []str Array of strings
/// @example strs sort::strings_desc
pub fn strings_desc(arr:[]str -- ) {
	arr len -> count
	1 count 1 for it {
		it -> i
		arr i nth -> key
		i 1 - -> j
		loop {
			j 0 < if {
				break
			}
			arr j nth -> jval
			jval key strings::compare 0 >= if {
				break
			}
			arr j 1 + jval set
			j 1 - -> j
		}
		arr j 1 + key set
	}
}
