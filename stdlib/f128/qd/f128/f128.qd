/// IEEE 754 decimal128 arithmetic beyond the operators.
///
/// `f128` is decimal floating point with 34 significant digits, so a value prints as exactly
/// what it holds: `0.1q 0.2q +` is `0.3`. The operators `+ - * /`, `neg` and the comparisons
/// work on f128 directly; this module has the rest of what IEEE 754-2008 asks of a decimal
/// format, and the elementary functions.
///
/// Every result is rounded to 34 digits with roundTiesToEven. `sqrt`, `exp`, `ln` and `log10`
/// are correctly rounded, as is `fma`, which rounds once for the product and the sum. The
/// trigonometric functions carry ten guard digits and reduce their argument against 6400
/// digits of pi, so `sin` of 1e6144 is as accurate as `sin` of 1.
///
/// Decimal values keep the exponent they were written or computed with, so `1.10q` and `1.1q`
/// are equal but print differently; `reduce` strips trailing zeros and `quantize` sets them.
/// doccheck: page-context
import "libf128.a" as "f128" {
	/// Square root, correctly rounded.
	/// @param x f128 Non-negative value
	/// @return result f128 Square root of x; NaN for a negative x
	/// @example 2q f128::sqrt print  // 1.414213562373095048801688724209698
	pub fn sqrt(x:f128 -- result:f128)

	/// e raised to x, correctly rounded.
	/// @param x f128 Exponent
	/// @return result f128 e^x
	/// @example 1q f128::exp print  // 2.718281828459045235360287471352662
	pub fn exp(x:f128 -- result:f128)

	/// Natural logarithm, correctly rounded.
	/// @param x f128 Positive value
	/// @return result f128 ln(x); -inf for 0, NaN for a negative x
	/// @example 10q f128::ln print  // 2.302585092994045684017991454684364
	pub fn ln(x:f128 -- result:f128)

	/// Base-10 logarithm, correctly rounded.
	/// @param x f128 Positive value
	/// @return result f128 log10(x)
	/// @example 1000q f128::log10 print  // 3
	pub fn log10(x:f128 -- result:f128)

	/// base raised to exponent.
	/// @param base f128 Base
	/// @param exponent f128 Exponent
	/// @return result f128 base^exponent
	/// @example 2q 10q f128::pow print  // 1024
	pub fn pow(base:f128 exponent:f128 -- result:f128)

	/// Sine of an angle in radians.
	/// @param x f128 Angle in radians
	/// @return result f128 sin(x)
	/// @example 0q f128::sin print  // 0
	pub fn sin(x:f128 -- result:f128)

	/// Cosine of an angle in radians.
	/// @param x f128 Angle in radians
	/// @return result f128 cos(x)
	/// @example 0q f128::cos print  // 1
	pub fn cos(x:f128 -- result:f128)

	/// Tangent of an angle in radians.
	/// @param x f128 Angle in radians
	/// @return result f128 tan(x)
	/// @example 0q f128::tan print  // 0
	pub fn tan(x:f128 -- result:f128)

	/// Arc sine, in radians.
	/// @param x f128 Value in [-1, 1]
	/// @return result f128 asin(x) in [-pi/2, pi/2]; NaN outside [-1, 1]
	/// @example 1q f128::asin print  // 1.570796326794896619231321691639751
	pub fn asin(x:f128 -- result:f128)

	/// Arc cosine, in radians.
	/// @param x f128 Value in [-1, 1]
	/// @return result f128 acos(x) in [0, pi]; NaN outside [-1, 1]
	/// @example 1q f128::acos print  // 0
	pub fn acos(x:f128 -- result:f128)

	/// Arc tangent, in radians.
	/// @param x f128 Any value
	/// @return result f128 atan(x) in [-pi/2, pi/2]
	/// @example 1q f128::atan print  // 0.7853981633974483096156608458198757
	pub fn atan(x:f128 -- result:f128)

	/// Angle of the point (x, y) from the positive x axis, in radians.
	/// @param y f128 Y coordinate
	/// @param x f128 X coordinate
	/// @return result f128 Angle in [-pi, pi]
	/// @example 1q -1q f128::atan2 print  // 2.356194490192344928846982537459627
	pub fn atan2(y:f128 x:f128 -- result:f128)

	/// Fused multiply-add: a*b + c with a single rounding.
	/// @param a f128 First factor
	/// @param b f128 Second factor
	/// @param c f128 Addend
	/// @return result f128 a*b + c, rounded once
	/// @example 2q 3q 1q f128::fma print  // 7
	pub fn fma(a:f128 b:f128 c:f128 -- result:f128)

	/// Absolute value. Clears the sign bit, so -0 becomes 0 and NaN stays NaN.
	/// @param x f128 Value
	/// @return result f128 |x|
	/// @example -2.5q f128::abs print  // 2.5
	pub fn abs(x:f128 -- result:f128)

	/// x with the sign of sign.
	/// @param x f128 Magnitude
	/// @param sign f128 Value whose sign is taken
	/// @return result f128 |x| with sign's sign
	/// @example 3q -1q f128::copysign print  // -3
	pub fn copysign(x:f128 sign:f128 -- result:f128)

	/// IEEE remainder: x - n*y where n is x/y rounded to the nearest integer, ties to even.
	/// The result lies in [-|y|/2, |y|/2].
	/// @param x f128 Dividend
	/// @param y f128 Divisor
	/// @return result f128 Remainder
	/// @example 10q 3q f128::remainder print  // 1
	pub fn remainder(x:f128 y:f128 -- result:f128)

	/// Truncated remainder: x - n*y where n is x/y truncated toward zero. It takes x's sign.
	/// @param x f128 Dividend
	/// @param y f128 Divisor
	/// @return result f128 Remainder
	/// @example -7q 2q f128::fmod print  // -1
	pub fn fmod(x:f128 y:f128 -- result:f128)

	/// IEEE minNum: the smaller of a and b, where a quiet NaN loses to a number.
	/// @param a f128 First value
	/// @param b f128 Second value
	/// @return result f128 Minimum
	/// @example 3q 7q f128::min print  // 3
	pub fn min(a:f128 b:f128 -- result:f128)

	/// IEEE maxNum: the larger of a and b, where a quiet NaN loses to a number.
	/// @param a f128 First value
	/// @param b f128 Second value
	/// @return result f128 Maximum
	/// @example 3q 7q f128::max print  // 7
	pub fn max(a:f128 b:f128 -- result:f128)

	/// x times ten to the n.
	/// @param x f128 Value
	/// @param n i64 Power of ten
	/// @return result f128 x * 10^n
	/// @example 1.5q 3 f128::scaleb print  // 1.5e+3
	pub fn scaleb(x:f128 n:i64 -- result:f128)

	/// Exponent of x's leading digit: floor(log10(|x|)) for a finite non-zero x.
	/// @param x f128 Value
	/// @return result f128 The exponent; -inf for 0
	/// @example 1234q f128::logb print  // 3
	pub fn logb(x:f128 -- result:f128)

	/// The next f128 above x.
	/// @param x f128 Value
	/// @return result f128 Least value greater than x
	/// @example 1q f128::next_up print  // 1.000000000000000000000000000000001
	pub fn next_up(x:f128 -- result:f128)

	/// The next f128 below x.
	/// @param x f128 Value
	/// @return result f128 Greatest value less than x
	/// @example 1q f128::next_down print  // 0.9999999999999999999999999999999999
	pub fn next_down(x:f128 -- result:f128)

	/// x rounded to the exponent of like: to the same number of decimal places.
	/// @param x f128 Value
	/// @param like f128 Value whose exponent is taken
	/// @return result f128 x with like's exponent; NaN if it will not fit 34 digits
	/// @example 2.34567q 0.01q f128::quantize print  // 2.35
	pub fn quantize(x:f128 like:f128 -- result:f128)

	/// x without trailing zeros: the same value at the largest exponent that holds it.
	/// @param x f128 Value
	/// @return result f128 x reduced
	/// @example 1.500q f128::reduce print  // 1.5
	pub fn reduce(x:f128 -- result:f128)

	/// Round to an integral value, ties to even.
	/// @param x f128 Value
	/// @return result f128 Nearest integer; 2.5 goes to 2
	/// @example 2.5q f128::round_even print  // 2
	pub fn round_even(x:f128 -- result:f128)

	/// Round to an integral value, ties away from zero.
	/// @param x f128 Value
	/// @return result f128 Nearest integer; 2.5 goes to 3
	/// @example 2.5q f128::round print  // 3
	pub fn round(x:f128 -- result:f128)

	/// Round toward zero to an integral value.
	/// @param x f128 Value
	/// @return result f128 Integer part of x
	/// @example -2.7q f128::trunc print  // -2
	pub fn trunc(x:f128 -- result:f128)

	/// Round toward negative infinity to an integral value.
	/// @param x f128 Value
	/// @return result f128 Largest integer not above x
	/// @example -2.1q f128::floor print  // -3
	pub fn floor(x:f128 -- result:f128)

	/// Round toward positive infinity to an integral value.
	/// @param x f128 Value
	/// @return result f128 Smallest integer not below x
	/// @example 2.1q f128::ceil print  // 3
	pub fn ceil(x:f128 -- result:f128)

	/// Whether x is NaN. NaN is unequal to everything, itself included, so `x x ==` cannot ask.
	/// @param x f128 Value
	/// @return result i64 1 if NaN, 0 otherwise
	/// @example 0q 0q / f128::is_nan print  // 1
	pub fn is_nan(x:f128 -- result:i64)

	/// Whether x is an infinity of either sign.
	/// @param x f128 Value
	/// @return result i64 1 if infinite, 0 otherwise
	/// @example 1q 0q / f128::is_inf print  // 1
	pub fn is_inf(x:f128 -- result:i64)

	/// Whether x is neither infinite nor NaN.
	/// @param x f128 Value
	/// @return result i64 1 if finite, 0 otherwise
	/// @example 1q f128::is_finite print  // 1
	pub fn is_finite(x:f128 -- result:i64)

	/// Whether x is zero of either sign.
	/// @param x f128 Value
	/// @return result i64 1 if zero, 0 otherwise
	/// @example -0q f128::is_zero print  // 1
	pub fn is_zero(x:f128 -- result:i64)

	/// Whether x is normal: finite, non-zero, and not subnormal.
	/// @param x f128 Value
	/// @return result i64 1 if normal, 0 otherwise
	/// @example 1q f128::is_normal print  // 1
	pub fn is_normal(x:f128 -- result:i64)

	/// Whether x is subnormal: non-zero and below 1e-6143 in magnitude.
	/// @param x f128 Value
	/// @return result i64 1 if subnormal, 0 otherwise
	/// @example 1e-6150q f128::is_subnormal print  // 1
	pub fn is_subnormal(x:f128 -- result:i64)

	/// Whether x's sign bit is set. True of -0 and of a negative NaN, which `0q <` is not.
	/// @param x f128 Value
	/// @return result i64 1 if the sign bit is set, 0 otherwise
	/// @example -0q f128::is_signed print  // 1
	pub fn is_signed(x:f128 -- result:i64)

	/// IEEE totalOrder: a total order over every f128, NaNs and signed zeros included.
	/// -0 orders before 0, and equal values written with different exponents order by
	/// exponent: 1.00q before 1.0q.
	/// @param a f128 First value
	/// @param b f128 Second value
	/// @return result i64 -1, 0 or 1
	/// @example -0q 0q f128::total_order print  // -1
	pub fn total_order(a:f128 b:f128 -- result:i64)

	/// Pi, correctly rounded to 34 digits.
	/// @return result f128 Pi
	/// @example f128::pi print  // 3.141592653589793238462643383279503
	pub fn pi( -- result:f128)

	/// Euler's number e, correctly rounded to 34 digits.
	/// @return result f128 e
	/// @example f128::e print  // 2.718281828459045235360287471352662
	pub fn e( -- result:f128)

	/// Positive infinity, which has no literal spelling.
	/// @return result f128 inf
	/// @example f128::inf print  // inf
	pub fn inf( -- result:f128)

	/// A quiet NaN, which has no literal spelling.
	/// @return result f128 nan
	/// @example f128::nan f128::is_nan print  // 1
	pub fn nan( -- result:f128)
}
