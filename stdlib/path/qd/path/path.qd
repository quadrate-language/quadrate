/// File path manipulation functions.
/// POSIX-style paths with forward slash separator.
use strings

/// Path separator constant.
pub const Sep = "/"

/// Find last occurrence of slash in string.
fn find_last_slash(s:str -- idx:i64) {
	s strings::len -> slen
	-1 -> result
	0 slen 1 for it {
		it -> i
		s i strings::char_at! 47 == if {
			i -> result
		}
	}
	result
}

/// Find last occurrence of dot in string.
fn find_last_dot(s:str -- idx:i64) {
	s strings::len -> slen
	-1 -> result
	0 slen 1 for it {
		it -> i
		s i strings::char_at! 46 == if {
			i -> result
		}
	}
	result
}

/// Get the directory part of a path.
/// @param path str File path
/// @return dir str Directory component
/// @example "/home/user/file.txt" path::dirname -> "/home/user"
pub fn dirname(path:str -- dir:str) {
	path find_last_slash -> last_slash
	"." -> result
	last_slash 0 == if {
		"/" -> result
	}
	last_slash 0 > if {
		path 0 last_slash strings::substring! -> result
	}
	result
}

/// Get the filename part of a path.
/// @param path str File path
/// @return name str Filename component
/// @example "/home/user/file.txt" path::basename -> "file.txt"
pub fn basename(path:str -- name:str) {
	path find_last_slash -> last_slash
	path -> result
	last_slash -1 != if {
		path strings::len -> pathlen
		last_slash 1 + -> start
		start pathlen < if {
			path start pathlen start - strings::substring! -> result
		} else {
			"" -> result
		}
	}
	result
}

/// Get the file extension (including dot).
/// @param path str File path
/// @return ext str Extension including dot, empty if none
/// @example "file.txt" path::ext -> ".txt"
pub fn ext(path:str -- ext:str) {
	// Inline basename logic to avoid type inference issues
	path find_last_slash -> last_slash
	path -> name
	last_slash -1 != if {
		path strings::len -> plen
		last_slash 1 + -> pstart
		pstart plen < if {
			path pstart plen pstart - strings::substring! -> name
		} else {
			"" -> name
		}
	}
	// Now find extension in name
	name find_last_dot -> last_dot
	"" -> result
	last_dot 0 > if {
		name strings::len -> nlen
		name last_dot nlen last_dot - strings::substring! -> result
	}
	result
}

/// Get filename without extension.
/// @param path str File path
/// @return stem str Filename without extension
/// @example "file.txt" path::stem -> "file"
pub fn stem(path:str -- stem:str) {
	// Inline basename logic to avoid type inference issues
	path find_last_slash -> last_slash
	path -> name
	last_slash -1 != if {
		path strings::len -> plen
		last_slash 1 + -> pstart
		pstart plen < if {
			path pstart plen pstart - strings::substring! -> name
		} else {
			"" -> name
		}
	}
	// Now find stem in name
	name find_last_dot -> last_dot
	name -> result
	last_dot 0 > if {
		name 0 last_dot strings::substring! -> result
	}
	result
}

/// Join two path components.
/// @param p1 str First path
/// @param p2 str Second path
/// @return joined str Joined path
/// @example "/home" "user" path::join -> "/home/user"
pub fn join(p1:str p2:str -- joined:str) {
	p1 -> result
	p2 "/" strings::starts_with if {
		p2 -> result
	} else {
		p1 strings::len -> len1
		len1 0 == if {
			p2 -> result
		} else {
			p1 len1 1 - strings::char_at! 47 == if {
				p1 p2 strings::concat -> result
			} else {
				p1 "/" strings::concat p2 strings::concat -> result
			}
		}
	}
	result
}

/// Check if path is absolute.
/// @param path str File path
/// @return result i64 1 if absolute, 0 otherwise
/// @example "/home/user" path::is_absolute -> 1
pub fn is_absolute(path:str -- result:i64) {
	path "/" strings::starts_with
}

/// Normalize a path (remove redundant separators).
/// @param path str File path
/// @return norm str Normalized path
/// @example "/home//user/" path::normalize -> "/home/user"
pub fn normalize(path:str -- norm:str) {
	// Loop to handle triple+ slashes (/// -> // -> /)
	path -> result
	loop {
		result "//" strings::contains 0 == if { break }
		result "//" "/" strings::replace! -> result
	}
	result strings::len -> rlen
	rlen 1 > if {
		result rlen 1 - strings::char_at! 47 == if {
			result 0 rlen 1 - strings::substring! -> result
		}
	}
	result
}

/// Change or add file extension.
/// @param path str File path
/// @param newext str New extension (with or without leading dot)
/// @return result str Path with new extension
/// @example "file.txt" ".md" path::with_ext -> "file.md"
pub fn with_ext(path:str newext:str -- result:str) {
	// Get the stem (filename without extension)
	path stem -> base
	// Get directory
	path dirname -> dir
	// Ensure extension starts with dot
	newext strings::len 0 > if {
		newext 0 strings::char_at! 46 != if {
			"." newext strings::concat -> newext
		}
	}
	// Build result
	dir "." strings::compare 0 == if {
		base newext strings::concat
	} else {
		dir "/" strings::concat base strings::concat newext strings::concat
	}
}

/// Check if path has an extension.
/// @param path str File path
/// @return result i64 1 if has extension, 0 otherwise
/// @example "file.txt" path::has_ext -> 1
pub fn has_ext(path:str -- result:i64) {
	path ext strings::len 0 >
}

/// Get parent directory (same as dirname but clearer name).
/// @param path str File path
/// @return parent str Parent directory
/// @example "/home/user/file.txt" path::parent -> "/home/user"
pub fn parent(path:str -- parent:str) {
	path dirname
}

/// Check if path is relative (not absolute).
/// @param path str File path
/// @return result i64 1 if relative, 0 otherwise
/// @example "home/user" path::is_relative -> 1
pub fn is_relative(path:str -- result:i64) {
	path is_absolute 0 ==
}

/// Check if a path matches a simple extension filter.
/// @param path str File path
/// @param extension str Extension to match (with or without dot)
/// @return result i64 1 if matches, 0 otherwise
/// @example "file.txt" "txt" path::has_extension -> 1
pub fn has_extension(path:str extension:str -- result:i64) {
	// Normalize extension to include dot
	extension strings::len 0 > if {
		extension 0 strings::char_at! 46 != if {
			"." extension strings::concat -> extension
		}
	}
	path ext extension strings::compare 0 ==
}

/// Get the depth of a path (number of components).
/// @param path str File path
/// @return depth i64 Number of path components
/// @example "/home/user/file.txt" path::depth -> 3
pub fn depth(path:str -- depth:i64) {
	path strings::len -> plen
	plen 0 == if {
		0
	} else {
		0 -> count
		0 -> i
		0 -> in_component
		loop {
			i plen >= if { break }
			path i strings::char_at! -> ch
			ch 47 == if {
				in_component 1 == if {
					0 -> in_component
				}
			} else {
				in_component 0 == if {
					count 1 + -> count
					1 -> in_component
				}
			}
			i 1 + -> i
		}
		count
	}
}

/// Check if path starts with a given prefix path.
/// @param path str File path to check
/// @param prefix str Prefix path
/// @return result i64 1 if starts with prefix, 0 otherwise
/// @example "/home/user/file.txt" "/home" path::starts_with -> 1
pub fn starts_with(path:str prefix:str -- result:i64) {
	path prefix strings::starts_with -> result
	// Also check it's at a path boundary
	result if {
		prefix strings::len -> plen
		path strings::len -> pathlen
		plen pathlen == if {
			1 -> result
		} else {
			pathlen plen > if {
				path plen strings::char_at! 47 == -> result
			}
		}
	}
	result
}

/// Remove a prefix from a path if it exists.
/// @param path str File path
/// @param prefix str Prefix to remove
/// @return result str Path without prefix
/// @example "/home/user/file.txt" "/home" path::strip_prefix -> "user/file.txt"
pub fn strip_prefix(path:str prefix:str -- result:str) {
	path prefix starts_with if {
		prefix strings::len -> plen
		path strings::len -> pathlen
		plen pathlen < if {
			// Skip the prefix and any leading slash
			path plen strings::char_at! 47 == if {
				plen 1 + -> plen
			}
			path plen pathlen plen - strings::substring!
		} else {
			""
		}
	} else {
		path
	}
}
