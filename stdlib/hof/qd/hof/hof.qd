/// Higher-Order Function combinators.
///
/// The combinators every program uses -- `dip`, `keep`, `bi`, `tri`, `bi_star`, `tri_star`,
/// `both`, `times`, `each`, `map`, `filter`, `fold`, `find`, `any` and `all` -- are builtins, and
/// need no `use`. This module has the rest: `when` and `unless`, which run a function value on a
/// condition, and `fold_right`.
///
/// Every one is generic, and `when` and `unless` take their function value with a stack
/// variable, `..a`, so it may have any arity.
/// doccheck: page-context
/// doccheck: page-setup [1 2 3] -> arr

/// Run a function value only if the condition is true. It must leave the stack the shape it
/// found it, since when the condition is false nothing runs.
/// @param cond i64 Condition (0 = false, non-zero = true)
/// @param q fn Function value, run when the condition is true
/// @example 5 1 fn { 2 * } hof::when print nl  // 10
/// @example 5 0 fn { 2 * } hof::when print nl  // 5
pub fn when<..a>(..a cond:i64 q:fn(..a -- ..a) -- ..a) {
	swap 0 != if { call } else { drop }
}

/// Run a function value only if the condition is false, as `when` runs it when it is true.
/// @param cond i64 Condition (0 = false, non-zero = true)
/// @param q fn Function value, run when the condition is false
/// @example 5 0 fn { 2 * } hof::unless print nl  // 10
/// @example 5 1 fn { 2 * } hof::unless print nl  // 5
pub fn unless<..a>(..a cond:i64 q:fn(..a -- ..a) -- ..a) {
	swap 0 == if { call } else { drop }
}

/// Fold an array right to left: `f` runs on each element and the accumulator, last element
/// first, as `fold` runs on the accumulator and each element first to last.
/// @param arr []T Array
/// @param acc A Initial accumulator
/// @param f fn(T A -- A) Function value (elem acc -- acc)
/// @return result A Final accumulator
/// @example arr 0 fn { + } hof::fold_right  // sum of array
pub def fold_right<T, A>(arr:[]T acc:A f:fn(T A -- A) -- result:A) {
	arr len 1 - -1 -1 for i {
		arr i nth acc f call -> acc
	}
	acc
}
