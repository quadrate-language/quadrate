use http

fn handle_index(c:ptr -- ) {
	-> c
	c "./index.html" http::static_file
}

fn handle_image(c:ptr -- ) {
	-> c
	c "./DISKETTE.png" http::static_file
}

fn main() {
	"Quadrate Store" print nl
	"http://localhost:8081/" print nl

	http::engine -> e
	defer {
		e http::free_engine
	}

	e "/" &handle_index http::GET
	e "/DISKETTE.png" &handle_image http::GET

	e ":8081" http::run!
}
