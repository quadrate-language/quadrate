      "description": "Error: Failed to create thread."
    },
    {
      "name": "ErrDetach",
      "value": "4",
      "description": "Error: Failed to detach thread."
    },
    {
      "name": "ErrJoin",
      "value": "3",
      "description": "Error: Failed to join thread."
    },
    {
      "name": "ErrMutex",
      "value": "5",
      "description": "Error: Mutex operation failed."
    },
    {
      "name": "ErrTimeout",
      "value": "8",
      "description": "Error: Operation timed out."
    }
  ],
