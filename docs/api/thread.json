      "name": "ErrChannel",
      "value": "6",
      "description": "Error: Channel operation failed."
    },
    {
      "name": "ErrClosed",
      "value": "7",
      "description": "Error: Channel is closed."
    },
    {
      "name": "ErrCreate",
