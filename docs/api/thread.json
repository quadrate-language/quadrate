{
  "name": "thread",
  "description": "Threading primitives using C11 threads. Provides Thread, Mutex, Channel, and WaitGroup for concurrent programming.",
  "constants": [
    {"name": "ErrCreate", "value": "2", "description": "Failed to create thread."},
    {"name": "ErrJoin", "value": "3", "description": "Failed to join thread."},
    {"name": "ErrDetach", "value": "4", "description": "Failed to detach thread."},
    {"name": "ErrMutex", "value": "5", "description": "Mutex operation failed."},
    {"name": "ErrChannel", "value": "6", "description": "Channel operation failed."},
    {"name": "ErrClosed", "value": "7", "description": "Channel is closed."},
    {"name": "ErrTimeout", "value": "8", "description": "Operation timed out."}
  ],
  "structs": [
    {"name": "Thread", "description": "A thread handle."},
    {"name": "Mutex", "description": "A mutual exclusion lock."},
    {"name": "Channel", "description": "A channel for thread communication."},
    {"name": "WaitGroup", "description": "A WaitGroup waits for a collection of threads to finish."}
  ],
  "functions": [
    {
      "name": "sleep",
      "signature": "(ms:i64 -- )",
      "failable": false,
      "description": "Sleep the current thread for the specified duration in milliseconds.",
      "params": [{"name": "ms", "type": "i64", "description": "Sleep duration in milliseconds"}],
      "returns": [],
      "errors": [],
      "examples": ["1000 thread::sleep  // Sleep 1 second"]
    },
    {
      "name": "spawn",
      "signature": "(func:ptr -- t:Thread)!",
      "failable": true,
      "description": "Spawn a new thread running the given function.",
      "params": [{"name": "func", "type": "ptr", "description": "Function pointer (use &function_name)"}],
      "returns": [{"name": "t", "type": "Thread", "description": "Thread handle"}],
      "errors": ["ErrCreate"],
      "examples": ["&worker thread::spawn! -> t"]
    },
    {
      "name": "Thread.join",
      "signature": "(t:Thread -- )!",
      "failable": true,
      "description": "Wait for the thread to complete.",
      "params": [{"name": "t", "type": "Thread", "description": "Thread handle"}],
      "returns": [],
      "errors": ["ErrJoin"],
      "examples": ["t join!"]
    },
    {
      "name": "Thread.detach",
      "signature": "(t:Thread -- )!",
      "failable": true,
      "description": "Detach the thread.",
      "params": [{"name": "t", "type": "Thread", "description": "Thread handle"}],
      "returns": [],
      "errors": ["ErrDetach"],
      "examples": ["t detach!"]
    },
    {
      "name": "Thread.is_alive",
      "signature": "(t:Thread -- alive:i64)",
      "failable": false,
      "description": "Check if the thread is still alive.",
      "params": [{"name": "t", "type": "Thread", "description": "Thread handle"}],
      "returns": [{"name": "alive", "type": "i64", "description": "1 if running, 0 if completed"}],
      "errors": [],
      "examples": ["t is_alive -> running"]
    },
    {
      "name": "mutex_new",
      "signature": "( -- m:Mutex)!",
      "failable": true,
      "description": "Create a new mutex.",
      "params": [],
      "returns": [{"name": "m", "type": "Mutex", "description": "New mutex handle"}],
      "errors": ["ErrMutex"],
      "examples": ["thread::mutex_new! -> m"]
    },
    {
      "name": "Mutex.lock",
      "signature": "(m:Mutex -- )!",
      "failable": true,
      "description": "Lock the mutex (blocking).",
      "params": [{"name": "m", "type": "Mutex", "description": "Mutex handle"}],
      "returns": [],
      "errors": ["ErrMutex"],
      "examples": ["m lock!"]
    },
    {
      "name": "Mutex.unlock",
      "signature": "(m:Mutex -- )!",
      "failable": true,
      "description": "Unlock the mutex.",
      "params": [{"name": "m", "type": "Mutex", "description": "Mutex handle"}],
      "returns": [],
      "errors": ["ErrMutex"],
      "examples": ["m unlock!"]
    },
    {
      "name": "Mutex.try_lock",
      "signature": "(m:Mutex -- success:i64)",
      "failable": false,
      "description": "Try to lock the mutex without blocking.",
      "params": [{"name": "m", "type": "Mutex", "description": "Mutex handle"}],
      "returns": [{"name": "success", "type": "i64", "description": "1 if locked, 0 if already held"}],
      "errors": [],
      "examples": ["m try_lock -> got"]
    },
    {
      "name": "Mutex.free",
      "signature": "(m:Mutex -- )",
      "failable": false,
      "description": "Free the mutex.",
      "params": [{"name": "m", "type": "Mutex", "description": "Mutex handle"}],
      "returns": [],
      "errors": [],
      "examples": ["m free"]
    },
    {
      "name": "chan_new",
      "signature": "( -- ch:Channel)!",
      "failable": true,
      "description": "Create a new unbuffered (synchronous) channel.",
      "params": [],
      "returns": [{"name": "ch", "type": "Channel", "description": "New channel handle"}],
      "errors": ["ErrChannel"],
      "examples": ["thread::chan_new! -> ch"]
    },
    {
      "name": "chan_buffered",
      "signature": "(capacity:i64 -- ch:Channel)!",
      "failable": true,
      "description": "Create a new buffered channel.",
      "params": [{"name": "capacity", "type": "i64", "description": "Buffer size"}],
      "returns": [{"name": "ch", "type": "Channel", "description": "New channel handle"}],
      "errors": ["ErrChannel"],
      "examples": ["10 thread::chan_buffered! -> ch"]
    },
    {
      "name": "Channel.send",
      "signature": "(ch:Channel val:i64 -- )!",
      "failable": true,
      "description": "Send a value on the channel (blocking).",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}, {"name": "val", "type": "i64", "description": "Value to send"}],
      "returns": [],
      "errors": ["ErrClosed"],
      "examples": ["ch 42 send!"]
    },
    {
      "name": "Channel.recv",
      "signature": "(ch:Channel -- val:i64)!",
      "failable": true,
      "description": "Receive a value from the channel (blocking).",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}],
      "returns": [{"name": "val", "type": "i64", "description": "Received value"}],
      "errors": ["ErrClosed"],
      "examples": ["ch recv! -> val"]
    },
    {
      "name": "Channel.try_send",
      "signature": "(ch:Channel val:i64 -- success:i64)",
      "failable": false,
      "description": "Try to send without blocking.",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}, {"name": "val", "type": "i64", "description": "Value to send"}],
      "returns": [{"name": "success", "type": "i64", "description": "1 if sent, 0 if would block"}],
      "errors": [],
      "examples": ["ch 42 try_send -> sent"]
    },
    {
      "name": "Channel.try_recv",
      "signature": "(ch:Channel -- val:i64 success:i64)",
      "failable": false,
      "description": "Try to receive without blocking.",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}],
      "returns": [{"name": "val", "type": "i64", "description": "Received value (0 if failed)"}, {"name": "success", "type": "i64", "description": "1 if received, 0 if would block"}],
      "errors": [],
      "examples": ["ch try_recv -> success -> val"]
    },
    {
      "name": "Channel.close",
      "signature": "(ch:Channel -- )",
      "failable": false,
      "description": "Close the channel.",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}],
      "returns": [],
      "errors": [],
      "examples": ["ch close"]
    },
    {
      "name": "Channel.is_closed",
      "signature": "(ch:Channel -- closed:i64)",
      "failable": false,
      "description": "Check if the channel is closed.",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}],
      "returns": [{"name": "closed", "type": "i64", "description": "1 if closed, 0 if open"}],
      "errors": [],
      "examples": ["ch is_closed -> done"]
    },
    {
      "name": "Channel.len",
      "signature": "(ch:Channel -- n:i64)",
      "failable": false,
      "description": "Get number of values in channel buffer.",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}],
      "returns": [{"name": "n", "type": "i64", "description": "Number of buffered values"}],
      "errors": [],
      "examples": ["ch len -> n"]
    },
    {
      "name": "Channel.cap",
      "signature": "(ch:Channel -- c:i64)",
      "failable": false,
      "description": "Get channel capacity.",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}],
      "returns": [{"name": "c", "type": "i64", "description": "Buffer capacity (0 for unbuffered)"}],
      "errors": [],
      "examples": ["ch cap -> c"]
    },
    {
      "name": "Channel.free",
      "signature": "(ch:Channel -- )",
      "failable": false,
      "description": "Free the channel.",
      "params": [{"name": "ch", "type": "Channel", "description": "Channel handle"}],
      "returns": [],
      "errors": [],
      "examples": ["ch free"]
    },
    {
      "name": "wg_new",
      "signature": "( -- wg:WaitGroup)!",
      "failable": true,
      "description": "Create a new WaitGroup.",
      "params": [],
      "returns": [{"name": "wg", "type": "WaitGroup", "description": "New WaitGroup handle"}],
      "errors": ["ErrCreate"],
      "examples": ["thread::wg_new! -> wg"]
    },
    {
      "name": "WaitGroup.add",
      "signature": "(wg:WaitGroup n:i64 -- )",
      "failable": false,
      "description": "Add to the WaitGroup counter.",
      "params": [{"name": "wg", "type": "WaitGroup", "description": "WaitGroup handle"}, {"name": "n", "type": "i64", "description": "Number to add (usually 1 per thread)"}],
      "returns": [],
      "errors": [],
      "examples": ["wg 2 add"]
    },
    {
      "name": "WaitGroup.done",
      "signature": "(wg:WaitGroup -- )",
      "failable": false,
      "description": "Mark one unit of work as done.",
      "params": [{"name": "wg", "type": "WaitGroup", "description": "WaitGroup handle"}],
      "returns": [],
      "errors": [],
      "examples": ["wg done"]
    },
    {
      "name": "WaitGroup.wait",
      "signature": "(wg:WaitGroup -- )!",
      "failable": true,
      "description": "Wait for all threads to complete.",
      "params": [{"name": "wg", "type": "WaitGroup", "description": "WaitGroup handle"}],
      "returns": [],
      "errors": ["ErrCreate"],
      "examples": ["wg wait!"]
    },
    {
      "name": "WaitGroup.free",
      "signature": "(wg:WaitGroup -- )",
      "failable": false,
      "description": "Free the WaitGroup.",
      "params": [{"name": "wg", "type": "WaitGroup", "description": "WaitGroup handle"}],
      "returns": [],
      "errors": [],
      "examples": ["wg free"]
    }
  ]
}
