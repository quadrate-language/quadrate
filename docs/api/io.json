  "functions": [
    {
      "name": "append_file",
      "signature": "(path:str contents:str -- )",
      "failable": true,
      "description": "Append string contents to a file. Creates the file if it doesn't exist.",
      "params": [{"name": "path", "type": "str", "description": "File path"}, {"name": "contents", "type": "str", "description": "String to append"}],
      "returns": [],
      "errors": [{"code": "ErrPermission", "description": "Permission denied or cannot open file"}, {"code": "ErrWrite", "description": "Write operation failed"}],
      "examples": ["\"/tmp/log.txt\" \"New line\\n\" io::append_file!"]
    },
    {
      "name": "close",
      "signature": "(handle:ptr -- )",
      "failable": false,
      "description": "Close a file.",
      "params": [{"name": "handle", "type": "ptr", "description": "File handle to close"}],
      "returns": [],
      "errors": [],
      "examples": ["f io::close"]
    },
    {
      "name": "eof",
      "signature": "(handle:ptr -- handle:ptr is_eof:i64)",
      "failable": false,
      "description": "Check if at end of file.",
      "params": [{"name": "handle", "type": "ptr", "description": "File handle"}],
      "returns": [{"name": "handle", "type": "ptr", "description": "File handle (unchanged)"}, {"name": "is_eof", "type": "i64", "description": "1 if at EOF, 0 otherwise"}],
      "errors": [],
      "examples": ["f io::eof -> f -> at_end"]
    },
    {
      "name": "flush",
      "signature": "( -- )",
      "failable": false,
      "description": "Flush stdout buffer. Ensures all pending output is written immediately. Useful for progress indicators that don't use newlines.",
      "params": [],
      "returns": [],
      "errors": [],
      "examples": ["\"Loading...\" print io::flush"]
    },
    {
      "name": "open",
      "signature": "(path:str mode:str -- handle:ptr)",
      "failable": true,
      "description": "Open a file.",
      "params": [{"name": "path", "type": "str", "description": "File path"}, {"name": "mode", "type": "str", "description": "Open mode (use io::Read, io::Write, etc.)"}],
      "returns": [{"name": "handle", "type": "ptr", "description": "File handle"}],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}],
      "examples": ["\"data.txt\" io::Read io::open! -> f"]
    },
    {
      "name": "read_file",
      "signature": "(path:str -- contents:str)",
      "failable": true,
      "description": "Read entire file contents.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "contents", "type": "str", "description": "File contents as string"}],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrRead", "description": "Read operation failed"}],
      "examples": ["\"/etc/hostname\" io::read_file! -> contents"]
    },
    {
      "name": "read",
      "signature": "(handle:ptr buffer:ptr count:i64 -- bytes_read:i64)",
      "failable": true,
      "description": "Read bytes into buffer.",
      "params": [{"name": "handle", "type": "ptr", "description": "File handle"}, {"name": "buffer", "type": "ptr", "description": "Pre-allocated buffer"}, {"name": "count", "type": "i64", "description": "Maximum bytes to read"}],
      "returns": [{"name": "bytes_read", "type": "i64", "description": "Actual bytes read"}],
      "errors": [{"code": "ErrInvalidArg", "description": "Invalid file handle, buffer, or count"}, {"code": "ErrRead", "description": "Read operation failed"}],
      "examples": ["f buf 1024 io::read! -> n"]
    },
    {
      "name": "readline",
      "signature": "( -- line:str)",
      "failable": true,
      "description": "Read a line from stdin.",
      "params": [],
      "returns": [{"name": "line", "type": "str", "description": "Line without trailing newline"}],
      "errors": [{"code": "ErrEof", "description": "End of file or read error"}],
      "examples": ["io::readline! -> input"]
    },
    {
      "name": "seek",
      "signature": "(handle:ptr offset:i64 whence:i64 -- position:i64)",
      "failable": true,
      "description": "Seek to position in file.",
      "params": [{"name": "handle", "type": "ptr", "description": "File handle"}, {"name": "offset", "type": "i64", "description": "Offset in bytes"}, {"name": "whence", "type": "i64", "description": "Reference point (SeekSet, SeekCur, SeekEnd)"}],
      "returns": [{"name": "position", "type": "i64", "description": "New position"}],
      "errors": [{"code": "ErrInvalidHandle", "description": "Invalid file handle"}, {"code": "ErrInvalidArg", "description": "Invalid whence value"}, {"code": "ErrSeek", "description": "Seek operation failed"}],
      "examples": ["f 0 io::SeekSet io::seek! drop"]
    },
    {
      "name": "stat_atime",
      "signature": "(path:str -- atime:i64)",
      "failable": true,
      "description": "Get file access time.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "atime", "type": "i64", "description": "Last access time as Unix timestamp"}],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied"}, {"code": "ErrStat", "description": "Stat operation failed"}],
      "examples": ["\"/etc/hostname\" io::stat_atime! -> atime"]
    },
    {
      "name": "stat_mode",
      "signature": "(path:str -- mode:i64)",
      "failable": true,
      "description": "Get file permissions (Unix mode).",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "mode", "type": "i64", "description": "Unix permission mode (e.g., 0644)"}],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied"}, {"code": "ErrStat", "description": "Stat operation failed"}],
      "examples": ["\"/etc/hostname\" io::stat_mode! -> mode"]
    },
    {
      "name": "stat_mtime",
      "signature": "(path:str -- mtime:i64)",
      "failable": true,
      "description": "Get file modification time.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "mtime", "type": "i64", "description": "Last modification time as Unix timestamp"}],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied"}, {"code": "ErrStat", "description": "Stat operation failed"}],
      "examples": ["\"/etc/hostname\" io::stat_mtime! -> mtime"]
    },
    {
      "name": "stat_size",
      "signature": "(path:str -- size:i64)",
      "failable": true,
      "description": "Get file size in bytes.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "size", "type": "i64", "description": "File size in bytes"}],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied"}, {"code": "ErrStat", "description": "Stat operation failed"}],
      "examples": ["\"/etc/hostname\" io::stat_size! -> size"]
    },
    {
      "name": "tell",
      "signature": "(handle:ptr -- position:i64)",
      "failable": true,
      "description": "Get current position in file.",
      "params": [{"name": "handle", "type": "ptr", "description": "File handle"}],
      "returns": [{"name": "position", "type": "i64", "description": "Current position"}],
      "errors": [{"code": "ErrInvalidHandle", "description": "Invalid file handle"}, {"code": "ErrSeek", "description": "Tell operation failed"}],
      "examples": ["f io::tell! -> pos"]
    },
    {
      "name": "write_file",
      "signature": "(path:str contents:str -- )",
      "failable": true,
      "description": "Write string contents to file. Creates or truncates the file at the given path.",
      "params": [{"name": "path", "type": "str", "description": "File path"}, {"name": "contents", "type": "str", "description": "String to write"}],
      "returns": [],
      "errors": [{"code": "ErrPermission", "description": "Permission denied or cannot create file"}, {"code": "ErrWrite", "description": "Write operation failed"}],
      "examples": ["\"/tmp/test.txt\" \"Hello, world!\\n\" io::write_file!"]
    },
    {
      "name": "write",
      "signature": "(handle:ptr buffer:ptr count:i64 -- bytes_written:i64)",
      "failable": true,
      "description": "Write bytes from buffer.",
      "params": [{"name": "handle", "type": "ptr", "description": "File handle"}, {"name": "buffer", "type": "ptr", "description": "Buffer containing data"}, {"name": "count", "type": "i64", "description": "Number of bytes to write"}],
      "returns": [{"name": "bytes_written", "type": "i64", "description": "Actual bytes written"}],
      "errors": [{"code": "ErrInvalidArg", "description": "Invalid file handle, buffer, or count"}, {"code": "ErrWrite", "description": "Write operation failed"}],
      "examples": ["f buf len io::write! drop"]
    }
  ]
}
