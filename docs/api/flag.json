{
  "name": "flag",
  "description": "Command-line flag parsing. Error codes: Ok=1 (success), specific errors start at 2 doccheck: page-context doccheck: page-context use os doccheck: page-setup os::args flag::parse -> f",
  "constants": [
    {
      "name": "ErrInvalidValue",
      "value": "4",
      "description": "Error: Invalid value format."
    },
    {
      "name": "ErrNotFound",
      "value": "2",
      "description": "Error: Flag not found."
    },
    {
      "name": "ErrNoValue",
      "value": "3",
      "description": "Error: Value not found (flag exists but has no value)."
    }
  ],
  "structs": [
    {
      "name": "Flag",
      "description": "Parsed command-line arguments.",
      "fields": [
        {"name": "argc", "type": "i64", "description": "Argument count"},
        {"name": "argv", "type": "str", "description": "Arguments string"}
      ]
    }
  ],
  "functions": [
    {
      "name": "boolean",
      "signature": "(f:Flag) boolean(name:str -- present:i64)",
      "failable": false,
      "description": "Check if a boolean flag exists.",
      "params": [{"name": "f", "type": "ptr", "description": "Flag struct"}, {"name": "name", "type": "str", "description": "Flag name (e.g., \"--verbose\")"}],
      "returns": [{"name": "present", "type": "i64", "description": "1 if found, 0 otherwise"}],
      "errors": [],
      "examples": ["f \"--verbose\" flag::boolean if { \"verbose\" print nl }"]
    },
    {
      "name": "destroy",
      "signature": "(f:Flag) destroy()",
      "failable": false,
      "description": "Free a Flag struct and its argv string.",
      "params": [],
      "returns": [],
      "errors": [],
      "examples": ["f flag::destroy"]
    },
    {
      "name": "float",
      "signature": "(f:Flag) float(name:str -- value:f64)",
      "failable": true,
      "description": "Get float value of a flag.",
      "params": [{"name": "f", "type": "ptr", "description": "Flag struct"}, {"name": "name", "type": "str", "description": "Flag name"}],
      "returns": [{"name": "value", "type": "f64", "description": "Flag value as float"}],
      "errors": [{"code": "ErrNotFound", "description": "Flag not found"}],
      "examples": ["f \"--rate\" flag::float! -> rate"]
    },
    {
      "name": "int",
      "signature": "(f:Flag) int(name:str -- value:i64)",
      "failable": true,
      "description": "Get integer value of a flag.",
      "params": [{"name": "f", "type": "ptr", "description": "Flag struct"}, {"name": "name", "type": "str", "description": "Flag name"}],
      "returns": [{"name": "value", "type": "i64", "description": "Flag value as integer"}],
      "errors": [{"code": "ErrNotFound", "description": "Flag not found"}],
      "examples": ["f \"--count\" flag::int! -> count"]
    },
    {
      "name": "parse",
      "signature": "(args:ptr -- f:Flag)",
      "failable": false,
      "description": "Parse command-line arguments.",
      "params": [{"name": "args", "type": "ptr", "description": "Argument array, as os::args returns"}],
      "returns": [{"name": "f", "type": "Flag", "description": "Parsed flags"}],
      "errors": [],
      "examples": ["os::args flag::parse -> f"]
    },
    {
      "name": "positional",
      "signature": "(f:Flag) positional(index:i64 -- value:str)",
      "failable": true,
      "description": "Get positional argument at index.",
      "params": [{"name": "f", "type": "ptr", "description": "Flag struct"}, {"name": "index", "type": "i64", "description": "Position (0-based, skips flags starting with -)"}],
      "returns": [{"name": "value", "type": "str", "description": "Positional argument"}],
      "errors": [{"code": "ErrNotFound", "description": "Index out of bounds"}],
      "examples": []
    },
    {
      "name": "string",
      "signature": "(f:Flag) string(name:str -- value:str)",
      "failable": true,
      "description": "Get string value of a flag.",
      "params": [{"name": "f", "type": "ptr", "description": "Flag struct"}, {"name": "name", "type": "str", "description": "Flag name"}],
      "returns": [{"name": "value", "type": "str", "description": "Flag value"}],
      "errors": [{"code": "ErrNotFound", "description": "Flag not found"}, {"code": "ErrNoValue", "description": "Flag exists but has no value"}],
      "examples": ["f \"--name\" flag::string! -> name"]
    }
  ]
}
