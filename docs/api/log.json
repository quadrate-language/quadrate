{
  "name": "log",
  "description": "Logging module - structured logging with levels and rotation.  Provides: - Log levels: Debug, Info, Warn, Error - Structured key-value logging - Multiple outputs (stdout, files) - Log rotation (by size, daily, hourly) - Text and JSON formats  ## Example      use log      fn main() {         // Create logger         log::new! -> logger          // Basic logging         logger \"server started\" log::info         logger \"connection failed\" log::error          // Set minimum level         logger log::LevelWarn log::set_level          // Add file output with rotation         logger \"/var/log/app.log\" log::RotateDaily 0 7 log::add_file_rotate!          // Structured logging with key-value pairs         logger \"user login\" \"user\" \"alice\" \"ip\" \"192.168.1.1\" 2 log::info_kv          // JSON format         logger log::FormatJson log::set_format          // Cleanup         logger log::free     }",
  "constants": [
    {
      "name": "ErrAlloc",
      "value": "2",
      "description": "Error: Memory allocation failed."
    },
    {
      "name": "ErrFile",
      "value": "3",
      "description": "Error: File operation failed."
    },
    {
      "name": "ErrInvalid",
      "value": "4",
      "description": "Error: Invalid argument."
    },
    {
      "name": "FormatJson",
      "value": "1",
      "description": "Output format: JSON lines."
    },
    {
      "name": "FormatText",
      "value": "0",
      "description": "Output format: human-readable text."
    },
    {
      "name": "LevelDebug",
      "value": "0",
      "description": "Log level: Debug (most verbose)."
    },
    {
      "name": "LevelError",
      "value": "3",
      "description": "Log level: Error (errors only)."
    },
    {
      "name": "LevelInfo",
      "value": "1",
      "description": "Log level: Info (normal messages)."
    },
    {
      "name": "LevelOff",
      "value": "4",
      "description": "Log level: Off (no logging)."
    },
    {
      "name": "LevelWarn",
      "value": "2",
      "description": "Log level: Warn (warnings)."
    },
    {
      "name": "RotateDaily",
      "value": "2",
      "description": "Rotation mode: rotate daily."
    },
    {
      "name": "RotateHourly",
      "value": "3",
      "description": "Rotation mode: rotate hourly."
    },
    {
      "name": "RotateNone",
      "value": "0",
      "description": "Rotation mode: no rotation."
    },
    {
      "name": "RotateSize",
      "value": "1",
      "description": "Rotation mode: rotate by file size."
    }
