  "functions": [
    {
      "name": "add_file",
      "signature": "(logger:Logger) add_file(path:str -- )",
      "failable": true,
      "description": "Add file output (no rotation). ",
      "params": [{"name": "path", "type": "str", "description": "Log file path"}],
      "returns": [],
      "errors": [{"code": "ErrFile", "description": "Failed to open file"}],
      "examples": ["logger \"/var/log/app.log\" log::add_file!"]
    },
    {
      "name": "add_file_rotate",
      "signature": "(logger:Logger) add_file_rotate(path:str mode:i64 max_size:i64 max_files:i64 -- )",
      "failable": true,
      "description": "Add file output with rotation. ",
      "params": [{"name": "path", "type": "str", "description": "Base log file path"}, {"name": "mode", "type": "i64", "description": "Rotation mode (RotateNone, RotateSize, RotateDaily, RotateHourly)"}, {"name": "max_size", "type": "i64", "description": "Max file size for RotateSize (bytes), 0 for time-based"}, {"name": "max_files", "type": "i64", "description": "Max rotated files to keep (0 = unlimited)"}],
      "returns": [],
      "errors": [{"code": "ErrFile", "description": "Failed to open file"}],
      "examples": ["logger \"/var/log/app.log\" log::RotateDaily 0 7 log::add_file_rotate!"]
