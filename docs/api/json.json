      "returns": [{"name": "value", "type": "str", "description": "Nested array as JSON string"}, {"name": "found", "type": "i64", "description": "1 if found, 0 otherwise"}],
      "errors": [],
      "examples": ["\"[[1,2],[3,4]]\" 0 json::array_get_array  // \"[1,2]\" 1"]
