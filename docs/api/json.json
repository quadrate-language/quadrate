{
  "name": "json",
  "description": "JSON parsing and querying.  Two ways in. `parse` reads a document once into a Value tree, which is what you want when more than one field is read out of it. The get_* family scans the text for a single key and allocates nothing, which is cheaper for exactly that -- one lookup, one document. doccheck: page-context doccheck: page-setup \"{\\x22name\\x22:\\x22Ada\\x22,\\x22n\\x22:1,\\x22xs\\x22:[1,2]}\" json::parse! -> doc doccheck: page-setup doc \"n\" json::get! -> v doccheck: page-setup doc json::first! -> c doccheck: page-setup json::new_array -> arr doccheck: page-setup json::new_object -> obj",
  "constants": [
    {
      "name": "Array",
      "value": "4",
      "description": "Type: Array value."
    },
    {
      "name": "Bool",
      "value": "1",
      "description": "Type: Boolean value."
    },
    {
      "name": "ErrDepth",
      "value": "14",
      "description": "Error: the document nests deeper than MaxDepth."
    },
    {
      "name": "ErrIndex",
      "value": "12",
      "description": "Error: the array index is out of range."
    },
    {
      "name": "ErrKey",
      "value": "13",
      "description": "Error: the object has no member with that key."
    },
    {
      "name": "ErrSyntax",
      "value": "10",
      "description": "Error: the document is not well-formed JSON."
    },
    {
      "name": "ErrType",
      "value": "11",
      "description": "Error: the value is not of the requested type."
    },
    {
      "name": "MaxDepth",
      "value": "200",
      "description": "Deepest array/object nesting `parse` accepts. Parsing is recursive, so this is what stops a document like [[[[... from running the process out of stack."
    },
    {
      "name": "Null",
      "value": "0",
      "description": "Type: Null value."
    },
    {
      "name": "Number",
      "value": "2",
      "description": "Type: Number value."
    },
    {
      "name": "Object",
      "value": "5",
      "description": "Type: Object value."
    },
    {
      "name": "String",
      "value": "3",
      "description": "Type: String value."
    }
  ],
  "structs": [
    {
      "name": "Value",
      "description": "A parsed JSON value.  Children are a singly linked list rather than an array: `head` is the first element (or member), `next` chains siblings, and `tail` is kept only so that appending stays O(1). An object member carries its name in `key`. ",
      "fields": [
        {"name": "kind", "type": "i64", "description": "One of Null, Bool, Number, String, Array, Object"},
        {"name": "inum", "type": "i64", "description": "Bool payload (0 or 1), or the Number payload when isint"},
        {"name": "num", "type": "f64", "description": "Number payload, always set for a Number"},
        {"name": "isint", "type": "i64", "description": "1 when the number was written without fraction or exponent"},
        {"name": "text", "type": "str", "description": "String payload"},
        {"name": "key", "type": "str", "description": "Member name, when this value is a member of an object"},
        {"name": "head", "type": "ptr", "description": "First child, or null"},
        {"name": "tail", "type": "ptr", "description": "Last child, or null"},
        {"name": "next", "type": "ptr", "description": "Next sibling, or null"},
        {"name": "count", "type": "i64", "description": "Number of children"}
      ]
    }
  ],
  "functions": [
