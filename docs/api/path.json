{
  "name": "path",
  "description": "File path manipulation functions. POSIX-style paths with forward slash separator.",
  "constants": [
    {
      "name": "Sep",
      "value": "\"/\"",
      "description": "Path separator constant."
    }
  ],
  "structs": [

  ],
  "functions": [
    {
      "name": "basename",
      "signature": "(path:str -- name:str)",
      "failable": false,
      "description": "Get the filename part of a path.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "name", "type": "str", "description": "Filename component"}],
      "errors": [],
      "examples": ["\"/home/user/file.txt\" path::basename -> \"file.txt\""]
    },
    {
      "name": "depth",
      "signature": "(path:str -- depth:i64)",
      "failable": false,
      "description": "Get the depth of a path (number of components).",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "depth", "type": "i64", "description": "Number of path components"}],
      "errors": [],
      "examples": ["\"/home/user/file.txt\" path::depth -> 3"]
    },
    {
      "name": "dirname",
      "signature": "(path:str -- dir:str)",
      "failable": false,
      "description": "Get the directory part of a path.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "dir", "type": "str", "description": "Directory component"}],
      "errors": [],
      "examples": ["\"/home/user/file.txt\" path::dirname -> \"/home/user\""]
    },
    {
      "name": "ext",
      "signature": "(path:str -- ext:str)",
      "failable": false,
      "description": "Get the file extension (including dot).",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "ext", "type": "str", "description": "Extension including dot, empty if none"}],
      "errors": [],
      "examples": ["\"file.txt\" path::ext -> \".txt\""]
    },
    {
      "name": "has_extension",
      "signature": "(path:str extension:str -- result:i64)",
      "failable": false,
      "description": "Check if a path matches a simple extension filter.",
      "params": [{"name": "path", "type": "str", "description": "File path"}, {"name": "extension", "type": "str", "description": "Extension to match (with or without dot)"}],
      "returns": [{"name": "result", "type": "i64", "description": "1 if matches, 0 otherwise"}],
      "errors": [],
      "examples": ["\"file.txt\" \"txt\" path::has_extension -> 1"]
    },
    {
      "name": "has_ext",
      "signature": "(path:str -- result:i64)",
      "failable": false,
      "description": "Check if path has an extension.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "result", "type": "i64", "description": "1 if has extension, 0 otherwise"}],
      "errors": [],
      "examples": ["\"file.txt\" path::has_ext -> 1"]
    },
    {
      "name": "is_absolute",
      "signature": "(path:str -- result:i64)",
      "failable": false,
      "description": "Check if path is absolute.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "result", "type": "i64", "description": "1 if absolute, 0 otherwise"}],
      "errors": [],
      "examples": ["\"/home/user\" path::is_absolute -> 1"]
    },
    {
      "name": "is_relative",
      "signature": "(path:str -- result:i64)",
      "failable": false,
      "description": "Check if path is relative (not absolute).",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "result", "type": "i64", "description": "1 if relative, 0 otherwise"}],
      "errors": [],
      "examples": ["\"home/user\" path::is_relative -> 1"]
    },
    {
      "name": "join",
      "signature": "(p1:str p2:str -- joined:str)",
      "failable": false,
      "description": "Join two path components.",
      "params": [{"name": "p1", "type": "str", "description": "First path"}, {"name": "p2", "type": "str", "description": "Second path"}],
      "returns": [{"name": "joined", "type": "str", "description": "Joined path"}],
      "errors": [],
      "examples": ["\"/home\" \"user\" path::join -> \"/home/user\""]
    },
    {
      "name": "normalize",
      "signature": "(path:str -- norm:str)",
      "failable": false,
      "description": "Normalize a path (remove redundant separators).",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "norm", "type": "str", "description": "Normalized path"}],
      "errors": [],
      "examples": ["\"/home//user/\" path::normalize -> \"/home/user\""]
    },
    {
      "name": "parent",
      "signature": "(path:str -- parent:str)",
      "failable": false,
      "description": "Get parent directory (same as dirname but clearer name).",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "parent", "type": "str", "description": "Parent directory"}],
      "errors": [],
      "examples": ["\"/home/user/file.txt\" path::parent -> \"/home/user\""]
    },
    {
      "name": "starts_with",
      "signature": "(path:str prefix:str -- result:i64)",
      "failable": false,
      "description": "Check if path starts with a given prefix path.",
      "params": [{"name": "path", "type": "str", "description": "File path to check"}, {"name": "prefix", "type": "str", "description": "Prefix path"}],
      "returns": [{"name": "result", "type": "i64", "description": "1 if starts with prefix, 0 otherwise"}],
      "errors": [],
      "examples": ["\"/home/user/file.txt\" \"/home\" path::starts_with -> 1"]
    },
    {
      "name": "stem",
      "signature": "(path:str -- stem:str)",
      "failable": false,
      "description": "Get filename without extension.",
      "params": [{"name": "path", "type": "str", "description": "File path"}],
      "returns": [{"name": "stem", "type": "str", "description": "Filename without extension"}],
      "errors": [],
      "examples": ["\"file.txt\" path::stem -> \"file\""]
    },
    {
      "name": "strip_prefix",
      "signature": "(path:str prefix:str -- result:str)",
      "failable": false,
      "description": "Remove a prefix from a path if it exists.",
      "params": [{"name": "path", "type": "str", "description": "File path"}, {"name": "prefix", "type": "str", "description": "Prefix to remove"}],
      "returns": [{"name": "result", "type": "str", "description": "Path without prefix"}],
      "errors": [],
      "examples": ["\"/home/user/file.txt\" \"/home\" path::strip_prefix -> \"user/file.txt\""]
    },
    {
      "name": "with_ext",
      "signature": "(path:str newext:str -- result:str)",
      "failable": false,
      "description": "Change or add file extension.",
      "params": [{"name": "path", "type": "str", "description": "File path"}, {"name": "newext", "type": "str", "description": "New extension (with or without leading dot)"}],
      "returns": [{"name": "result", "type": "str", "description": "Path with new extension"}],
      "errors": [],
      "examples": ["\"file.txt\" \".md\" path::with_ext -> \"file.md\""]
    }
  ]
}
