{
  "name": "crc32",
  "description": "CRC32 checksum calculation. Implements the standard CRC-32 algorithm (ISO 3309, used in Ethernet, ZIP, PNG). Polynomial: 0xEDB88320 (reflected form of 0x04C11DB7)",
  "constants": [

  ],
  "structs": [

  ],
  "functions": [
    {
      "name": "checksum_buf",
      "signature": "(buf:ptr len:i64 -- crc:i64)",
      "failable": false,
      "description": "Calculate CRC32 of a byte buffer.",
      "params": [{"name": "buf", "type": "ptr", "description": "Buffer to checksum"}, {"name": "len", "type": "i64", "description": "Length of buffer in bytes"}],
      "returns": [{"name": "crc", "type": "i64", "description": "CRC32 checksum"}],
      "errors": [],
      "examples": ["buf buflen crc32::checksum_buf -> crc"]
    },
    {
      "name": "checksum_hex",
      "signature": "(s:str -- h:str)",
      "failable": false,
      "description": "Calculate CRC32 and return as 8-character hex string.",
      "params": [{"name": "s", "type": "str", "description": "Input string"}],
      "returns": [{"name": "hex", "type": "str", "description": "CRC32 as hex string (lowercase)"}],
      "errors": [],
      "examples": ["\"Hello\" crc32::hex -> h  // \"f7d18982\""]
    },
    {
      "name": "checksum",
      "signature": "(s:str -- crc:i64)",
      "failable": false,
      "description": "Calculate CRC32 checksum of a string.",
      "params": [{"name": "s", "type": "str", "description": "Input string"}],
      "returns": [{"name": "crc", "type": "i64", "description": "CRC32 checksum as unsigned 32-bit value"}],
      "errors": [],
      "examples": ["\"Hello\" crc32::checksum -> crc"]
    },
    {
      "name": "finalize",
      "signature": "(crc:i64 -- final:i64)",
      "failable": false,
      "description": "Finalize a running CRC to get the final checksum.",
      "params": [{"name": "crc", "type": "i64", "description": "Current CRC state from update()"}],
      "returns": [{"name": "final", "type": "i64", "description": "Final CRC32 checksum"}],
      "errors": [],
      "examples": ["crc_state crc32::finalize -> crc"]
    },
    {
      "name": "update",
      "signature": "(crc:i64 s:str -- new_crc:i64)",
      "failable": false,
      "description": "Update a running CRC with more data. Use for streaming/incremental CRC calculation.",
      "params": [{"name": "crc", "type": "i64", "description": "Current CRC state (use 4294967295 to start)"}, {"name": "s", "type": "str", "description": "Data to add"}],
      "returns": [{"name": "new_crc", "type": "i64", "description": "Updated CRC state"}],
      "errors": [],
      "examples": ["4294967295 \"Hello\" crc32::update \" World\" crc32::update crc32::finalize -> crc"]
    },
    {
      "name": "verify",
      "signature": "(s:str expected:i64 -- ok:i64)",
      "failable": false,
      "description": "Verify data against an expected CRC32.",
      "params": [{"name": "s", "type": "str", "description": "Data to verify"}, {"name": "expected", "type": "i64", "description": "Expected CRC32 value"}],
      "returns": [{"name": "ok", "type": "i64", "description": "1 if matches, 0 otherwise"}],
      "errors": [],
      "examples": ["\"Hello\" 4157704578 crc32::verify -> ok"]
    }
  ]
}
