{
  "name": "builtins",
  "description": "Built-in stack operations, arithmetic, and control instructions.",
  "categories": [
    {
      "name": "Stack Manipulation",
      "instructions": [
        {"name": "dup", "signature": "(a -- a a)", "description": "Duplicate top element"},
        {"name": "dupd", "signature": "(a b -- a a b)", "description": "Duplicate second element"},
        {"name": "dup2", "signature": "(a b -- a b a b)", "description": "Duplicate top two elements"},
        {"name": "swap", "signature": "(a b -- b a)", "description": "Swap top two elements"},
        {"name": "swapd", "signature": "(a b c -- b a c)", "description": "Swap second pair of elements"},
        {"name": "swap2", "signature": "(a b c d -- c d a b)", "description": "Swap two pairs"},
        {"name": "over", "signature": "(a b -- a b a)", "description": "Copy second element to top"},
        {"name": "overd", "signature": "(a b c -- a b c a)", "description": "Copy second element below top"},
        {"name": "over2", "signature": "(a b c d -- a b c d a b)", "description": "Copy second pair to top"},
        {"name": "nip", "signature": "(a b -- b)", "description": "Remove second element"},
        {"name": "nipd", "signature": "(a b c -- a c)", "description": "Remove second element below top"},
        {"name": "drop", "signature": "(a --)", "description": "Drop top element"},
        {"name": "drop2", "signature": "(a b --)", "description": "Drop top two elements"},
        {"name": "rot", "signature": "(a b c -- b c a)", "description": "Rotate three elements"},
        {"name": "tuck", "signature": "(a b -- b a b)", "description": "Copy top below second"},
        {"name": "pick", "signature": "(... n -- ... x)", "description": "Copy nth element to top (0 = top)"},
        {"name": "roll", "signature": "(... n -- ... x)", "description": "Move nth element to top"},
        {"name": "depth", "signature": "(-- n)", "description": "Push current stack depth"},
        {"name": "clear", "signature": "(... --)", "description": "Clear entire stack"},
        {"name": "call", "signature": "(fn --)", "description": "Call a function pointer"}
      ]
    },
    {
      "name": "Arithmetic",
      "instructions": [
        {"name": "add", "signature": "(a b -- a+b)", "description": "Add top two elements", "alias": "+"},
        {"name": "sub", "signature": "(a b -- a-b)", "description": "Subtract top from second", "alias": "-"},
        {"name": "mul", "signature": "(a b -- a*b)", "description": "Multiply top two elements", "alias": "*"},
        {"name": "div", "signature": "(a b -- a/b)", "description": "Divide second by top", "alias": "/"},
        {"name": "mod", "signature": "(a b -- a%b)", "description": "Modulo (remainder)", "alias": "%"},
        {"name": "neg", "signature": "(a -- -a)", "description": "Negate top element"},
        {"name": "inc", "signature": "(a -- a+1)", "description": "Increment by 1", "alias": "++"},
        {"name": "dec", "signature": "(a -- a-1)", "description": "Decrement by 1", "alias": "--"}
      ]
    },
    {
      "name": "Comparison",
      "instructions": [
        {"name": "eq", "signature": "(a b -- bool)", "description": "Test equality (a == b)", "alias": "=="},
        {"name": "neq", "signature": "(a b -- bool)", "description": "Test inequality (a != b)", "alias": "!="},
        {"name": "lt", "signature": "(a b -- bool)", "description": "Test less than (a < b)", "alias": "<"},
        {"name": "gt", "signature": "(a b -- bool)", "description": "Test greater than (a > b)", "alias": ">"},
        {"name": "lte", "signature": "(a b -- bool)", "description": "Test less or equal (a <= b)", "alias": "<="},
        {"name": "gte", "signature": "(a b -- bool)", "description": "Test greater or equal (a >= b)", "alias": ">="},
        {"name": "within", "signature": "(val min max -- bool)", "description": "Test if val is in [min, max]"}
      ]
    },
    {
      "name": "Bitwise",
      "instructions": [
        {"name": "and", "signature": "(a b -- a&b)", "description": "Bitwise AND"},
        {"name": "or", "signature": "(a b -- a|b)", "description": "Bitwise OR"},
        {"name": "xor", "signature": "(a b -- a^b)", "description": "Bitwise XOR"},
        {"name": "not", "signature": "(a -- ~a)", "description": "Bitwise NOT"},
        {"name": "shl", "signature": "(a n -- a<<n)", "description": "Shift left by n bits", "alias": "<<"},
        {"name": "shr", "signature": "(a n -- a>>n)", "description": "Shift right by n bits", "alias": ">>"}
      ]
    },
    {
      "name": "Type Casting",
      "instructions": [
        {"name": "cast<T>", "signature": "(a -- T)", "description": "Cast to specified type (i64, f64, str, ptr)"},
        {"name": "sizeof<T>", "signature": "(-- size)", "description": "Get size of type in bytes: sizeof<MyStruct>"}
      ]
    },
    {
      "name": "Arrays",
      "instructions": [
        {"name": "make", "signature": "(n -- arr)", "description": "Create array of n elements (generic)"},
        {"name": "makei", "signature": "(n -- arr)", "description": "Create array of n integers"},
        {"name": "makef", "signature": "(n -- arr)", "description": "Create array of n floats"},
        {"name": "makes", "signature": "(n -- arr)", "description": "Create array of n strings"},
        {"name": "makep", "signature": "(n -- arr)", "description": "Create array of n pointers"},
        {"name": "nth", "signature": "(arr i -- val)", "description": "Get element at index i"},
        {"name": "set", "signature": "(arr i val -- arr)", "description": "Set element at index i"},
        {"name": "len", "signature": "(arr -- n)", "description": "Get array length"},
        {"name": "append", "signature": "(arr val -- arr)", "description": "Append element to array"}
      ]
    },
    {
      "name": "I/O",
      "instructions": [
        {"name": "print", "signature": "(a --)", "description": "Print top value (no newline)"},
        {"name": "prints", "signature": "(... -- ...)", "description": "Print entire stack"},
        {"name": "printv", "signature": "(a --)", "description": "Print top value with type info"},
        {"name": "printsv", "signature": "(... -- ...)", "description": "Print entire stack with types"},
        {"name": "nl", "signature": "(--)", "description": "Print newline"},
        {"name": "read", "signature": "(-- argc arg1 arg2 ...)", "description": "Read command-line arguments"}
      ]
    },
    {
      "name": "Memory",
      "instructions": [
        {"name": "free", "signature": "(ptr --)", "description": "Free allocated memory"}
      ]
    },
    {
      "name": "Error Handling",
      "instructions": [
        {"name": "panic", "signature": "(msg code --)", "description": "Raise an error and return from current fallible function"},
        {"name": "err", "signature": "(-- msg code)", "description": "Get last error message and code after a fallible function fails"}
      ]
    },
    {
      "name": "Threading",
      "instructions": [
        {"name": "spawn", "signature": "(fn -- thread)", "description": "Spawn new thread running function"},
        {"name": "detach", "signature": "(thread --)", "description": "Detach thread (no join needed)"},
        {"name": "wait", "signature": "(thread --)", "description": "Wait for thread to complete"}
      ]
    }
  ]
}
