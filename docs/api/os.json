{
  "name": "os",
  "description": "Operating system interface. Error codes: Ok=1 (success), specific errors start at 2",
  "constants": [
    {
      "name": "ErrExists",
      "value": "4",
      "description": "Error: File already exists."
    },
    {
      "name": "ErrInvalidArg",
      "value": "12",
      "description": "Error: Invalid argument."
    },
    {
      "name": "ErrIo",
      "value": "7",
      "description": "Error: I/O error."
    },
    {
      "name": "ErrIsDirectory",
      "value": "6",
      "description": "Error: Path is a directory."
    },
    {
      "name": "ErrNameTooLong",
      "value": "10",
      "description": "Error: File name too long."
    },
    {
      "name": "ErrNoSpace",
      "value": "8",
      "description": "Error: No space left on device."
    },
    {
      "name": "ErrNotDirectory",
      "value": "5",
      "description": "Error: Path is not a directory."
    },
    {
      "name": "ErrNotFound",
      "value": "2",
      "description": "Error: No such file or directory."
    },
    {
      "name": "ErrOutOfMemory",
      "value": "11",
      "description": "Error: Out of memory."
    },
    {
      "name": "ErrPermission",
      "value": "3",
      "description": "Error: Permission denied."
    },
    {
      "name": "ErrReadOnly",
      "value": "9",
      "description": "Error: Read-only file system."
    },
    {
      "name": "ExitFailure",
      "value": "1",
      "description": "Exit code for failed termination."
    },
    {
      "name": "ExitSuccess",
      "value": "0",
      "description": "Exit code for successful termination."
    }
  ],
  "structs": [

  ],
  "functions": [
    {
      "name": "chdir",
      "signature": "(path:str -- )",
      "failable": true,
      "description": "Change the current working directory.",
      "params": [{"name": "path", "type": "str", "description": "Directory path"}],
      "returns": [],
      "errors": [{"code": "ErrNotFound", "description": "Directory not found"}, {"code": "ErrPermission", "description": "Permission denied"}, {"code": "ErrNotDirectory", "description": "Path is not a directory"}],
      "examples": ["\"/tmp\" os::chdir!"]
    },
    {
      "name": "chmod",
      "signature": "(path:str mode:i64 -- )",
      "failable": true,
      "description": "Change file permissions. Mode is specified as Unix permission bits (e.g., 0o644, 0o755).",
      "params": [{"name": "path", "type": "str", "description": "File or directory path"}, {"name": "mode", "type": "i64", "description": "Permission mode (e.g., 420 for 0o644)"}],
      "returns": [],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied"}],
      "examples": ["\"/tmp/script.sh\" 0o755 os::chmod!"]
    },
    {
      "name": "chown",
      "signature": "(path:str uid:i64 gid:i64 -- )",
      "failable": true,
      "description": "Change file owner and group. Use -1 for uid or gid to leave unchanged.",
      "params": [{"name": "path", "type": "str", "description": "File or directory path"}, {"name": "uid", "type": "i64", "description": "User ID (-1 to not change)"}, {"name": "gid", "type": "i64", "description": "Group ID (-1 to not change)"}],
      "returns": [],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied (usually requires root)"}],
      "examples": ["\"/tmp/myfile\" 1000 1000 os::chown!"]
    },
    {
      "name": "copy",
      "signature": "(srcpath:str dstpath:str -- )",
      "failable": true,
      "description": "Copy a file.",
      "params": [{"name": "srcpath", "type": "str", "description": "Source path"}, {"name": "dstpath", "type": "str", "description": "Destination path"}],
      "returns": [],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied"}],
      "examples": ["\"src.txt\" \"dst.txt\" os::copy!"]
    },
    {
      "name": "cwd",
      "signature": "( -- path:str)",
      "failable": true,
      "description": "Get current working directory.",
      "params": [],
      "returns": [{"name": "path", "type": "str", "description": "Current working directory path"}],
      "errors": [{"code": "ErrIo", "description": "Failed to get directory"}],
      "examples": ["os::cwd! -> dir"]
    },
    {
      "name": "delete",
      "signature": "(path:str -- )",
      "failable": true,
      "description": "Delete a file or empty directory.",
      "params": [{"name": "path", "type": "str", "description": "Path to delete"}],
      "returns": [],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied"}],
      "examples": ["\"/tmp/test.txt\" os::delete!"]
    },
    {
      "name": "exec",
      "signature": "(cmd:str -- stdout:str exitcode:i64)",
      "failable": true,
      "description": "Execute a command and capture all output. Simpler alternative to os::popen when you just need the full output.",
      "params": [{"name": "cmd", "type": "str", "description": "Command to execute"}],
      "returns": [{"name": "stdout", "type": "str", "description": "All output from command"}, {"name": "exitcode", "type": "i64", "description": "Command exit status"}],
      "errors": [{"code": "ErrIo", "description": "Failed to execute command"}, {"code": "ErrOutOfMemory", "description": "Out of memory"}],
      "examples": ["\"echo hello\" os::exec! -> exitcode -> stdout"]
    },
    {
      "name": "exists",
      "signature": "(path:str -- exists:i64)",
      "failable": false,
      "description": "Check if path exists.",
      "params": [{"name": "path", "type": "str", "description": "File or directory path"}],
      "returns": [{"name": "exists", "type": "i64", "description": "1 if exists, 0 otherwise"}],
      "errors": [],
      "examples": ["\"/tmp\" os::exists print  // 1"]
    },
    {
      "name": "exit",
      "signature": "(code:i64 -- )",
      "failable": false,
      "description": "Exit the program with status code.",
      "params": [{"name": "code", "type": "i64", "description": "Exit status (os::ExitSuccess or os::ExitFailure)"}],
      "returns": [],
      "errors": [],
      "examples": ["os::ExitSuccess os::exit"]
    },
    {
      "name": "getenv",
      "signature": "(name:str -- value:str)",
      "failable": false,
      "description": "Get environment variable value.",
      "params": [{"name": "name", "type": "str", "description": "Variable name"}],
      "returns": [{"name": "value", "type": "str", "description": "Variable value (empty if not set)"}],
      "errors": [],
      "examples": ["\"HOME\" os::getenv -> home"]
    },
    {
      "name": "getgid",
      "signature": "( -- gid:i64)",
      "failable": false,
      "description": "Get the current group ID.",
      "params": [],
      "returns": [{"name": "gid", "type": "i64", "description": "Real group ID of the calling process"}],
      "errors": [],
      "examples": ["os::getgid print"]
    },
    {
      "name": "getpid",
      "signature": "( -- pid:i64)",
      "failable": false,
      "description": "Get the current process ID.",
      "params": [],
      "returns": [{"name": "pid", "type": "i64", "description": "Process ID"}],
      "errors": [],
      "examples": ["os::getpid print nl"]
    },
    {
      "name": "getuid",
      "signature": "( -- uid:i64)",
      "failable": false,
      "description": "Get the current user ID.",
      "params": [],
      "returns": [{"name": "uid", "type": "i64", "description": "Real user ID of the calling process"}],
      "errors": [],
      "examples": ["os::getuid print"]
    },
    {
      "name": "glob",
      "signature": "(pattern:str -- entries:ptr count:i64)",
      "failable": true,
      "description": "Match files using glob pattern. Supports *, ?, and ** for recursive matching.",
      "params": [{"name": "pattern", "type": "str", "description": "Glob pattern"}],
      "returns": [{"name": "entries", "type": "ptr", "description": "Array of matching paths"}, {"name": "count", "type": "i64", "description": "Number of matches"}],
      "errors": [],
      "examples": ["\"*.qd\" os::glob! -> count -> entries"]
    },
    {
      "name": "hostname",
      "signature": "( -- hostname:str)",
      "failable": true,
      "description": "Get the system hostname.",
      "params": [],
      "returns": [{"name": "hostname", "type": "str", "description": "Hostname of the current system"}],
      "errors": [{"code": "ErrIo", "description": "Failed to get hostname"}],
      "examples": ["os::hostname! print"]
    },
    {
      "name": "is_dir",
      "signature": "(path:str -- is_dir:i64)",
      "failable": false,
      "description": "Check if path is a directory.",
      "params": [{"name": "path", "type": "str", "description": "Path to check"}],
      "returns": [{"name": "is_dir", "type": "i64", "description": "1 if directory, 0 otherwise"}],
      "errors": [],
      "examples": ["\"/tmp\" os::is_dir print  // 1"]
    },
    {
      "name": "is_file",
      "signature": "(path:str -- is_file:i64)",
      "failable": false,
      "description": "Check if path is a regular file.",
      "params": [{"name": "path", "type": "str", "description": "Path to check"}],
      "returns": [{"name": "is_file", "type": "i64", "description": "1 if regular file, 0 otherwise"}],
      "errors": [],
      "examples": ["\"/etc/passwd\" os::is_file print  // 1"]
    },
    {
      "name": "is_symlink",
      "signature": "(path:str -- is_symlink:i64)",
      "failable": false,
      "description": "Check if path is a symbolic link. Does not follow the link to check if the target exists.",
      "params": [{"name": "path", "type": "str", "description": "Path to check"}],
      "returns": [{"name": "is_symlink", "type": "i64", "description": "1 if symbolic link, 0 otherwise"}],
      "errors": [],
      "examples": ["\"/tmp/mylink\" os::is_symlink print"]
    },
    {
      "name": "list",
      "signature": "(path:str -- entries:ptr count:i64)",
      "failable": true,
      "description": "List directory contents.",
      "params": [{"name": "path", "type": "str", "description": "Directory path"}],
      "returns": [{"name": "entries", "type": "ptr", "description": "Array of entry names"}, {"name": "count", "type": "i64", "description": "Number of entries"}],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrNotDirectory", "description": "Path is not a directory"}],
      "examples": ["\"/tmp\" os::list! -> entries -> count"]
    },
    {
      "name": "mkdir",
      "signature": "(path:str -- )",
      "failable": true,
      "description": "Create a directory and all parent directories.",
      "params": [{"name": "path", "type": "str", "description": "Directory path"}],
      "returns": [],
      "errors": [{"code": "ErrPermission", "description": "Permission denied"}],
      "examples": ["\"/tmp/a/b/c\" os::mkdir!"]
    },
    {
      "name": "mktemp",
      "signature": "( -- path:str)",
      "failable": true,
      "description": "Create a unique temporary directory. Creates a directory in /tmp with a unique name. Caller is responsible for removing it when done (use os::rmdir).",
      "params": [],
      "returns": [{"name": "path", "type": "str", "description": "Path to the created directory"}],
      "errors": [{"code": "ErrIo", "description": "Failed to create directory"}],
      "examples": ["os::mktemp! -> tmpdir"]
    },
    {
      "name": "popen",
      "signature": "(cmd:str callback:ptr -- exitcode:i64)",
      "failable": true,
      "description": "Execute a command and stream output line-by-line to a callback. The callback is called synchronously for each line of output (without trailing newline). The call blocks until the command completes. Closures with captured variables are supported.",
      "params": [{"name": "cmd", "type": "str", "description": "Command to execute"}, {"name": "callback", "type": "ptr", "description": "Callback function (line:str -- )"}],
      "returns": [{"name": "exitcode", "type": "i64", "description": "Command exit status"}],
      "errors": [{"code": "ErrIo", "description": "Failed to execute command"}],
      "examples": ["\"ls -la\" fn (line:str -- ) { print nl } os::popen! -> code"]
    },
    {
      "name": "readlink",
      "signature": "(path:str -- target:str)",
      "failable": true,
      "description": "Read the target of a symbolic link.",
      "params": [{"name": "path", "type": "str", "description": "Path to the symbolic link"}],
      "returns": [{"name": "target", "type": "str", "description": "Path that the link points to"}],
      "errors": [{"code": "ErrNotFound", "description": "Link not found"}, {"code": "ErrInvalidArg", "description": "Path is not a symbolic link"}],
      "examples": ["\"/tmp/mylink\" os::readlink! -> target"]
    },
    {
      "name": "rename",
      "signature": "(oldpath:str newpath:str -- )",
      "failable": true,
      "description": "Rename or move a file.",
      "params": [{"name": "oldpath", "type": "str", "description": "Current path"}, {"name": "newpath", "type": "str", "description": "New path"}],
      "returns": [],
      "errors": [{"code": "ErrNotFound", "description": "File not found"}, {"code": "ErrPermission", "description": "Permission denied"}],
      "examples": ["\"old.txt\" \"new.txt\" os::rename!"]
    },
    {
      "name": "rmdir",
      "signature": "(path:str -- )",
      "failable": true,
      "description": "Remove directory and all contents recursively.",
      "params": [{"name": "path", "type": "str", "description": "Directory path to remove"}],
      "returns": [],
      "errors": [{"code": "ErrNotFound", "description": "Path not found"}, {"code": "ErrPermission", "description": "Permission denied"}],
      "examples": ["\"/tmp/mydir\" os::rmdir!"]
    },
    {
      "name": "setenv",
      "signature": "(name:str value:str -- )",
      "failable": false,
      "description": "Set environment variable.",
      "params": [{"name": "name", "type": "str", "description": "Variable name"}, {"name": "value", "type": "str", "description": "Variable value"}],
      "returns": [],
      "errors": [],
      "examples": ["\"MY_VAR\" \"hello\" os::setenv"]
    },
    {
      "name": "symlink",
      "signature": "(target:str linkpath:str -- )",
      "failable": true,
      "description": "Create a symbolic link.",
      "params": [{"name": "target", "type": "str", "description": "Path that the link points to"}, {"name": "linkpath", "type": "str", "description": "Path where the link will be created"}],
      "returns": [],
      "errors": [{"code": "ErrExists", "description": "Link path already exists"}, {"code": "ErrPermission", "description": "Permission denied"}],
      "examples": ["\"/usr/bin/python3\" \"/tmp/python\" os::symlink!"]
    },
    {
      "name": "system",
      "signature": "(cmd:str -- exitcode:i64)",
      "failable": false,
      "description": "Execute a shell command.",
      "params": [{"name": "cmd", "type": "str", "description": "Command to execute"}],
      "returns": [{"name": "exitcode", "type": "i64", "description": "Command exit status"}],
      "errors": [],
      "examples": ["\"ls -la\" os::system -> code"]
    },
    {
      "name": "unsetenv",
      "signature": "(name:str -- )",
      "failable": false,
      "description": "Unset environment variable.",
      "params": [{"name": "name", "type": "str", "description": "Variable name to remove"}],
      "returns": [],
      "errors": [],
      "examples": ["\"MY_VAR\" os::unsetenv"]
    },
    {
      "name": "walk",
      "signature": "(path:str callback:ptr -- )",
      "failable": true,
      "description": "Walk a directory tree recursively. Calls callback for each file and directory.",
      "params": [{"name": "path", "type": "str", "description": "Directory path to walk"}, {"name": "callback", "type": "ptr", "description": "Callback function (path:str is_dir:i64 depth:i64 -- )"}],
      "returns": [],
      "errors": [{"code": "ErrNotFound", "description": "Path not found"}, {"code": "ErrNotDirectory", "description": "Path is not a directory"}],
      "examples": ["\"/tmp\" fn (p:str is_dir:i64 depth:i64 -- ) { p print nl } os::walk!"]
    }
  ]
}
