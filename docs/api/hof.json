{
  "name": "hof",
  "description": "Higher-order function combinators for functional programming. Provides function application, conditional combinators, and array operations (fold, map, filter, etc.).",
  "constants": [],
  "structs": [],
  "functions": [
    {
      "name": "apply",
      "signature": "(x:i64 f:ptr -- r:i64)",
      "failable": false,
      "description": "Apply a function to a value.",
      "params": [
        {"name": "x", "type": "i64", "description": "Input value"},
        {"name": "f", "type": "ptr", "description": "Function pointer (i64 -- i64)"}
      ],
      "returns": [{"name": "r", "type": "i64", "description": "Result of f(x)"}],
      "errors": [],
      "examples": ["5 fn (x:i64 -- r:i64) { 2 * } hof::apply"]
    },
    {
      "name": "bi",
      "signature": "(x:i64 f:ptr g:ptr -- a:i64 b:i64)",
      "failable": false,
      "description": "Apply two functions to the same value.",
      "params": [
        {"name": "x", "type": "i64", "description": "Input value"},
        {"name": "f", "type": "ptr", "description": "First function (i64 -- i64)"},
        {"name": "g", "type": "ptr", "description": "Second function (i64 -- i64)"}
      ],
      "returns": [
        {"name": "a", "type": "i64", "description": "Result of f(x)"},
        {"name": "b", "type": "i64", "description": "Result of g(x)"}
      ],
      "errors": [],
      "examples": ["5 fn (x:i64 -- r:i64) { 2 * } fn (x:i64 -- r:i64) { 3 + } hof::bi"]
    },
    {
      "name": "tri",
      "signature": "(x:i64 f:ptr g:ptr h:ptr -- a:i64 b:i64 c:i64)",
      "failable": false,
      "description": "Apply three functions to the same value.",
      "params": [
        {"name": "x", "type": "i64", "description": "Input value"},
        {"name": "f", "type": "ptr", "description": "First function (i64 -- i64)"},
        {"name": "g", "type": "ptr", "description": "Second function (i64 -- i64)"},
        {"name": "h", "type": "ptr", "description": "Third function (i64 -- i64)"}
      ],
      "returns": [
        {"name": "a", "type": "i64", "description": "Result of f(x)"},
        {"name": "b", "type": "i64", "description": "Result of g(x)"},
        {"name": "c", "type": "i64", "description": "Result of h(x)"}
      ],
      "errors": [],
      "examples": ["5 fn (x:i64 -- r:i64) { 1 + } fn (x:i64 -- r:i64) { 2 * } fn (x:i64 -- r:i64) { dup * } hof::tri"]
    },
    {
      "name": "keep",
      "signature": "(x:i64 f:ptr -- r:i64 orig:i64)",
      "failable": false,
      "description": "Apply a function but keep the original value on the stack.",
      "params": [
        {"name": "x", "type": "i64", "description": "Input value"},
        {"name": "f", "type": "ptr", "description": "Function pointer (i64 -- i64)"}
      ],
      "returns": [
        {"name": "r", "type": "i64", "description": "Result of f(x)"},
        {"name": "orig", "type": "i64", "description": "Original value (preserved)"}
      ],
      "errors": [],
      "examples": ["5 fn (x:i64 -- r:i64) { 2 * } hof::keep  // Stack: 10 5"]
    },
    {
      "name": "dip",
      "signature": "(x:i64 y:i64 f:ptr -- r:i64 top:i64)",
      "failable": false,
      "description": "Apply a function to the second stack element, preserving the top.",
      "params": [
        {"name": "x", "type": "i64", "description": "Second element (will have f applied)"},
        {"name": "y", "type": "i64", "description": "Top element (preserved)"},
        {"name": "f", "type": "ptr", "description": "Function pointer (i64 -- i64)"}
      ],
      "returns": [
        {"name": "r", "type": "i64", "description": "Result of f(x)"},
        {"name": "top", "type": "i64", "description": "Original top value (preserved)"}
      ],
      "errors": [],
      "examples": ["10 20 fn (x:i64 -- r:i64) { 2 * } hof::dip  // Stack: 20 20"]
    },
    {
      "name": "both",
      "signature": "(x:i64 y:i64 f:ptr -- a:i64 b:i64)",
      "failable": false,
      "description": "Apply the same function to two values separately.",
      "params": [
        {"name": "x", "type": "i64", "description": "First value"},
        {"name": "y", "type": "i64", "description": "Second value"},
        {"name": "f", "type": "ptr", "description": "Function pointer (i64 -- i64)"}
      ],
      "returns": [
        {"name": "a", "type": "i64", "description": "Result of f(x)"},
        {"name": "b", "type": "i64", "description": "Result of f(y)"}
      ],
      "errors": [],
      "examples": ["3 4 fn (x:i64 -- r:i64) { dup * } hof::both  // Stack: 9 16"]
    },
    {
      "name": "bi_star",
      "signature": "(x:i64 y:i64 f:ptr g:ptr -- a:i64 b:i64)",
      "failable": false,
      "description": "Apply different functions to two values (f to x, g to y).",
      "params": [
        {"name": "x", "type": "i64", "description": "First value"},
        {"name": "y", "type": "i64", "description": "Second value"},
        {"name": "f", "type": "ptr", "description": "Function for first value (i64 -- i64)"},
        {"name": "g", "type": "ptr", "description": "Function for second value (i64 -- i64)"}
      ],
      "returns": [
        {"name": "a", "type": "i64", "description": "Result of f(x)"},
        {"name": "b", "type": "i64", "description": "Result of g(y)"}
      ],
      "errors": [],
      "examples": ["3 4 fn (x:i64 -- r:i64) { 1 + } fn (x:i64 -- r:i64) { 2 * } hof::bi_star"]
    },
    {
      "name": "when",
      "signature": "(x:i64 cond:i64 f:ptr -- r:i64)",
      "failable": false,
      "description": "Apply function only if condition is true, otherwise return value unchanged.",
      "params": [
        {"name": "x", "type": "i64", "description": "Input value"},
        {"name": "cond", "type": "i64", "description": "Condition (0 = false, non-zero = true)"},
        {"name": "f", "type": "ptr", "description": "Function pointer (i64 -- i64)"}
      ],
      "returns": [{"name": "r", "type": "i64", "description": "f(x) if cond is true, otherwise x"}],
      "errors": [],
      "examples": ["5 1 fn (x:i64 -- r:i64) { 2 * } hof::when  // 10"]
    },
    {
      "name": "unless",
      "signature": "(x:i64 cond:i64 f:ptr -- r:i64)",
      "failable": false,
      "description": "Apply function only if condition is false, otherwise return value unchanged.",
      "params": [
        {"name": "x", "type": "i64", "description": "Input value"},
        {"name": "cond", "type": "i64", "description": "Condition (0 = false, non-zero = true)"},
        {"name": "f", "type": "ptr", "description": "Function pointer (i64 -- i64)"}
      ],
      "returns": [{"name": "r", "type": "i64", "description": "f(x) if cond is false, otherwise x"}],
      "errors": [],
      "examples": ["5 0 fn (x:i64 -- r:i64) { 2 * } hof::unless  // 10"]
    },
    {
      "name": "times",
      "signature": "(x:i64 n:i64 f:ptr -- r:i64)",
      "failable": false,
      "description": "Apply function n times to a value.",
      "params": [
        {"name": "x", "type": "i64", "description": "Initial value"},
        {"name": "n", "type": "i64", "description": "Number of times to apply"},
        {"name": "f", "type": "ptr", "description": "Function pointer (i64 -- i64)"}
      ],
      "returns": [{"name": "r", "type": "i64", "description": "Result after n applications"}],
      "errors": [],
      "examples": ["1 4 fn (x:i64 -- r:i64) { 2 * } hof::times  // 16"]
    },
    {
      "name": "fold",
      "signature": "(arr:ptr count:i64 init:i64 f:ptr -- result:i64)",
      "failable": false,
      "description": "Fold/reduce an array left-to-right with a binary function.",
      "params": [
        {"name": "arr", "type": "ptr", "description": "Array pointer"},
        {"name": "count", "type": "i64", "description": "Array length"},
        {"name": "init", "type": "i64", "description": "Initial accumulator value"},
        {"name": "f", "type": "ptr", "description": "Binary function (acc:i64 elem:i64 -- acc:i64)"}
      ],
      "returns": [{"name": "result", "type": "i64", "description": "Final accumulated value"}],
      "errors": [],
      "examples": ["arr count 0 fn (acc:i64 x:i64 -- r:i64) { + } hof::fold  // sum"]
    },
    {
      "name": "fold_right",
      "signature": "(arr:ptr count:i64 init:i64 f:ptr -- result:i64)",
      "failable": false,
      "description": "Fold/reduce an array right-to-left with a binary function.",
      "params": [
        {"name": "arr", "type": "ptr", "description": "Array pointer"},
        {"name": "count", "type": "i64", "description": "Array length"},
        {"name": "init", "type": "i64", "description": "Initial accumulator value"},
        {"name": "f", "type": "ptr", "description": "Binary function (elem:i64 acc:i64 -- acc:i64)"}
      ],
      "returns": [{"name": "result", "type": "i64", "description": "Final accumulated value"}],
      "errors": [],
      "examples": ["arr count 0 fn (x:i64 acc:i64 -- r:i64) { + } hof::fold_right"]
    },
    {
      "name": "map",
      "signature": "(arr:ptr count:i64 f:ptr -- result:ptr out_count:i64)",
      "failable": false,
      "description": "Map a function over an array, returning a new array. The caller must free the result.",
      "params": [
        {"name": "arr", "type": "ptr", "description": "Input array pointer"},
        {"name": "count", "type": "i64", "description": "Array length"},
        {"name": "f", "type": "ptr", "description": "Function pointer (i64 -- i64)"}
      ],
      "returns": [
        {"name": "result", "type": "ptr", "description": "New array with mapped values"},
        {"name": "out_count", "type": "i64", "description": "Array length (same as input)"}
      ],
      "errors": [],
      "examples": ["arr count fn (x:i64 -- r:i64) { 2 * } hof::map -> count -> result"]
    },
    {
      "name": "filter",
      "signature": "(arr:ptr count:i64 pred:ptr -- result:ptr out_count:i64)",
      "failable": false,
      "description": "Filter an array, keeping only elements that satisfy a predicate. The caller must free the result.",
      "params": [
        {"name": "arr", "type": "ptr", "description": "Input array pointer"},
        {"name": "count", "type": "i64", "description": "Array length"},
        {"name": "pred", "type": "ptr", "description": "Predicate function (i64 -- i64)"}
      ],
      "returns": [
        {"name": "result", "type": "ptr", "description": "New array with matching elements"},
        {"name": "out_count", "type": "i64", "description": "Length of filtered array"}
      ],
      "errors": [],
      "examples": ["arr count fn (x:i64 -- r:i64) { 2 % 0 == } hof::filter -> count -> result"]
    },
    {
      "name": "any",
      "signature": "(arr:ptr count:i64 pred:ptr -- result:i64)",
      "failable": false,
      "description": "Check if any element in the array satisfies a predicate.",
      "params": [
        {"name": "arr", "type": "ptr", "description": "Array pointer"},
        {"name": "count", "type": "i64", "description": "Array length"},
        {"name": "pred", "type": "ptr", "description": "Predicate function (i64 -- i64)"}
      ],
      "returns": [{"name": "result", "type": "i64", "description": "1 if any element satisfies pred, 0 otherwise"}],
      "errors": [],
      "examples": ["arr count fn (x:i64 -- r:i64) { 0 > } hof::any"]
    },
    {
      "name": "all",
      "signature": "(arr:ptr count:i64 pred:ptr -- result:i64)",
      "failable": false,
      "description": "Check if all elements in the array satisfy a predicate.",
      "params": [
        {"name": "arr", "type": "ptr", "description": "Array pointer"},
        {"name": "count", "type": "i64", "description": "Array length"},
        {"name": "pred", "type": "ptr", "description": "Predicate function (i64 -- i64)"}
      ],
      "returns": [{"name": "result", "type": "i64", "description": "1 if all elements satisfy pred, 0 otherwise"}],
      "errors": [],
      "examples": ["arr count fn (x:i64 -- r:i64) { 0 > } hof::all"]
    },
    {
      "name": "find",
      "signature": "(arr:ptr count:i64 pred:ptr -- elem:i64 found:i64)",
      "failable": false,
      "description": "Find the first element satisfying a predicate.",
      "params": [
        {"name": "arr", "type": "ptr", "description": "Array pointer"},
        {"name": "count", "type": "i64", "description": "Array length"},
        {"name": "pred", "type": "ptr", "description": "Predicate function (i64 -- i64)"}
      ],
      "returns": [
        {"name": "elem", "type": "i64", "description": "Found element (or 0 if not found)"},
        {"name": "found", "type": "i64", "description": "1 if found, 0 otherwise"}
      ],
      "errors": [],
      "examples": ["arr count fn (x:i64 -- r:i64) { 10 > } hof::find -> found -> elem"]
    }
  ]
}
