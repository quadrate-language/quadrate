{
  "name": "hof",
  "description": "Higher-Order Function combinators. Combinators are functions that combine or apply other functions in useful patterns. They enable functional programming without explicit temporary variables.",
  "constants": [

  ],
  "structs": [

  ],
  "functions": [
    {
      "name": "all",
      "signature": "(arr:[]i64 pred:fn(i64 -- i64) -- result:i64)",
      "failable": false,
      "description": "Check if all elements satisfy a predicate.",
      "params": [{"name": "arr", "type": "[]i64", "description": "Array"}, {"name": "pred", "type": "fn(i64 -- i64)", "description": "Predicate function (i64 -- bool:i64)"}],
      "returns": [{"name": "result", "type": "i64", "description": "1 if all elements satisfy pred, 0 otherwise"}],
      "errors": [],
      "examples": ["arr fn (x:i64 -- r:i64) { 0 > } hof::all  // all positive?"]
    },
    {
      "name": "any",
      "signature": "(arr:[]i64 pred:fn(i64 -- i64) -- result:i64)",
      "failable": false,
      "description": "Check if any element satisfies a predicate.",
      "params": [{"name": "arr", "type": "[]i64", "description": "Array"}, {"name": "pred", "type": "fn(i64 -- i64)", "description": "Predicate function (i64 -- bool:i64)"}],
      "returns": [{"name": "result", "type": "i64", "description": "1 if any element satisfies pred, 0 otherwise"}],
      "errors": [],
      "examples": ["arr fn (x:i64 -- r:i64) { 0 > } hof::any  // any positive?"]
    },
    {
      "name": "apply",
      "signature": "(x:i64 f:fn(i64 -- i64) -- r:i64)",
      "failable": false,
      "description": "Apply a function to a value.",
      "params": [{"name": "x", "type": "i64", "description": "The input value"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function (i64 -- i64)"}],
      "returns": [{"name": "r", "type": "i64", "description": "Result of f(x)"}],
      "errors": [],
      "examples": ["5 fn (x:i64 -- r:i64) { 2 * } hof::apply print nl  // 10"]
    },
    {
      "name": "bi_star",
      "signature": "(x:i64 y:i64 f:fn(i64 -- i64) g:fn(i64 -- i64) -- a:i64 b:i64)",
      "failable": false,
      "description": "Apply two functions to two values (first to first, second to second).",
      "params": [{"name": "x", "type": "i64", "description": "First value"}, {"name": "y", "type": "i64", "description": "Second value"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function for first value (i64 -- i64)"}, {"name": "g", "type": "fn(i64 -- i64)", "description": "Function for second value (i64 -- i64)"}],
      "returns": [{"name": "a", "type": "i64", "description": "Result of f(x)"}, {"name": "b", "type": "i64", "description": "Result of g(y)"}],
      "errors": [],
      "examples": ["3 4 fn (x:i64 -- r:i64) { 1 + } fn (x:i64 -- r:i64) { 2 * } hof::bi_star  // Stack: 4 8"]
    },
    {
      "name": "bi",
      "signature": "(x:i64 f:fn(i64 -- i64) g:fn(i64 -- i64) -- a:i64 b:i64)",
      "failable": false,
      "description": "Apply two functions to the same value.",
      "params": [{"name": "x", "type": "i64", "description": "The input value"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "First function (i64 -- i64)"}, {"name": "g", "type": "fn(i64 -- i64)", "description": "Second function (i64 -- i64)"}],
      "returns": [{"name": "a", "type": "i64", "description": "Result of f(x)"}, {"name": "b", "type": "i64", "description": "Result of g(x)"}],
      "errors": [],
      "examples": ["5 fn (x:i64 -- r:i64) { 2 * } fn (x:i64 -- r:i64) { 3 + } hof::bi  // Stack: 10 8"]
    },
    {
      "name": "both",
      "signature": "(x:i64 y:i64 f:fn(i64 -- i64) -- a:i64 b:i64)",
      "failable": false,
      "description": "Apply a function to two values separately.",
      "params": [{"name": "x", "type": "i64", "description": "First value"}, {"name": "y", "type": "i64", "description": "Second value"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function (i64 -- i64)"}],
      "returns": [{"name": "a", "type": "i64", "description": "Result of f(x)"}, {"name": "b", "type": "i64", "description": "Result of f(y)"}],
      "errors": [],
      "examples": ["3 4 fn (x:i64 -- r:i64) { dup * } hof::both  // Stack: 9 16"]
    },
    {
      "name": "dip",
      "signature": "(x:i64 y:i64 f:fn(i64 -- i64) -- r:i64 top:i64)",
      "failable": false,
      "description": "Apply a function to the second stack element, preserving the top.",
      "params": [{"name": "x", "type": "i64", "description": "Second element (will have f applied)"}, {"name": "y", "type": "i64", "description": "Top element (preserved)"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function (i64 -- i64)"}],
      "returns": [{"name": "r", "type": "i64", "description": "Result of f(x)"}, {"name": "y", "type": "i64", "description": "Original top value (preserved)"}],
      "errors": [],
      "examples": ["10 20 fn (x:i64 -- r:i64) { 2 * } hof::dip  // Stack: 20 20"]
    },
    {
      "name": "filter",
      "signature": "(arr:[]i64 pred:fn(i64 -- i64) -- result:[]i64)",
      "failable": false,
      "description": "Filter an array, keeping only elements that satisfy a predicate.",
      "params": [{"name": "arr", "type": "[]i64", "description": "Input array"}, {"name": "pred", "type": "fn(i64 -- i64)", "description": "Predicate function (i64 -- bool:i64)"}],
      "returns": [{"name": "result", "type": "[]i64", "description": "New array with filtered values"}],
      "errors": [],
      "examples": ["arr fn (x:i64 -- r:i64) { 2 mod 0 == } hof::filter  // keep evens"]
    },
    {
      "name": "find",
      "signature": "(arr:[]i64 pred:fn(i64 -- i64) -- elem:i64 found:i64)",
      "failable": false,
      "description": "Find the first element satisfying a predicate.",
      "params": [{"name": "arr", "type": "[]i64", "description": "Array"}, {"name": "pred", "type": "fn(i64 -- i64)", "description": "Predicate function (i64 -- bool:i64)"}],
      "returns": [{"name": "elem", "type": "i64", "description": "The found element (or 0 if not found)"}, {"name": "found", "type": "i64", "description": "1 if found, 0 otherwise"}],
      "errors": [],
      "examples": ["arr fn (x:i64 -- r:i64) { 10 > } hof::find  // first > 10"]
    },
    {
      "name": "fold",
      "signature": "(arr:[]i64 acc:i64 f:fn(i64 i64 -- i64) -- result:i64)",
      "failable": false,
      "description": "Fold/reduce an array left-to-right with a binary function.",
      "params": [{"name": "arr", "type": "[]i64", "description": "Array"}, {"name": "init", "type": "i64", "description": "Initial accumulator value"}, {"name": "f", "type": "fn(i64 i64 -- i64)", "description": "Binary function (acc:i64 elem:i64 -- acc:i64)"}],
      "returns": [{"name": "result", "type": "i64", "description": "Final accumulated value"}],
      "errors": [],
      "examples": ["arr 0 fn (acc:i64 x:i64 -- r:i64) { + } hof::fold  // sum of array"]
    },
    {
      "name": "fold_right",
      "signature": "(arr:[]i64 acc:i64 f:fn(i64 i64 -- i64) -- result:i64)",
      "failable": false,
      "description": "Fold/reduce an array right-to-left with a binary function.",
      "params": [{"name": "arr", "type": "[]i64", "description": "Array"}, {"name": "init", "type": "i64", "description": "Initial accumulator value"}, {"name": "f", "type": "fn(i64 i64 -- i64)", "description": "Binary function (elem:i64 acc:i64 -- acc:i64)"}],
      "returns": [{"name": "result", "type": "i64", "description": "Final accumulated value"}],
      "errors": [],
      "examples": ["arr 0 fn (x:i64 acc:i64 -- r:i64) { + } hof::fold_right  // sum of array"]
    },
    {
      "name": "keep",
      "signature": "(x:i64 f:fn(i64 -- i64) -- r:i64 orig:i64)",
      "failable": false,
      "description": "Apply a function but keep the original value.",
      "params": [{"name": "x", "type": "i64", "description": "The input value"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function (i64 -- i64)"}],
      "returns": [{"name": "r", "type": "i64", "description": "Result of f(x)"}, {"name": "x", "type": "i64", "description": "Original value (preserved)"}],
      "errors": [],
      "examples": ["5 fn (x:i64 -- r:i64) { 2 * } hof::keep  // Stack: 10 5"]
    },
    {
      "name": "map",
      "signature": "(arr:[]i64 f:fn(i64 -- i64) -- result:[]i64)",
      "failable": false,
      "description": "Map a function over an array, returning a new array.",
      "params": [{"name": "arr", "type": "[]i64", "description": "Input array"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function (i64 -- i64)"}],
      "returns": [{"name": "result", "type": "[]i64", "description": "New array with mapped values"}],
      "errors": [],
      "examples": ["arr fn (x:i64 -- r:i64) { 2 * } hof::map  // double each element"]
    },
    {
      "name": "times",
      "signature": "(x:i64 n:i64 f:fn(i64 -- i64) -- r:i64)",
      "failable": false,
      "description": "Apply function n times to an initial value.",
      "params": [{"name": "x", "type": "i64", "description": "Initial value"}, {"name": "n", "type": "i64", "description": "Number of times to apply"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function (i64 -- i64)"}],
      "returns": [{"name": "r", "type": "i64", "description": "Result after n applications"}],
      "errors": [],
      "examples": ["2 4 fn (x:i64 -- r:i64) { dup * } hof::times print nl  // 65536 (2^16)"]
    },
    {
      "name": "tri",
      "signature": "(x:i64 f:fn(i64 -- i64) g:fn(i64 -- i64) h:fn(i64 -- i64) -- a:i64 b:i64 c:i64)",
      "failable": false,
      "description": "Apply three functions to the same value.",
      "params": [{"name": "x", "type": "i64", "description": "The input value"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "First function (i64 -- i64)"}, {"name": "g", "type": "fn(i64 -- i64)", "description": "Second function (i64 -- i64)"}, {"name": "h", "type": "fn(i64 -- i64)", "description": "Third function (i64 -- i64)"}],
      "returns": [{"name": "a", "type": "i64", "description": "Result of f(x)"}, {"name": "b", "type": "i64", "description": "Result of g(x)"}, {"name": "c", "type": "i64", "description": "Result of h(x)"}],
      "errors": [],
      "examples": ["5 fn (x:i64 -- r:i64) { 1 + } fn (x:i64 -- r:i64) { 2 * } fn (x:i64 -- r:i64) { dup * } hof::tri  // Stack: 6 10 25"]
    },
    {
      "name": "unless",
      "signature": "(x:i64 cond:i64 f:fn(i64 -- i64) -- r:i64)",
      "failable": false,
      "description": "Apply function only if condition is false, otherwise return value unchanged.",
      "params": [{"name": "x", "type": "i64", "description": "The input value"}, {"name": "cond", "type": "i64", "description": "Condition (0 = false, non-zero = true)"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function (i64 -- i64)"}],
      "returns": [{"name": "r", "type": "i64", "description": "Result of f(x) if cond is false, otherwise x"}],
      "errors": [],
      "examples": ["5 0 fn (x:i64 -- r:i64) { 2 * } hof::unless print nl  // 10", "5 1 fn (x:i64 -- r:i64) { 2 * } hof::unless print nl  // 5"]
    },
    {
      "name": "when",
      "signature": "(x:i64 cond:i64 f:fn(i64 -- i64) -- r:i64)",
      "failable": false,
      "description": "Apply function only if condition is true, otherwise return value unchanged.",
      "params": [{"name": "x", "type": "i64", "description": "The input value"}, {"name": "cond", "type": "i64", "description": "Condition (0 = false, non-zero = true)"}, {"name": "f", "type": "fn(i64 -- i64)", "description": "Function (i64 -- i64)"}],
      "returns": [{"name": "r", "type": "i64", "description": "Result of f(x) if cond is true, otherwise x"}],
      "errors": [],
      "examples": ["5 1 fn (x:i64 -- r:i64) { 2 * } hof::when print nl  // 10", "5 0 fn (x:i64 -- r:i64) { 2 * } hof::when print nl  // 5"]
    }
  ]
}
