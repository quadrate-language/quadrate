    {
      "name": "clear",
      "signature": "(signum:i64 -- )",
      "failable": false,
      "description": "Clear the pending flag for a signal.",
      "params": [{"name": "signum", "type": "i64", "description": "Signal number"}],
      "returns": [],
      "errors": [],
      "examples": ["signal::SigInt signal::clear"]
    },
    {
      "name": "ignore",
      "signature": "(signum:i64 -- )",
      "failable": false,
      "description": "Ignore the specified signal completely.",
      "params": [{"name": "signum", "type": "i64", "description": "Signal number"}],
      "returns": [],
      "errors": [],
      "examples": ["signal::SigPipe signal::ignore"]
    },
    {
      "name": "kill",
      "signature": "(pid:i64 signum:i64 -- result:i64)",
      "failable": false,
      "description": "Send a signal to another process.",
      "params": [{"name": "pid", "type": "i64", "description": "Process ID to signal"}, {"name": "signum", "type": "i64", "description": "Signal number to send"}],
      "returns": [{"name": "result", "type": "i64", "description": "0 on success, -1 on error"}],
      "errors": [],
      "examples": ["1234 signal::SigTerm signal::kill drop"]
    },
    {
      "name": "pending",
      "signature": "(signum:i64 -- flag:i64)",
      "failable": false,
      "description": "Check if a signal is pending (received but not cleared). Returns 1 if pending, 0 otherwise. Does not clear the flag.",
      "params": [{"name": "signum", "type": "i64", "description": "Signal number"}],
      "returns": [{"name": "flag", "type": "i64", "description": "1 if pending, 0 otherwise"}],
      "errors": [],
      "examples": ["signal::SigInt signal::pending"]
    },
    {
      "name": "raise",
      "signature": "(signum:i64 -- result:i64)",
      "failable": false,
      "description": "Send a signal to the current process.",
      "params": [{"name": "signum", "type": "i64", "description": "Signal number to send"}],
      "returns": [{"name": "result", "type": "i64", "description": "0 on success, -1 on error"}],
      "errors": [],
