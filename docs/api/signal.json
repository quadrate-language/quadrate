    {
      "name": "pending",
      "signature": "(signum:i64 -- flag:i64)",
      "failable": false,
      "description": "Check if a signal is pending (received but not cleared). Returns 1 if pending, 0 otherwise. Does not clear the flag.",
      "params": [{"name": "signum", "type": "i64", "description": "Signal number"}],
      "returns": [{"name": "flag", "type": "i64", "description": "1 if pending, 0 otherwise"}],
      "errors": [],
      "examples": ["signal::SigInt signal::pending"]
    },
    {
      "name": "reset",
      "signature": "(signum:i64 -- )",
      "failable": false,
      "description": "Reset signal to default behavior.",
      "params": [{"name": "signum", "type": "i64", "description": "Signal number"}],
      "returns": [],
      "errors": [],
      "examples": ["signal::SigInt signal::reset"]
    },
    {
      "name": "trap",
      "signature": "(signum:i64 -- )",
      "failable": false,
      "description": "Install a handler to catch the specified signal. After trapping, the signal sets a pending flag instead of causing the default action (e.g., termination).",
      "params": [{"name": "signum", "type": "i64", "description": "Signal number (use signal::SigInt, etc.)"}],
      "returns": [],
      "errors": [],
      "examples": ["signal::SigInt signal::trap"]
    },
    {
      "name": "wait",
      "signature": "( -- signum:i64)",
      "failable": false,
      "description": "Block until any trapped signal is received. Returns the signal number that was received.",
      "params": [],
      "returns": [{"name": "signum", "type": "i64", "description": "The signal that was received"}],
      "errors": [],
      "examples": ["signal::wait -> sig"]
