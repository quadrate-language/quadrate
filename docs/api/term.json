  "functions": [
    {
      "name": "bg256",
      "signature": "(n:i64 -- s:str)",
      "failable": false,
      "description": "Set background to 256-color palette value (0-255).",
      "params": [{"name": "n", "type": "i64", "description": "Color index (0-255)"}],
      "returns": [{"name": "s", "type": "str", "description": "ANSI escape sequence"}],
      "errors": [],
      "examples": ["21 term::bg256 print \"Blue BG\" print term::Reset print nl"]
    },
    {
      "name": "bg_rgb",
      "signature": "(r:i64 g:i64 b:i64 -- s:str)",
      "failable": false,
      "description": "Set background to RGB color.",
      "params": [{"name": "r", "type": "i64", "description": "Red component (0-255)"}, {"name": "g", "type": "i64", "description": "Green component (0-255)"}, {"name": "b", "type": "i64", "description": "Blue component (0-255)"}],
      "returns": [{"name": "s", "type": "str", "description": "ANSI escape sequence"}],
      "errors": [],
      "examples": ["0 0 128 term::bg_rgb print \"Navy BG\" print term::Reset print nl"]
    },
