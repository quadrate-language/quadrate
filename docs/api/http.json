  "structs": [
    {
      "name": "Ctx",
      "description": "HTTP Context structure (for server handlers). Passed to route handlers, contains request data and response methods. Fields:   method - GET, POST, PUT, DELETE, etc.   path - /users/123 (path without query string)   query - Raw query string (foo=bar&baz=qux)   headers - Request headers   body - Request body   params - Path parameters as \"key=val\\nkey2=val2\"   _socket - Internal: client socket   _responded - Internal: response sent flag",
      "fields": [
        {"name": "method", "type": "str", "description": ""},
        {"name": "path", "type": "str", "description": ""},
        {"name": "query", "type": "str", "description": ""},
        {"name": "headers", "type": "str", "description": ""},
        {"name": "body", "type": "str", "description": ""},
        {"name": "params", "type": "str", "description": ""},
        {"name": "_socket", "type": "i64", "description": ""},
        {"name": "_responded", "type": "i64", "description": ""}
      ]
    },
    {
      "name": "Response",
      "description": "HTTP Response structure (for client)",
      "fields": [
        {"name": "status", "type": "i64", "description": ""},
        {"name": "headers", "type": "str", "description": ""},
        {"name": "body", "type": "str", "description": ""}
      ]
    }
  ],
  "functions": [
    {
      "name": "abort",
      "signature": "(c:Ctx status:i64 body:str -- )",
      "failable": false,
      "description": "Abort request processing and send error response. Prevents further middleware/handlers from running.",
      "params": [{"name": "c", "type": "Ctx", "description": "Context"}, {"name": "status", "type": "i64", "description": "HTTP status code"}, {"name": "body", "type": "str", "description": "Error message"}],
      "returns": [],
      "errors": [],
      "examples": ["c 401 \"Unauthorized\" http::abort"]
    },
    {
