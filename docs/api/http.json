    {
      "name": "Response",
      "description": "HTTP response structure",
      "fields": [
        {"name": "status", "type": "i64", "description": "HTTP status code (200, 404, etc.)"},
        {"name": "headers", "type": "str", "description": "Response headers as string"},
        {"name": "body", "type": "str", "description": "Response body content"}
      ]
    }
  ],
  "functions": [
    {
      "name": "new",
      "signature": "(url:str -- req:ptr)",
      "failable": false,
      "description": "Create new HTTP request builder.",
      "params": [{"name": "url", "type": "str", "description": "The request URL (http:// or https://)"}],
      "returns": [{"name": "req", "type": "ptr", "description": "Request object"}],
      "errors": [],
      "examples": ["\"https://example.com\" http::new -> req"]
    },
    {
      "name": "method",
      "signature": "(req:ptr method:str -- )",
      "failable": false,
      "description": "Set request HTTP method.",
      "params": [
        {"name": "req", "type": "ptr", "description": "Request object"},
        {"name": "method", "type": "str", "description": "HTTP method (GET, POST, PUT, DELETE, etc.)"}
      ],
      "returns": [],
      "errors": [],
      "examples": ["req \"POST\" http::method"]
    },
    {
      "name": "header",
      "signature": "(req:ptr name:str value:str -- )",
      "failable": false,
      "description": "Add request header.",
      "params": [
        {"name": "req", "type": "ptr", "description": "Request object"},
        {"name": "name", "type": "str", "description": "Header name"},
        {"name": "value", "type": "str", "description": "Header value"}
      ],
      "returns": [],
      "errors": [],
      "examples": ["req \"Content-Type\" \"application/json\" http::header"]
    },
    {
      "name": "body",
      "signature": "(req:ptr body:str -- )",
      "failable": false,
      "description": "Set request body.",
      "params": [
        {"name": "req", "type": "ptr", "description": "Request object"},
        {"name": "body", "type": "str", "description": "Request body content"}
      ],
      "returns": [],
      "errors": [],
      "examples": ["req \"data\" http::body"]
    },
    {
      "name": "send",
      "signature": "(req:ptr -- resp:Response)",
      "failable": true,
      "description": "Execute HTTP request.",
      "params": [{"name": "req", "type": "ptr", "description": "Request object"}],
      "returns": [{"name": "resp", "type": "Response", "description": "Response struct with status, headers, body"}],
      "errors": ["ErrConnect", "ErrTls", "ErrTimeout", "ErrParse", "ErrInvalidUrl", "ErrSend", "ErrReceive"],
      "examples": ["req http::send! -> resp  resp @status print"]
    },
    {
      "name": "get",
      "signature": "(url:str -- resp:Response)",
      "failable": true,
      "description": "Simple GET request.",
      "params": [{"name": "url", "type": "str", "description": "The request URL"}],
      "returns": [{"name": "resp", "type": "Response", "description": "Response struct"}],
      "errors": ["ErrConnect", "ErrTls", "ErrTimeout", "ErrParse", "ErrInvalidUrl"],
      "examples": ["\"https://example.com\" http::get! -> resp"]
    },
    {
      "name": "free_request",
      "signature": "(req:ptr -- )",
      "failable": false,
      "description": "Free request object (call after send).",
      "params": [{"name": "req", "type": "ptr", "description": "Request object"}],
      "returns": [],
      "errors": [],
      "examples": ["req http::free_request"]
