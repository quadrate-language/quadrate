      "signature": "(arr:ptr count:i64 needle:i64 cmp:fn(i64 i64 -- i64)",
      "failable": false,
      "description": "Find the index of the first element not ordered before `needle` (binary search lower bound). The array must already be sorted by the same comparator. Returns `count` when every element sorts before `needle`.",
      "params": [{"name": "arr", "type": "ptr", "description": "Array of i64 values, sorted by `cmp`"}, {"name": "count", "type": "i64", "description": "Number of elements"}, {"name": "needle", "type": "i64", "description": "Value to locate"}, {"name": "cmp", "type": "fn", "description": "Comparator (a b -- ordering)"}],
      "returns": [{"name": "idx", "type": "i64", "description": "Index of the first element not ordered before `needle`"}],
      "errors": [],
      "examples": ["arr count 42 &ascending sort::lower_bound_by print nl"]
