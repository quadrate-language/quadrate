    {
      "name": "search",
      "signature": "(arr:ptr count:i64 needle:i64 -- idx:i64)",
      "failable": false,
      "description": "Binary search for a value in a sorted array. The array must be sorted in ascending order. Returns the index of the element if found, or -1 if not found.",
