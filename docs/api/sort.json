    {
      "name": "is_sorted",
      "signature": "(arr:ptr count:i64 -- sorted:i64)",
      "failable": false,
      "description": "Check if an array is sorted in ascending order. Returns 1 if sorted, 0 otherwise. Arrays with 0 or 1 elements are always sorted.",
      "params": [
        {"name": "arr", "type": "ptr", "description": "Array of i64 values"},
        {"name": "count", "type": "i64", "description": "Number of elements"}
      ],
      "returns": [{"name": "sorted", "type": "i64", "description": "1 if sorted ascending, 0 otherwise"}],
      "errors": [],
