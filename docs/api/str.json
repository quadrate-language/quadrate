    {
      "name": "from_char",
      "signature": "(char_code:i64 -- str:str)",
      "failable": false,
      "description": "Create string from character code.",
      "params": [{"name": "char_code", "type": "i64", "description": "ASCII/UTF-8 byte value"}],
      "returns": [{"name": "str", "type": "str", "description": "Single character string"}],
      "errors": [],
      "examples": ["65 str::from_char print  // \"A\""]
