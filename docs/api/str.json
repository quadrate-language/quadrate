{
  "name": "str",
  "description": "String manipulation functions. Error codes: Ok=1 (success), specific errors start at 2",
  "constants": [
    {
      "name": "ErrAlloc",
      "value": "3",
      "description": "Error: Memory allocation failed."
    },
    {
      "name": "ErrInvalidArg",
      "value": "4",
      "description": "Error: Invalid argument."
    },
    {
      "name": "ErrOutOfBounds",
      "value": "2",
      "description": "Error: Index out of bounds."
    }
  ],
  "structs": [

  ],
  "functions": [
    {
      "name": "char_at",
      "signature": "(str:str index:i64 -- char_code:i64)",
      "failable": false,
      "description": "Get character code at index.",
      "params": [{"name": "str", "type": "str", "description": "Input string"}, {"name": "index", "type": "i64", "description": "Character position"}],
      "returns": [{"name": "char_code", "type": "i64", "description": "ASCII/UTF-8 byte value"}],
      "errors": [],
      "examples": ["\"hello\" 0 str::char_at! print  // 104 ('h')"]
    },
    {
      "name": "compare",
      "signature": "(str1:str str2:str -- result:i64)",
      "failable": false,
      "description": "Compare two strings lexicographically.",
      "params": [{"name": "str1", "type": "str", "description": "First string"}, {"name": "str2", "type": "str", "description": "Second string"}],
      "returns": [{"name": "result", "type": "i64", "description": "<0 if str1<str2, 0 if equal, >0 if str1>str2"}],
      "errors": [],
      "examples": ["\"abc\" \"abd\" str::compare print  // -1"]
    },
    {
      "name": "concat",
      "signature": "(str1:str str2:str -- result:str)",
      "failable": false,
      "description": "Concatenate two strings.",
      "params": [{"name": "str1", "type": "str", "description": "First string"}, {"name": "str2", "type": "str", "description": "Second string"}],
      "returns": [{"name": "result", "type": "str", "description": "Combined string"}],
      "errors": [],
      "examples": ["\"hello\" \" world\" str::concat print  // \"hello world\""]
    },
    {
