import "libstdstrconvqd_static.a" as "strconv" {
	// Integer formatting/parsing with explicit base
	pub fn format_int(value:i64 base:i64 -- str:str)
	pub fn parse_int(str:str base:i64 -- value:i64)

	// Convenience functions for base 10
	pub fn itoa(value:i64 -- str:str)
	pub fn atoi(str:str -- value:i64)
}
