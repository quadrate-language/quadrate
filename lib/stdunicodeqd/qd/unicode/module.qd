// Unicode character constants for Quadrate
//
// Provides named constants for common Unicode code points.
//
// Usage:
//   use unicode
//   unicode::A . nl          // prints 65
//   char unicode::newline == // check if char is newline

// Control characters (0-31)
pub const nul = 0
pub const tab = 9
pub const newline = 10
pub const cr = 13
pub const esc = 27

// Printable ASCII (32-126)
pub const space = 32
pub const exclaim = 33
pub const dquote = 34
pub const hash = 35
pub const dollar = 36
pub const percent = 37
pub const ampersand = 38
pub const squote = 39
pub const lparen = 40
pub const rparen = 41
pub const asterisk = 42
pub const plus = 43
pub const comma = 44
pub const minus = 45
pub const dot = 46
pub const slash = 47

// Digits (48-57)
pub const digit0 = 48
pub const digit1 = 49
pub const digit2 = 50
pub const digit3 = 51
pub const digit4 = 52
pub const digit5 = 53
pub const digit6 = 54
pub const digit7 = 55
pub const digit8 = 56
pub const digit9 = 57

pub const colon = 58
pub const semicolon = 59
pub const lt = 60
pub const equals = 61
pub const gt = 62
pub const question = 63
pub const at = 64

// Uppercase letters (65-90)
pub const A = 65
pub const B = 66
pub const C = 67
pub const D = 68
pub const E = 69
pub const F = 70
pub const G = 71
pub const H = 72
pub const I = 73
pub const J = 74
pub const K = 75
pub const L = 76
pub const M = 77
pub const N = 78
pub const O = 79
pub const P = 80
pub const Q = 81
pub const R = 82
pub const S = 83
pub const T = 84
pub const U = 85
pub const V = 86
pub const W = 87
pub const X = 88
pub const Y = 89
pub const Z = 90

pub const lbracket = 91
pub const backslash = 92
pub const rbracket = 93
pub const caret = 94
pub const underscore = 95
pub const backtick = 96

// Lowercase letters (97-122)
pub const a = 97
pub const b = 98
pub const c = 99
pub const d = 100
pub const e = 101
pub const f = 102
pub const g = 103
pub const h = 104
pub const i = 105
pub const j = 106
pub const k = 107
pub const l = 108
pub const m = 109
pub const n = 110
pub const o = 111
pub const p = 112
pub const q = 113
pub const r = 114
pub const s = 115
pub const t = 116
pub const u = 117
pub const v = 118
pub const w = 119
pub const x = 120
pub const y = 121
pub const z = 122

pub const lbrace = 123
pub const pipe = 124
pub const rbrace = 125
pub const tilde = 126

// Character classification functions

// Check if character code is a digit (0-9)
pub fn is_digit(c:i64 -- result:i64) {
	-> c
	c digit0 >= c digit9 <= *
}
