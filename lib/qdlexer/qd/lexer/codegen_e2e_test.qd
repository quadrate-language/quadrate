use strings
use sb
use "lexer.qd"
use "ast.qd"
use "parser.qd"
use "codegen.qd"
fn main() {
	"fn main() {\n\t0 5 1 for i {\n\t\ti print nl\n\t}\n\t2 switch {\n\t\t1 { \"one\" print nl }\n\t\t2 { \"two\" print nl }\n\t\t_ { \"other\" print nl }\n\t}\n}" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir print
}
