/// Textual LLVM IR emitter for Quadrate.
/// Walks the AST and produces .ll text that can be compiled with llc + clang.
use strings
use strconv
use sb
use "ast.qd"

// Codegen state passed through all emit functions
pub struct CgState {
	globals:ptr      // sb for global declarations (strings, etc.)
	code:ptr         // sb for function code
	counter:i64      // shared counter for strings and labels
}

pub fn new_state( -- s:CgState) {
	CgState {
		globals = sb::new
		code = sb::new
		counter = 0
	}
}

// Add a string constant and return its IR name (@.str.N)
fn add_string(s:ptr text:str -- s2:ptr name:str) {
	-> raw -> st
	st @counter -> n
	n 1 + st.counter

	// Build name: @.str.N
	sb::new -> snb  snb "@.str." sb::append -> snb  snb n sb::append_int -> snb  snb sb::finish -> sname

	// Strip quotes from the raw text if present
	raw -> content
	raw strings::len -> rlen
	rlen 2 >= if {
		raw 0 strings::char_at! -> fc
		fc 34 == if {
			// Remove surrounding quotes
			raw 1 rlen 2 - strings::substring! -> content
		}
	}

	// Process escape sequences: \n → \0A, \t → \09, etc. for LLVM IR
	sb::new -> esc
	0 -> real_bytes
	0 -> ei
	content strings::len -> clen
	ei clen < while {
		content ei strings::char_at! -> ch
		0 -> did_escape
		ch 92 == if {
			ei 1 + clen < if {
				content ei 1 + strings::char_at! -> ech
				ech 110 == if { esc "\\0A" sb::append -> esc  1 -> did_escape }
				ech 116 == did_escape 0 == and if { esc "\\09" sb::append -> esc  1 -> did_escape }
				ech 114 == did_escape 0 == and if { esc "\\0D" sb::append -> esc  1 -> did_escape }
				ech 92 == did_escape 0 == and if { esc "\\5C" sb::append -> esc  1 -> did_escape }
				ech 34 == did_escape 0 == and if { esc "\\22" sb::append -> esc  1 -> did_escape }
				ech 48 == did_escape 0 == and if { esc "\\00" sb::append -> esc  1 -> did_escape }
				ech 101 == did_escape 0 == and if { esc "\\1B" sb::append -> esc  1 -> did_escape }
				did_escape if {
					real_bytes 1 + -> real_bytes
					ei 2 + -> ei
				} else {
					esc "\\5C" sb::append -> esc
					real_bytes 1 + -> real_bytes
					ei 1 + -> ei
				}
			} else {
				esc "\\5C" sb::append -> esc
				real_bytes 1 + -> real_bytes
				ei 1 + -> ei
			}
		} else {
			esc ch sb::append_char -> esc
			real_bytes 1 + -> real_bytes
			ei 1 + -> ei
		}
		ei clen <
	}
	esc sb::finish -> escaped
	real_bytes 1 + -> arr_size  // +1 for null terminator

	// Emit global: @.str.N = private unnamed_addr constant [len+1 x i8] c"...\00"
	st @globals -> g
	g sname sb::append -> g
	g " = private unnamed_addr constant [" sb::append -> g
	g arr_size sb::append_int -> g
	g " x i8] c\"" sb::append -> g
	g escaped sb::append -> g
	g "\\00\"\n" sb::append -> g
	g st.globals

	st sname
}

// Get a unique label
fn next_label(s:ptr -- s2:ptr name:str) {
	-> st
	st @counter -> n
	n 1 + st.counter
	sb::new -> lnb  lnb "L" sb::append -> lnb  lnb n sb::append_int -> lnb  st lnb sb::finish
}

// Collect local variable names from a block (recursive)
// Returns comma-separated string: ",x,y,z,"
fn collect_locals(node:ptr result:ptr -- result2:ptr) {
	-> buf -> n
	n null == if { buf return }
	n @nkind ast::NodeType::LocalDecl == if {
		buf "," sb::append -> buf
		buf n @ntext sb::append -> buf
		buf "," sb::append -> buf
	}
	n @nkind ast::NodeType::ForStmt == if {
		buf "," sb::append -> buf
		buf n @ntext sb::append -> buf
		buf "," sb::append -> buf
	}
	// Recurse into children
	n @child1 null neq if { n @child1 buf collect_locals -> buf }
	n @child2 null neq if { n @child2 buf collect_locals -> buf }
	n @child3 null neq if { n @child3 buf collect_locals -> buf }
	n @child4 null neq if { n @child4 buf collect_locals -> buf }
	n @extra -> cur
	cur null neq while {
		cur buf collect_locals -> buf
		cur @sibling -> cur
		cur null neq
	}
	buf
}

// Convert integer to string (for use in $"..." which expects strings)
fn i2s(n:i64 -- s:str) {
	-> v
	sb::new -> b  b v sb::append_int -> b  b sb::finish
}

// Check if a name is in the locals string
fn is_local(locals:str name:str -- result:i64) {
	-> n -> ls
	sb::new -> ndb
	ndb "," sb::append -> ndb
	ndb n sb::append -> ndb
	ndb "," sb::append -> ndb
	ndb sb::finish -> needle
	ls needle strings::contains
}

// Extract function prefix from the locals string (stored as "~prefix!" in loc)
fn get_prefix(locals:str -- prefix:str) {
	-> ls
	ls "~" strings::index_of -> idx
	idx 0 >= if {
		idx 1 + -> pstart
		// Find end of prefix (next ! or end)
		pstart -> pend
		ls strings::len -> lslen
		pend lslen < while {
			ls pend strings::char_at! 33 == if { break }
			pend 1 + -> pend
			pend lslen <
		}
		ls pstart pend pstart - strings::substring!
	} else {
		"usr_main_"
	}
}

// Collect UNIQUE local names from AST and emit allocas.
// Uses collect_locals to get all names (with duplicates), then deduplicates.
// skip_name: if non-empty, skip this name (already allocated, e.g. receiver)
fn emit_unique_allocas(s:ptr body:ptr skip_name:str -- s2:ptr) {
	-> skip -> bnode -> st
	bnode null == if { st return }
	bnode sb::new collect_locals sb::finish -> all_locals
	all_locals strings::len 2 < if { st return }
	// all_locals is ",x,y,x,z," format — deduplicate
	st @code -> o
	// Pre-seed seen with skip_name if provided
	"" -> seen
	skip strings::len 0 > if {
		"," skip strings::concat "," strings::concat -> seen
	}
	// Walk each name between commas (skip leading comma)
	1 -> pos
	all_locals strings::len -> alen
	pos alen < while {
		// Find next comma
		pos -> end
		end alen < while {
			all_locals end strings::char_at! 44 == if { break }
			end 1 + -> end
			end alen <
		}
		end pos > if {
			all_locals pos end pos - strings::substring! -> vn
			"," vn strings::concat "," strings::concat -> ck
			seen ck strings::contains 0 == if {
				o $"  %local.{vn} = alloca %qd_stack_element_t\n" sb::append -> o
				seen ck strings::concat -> seen
			}
		}
		end 1 + -> pos
		pos alen <
	}
	o st.code
	st
}

// Collect struct field types from a program AST.
// Format: "!@fieldname=typename!" (@ prefix distinguishes from constants)
// StructField has ntext=fieldname and child1=Ident(typename).
pub fn collect_field_types(node:ptr buf:ptr -- buf2:ptr) {
	-> out -> n
	n null == if { out return }
	n @nkind -> nk
	nk ast::NodeType::StructField == if {
		n @child1 null neq if {
			n @ntext -> fname
			n @child1 @ntext -> ftype
			sb::new -> ftkey
			ftkey "!@" sb::append -> ftkey
			ftkey fname sb::append -> ftkey
			ftkey "=" sb::append -> ftkey
			ftkey sb::build -> ftkeystr
			out sb::build ftkeystr strings::contains 0 == if {
				out "!@" sb::append -> out
				out fname sb::append -> out
				out "=" sb::append -> out
				out ftype sb::append -> out
			}
		}
	}
	// Only recurse into structural nodes (Program, StructDecl, StructField)
	nk ast::NodeType::Program == nk ast::NodeType::StructDecl == or
	nk ast::NodeType::StructField == or nk ast::NodeType::FnDecl == or
	nk ast::NodeType::Block == or nk ast::NodeType::ImportDecl == or
	nk ast::NodeType::UseStmt == or if {
		n @child1 null neq if { n @child1 out collect_field_types -> out }
		n @child2 null neq if { n @child2 out collect_field_types -> out }
		n @child3 null neq if { n @child3 out collect_field_types -> out }
		n @child4 null neq if { n @child4 out collect_field_types -> out }
		n @extra -> cur
		cur null neq while {
			cur out collect_field_types -> out
			cur @sibling -> cur
			cur null neq
		}
	}
	out
}

// Collect all constants from a program AST into a registry string.
// Format: "!name=value!name2=value2!" (! delimited, = separates name from value)
pub fn collect_constants(node:ptr buf:ptr -- buf2:ptr) {
	-> out -> n
	n null == if { out return }
	n @nkind ast::NodeType::ConstDecl == if {
		n @child1 null neq if {
			n @ntext -> cname
			n @child1 @ntext -> cval
			// Convert hex to decimal
			n @child1 @nkind ast::NodeType::IntLit == if {
				cval strings::len 2 > if {
					cval 0 strings::char_at! 48 == if {
						cval 1 strings::char_at! -> xc
						xc 120 == xc 88 == or if {
							cval 16 strconv::parse_int! -> hv
							sb::new -> hb
							hb hv sb::append_int -> hb
							hb sb::finish -> cval
						}
					}
				}
			}
			out "!" sb::append -> out
			out cname sb::append -> out
			out "=" sb::append -> out
			out cval sb::append -> out
		}
	}
	// Only recurse into top-level containers (not deep expression trees)
	n @nkind -> nk2
	nk2 ast::NodeType::Program == nk2 ast::NodeType::Block == or
	nk2 ast::NodeType::FnDecl == or nk2 ast::NodeType::ConstDecl == or
	nk2 ast::NodeType::EnumDecl == or nk2 ast::NodeType::ImportDecl == or if {
		n @child1 null neq if { n @child1 out collect_constants -> out }
		n @child2 null neq if { n @child2 out collect_constants -> out }
		n @child3 null neq if { n @child3 out collect_constants -> out }
		n @child4 null neq if { n @child4 out collect_constants -> out }
	}
	n @extra -> cur
	cur null neq while {
		cur out collect_constants -> out
		cur @sibling -> cur
		cur null neq
	}
	out
}

// Look up a constant by name in the constants registry.
// Returns the value string, or "" if not found.
fn lookup_constant(consts:str name:str -- val:str) {
	-> n -> cs
	cs strings::len 0 == if { "" return }
	// Search for !name= pattern
	sb::new -> nb
	nb "!" sb::append -> nb
	nb n sb::append -> nb
	nb "=" sb::append -> nb
	nb sb::finish -> needle
	cs needle strings::index_of -> idx
	idx 0 < if { "" return }
	// Found — extract value (from after = to next ! or end)
	idx needle strings::len + -> vstart
	vstart -> vend
	cs strings::len -> cslen
	vend cslen < while {
		cs vend strings::char_at! 33 == if { break }
		vend 1 + -> vend
		vend cslen <
	}
	cs vstart vend vstart - strings::substring!
}

// Look up a field's type from the constants registry.
// Field types are stored as "!@fieldname=typename!" in the registry.
fn lookup_field_type(consts:str name:str -- typename:str) {
	-> n -> cs
	sb::new -> nb
	nb "!@" sb::append -> nb
	nb n sb::append -> nb
	nb "=" sb::append -> nb
	nb sb::finish -> needle
	cs needle strings::index_of -> idx
	idx 0 < if { "i64" return }  // default to i64
	idx needle strings::len + -> vstart
	vstart -> vend
	cs strings::len -> cslen
	vend cslen < while {
		cs vend strings::char_at! 33 == if { break }  // stop at !
		vend 1 + -> vend
		vend cslen <
	}
	cs vstart vend vstart - strings::substring!
}

// Emit a single AST node
fn emit_node(s:ptr node:ptr locals:str -- s2:ptr) {
	-> loc -> n -> st
	n null == if { st return }
	st @code -> o
	n @nkind -> k

	// Integer literal
	k ast::NodeType::IntLit == if {
		o "  call i32 @qd_push_i(ptr %ctx, i64 " sb::append -> o
		n @ntext -> val
		// Convert hex literals (0x...) to decimal for LLVM IR
		val strings::len 2 > if {
			val 0 strings::char_at! 48 == if {
				val 1 strings::char_at! -> xch
				xch 120 == xch 88 == or if {
					val 16 strconv::parse_int! -> hexval
					sb::new -> hb
					hb hexval sb::append_int -> hb
					hb sb::finish -> val
				}
			}
		}
		val "true" strings::compare 0 == val "Ok" strings::compare 0 == or if {
			o "1" sb::append -> o
		} else {
			val "false" strings::compare 0 == val "Err" strings::compare 0 == or
			val "null" strings::compare 0 == or if {
				o "0" sb::append -> o
			} else {
				o val sb::append -> o
			}
		}
		o ")\n" sb::append -> o
		o st.code
		st return
	}

	// Float literal
	k ast::NodeType::FloatLit == if {
		o "  call i32 @qd_push_f(ptr %ctx, double " sb::append -> o
		o n @ntext sb::append -> o
		o ")\n" sb::append -> o
		o st.code
		st return
	}

	// String literal
	k ast::NodeType::StrLit == if {
		st n @ntext add_string -> sname -> st
		o "  call i32 @qd_push_s(ptr %ctx, ptr " sb::append -> o
		o sname sb::append -> o
		o ")\n" sb::append -> o
		o st.code
		st return
	}

	// Identifier (builtin, local variable push, or function call)
	k ast::NodeType::Ident == if {
		n @ntext -> fname
		// Built-in stack instructions
		fname "print" strings::compare 0 == if { o "  call i32 @qd_print(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "prints" strings::compare 0 == if { o "  call i32 @qd_print(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "nl" strings::compare 0 == if { o "  call i32 @qd_nl(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "dup" strings::compare 0 == if { o "  call i32 @qd_dup(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "drop" strings::compare 0 == if { o "  call i32 @qd_drop(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "swap" strings::compare 0 == if { o "  call i32 @qd_swap(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "over" strings::compare 0 == if { o "  call i32 @qd_over(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "rot" strings::compare 0 == if { o "  call i32 @qd_rot(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "nip" strings::compare 0 == if { o "  call i32 @qd_nip(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "len" strings::compare 0 == if { o "  call i32 @qd_len(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "free" strings::compare 0 == if { o "  call i32 @qd_free(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "panic" strings::compare 0 == if { o "  call i32 @qd_panic(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "err" strings::compare 0 == if { o "  call i32 @qd_err(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "and" strings::compare 0 == if { o "  call i32 @qd_and(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "or" strings::compare 0 == if { o "  call i32 @qd_or(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "not" strings::compare 0 == if { o "  call i32 @qd_not(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "neg" strings::compare 0 == if { o "  call i32 @qd_neg(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "tuck" strings::compare 0 == if { o "  call i32 @qd_tuck(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "pick" strings::compare 0 == if { o "  call i32 @qd_pick(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "roll" strings::compare 0 == if { o "  call i32 @qd_roll(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "neq" strings::compare 0 == if { o "  call i32 @qd_neq(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "eq" strings::compare 0 == if { o "  call i32 @qd_eq(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "lt" strings::compare 0 == if { o "  call i32 @qd_lt(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "gt" strings::compare 0 == if { o "  call i32 @qd_gt(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "lte" strings::compare 0 == if { o "  call i32 @qd_lte(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "gte" strings::compare 0 == if { o "  call i32 @qd_gte(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "add" strings::compare 0 == if { o "  call i32 @qd_add(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "sub" strings::compare 0 == if { o "  call i32 @qd_sub(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "mul" strings::compare 0 == if { o "  call i32 @qd_mul(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "div" strings::compare 0 == if { o "  call i32 @qd_div(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "mod" strings::compare 0 == if { o "  call i32 @qd_mod(ptr %ctx)\n" sb::append -> o  o st.code st return }
		fname "cast" strings::compare 0 == if { o st.code st return }  // no-op at runtime
		// Check if it looks like a local variable (lowercase first char, not a known builtin)
		// Emit: load value from alloca and push onto runtime stack
		// This relies on the variable being previously declared with -> name
		// Check if this identifier is a local variable
		loc fname is_local if {
			// Push local variable value onto runtime stack (preserves type tag)
			st next_label -> uid -> st
			st @code -> o
			o $"  %stp_{uid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
			o $"  %stk_{uid} = load ptr, ptr %stp_{uid}\n" sb::append -> o
			o $"  call i32 @qdrt_push_element(ptr %stk_{uid}, ptr %local.{fname})\n" sb::append -> o
			o st.code
			st return
		}
		// Check if it's a constant (lookup in the constants registry embedded in loc)
		loc fname lookup_constant -> cval
		cval strings::len 0 > if {
			o $"  call i32 @qd_push_i(ptr %ctx, i64 {cval})\n" sb::append -> o
			o st.code
			st return
		}
		// Function call (use current module prefix)
		loc get_prefix -> cur_pfx
		o "  call i32 @" sb::append -> o
		o cur_pfx sb::append -> o
		o fname sb::append -> o
		o "(ptr %ctx)\n" sb::append -> o
		o st.code
		st return
	}

	// Scoped identifier (module::func or Enum::Variant or module::Constant)
	k ast::NodeType::ScopedIdent == if {
		n @ntext -> scope
		n @child1 @ntext -> member
		// Check if scope looks like an enum (starts with uppercase)
		scope 0 strings::char_at! -> sc
		sc 65 >= sc 90 <= and if {
			// Enum variant — load from global constant
			st next_label -> uid -> st
			st @code -> o
			o $"  %ev_{uid} = load i64, ptr @__enum_{scope}_{member}\n" sb::append -> o
			o $"  call i32 @qd_push_i(ptr %ctx, i64 %ev_{uid})\n" sb::append -> o
			o st.code
			st return
		}
		// Check if member starts with uppercase (enum variant or module constant)
		member 0 strings::char_at! -> mc
		mc 65 >= mc 90 <= and if {
			// Check if it's a triple-scope enum variant (Enum::Variant)
			member "::" strings::contains if {
				// Replace :: with _ for the global name
				member "::" "_" strings::replace! -> enum_name
				st next_label -> uid -> st
				st @code -> o
				o $"  %ev_{uid} = load i64, ptr @__enum_{enum_name}\n" sb::append -> o
				o $"  call i32 @qd_push_i(ptr %ctx, i64 %ev_{uid})\n" sb::append -> o
				o st.code
				st return
			}
			// Module constant — load from global
			st next_label -> uid -> st
			st @code -> o
			o $"  %mc_{uid} = load i64, ptr @__const_{scope}_{member}\n" sb::append -> o
			o $"  call i32 @qd_push_i(ptr %ctx, i64 %mc_{uid})\n" sb::append -> o
			o st.code
			st return
		}
		// Check if member is a constant (look up in constants registry embedded in loc)
		loc member lookup_constant -> scval
		scval strings::len 0 > if {
			o $"  call i32 @qd_push_i(ptr %ctx, i64 {scval})\n" sb::append -> o
			o st.code
			st return
		}
		// Module function call: usr_module_func
		// Check and strip ! and ? suffixes (fallible markers)
		0 -> is_bang
		member strings::len -> mlen
		mlen 0 > if {
			member mlen 1 - strings::char_at! -> last_ch
			last_ch 33 == if { 1 -> is_bang  member 0 mlen 1 - strings::substring! -> member }
			last_ch 63 == if { member 0 mlen 1 - strings::substring! -> member }
		}
		o $"  call i32 @usr_{scope}_{member}(ptr %ctx)\n" sb::append -> o
		// Handle ! (abort on error): pop status code, abort if 0
		is_bang if {
			st next_label -> fuid -> st
			o $"  %fe_{fuid} = alloca %qd_stack_element_t\n" sb::append -> o
			o $"  %fstp_{fuid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
			o $"  %fstk_{fuid} = load ptr, ptr %fstp_{fuid}\n" sb::append -> o
			o $"  call void @qd_stack_pop(ptr %fstk_{fuid}, ptr %fe_{fuid})\n" sb::append -> o
			o $"  %fvp_{fuid} = getelementptr %qd_stack_element_t, ptr %fe_{fuid}, i32 0, i32 0\n" sb::append -> o
			o $"  %fvi_{fuid} = load i64, ptr %fvp_{fuid}\n" sb::append -> o
			o $"  %fok_{fuid} = icmp ne i64 %fvi_{fuid}, 0\n" sb::append -> o
			st next_label -> ok_label -> st
			st next_label -> fail_label -> st
			o $"  br i1 %fok_{fuid}, label %{ok_label}, label %{fail_label}\n" sb::append -> o
			o $"{fail_label}:\n" sb::append -> o
			o "  call i32 @qd_panic(ptr %ctx)\n" sb::append -> o
			o "  unreachable\n" sb::append -> o
			o $"{ok_label}:\n" sb::append -> o
		}
		o st.code
		st return
	}

	// Instruction (operator)
	k ast::NodeType::Instruction == if {
		n @ntext -> op
		op "+" strings::compare 0 == op "add" strings::compare 0 == or if { o "  call i32 @qd_add(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "-" strings::compare 0 == op "sub" strings::compare 0 == or if { o "  call i32 @qd_sub(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "*" strings::compare 0 == op "mul" strings::compare 0 == or if { o "  call i32 @qd_mul(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "/" strings::compare 0 == op "div" strings::compare 0 == or if { o "  call i32 @qd_div(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "%" strings::compare 0 == op "mod" strings::compare 0 == or if { o "  call i32 @qd_mod(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "==" strings::compare 0 == op "eq" strings::compare 0 == or if { o "  call i32 @qd_eq(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "!=" strings::compare 0 == op "neq" strings::compare 0 == or if { o "  call i32 @qd_neq(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "<" strings::compare 0 == op "lt" strings::compare 0 == or if { o "  call i32 @qd_lt(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op ">" strings::compare 0 == op "gt" strings::compare 0 == or if { o "  call i32 @qd_gt(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "<=" strings::compare 0 == op "lte" strings::compare 0 == or if { o "  call i32 @qd_lte(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op ">=" strings::compare 0 == op "gte" strings::compare 0 == or if { o "  call i32 @qd_gte(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "and" strings::compare 0 == if { o "  call i32 @qd_and(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "or" strings::compare 0 == if { o "  call i32 @qd_or(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "not" strings::compare 0 == if { o "  call i32 @qd_not(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "neg" strings::compare 0 == if { o "  call i32 @qd_neg(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "tuck" strings::compare 0 == if { o "  call i32 @qd_tuck(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "pick" strings::compare 0 == if { o "  call i32 @qd_pick(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "roll" strings::compare 0 == if { o "  call i32 @qd_roll(ptr %ctx)\n" sb::append -> o  o st.code st return }
		op "cast" strings::compare 0 == if { o st.code st return }  // cast is a no-op at runtime
		o "  ; TODO: instruction " sb::append -> o
		o op sb::append -> o
		o "\n" sb::append -> o
		o st.code
		st return
	}

	// Local variable declaration: -> name
	// Alloca is emitted at function entry by emit_unique_allocas
	k ast::NodeType::LocalDecl == if {
		n @ntext -> vname
		st next_label -> uid -> st
		st @code -> o
		o $"  %stp_{uid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
		o $"  %stk_{uid} = load ptr, ptr %stp_{uid}\n" sb::append -> o
		o $"  call void @qd_stack_pop(ptr %stk_{uid}, ptr %local.{vname})\n" sb::append -> o
		o st.code
		st return
	}

	// Block — recurse
	k ast::NodeType::Block == if {
		// Inline block iteration (avoids recursion depth for $"..." blocks)
		n @child1 null neq if { st n @child1 loc emit_node -> st }
		n @child2 null neq if { st n @child2 loc emit_node -> st }
		n @child3 null neq if { st n @child3 loc emit_node -> st }
		n @child4 null neq if { st n @child4 loc emit_node -> st }
		n @extra -> blkcur
		blkcur null neq while {
			st blkcur loc emit_node -> st
			blkcur @sibling -> blkcur
			blkcur null neq
		}
		st return
	}

	// If statement
	k ast::NodeType::IfStmt == if {
		st n loc emit_if return
	}

	// While loop
	k ast::NodeType::WhileStmt == if {
		st n loc emit_while return
	}

	// Loop (infinite)
	k ast::NodeType::LoopStmt == if {
		st n loc emit_loop return
	}

	// Switch statement
	k ast::NodeType::SwitchStmt == if {
		st n loc emit_switch return
	}

	// For loop
	k ast::NodeType::ForStmt == if {
		st n loc emit_for return
	}

	// Return statement
	k ast::NodeType::ReturnStmt == if {
		o "  br label %return\n" sb::append -> o
		o st.code
		st return
	}

	// Break statement
	k ast::NodeType::BreakStmt == if {
		// Extract current loop exit label from loc (#exit=LABEL) — use last for nesting
		loc "#exit=" strings::last_index_of -> bei
		"loop_exit" -> brk_lbl
		bei 0 >= if {
			bei 6 + -> bes
			bes -> bee
			loc strings::len -> bll
			bee bll < while {
				loc bee strings::char_at! 35 == if { break }  // stop at next #
				loc bee strings::char_at! 33 == if { break }  // stop at !
				loc bee strings::char_at! 126 == if { break } // stop at ~
				bee 1 + -> bee
				bee bll <
			}
			loc bes bee bes - strings::substring! -> brk_lbl
		}
		o "  br label %" sb::append -> o
		o brk_lbl sb::append -> o
		o "\n" sb::append -> o
		o st.code
		st return
	}

	// Continue statement
	k ast::NodeType::ContinueStmt == if {
		loc "#cond=" strings::last_index_of -> cei
		"loop_cond" -> cont_lbl
		cei 0 >= if {
			cei 6 + -> ces
			ces -> cee
			loc strings::len -> cll
			cee cll < while {
				loc cee strings::char_at! 35 == if { break }
				loc cee strings::char_at! 33 == if { break }
				loc cee strings::char_at! 126 == if { break }
				cee 1 + -> cee
				cee cll <
			}
			loc ces cee ces - strings::substring! -> cont_lbl
		}
		o "  br label %" sb::append -> o
		o cont_lbl sb::append -> o
		o "\n" sb::append -> o
		o st.code
		st return
	}

	// Field access: @fieldname — pop struct ptr, load field, push value
	// Uses struct layout stored in globals by emit_struct_decl
	k ast::NodeType::FieldAccess == if {
		st next_label -> uid -> st
		st @code -> o
		n @ntext -> fname
		// Pop struct pointer from stack
		o $"  %fa_elem_{uid} = alloca %qd_stack_element_t\n" sb::append -> o
		o $"  %fa_stp_{uid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
		o $"  %fa_stk_{uid} = load ptr, ptr %fa_stp_{uid}\n" sb::append -> o
		o $"  call void @qd_stack_pop(ptr %fa_stk_{uid}, ptr %fa_elem_{uid})\n" sb::append -> o
		// Load struct ptr value
		o $"  %fa_vp_{uid} = getelementptr %qd_stack_element_t, ptr %fa_elem_{uid}, i32 0, i32 0\n" sb::append -> o
		o $"  %fa_ptr_{uid} = load ptr, ptr %fa_vp_{uid}\n" sb::append -> o
		// Field offset from global (8 bytes per field)
		o $"  %fa_off_{uid} = load i64, ptr @__offset_{fname}\n" sb::append -> o
		o $"  %fa_fp_{uid} = getelementptr i8, ptr %fa_ptr_{uid}, i64 %fa_off_{uid}\n" sb::append -> o
		// Load value and push with type-appropriate function
		loc fname lookup_field_type -> ftype
		ftype "str" strings::compare 0 == if {
			o $"  %fa_val_{uid} = load ptr, ptr %fa_fp_{uid}\n" sb::append -> o
			o $"  call i32 @qd_push_s_ref(ptr %ctx, ptr %fa_val_{uid})\n" sb::append -> o
		} else {
			ftype "ptr" strings::compare 0 == ftype "*" strings::starts_with or if {
				o $"  %fa_val_{uid} = load ptr, ptr %fa_fp_{uid}\n" sb::append -> o
				o $"  call i32 @qd_push_p(ptr %ctx, ptr %fa_val_{uid})\n" sb::append -> o
			} else {
				ftype "f64" strings::compare 0 == if {
					o $"  %fa_val_{uid} = load double, ptr %fa_fp_{uid}\n" sb::append -> o
					o $"  call i32 @qd_push_f(ptr %ctx, double %fa_val_{uid})\n" sb::append -> o
				} else {
					// Default: i64
					o $"  %fa_val_{uid} = load i64, ptr %fa_fp_{uid}\n" sb::append -> o
					o $"  call i32 @qd_push_i(ptr %ctx, i64 %fa_val_{uid})\n" sb::append -> o
				}
			}
		}
		o st.code
		st return
	}

	// Field set: val var.field — pop value, load var (local), store at field offset
	k ast::NodeType::FieldSet == if {
		st next_label -> uid -> st
		st @code -> o
		n @ntext -> vname
		n @child1 @ntext -> fname
		// Pop value from stack
		o $"  %fs_elem_{uid} = alloca %qd_stack_element_t\n" sb::append -> o
		o $"  %fs_stp_{uid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
		o $"  %fs_stk_{uid} = load ptr, ptr %fs_stp_{uid}\n" sb::append -> o
		o $"  call void @qd_stack_pop(ptr %fs_stk_{uid}, ptr %fs_elem_{uid})\n" sb::append -> o
		o $"  %fs_vp_{uid} = getelementptr %qd_stack_element_t, ptr %fs_elem_{uid}, i32 0, i32 0\n" sb::append -> o
		o $"  %fs_val_{uid} = load i64, ptr %fs_vp_{uid}\n" sb::append -> o
		// Load struct pointer from local variable
		o $"  %fs_svp_{uid} = getelementptr %qd_stack_element_t, ptr %local.{vname}, i32 0, i32 0\n" sb::append -> o
		o $"  %fs_sptr_{uid} = load ptr, ptr %fs_svp_{uid}\n" sb::append -> o
		// Store 8-byte value into struct field
		o $"  %fs_off_{uid} = load i64, ptr @__offset_{fname}\n" sb::append -> o
		o $"  %fs_fp_{uid} = getelementptr i8, ptr %fs_sptr_{uid}, i64 %fs_off_{uid}\n" sb::append -> o
		o $"  store i64 %fs_val_{uid}, ptr %fs_fp_{uid}\n" sb::append -> o
		o st.code
		st return
	}

	// Struct construction: Name { field = value ... }
	k ast::NodeType::StructConstruct == if {
		st next_label -> uid -> st
		st @code -> o
		n @ntext -> sname
		// Allocate struct: load size from @__size_StructName, call qd_struct_alloc
		o $"  %sz_{uid} = load i64, ptr @__size_{sname}\n" sb::append -> o
		o $"  %sp_{uid} = call ptr @qd_struct_alloc(i64 %sz_{uid}, ptr null)\n" sb::append -> o
		o st.code
		// Write field values: iterate StructField children
		// Each StructField has ntext=fieldname, child1=value expression
		n @child1 null neq if { st n @child1 uid sname loc emit_struct_field -> st }
		n @child2 null neq if { st n @child2 uid sname loc emit_struct_field -> st }
		n @child3 null neq if { st n @child3 uid sname loc emit_struct_field -> st }
		n @child4 null neq if { st n @child4 uid sname loc emit_struct_field -> st }
		n @extra -> cur
		cur null neq while {
			st cur uid sname loc emit_struct_field -> st
			cur @sibling -> cur
			cur null neq
		}
		// Push struct pointer onto stack
		st @code -> o
		o $"  call i32 @qd_push_p(ptr %ctx, ptr %sp_{uid})\n" sb::append -> o
		o st.code
		st return
	}

	// Anything else
	k i2s -> ks
	o $"  ; TODO: node kind {ks}\n" sb::append -> o
	o st.code
	st
}

// Helper: emit an enum variant global constant
fn emit_enum_variant(g:ptr ename:str vname:str val:i64 -- g2:ptr) {
	-> v -> vn -> en -> buf
	v i2s -> vs
	buf $"@__enum_{en}_{vn} = private constant i64 {vs}\n" sb::append -> buf
	buf
}

// Helper: emit a struct field write (used during struct construction)
fn emit_struct_field(s:ptr field:ptr struct_uid:str struct_name:str locals:str -- s2:ptr) {
	-> loc -> sname -> suid -> fld -> st
	fld null == if { st return }
	fld @nkind ast::NodeType::StructField neq if { st return }
	fld @ntext -> fname

	// Evaluate ALL field value expressions (children of StructField)
	fld @child1 null neq if { st fld @child1 loc emit_node -> st }
	fld @child2 null neq if { st fld @child2 loc emit_node -> st }
	fld @child3 null neq if { st fld @child3 loc emit_node -> st }
	fld @child4 null neq if { st fld @child4 loc emit_node -> st }
	fld @extra -> fcur
	fcur null neq while {
		st fcur loc emit_node -> st
		fcur @sibling -> fcur
		fcur null neq
	}

	// Pop value from runtime stack
	st next_label -> uid -> st
	st @code -> o
	o $"  %sf_elem_{uid} = alloca %qd_stack_element_t\n" sb::append -> o
	o $"  %sf_stp_{uid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
	o $"  %sf_stk_{uid} = load ptr, ptr %sf_stp_{uid}\n" sb::append -> o
	o $"  call void @qd_stack_pop(ptr %sf_stk_{uid}, ptr %sf_elem_{uid})\n" sb::append -> o
	// Store the raw 8-byte value into the struct field
	o $"  %sf_vp_{uid} = getelementptr %qd_stack_element_t, ptr %sf_elem_{uid}, i32 0, i32 0\n" sb::append -> o
	o $"  %sf_val_{uid} = load i64, ptr %sf_vp_{uid}\n" sb::append -> o
	o $"  %sf_off_{uid} = load i64, ptr @__offset_{fname}\n" sb::append -> o
	o $"  %sf_fp_{uid} = getelementptr i8, ptr %sp_{suid}, i64 %sf_off_{uid}\n" sb::append -> o
	o $"  store i64 %sf_val_{uid}, ptr %sf_fp_{uid}\n" sb::append -> o
	// Retain reference-counted string values stored in struct fields
	loc fname lookup_field_type -> sftype
	sftype "str" strings::compare 0 == if {
		o $"  %sf_sptr_{uid} = inttoptr i64 %sf_val_{uid} to ptr\n" sb::append -> o
		o $"  call void @qd_string_retain(ptr %sf_sptr_{uid})\n" sb::append -> o
	}
	o st.code
	st
}

// Helper: emit pop-condition-and-branch pattern
fn emit_pop_cond(s:ptr uid:str -- s2:ptr) {
	-> id -> st
	st @code -> o
	o $"  %ce_{id} = alloca %qd_stack_element_t\n" sb::append -> o
	o $"  %stp_{id} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
	o $"  %stk_{id} = load ptr, ptr %stp_{id}\n" sb::append -> o
	o $"  call void @qd_stack_pop(ptr %stk_{id}, ptr %ce_{id})\n" sb::append -> o
	o $"  %cv_{id} = getelementptr %qd_stack_element_t, ptr %ce_{id}, i32 0, i32 0\n" sb::append -> o
	o $"  %ci_{id} = load i64, ptr %cv_{id}\n" sb::append -> o
	o $"  %cc_{id} = icmp ne i64 %ci_{id}, 0\n" sb::append -> o
	o st.code
	st
}

// Emit if/else
fn emit_if(s:ptr node:ptr locals:str -- s2:ptr) {
	-> loc -> n -> st
	st next_label -> uid -> st
	st next_label -> then_label -> st
	st next_label -> else_label -> st
	st next_label -> merge_label -> st

	st uid emit_pop_cond -> st
	st @code -> o

	n ast::child_count 2 >= if {
		o $"  br i1 %cc_{uid}, label %{then_label}, label %{else_label}\n" sb::append -> o
	} else {
		o $"  br i1 %cc_{uid}, label %{then_label}, label %{merge_label}\n" sb::append -> o
	}

	o $"{then_label}:\n" sb::append -> o  o st.code
	st n @child1 loc emit_block -> st
	st @code -> o
	o $"  br label %{merge_label}\n" sb::append -> o

	n ast::child_count 2 >= if {
		o $"{else_label}:\n" sb::append -> o  o st.code
		st n @child2 loc emit_block -> st
		st @code -> o
		o $"  br label %{merge_label}\n" sb::append -> o
	}

	o $"{merge_label}:\n" sb::append -> o  o st.code
	st
}

// Emit while loop
fn emit_while(s:ptr node:ptr locals:str -- s2:ptr) {
	-> loc -> n -> st
	st next_label -> uid -> st
	st next_label -> body_label -> st
	st next_label -> exit_label -> st
	st next_label -> cond_label -> st

	// Push loop labels into loc for break/continue
	loc $"#exit={exit_label}#cond={cond_label}" strings::concat -> loop_loc

	st @code -> o
	// Pop initial condition (already on stack from before 'while')
	st uid emit_pop_cond -> st
	st @code -> o
	o $"  br i1 %cc_{uid}, label %{body_label}, label %{exit_label}\n" sb::append -> o

	// Body
	o $"{body_label}:\n" sb::append -> o  o st.code
	st n @child1 loop_loc emit_block -> st

	// After body, pop new condition and loop back
	st @code -> o
	o $"  br label %{cond_label}\n" sb::append -> o
	o $"{cond_label}:\n" sb::append -> o
	st next_label -> uid2 -> st
	st uid2 emit_pop_cond -> st
	st @code -> o
	o $"  br i1 %cc_{uid2}, label %{body_label}, label %{exit_label}\n" sb::append -> o

	o $"{exit_label}:\n" sb::append -> o  o st.code
	st
}

// Emit infinite loop
fn emit_loop(s:ptr node:ptr locals:str -- s2:ptr) {
	-> loc -> n -> st
	st next_label -> body_label -> st
	st next_label -> exit_label -> st

	// Push loop labels into loc for break/continue
	loc $"#exit={exit_label}#cond={body_label}" strings::concat -> loop_loc

	st @code -> o
	o $"  br label %{body_label}\n" sb::append -> o
	o $"{body_label}:\n" sb::append -> o  o st.code

	st n @child1 loop_loc emit_block -> st

	st @code -> o
	o $"  br label %{body_label}\n" sb::append -> o
	o $"{exit_label}:\n" sb::append -> o  o st.code
	st
}

// Emit switch statement (simplified: chain of if-else comparisons)
fn emit_switch(s:ptr node:ptr locals:str -- s2:ptr) {
	-> loc -> n -> st
	st next_label -> uid -> st
	st next_label -> exit_label -> st

	// Pop switch value using emit_pop_cond — value is in %ci_uid
	st uid emit_pop_cond -> st

	// Emit case chain
	st n exit_label uid loc emit_switch_cases -> st

	st @code -> o
	o $"  br label %{exit_label}\n" sb::append -> o
	o $"{exit_label}:\n" sb::append -> o  o st.code
	st
}

// Emit switch case chain (iterates all children of switch node)
fn emit_switch_cases(s:ptr node:ptr exit:str sw_uid:str locals:str -- s2:ptr) {
	-> loc -> suid -> exit_label -> n -> st

	// Process each child (CaseClause or DefaultClause)
	n @child1 null neq if { st n @child1 exit_label suid loc emit_one_case -> st }
	n @child2 null neq if { st n @child2 exit_label suid loc emit_one_case -> st }
	n @child3 null neq if { st n @child3 exit_label suid loc emit_one_case -> st }
	n @child4 null neq if { st n @child4 exit_label suid loc emit_one_case -> st }
	n @extra -> cur
	cur null neq while {
		st cur exit_label suid loc emit_one_case -> st
		cur @sibling -> cur
		cur null neq
	}
	st
}

// Emit a single case or default clause
fn emit_one_case(s:ptr case_node:ptr exit:str sw_uid:str locals:str -- s2:ptr) {
	-> loc -> suid -> exit_label -> cn -> st
	cn null == if { st return }

	// Default clause: just emit body
	cn @nkind ast::NodeType::DefaultClause == if {
		cn @child1 null neq if { st cn @child1 loc emit_block -> st }
		st @code -> o
		o $"  br label %{exit_label}\n" sb::append -> o
		st next_label -> after -> st
		o $"{after}:\n" sb::append -> o  o st.code
		st return
	}

	// Case clause: child1=value, child2=body
	cn @nkind ast::NodeType::CaseClause == if {
		st next_label -> case_uid -> st
		st next_label -> body_label -> st
		st next_label -> next_label2 -> st
		st @code -> o

		// Evaluate case value — emit the value node, pop, compare with switch value
		o st.code
		st cn @child1 loc emit_node -> st
		// Pop case value
		st case_uid emit_pop_cond -> st
		st @code -> o
		// Compare: switch_val == case_val
		o $"  %cmp_{case_uid} = icmp eq i64 %ci_{suid}, %ci_{case_uid}\n" sb::append -> o
		o $"  br i1 %cmp_{case_uid}, label %{body_label}, label %{next_label2}\n" sb::append -> o

		// Body
		o $"{body_label}:\n" sb::append -> o  o st.code
		cn @child2 null neq if { st cn @child2 loc emit_block -> st }
		st @code -> o
		o $"  br label %{exit_label}\n" sb::append -> o

		// Next case
		o $"{next_label2}:\n" sb::append -> o  o st.code
		st return
	}

	st
}

// Emit for loop: start end step for var { body }
// The start/end/step values are already on the runtime stack (pushed before 'for')
fn emit_for(s:ptr node:ptr locals:str -- s2:ptr) {
	-> loc -> n -> st
	st next_label -> uid -> st
	st next_label -> body_label -> st
	st next_label -> exit_label -> st
	st next_label -> cond_label -> st
	n @ntext -> iter_var

	// Push loop labels into loc for break/continue
	loc $"#exit={exit_label}#cond={cond_label}" strings::concat -> loop_loc

	st @code -> o
	// Pop step, end, start from stack
	o $"  %for_step_e_{uid} = alloca %qd_stack_element_t\n" sb::append -> o
	o $"  %for_end_e_{uid} = alloca %qd_stack_element_t\n" sb::append -> o
	o $"  %for_start_e_{uid} = alloca %qd_stack_element_t\n" sb::append -> o
	// Note: %local.{iter_var} alloca is emitted at function entry by emit_unique_allocas
	// Get stack ptr
	o $"  %for_stp_{uid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
	o $"  %for_stk_{uid} = load ptr, ptr %for_stp_{uid}\n" sb::append -> o
	// Pop step, end, start
	o $"  call void @qd_stack_pop(ptr %for_stk_{uid}, ptr %for_step_e_{uid})\n" sb::append -> o
	o $"  call void @qd_stack_pop(ptr %for_stk_{uid}, ptr %for_end_e_{uid})\n" sb::append -> o
	o $"  call void @qd_stack_pop(ptr %for_stk_{uid}, ptr %for_start_e_{uid})\n" sb::append -> o
	// Load values
	o $"  %for_step_{uid} = load i64, ptr %for_step_e_{uid}\n" sb::append -> o
	o $"  %for_end_{uid} = load i64, ptr %for_end_e_{uid}\n" sb::append -> o
	o $"  %for_start_{uid} = load i64, ptr %for_start_e_{uid}\n" sb::append -> o
	// Initialize iterator — push as int then pop into local to set type tag correctly
	o $"  call i32 @qd_push_i(ptr %ctx, i64 %for_start_{uid})\n" sb::append -> o
	st next_label -> fiuid -> st
	o $"  %fistp_{fiuid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
	o $"  %fistk_{fiuid} = load ptr, ptr %fistp_{fiuid}\n" sb::append -> o
	o $"  call void @qd_stack_pop(ptr %fistk_{fiuid}, ptr %local.{iter_var})\n" sb::append -> o
	o $"  br label %{cond_label}\n" sb::append -> o

	// Condition: i < end — use runtime stack comparison
	o $"{cond_label}:\n" sb::append -> o
	st next_label -> fcuid -> st
	o $"  %fcstp_{fcuid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
	o $"  %fcstk_{fcuid} = load ptr, ptr %fcstp_{fcuid}\n" sb::append -> o
	o $"  call i32 @qdrt_push_element(ptr %fcstk_{fcuid}, ptr %local.{iter_var})\n" sb::append -> o
	o $"  call i32 @qd_push_i(ptr %ctx, i64 %for_end_{uid})\n" sb::append -> o
	o $"  call i32 @qd_lt(ptr %ctx)\n" sb::append -> o
	// Pop condition result
	o $"  %fcond_{fcuid} = alloca %qd_stack_element_t\n" sb::append -> o
	o $"  call void @qd_stack_pop(ptr %fcstk_{fcuid}, ptr %fcond_{fcuid})\n" sb::append -> o
	o $"  %fcv_{fcuid} = getelementptr %qd_stack_element_t, ptr %fcond_{fcuid}, i32 0, i32 0\n" sb::append -> o
	o $"  %fci_{fcuid} = load i64, ptr %fcv_{fcuid}\n" sb::append -> o
	o $"  %fcc_{fcuid} = icmp ne i64 %fci_{fcuid}, 0\n" sb::append -> o
	o $"  br i1 %fcc_{fcuid}, label %{body_label}, label %{exit_label}\n" sb::append -> o

	// Body
	o $"{body_label}:\n" sb::append -> o  o st.code
	st n @child1 loop_loc emit_block -> st
	st @code -> o

	// Increment: i += step
	// Load iterator value for increment
	o $"  %for_ivp_{uid} = getelementptr %qd_stack_element_t, ptr %local.{iter_var}, i32 0, i32 0\n" sb::append -> o
	o $"  %for_iv_{uid} = load i64, ptr %for_ivp_{uid}\n" sb::append -> o
	o $"  %for_next_{uid} = add i64 %for_iv_{uid}, %for_step_{uid}\n" sb::append -> o
	// Store incremented value with proper type tag
	o $"  call i32 @qd_push_i(ptr %ctx, i64 %for_next_{uid})\n" sb::append -> o
	st next_label -> fuuid -> st
	o $"  %fustp_{fuuid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
	o $"  %fustk_{fuuid} = load ptr, ptr %fustp_{fuuid}\n" sb::append -> o
	o $"  call void @qd_stack_pop(ptr %fustk_{fuuid}, ptr %local.{iter_var})\n" sb::append -> o
	o $"  br label %{cond_label}\n" sb::append -> o

	// Exit
	o $"{exit_label}:\n" sb::append -> o  o st.code
	st
}

// Emit a block — iterate all children
fn emit_block(s:ptr block:ptr locals:str -- s2:ptr) {
	-> loc -> blk -> st
	blk null == if { st return }
	blk @child1 null neq if { st blk @child1 loc emit_node -> st }
	blk @child2 null neq if { st blk @child2 loc emit_node -> st }
	blk @child3 null neq if { st blk @child3 loc emit_node -> st }
	blk @child4 null neq if { st blk @child4 loc emit_node -> st }
	blk @extra -> cur
	cur null neq while {
		st cur loc emit_node -> st
		cur @sibling -> cur
		cur null neq
	}
	st
}

// Emit a user function
// recv: receiver variable name (e.g., "p"), or "" for non-method functions
// consts: constants registry string (from collect_constants)
fn emit_function(s:ptr name:str body:ptr recv:str param_count:i64 consts:str prefix:str -- s2:ptr) {
	-> pfx -> cstr -> nparams -> recv_name -> body_node -> fname -> st

	// Collect local variable names from function body
	// Append constants string so emit_node can resolve constants
	"" -> loc
	body_node null neq if {
		body_node sb::new collect_locals -> locals_buf
		locals_buf sb::finish -> loc
	}
	// Store prefix first (before constants to avoid contamination)
	loc "~" strings::concat pfx strings::concat -> loc

	// Append constants to locals for threading through to emit_node
	loc cstr strings::concat "!" strings::concat -> loc

	// Add receiver to locals string so is_local recognizes it
	recv_name strings::len 0 > if {
		loc "," strings::concat recv_name strings::concat "," strings::concat -> loc
	}

	st @code -> o
	o "define i32 @" sb::append -> o
	o pfx sb::append -> o
	o fname sb::append -> o
	o "(ptr %ctx) {\n" sb::append -> o
	o "entry:\n" sb::append -> o
	// Emit receiver alloca + pop if this is a method
	// If the method has params, the receiver is below them on the stack.
	// Use qd_roll to bring it to the top before popping.
	recv_name strings::len 0 > if {
		o $"  %local.{recv_name} = alloca %qd_stack_element_t\n" sb::append -> o
		nparams 0 > if {
			// Roll receiver to top: push param_count, call qd_roll
			nparams i2s -> np_s
			o $"  call i32 @qd_push_i(ptr %ctx, i64 {np_s})\n" sb::append -> o
			o "  call i32 @qd_roll(ptr %ctx)\n" sb::append -> o
		}
		st next_label -> ruid -> st
		o $"  %rstp_{ruid} = getelementptr %qd_context_t, ptr %ctx, i32 0, i32 0\n" sb::append -> o
		o $"  %rstk_{ruid} = load ptr, ptr %rstp_{ruid}\n" sb::append -> o
		o $"  call void @qd_stack_pop(ptr %rstk_{ruid}, ptr %local.{recv_name})\n" sb::append -> o
	}
	o st.code
	// Pre-allocate all unique local variables at function entry
	// Skip receiver name to avoid duplicate alloca
	st body_node recv_name emit_unique_allocas -> st
	body_node null neq if { st body_node loc emit_block -> st }
	st @code -> o
	o "  br label %return\n" sb::append -> o
	o "return:\n" sb::append -> o
	o "  ret i32 0\n" sb::append -> o
	o "}\n\n" sb::append -> o
	o st.code
	st
}

// Emit a top-level declaration
fn emit_top_level(s:ptr node:ptr consts:str prefix:str -- s2:ptr) {
	-> pfx -> cstr -> n -> st
	n null == if { st return }
	n @nkind -> k
	k ast::NodeType::FnDecl == if {
		n @ntext -> fname
		"" -> recv_var
		// Check for method receiver — adjust function name to include receiver type
		// Receiver is child3 or child4 (depends on metadata presence)
		// Receiver Param node has ntext like "l:Lexer"
		n @child3 null neq if {
			n @child3 @nkind ast::NodeType::Param == if {
				n @child3 @ntext -> recv_text
				recv_text ":" strings::index_of -> colon_pos
				colon_pos 0 >= if {
					recv_text colon_pos 1 + recv_text strings::len colon_pos 1 + - strings::substring! -> recv_type
					recv_type "_" strings::concat fname strings::concat -> fname
					recv_text 0 colon_pos strings::substring! -> recv_var
				}
			}
		}
		n @child4 null neq if {
			n @child4 @nkind ast::NodeType::Param == if {
				n @child4 @ntext -> recv_text2
				recv_text2 ":" strings::index_of -> colon_pos2
				colon_pos2 0 >= if {
					recv_text2 colon_pos2 1 + recv_text2 strings::len colon_pos2 1 + - strings::substring! -> recv_type2
					recv_type2 "_" strings::concat fname strings::concat -> fname
					recv_text2 0 colon_pos2 strings::substring! -> recv_var
				}
			}
		}
		// Count INPUT parameters only (exclude output params prefixed with "out:")
		0 -> param_count
		n @child1 null neq if {
			n @child1 @child1 null neq if {
				n @child1 @child1 @ntext "out:" strings::starts_with 0 == if { param_count 1 + -> param_count }
			}
			n @child1 @child2 null neq if {
				n @child1 @child2 @ntext "out:" strings::starts_with 0 == if { param_count 1 + -> param_count }
			}
			n @child1 @child3 null neq if {
				n @child1 @child3 @ntext "out:" strings::starts_with 0 == if { param_count 1 + -> param_count }
			}
			n @child1 @child4 null neq if {
				n @child1 @child4 @ntext "out:" strings::starts_with 0 == if { param_count 1 + -> param_count }
			}
			n @child1 @extra -> pcur
			pcur null neq while {
				pcur @ntext "out:" strings::starts_with 0 == if { param_count 1 + -> param_count }
				pcur @sibling -> pcur
				pcur null neq
			}
		}
		st fname n @child2 recv_var param_count cstr pfx emit_function -> st
		// For methods, emit an unqualified wrapper so "c get" resolves
		recv_var strings::len 0 > if {
			n @ntext -> orig_name
			st @code -> o
			o "define i32 @" sb::append -> o
			o pfx sb::append -> o
			o orig_name sb::append -> o
			o "(ptr %ctx) {\n  %r = tail call i32 @" sb::append -> o
			o pfx sb::append -> o
			o fname sb::append -> o
			o "(ptr %ctx)\n  ret i32 %r\n}\n" sb::append -> o
			o st.code
		}
		st return
	}
	// Struct declaration — emit field offset globals and size constant
	k ast::NodeType::StructDecl == if {
		st @globals -> g
		n @ntext -> sname
		0 -> offset
		// Iterate fields — dedup by checking if @__offset_NAME already in globals
		n @child1 null neq if {
			n @child1 @ntext -> fn1
			$"@__offset_{fn1}" -> ocheck1
			offset i2s -> off_s
			g sb::build ocheck1 strings::contains 0 == if {
				g $"{ocheck1} = private constant i64 {off_s}\n" sb::append -> g
			}
			offset 8 + -> offset
		}
		n @child2 null neq if {
			n @child2 @ntext -> fn2
			$"@__offset_{fn2}" -> ocheck2
			offset i2s -> off_s
			g sb::build ocheck2 strings::contains 0 == if {
				g $"{ocheck2} = private constant i64 {off_s}\n" sb::append -> g
			}
			offset 8 + -> offset
		}
		n @child3 null neq if {
			n @child3 @ntext -> fn3
			$"@__offset_{fn3}" -> ocheck3
			offset i2s -> off_s
			g sb::build ocheck3 strings::contains 0 == if {
				g $"{ocheck3} = private constant i64 {off_s}\n" sb::append -> g
			}
			offset 8 + -> offset
		}
		n @child4 null neq if {
			n @child4 @ntext -> fn4
			$"@__offset_{fn4}" -> ocheck4
			offset i2s -> off_s
			g sb::build ocheck4 strings::contains 0 == if {
				g $"{ocheck4} = private constant i64 {off_s}\n" sb::append -> g
			}
			offset 8 + -> offset
		}
		// Extra fields
		n @extra -> cur
		cur null neq while {
			cur @ntext -> cfn
			$"@__offset_{cfn}" -> ocheckx
			offset i2s -> off_s
			g sb::build ocheckx strings::contains 0 == if {
				g $"{ocheckx} = private constant i64 {off_s}\n" sb::append -> g
			}
			offset 8 + -> offset
			cur @sibling -> cur
			cur null neq
		}
		// Size constant
		offset i2s -> off_s
		g $"@__size_{sname} = private constant i64 {off_s}\n" sb::append -> g
		g st.globals
		st return
	}
	// Enum declaration — emit variant value globals
	k ast::NodeType::EnumDecl == if {
		st @globals -> g
		n @ntext -> ename
		0 -> eval
		n @child1 null neq if {
			n @child1 @ntext -> vn1
			g ename vn1 eval emit_enum_variant -> g
			eval 1 + -> eval
		}
		n @child2 null neq if {
			n @child2 @ntext -> vn2
			g ename vn2 eval emit_enum_variant -> g
			eval 1 + -> eval
		}
		n @child3 null neq if {
			n @child3 @ntext -> vn3
			g ename vn3 eval emit_enum_variant -> g
			eval 1 + -> eval
		}
		n @child4 null neq if {
			n @child4 @ntext -> vn4
			g ename vn4 eval emit_enum_variant -> g
			eval 1 + -> eval
		}
		n @extra -> cur
		cur null neq while {
			cur @ntext -> vnx
			g ename vnx eval emit_enum_variant -> g
			eval 1 + -> eval
			cur @sibling -> cur
			cur null neq
		}
		g st.globals
		st return
	}

	// Constant declaration: const Name = value
	k ast::NodeType::ConstDecl == if {
		n @ntext -> cname
		n @child1 null neq if {
			n @child1 @ntext -> cval
			// Convert hex values to decimal
			cval -> cval_dec
			n @child1 @nkind ast::NodeType::IntLit == if {
				cval strings::len 2 > if {
					cval 0 strings::char_at! 48 == if {
						cval 1 strings::char_at! -> xch
						xch 120 == xch 88 == or if {
							cval 16 strconv::parse_int! -> hv
							sb::new -> hvb
							hvb hv sb::append_int -> hvb
							hvb sb::finish -> cval_dec
						}
					}
				}
			}
			// Constants are collected by collect_constants pre-pass and
			// inlined at usage site via the constants string
		}
		st return
	}
	// UseStmt — skip (handled by driver)
	k ast::NodeType::UseStmt == if { st return }

	st @code -> o
	o "; skipped: " sb::append -> o
	o n @ntext sb::append -> o
	o "\n" sb::append -> o
	o st.code
	st
}

// Emit the main() entry point
fn emit_main_entry(s:ptr -- s2:ptr) {
	-> st
	st @code -> o
	o "define i32 @main(i32 %argc, ptr %argv) {\n" sb::append -> o
	o "entry:\n" sb::append -> o
	o "  %ctx = call ptr @qd_create_context(i64 1024)\n" sb::append -> o
	o "  call i32 @usr_main_main(ptr %ctx)\n" sb::append -> o
	o "  call void @qd_free_context(ptr %ctx)\n" sb::append -> o
	o "  ret i32 0\n" sb::append -> o
	o "}\n" sb::append -> o
	o st.code
	st
}

// Emit declarations for a stdlib module's functions.
// mod_name: module name (e.g., "io")
// func_names: comma-separated function names (e.g., "open,close,read_file,write_file")
pub fn emit_module_declares(s:ptr mod_name:str func_names:str -- s2:ptr) {
	-> fns -> mname -> st
	fns strings::len 0 == if { st return }
	st @code -> o
	o $"\n; Module: {mname}\n" sb::append -> o
	// Parse comma-separated function names
	0 -> pos
	fns strings::len -> flen
	pos flen < while {
		pos -> end
		end flen < fns end strings::char_at! 44 neq and while {
			end 1 + -> end
			end flen < fns end strings::char_at! 44 neq and
		}
		end pos > if {
			fns pos end pos - strings::substring! -> fname
			o "declare i32 @usr_" sb::append -> o
			o mname sb::append -> o
			o "_" sb::append -> o
			o fname sb::append -> o
			o "(ptr)\n" sb::append -> o
		}
		end 1 + -> pos
		pos flen <
	}
	o st.code
	st
}

// Emit declarations and code for a merged .qd file's AST
pub fn emit_merged_file(s:ptr file_ast:ptr consts:str prefix:str -- s2:ptr) {
	-> pfx -> cstr -> froot -> st
	froot null == if { st return }
	// Process all top-level declarations from the merged file
	froot @child1 null neq if { st froot @child1 cstr pfx emit_top_level -> st }
	froot @child2 null neq if { st froot @child2 cstr pfx emit_top_level -> st }
	froot @child3 null neq if { st froot @child3 cstr pfx emit_top_level -> st }
	froot @child4 null neq if { st froot @child4 cstr pfx emit_top_level -> st }
	froot @extra -> cur
	cur null neq while {
		st cur cstr pfx emit_top_level -> st
		cur @sibling -> cur
		cur null neq
	}
	st
}

// Generate IR for a program AST, plus optional merged file ASTs and module declares.
// merged_files: linked list of program ASTs (via @sibling) to merge, or null
// module_declares: IR text for module declare statements, or ""
pub fn generate_full(prog:ptr merged_files:ptr module_declares:str -- ir:str) {
	-> mdecls -> merged -> root
	new_state -> st

	// Preamble (header emitted in final combine)
	st @code -> o
	o "%qd_context_t = type { ptr, i64, ptr, i32, ptr, ptr }\n" sb::append -> o
	o "%qd_stack_t = type { ptr, i64, i64 }\n" sb::append -> o
	o "%qd_stack_element_t = type { i64, i32, i8 }\n\n" sb::append -> o
	o "declare ptr @qd_create_context(i64)\n" sb::append -> o
	o "declare void @qd_free_context(ptr)\n" sb::append -> o
	o "declare i32 @qd_push_i(ptr, i64)\n" sb::append -> o
	o "declare i32 @qd_push_f(ptr, double)\n" sb::append -> o
	o "declare i32 @qd_push_s(ptr, ptr)\n" sb::append -> o
	o "declare i32 @qd_push_p(ptr, ptr)\n" sb::append -> o
	o "declare i32 @qd_push_s_ref(ptr, ptr)\n" sb::append -> o
	o "declare void @qd_string_retain(ptr)\n" sb::append -> o
	o "declare void @qd_ptr_retain(ptr)\n" sb::append -> o
	o "declare i32 @qd_print(ptr)\n" sb::append -> o
	o "declare i32 @qd_nl(ptr)\n" sb::append -> o
	o "declare i32 @qd_add(ptr)\n" sb::append -> o
	o "declare i32 @qd_sub(ptr)\n" sb::append -> o
	o "declare i32 @qd_mul(ptr)\n" sb::append -> o
	o "declare i32 @qd_div(ptr)\n" sb::append -> o
	o "declare i32 @qd_mod(ptr)\n" sb::append -> o
	o "declare i32 @qd_eq(ptr)\n" sb::append -> o
	o "declare i32 @qd_neq(ptr)\n" sb::append -> o
	o "declare i32 @qd_lt(ptr)\n" sb::append -> o
	o "declare i32 @qd_gt(ptr)\n" sb::append -> o
	o "declare i32 @qd_lte(ptr)\n" sb::append -> o
	o "declare i32 @qd_gte(ptr)\n" sb::append -> o
	o "declare i32 @qd_dup(ptr)\n" sb::append -> o
	o "declare i32 @qd_drop(ptr)\n" sb::append -> o
	o "declare i32 @qd_swap(ptr)\n" sb::append -> o
	o "declare i32 @qd_over(ptr)\n" sb::append -> o
	o "declare i32 @qd_rot(ptr)\n" sb::append -> o
	o "declare i32 @qd_nip(ptr)\n" sb::append -> o
	o "declare i32 @qd_len(ptr)\n" sb::append -> o
	o "declare i32 @qd_free(ptr)\n" sb::append -> o
	o "declare i32 @qd_panic(ptr)\n" sb::append -> o
	o "declare i32 @qd_err(ptr)\n" sb::append -> o
	o "declare i32 @qd_and(ptr)\n" sb::append -> o
	o "declare i32 @qd_or(ptr)\n" sb::append -> o
	o "declare i32 @qd_not(ptr)\n" sb::append -> o
	o "declare i32 @qd_neg(ptr)\n" sb::append -> o
	o "declare i32 @qd_tuck(ptr)\n" sb::append -> o
	o "declare i32 @qd_pick(ptr)\n" sb::append -> o
	o "declare i32 @qd_roll(ptr)\n" sb::append -> o
	o "declare void @qd_stack_pop(ptr, ptr)\n" sb::append -> o
	o "declare i32 @qdrt_push_element(ptr, ptr)\n" sb::append -> o
	o "declare void @qd_push_call(ptr, ptr, ptr, i64)\n" sb::append -> o
	o "declare void @qd_pop_call(ptr)\n" sb::append -> o
	o "declare void @_exit(i32)\n" sb::append -> o
	o "declare ptr @qd_struct_alloc(i64, ptr)\n\n" sb::append -> o
	o st.code

	// Pre-pass: collect all constants and field types from main and merged files
	root sb::new collect_constants -> cbuf
	merged -> miter
	miter null neq while {
		miter cbuf collect_constants -> cbuf
		miter @sibling -> miter
		miter null neq
	}
	// Also collect struct field types (stored as !@fieldname=typename!)
	root cbuf collect_field_types -> cbuf
	merged -> miter2
	miter2 null neq while {
		miter2 cbuf collect_field_types -> cbuf
		miter2 @sibling -> miter2
		miter2 null neq
	}
	cbuf "!" sb::append -> cbuf  // terminator
	cbuf sb::finish -> all_consts

	// Top-level declarations (main file uses "usr_main_" prefix)
	"usr_main_" -> main_pfx
	root @child1 null neq if { st root @child1 all_consts main_pfx emit_top_level -> st }
	root @child2 null neq if { st root @child2 all_consts main_pfx emit_top_level -> st }
	root @child3 null neq if { st root @child3 all_consts main_pfx emit_top_level -> st }
	root @child4 null neq if { st root @child4 all_consts main_pfx emit_top_level -> st }
	root @extra -> cur
	cur null neq while {
		st cur all_consts main_pfx emit_top_level -> st
		cur @sibling -> cur
		cur null neq
	}

	// Process merged file ASTs
	// Each merged AST's ntext holds the prefix (set by driver), default to "usr_main_"
	merged null neq while {
		merged @ntext -> mpfx
		mpfx strings::len 0 == if { "usr_main_" -> mpfx }
		st merged all_consts mpfx emit_merged_file -> st
		merged @sibling -> merged
		merged null neq
	}

	// Emit module declares (as IR text)
	mdecls strings::len 0 > if {
		st @code -> o
		o mdecls sb::append -> o
		o st.code
	}

	// Main entry
	st emit_main_entry -> st

	// Combine: header + globals + code
	st @globals sb::finish -> globals_str
	st @code sb::finish -> code_str

	sb::new -> final
	final "; Generated by Quadrate self-hosted compiler\n" sb::append -> final
	final "source_filename = \"quadrate\"\n\n" sb::append -> final
	final globals_str sb::append -> final
	final "\n" sb::append -> final
	final code_str sb::append -> final
	final sb::finish
}

// Simple wrapper for backward compatibility
pub fn generate(prog:ptr -- ir:str) {
	-> root
	root null "" generate_full
}
