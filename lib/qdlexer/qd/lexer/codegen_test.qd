/// Test the textual LLVM IR emitter
use testing
use strings
use sb
use "lexer.qd"
use "ast.qd"
use "parser.qd"
use "codegen.qd"

test "generate IR for empty main" {
	"fn main() { }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "qd_context_t" strings::contains testing::assert_true
	ir "@main(" strings::contains testing::assert_true
	ir "@usr_main_main(" strings::contains testing::assert_true
}

test "generate IR for integer literal" {
	"fn main() { 42 }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "qd_push_i(ptr %ctx, i64 42)" strings::contains testing::assert_true
}

test "generate IR for print" {
	"fn main() { 42 print nl }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "qd_push_i(ptr %ctx, i64 42)" strings::contains testing::assert_true
	ir "qd_print(ptr %ctx)" strings::contains testing::assert_true
	ir "qd_nl(ptr %ctx)" strings::contains testing::assert_true
}

test "generate IR for arithmetic" {
	"fn main() { 1 2 + }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "qd_push_i(ptr %ctx, i64 1)" strings::contains testing::assert_true
	ir "qd_push_i(ptr %ctx, i64 2)" strings::contains testing::assert_true
	ir "qd_add(ptr %ctx)" strings::contains testing::assert_true
}

test "generate IR for function call" {
	"fn double() { dup + }\nfn main() { 21 double }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "@usr_main_double(" strings::contains testing::assert_true
	ir "qd_dup" strings::contains testing::assert_true
}

test "generate IR for boolean literals" {
	"fn main() { true false Ok Err null }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "i64 1)" strings::contains testing::assert_true
	ir "i64 0)" strings::contains testing::assert_true
}

test "generate IR for string literal" {
	"fn main() { \"hello\" print nl }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "@.str." strings::contains testing::assert_true
	ir "hello" strings::contains testing::assert_true
	ir "qd_push_s" strings::contains testing::assert_true
}

test "generate IR for local variable" {
	"fn main() { 42 -> x }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "alloca %qd_stack_element_t" strings::contains testing::assert_true
	ir "qd_stack_pop" strings::contains testing::assert_true
}

test "generate IR for if statement" {
	"fn main() { 1 if { 42 print nl } }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "icmp ne i64" strings::contains testing::assert_true
	ir "br i1" strings::contains testing::assert_true
}

test "generate IR for struct" {
	"struct Point { x:i64 y:i64 }\nfn main() { Point { x = 1 y = 2 } -> p  p @x print nl }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "qd_struct_alloc" strings::contains testing::assert_true
	ir "@__size_Point" strings::contains testing::assert_true
	ir "@__offset_x" strings::contains testing::assert_true
	ir "qd_push_p" strings::contains testing::assert_true
}

test "generate IR for enum" {
	"enum Color { Red Green Blue }\nfn main() { Color::Green print nl }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "@__enum_Color_Red" strings::contains testing::assert_true
	ir "@__enum_Color_Green" strings::contains testing::assert_true
	ir "@__enum_Color_Blue" strings::contains testing::assert_true
}

test "generate IR for field set" {
	"struct S { x:i64 }\nfn main() { S { x = 1 } -> s  99 s.x }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "@__offset_x" strings::contains testing::assert_true
	ir "store i64" strings::contains testing::assert_true
}

test "generate IR for for loop" {
	"fn main() { 0 3 1 for i { i print nl } }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "qd_stack_pop" strings::contains testing::assert_true
	ir "icmp slt" strings::contains testing::assert_true
	ir "add i64" strings::contains testing::assert_true
}

test "generate IR for switch" {
	"fn main() { 1 switch { 1 { \"one\" } _ { \"other\" } } }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "icmp eq" strings::contains testing::assert_true
}

test "generate IR for method" {
	"struct Counter { val:i64 }\nfn (c:Counter) get( -- ) { }\nfn main() { }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "@usr_main_Counter_get" strings::contains testing::assert_true
}

test "generate IR for scoped call" {
	"fn main() { 1 2 math::add }" parser::new -> p
	p parser::parse_program -> prog
	prog codegen::generate -> ir
	ir "@usr_math_add(ptr %ctx)" strings::contains testing::assert_true
}
