/// String manipulation functions.
/// Error codes: Ok=1 (success), specific errors start at 2

/// Error: Index out of bounds.
pub const ErrOutOfBounds = 2
/// Error: Memory allocation failed.
pub const ErrAlloc = 3
/// Error: Invalid argument.
pub const ErrInvalidArg = 4

import "libqdstr.a" as "str" {
	/// Get string length in bytes.
	/// @param str str Input string
	/// @return len i64 Length in bytes
	/// @example "hello" str::len print  // 5
	pub fn len(str:str -- len:i64)

	/// Concatenate two strings.
	/// @param str1 str First string
	/// @param str2 str Second string
	/// @return result str Combined string
	/// @example "hello" " world" str::concat print  // "hello world"
	pub fn concat(str1:str str2:str -- result:str)

	/// Check if string contains substring.
	/// @param str str String to search in
	/// @param needle str Substring to find
	/// @return result i64 1 if found, 0 otherwise
	/// @example "hello" "ell" str::contains print  // 1
	pub fn contains(str:str needle:str -- result:i64)

	/// Check if string starts with prefix.
	/// @param str str String to check
	/// @param prefix str Prefix to match
	/// @return result i64 1 if matches, 0 otherwise
	/// @example "hello" "hel" str::starts_with print  // 1
	pub fn starts_with(str:str prefix:str -- result:i64)

	/// Check if string ends with suffix.
	/// @param str str String to check
	/// @param suffix str Suffix to match
	/// @return result i64 1 if matches, 0 otherwise
	/// @example "hello" "lo" str::ends_with print  // 1
	pub fn ends_with(str:str suffix:str -- result:i64)

	/// Find first occurrence of substring.
	/// @param haystack str String to search in
	/// @param needle str Substring to find
	/// @return index i64 Index of first match, -1 if not found
	/// @example "hello" "ll" str::index_of print  // 2
	pub fn index_of(haystack:str needle:str -- index:i64)

	/// Find substring starting from position.
	/// @param haystack str String to search in
	/// @param needle str Substring to find
	/// @param start i64 Starting position
	/// @return index i64 Index of match, -1 if not found
	/// @example "hello hello" "hello" 1 str::index_of_from print  // 6
	pub fn index_of_from(haystack:str needle:str start:i64 -- index:i64)

	/// Convert string to uppercase.
	/// @param str str Input string
	/// @return result str Uppercase string
	/// @example "hello" str::upper print  // "HELLO"
	pub fn upper(str:str -- result:str)

	/// Convert string to lowercase.
	/// @param str str Input string
	/// @return result str Lowercase string
	/// @example "HELLO" str::lower print  // "hello"
	pub fn lower(str:str -- result:str)

	/// Remove leading and trailing whitespace.
	/// @param str str Input string
	/// @return result str Trimmed string
	/// @example "  hello  " str::trim print  // "hello"
	pub fn trim(str:str -- result:str)

	/// Extract substring.
	/// @param str str Source string
	/// @param start i64 Starting index
	/// @param length i64 Number of characters
	/// @return result str Extracted substring
	/// @error ErrOutOfBounds Index out of bounds
	/// @example "hello" 1 3 str::substring! print  // "ell"
	pub fn substring(str:str start:i64 length:i64 -- result:str)!

	/// Replace all occurrences of substring.
	/// @param str str Source string
	/// @param old str Substring to replace
	/// @param new str Replacement string
	/// @return result str String with replacements
	/// @error ErrAlloc Memory allocation failed
	/// @example "hello" "l" "L" str::replace! print  // "heLLo"
	pub fn replace(str:str old:str new:str -- result:str)!

	/// Get character code at index.
	/// @param str str Input string
	/// @param index i64 Character position
	/// @return char_code i64 ASCII/UTF-8 byte value
	/// @error ErrOutOfBounds Index out of bounds
	/// @example "hello" 0 str::char_at! print  // 104 ('h')
	pub fn char_at(str:str index:i64 -- char_code:i64)!

	/// Create string from character code.
	/// @param char_code i64 ASCII/UTF-8 byte value
	/// @return str str Single character string
	/// @example 65 str::from_char print  // "A"
	pub fn from_char(char_code:i64 -- str:str)

	/// Split string by delimiter.
	/// @param str str String to split
	/// @param delim str Delimiter string
	/// @return parts ptr Array of string parts
	/// @return count i64 Number of parts
	/// @error ErrAlloc Memory allocation failed
	/// @example "a,b,c" "," str::split!  // parts=["a","b","c"], count=3
	pub fn split(str:str delim:str -- parts:ptr count:i64)!

	/// Compare two strings lexicographically.
	/// @param str1 str First string
	/// @param str2 str Second string
	/// @return result i64 <0 if str1<str2, 0 if equal, >0 if str1>str2
	/// @example "abc" "abd" str::compare print  // -1
	pub fn compare(str1:str str2:str -- result:i64)

	/// Sort array of strings in ascending alphabetical order.
	/// @param arr ptr Array of string pointers
	/// @param count i64 Number of elements
	/// @example entries count str::sort
	pub fn sort(arr:ptr count:i64 -- )

	/// Sort array of strings in descending alphabetical order.
	/// @param arr ptr Array of string pointers
	/// @param count i64 Number of elements
	/// @example entries count str::sort_desc
	pub fn sort_desc(arr:ptr count:i64 -- )

	/// Convert C string pointer to Quadrate string.
	/// @param ptr ptr Pointer to null-terminated C string
	/// @return str str Quadrate string
	/// @example entries 0 mem::get_ptr str::from_ptr print
	pub fn from_ptr(ptr:ptr -- str:str)

	/// Join array of strings with delimiter.
	/// @param parts ptr Array of string pointers
	/// @param count i64 Number of strings
	/// @param delim str Delimiter string
	/// @return result str Joined string
	/// @error ErrAlloc Memory allocation failed
	/// @example parts count "/" str::join! -> path
	pub fn join(parts:ptr count:i64 delim:str -- result:str)!

	/// Repeat string n times.
	/// @param str str Input string
	/// @param n i64 Number of repetitions
	/// @return result str Repeated string
	/// @example "ab" 3 str::repeat print  // "ababab"
	pub fn repeat(str:str n:i64 -- result:str)

	/// Reverse a string.
	/// @param str str Input string
	/// @return result str Reversed string
	/// @example "hello" str::reverse print  // "olleh"
	pub fn reverse(str:str -- result:str)

	/// Remove leading whitespace.
	/// @param str str Input string
	/// @return result str String with leading whitespace removed
	/// @example "  hello" str::trim_left print  // "hello"
	pub fn trim_left(str:str -- result:str)

	/// Remove trailing whitespace.
	/// @param str str Input string
	/// @return result str String with trailing whitespace removed
	/// @example "hello  " str::trim_right print  // "hello"
	pub fn trim_right(str:str -- result:str)

	/// Count occurrences of substring.
	/// @param haystack str String to search in
	/// @param needle str Substring to count
	/// @return count i64 Number of occurrences
	/// @example "ababa" "aba" str::count print  // 1 (non-overlapping)
	pub fn count(haystack:str needle:str -- count:i64)

	/// Find last occurrence of substring.
	/// @param haystack str String to search in
	/// @param needle str Substring to find
	/// @return index i64 Index of last match, -1 if not found
	/// @example "hello hello" "hello" str::last_index_of print  // 6
	pub fn last_index_of(haystack:str needle:str -- index:i64)
}
