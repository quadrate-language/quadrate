// Unit tests for the str module
use str
use testing

test "str::len" {
	"hello" str::len 5 testing::assert_eq
	"" str::len 0 testing::assert_eq
	"a" str::len 1 testing::assert_eq
	"hello world" str::len 11 testing::assert_eq
}

test "str::concat" {
	"hello" " world" str::concat "hello world" testing::assert_eq
	"" "test" str::concat "test" testing::assert_eq
	"test" "" str::concat "test" testing::assert_eq
	"" "" str::concat "" testing::assert_eq
}

test "str::contains" {
	"hello world" "world" str::contains testing::assert_true
	"hello world" "foo" str::contains testing::assert_false
	"hello world" "" str::contains testing::assert_true
	"" "test" str::contains testing::assert_false
	"hello" "hello" str::contains testing::assert_true
}

test "str::starts_with" {
	"hello world" "hello" str::starts_with testing::assert_true
	"hello world" "world" str::starts_with testing::assert_false
	"hello world" "" str::starts_with testing::assert_true
	"" "test" str::starts_with testing::assert_false
	"hello" "hello" str::starts_with testing::assert_true
}

test "str::ends_with" {
	"hello world" "world" str::ends_with testing::assert_true
	"hello world" "hello" str::ends_with testing::assert_false
	"hello world" "" str::ends_with testing::assert_true
	"" "test" str::ends_with testing::assert_false
	"hello" "hello" str::ends_with testing::assert_true
}

test "str::upper" {
	"hello" str::upper "HELLO" testing::assert_eq
	"HELLO" str::upper "HELLO" testing::assert_eq
	"HeLLo" str::upper "HELLO" testing::assert_eq
	"123" str::upper "123" testing::assert_eq
	"" str::upper "" testing::assert_eq
}

test "str::lower" {
	"HELLO" str::lower "hello" testing::assert_eq
	"hello" str::lower "hello" testing::assert_eq
	"HeLLo" str::lower "hello" testing::assert_eq
	"123" str::lower "123" testing::assert_eq
	"" str::lower "" testing::assert_eq
}

test "str::trim" {
	"  hello  " str::trim "hello" testing::assert_eq
	"hello" str::trim "hello" testing::assert_eq
	"  hello" str::trim "hello" testing::assert_eq
	"hello  " str::trim "hello" testing::assert_eq
	"   " str::trim "" testing::assert_eq
	"" str::trim "" testing::assert_eq
}

test "str::index_of" {
	"hello world" "world" str::index_of 6 testing::assert_eq
	"hello world" "hello" str::index_of 0 testing::assert_eq
	"hello world" "foo" str::index_of -1 testing::assert_eq
	"hello" "l" str::index_of 2 testing::assert_eq
}

test "str::index_of_from" {
	"hello hello" "hello" 1 str::index_of_from 6 testing::assert_eq
	"aaa" "a" 1 str::index_of_from 1 testing::assert_eq
	"hello" "x" 0 str::index_of_from -1 testing::assert_eq
}

test "str::replace" {
	"hello world" "world" "there" str::replace! "hello there" testing::assert_eq
	"aaa" "a" "b" str::replace! "bbb" testing::assert_eq
	"hello" "x" "y" str::replace! "hello" testing::assert_eq
}

test "str::substring" {
	"hello world" 0 5 str::substring! "hello" testing::assert_eq
	"hello world" 6 5 str::substring! "world" testing::assert_eq
	"hello" 0 0 str::substring! "" testing::assert_eq
}

test "str::char_at returns char code" {
	"hello" 0 str::char_at! 104 testing::assert_eq  // 'h' = 104
	"hello" 1 str::char_at! 101 testing::assert_eq  // 'e' = 101
	"ABC" 0 str::char_at! 65 testing::assert_eq     // 'A' = 65
}

test "str::from_char" {
	65 str::from_char "A" testing::assert_eq
	97 str::from_char "a" testing::assert_eq
	48 str::from_char "0" testing::assert_eq
}

test "str::compare" {
	"abc" "abc" str::compare 0 testing::assert_eq
	"abc" "abd" str::compare 0 < testing::assert_true
	"abd" "abc" str::compare 0 > testing::assert_true
	"" "" str::compare 0 testing::assert_eq
}

test "str::repeat" {
	"ab" 3 str::repeat "ababab" testing::assert_eq
	"x" 5 str::repeat "xxxxx" testing::assert_eq
	"hello" 1 str::repeat "hello" testing::assert_eq
	"test" 0 str::repeat "" testing::assert_eq
	"" 10 str::repeat "" testing::assert_eq
}

test "str::reverse" {
	"hello" str::reverse "olleh" testing::assert_eq
	"abc" str::reverse "cba" testing::assert_eq
	"a" str::reverse "a" testing::assert_eq
	"" str::reverse "" testing::assert_eq
	"12345" str::reverse "54321" testing::assert_eq
}

test "str::trim_left" {
	"  hello" str::trim_left "hello" testing::assert_eq
	"hello" str::trim_left "hello" testing::assert_eq
	"  hello  " str::trim_left "hello  " testing::assert_eq
	"   " str::trim_left "" testing::assert_eq
	"" str::trim_left "" testing::assert_eq
}

test "str::trim_right" {
	"hello  " str::trim_right "hello" testing::assert_eq
	"hello" str::trim_right "hello" testing::assert_eq
	"  hello  " str::trim_right "  hello" testing::assert_eq
	"   " str::trim_right "" testing::assert_eq
	"" str::trim_right "" testing::assert_eq
}

test "str::count" {
	"ababa" "a" str::count 3 testing::assert_eq
	"hello" "l" str::count 2 testing::assert_eq
	"hello" "x" str::count 0 testing::assert_eq
	"aaa" "aa" str::count 1 testing::assert_eq  // non-overlapping
	"" "test" str::count 0 testing::assert_eq
}

test "str::last_index_of" {
	"hello hello" "hello" str::last_index_of 6 testing::assert_eq
	"abcabc" "abc" str::last_index_of 3 testing::assert_eq
	"hello" "x" str::last_index_of -1 testing::assert_eq
	"hello" "hello" str::last_index_of 0 testing::assert_eq
}

// === New function tests ===

test "str::is_empty" {
	"" str::is_empty testing::assert_true
	"hello" str::is_empty testing::assert_false
	" " str::is_empty testing::assert_false
}

test "str::is_blank" {
	"" str::is_blank testing::assert_true
	"   " str::is_blank testing::assert_true
	" \t\n " str::is_blank testing::assert_true
	"hello" str::is_blank testing::assert_false
	"  a  " str::is_blank testing::assert_false
}

test "str::equals_ignore_case" {
	"Hello" "HELLO" str::equals_ignore_case testing::assert_true
	"hello" "hello" str::equals_ignore_case testing::assert_true
	"ABC" "abc" str::equals_ignore_case testing::assert_true
	"hello" "world" str::equals_ignore_case testing::assert_false
	"" "" str::equals_ignore_case testing::assert_true
}

test "str::pad_left" {
	"42" 5 "0" str::pad_left "00042" testing::assert_eq
	"hello" 10 " " str::pad_left "     hello" testing::assert_eq
	"test" 4 "x" str::pad_left "test" testing::assert_eq
	"test" 2 "x" str::pad_left "test" testing::assert_eq
	"" 3 "-" str::pad_left "---" testing::assert_eq
}

test "str::pad_right" {
	"hi" 5 "." str::pad_right "hi..." testing::assert_eq
	"hello" 10 " " str::pad_right "hello     " testing::assert_eq
	"test" 4 "x" str::pad_right "test" testing::assert_eq
	"test" 2 "x" str::pad_right "test" testing::assert_eq
	"" 3 "-" str::pad_right "---" testing::assert_eq
}

test "str::center" {
	"hi" 6 "-" str::center "--hi--" testing::assert_eq
	"abc" 7 " " str::center "  abc  " testing::assert_eq
	"test" 4 "x" str::center "test" testing::assert_eq
	"a" 4 "=" str::center "=a==" testing::assert_eq
}

test "str::capitalize" {
	"hello" str::capitalize "Hello" testing::assert_eq
	"HELLO" str::capitalize "Hello" testing::assert_eq
	"hELLO wORLD" str::capitalize "Hello world" testing::assert_eq
	"" str::capitalize "" testing::assert_eq
	"a" str::capitalize "A" testing::assert_eq
}

test "str::title" {
	"hello world" str::title "Hello World" testing::assert_eq
	"HELLO WORLD" str::title "Hello World" testing::assert_eq
	"the quick brown fox" str::title "The Quick Brown Fox" testing::assert_eq
	"" str::title "" testing::assert_eq
	"a b c" str::title "A B C" testing::assert_eq
}

test "str::trim_prefix" {
	"hello" "hel" str::trim_prefix "lo" testing::assert_eq
	"hello" "world" str::trim_prefix "hello" testing::assert_eq
	"hello" "" str::trim_prefix "hello" testing::assert_eq
	"hello" "hello" str::trim_prefix "" testing::assert_eq
	"" "test" str::trim_prefix "" testing::assert_eq
}

test "str::trim_suffix" {
	"hello" "lo" str::trim_suffix "hel" testing::assert_eq
	"hello" "world" str::trim_suffix "hello" testing::assert_eq
	"hello" "" str::trim_suffix "hello" testing::assert_eq
	"hello" "hello" str::trim_suffix "" testing::assert_eq
	"" "test" str::trim_suffix "" testing::assert_eq
}

test "str::replace_first" {
	"abab" "ab" "X" str::replace_first "Xab" testing::assert_eq
	"hello world world" "world" "there" str::replace_first "hello there world" testing::assert_eq
	"hello" "x" "y" str::replace_first "hello" testing::assert_eq
	"aaa" "a" "bb" str::replace_first "bbaa" testing::assert_eq
}

test "str::insert" {
	"hello" 2 "XX" str::insert "heXXllo" testing::assert_eq
	"hello" 0 "XX" str::insert "XXhello" testing::assert_eq
	"hello" 5 "XX" str::insert "helloXX" testing::assert_eq
	"" 0 "test" str::insert "test" testing::assert_eq
}

test "str::remove_range" {
	"hello" 1 3 str::remove_range "ho" testing::assert_eq
	"hello" 0 1 str::remove_range "ello" testing::assert_eq
	"hello" 4 1 str::remove_range "hell" testing::assert_eq
	"hello" 0 5 str::remove_range "" testing::assert_eq
	"hello" 2 0 str::remove_range "hello" testing::assert_eq
}

test "str::truncate" {
	"hello world" 8 "..." str::truncate "hello..." testing::assert_eq
	"hi" 10 "..." str::truncate "hi" testing::assert_eq
	"hello" 5 "..." str::truncate "hello" testing::assert_eq
	"hello world" 5 "" str::truncate "hello" testing::assert_eq
}

test "str::is_numeric" {
	"12345" str::is_numeric testing::assert_true
	"0" str::is_numeric testing::assert_true
	"" str::is_numeric testing::assert_false
	"123abc" str::is_numeric testing::assert_false
	"12.34" str::is_numeric testing::assert_false
	"-5" str::is_numeric testing::assert_false
}

test "str::is_alpha" {
	"Hello" str::is_alpha testing::assert_true
	"abc" str::is_alpha testing::assert_true
	"" str::is_alpha testing::assert_false
	"Hello123" str::is_alpha testing::assert_false
	"Hello World" str::is_alpha testing::assert_false
}

test "str::is_alphanumeric" {
	"Hello123" str::is_alphanumeric testing::assert_true
	"abc" str::is_alphanumeric testing::assert_true
	"123" str::is_alphanumeric testing::assert_true
	"" str::is_alphanumeric testing::assert_false
	"Hello World" str::is_alphanumeric testing::assert_false
	"test!" str::is_alphanumeric testing::assert_false
}

test "str::is_ascii" {
	"hello" str::is_ascii testing::assert_true
	"Hello123!@#" str::is_ascii testing::assert_true
	"" str::is_ascii testing::assert_true
	// Non-ASCII characters should return false
	"héllo" str::is_ascii testing::assert_false
	"日本語" str::is_ascii testing::assert_false
	"hello 🎉" str::is_ascii testing::assert_false
}

test "str::is_lowercase" {
	"hello" str::is_lowercase testing::assert_true
	"hello world" str::is_lowercase testing::assert_true
	"Hello" str::is_lowercase testing::assert_false
	"HELLO" str::is_lowercase testing::assert_false
	"123" str::is_lowercase testing::assert_false
	"" str::is_lowercase testing::assert_false
}

test "str::is_uppercase" {
	"HELLO" str::is_uppercase testing::assert_true
	"HELLO WORLD" str::is_uppercase testing::assert_true
	"Hello" str::is_uppercase testing::assert_false
	"hello" str::is_uppercase testing::assert_false
	"123" str::is_uppercase testing::assert_false
	"" str::is_uppercase testing::assert_false
}

test "str::char_count" {
	"hello" str::char_count 5 testing::assert_eq
	"" str::char_count 0 testing::assert_eq
	"abc" str::char_count 3 testing::assert_eq
	// UTF-8 multi-byte characters (each is 2-4 bytes but 1 codepoint)
	"héllo" str::char_count 5 testing::assert_eq
	"日本語" str::char_count 3 testing::assert_eq
	"🎉" str::char_count 1 testing::assert_eq
}

test "str::slice" {
	"hello" 1 4 str::slice "ell" testing::assert_eq
	"hello" 0 5 str::slice "hello" testing::assert_eq
	"hello" -3 -1 str::slice "ll" testing::assert_eq
	"hello" 1 -1 str::slice "ell" testing::assert_eq
	"hello" -2 100 str::slice "lo" testing::assert_eq
	"hello" 3 3 str::slice "" testing::assert_eq
	// Edge: start > end after normalization returns empty
	"hello" 4 2 str::slice "" testing::assert_eq
	// Edge: negative start beyond string length
	"hello" -100 3 str::slice "hel" testing::assert_eq
	// Edge: empty string
	"" 0 0 str::slice "" testing::assert_eq
}

test "str::lines" {
	"a\nb\nc" str::lines! -> count -> arr
	count 3 testing::assert_eq

	"single" str::lines! -> count2 -> arr2
	count2 1 testing::assert_eq

	"a\r\nb\r\nc" str::lines! -> count3 -> arr3
	count3 3 testing::assert_eq
}

test "str::words" {
	"hello world" str::words! -> count -> arr
	count 2 testing::assert_eq

	"  multiple   spaces  " str::words! -> count2 -> arr2
	count2 2 testing::assert_eq

	"single" str::words! -> count3 -> arr3
	count3 1 testing::assert_eq

	"   " str::words! -> count4 -> arr4
	count4 0 testing::assert_eq
}

test "str::split_n" {
	"a:b:c:d" ":" 2 str::split_n! -> count -> arr
	count 2 testing::assert_eq

	"a:b:c" ":" 10 str::split_n! -> count2 -> arr2
	count2 3 testing::assert_eq

	"a:b:c" ":" 1 str::split_n! -> count3 -> arr3
	count3 1 testing::assert_eq
}
