/// Bitwise operations for integer manipulation.
///
/// Core operations (and, or, xor, not, shl, shr) are builtins.
/// This module provides higher-level bit manipulation functions.
/// Keep only the bottom N bits.
/// @param value i64 Input value
/// @param num_bits i64 Number of bits to keep from LSB
/// @return result i64 Masked value
/// @example 0xFF 4 bits::mask print  // 15
pub fn mask(value:i64 num_bits:i64 -- result:i64) {
	1 swap shl 1 sub and
}

/// Extract a bit field from a value.
/// @param value i64 Source value
/// @param start_bit i64 Start position (0 = LSB)
/// @param num_bits i64 Number of bits to extract
/// @return result i64 Extracted bits, right-aligned
/// @example 0b11010110 2 3 bits::extract print  // 5
pub fn extract(value:i64 start_bit:i64 num_bits:i64 -- result:i64) {
	swap shr swap mask
}

/// Set a bit field in a value.
/// @param target i64 Target value to modify
/// @param value i64 Value to insert
/// @param start_bit i64 Start position (0 = LSB)
/// @param num_bits i64 Number of bits to set
/// @return result i64 Modified target
/// @example 0 0b101 2 3 bits::set_bits print  // 20 (0b10100)
pub fn set_bits(target:i64 value:i64 start_bit:i64 num_bits:i64 -- result:i64) {
	-> nb -> sb -> val -> tgt
	1 nb shl 1 sub -> bit_mask
	bit_mask sb shl -> positioned_mask
	positioned_mask not tgt and -> cleared
	val nb mask sb shl cleared or
}

/// Rotate bits left within a width.
/// @param value i64 Value to rotate
/// @param bits i64 Positions to rotate
/// @param width i64 Bit width to rotate within
/// @return result i64 Rotated value
/// @example 0b0011 1 4 bits::rotate_left print  // 6 (0b0110)
pub fn rotate_left(value:i64 bits:i64 width:i64 -- result:i64) {
	-> w -> b -> v
	v w b sub shr -> high
	v b shl w mask -> low
	high low or
}

/// Rotate bits right within a width.
/// @param value i64 Value to rotate
/// @param bits i64 Positions to rotate
/// @param width i64 Bit width to rotate within
/// @return result i64 Rotated value
/// @example 0b0110 1 4 bits::rotate_right print  // 3 (0b0011)
pub fn rotate_right(value:i64 bits:i64 width:i64 -- result:i64) {
	-> w -> b -> v
	v b mask w b sub shl -> low
	v b shr w mask -> high
	high low or
}

/// Count set bits (population count).
/// @param value i64 Value to count
/// @return count i64 Number of 1 bits
/// @example 0b1010110 bits::popcount print  // 4
pub fn popcount(value:i64 -- count:i64) {
	0 swap
	64 0 1 for it {
		dup 1 and rot add swap 1 shr
	}
	drop
}

/// Reverse the bottom N bits.
/// @param value i64 Value to reverse
/// @param width i64 Number of bits to reverse
/// @return result i64 Reversed value
/// @example 0b1011 4 bits::reverse_bits print  // 13 (0b1101)
pub fn reverse_bits(value:i64 width:i64 -- result:i64) {
	-> w -> v
	0 -> result
	w 0 1 for it {
		result 1 shl v 1 and or -> result
		v 1 shr -> v
	}
	result
}

/// Check if a bit is set.
/// @param value i64 Value to check
/// @param bit_pos i64 Bit position (0 = LSB)
/// @return flag i64 1 if set, 0 if not
/// @example 0b1010 1 bits::has_bit print  // 1
pub fn has_bit(value:i64 bit_pos:i64 -- flag:i64) {
	shr 1 and
}

/// Set a bit to 1.
/// @param value i64 Input value
/// @param bit_pos i64 Bit position to set
/// @return result i64 Value with bit set
/// @example 0b1000 1 bits::set_bit print  // 10 (0b1010)
pub fn set_bit(value:i64 bit_pos:i64 -- result:i64) {
	1 over shl or
}

/// Clear a bit to 0.
/// @param value i64 Input value
/// @param bit_pos i64 Bit position to clear
/// @return result i64 Value with bit cleared
/// @example 0b1010 1 bits::clear_bit print  // 8 (0b1000)
pub fn clear_bit(value:i64 bit_pos:i64 -- result:i64) {
	1 swap shl not and
}

/// Toggle a bit.
/// @param value i64 Input value
/// @param bit_pos i64 Bit position to toggle
/// @return result i64 Value with bit toggled
/// @example 0b1010 0 bits::toggle_bit print  // 11 (0b1011)
pub fn toggle_bit(value:i64 bit_pos:i64 -- result:i64) {
	1 swap shl xor
}
