// Unit tests for the time module
use strings
use time
use testing

test "time constants" {
	time::Nanosecond 1 testing::assert_eq
	time::Microsecond 1000 testing::assert_eq
	time::Millisecond 1000000 testing::assert_eq
	time::Second 1000000000 testing::assert_eq
}

test "time weekday constants" {
	time::Sunday 0 testing::assert_eq
	time::Monday 1 testing::assert_eq
	time::Saturday 6 testing::assert_eq
}

test "time month constants" {
	time::January 1 testing::assert_eq
	time::February 2 testing::assert_eq
	time::December 12 testing::assert_eq
}

test "time::is_leap_year" {
	2024 time::is_leap_year testing::assert_true
	2023 time::is_leap_year testing::assert_false
	2000 time::is_leap_year testing::assert_true
	1900 time::is_leap_year testing::assert_false
	2020 time::is_leap_year testing::assert_true
}

test "time::days_in_month" {
	2024 1 time::days_in_month 31 testing::assert_eq
	2024 2 time::days_in_month 29 testing::assert_eq
	2023 2 time::days_in_month 28 testing::assert_eq
	2024 4 time::days_in_month 30 testing::assert_eq
	2024 12 time::days_in_month 31 testing::assert_eq
}

test "time::year from epoch" {
	0 time::year 1970 testing::assert_eq
}

test "time::month from epoch" {
	0 time::month 1 testing::assert_eq
}

test "time::day from epoch" {
	0 time::day 1 testing::assert_eq
}

test "time::hour from epoch" {
	0 time::hour 0 testing::assert_eq
}

test "time::minute from epoch" {
	0 time::minute 0 testing::assert_eq
}

test "time::second from epoch" {
	0 time::second 0 testing::assert_eq
}

test "time::weekday from epoch" {
	0 time::weekday time::Thursday testing::assert_eq
}

test "time::date creates timestamp" {
	1970 1 1 0 0 0 time::date 0 testing::assert_eq
}

test "time::before" {
	0 100 time::before testing::assert_true
	100 0 time::before testing::assert_false
	50 50 time::before testing::assert_false
}

test "time::after" {
	100 0 time::after testing::assert_true
	0 100 time::after testing::assert_false
	50 50 time::after testing::assert_false
}

test "time::sub" {
	100 50 time::sub 50 testing::assert_eq
	50 100 time::sub -50 testing::assert_eq
}

test "time::add" {
	100 50 time::add 150 testing::assert_eq
	0 time::Second time::add time::Second testing::assert_eq
}

test "time::is_weekend" {
	time::Sunday time::is_weekend testing::assert_true
	time::Saturday time::is_weekend testing::assert_true
	time::Monday time::is_weekend testing::assert_false
	time::Friday time::is_weekend testing::assert_false
}

test "time::is_weekday" {
	time::Monday time::is_weekday testing::assert_true
	time::Friday time::is_weekday testing::assert_true
	time::Sunday time::is_weekday testing::assert_false
	time::Saturday time::is_weekday testing::assert_false
}

test "time::days_in_year" {
	2024 time::days_in_year 366 testing::assert_eq
	2023 time::days_in_year 365 testing::assert_eq
	2000 time::days_in_year 366 testing::assert_eq
	1900 time::days_in_year 365 testing::assert_eq
}

test "time::add_days" {
	0 1 time::add_days 86400 testing::assert_eq
	0 7 time::add_days 604800 testing::assert_eq
	100 0 time::add_days 100 testing::assert_eq
}

test "time::add_hours" {
	0 1 time::add_hours 3600 testing::assert_eq
	0 24 time::add_hours 86400 testing::assert_eq
}

test "time::add_minutes" {
	0 1 time::add_minutes 60 testing::assert_eq
	0 60 time::add_minutes 3600 testing::assert_eq
}

test "time::days_between" {
	86400 0 time::days_between 1 testing::assert_eq
	0 86400 time::days_between 1 testing::assert_eq
	604800 0 time::days_between 7 testing::assert_eq
	100 0 time::days_between 0 testing::assert_eq
}

test "time::hours_between" {
	3600 0 time::hours_between 1 testing::assert_eq
	86400 0 time::hours_between 24 testing::assert_eq
}

test "time::start_of_day" {
	43200 time::start_of_day 0 testing::assert_eq
	0 time::start_of_day 0 testing::assert_eq
}

test "time::end_of_day" {
	0 time::end_of_day 86399 testing::assert_eq
}

test "time::same_day" {
	0 43200 time::same_day testing::assert_true
	0 86400 time::same_day testing::assert_false
}

test "time::error constants" {
	time::ErrFormat 2 testing::assert_eq
	time::ErrParse 3 testing::assert_eq
}

test "time::format year-month-day" {
	0 "%Y-%m-%d" time::format! -> result
	result strings::len 10 testing::assert_eq
}

test "time::format time" {
	0 "%H:%M:%S" time::format! -> result
	result strings::len 8 testing::assert_eq
}

test "time::format full datetime" {
	0 "%Y-%m-%d %H:%M:%S" time::format! -> result
	result strings::len 19 testing::assert_eq
}

test "time::parse and format roundtrip" {
	time::unix -> now
	now "%Y-%m-%d %H:%M:%S" time::format! -> formatted
	formatted "%Y-%m-%d %H:%M:%S" time::parse! -> parsed
	parsed now testing::assert_eq
}

test "time::parse date only" {
	"2024-06-15" "%Y-%m-%d" time::parse! -> ts
	ts time::year 2024 testing::assert_eq
	ts time::month 6 testing::assert_eq
	ts time::day 15 testing::assert_eq
}

test "time::millis returns positive" {
	time::millis -> ms
	ms 0 > testing::assert_true
}

test "time::micros returns positive" {
	time::micros -> us
	us 0 > testing::assert_true
}

test "time::millis less than micros" {
	time::millis -> ms
	time::micros -> us
	us ms > testing::assert_true
}
