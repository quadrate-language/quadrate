/// Time operations and duration constants.
/// Duration = 1 nanosecond.
pub const Nanosecond = 1
/// Duration = 1 microsecond (1000 nanoseconds).
pub const Microsecond = 1000
/// Duration = 1 millisecond (1,000,000 nanoseconds).
pub const Millisecond = 1000000
/// Duration = 1 second (1,000,000,000 nanoseconds).
pub const Second = 1000000000
/// Duration = 1 minute (60 seconds).
pub const Minute = 60000000000
/// Duration = 1 hour (60 minutes).
pub const Hour = 3600000000000
/// Duration = 1 day (24 hours).
pub const Day = 86400000000000
/// Duration = 1 week (7 days).
pub const Week = 604800000000000
/// Weekday constants (Sunday=0)
pub const Sunday = 0
pub const Monday = 1
pub const Tuesday = 2
pub const Wednesday = 3
pub const Thursday = 4
pub const Friday = 5
pub const Saturday = 6
/// Month constants (1-indexed)
pub const January = 1
pub const February = 2
pub const March = 3
pub const April = 4
pub const May = 5
pub const June = 6
pub const July = 7
pub const August = 8
pub const September = 9
pub const October = 10
pub const November = 11
pub const December = 12
/// Error: Format operation failed.
pub const ErrFormat = 2
/// Error: Parse operation failed.
pub const ErrParse = 3

import "libtime.a" as "time" {
	/// Get Unix timestamp in seconds.
	/// @return timestamp i64 Seconds since 1970-01-01 00:00:00 UTC
	/// @example time::unix print  // 1700000000
	pub fn unix( -- timestamp:i64)

	/// Get current time in nanoseconds since epoch.
	/// @return nanoseconds i64 Nanoseconds since 1970-01-01 00:00:00 UTC
	/// @example time::now -> start
	pub fn now( -- nanoseconds:i64)

	/// Sleep for duration in nanoseconds.
	/// @param duration i64 Duration to sleep (use time constants)
	/// @example time::Second time::sleep
	pub fn sleep(duration:i64 -- )

	/// Format timestamp using strftime format string.
	/// Common format specifiers:
	/// - %Y: 4-digit year, %m: month (01-12), %d: day (01-31)
	/// - %H: hour (00-23), %M: minute (00-59), %S: second (00-59)
	/// - %F: date (YYYY-MM-DD), %T: time (HH:MM:SS)
	/// - %A: weekday name, %B: month name
	/// @param timestamp i64 Unix timestamp in seconds
	/// @param format str strftime format string
	/// @return result str Formatted time string
	/// @error ErrFormat Format error or invalid timestamp
	/// @example time::unix "%Y-%m-%d %H:%M:%S" time::format! print
	pub fn format(timestamp:i64 format:str -- result:str)!

	/// Parse string to timestamp using strptime format string.
	/// @param input str String to parse
	/// @param format str strptime format string
	/// @return timestamp i64 Unix timestamp in seconds
	/// @error ErrParse Parse failed or invalid format
	/// @example "2024-01-15" "%Y-%m-%d" time::parse! -> ts
	pub fn parse(input:str format:str -- timestamp:i64)!
}

// ============================================================
// Date Functions
// ============================================================
/// Check if year is a leap year.
/// @param yr i64 Year to check
/// @return is_leap i64 1 if leap year, 0 otherwise
/// @example 2024 time::is_leap_year print  // 1
pub fn is_leap_year(yr:i64 -- is_leap:i64) {
	yr 400 % 0 == if {
		1
	} else {
		yr 100 % 0 == if {
			0
		} else {
			yr 4 % 0 == if {
				1
			} else {
				0
			}
		}
	}
}

/// Get number of days in a month.
/// @param yr i64 Year (needed for February)
/// @param mon i64 Month (1-12)
/// @return days i64 Number of days in the month
/// @example 2024 2 time::days_in_month print  // 29
pub fn days_in_month(yr:i64 mon:i64 -- days:i64) {
	mon 1 == if {
		31
	}
	else {
		mon 2 == if {
			yr is_leap_year if {
				29
			} else {
				28
			}
		}
		else {
			mon 3 == if {
				31
			}
			else {
				mon 4 == if {
					30
				}
				else {
					mon 5 == if {
						31
					}
					else {
						mon 6 == if {
							30
						}
						else {
							mon 7 == if {
								31
							}
							else {
								mon 8 == if {
									31
								}
								else {
									mon 9 == if {
										30
									}
									else {
										mon 10 == if {
											31
										}
										else {
											mon 11 == if {
												30
											}
											else {
												31
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

// Internal: decompose unix timestamp into year, month, day in a single pass.
// Avoids redundant year/month iteration when multiple components are needed.
fn decompose(ts:i64 -- yr:i64 mon:i64 d:i64) {
	1970 -> yr
	ts 0 >= if {
		loop {
			yr is_leap_year if { 366 } else { 365 }
			-> days_in_yr
			days_in_yr 86400 * -> secs_in_yr
			ts secs_in_yr < if { break }
			ts secs_in_yr - -> ts
			yr 1 + -> yr
		}
	} else {
		loop {
			yr 1 - -> yr
			yr is_leap_year if { 366 } else { 365 }
			-> days_in_yr
			days_in_yr 86400 * -> secs_in_yr
			ts secs_in_yr + -> ts
			ts 0 >= if { break }
		}
	}
	// ts is now seconds from start of year
	ts 0 < if { ts 86400 + -> ts }
	1 -> mon
	loop {
		mon 12 > if { break }
		yr mon days_in_month 86400 * -> days_secs
		ts days_secs < if { break }
		ts days_secs - -> ts
		mon 1 + -> mon
	}
	ts 86400 / 1 + -> d
	yr mon d
}

/// Extract year from Unix timestamp.
/// @param ts i64 Unix timestamp in seconds
/// @return yr i64 Year (e.g., 2024)
/// @example time::unix time::year .
pub fn year(ts:i64 -- yr:i64) {
	ts decompose drop drop
}

/// Extract month from Unix timestamp (1-12).
/// @param ts i64 Unix timestamp in seconds
/// @return mon i64 Month (1=January, 12=December)
/// @example time::unix time::month .
pub fn month(ts:i64 -- mon:i64) {
	ts decompose drop nip
}

/// Extract day of month from Unix timestamp (1-31).
/// @param ts i64 Unix timestamp in seconds
/// @return d i64 Day of month
/// @example time::unix time::day .
pub fn day(ts:i64 -- d:i64) {
	ts decompose nip nip
}

/// Extract hour from Unix timestamp (0-23).
/// @param ts i64 Unix timestamp in seconds
/// @return h i64 Hour
/// @example time::unix time::hour .
pub fn hour(ts:i64 -- h:i64) {
	ts 0 < if {
		ts 86400 % 86400 + 86400 % -> ts
	} else {
		ts 86400 % -> ts
	}
	ts 3600 /
}

/// Extract minute from Unix timestamp (0-59).
/// @param ts i64 Unix timestamp in seconds
/// @return m i64 Minute
/// @example time::unix time::minute .
pub fn minute(ts:i64 -- m:i64) {
	ts 0 < if {
		ts 86400 % 86400 + 86400 % -> ts
	} else {
		ts 86400 % -> ts
	}
	ts 3600 % 60 /
}

/// Extract second from Unix timestamp (0-59).
/// @param ts i64 Unix timestamp in seconds
/// @return s i64 Second
/// @example time::unix time::second .
pub fn second(ts:i64 -- s:i64) {
	ts 0 < if {
		ts 60 % 60 + 60 % -> ts
		ts
	} else {
		ts 60 %
	}
}

/// Get day of week from Unix timestamp (0=Sunday, 6=Saturday).
/// @param ts i64 Unix timestamp in seconds
/// @return wd i64 Weekday (0=Sunday)
/// @example time::unix time::weekday .
pub fn weekday(ts:i64 -- wd:i64) {
	// Jan 1, 1970 was Thursday (4)
	ts 86400 / 4 + -> days
	days 0 < if {
		days 7 % 7 + 7 %
	} else {
		days 7 %
	}
}

/// Get day of year from Unix timestamp (1-366).
/// @param ts i64 Unix timestamp in seconds
/// @return yd i64 Day of year
/// @example time::unix time::year_day .
pub fn year_day(ts:i64 -- yd:i64) {
	ts decompose -> d -> mon -> yr
	0 -> total
	1 -> m
	loop {
		m mon >= if { break }
		yr m days_in_month total + -> total
		m 1 + -> m
	}
	total d +
}

/// Create Unix timestamp from date components.
/// @param yr i64 Year
/// @param mon i64 Month (1-12)
/// @param d i64 Day (1-31)
/// @param h i64 Hour (0-23)
/// @param m i64 Minute (0-59)
/// @param s i64 Second (0-59)
/// @return ts i64 Unix timestamp in seconds
/// @example 2024 1 15 12 30 0 time::date .
pub fn date(yr:i64 mon:i64 d:i64 h:i64 m:i64 s:i64 -- ts:i64) {
	0 -> total

	// Add years
	yr 1970 >= if {
		1970 -> y
		loop {
			y yr >= if {
				break
			}
			y is_leap_year if {
				366
			} else {
				365
			}
			86400 * total + -> total
			y 1 + -> y
		}
	} else {
		yr -> y
		loop {
			y 1970 >= if {
				break
			}
			y is_leap_year if {
				366
			} else {
				365
			}
			86400 * total - -> total
			y 1 + -> y
		}
	}

	// Add months
	1 -> mo
	loop {
		mo mon >= if {
			break
		}
		yr mo days_in_month 86400 * total + -> total
		mo 1 + -> mo
	}

	// Add days, hours, minutes, seconds
	d 1 - 86400 * total + -> total
	h 3600 * total + -> total
	m 60 * total + -> total
	s total + -> total

	total
}

/// Add duration to a timestamp.
/// @param ts i64 Timestamp (use time::now for nanoseconds)
/// @param duration i64 Duration to add (use time constants)
/// @return new_ts i64 New timestamp
/// @example time::now time::Day 4 * time::add .
pub fn add(ts:i64 duration:i64 -- new_ts:i64) {
	ts duration +
}

/// Check if timestamp is before another.
/// @param ts1 i64 First timestamp
/// @param ts2 i64 Second timestamp
/// @return before i64 1 if ts1 < ts2, 0 otherwise
/// @example ts1 ts2 time::before .
pub fn before(ts1:i64 ts2:i64 -- before:i64) {
	ts1 ts2 < if {
		1
	} else {
		0
	}
}

/// Check if timestamp is after another.
/// @param ts1 i64 First timestamp
/// @param ts2 i64 Second timestamp
/// @return after i64 1 if ts1 > ts2, 0 otherwise
/// @example ts1 ts2 time::after .
pub fn after(ts1:i64 ts2:i64 -- after:i64) {
	ts1 ts2 > if {
		1
	} else {
		0
	}
}

/// Get difference between two timestamps in seconds.
/// @param ts1 i64 First timestamp
/// @param ts2 i64 Second timestamp
/// @return diff i64 ts1 - ts2 in seconds
/// @example end_time start_time time::sub .
pub fn sub(ts1:i64 ts2:i64 -- diff:i64) {
	ts1 ts2 -
}

/// Check if weekday is a weekend day (Saturday or Sunday).
/// @param wd i64 Weekday (0=Sunday, 6=Saturday)
/// @return is_wknd i64 1 if weekend, 0 otherwise
/// @example time::unix time::weekday time::is_weekend .
pub fn is_weekend(wd:i64 -- is_wknd:i64) {
	wd Sunday == wd Saturday == or
}

/// Check if weekday is a weekday (Monday-Friday).
/// @param wd i64 Weekday (0=Sunday, 6=Saturday)
/// @return is_wkday i64 1 if weekday, 0 otherwise
/// @example time::unix time::weekday time::is_weekday .
pub fn is_weekday(wd:i64 -- is_wkday:i64) {
	wd is_weekend 0 ==
}

/// Get number of days in a year.
/// @param yr i64 Year
/// @return days i64 365 or 366 for leap year
/// @example 2024 time::days_in_year .  // 366
pub fn days_in_year(yr:i64 -- days:i64) {
	yr is_leap_year if { 366 } else { 365 }
}

/// Add days to a timestamp.
/// @param ts i64 Unix timestamp in seconds
/// @param days i64 Number of days to add
/// @return new_ts i64 New timestamp
/// @example time::unix 7 time::add_days .
pub fn add_days(ts:i64 days:i64 -- new_ts:i64) {
	ts days 86400 * +
}

/// Add hours to a timestamp.
/// @param ts i64 Unix timestamp in seconds
/// @param hours i64 Number of hours to add
/// @return new_ts i64 New timestamp
/// @example time::unix 2 time::add_hours .
pub fn add_hours(ts:i64 hours:i64 -- new_ts:i64) {
	ts hours 3600 * +
}

/// Add minutes to a timestamp.
/// @param ts i64 Unix timestamp in seconds
/// @param mins i64 Number of minutes to add
/// @return new_ts i64 New timestamp
/// @example time::unix 30 time::add_minutes .
pub fn add_minutes(ts:i64 mins:i64 -- new_ts:i64) {
	ts mins 60 * +
}

/// Get number of full days between two timestamps.
/// @param ts1 i64 First timestamp in seconds
/// @param ts2 i64 Second timestamp in seconds
/// @return days i64 Number of full days between timestamps (absolute)
/// @example end_ts start_ts time::days_between .
pub fn days_between(ts1:i64 ts2:i64 -- days:i64) {
	ts1 ts2 - -> diff
	diff 0 < if { 0 diff - -> diff }
	diff 86400 /
}

/// Get number of full hours between two timestamps.
/// @param ts1 i64 First timestamp in seconds
/// @param ts2 i64 Second timestamp in seconds
/// @return hours i64 Number of full hours between timestamps (absolute)
/// @example end_ts start_ts time::hours_between .
pub fn hours_between(ts1:i64 ts2:i64 -- hours:i64) {
	ts1 ts2 - -> diff
	diff 0 < if { 0 diff - -> diff }
	diff 3600 /
}

/// Get start of day (midnight) for a timestamp.
/// @param ts i64 Unix timestamp in seconds
/// @return midnight_ts i64 Timestamp at midnight of same day
/// @example time::unix time::start_of_day .
pub fn start_of_day(ts:i64 -- midnight_ts:i64) {
	ts decompose -> d -> mon -> yr
	yr mon d 0 0 0 date
}

/// Get end of day (23:59:59) for a timestamp.
/// @param ts i64 Unix timestamp in seconds
/// @return end_ts i64 Timestamp at 23:59:59 of same day
/// @example time::unix time::end_of_day .
pub fn end_of_day(ts:i64 -- end_ts:i64) {
	ts decompose -> d -> mon -> yr
	yr mon d 23 59 59 date
}

/// Get ISO week number (1-53).
/// @param ts i64 Unix timestamp in seconds
/// @return week i64 ISO week number
/// @example time::unix time::iso_week .
pub fn iso_week(ts:i64 -- week:i64) {
	ts year_day -> yd
	ts weekday -> wd
	// Adjust weekday so Monday=1, Sunday=7
	wd 0 == if { 7 -> wd }
	// ISO week starts Monday, week 1 contains first Thursday
	yd wd - 10 + 7 / -> week
	week 0 < if { 1 -> week }
	week 53 > if { 53 -> week }
	week
}

/// Check if two timestamps are on the same day.
/// @param ts1 i64 First timestamp
/// @param ts2 i64 Second timestamp
/// @return same i64 1 if same day, 0 otherwise
/// @example ts1 ts2 time::same_day .
pub fn same_day(ts1:i64 ts2:i64 -- same:i64) {
	ts1 decompose -> d1 -> mon1 -> yr1
	ts2 decompose -> d2 -> mon2 -> yr2
	yr1 yr2 == mon1 mon2 == and d1 d2 == and
}

/// Get current time in milliseconds since epoch.
/// @return milliseconds i64 Milliseconds since 1970-01-01 00:00:00 UTC
/// @example time::millis -> ms
pub fn millis( -- milliseconds:i64) {
	time::now time::Millisecond /
}

/// Get current time in microseconds since epoch.
/// @return microseconds i64 Microseconds since 1970-01-01 00:00:00 UTC
/// @example time::micros -> us
pub fn micros( -- microseconds:i64) {
	time::now time::Microsecond /
}
