/// Unix signal handling with polling-based API.
///
/// Signals are caught and stored as flags. Use pending() to check
/// if a signal was received, and clear() to reset the flag.
///
/// Example:
///   use signal
///
///   fn main() {
///       signal::SigInt signal::trap
///       "Running. Press Ctrl+C to stop." print nl
///
///       loop {
///           signal::SigInt signal::pending if {
///               "Shutting down" print nl
///               signal::SigInt signal::clear
///               break
///           }
///       }
///   }

/// Hangup signal (terminal closed).
pub const SigHup = 1
/// Interrupt signal (Ctrl+C).
pub const SigInt = 2
/// Quit signal (Ctrl+\).
pub const SigQuit = 3
/// Illegal instruction.
pub const SigIll = 4
/// Abort signal.
pub const SigAbrt = 6
/// Floating point exception.
pub const SigFpe = 8
/// Kill signal (cannot be caught).
pub const SigKill = 9
/// Segmentation fault.
pub const SigSegv = 11
/// Broken pipe.
pub const SigPipe = 13
/// Alarm clock.
pub const SigAlrm = 14
/// Termination signal.
pub const SigTerm = 15
/// User-defined signal 1.
pub const SigUsr1 = 10
/// User-defined signal 2.
pub const SigUsr2 = 12
/// Child process stopped or terminated.
pub const SigChld = 17
/// Continue if stopped.
pub const SigCont = 18
/// Stop signal (cannot be caught).
pub const SigStop = 19
/// Terminal stop (Ctrl+Z).
pub const SigTstp = 20
/// Background read from terminal.
pub const SigTtin = 21
/// Background write to terminal.
pub const SigTtou = 22
import "libqdsignal.a" as "signal" {
	/// Install a handler to catch the specified signal.
	/// After trapping, the signal sets a pending flag instead of
	/// causing the default action (e.g., termination).
	/// @param signum i64 Signal number (use signal::SigInt, etc.)
	/// @example signal::SigInt signal::trap
	pub fn trap(signum:i64 -- )

	/// Ignore the specified signal completely.
	/// @param signum i64 Signal number
	/// @example signal::SigPipe signal::ignore
	pub fn ignore(signum:i64 -- )

	/// Reset signal to default behavior.
	/// @param signum i64 Signal number
	/// @example signal::SigInt signal::reset
	pub fn reset(signum:i64 -- )

	/// Check if a signal is pending (received but not cleared).
	/// Returns 1 if pending, 0 otherwise. Does not clear the flag.
	/// @param signum i64 Signal number
	/// @return flag i64 1 if pending, 0 otherwise
	/// @example signal::SigInt signal::pending
	pub fn pending(signum:i64 -- flag:i64)

	/// Clear the pending flag for a signal.
	/// @param signum i64 Signal number
	/// @example signal::SigInt signal::clear
	pub fn clear(signum:i64 -- )

	/// Block until any trapped signal is received.
	/// Returns the signal number that was received.
	/// @return signum i64 The signal that was received
	/// @example signal::wait -> sig
	pub fn wait( -- signum:i64)
}
