/// Command-line flag parsing.
/// Error codes: Ok=1 (success), specific errors start at 2

/// Error: Flag not found.
pub const ErrNotFound = 2
/// Error: Value not found (flag exists but has no value).
pub const ErrNoValue = 3
/// Error: Invalid value format.
pub const ErrInvalidValue = 4

use strings
use strconv
use unicode

/// Parsed command-line arguments.
/// @field argc i64 Argument count
/// @field argv str Arguments string
pub struct Flag {
	argc:i64
	argv:str
}

/// Parse arguments from read instruction.
/// @param argc i64 Argument count from read
/// @return f Flag Parsed flags
/// @example read flag::parse -> f
pub fn parse(argc:i64 -- f:Flag) {
	"" -> argv
	"" -> arg
	"" -> old_argv
	"" -> prefix
	0 -> iter

	0 argc 1 for it {
		-> arg
		"\n" arg strings::concat -> prefix
		argv -> old_argv
		prefix argv strings::concat -> argv
		iter 0 > if {
			old_argv drop
		}
		prefix drop
		iter 1 + -> iter
	}
	argc 0 > if {
		argv -> old_argv
		argv "\n" strings::concat -> argv
		old_argv drop
	} else {
		"\n" -> argv
	}

	Flag {
		argc = argc
		argv = argv
	}
}

/// Free a Flag struct and its argv string.
/// @example f flag::destroy
pub fn (f:Flag) destroy( -- ) {
	f <<argv drop
	f free
}

/// Check if a boolean flag exists.
/// @param f ptr Flag struct
/// @param name str Flag name (e.g., "--verbose")
/// @return present i64 1 if found, 0 otherwise
/// @example f "--verbose" flag::boolean if { "verbose" print nl }
pub fn (f:Flag) boolean(name:str -- present:i64) {
	"\n" name strings::concat -> pattern
	pattern "\n" strings::concat -> pattern

	f <<argv pattern strings::contains
}

/// Get string value of a flag.
/// @param f ptr Flag struct
/// @param name str Flag name
/// @return value str Flag value
/// @error ErrNotFound Flag not found
/// @error ErrNoValue Flag exists but has no value
/// @example f "--name" flag::string! -> name
pub fn (f:Flag) string(name:str -- value:str)! {
	"" -> value
	"" -> pattern
	"" -> argv
	"" -> tmp
	0 -> idx
	0 -> start
	0 -> end_idx

	"\n" name strings::concat -> pattern
	pattern "\n" strings::concat -> tmp
	tmp -> pattern

	f <<argv pattern strings::index_of -> idx
	idx 0 < if {
		"flag not found: " name strings::concat ErrNotFound panic
	}

	idx 1 + name strings::len + 1 + -> start
	f <<argv -> argv

	argv "\n" start strings::index_of_from -> end_idx
	end_idx 0 < if {
		"flag has no value: " name strings::concat ErrNoValue panic
	}

	argv start end_idx start - strings::substring! -> value
	value
}

/// Get integer value of a flag.
/// @param f ptr Flag struct
/// @param name str Flag name
/// @return value i64 Flag value as integer
/// @error ErrNotFound Flag not found
/// @example f "--count" flag::int! -> count
pub fn (f:Flag) int(name:str -- value:i64)! {
	"" -> s

	f name string if {
		-> s
		s parse_int
	} else {
		drop  // drop unused string from 'string' call
		"flag not found: " name strings::concat ErrNotFound panic
		0
	}
}

/// Get float value of a flag.
/// @param f ptr Flag struct
/// @param name str Flag name
/// @return value f64 Flag value as float
/// @error ErrNotFound Flag not found
/// @example f "--rate" flag::float! -> rate
pub fn (f:Flag) float(name:str -- value:f64)! {
	f name string if {
		-> s
		s parse_float
	} else {
		drop  // drop unused string from 'string' call
		"flag not found: " name strings::concat ErrNotFound panic
		0.0
	}
}

/// Get positional argument at index.
/// @param f ptr Flag struct
/// @param index i64 Position (0-based, skips flags starting with -)
/// @return value str Positional argument
/// @error ErrNotFound Index out of bounds
pub fn (f:Flag) positional(index:i64 -- value:str)! {
	"" -> result
	0 -> pos_idx
	0 -> start
	0 -> end_idx
	0 -> found
	f <<argv -> argv
	argv strings::len -> len

	// Skip initial newline
	1 -> start

	loop {
		start len >= if {
			break
		}

		// Find end of current arg
		argv "\n" start strings::index_of_from -> end_idx
		end_idx 0 < if {
			len -> end_idx
		}

		// Skip empty args
		end_idx start == if {
			start 1 + -> start
			continue
		}

		// Check if this is a flag (starts with -)
		argv start strings::char_at! unicode::minus != if {
			// This is a positional argument
			pos_idx index == if {
				argv start end_idx start - strings::substring! -> result
				1 -> found
				break
			}
			pos_idx 1 + -> pos_idx
		} else {
			// This is a flag - check if it has a value after it
			// Skip the flag, but also skip its value if it doesn't start with -
			end_idx 1 + -> start
			start len < if {
				argv "\n" start strings::index_of_from -> end_idx
				end_idx 0 < if {
					len -> end_idx
				}
				// Check if next arg is a value (not starting with -)
				start end_idx < if {
					argv start strings::char_at! unicode::minus != if {
						// Skip this value too (it belongs to the flag)
						end_idx 1 + -> start
						continue
					}
				}
			}
			continue
		}

		end_idx 1 + -> start
	}

	found 0 == if {
		"positional argument not found at index " index strconv::itoa strings::concat ErrNotFound panic
	}
	result
}

fn parse_int(s:str -- value:i64) {
	0 -> value
	0 -> i
	1 -> sign
	s strings::len -> len

	len 0 > if {
		s 0 strings::char_at! unicode::minus == if {
			-1 -> sign
			1 -> i
		}
	}

	loop {
		i len < if {
			s i strings::char_at! -> ch
			ch unicode::is_digit if {
				value 10 * ch unicode::digit0 - + -> value
				i 1 + -> i
			} else {
				break
			}
		} else {
			break
		}
	}

	value sign *
}

fn parse_float(s:str -- value:f64) {
	0.0 -> value
	0 -> i
	1.0 -> sign
	s strings::len -> len
	0 -> seen_dot
	1.0 -> decimal_place

	len 0 > if {
		s 0 strings::char_at! unicode::minus == if {
			-1.0 -> sign
			1 -> i
		}
	}

	loop {
		i len < if {
			s i strings::char_at! -> ch
			ch unicode::dot == if {
				1 -> seen_dot
				i 1 + -> i
			} else {
				ch unicode::is_digit if {
					seen_dot if {
						decimal_place 10.0 * -> decimal_place
						value ch unicode::digit0 - cast<f64> decimal_place / + -> value
					} else {
						value 10.0 * ch unicode::digit0 - cast<f64> + -> value
					}
					i 1 + -> i
				} else {
					break
				}
			}
		} else {
			break
		}
	}

	value sign *
}
