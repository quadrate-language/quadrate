/// Time operations and duration constants.
/// Duration = 1 nanosecond.
pub const Nanosecond = 1
/// Duration = 1 microsecond (1000 nanoseconds).
pub const Microsecond = 1000
/// Duration = 1 millisecond (1,000,000 nanoseconds).
pub const Millisecond = 1000000
/// Duration = 1 second (1,000,000,000 nanoseconds).
pub const Second = 1000000000
/// Duration = 1 minute (60 seconds).
pub const Minute = 60000000000
/// Duration = 1 hour (60 minutes).
pub const Hour = 3600000000000
/// Duration = 1 day (24 hours).
pub const Day = 86400000000000
/// Duration = 1 week (7 days).
pub const Week = 604800000000000
/// Weekday constants (Sunday=0)
pub const Sunday = 0
pub const Monday = 1
pub const Tuesday = 2
pub const Wednesday = 3
pub const Thursday = 4
pub const Friday = 5
pub const Saturday = 6
/// Month constants (1-indexed)
pub const January = 1
pub const February = 2
pub const March = 3
pub const April = 4
pub const May = 5
pub const June = 6
pub const July = 7
pub const August = 8
pub const September = 9
pub const October = 10
pub const November = 11
pub const December = 12
import "libqdtime.a" as "time" {
	/// Get Unix timestamp in seconds.
	/// @return timestamp i64 Seconds since 1970-01-01 00:00:00 UTC
	/// @example time::unix print  // 1700000000
	pub fn unix( -- timestamp:i64)

	/// Get current time in nanoseconds since epoch.
	/// @return nanoseconds i64 Nanoseconds since 1970-01-01 00:00:00 UTC
	/// @example time::now -> start
	pub fn now( -- nanoseconds:i64)

	/// Sleep for duration in nanoseconds.
	/// @param duration i64 Duration to sleep (use time constants)
	/// @example time::Second time::sleep
	pub fn sleep(duration:i64 -- )
}

// ============================================================
// Date Functions
// ============================================================
/// Check if year is a leap year.
/// @param yr i64 Year to check
/// @return is_leap i64 1 if leap year, 0 otherwise
/// @example 2024 time::is_leap_year print  // 1
pub fn is_leap_year(yr:i64 -- is_leap:i64) {
	-> yr
	yr 400 % 0 == if {
		1
	} else {
		yr 100 % 0 == if {
			0
		} else {
			yr 4 % 0 == if {
				1
			} else {
				0
			}
		}
	}
}

/// Get number of days in a month.
/// @param yr i64 Year (needed for February)
/// @param mon i64 Month (1-12)
/// @return days i64 Number of days in the month
/// @example 2024 2 time::days_in_month print  // 29
pub fn days_in_month(yr:i64 mon:i64 -- days:i64) {
	-> mon
	-> yr
	mon 1 == if {
		31
	}
	else {
		mon 2 == if {
			yr is_leap_year if {
				29
			} else {
				28
			}
		}
		else {
			mon 3 == if {
				31
			}
			else {
				mon 4 == if {
					30
				}
				else {
					mon 5 == if {
						31
					}
					else {
						mon 6 == if {
							30
						}
						else {
							mon 7 == if {
								31
							}
							else {
								mon 8 == if {
									31
								}
								else {
									mon 9 == if {
										30
									}
									else {
										mon 10 == if {
											31
										}
										else {
											mon 11 == if {
												30
											}
											else {
												31
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

/// Extract year from Unix timestamp.
/// @param ts i64 Unix timestamp in seconds
/// @return yr i64 Year (e.g., 2024)
/// @example time::unix time::year .
pub fn year(ts:i64 -- yr:i64) {
	-> ts
	1970 -> yr
	ts 0 >= if {
		// Forward from 1970
		loop {
			yr is_leap_year if {
				366
			} else {
				365
			}
			-> days_in_yr
			days_in_yr 86400 * -> secs_in_yr
			ts secs_in_yr < if {
				break
			}
			ts secs_in_yr - -> ts
			yr 1 + -> yr
		}
	} else {
		// Backward from 1970
		loop {
			yr 1 - -> yr
			yr is_leap_year if {
				366
			} else {
				365
			}
			-> days_in_yr
			days_in_yr 86400 * -> secs_in_yr
			ts secs_in_yr + -> ts
			ts 0 >= if {
				break
			}
		}
	}
	yr
}

/// Extract month from Unix timestamp (1-12).
/// @param ts i64 Unix timestamp in seconds
/// @return mon i64 Month (1=January, 12=December)
/// @example time::unix time::month .
pub fn month(ts:i64 -- mon:i64) {
	-> ts
	ts year -> yr
	// Calculate seconds from start of year
	1970 -> y
	0 -> secs
	ts 0 >= if {
		loop {
			y yr >= if {
				break
			}
			y is_leap_year if {
				366
			} else {
				365
			}
			86400 * secs + -> secs
			y 1 + -> y
		}
	} else {
		yr -> y
		loop {
			y 1970 >= if {
				break
			}
			y 1 - -> y
			y is_leap_year if {
				366
			} else {
				365
			}
			86400 * secs - -> secs
		}
	}
	ts secs - -> remaining
	remaining 0 < if {
		remaining 86400 + -> remaining
	}

	1 -> mon
	loop {
		mon 12 > if {
			break
		}
		yr mon days_in_month 86400 * -> days_secs
		remaining days_secs < if {
			break
		}
		remaining days_secs - -> remaining
		mon 1 + -> mon
	}
	mon
}

/// Extract day of month from Unix timestamp (1-31).
/// @param ts i64 Unix timestamp in seconds
/// @return d i64 Day of month
/// @example time::unix time::day .
pub fn day(ts:i64 -- d:i64) {
	-> ts
	ts year -> yr
	ts month -> mon

	// Calculate seconds from start of year
	1970 -> y
	0 -> secs
	ts 0 >= if {
		loop {
			y yr >= if {
				break
			}
			y is_leap_year if {
				366
			} else {
				365
			}
			86400 * secs + -> secs
			y 1 + -> y
		}
	} else {
		yr -> y
		loop {
			y 1970 >= if {
				break
			}
			y 1 - -> y
			y is_leap_year if {
				366
			} else {
				365
			}
			86400 * secs - -> secs
		}
	}
	ts secs - -> remaining
	remaining 0 < if {
		remaining 86400 + -> remaining
	}

	// Subtract months
	1 -> m
	loop {
		m mon >= if {
			break
		}
		yr m days_in_month 86400 * remaining swap - -> remaining
		m 1 + -> m
	}
	remaining 86400 / 1 +
}

/// Extract hour from Unix timestamp (0-23).
/// @param ts i64 Unix timestamp in seconds
/// @return h i64 Hour
/// @example time::unix time::hour .
pub fn hour(ts:i64 -- h:i64) {
	-> ts
	ts 0 < if {
		ts 86400 % 86400 + 86400 % -> ts
	} else {
		ts 86400 % -> ts
	}
	ts 3600 /
}

/// Extract minute from Unix timestamp (0-59).
/// @param ts i64 Unix timestamp in seconds
/// @return m i64 Minute
/// @example time::unix time::minute .
pub fn minute(ts:i64 -- m:i64) {
	-> ts
	ts 0 < if {
		ts 86400 % 86400 + 86400 % -> ts
	} else {
		ts 86400 % -> ts
	}
	ts 3600 % 60 /
}

/// Extract second from Unix timestamp (0-59).
/// @param ts i64 Unix timestamp in seconds
/// @return s i64 Second
/// @example time::unix time::second .
pub fn second(ts:i64 -- s:i64) {
	-> ts
	ts 0 < if {
		ts 60 % 60 + 60 % -> ts
		ts
	} else {
		ts 60 %
	}
}

/// Get day of week from Unix timestamp (0=Sunday, 6=Saturday).
/// @param ts i64 Unix timestamp in seconds
/// @return wd i64 Weekday (0=Sunday)
/// @example time::unix time::weekday .
pub fn weekday(ts:i64 -- wd:i64) {
	-> ts
	// Jan 1, 1970 was Thursday (4)
	ts 86400 / 4 + -> days
	days 0 < if {
		days 7 % 7 + 7 %
	} else {
		days 7 %
	}
}

/// Get day of year from Unix timestamp (1-366).
/// @param ts i64 Unix timestamp in seconds
/// @return yd i64 Day of year
/// @example time::unix time::year_day .
pub fn year_day(ts:i64 -- yd:i64) {
	-> ts
	ts year -> yr
	ts month -> mon
	ts day -> d

	0 -> total
	1 -> m
	loop {
		m mon >= if {
			break
		}
		yr m days_in_month total + -> total
		m 1 + -> m
	}
	total d +
}

/// Create Unix timestamp from date components.
/// @param yr i64 Year
/// @param mon i64 Month (1-12)
/// @param d i64 Day (1-31)
/// @param h i64 Hour (0-23)
/// @param m i64 Minute (0-59)
/// @param s i64 Second (0-59)
/// @return ts i64 Unix timestamp in seconds
/// @example 2024 1 15 12 30 0 time::date .
pub fn date(yr:i64 mon:i64 d:i64 h:i64 m:i64 s:i64 -- ts:i64) {
	-> s -> m -> h -> d -> mon -> yr

	0 -> total

	// Add years
	yr 1970 >= if {
		1970 -> y
		loop {
			y yr >= if {
				break
			}
			y is_leap_year if {
				366
			} else {
				365
			}
			86400 * total + -> total
			y 1 + -> y
		}
	} else {
		yr -> y
		loop {
			y 1970 >= if {
				break
			}
			y is_leap_year if {
				366
			} else {
				365
			}
			86400 * total - -> total
			y 1 + -> y
		}
	}

	// Add months
	1 -> mo
	loop {
		mo mon >= if {
			break
		}
		yr mo days_in_month 86400 * total + -> total
		mo 1 + -> mo
	}

	// Add days, hours, minutes, seconds
	d 1 - 86400 * total + -> total
	h 3600 * total + -> total
	m 60 * total + -> total
	s total + -> total

	total
}

/// Add duration to a timestamp.
/// @param ts i64 Timestamp (use time::now for nanoseconds)
/// @param duration i64 Duration to add (use time constants)
/// @return new_ts i64 New timestamp
/// @example time::now time::Day 4 * time::add .
pub fn add(ts:i64 duration:i64 -- new_ts:i64) {
	-> duration -> ts
	ts duration +
}

/// Check if timestamp is before another.
/// @param ts1 i64 First timestamp
/// @param ts2 i64 Second timestamp
/// @return before i64 1 if ts1 < ts2, 0 otherwise
/// @example ts1 ts2 time::before .
pub fn before(ts1:i64 ts2:i64 -- before:i64) {
	-> ts2 -> ts1
	ts1 ts2 < if {
		1
	} else {
		0
	}
}

/// Check if timestamp is after another.
/// @param ts1 i64 First timestamp
/// @param ts2 i64 Second timestamp
/// @return after i64 1 if ts1 > ts2, 0 otherwise
/// @example ts1 ts2 time::after .
pub fn after(ts1:i64 ts2:i64 -- after:i64) {
	-> ts2 -> ts1
	ts1 ts2 > if {
		1
	} else {
		0
	}
}

/// Get difference between two timestamps in seconds.
/// @param ts1 i64 First timestamp
/// @param ts2 i64 Second timestamp
/// @return diff i64 ts1 - ts2 in seconds
/// @example end_time start_time time::sub .
pub fn sub(ts1:i64 ts2:i64 -- diff:i64) {
	-> ts2 -> ts1
	ts1 ts2 -
}
