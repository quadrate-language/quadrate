/// Low-level memory allocation and manipulation.
///
/// SAFETY: These are unsafe operations with no bounds checking.
/// Improper use can cause segmentation faults and memory corruption.
import "libqdmem.a" as "mem" {
	/// Allocate memory.
	/// @param bytes i64 Number of bytes to allocate
	/// @return address ptr Allocated memory, or null (0) on failure
	/// @example 1024 mem::alloc -> buf
	pub fn alloc(bytes:i64 -- address:ptr)

	/// Reallocate memory to new size.
	/// @param address ptr Existing allocation (or null for new alloc)
	/// @param new_bytes i64 New size in bytes
	/// @return new_address ptr Reallocated memory, or null on failure
	/// @example buf 2048 mem::realloc -> buf
	pub fn realloc(address:ptr new_bytes:i64 -- new_address:ptr)

	/// Set a byte at offset.
	/// @param value i64 Byte value (0-255)
	/// @param address ptr Base address
	/// @param offset i64 Byte offset from base
	/// @example 65 buf 0 mem::set_byte
	pub fn set_byte(value:i64 address:ptr offset:i64 -- )

	/// Get a byte at offset.
	/// @param address ptr Base address
	/// @param offset i64 Byte offset from base
	/// @return value i64 Byte value (0-255)
	/// @example buf 0 mem::get_byte -> b
	pub fn get_byte(address:ptr offset:i64 -- value:i64)

	/// Set a 64-bit integer at offset.
	/// @param value i64 Integer value
	/// @param address ptr Base address
	/// @param offset i64 Byte offset from base
	/// @example 42 buf 0 mem::set
	pub fn set(value:i64 address:ptr offset:i64 -- )

	/// Get a 64-bit integer at offset.
	/// @param address ptr Base address
	/// @param offset i64 Byte offset from base
	/// @return value i64 Integer value
	/// @example buf 0 mem::get -> n
	pub fn get(address:ptr offset:i64 -- value:i64)

	/// Set a 64-bit float at offset.
	/// @param value f64 Float value
	/// @param address ptr Base address
	/// @param offset i64 Byte offset from base
	/// @example 3.14 buf 0 mem::set_float
	pub fn set_float(value:f64 address:ptr offset:i64 -- )

	/// Get a 64-bit float at offset.
	/// @param address ptr Base address
	/// @param offset i64 Byte offset from base
	/// @return value f64 Float value
	/// @example buf 0 mem::get_float -> x
	pub fn get_float(address:ptr offset:i64 -- value:f64)

	/// Set a pointer at offset.
	/// @param value ptr Pointer value
	/// @param address ptr Base address
	/// @param offset i64 Byte offset from base
	/// @example other_buf buf 0 mem::set_ptr
	pub fn set_ptr(value:ptr address:ptr offset:i64 -- )

	/// Get a pointer at offset.
	/// @param address ptr Base address
	/// @param offset i64 Byte offset from base
	/// @return value ptr Pointer value
	/// @example buf 0 mem::get_ptr -> p
	pub fn get_ptr(address:ptr offset:i64 -- value:ptr)

	/// Copy bytes between memory regions.
	/// @param src ptr Source address
	/// @param dst ptr Destination address
	/// @param bytes i64 Number of bytes to copy
	/// @example src dst 100 mem::copy
	pub fn copy(src:ptr dst:ptr bytes:i64 -- )

	/// Zero out memory region.
	/// @param address ptr Base address
	/// @param bytes i64 Number of bytes to zero
	/// @example buf 1024 mem::zero
	pub fn zero(address:ptr bytes:i64 -- )

	/// Fill memory region with byte value.
	/// @param value i64 Fill value (0-255)
	/// @param address ptr Base address
	/// @param bytes i64 Number of bytes to fill
	/// @example 0xFF buf 1024 mem::fill
	pub fn fill(value:i64 address:ptr bytes:i64 -- )

	/// Convert buffer to string.
	/// @param buffer ptr Source buffer
	/// @param length i64 Number of bytes
	/// @return text str Null-terminated string
	/// @example buf len mem::to_string -> s
	pub fn to_string(buffer:ptr length:i64 -- text:str)

	/// Convert string to buffer.
	/// @param text str Source string
	/// @return buffer ptr Allocated buffer
	/// @return length i64 String length
	/// @example "hello" mem::from_string -> buf -> len
	pub fn from_string(text:str -- buffer:ptr length:i64)
}

/// Free allocated memory.
/// @param address ptr Memory to free (null is safe)
/// @example buf mem::free
pub fn free(address:ptr -- ) {
	free
}

/// Check if pointer is null.
/// @param address ptr Pointer to check
/// @return is_null i64 1 if null, 0 otherwise
/// @example buf mem::is_null .  // 0
pub fn is_null(address:ptr -- is_null:i64) {
	0 eq
}
