/// Unicode character constants and classification.
/// Control: Null character.
pub const nul = 0
/// Control: Tab character.
pub const tab = 9
/// Control: Newline (line feed).
pub const newline = 10
/// Control: Carriage return.
pub const cr = 13
/// Control: Escape character.
pub const esc = 27
/// Punctuation: Space.
pub const space = 32
/// Punctuation: Exclamation mark (!).
pub const exclaim = 33
/// Punctuation: Double quote (").
pub const dquote = 34
/// Punctuation: Hash (#).
pub const hash = 35
/// Punctuation: Dollar sign ($).
pub const dollar = 36
/// Punctuation: Percent (%).
pub const percent = 37
/// Punctuation: Ampersand (&).
pub const ampersand = 38
/// Punctuation: Single quote (').
pub const squote = 39
/// Punctuation: Left parenthesis.
pub const lparen = 40
/// Punctuation: Right parenthesis.
pub const rparen = 41
/// Punctuation: Asterisk (*).
pub const asterisk = 42
/// Punctuation: Plus sign (+).
pub const plus = 43
/// Punctuation: Comma (,).
pub const comma = 44
/// Punctuation: Minus/hyphen (-).
pub const minus = 45
/// Punctuation: Period/dot (.).
pub const dot = 46
/// Punctuation: Forward slash (/).
pub const slash = 47
/// Digit = 0.
pub const digit0 = 48
/// Digit = 1.
pub const digit1 = 49
/// Digit = 2.
pub const digit2 = 50
/// Digit = 3.
pub const digit3 = 51
/// Digit = 4.
pub const digit4 = 52
/// Digit = 5.
pub const digit5 = 53
/// Digit = 6.
pub const digit6 = 54
/// Digit = 7.
pub const digit7 = 55
/// Digit = 8.
pub const digit8 = 56
/// Digit = 9.
pub const digit9 = 57
/// Punctuation: Colon (:).
pub const colon = 58
/// Punctuation: Semicolon (;).
pub const semicolon = 59
/// Punctuation: Less than (<).
pub const lt = 60
/// Punctuation: Equals (=).
pub const equals = 61
/// Punctuation: Greater than (>).
pub const gt = 62
/// Punctuation: Question mark (?).
pub const question = 63
/// Punctuation: At sign (@).
pub const at = 64
/// Letter: Uppercase A.
pub const A = 65
/// Letter: Uppercase B.
pub const B = 66
/// Letter: Uppercase C.
pub const C = 67
/// Letter: Uppercase D.
pub const D = 68
/// Letter: Uppercase E.
pub const E = 69
/// Letter: Uppercase F.
pub const F = 70
/// Letter: Uppercase G.
pub const G = 71
/// Letter: Uppercase H.
pub const H = 72
/// Letter: Uppercase I.
pub const I = 73
/// Letter: Uppercase J.
pub const J = 74
/// Letter: Uppercase K.
pub const K = 75
/// Letter: Uppercase L.
pub const L = 76
/// Letter: Uppercase M.
pub const M = 77
/// Letter: Uppercase N.
pub const N = 78
/// Letter: Uppercase O.
pub const O = 79
/// Letter: Uppercase P.
pub const P = 80
/// Letter: Uppercase Q.
pub const Q = 81
/// Letter: Uppercase R.
pub const R = 82
/// Letter: Uppercase S.
pub const S = 83
/// Letter: Uppercase T.
pub const T = 84
/// Letter: Uppercase U.
pub const U = 85
/// Letter: Uppercase V.
pub const V = 86
/// Letter: Uppercase W.
pub const W = 87
/// Letter: Uppercase X.
pub const X = 88
/// Letter: Uppercase Y.
pub const Y = 89
/// Letter: Uppercase Z.
pub const Z = 90
/// Punctuation: Left bracket ([).
pub const lbracket = 91
/// Punctuation: Backslash (\).
pub const backslash = 92
/// Punctuation: Right bracket (]).
pub const rbracket = 93
/// Punctuation: Caret (^).
pub const caret = 94
/// Punctuation: Underscore (_).
pub const underscore = 95
/// Punctuation: Backtick (`).
pub const backtick = 96
/// Letter: Lowercase a.
pub const a = 97
/// Letter: Lowercase b.
pub const b = 98
/// Letter: Lowercase c.
pub const c = 99
/// Letter: Lowercase d.
pub const d = 100
/// Letter: Lowercase e.
pub const e = 101
/// Letter: Lowercase f.
pub const f = 102
/// Letter: Lowercase g.
pub const g = 103
/// Letter: Lowercase h.
pub const h = 104
/// Letter: Lowercase i.
pub const i = 105
/// Letter: Lowercase j.
pub const j = 106
/// Letter: Lowercase k.
pub const k = 107
/// Letter: Lowercase l.
pub const l = 108
/// Letter: Lowercase m.
pub const m = 109
/// Letter: Lowercase n.
pub const n = 110
/// Letter: Lowercase o.
pub const o = 111
/// Letter: Lowercase p.
pub const p = 112
/// Letter: Lowercase q.
pub const q = 113
/// Letter: Lowercase r.
pub const r = 114
/// Letter: Lowercase s.
pub const s = 115
/// Letter: Lowercase t.
pub const t = 116
/// Letter: Lowercase u.
pub const u = 117
/// Letter: Lowercase v.
pub const v = 118
/// Letter: Lowercase w.
pub const w = 119
/// Letter: Lowercase x.
pub const x = 120
/// Letter: Lowercase y.
pub const y = 121
/// Letter: Lowercase z.
pub const z = 122
/// Punctuation: Left brace ({).
pub const lbrace = 123
/// Punctuation: Pipe (|).
pub const pipe = 124
/// Punctuation: Right brace (}).
pub const rbrace = 125
/// Punctuation: Tilde (~).
pub const tilde = 126

/// Check if character is a digit (0-9).
/// @param c i64 Character code
/// @return result i64 1 if digit, 0 otherwise
/// @example 48 unicode::is_digit print  // 1
pub fn is_digit(c:i64 -- result:i64) {
	c digit0 >= c digit9 <= *
}

/// Check if character is an uppercase letter (A-Z).
/// @param c i64 Character code
/// @return result i64 1 if uppercase, 0 otherwise
/// @example 65 unicode::is_upper print  // 1
pub fn is_upper(c:i64 -- result:i64) {
	c A >= c Z <= *
}

/// Check if character is a lowercase letter (a-z).
/// @param c i64 Character code
/// @return result i64 1 if lowercase, 0 otherwise
/// @example 97 unicode::is_lower print  // 1
pub fn is_lower(c:i64 -- result:i64) {
	c a >= c z <= *
}

/// Check if character is an alphabetic letter (A-Z or a-z).
/// @param c i64 Character code
/// @return result i64 1 if alphabetic, 0 otherwise
/// @example 65 unicode::is_alpha print  // 1
pub fn is_alpha(c:i64 -- result:i64) {
	c is_upper c is_lower or
}

/// Check if character is alphanumeric (A-Z, a-z, or 0-9).
/// @param c i64 Character code
/// @return result i64 1 if alphanumeric, 0 otherwise
/// @example 65 unicode::is_alnum print  // 1
pub fn is_alnum(c:i64 -- result:i64) {
	c is_alpha c is_digit or
}

/// Check if character is whitespace (space, tab, newline, carriage return).
/// @param c i64 Character code
/// @return result i64 1 if whitespace, 0 otherwise
/// @example 32 unicode::is_space print  // 1
pub fn is_space(c:i64 -- result:i64) {
	c space == c tab == or c newline == or c cr == or
}

/// Convert uppercase letter to lowercase.
/// @param c i64 Character code
/// @return result i64 Lowercase character code (unchanged if not uppercase)
/// @example 65 unicode::to_lower print  // 97
pub fn to_lower(c:i64 -- result:i64) {
	c is_upper if {
		c A - a +
	} else {
		c
	}
}

/// Convert lowercase letter to uppercase.
/// @param c i64 Character code
/// @return result i64 Uppercase character code (unchanged if not lowercase)
/// @example 97 unicode::to_upper print  // 65
pub fn to_upper(c:i64 -- result:i64) {
	c is_lower if {
		c a - A +
	} else {
		c
	}
}

/// Check if character is a hexadecimal digit (0-9, A-F, a-f).
/// @param c i64 Character code
/// @return result i64 1 if hex digit, 0 otherwise
/// @example 65 unicode::is_hex_digit print  // 1 (A)
pub fn is_hex_digit(c:i64 -- result:i64) {
	c is_digit
	c A >= c F <= and or
	c a >= c f <= and or
}

/// Check if character is printable (space through tilde, ASCII 32-126).
/// @param c i64 Character code
/// @return result i64 1 if printable, 0 otherwise
/// @example 65 unicode::is_print print  // 1
pub fn is_print(c:i64 -- result:i64) {
	c space >= c tilde <= and
}

/// Check if character is a control character (ASCII 0-31 and 127).
/// @param c i64 Character code
/// @return result i64 1 if control character, 0 otherwise
/// @example 10 unicode::is_control print  // 1 (newline)
pub fn is_control(c:i64 -- result:i64) {
	c 0 >= c 31 <= and
	c 127 == or
}

/// Check if character is punctuation (printable but not alphanumeric or space).
/// @param c i64 Character code
/// @return result i64 1 if punctuation, 0 otherwise
/// @example 33 unicode::is_punct print  // 1 (!)
pub fn is_punct(c:i64 -- result:i64) {
	c is_print
	c is_alnum 0 == and
	c space != and
}

/// Check if character is a valid identifier start (letter or underscore).
/// @param c i64 Character code
/// @return result i64 1 if valid identifier start, 0 otherwise
/// @example 95 unicode::is_ident_start print  // 1 (_)
pub fn is_ident_start(c:i64 -- result:i64) {
	c is_alpha c underscore == or
}

/// Check if character is a valid identifier continuation (letter, digit, or underscore).
/// @param c i64 Character code
/// @return result i64 1 if valid identifier continuation, 0 otherwise
/// @example 95 unicode::is_ident_cont print  // 1 (_)
pub fn is_ident_cont(c:i64 -- result:i64) {
	c is_alnum c underscore == or
}

/// Check if character is ASCII (0-127).
/// @param c i64 Character code
/// @return result i64 1 if ASCII, 0 otherwise
/// @example 65 unicode::is_ascii print  // 1
pub fn is_ascii(c:i64 -- result:i64) {
	c 0 >= c 127 <= and
}

/// Convert digit character to its numeric value.
/// @param c i64 Character code (must be a digit)
/// @return result i64 Numeric value (0-9), or -1 if not a digit
/// @example 53 unicode::digit_value print  // 5
pub fn digit_value(c:i64 -- result:i64) {
	c is_digit if {
		c digit0 -
	} else {
		-1
	}
}

/// Convert hex digit character to its numeric value.
/// @param c i64 Character code (must be a hex digit)
/// @return result i64 Numeric value (0-15), or -1 if not a hex digit
/// @example 65 unicode::hex_digit_value print  // 10 (A)
pub fn hex_digit_value(c:i64 -- result:i64) {
	c is_digit if {
		c digit0 -
	} else {
		c A >= c F <= and if {
			c A - 10 +
		} else {
			c a >= c f <= and if {
				c a - 10 +
			} else {
				-1
			}
		}
	}
}

// ============================================================
// UTF-8 Utilities
// ============================================================

/// Check if byte is a UTF-8 continuation byte (10xxxxxx).
/// @param b i64 Byte value
/// @return result i64 1 if continuation byte, 0 otherwise
/// @example 0x80 unicode::is_utf8_cont print  // 1
pub fn is_utf8_cont(b:i64 -- result:i64) {
	b 0xC0 and 0x80 ==
}

/// Check if byte is the start of a UTF-8 sequence.
/// @param b i64 Byte value
/// @return result i64 1 if start byte, 0 otherwise
/// @example 0xC2 unicode::is_utf8_start print  // 1
pub fn is_utf8_start(b:i64 -- result:i64) {
	b is_utf8_cont 0 ==
}

/// Get the number of bytes in a UTF-8 sequence based on the first byte.
/// Returns 1 for ASCII, 2-4 for multi-byte sequences, 0 for invalid.
/// @param b i64 First byte of UTF-8 sequence
/// @return len i64 Number of bytes (1-4), or 0 if invalid
/// @example 0xC2 unicode::utf8_seq_len print  // 2
pub fn utf8_seq_len(b:i64 -- len:i64) {
	b 0 < b 255 > or if {
		0
	} else {
		b 0x80 < if {
			1  // ASCII
		} else {
			b 0xC0 < if {
				0  // Invalid (continuation byte)
			} else {
				b 0xE0 < if {
					2  // 110xxxxx
				} else {
					b 0xF0 < if {
						3  // 1110xxxx
					} else {
						b 0xF8 < if {
							4  // 11110xxx
						} else {
							0  // Invalid
						}
					}
				}
			}
		}
	}
}

/// Get the number of UTF-8 bytes needed to encode a codepoint.
/// @param cp i64 Unicode codepoint
/// @return len i64 Number of bytes needed (1-4), or 0 if invalid
/// @example 0x00E9 unicode::utf8_encode_len print  // 2 (é)
pub fn utf8_encode_len(cp:i64 -- len:i64) {
	cp 0 < if {
		0
	} else {
		cp 0x80 < if {
			1
		} else {
			cp 0x800 < if {
				2
			} else {
				cp 0x10000 < if {
					3
				} else {
					cp 0x110000 < if {
						4
					} else {
						0  // Invalid (beyond Unicode range)
					}
				}
			}
		}
	}
}

/// Check if a codepoint is valid Unicode.
/// @param cp i64 Codepoint to check
/// @return valid i64 1 if valid, 0 otherwise
/// @example 0x1F600 unicode::is_valid_codepoint print  // 1 (😀)
pub fn is_valid_codepoint(cp:i64 -- valid:i64) {
	cp 0 >= cp 0x10FFFF <= and
	// Also exclude surrogates (0xD800-0xDFFF)
	cp 0xD800 < cp 0xDFFF > or and
}
