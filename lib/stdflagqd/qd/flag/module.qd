// Flag parsing library for Quadrate
//
// Provides functions to parse command-line flags.
//
// Usage:
//   read flag::parse -> f
//   defer { f free }
//   f "--verbose" flag::bool if { "verbose mode" . nl }
//   f "--name" flag::string! { "name=" . . nl }
//   f "--count" flag::int! { } else { 10 }

use str

// Struct to hold parsed arguments
pub struct Flag {
	argc:i64
	argv:str
}

// Parse arguments from read instruction into Flag struct
// Usage: read flag::parse -> f
pub fn parse(argc:i64 -- ) {
	-> argc
	"" -> argv
	"" -> arg
	"" -> old_argv
	"" -> prefix
	0 -> iter

	// Pop args from stack - they come in reverse order, so prepend
	0 argc 1 for {
		-> arg
		// Prepend: \narg + existing argv
		"\n" arg str::concat -> prefix
		argv -> old_argv
		prefix argv str::concat -> argv
		// Free intermediate strings (but not initial empty literal)
		iter 0 > if { old_argv drop }
		prefix drop
		iter 1 + -> iter
	}
	// Add trailing newline
	argc 0 > if {
		argv -> old_argv
		argv "\n" str::concat -> argv
		old_argv drop
	} else {
		"\n" -> argv
	}

	// Create Flag struct - leaves ptr on stack for caller
	argc argv Flag
}

// Free a Flag struct and its argv string
// Usage: f flag::free
pub fn destroy(f:ptr -- ) {
	-> f
	// Free the argv string first
	f @argv drop
	// Then free the struct
	f free
}

// Check if a flag exists in the parsed arguments
// Returns 1 if found, 0 if not
pub fn bool(f:ptr name:str -- present:i64) {
	-> name
	-> f

	// Build search pattern: "\nflag\n"
	"\n" name str::concat -> pattern
	pattern "\n" str::concat -> pattern

	// Search for exact match in argv
	f @argv pattern str::contains
}

// Get string value of a flag from the parsed arguments
// The value is the argument immediately following the flag name
pub fn string(f:ptr name:str -- value:str)! {
	-> name
	-> f
	"" -> value
	"" -> pattern
	"" -> argv
	"" -> tmp
	0 -> idx
	0 -> start
	0 -> end_idx

	// Build search pattern: "\nflag\n"
	"\n" name str::concat -> pattern
	pattern "\n" str::concat -> tmp
	tmp -> pattern

	// Find the flag in argv
	f @argv pattern str::index_of -> idx
	idx 0 < if {
		"flag not found" 1 error
	}

	// Extract value after the flag
	// idx points to the \n before flag, skip \nflag\n to get to value
	idx 1 + name str::len + 1 + -> start
	f @argv -> argv

	// Find end of value (next newline)
	argv "\n" start str::index_of_from -> end_idx
	end_idx 0 < if {
		"value not found" 1 error
	}

	// Extract substring
	argv start end_idx start - str::substring! -> value
	value
}

// Get integer value of a flag from the parsed arguments
pub fn int(f:ptr name:str -- value:i64)! {
	-> name
	-> f
	"" -> s

	// Get string value first, propagate error if not found
	f name string if {
		-> s
		s parse_int
	} else {
		"flag not found" 1 error
		0
	}
}

// Get float value of a flag from the parsed arguments
pub fn float(f:ptr name:str -- value:f64)! {
	-> name
	-> f

	// Get string value first, propagate error if not found
	f name string if {
		-> s
		s parse_float
	} else {
		"flag not found" 1 error
		0.0
	}
}

// Get positional argument at index (0-based, skipping flags starting with -)
// TODO: implement once array access is available
pub fn positional(f:ptr index:i64 -- value:str)! {
	-> index
	-> f
	"positional not yet implemented" 1 error
	""
}

// Helper: parse string to integer
fn parse_int(s:str -- value:i64) {
	-> s
	0 -> value
	0 -> i
	1 -> sign
	s str::len -> len

	len 0 > if {
		s 0 str::char_at 45 == if {
			-1 -> sign
			1 -> i
		}
	}

	loop {
		i len < if {
			s i str::char_at -> ch
			ch 48 >= ch 57 <= and if {
				value 10 * ch 48 - + -> value
				i 1 + -> i
			} else {
				break
			}
		} else {
			break
		}
	}

	value sign *
}

// Helper: parse string to float
fn parse_float(s:str -- value:f64) {
	-> s
	0.0 -> value
	0 -> i
	1.0 -> sign
	s str::len -> len
	0 -> seen_dot
	1.0 -> decimal_place

	len 0 > if {
		s 0 str::char_at 45 == if {
			-1.0 -> sign
			1 -> i
		}
	}

	loop {
		i len < if {
			s i str::char_at -> ch
			ch 46 == if {
				1 -> seen_dot
				i 1 + -> i
			} else {
				ch 48 >= ch 57 <= and if {
					seen_dot if {
						decimal_place 10.0 * -> decimal_place
						value ch 48 - castf decimal_place / + -> value
					} else {
						value 10.0 * ch 48 - castf + -> value
					}
					i 1 + -> i
				} else {
					break
				}
			}
		} else {
			break
		}
	}

	value sign *
}
