// Quadrate Language Reference
// This file defines all keywords and built-in instructions with documentation.
// Used to generate the language reference documentation.
//
// Format:
//   KEYWORD(name, "description")
//   BUILTIN(name, "signature", "description")

// ============================================================================
// KEYWORDS
// ============================================================================

/// Function declaration keyword.
/// @example fn square(x:i64 -- r:i64) { dup * }
KEYWORD(fn, "Declares a function with a stack signature. Its inputs stay on the stack for the body to work on; `def` declares one that binds them to their names instead. Written without a name it is an anonymous function, which follows the same rules.")

/// Public visibility modifier.
/// @example pub fn greet() { "Hello" print nl }
KEYWORD(pub, "Makes a function, constant, or struct visible to other modules.")

/// Constant declaration keyword.
/// @example const PI = 3.14159
KEYWORD(const, "Declares a compile-time constant value.")

/// Module-level mutable global variable. Type annotation is optional.
/// @example var counter = 0    // inferred i64
KEYWORD(var, "Declares a module-level mutable global (type annotation optional; inferred from initializer when omitted).")


/// Struct declaration keyword.
/// @example struct Point { x:f64 y:f64 }
KEYWORD(struct, "Declares a structured data type with named fields.")

/// Packed struct modifier.
/// @example packed struct FileLump { offset:u32 size:u32 name:u64 }
KEYWORD(packed, "Struct modifier: fields laid out adjacent at exact widths, no padding. Used before `struct`.")

/// Function declaration keyword that binds the inputs.
/// @example def area(w:f64 h:f64 -- a:f64) { w h * }
KEYWORD(def, "Declares a function like `fn`, but each named input is bound as a local at entry instead of staying on the stack. Written without a name it is an anonymous function.")

/// Inline function modifier.
/// @example inline fn sq(x:i64 -- y:i64) { dup * }
KEYWORD(inline, "Function modifier: every call is replaced by the function's body. Used before `fn` or `def`.")

/// Enumeration declaration keyword.
/// @example enum Color { Red Green Blue }
KEYWORD(enum, "Declares named integer constants, numbered from 0 and written Color::Red.")

/// Type alias declaration keyword.
/// @example type Score = i64
KEYWORD(type, "Declares another name for a type, accepted wherever the type is. `bool` is a built-in alias for i64.")

/// Test declaration keyword.
/// @example use testing
/// @example test "adds" { 1 2 + 3 testing::assert_eq }
KEYWORD(test, "Declares a named test block, run by quadc --test or quad test.")

/// Module import keyword.
/// @example use strings
KEYWORD(use, "Imports a module, making its functions available with module::function syntax.")

/// C library import keyword.
/// @example import "libmath.a" as "math" { pub fn sin(x:f64 -- y:f64) }
KEYWORD(import, "Imports a C library, declaring its functions with Quadrate signatures.")

/// Conditional execution keyword.
/// @example 5 3 > if { "yes" print }
KEYWORD(if, "Executes a block if the top of stack is true (non-zero).")

/// Alternative branch keyword.
/// @example x 0 > if { "positive" } else { "non-positive" }
KEYWORD(else, "Provides an alternative block when the if condition is false.")

/// Counted loop keyword.
/// @example 0 10 1 for i { i print nl }
KEYWORD(for, "Iterates from start to end with a step, binding the iterator variable.")

/// Infinite loop keyword.
/// @example loop { "forever" print nl }
KEYWORD(loop, "Repeats a block indefinitely until break is called.")

/// Conditional loop exit. Takes a flag and leaves the innermost loop when it is false.
/// @example 0 -> i  loop { i 5 < while  i print nl  i 1 + -> i }
KEYWORD(while, "Inside a loop: takes a flag and leaves the innermost loop when it is false (zero).")

/// Conditional loop exit. Takes a flag and leaves the innermost loop when it is true.
/// @example loop { read_line -> line  line process  line "quit" == until }
KEYWORD(until, "Inside a loop: takes a flag and leaves the innermost loop when it is true (non-zero).")

/// Loop exit keyword.
/// @example loop { x 10 > if { break } }
KEYWORD(break, "Exits the innermost loop immediately.")

/// Loop continuation keyword.
/// @example 0 10 1 for i { i 5 == if { continue } i print nl }
KEYWORD(continue, "Skips to the next iteration of the innermost loop.")

/// Function exit keyword.
/// @example fn early() { true if { return } "not reached" print }
KEYWORD(return, "Exits the current function immediately.")

/// Deferred execution keyword.
/// @example defer { file io::close }
KEYWORD(defer, "Schedules a block to run when the function exits, in LIFO order.")

/// Multi-way branch keyword.
/// @example x switch { 1 { "one" } 2 { "two" } _ { "other" } }
KEYWORD(switch, "Branches based on matching the top of stack against case values.")

/// Wildcard/default case in switch.
/// @example _ { "no match" print }
KEYWORD(_, "Provides a fallback block when no switch case matches.")

/// Local variable binding.
/// @example 42 -> x
KEYWORD(->, "Pops a value from the stack and binds it to a local variable.")

/// Boolean true literal.
/// @example true if { "yes" print }
KEYWORD(true, "Pushes 1 onto the stack.")

/// Boolean false literal.
/// @example false if { } else { "no" print }
KEYWORD(false, "Pushes 0 onto the stack.")

/// Success status constant.
/// @example Ok print  // 0
KEYWORD(Ok, "Pushes 0, the status a fallible call leaves when it succeeded.")

/// Generic error code constant.
/// @example Err print  // 1
KEYWORD(Err, "Pushes 1, the generic error code a fallible call can panic with.")

/// Null pointer literal.
/// @example null -> p
KEYWORD(null, "Pushes the null pointer.")

/// Type narrowing keyword.
/// @example p as Point <<x
KEYWORD(as, "Narrows a ptr to a struct type at compile time, so its fields can be read. Costs nothing at run time.")

// ============================================================================
// STACK OPERATIONS
// ============================================================================

/// Duplicate top of stack.
/// @signature ( x -- x x )
/// @example 5 dup + // 10
BUILTIN(dup, "( x -- x x )", "Copies the top value.")

/// Duplicate top two values.
/// @signature ( x y -- x y x y )
/// @example 1 2 dup2 // Stack: [1, 2, 1, 2]
BUILTIN(dup2, "( x y -- x y x y )", "Copies the top two values.")

/// Remove top of stack.
/// @signature ( x -- )
/// @example 1 2 3 drop // Stack: [1, 2]
BUILTIN(drop, "( x -- )", "Removes the top value.")

/// Swap top two values.
/// @signature ( x y -- y x )
/// @example 1 2 swap // Stack: [2, 1]
BUILTIN(swap, "( x y -- y x )", "Exchanges the top two values.")

/// Copy second value to top.
/// @signature ( x y -- x y x )
/// @example 1 2 over // Stack: [1, 2, 1]
BUILTIN(over, "( x y -- x y x )", "Copies the second value to the top.")

/// Rotate top three values.
/// @signature ( x y z -- y z x )
/// @example 1 2 3 rot // Stack: [2, 3, 1]
BUILTIN(rot, "( x y z -- y z x )", "Moves the third value to the top.")

/// Reverse rotate: the top value goes to the third position.
/// @signature ( x y z -- z x y )
/// @example 1 2 3 rrot  // Stack: 3 1 2
BUILTIN(rrot, "( x y z -- z x y )", "Moves the top value below the next two; the inverse of rot.")

/// Moves the fourth value to the top.
/// @signature ( a b c d -- b c d a )
/// @example 1 2 3 4 rot4  // Stack: 2 3 4 1
BUILTIN(rot4, "( a b c d -- b c d a )", "Moves the fourth value to the top; rot one deeper.")

/// Moves the top value below the next three; the inverse of rot4.
/// @signature ( a b c d -- d a b c )
/// @example 1 2 3 4 rrot4  // Stack: 4 1 2 3
BUILTIN(rrot4, "( a b c d -- d a b c )", "Moves the top value below the next three; the inverse of rot4.")

/// Copy the top value below the second.
/// @signature ( x y -- y x y )
/// @example 1 2 tuck  // Stack: 2 1 2
BUILTIN(tuck, "( x y -- y x y )", "Copies the top value below the second.")

/// Drop the top two values.
/// @signature ( x y -- )
/// @example 1 2 3 drop2  // Stack: 1
BUILTIN(drop2, "( x y -- )", "Removes the top two values.")

/// Remove second value.
/// @signature ( x y -- y )
/// @example 1 2 nip // Stack: [2]
BUILTIN(nip, "( x y -- y )", "Removes the second value.")

/// Copy the third value to the top.
/// @signature ( x y z -- x y z x )
/// @example 1 2 3 pick // 1 2 3 1
BUILTIN(pick, "( x y z -- x y z x )", "Copies the third value to the top.")

// ============================================================================
// ARITHMETIC OPERATIONS
// ============================================================================

/// Addition.
/// @signature ( a b -- sum )
/// @example 3 4 + // 7
BUILTIN(+, "( a b -- sum )", "Adds two numbers.")

/// Subtraction.
/// @signature ( a b -- diff )
/// @example 10 3 - // 7
BUILTIN(-, "( a b -- diff )", "Subtracts b from a.")

/// Multiplication.
/// @signature ( a b -- product )
/// @example 6 7 * // 42
BUILTIN(*, "( a b -- product )", "Multiplies two numbers.")

/// Division.
/// @signature ( a b -- quotient )
/// @example 20 4 / // 5
BUILTIN(/, "( a b -- quotient )", "Divides a by b.")

/// Modulo.
/// @signature ( a b -- remainder )
/// @example 17 5 % // 2
BUILTIN(%, "( a b -- remainder )", "Computes a modulo b.")

/// Negation.
/// @signature ( a -- -a )
/// @example 5 neg // -5
BUILTIN(neg, "( a -- -a )", "Negates a number.")

/// Increment.
/// @signature ( a -- a+1 )
/// @example 5 ++ // 6
BUILTIN(++, "( a -- a+1 )", "Adds 1 to a number.")

/// Decrement.
/// @signature ( a -- a-1 )
/// @example 5 -- // 4
BUILTIN(--, "( a -- a-1 )", "Subtracts 1 from a number.")

// ============================================================================
// COMPARISON OPERATIONS
// ============================================================================

/// Equal.
/// @signature ( a b -- flag )
/// @example 5 5 == // 1
BUILTIN(==, "( a b -- flag )", "Returns 1 if a equals b, 0 otherwise.")

/// Not equal.
/// @signature ( a b -- flag )
/// @example 5 3 != // 1
BUILTIN(!=, "( a b -- flag )", "Returns 1 if a does not equal b, 0 otherwise.")

/// Less than.
/// @signature ( a b -- flag )
/// @example 3 5 < // 1
BUILTIN(<, "( a b -- flag )", "Returns 1 if a is less than b, 0 otherwise.")

/// Less than or equal.
/// @signature ( a b -- flag )
/// @example 5 5 <= // 1
BUILTIN(<=, "( a b -- flag )", "Returns 1 if a is less than or equal to b, 0 otherwise.")

/// Greater than.
/// @signature ( a b -- flag )
/// @example 5 3 > // 1
BUILTIN(>, "( a b -- flag )", "Returns 1 if a is greater than b, 0 otherwise.")

/// Greater than or equal.
/// @signature ( a b -- flag )
/// @example 5 5 >= // 1
BUILTIN(>=, "( a b -- flag )", "Returns 1 if a is greater than or equal to b, 0 otherwise.")

/// Range check.
/// @signature ( a low high -- flag )
/// @example 5 0 10 within // 1
BUILTIN(within, "( a low high -- flag )", "Returns 1 if a is in [low, high], both ends included, 0 otherwise.")

// ============================================================================
// LOGICAL OPERATIONS
//
// These work on truth values: every non-zero value counts as true and the result is
// always 0 or 1. The bitwise operations of the same names are bits::and, bits::or and
// bits::not. Both operands are always evaluated -- these are ordinary stack words, not
// short-circuiting forms.
// ============================================================================

/// Logical AND.
/// @signature ( a b -- flag )
/// @example 1 1 and // 1
/// @example 2 1 and // 1 (any non-zero value is true; bits::and would give 0)
BUILTIN(and, "( a b -- flag )", "Returns 1 if both values are non-zero, 0 otherwise; both are always evaluated. `bits::and` is the bitwise one.")

/// Logical OR.
/// @signature ( a b -- flag )
/// @example 0 0 or // 0
/// @example 2 1 or // 1 (any non-zero value is true; bits::or would give 3)
BUILTIN(or, "( a b -- flag )", "Returns 1 if either value is non-zero, 0 otherwise; both are always evaluated. `bits::or` is the bitwise one.")

/// Logical NOT.
/// @signature ( a -- flag )
/// @example 0 not // 1
/// @example 5 not // 0
BUILTIN(not, "( a -- flag )", "Returns 1 if the value is zero, 0 otherwise. `bits::not` is the bitwise ones' complement.")

// ============================================================================
// ARRAY OPERATIONS
// ============================================================================

/// Get array length.
/// @signature ( arr -- n )
/// @example arr len // number of elements
/// @example "héllo" len // 5
BUILTIN(len, "( arr -- n )", "Returns the number of elements in an array, or of characters in a string.")

/// Get array element.
/// @signature ( arr i -- elem )
/// @example arr 0 nth // first element
/// @example "abc" 1 nth // 98
BUILTIN(nth, "( arr i -- elem )", "Returns the element at index i; in a string, the character there, as its codepoint.")

/// Set array element.
/// @signature ( arr i x -- )
/// @example arr 0 42 set
BUILTIN(set, "( arr i x -- )", "Stores x at index i.")

/// Append to array.
/// @signature ( arr x -- arr )
/// @example arr 42 append -> arr
BUILTIN(append, "( arr x -- arr )", "Appends x and returns the array, which may have moved.")

/// Free array memory.
/// @signature ( p -- )
/// @example arr free
BUILTIN(free, "( p -- )", "Frees an array or a struct.")

// ============================================================================
// STRUCT OPERATIONS
// ============================================================================

/// Shallow-copy a struct or an array.
/// @signature ( x -- x2 )
/// @example p clone -> q
/// @example q 42 >>x drop // p is untouched
/// @example [1 2 3] clone -> b
BUILTIN(clone, "( x -- x2 )", "Returns a shallow copy of a struct or an array: what a field or an element refers to is shared.")

// ============================================================================
// TYPE CASTING
// ============================================================================

/// Cast to type.
/// @signature ( x -- T )
/// @example 3.14 cast<i64> // 3
/// @example 42 cast<f64> // 42.0
/// @example 42 cast<str> // "42"
/// @example 42 cast<d128> // 42
BUILTIN(cast, "( x -- T )", "Converts x to T, written cast<T>: one of i64, f64, d128, ptr and str.")

/// Size of a type.
/// @signature ( -- n )
/// @example sizeof<i64> // 8
BUILTIN(sizeof, "( -- n )", "Returns the size of T in bytes, written sizeof<T>; known at compile time.")

// ============================================================================
// INPUT/OUTPUT
// ============================================================================

/// Print value.
/// @signature ( x -- )
/// @example 42 print
BUILTIN(print, "( x -- )", "Prints a value without a newline.")

/// Print value with type info.
/// @signature ( x -- )
BUILTIN(dump, "( x -- )", "Prints a value with its type, for debugging.")

/// Print newline.
/// @signature ( -- )
/// @example nl
BUILTIN(nl, "( -- )", "Prints a newline.")


// ============================================================================
// ERROR HANDLING
// ============================================================================

/// Get the last error's message and code.
/// @signature ( -- msg code )
/// @example err print nl print nl  // the code, then the message, of the last failed call
BUILTIN(err, "( -- msg code )", "Returns the message and code of the last failed call, and clears them.")

/// Test a fallible call's status for success.
/// @signature ( status -- flag )
/// @example 10 2 divide ok if { print nl } else { drop }
BUILTIN(ok, "( status -- flag )", "Returns 1 if a fallible call's status is Ok (0), and 0 if it is an error code.")

/// Test a fallible call's status for failure.
/// @signature ( status -- flag )
/// @example path load fail if { drop "cannot load" print nl return }
BUILTIN(fail, "( status -- flag )", "Returns 1 if a fallible call's status is an error code, and 0 if it is Ok.")

/// Panic with error message and code.
/// @signature ( msg code -- )
/// @example "invalid input" 1 panic
BUILTIN(panic, "( msg code -- )", "Signals an error and returns from the fallible function.")

// ============================================================================
// COMBINATORS
// ============================================================================
// Each runs function values in a pattern stack code repeats. A `fn { }` written in place before
// one is checked on the real stack and compiled inline.

/// Call a function value.
/// @signature ( q -- ... )
/// @example &foo call  // calls the function foo
BUILTIN(call, "( q -- ... )", "Runs a function value: a fn { } literal, a local holding one, or &name.")

/// Runs q on what is under x, then puts x back.
/// @signature ( ..a x q -- ..b x )
/// @example 10 20 fn { 1 + } dip  // 11 20
BUILTIN(dip, "( ..a x q -- ..b x )", "Runs q on what is under x, then puts x back.")

/// Runs q on x, then puts x back on top.
/// @signature ( ..a x q -- ..b x )
/// @example 2 fn { dup * } keep  // 4 2
BUILTIN(keep, "( ..a x q -- ..b x )", "Runs q on x, then puts x back on top.")

/// Runs q on what is under the top two values, then puts them back.
/// @signature ( ..a x y q -- ..b x y )
/// @example 1 2 3 fn { 10 * } dip2  // 10 2 3
BUILTIN(dip2, "( ..a x y q -- ..b x y )", "Runs q on what is under the top two values, then puts them back.")

/// Runs q on the top two values, then puts them back on top.
/// @signature ( ..a x y q -- ..b x y )
/// @example 2 3 fn { * } keep2  // 6 2 3
BUILTIN(keep2, "( ..a x y q -- ..b x y )", "Runs q on the top two values, then puts them back on top.")

/// Runs p on x, then q on x again, each on what the last left.
/// @signature ( ..a x p q -- ..c )
/// @example 5 fn { 1 + } fn { 2 * } bi  // 6 10
BUILTIN(bi, "( ..a x p q -- ..c )", "Runs p on x, then q on x again, each on what the last left.")

/// Runs p, q and r on x in turn, as bi runs two.
/// @signature ( ..a x p q r -- ..d )
/// @example 5 fn { 1 + } fn { 2 * } fn { 3 - } tri  // 6 10 2
BUILTIN(tri, "( ..a x p q r -- ..d )", "Runs p, q and r on x in turn, as bi runs two.")

/// Runs p on x, with what is under x, then q on y: Factor's bi*.
/// @signature ( ..a x y p q -- ..c )
/// @example 3 4 fn { 1 + } fn { 2 * } bi_star  // 4 8
BUILTIN(bi_star, "( ..a x y p q -- ..c )", "Runs p on x, with what is under x, then q on y: Factor's bi*.")

/// Runs p on x, q on y and r on z, as bi_star runs two.
/// @signature ( ..a x y z p q r -- ..d )
/// @example 1 2 3 fn { 10 * } fn { 20 * } fn { 30 * } tri_star  // 10 40 90
BUILTIN(tri_star, "( ..a x y z p q r -- ..d )", "Runs p on x, q on y and r on z, as bi_star runs two.")

/// Runs q on x, then on y.
/// @signature ( ..a x y q -- ..c )
/// @example 3 4 fn { 10 * } both  // 30 40
BUILTIN(both, "( ..a x y q -- ..c )", "Runs q on x, then on y.")

/// Runs q n times; it must leave the stack as it found it.
/// @signature ( ..a n q -- ..a )
/// @example 1 3 fn { 2 * } times  // 8
BUILTIN(times, "( ..a n q -- ..a )", "Runs q n times; it must leave the stack as it found it.")

/// Runs q with each element of arr on top; it must leave the stack as it found it.
/// @signature ( ..a arr q -- ..a )
/// @example 0 [1 2 3] fn { + } each  // 6
BUILTIN(each, "( ..a arr q -- ..a )", "Runs q with each element, or character of a string, on top; it must leave the stack as it found it.")

/// A new array of what q leaves for each element.
/// @signature ( arr q -- arr2 )
/// @example [1 2 3] fn { dup * } map  // [1 4 9]
BUILTIN(map, "( arr q -- arr2 )", "Returns a new array of what q leaves for each element.")

/// A new array of the elements for which q leaves a true flag.
/// @signature ( arr q -- arr2 )
/// @example [1 2 3 4] fn { 2 mod 0 == } filter  // [2 4]
BUILTIN(filter, "( arr q -- arr2 )", "Returns a new array of the elements q leaves a true flag for.")

/// Runs q on the accumulator and each element in turn, starting from init.
/// @signature ( arr acc q -- acc )
/// @example [1 2 3] 0 fn { + } fold  // 6
BUILTIN(fold, "( arr acc q -- acc )", "Runs q on the accumulator and each element, or character of a string, in turn, starting from acc.")

/// Whether any element satisfies the predicate; stops at the first that does. A string is
/// searched one character (codepoint) at a time.
/// @signature ( arr q -- flag )
/// @example [1 5 12] fn { 10 > } any  // 1
/// @example "a1b" fn { 48 57 within } any  // 1
BUILTIN(any, "( arr q -- flag )", "Returns 1 if q leaves a true flag for any element, or character of a string, stopping at the first that does.")

/// Whether every element satisfies the predicate; stops at the first that does not. A string
/// is searched one character (codepoint) at a time.
/// @signature ( arr q -- flag )
/// @example [1 5 12] fn { 0 > } all  // 1
BUILTIN(all, "( arr q -- flag )", "Returns 1 if q leaves a true flag for every element, or character of a string, stopping at the first that does not.")

/// The first element that satisfies the predicate, and whether there was one. In a string the
/// element is a character's codepoint.
/// @signature ( arr q -- elem flag )
/// @example [1 5 12] fn { 4 > } find  // 5 1
BUILTIN(find, "( arr q -- elem flag )", "Returns the first element, or character of a string, q leaves a true flag for, and 1; or the zero of the element type, and 0.")

/// The position of the first element that satisfies the predicate, or -1. In a string the
/// position is a character index, as strings::char_at counts them.
/// @signature ( arr q -- i )
/// @example [1 5 12] fn { 4 > } index  // 1
/// @example "key=value" fn { 61 == } index  // 3
BUILTIN(index, "( arr q -- i )", "Returns the position of the first element, or character of a string, q leaves a true flag for, or -1.")

/// index from a position: the first match at or after `start`, or -1. A start before the
/// beginning is the beginning.
/// @signature ( arr start q -- i )
/// @example [3 8 5 12] 2 fn { 4 > } scan  // 2
/// @example "a=b=c" 2 fn { 61 == } scan  // 3
BUILTIN(scan, "( arr start q -- i )", "Returns the position of the first element, or character of a string, at or after start that q leaves a true flag for, or -1.")
