/// Quaternion math operations for 3D rotations.
use math

/// Quaternion for representing rotations.
/// Stored as (w, x, y, z) where w is the scalar part.
/// @field w f64 Scalar (real) component
/// @field x f64 X component of vector part
/// @field y f64 Y component of vector part
/// @field z f64 Z component of vector part
pub struct Quat {
	w:f64
	x:f64
	y:f64
	z:f64
}

/// Create identity quaternion (no rotation).
/// @return q Quat Identity quaternion
/// @example quat::identity -> q
pub fn identity( -- q:Quat) {
	Quat {
		w = 1.0
		x = 0.0
		y = 0.0
		z = 0.0
	}
}

/// Create quaternion from components.
/// @param w f64 Scalar component
/// @param x f64 X component
/// @param y f64 Y component
/// @param z f64 Z component
/// @return q Quat New quaternion
/// @example 1.0 0.0 0.0 0.0 quat::new -> q
pub fn new(w:f64 x:f64 y:f64 z:f64 -- q:Quat) {
	-> z_v
	-> y_v
	-> x_v
	-> w_v
	Quat {
		w = w_v
		x = x_v
		y = y_v
		z = z_v
	}
}

/// Quaternion multiplication.
/// @param a Quat First quaternion
/// @param b Quat Second quaternion
/// @return result Quat Product of a and b
/// @example q1 q2 quat::mul -> q3
pub fn mul(a:Quat b:Quat -- result:Quat) {
	-> b
	-> a
	Quat {
		w = a @w b @w * a @x b @x * - a @y b @y * - a @z b @z * -
		x = a @w b @x * a @x b @w * + a @y b @z * + a @z b @y * -
		y = a @w b @y * a @y b @w * + a @z b @x * + a @x b @z * -
		z = a @w b @z * a @z b @w * + a @x b @y * + a @y b @x * -
	}
}

/// Conjugate of quaternion.
/// @param q Quat Input quaternion
/// @return result Quat Conjugate quaternion
/// @example q quat::conjugate -> q_conj
pub fn conjugate(q:Quat -- result:Quat) {
	-> q
	Quat {
		w = q @w
		x = q @x neg
		y = q @y neg
		z = q @z neg
	}
}

/// Length (magnitude) of quaternion.
/// @param q Quat Input quaternion
/// @return result f64 Length of quaternion
/// @example q quat::length -> len
pub fn length(q:Quat -- result:f64) {
	-> q
	q @w q @w * q @x q @x * + q @y q @y * + q @z q @z * + math::sqrt
}

/// Normalize quaternion to unit length.
/// @param q Quat Input quaternion
/// @return result Quat Unit quaternion
/// @example q quat::normalize -> unit_q
pub fn normalize(q:Quat -- result:Quat) {
	-> q
	q length -> mag
	mag 0.0 gt if {
		1.0 mag / -> inv_mag
		Quat {
			w = q @w inv_mag *
			x = q @x inv_mag *
			y = q @y inv_mag *
			z = q @z inv_mag *
		}
	} else {
		identity
	}
}

/// Dot product of two quaternions.
/// @param a Quat First quaternion
/// @param b Quat Second quaternion
/// @return result f64 Dot product
/// @example q1 q2 quat::dot -> d
pub fn dot(a:Quat b:Quat -- result:f64) {
	-> b
	-> a
	a @w b @w * a @x b @x * + a @y b @y * + a @z b @z * +
}
