/// Operating system interface.
/// Error codes: Ok=1 (success), specific errors start at 2

/// Error: No such file or directory.
pub const ErrNotFound = 2
/// Error: Permission denied.
pub const ErrPermission = 3
/// Error: File already exists.
pub const ErrExists = 4
/// Error: Path is not a directory.
pub const ErrNotDirectory = 5
/// Error: Path is a directory.
pub const ErrIsDirectory = 6
/// Error: I/O error.
pub const ErrIo = 7
/// Error: No space left on device.
pub const ErrNoSpace = 8
/// Error: Read-only file system.
pub const ErrReadOnly = 9
/// Error: File name too long.
pub const ErrNameTooLong = 10
/// Error: Out of memory.
pub const ErrOutOfMemory = 11
/// Error: Invalid argument.
pub const ErrInvalidArg = 12

/// Exit code for successful termination.
pub const ExitSuccess = 0
/// Exit code for failed termination.
pub const ExitFailure = 1

import "libos.a" as "os" {
	/// Exit the program with status code.
	/// @param code i64 Exit status (os::ExitSuccess or os::ExitFailure)
	/// @example os::ExitSuccess os::exit
	pub fn exit(code:i64 -- )

	/// Execute a shell command.
	/// @param cmd str Command to execute
	/// @return exitcode i64 Command exit status
	/// @example "ls -la" os::system -> code
	pub fn system(cmd:str -- exitcode:i64)

	/// Get environment variable value.
	/// @param name str Variable name
	/// @return value str Variable value (empty if not set)
	/// @example "HOME" os::getenv -> home
	pub fn getenv(name:str -- value:str)

	/// Set environment variable.
	/// @param name str Variable name
	/// @param value str Variable value
	/// @example "MY_VAR" "hello" os::setenv
	pub fn setenv(name:str value:str -- )

	/// Unset environment variable.
	/// @param name str Variable name to remove
	/// @example "MY_VAR" os::unsetenv
	pub fn unsetenv(name:str -- )

	/// Check if path exists.
	/// @param path str File or directory path
	/// @return exists i64 1 if exists, 0 otherwise
	/// @example "/tmp" os::exists print  // 1
	pub fn exists(path:str -- exists:i64)

	/// Delete a file or empty directory.
	/// @param path str Path to delete
	/// @error ErrNotFound File not found
	/// @error ErrPermission Permission denied
	/// @example "/tmp/test.txt" os::delete!
	pub fn delete(path:str -- )!

	/// Rename or move a file.
	/// @param oldpath str Current path
	/// @param newpath str New path
	/// @error ErrNotFound File not found
	/// @error ErrPermission Permission denied
	/// @example "old.txt" "new.txt" os::rename!
	pub fn rename(oldpath:str newpath:str -- )!

	/// Copy a file.
	/// @param srcpath str Source path
	/// @param dstpath str Destination path
	/// @error ErrNotFound File not found
	/// @error ErrPermission Permission denied
	/// @example "src.txt" "dst.txt" os::copy!
	pub fn copy(srcpath:str dstpath:str -- )!

	/// Create a directory and all parent directories.
	/// @param path str Directory path
	/// @error ErrPermission Permission denied
	/// @example "/tmp/a/b/c" os::mkdir!
	pub fn mkdir(path:str -- )!

	/// List directory contents.
	/// @param path str Directory path
	/// @return entries ptr Array of entry names
	/// @return count i64 Number of entries
	/// @error ErrNotFound File not found
	/// @error ErrNotDirectory Path is not a directory
	/// @example "/tmp" os::list! -> entries -> count
	pub fn list(path:str -- entries:ptr count:i64)!

	/// Execute a command and stream output line-by-line to a callback.
	/// The callback is called synchronously for each line of output (without trailing newline).
	/// The call blocks until the command completes. Closures with captured variables are supported.
	/// @param cmd str Command to execute
	/// @param callback ptr Callback function (line:str -- )
	/// @return exitcode i64 Command exit status
	/// @error ErrIo Failed to execute command
	/// @example "ls -la" fn (line:str -- ) { print nl } os::popen! -> code
	pub fn popen(cmd:str callback:ptr -- exitcode:i64)!

	/// Execute a command and capture all output.
	/// Simpler alternative to os::popen when you just need the full output.
	/// @param cmd str Command to execute
	/// @return stdout str All output from command
	/// @return exitcode i64 Command exit status
	/// @error ErrIo Failed to execute command
	/// @error ErrOutOfMemory Out of memory
	/// @example "echo hello" os::exec! -> exitcode -> stdout
	pub fn exec(cmd:str -- stdout:str exitcode:i64)!

	/// Get the current process ID.
	/// @return pid i64 Process ID
	/// @example os::getpid print nl
	pub fn getpid( -- pid:i64)

	/// Check if path is a directory.
	/// @param path str Path to check
	/// @return is_dir i64 1 if directory, 0 otherwise
	/// @example "/tmp" os::is_dir print  // 1
	pub fn is_dir(path:str -- is_dir:i64)

	/// Check if path is a regular file.
	/// @param path str Path to check
	/// @return is_file i64 1 if regular file, 0 otherwise
	/// @example "/etc/passwd" os::is_file print  // 1
	pub fn is_file(path:str -- is_file:i64)

	/// Remove directory and all contents recursively.
	/// @param path str Directory path to remove
	/// @error ErrNotFound Path not found
	/// @error ErrPermission Permission denied
	/// @example "/tmp/mydir" os::rmdir!
	pub fn rmdir(path:str -- )!

	/// Walk a directory tree recursively.
	/// Calls callback for each file and directory.
	/// @param path str Directory path to walk
	/// @param callback ptr Callback function (path:str is_dir:i64 depth:i64 -- )
	/// @error ErrNotFound Path not found
	/// @error ErrNotDirectory Path is not a directory
	/// @example "/tmp" fn (p:str is_dir:i64 depth:i64 -- ) { p print nl } os::walk!
	pub fn walk(path:str callback:ptr -- )!

	/// Match files using glob pattern.
	/// Supports *, ?, and ** for recursive matching.
	/// @param pattern str Glob pattern
	/// @return entries ptr Array of matching paths
	/// @return count i64 Number of matches
	/// @example "*.qd" os::glob! -> count -> entries
	pub fn glob(pattern:str -- entries:ptr count:i64)!

	/// Create a unique temporary directory.
	/// Creates a directory in /tmp with a unique name.
	/// Caller is responsible for removing it when done (use os::rmdir).
	/// @return path str Path to the created directory
	/// @error ErrIo Failed to create directory
	/// @example os::mktemp! -> tmpdir
	pub fn mktemp( -- path:str)!

	/// Get current working directory.
	/// @return path str Current working directory path
	/// @error ErrIo Failed to get directory
	/// @example os::cwd! -> dir
	pub fn cwd( -- path:str)!

	/// Create a symbolic link.
	/// @param target str Path that the link points to
	/// @param linkpath str Path where the link will be created
	/// @error ErrExists Link path already exists
	/// @error ErrPermission Permission denied
	/// @example "/usr/bin/python3" "/tmp/python" os::symlink!
	pub fn symlink(target:str linkpath:str -- )!

	/// Read the target of a symbolic link.
	/// @param path str Path to the symbolic link
	/// @return target str Path that the link points to
	/// @error ErrNotFound Link not found
	/// @error ErrInvalidArg Path is not a symbolic link
	/// @example "/tmp/mylink" os::readlink! -> target
	pub fn readlink(path:str -- target:str)!

	/// Check if path is a symbolic link.
	/// Does not follow the link to check if the target exists.
	/// @param path str Path to check
	/// @return is_symlink i64 1 if symbolic link, 0 otherwise
	/// @example "/tmp/mylink" os::is_symlink print
	pub fn is_symlink(path:str -- is_symlink:i64)

	/// Change file permissions.
	/// Mode is specified as Unix permission bits (e.g., 0o644, 0o755).
	/// @param path str File or directory path
	/// @param mode i64 Permission mode (e.g., 420 for 0o644)
	/// @error ErrNotFound File not found
	/// @error ErrPermission Permission denied
	/// @example "/tmp/script.sh" 0o755 os::chmod!
	pub fn chmod(path:str mode:i64 -- )!

	/// Change file owner and group.
	/// Use -1 for uid or gid to leave unchanged.
	/// @param path str File or directory path
	/// @param uid i64 User ID (-1 to not change)
	/// @param gid i64 Group ID (-1 to not change)
	/// @error ErrNotFound File not found
	/// @error ErrPermission Permission denied (usually requires root)
	/// @example "/tmp/myfile" 1000 1000 os::chown!
	pub fn chown(path:str uid:i64 gid:i64 -- )!

	/// Get the current user ID.
	/// @return uid i64 Real user ID of the calling process
	/// @example os::getuid print
	pub fn getuid( -- uid:i64)

	/// Get the current group ID.
	/// @return gid i64 Real group ID of the calling process
	/// @example os::getgid print
	pub fn getgid( -- gid:i64)

	/// Get the system hostname.
	/// @return hostname str Hostname of the current system
	/// @error ErrIo Failed to get hostname
	/// @example os::hostname! print
	pub fn hostname( -- hostname:str)!

	/// Change the current working directory.
	/// @param path str Directory path
	/// @error ErrNotFound Directory not found
	/// @error ErrPermission Permission denied
	/// @error ErrNotDirectory Path is not a directory
	/// @example "/tmp" os::chdir!
	pub fn chdir(path:str -- )!
}
