/// SHA-256 cryptographic hash function.
/// Produces a 256-bit (32-byte) hash value.
/// Conforms to FIPS 180-4.
use bits
use bytes
use mem
use str

// Initial hash values
const H0_INIT = 1779033703
const H1_INIT = 3144134277
const H2_INIT = 1013904242
const H3_INIT = 2773480762
const H4_INIT = 1359893119
const H5_INIT = 2600822924
const H6_INIT = 528734635
const H7_INIT = 1541459225

fn make_k_table( -- tbl:ptr) {
	512 mem::alloc -> tbl
	1116352408 tbl 0   mem::set
	1899447441 tbl 8   mem::set
	3049323471 tbl 16  mem::set
	3921009573 tbl 24  mem::set
	961987163 tbl 32  mem::set
	1508970993 tbl 40  mem::set
	2453635748 tbl 48  mem::set
	2870763221 tbl 56  mem::set
	3624381080 tbl 64  mem::set
	310598401 tbl 72  mem::set
	607225278 tbl 80  mem::set
	1426881987 tbl 88  mem::set
	1925078388 tbl 96  mem::set
	2162078206 tbl 104 mem::set
	2614888103 tbl 112 mem::set
	3248222580 tbl 120 mem::set
	3835390401 tbl 128 mem::set
	4022224774 tbl 136 mem::set
	264347078 tbl 144 mem::set
	604807628 tbl 152 mem::set
	770255983 tbl 160 mem::set
	1249150122 tbl 168 mem::set
	1555081692 tbl 176 mem::set
	1996064986 tbl 184 mem::set
	2554220882 tbl 192 mem::set
	2821834349 tbl 200 mem::set
	2952996808 tbl 208 mem::set
	3210313671 tbl 216 mem::set
	3336571891 tbl 224 mem::set
	3584528711 tbl 232 mem::set
	113926993 tbl 240 mem::set
	338241895 tbl 248 mem::set
	666307205 tbl 256 mem::set
	773529912 tbl 264 mem::set
	1294757372 tbl 272 mem::set
	1396182291 tbl 280 mem::set
	1695183700 tbl 288 mem::set
	1986661051 tbl 296 mem::set
	2177026350 tbl 304 mem::set
	2456956037 tbl 312 mem::set
	2730485921 tbl 320 mem::set
	2820302411 tbl 328 mem::set
	3259730800 tbl 336 mem::set
	3345764771 tbl 344 mem::set
	3516065817 tbl 352 mem::set
	3600352804 tbl 360 mem::set
	4094571909 tbl 368 mem::set
	275423344 tbl 376 mem::set
	430227734 tbl 384 mem::set
	506948616 tbl 392 mem::set
	659060556 tbl 400 mem::set
	883997877 tbl 408 mem::set
	958139571 tbl 416 mem::set
	1322822218 tbl 424 mem::set
	1537002063 tbl 432 mem::set
	1747873779 tbl 440 mem::set
	1955562222 tbl 448 mem::set
	2024104815 tbl 456 mem::set
	2227730452 tbl 464 mem::set
	2361852424 tbl 472 mem::set
	2428436474 tbl 480 mem::set
	2756734187 tbl 488 mem::set
	3204031479 tbl 496 mem::set
	3329325298 tbl 504 mem::set
	tbl
}

fn rotr32(x:i64 n:i64 -- result:i64) {
	-> n
	-> x
	x 32 bits::mask -> x
	x n shr x 32 n - shl or 32 bits::mask
}

fn ch(x:i64 y:i64 z:i64 -- result:i64) {
	-> z -> y -> x
	x y and x not z and xor 32 bits::mask
}

fn maj(x:i64 y:i64 z:i64 -- result:i64) {
	-> z -> y -> x
	x y and x z and xor y z and xor 32 bits::mask
}

fn sigma0(x:i64 -- result:i64) {
	-> x
	x 2 rotr32 x 13 rotr32 xor x 22 rotr32 xor
}

fn sigma1(x:i64 -- result:i64) {
	-> x
	x 6 rotr32 x 11 rotr32 xor x 25 rotr32 xor
}

fn gamma0(x:i64 -- result:i64) {
	-> x
	x 7 rotr32 x 18 rotr32 xor x 3 shr xor 32 bits::mask
}

fn gamma1(x:i64 -- result:i64) {
	-> x
	x 17 rotr32 x 19 rotr32 xor x 10 shr xor 32 bits::mask
}

fn add32(a:i64 b:i64 -- result:i64) {
	+ 32 bits::mask
}

fn process_block(msg:ptr block_offset:i64 h:ptr -- ) {
	-> h
	-> block_offset
	-> msg
	make_k_table -> k
	512 mem::alloc -> w

	0 -> i
	loop {
		i 16 >= if {
			break
		}
		msg block_offset i 4 * + bytes::read_u32_be -> word
		word w i 8 * mem::set
		i 1 + -> i
	}

	16 -> i
	loop {
		i 64 >= if {
			break
		}
		w i 2 - 8 * mem::get gamma1 -> s1
		w i 7 - 8 * mem::get -> w7
		w i 15 - 8 * mem::get gamma0 -> s0
		w i 16 - 8 * mem::get -> w16
		s1 w7 add32 s0 add32 w16 add32 -> wi
		wi w i 8 * mem::set
		i 1 + -> i
	}

	h 0 mem::get -> a
	h 8 mem::get -> b
	h 16 mem::get -> c
	h 24 mem::get -> d
	h 32 mem::get -> e
	h 40 mem::get -> f
	h 48 mem::get -> g
	h 56 mem::get -> hh

	0 -> i
	loop {
		i 64 >= if {
			break
		}
		e sigma1 e f g ch add32 hh add32 k i 8 * mem::get add32 w i 8 * mem::get add32 -> t1
		a sigma0 a b c maj add32 -> t2
		hh -> hh2
		g -> hh
		f -> g
		e -> f
		d t1 add32 -> e
		c -> d
		b -> c
		a -> b
		t1 t2 add32 -> a
		i 1 + -> i
	}

	h 0 mem::get a add32 -> new_h0
	h 8 mem::get b add32 -> new_h1
	h 16 mem::get c add32 -> new_h2
	h 24 mem::get d add32 -> new_h3
	h 32 mem::get e add32 -> new_h4
	h 40 mem::get f add32 -> new_h5
	h 48 mem::get g add32 -> new_h6
	h 56 mem::get hh add32 -> new_h7
	new_h0 h 0 mem::set
	new_h1 h 8 mem::set
	new_h2 h 16 mem::set
	new_h3 h 24 mem::set
	new_h4 h 32 mem::set
	new_h5 h 40 mem::set
	new_h6 h 48 mem::set
	new_h7 h 56 mem::set

	w mem::free
	k mem::free
}

// Internal function to calculate hash state
fn calculate_hash_state(dptr:ptr dlen:i64 -- h:ptr) {
	-> dlen
	-> dptr

	64 mem::alloc -> h
	H0_INIT h 0 mem::set
	H1_INIT h 8 mem::set
	H2_INIT h 16 mem::set
	H3_INIT h 24 mem::set
	H4_INIT h 32 mem::set
	H5_INIT h 40 mem::set
	H6_INIT h 48 mem::set
	H7_INIT h 56 mem::set

	dlen 1 + 8 + -> minlen
	minlen 64 + 1 - 64 / 64 * -> padded_len

	padded_len mem::alloc -> msg

	// Copy message using bytes::copy (safe for binary)
	msg 0 dptr 0 dlen bytes::copy

	128 msg dlen mem::set_byte

	dlen 1 + -> i
	loop {
		i padded_len 8 - >= if {
			break
		}
		0 msg i mem::set_byte
		i 1 + -> i
	}

	dlen 8 * -> bitlen
	msg padded_len 8 - 0 bytes::write_u32_be
	msg padded_len 4 - bitlen bytes::write_u32_be

	0 -> block_offset
	loop {
		block_offset padded_len >= if {
			break
		}
		msg block_offset h process_block
		block_offset 64 + -> block_offset
	}

	msg mem::free
	h
}

/// Calculate SHA-256 hash of raw bytes.
/// @param buf ptr Input buffer
/// @param length i64 Length of buffer in bytes
/// @return hash str 64-character hex string (lowercase)
pub fn hash_bytes(buf:ptr length:i64 -- result:str) {
	-> length
	-> buf
	buf length calculate_hash_state -> h

	64 mem::alloc -> out
	0 -> i
	loop {
		i 8 >= if {
			break
		}
		h i 8 * mem::get -> word
		0 -> j
		loop {
			j 8 >= if {
				break
			}
			word 28 j 4 * - shr 15 and -> nibble
			nibble 10 < if {
				48 nibble +
			} else {
				87 nibble +
			}
			-> char
			char out i 8 * j + mem::set_byte
			j 1 + -> j
		}
		i 1 + -> i
	}

	h mem::free
	out 64 mem::to_string -> result
	out mem::free
	result
}

/// Calculate SHA-256 hash of a string.
pub fn hash(s:str -- result:str) {
	-> s
	s mem::from_string -> length -> buf
	buf length hash_bytes -> result
	buf mem::free
	result
}

/// Calculate SHA-256 hash and return as raw 32-byte buffer.
pub fn hash_raw(s:str -- buf:ptr) {
	-> s
	s mem::from_string -> length -> data
	data length calculate_hash_state -> h
	data mem::free

	32 mem::alloc -> buf
	0 -> i
	loop {
		i 8 >= if {
			break
		}
		h i 8 * mem::get -> word
		buf i 4 * word bytes::write_u32_be
		i 1 + -> i
	}
	h mem::free
	buf
}

/// Verify a string against an expected SHA-256 hash.
pub fn verify(s:str expected:str -- ok:i64) {
	-> expected
	-> s
	s hash -> actual
	actual expected str::compare 0 == if {
		1
	} else {
		0
	}
}
