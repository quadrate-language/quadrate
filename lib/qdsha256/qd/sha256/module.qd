/// SHA-256 cryptographic hash function.
/// Produces a 256-bit (32-byte) hash value.
/// Conforms to FIPS 180-4.
use bits
use bytes
use mem
use str

// Initial hash values
const H0_INIT = 1779033703
const H1_INIT = 3144134277
const H2_INIT = 1013904242
const H3_INIT = 2773480762
const H4_INIT = 1359893119
const H5_INIT = 2600822924
const H6_INIT = 528734635
const H7_INIT = 1541459225

fn make_k_table( -- tbl:ptr) {
	512 mem::alloc -> tbl
	tbl 0   1116352408 mem::set
	tbl 8   1899447441 mem::set
	tbl 16  3049323471 mem::set
	tbl 24  3921009573 mem::set
	tbl 32  961987163 mem::set
	tbl 40  1508970993 mem::set
	tbl 48  2453635748 mem::set
	tbl 56  2870763221 mem::set
	tbl 64  3624381080 mem::set
	tbl 72  310598401 mem::set
	tbl 80  607225278 mem::set
	tbl 88  1426881987 mem::set
	tbl 96  1925078388 mem::set
	tbl 104 2162078206 mem::set
	tbl 112 2614888103 mem::set
	tbl 120 3248222580 mem::set
	tbl 128 3835390401 mem::set
	tbl 136 4022224774 mem::set
	tbl 144 264347078 mem::set
	tbl 152 604807628 mem::set
	tbl 160 770255983 mem::set
	tbl 168 1249150122 mem::set
	tbl 176 1555081692 mem::set
	tbl 184 1996064986 mem::set
	tbl 192 2554220882 mem::set
	tbl 200 2821834349 mem::set
	tbl 208 2952996808 mem::set
	tbl 216 3210313671 mem::set
	tbl 224 3336571891 mem::set
	tbl 232 3584528711 mem::set
	tbl 240 113926993 mem::set
	tbl 248 338241895 mem::set
	tbl 256 666307205 mem::set
	tbl 264 773529912 mem::set
	tbl 272 1294757372 mem::set
	tbl 280 1396182291 mem::set
	tbl 288 1695183700 mem::set
	tbl 296 1986661051 mem::set
	tbl 304 2177026350 mem::set
	tbl 312 2456956037 mem::set
	tbl 320 2730485921 mem::set
	tbl 328 2820302411 mem::set
	tbl 336 3259730800 mem::set
	tbl 344 3345764771 mem::set
	tbl 352 3516065817 mem::set
	tbl 360 3600352804 mem::set
	tbl 368 4094571909 mem::set
	tbl 376 275423344 mem::set
	tbl 384 430227734 mem::set
	tbl 392 506948616 mem::set
	tbl 400 659060556 mem::set
	tbl 408 883997877 mem::set
	tbl 416 958139571 mem::set
	tbl 424 1322822218 mem::set
	tbl 432 1537002063 mem::set
	tbl 440 1747873779 mem::set
	tbl 448 1955562222 mem::set
	tbl 456 2024104815 mem::set
	tbl 464 2227730452 mem::set
	tbl 472 2361852424 mem::set
	tbl 480 2428436474 mem::set
	tbl 488 2756734187 mem::set
	tbl 496 3204031479 mem::set
	tbl 504 3329325298 mem::set
	tbl
}

fn rotr32(x:i64 n:i64 -- result:i64) {
	-> n
	-> x
	x 32 bits::mask -> x
	x n shr x 32 n - shl or 32 bits::mask
}

fn ch(x:i64 y:i64 z:i64 -- result:i64) {
	-> z -> y -> x
	x y and x not z and xor 32 bits::mask
}

fn maj(x:i64 y:i64 z:i64 -- result:i64) {
	-> z -> y -> x
	x y and x z and xor y z and xor 32 bits::mask
}

fn sigma0(x:i64 -- result:i64) {
	-> x
	x 2 rotr32 x 13 rotr32 xor x 22 rotr32 xor
}

fn sigma1(x:i64 -- result:i64) {
	-> x
	x 6 rotr32 x 11 rotr32 xor x 25 rotr32 xor
}

fn gamma0(x:i64 -- result:i64) {
	-> x
	x 7 rotr32 x 18 rotr32 xor x 3 shr xor 32 bits::mask
}

fn gamma1(x:i64 -- result:i64) {
	-> x
	x 17 rotr32 x 19 rotr32 xor x 10 shr xor 32 bits::mask
}

fn add32(a:i64 b:i64 -- result:i64) {
	+ 32 bits::mask
}

fn process_block(msg:ptr block_offset:i64 h:ptr -- ) {
	-> h
	-> block_offset
	-> msg
	make_k_table -> k
	512 mem::alloc -> w

	0 -> i
	loop {
		i 16 >= if {
			break
		}
		msg block_offset i 4 * + bytes::read_u32_be -> word
		w i 8 * word mem::set
		i 1 + -> i
	}

	16 -> i
	loop {
		i 64 >= if {
			break
		}
		w i 2 - 8 * mem::get gamma1 -> s1
		w i 7 - 8 * mem::get -> w7
		w i 15 - 8 * mem::get gamma0 -> s0
		w i 16 - 8 * mem::get -> w16
		s1 w7 add32 s0 add32 w16 add32 -> wi
		w i 8 * wi mem::set
		i 1 + -> i
	}

	h 0 mem::get -> a
	h 8 mem::get -> b
	h 16 mem::get -> c
	h 24 mem::get -> d
	h 32 mem::get -> e
	h 40 mem::get -> f
	h 48 mem::get -> g
	h 56 mem::get -> hh

	0 -> i
	loop {
		i 64 >= if {
			break
		}
		e sigma1 e f g ch add32 hh add32 k i 8 * mem::get add32 w i 8 * mem::get add32 -> t1
		a sigma0 a b c maj add32 -> t2
		hh -> hh2
		g -> hh
		f -> g
		e -> f
		d t1 add32 -> e
		c -> d
		b -> c
		a -> b
		t1 t2 add32 -> a
		i 1 + -> i
	}

	h 0 mem::get a add32 -> new_h0
	h 8 mem::get b add32 -> new_h1
	h 16 mem::get c add32 -> new_h2
	h 24 mem::get d add32 -> new_h3
	h 32 mem::get e add32 -> new_h4
	h 40 mem::get f add32 -> new_h5
	h 48 mem::get g add32 -> new_h6
	h 56 mem::get hh add32 -> new_h7
	h 0 new_h0 mem::set
	h 8 new_h1 mem::set
	h 16 new_h2 mem::set
	h 24 new_h3 mem::set
	h 32 new_h4 mem::set
	h 40 new_h5 mem::set
	h 48 new_h6 mem::set
	h 56 new_h7 mem::set

	w mem::free
	k mem::free
}

// Internal function to calculate hash state
fn calculate_hash_state(dptr:ptr dlen:i64 -- h:ptr) {
	-> dlen
	-> dptr

	64 mem::alloc -> h
	h 0 H0_INIT mem::set
	h 8 H1_INIT mem::set
	h 16 H2_INIT mem::set
	h 24 H3_INIT mem::set
	h 32 H4_INIT mem::set
	h 40 H5_INIT mem::set
	h 48 H6_INIT mem::set
	h 56 H7_INIT mem::set

	dlen 1 + 8 + -> minlen
	minlen 64 + 1 - 64 / 64 * -> padded_len

	padded_len mem::alloc -> msg

	// Copy message using bytes::copy (safe for binary)
	msg 0 dptr 0 dlen bytes::copy

	msg dlen 128 mem::set_byte

	dlen 1 + -> i
	loop {
		i padded_len 8 - >= if {
			break
		}
		msg i 0 mem::set_byte
		i 1 + -> i
	}

	dlen 8 * -> bitlen
	msg padded_len 8 - 0 bytes::write_u32_be
	msg padded_len 4 - bitlen bytes::write_u32_be

	0 -> block_offset
	loop {
		block_offset padded_len >= if {
			break
		}
		msg block_offset h process_block
		block_offset 64 + -> block_offset
	}

	msg mem::free
	h
}

/// Calculate SHA-256 hash of raw bytes.
/// @param buf ptr Input buffer
/// @param length i64 Length of buffer in bytes
/// @return hash str 64-character hex string (lowercase)
pub fn hash_bytes(buf:ptr length:i64 -- result:str) {
	-> length
	-> buf
	buf length calculate_hash_state -> h

	64 mem::alloc -> out
	0 -> i
	loop {
		i 8 >= if {
			break
		}
		h i 8 * mem::get -> word
		0 -> j
		loop {
			j 8 >= if {
				break
			}
			word 28 j 4 * - shr 15 and -> nibble
			nibble 10 < if {
				48 nibble +
			} else {
				87 nibble +
			}
			-> char
			out i 8 * j + char mem::set_byte
			j 1 + -> j
		}
		i 1 + -> i
	}

	h mem::free
	out 64 mem::to_string -> result
	out mem::free
	result
}

/// Calculate SHA-256 hash of a string.
pub fn hash(s:str -- result:str) {
	-> s
	s mem::from_string -> length -> buf
	buf length hash_bytes -> result
	buf mem::free
	result
}

/// Calculate SHA-256 hash and return as raw 32-byte buffer.
pub fn hash_raw(s:str -- buf:ptr) {
	-> s
	s mem::from_string -> length -> data
	data length calculate_hash_state -> h
	data mem::free

	32 mem::alloc -> buf
	0 -> i
	loop {
		i 8 >= if {
			break
		}
		h i 8 * mem::get -> word
		buf i 4 * word bytes::write_u32_be
		i 1 + -> i
	}
	h mem::free
	buf
}

/// Verify a string against an expected SHA-256 hash.
pub fn verify(s:str expected:str -- ok:i64) {
	-> expected
	-> s
	s hash -> actual
	actual expected str::compare 0 == if {
		1
	} else {
		0
	}
}
