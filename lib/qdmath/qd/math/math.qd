/// Mathematical functions and constants.

/// Mathematical constant Pi (π).
pub const Pi = 3.141592653589793238
/// Euler's number (e).
pub const E = 2.718281828459045235
/// Tau = 2π (full circle in radians).
pub const Tau = 6.283185307179586477
/// Golden ratio φ = (1 + √5) / 2.
pub const Phi = 1.618033988749894848
/// Square root of 2.
pub const Sqrt2 = 1.414213562373095049
/// Square root of 3.
pub const Sqrt3 = 1.732050807568877294
/// Natural logarithm of 2.
pub const Ln2 = 0.693147180559945309
/// Natural logarithm of 10.
pub const Ln10 = 2.302585092994045684
/// Base-2 logarithm of e.
pub const Log2E = 1.442695040888963407
/// Base-10 logarithm of e.
pub const Log10E = 0.434294481903251828
import "libqdmath.a" as "math" {
	/// Sine of angle in radians.
	/// @param x f64 Angle in radians
	/// @return result f64 Sine value [-1, 1]
	/// @example 0.0 math::sin print  // 0.0
	pub fn sin(x:f64 -- result:f64)

	/// Cosine of angle in radians.
	/// @param x f64 Angle in radians
	/// @return result f64 Cosine value [-1, 1]
	/// @example 0.0 math::cos print  // 1.0
	pub fn cos(x:f64 -- result:f64)

	/// Tangent of angle in radians.
	/// @param x f64 Angle in radians
	/// @return result f64 Tangent value
	/// @example 0.0 math::tan print  // 0.0
	pub fn tan(x:f64 -- result:f64)

	/// Arc sine (inverse sine).
	/// @param x f64 Value in range [-1, 1]
	/// @return result f64 Angle in radians [-π/2, π/2]
	/// @example 0.0 math::asin print  // 0.0
	pub fn asin(x:f64 -- result:f64)

	/// Arc cosine (inverse cosine).
	/// @param x f64 Value in range [-1, 1]
	/// @return result f64 Angle in radians [0, π]
	/// @example 1.0 math::acos print  // 0.0
	pub fn acos(x:f64 -- result:f64)

	/// Arc tangent (inverse tangent).
	/// @param x f64 Any value
	/// @return result f64 Angle in radians [-π/2, π/2]
	/// @example 0.0 math::atan print  // 0.0
	pub fn atan(x:f64 -- result:f64)

	/// Two-argument arc tangent.
	/// Returns the angle in radians between the positive x-axis and the point (x, y).
	/// More useful than atan for computing angles because it handles all quadrants.
	/// @param y f64 Y coordinate
	/// @param x f64 X coordinate
	/// @return result f64 Angle in radians [-π, π]
	/// @example 1.0 1.0 math::atan2 print  // ~0.785 (π/4)
	pub fn atan2(y:f64 x:f64 -- result:f64)

	/// Square root.
	/// @param x f64 Non-negative value
	/// @return result f64 Square root of x
	/// @example 4.0 math::sqrt print  // 2.0
	pub fn sqrt(x:f64 -- result:f64)

	/// Cube root.
	/// @param x f64 Any value
	/// @return result f64 Cube root of x
	/// @example 8.0 math::cbrt print  // 2.0
	pub fn cbrt(x:f64 -- result:f64)

	/// Power function.
	/// @param base f64 Base value
	/// @param exp f64 Exponent
	/// @return result f64 base raised to exp
	/// @example 2.0 3.0 math::pow print  // 8.0
	pub fn pow(base:f64 exp:f64 -- result:f64)

	/// Exponential function (e^x).
	/// @param x f64 Exponent value
	/// @return result f64 e raised to x
	/// @example 1.0 math::exp print  // ~2.718 (e)
	pub fn exp(x:f64 -- result:f64)

	/// Hypotenuse (Euclidean distance).
	/// Computes sqrt(x² + y²) without intermediate overflow or underflow.
	/// @param x f64 First value
	/// @param y f64 Second value
	/// @return result f64 sqrt(x² + y²)
	/// @example 3.0 4.0 math::hypot print  // 5.0
	pub fn hypot(x:f64 y:f64 -- result:f64)

	/// Natural logarithm (base e).
	/// @param x f64 Positive value
	/// @return result f64 Natural log of x
	/// @example 2.718281828 math::ln print  // ~1.0
	pub fn ln(x:f64 -- result:f64)

	/// Base-10 logarithm.
	/// @param x f64 Positive value
	/// @return result f64 Log base 10 of x
	/// @example 100.0 math::log10 print  // 2.0
	pub fn log10(x:f64 -- result:f64)

	/// Ceiling (round up).
	/// @param x f64 Any value
	/// @return result f64 Smallest integer >= x
	/// @example 2.3 math::ceil print  // 3.0
	pub fn ceil(x:f64 -- result:f64)

	/// Floor (round down).
	/// @param x f64 Any value
	/// @return result f64 Largest integer <= x
	/// @example 2.7 math::floor print  // 2.0
	pub fn floor(x:f64 -- result:f64)

	/// Round to nearest integer.
	/// @param x f64 Any value
	/// @return result f64 Nearest integer to x
	/// @example 2.5 math::round print  // 3.0
	pub fn round(x:f64 -- result:f64)

	/// Floating-point modulo (remainder).
	/// Returns the remainder of x/y with the same sign as x.
	/// @param x f64 Dividend
	/// @param y f64 Divisor (non-zero)
	/// @return result f64 Remainder of x/y
	/// @example 5.5 2.0 math::fmod print  // 1.5
	pub fn fmod(x:f64 y:f64 -- result:f64)

	/// Hyperbolic sine.
	/// @param x f64 Any value
	/// @return result f64 Hyperbolic sine of x
	/// @example 1.0 math::sinh print  // ~1.175
	pub fn sinh(x:f64 -- result:f64)

	/// Hyperbolic cosine.
	/// @param x f64 Any value
	/// @return result f64 Hyperbolic cosine of x
	/// @example 0.0 math::cosh print  // 1.0
	pub fn cosh(x:f64 -- result:f64)

	/// Hyperbolic tangent.
	/// @param x f64 Any value
	/// @return result f64 Hyperbolic tangent of x [-1, 1]
	/// @example 0.0 math::tanh print  // 0.0
	pub fn tanh(x:f64 -- result:f64)

	/// Inverse hyperbolic sine.
	/// @param x f64 Any value
	/// @return result f64 Inverse hyperbolic sine of x
	/// @example 0.0 math::asinh print  // 0.0
	pub fn asinh(x:f64 -- result:f64)

	/// Inverse hyperbolic cosine.
	/// @param x f64 Value >= 1
	/// @return result f64 Inverse hyperbolic cosine of x
	/// @example 1.0 math::acosh print  // 0.0
	pub fn acosh(x:f64 -- result:f64)

	/// Inverse hyperbolic tangent.
	/// @param x f64 Value in range (-1, 1)
	/// @return result f64 Inverse hyperbolic tangent of x
	/// @example 0.0 math::atanh print  // 0.0
	pub fn atanh(x:f64 -- result:f64)

	/// Base-2 logarithm.
	/// @param x f64 Positive value
	/// @return result f64 Log base 2 of x
	/// @example 8.0 math::log2 print  // 3.0
	pub fn log2(x:f64 -- result:f64)

	/// Exponential base 2 (2^x).
	/// @param x f64 Exponent
	/// @return result f64 2 raised to x
	/// @example 3.0 math::exp2 print  // 8.0
	pub fn exp2(x:f64 -- result:f64)

	/// Truncate toward zero.
	/// @param x f64 Any value
	/// @return result f64 Integer part of x (toward zero)
	/// @example -2.7 math::trunc print  // -2.0
	pub fn trunc(x:f64 -- result:f64)
}

/// Square a number.
/// @param x f64 Value to square
/// @return result f64 x * x
/// @example 3.0 math::sq print  // 9.0
pub fn sq(x:f64 -- result:f64) {
	dup mul
}

/// Cube a number.
/// @param x f64 Value to cube
/// @return result f64 x * x * x
/// @example 2.0 math::cb print  // 8.0
pub fn cb(x:f64 -- result:f64) {
	dup dup mul mul
}

/// Absolute value.
/// @param x f64 Any value
/// @return result f64 |x|
/// @example -5.0 math::abs print  // 5.0
pub fn abs(x:f64 -- result:f64) {
	dup 0.0 lt if {
		neg
	}
}

/// Reciprocal (1/x).
/// @param x f64 Non-zero value
/// @return result f64 1/x
/// @example 4.0 math::inv print  // 0.25
pub fn inv(x:f64 -- result:f64) {
	1.0 swap div
}

/// Factorial (n!).
/// @param n i64 Non-negative integer
/// @return result i64 n!
/// @example 5 math::fac print  // 120
pub fn fac(n:i64 -- result:i64) {
	-> n_v
	1 -> res
	1 n_v 1 + 1 for it {
		res it * -> res
	}
	res
}

/// Minimum of two values.
/// @param a any First value
/// @param b any Second value
/// @return result any Smaller of a and b
/// @example 3 7 math::min print  // 3
pub fn min(a:any b:any -- result:any) {
	over over lt if {
		drop
	} else {
		nip
	}
}

/// Maximum of two values.
/// @param a any First value
/// @param b any Second value
/// @return result any Larger of a and b
/// @example 3 7 math::max print  // 7
pub fn max(a:any b:any -- result:any) {
	over over gt if {
		drop
	} else {
		nip
	}
}

/// Logarithm with arbitrary base.
/// @param x f64 Positive value
/// @param base f64 Logarithm base
/// @return result f64 log_base(x)
/// @example 8.0 2.0 math::log print  // 3.0
pub fn log(x:f64 base:f64 -- result:f64) {
	-> base -> x
	x math::ln base math::ln /
}

/// Clamp value to range.
/// @param x f64 Value to clamp
/// @param min_val f64 Minimum bound
/// @param max_val f64 Maximum bound
/// @return result f64 x clamped to [min_val, max_val]
/// @example 15.0 0.0 10.0 math::clamp print  // 10.0
pub fn clamp(x:f64 min_val:f64 max_val:f64 -- result:f64) {
	-> max_v
	-> min_v
	-> x_v
	x_v max_v < if {
		x_v
	} else {
		max_v
	}
	-> temp
	temp min_v > if {
		temp
	} else {
		min_v
	}
}

/// Check if value is within range (inclusive).
/// @param x any Value to check
/// @param min_val any Minimum bound
/// @param max_val any Maximum bound
/// @return result i64 1 if in range, 0 otherwise
/// @example 5 0 10 math::within print  // 1
pub fn within(x:any min_val:any max_val:any -- result:i64) {
	-> max_v
	-> min_v
	-> x_v
	x_v min_v gte if {
		x_v max_v lte if {
			1
		} else {
			0
		}
	} else {
		0
	}
}

/// Linear interpolation between two values.
/// @param a f64 Start value
/// @param b f64 End value
/// @param t f64 Interpolation factor [0, 1]
/// @return result f64 a + (b - a) * t
/// @example 0.0 10.0 0.5 math::lerp print  // 5.0
pub fn lerp(a:f64 b:f64 t:f64 -- result:f64) {
	-> t_v
	-> b_v
	-> a_v
	b_v a_v - t_v * a_v +
}

/// Convert degrees to radians.
/// @param degrees f64 Angle in degrees
/// @return radians f64 Angle in radians
/// @example 180.0 math::deg_to_rad print  // ~3.14159
pub fn deg_to_rad(degrees:f64 -- radians:f64) {
	3.141592653589793 180 div mul
}

/// Convert radians to degrees.
/// @param radians f64 Angle in radians
/// @return degrees f64 Angle in degrees
/// @example 3.141592653589793 math::rad_to_deg print  // 180.0
pub fn rad_to_deg(radians:f64 -- degrees:f64) {
	180 mul 3.141592653589793 div
}


// ============================================================================
// Vec2 - 2D vector math operations
// ============================================================================

/// 2D vector with x and y components.
/// @field x f64 X component
/// @field y f64 Y component
pub struct Vec2 {
	x:f64
	y:f64
}

/// Create a Vec2 with all components set to zero.
/// @return v Vec2 Zero vector (0, 0)
/// @example math::vec2_zero -> v
pub fn vec2_zero( -- v:Vec2) {
	Vec2 {
		x = 0.0
		y = 0.0
	}
}

/// Create a Vec2 with all components set to one.
/// @return v Vec2 One vector (1, 1)
/// @example math::vec2_one -> v
pub fn vec2_one( -- v:Vec2) {
	Vec2 {
		x = 1.0
		y = 1.0
	}
}

/// Add another Vec2 to this vector.
/// @param other Vec2 Vector to add
/// @return result Vec2 Sum of vectors
/// @example other v add -> sum
pub fn (v:Vec2) add(other:Vec2 -- result:Vec2) {
	-> other
	Vec2 {
		x = v @x other @x +
		y = v @y other @y +
	}
}

/// Subtract another Vec2 from this vector.
/// @param other Vec2 Vector to subtract
/// @return result Vec2 Difference of vectors
/// @example other v subtract -> diff
pub fn (v:Vec2) subtract(other:Vec2 -- result:Vec2) {
	-> other
	Vec2 {
		x = v @x other @x -
		y = v @y other @y -
	}
}

/// Multiply this vector by a scalar.
/// @param s f64 Scalar multiplier
/// @return result Vec2 Scaled vector
/// @example 2.0 v scale -> scaled
pub fn (v:Vec2) scale(s:f64 -- result:Vec2) {
	-> s
	Vec2 {
		x = v @x s *
		y = v @y s *
	}
}

/// Dot product with another Vec2.
/// @param other Vec2 Other vector
/// @return result f64 Dot product
/// @example other v dot -> d
pub fn (v:Vec2) dot(other:Vec2 -- result:f64) {
	-> other
	v @x other @x * v @y other @y * +
}

/// Length (magnitude) of this vector.
/// @return result f64 Length of vector
/// @example v length -> len
pub fn (v:Vec2) length( -- result:f64) {
	v @x v @x * v @y v @y * + math::sqrt
}

/// Squared length of this vector (avoids sqrt).
/// @return result f64 Squared length of vector
/// @example v length_sq -> len_sq
pub fn (v:Vec2) length_sq( -- result:f64) {
	v @x v @x * v @y v @y * +
}

/// Normalize this vector to unit length.
/// @return result Vec2 Unit vector in same direction
/// @example v normalize -> unit
pub fn (v:Vec2) normalize( -- result:Vec2) {
	v @x v @x * v @y v @y * + math::sqrt -> mag
	mag 0.0 gt if {
		1.0 mag / -> inv_mag
		Vec2 {
			x = v @x inv_mag *
			y = v @y inv_mag *
		}
	} else {
		vec2_zero
	}
}

/// Negate this vector.
/// @return result Vec2 Negated vector
/// @example v neg -> neg_v
pub fn (v:Vec2) neg( -- result:Vec2) {
	Vec2 {
		x = v @x neg
		y = v @y neg
	}
}

/// Linear interpolation to another Vec2.
/// @param other Vec2 End vector
/// @param t f64 Interpolation factor (0.0 to 1.0)
/// @return result Vec2 Interpolated vector
/// @example other 0.5 v lerp -> mid
pub fn (v:Vec2) lerp(other:Vec2 t:f64 -- result:Vec2) {
	-> t
	-> other
	Vec2 {
		x = v @x other @x v @x - t * +
		y = v @y other @y v @y - t * +
	}
}

/// Distance to another Vec2.
/// @param other Vec2 Other point
/// @return result f64 Distance between points
/// @example other v distance -> d
pub fn (v:Vec2) distance(other:Vec2 -- result:f64) {
	-> other
	v @x other @x - dup * v @y other @y - dup * + math::sqrt
}

/// Angle of this vector from positive X axis.
/// @return result f64 Angle in radians [-π, π]
/// @example v angle -> a
pub fn (v:Vec2) angle( -- result:f64) {
	v @y v @x math::atan2
}

/// Rotate this vector by an angle.
/// @param angle f64 Rotation angle in radians
/// @return result Vec2 Rotated vector
/// @example 1.57 v rotate -> rotated
pub fn (v:Vec2) rotate(angle:f64 -- result:Vec2) {
	-> angle
	angle math::cos -> c
	angle math::sin -> s
	Vec2 {
		x = v @x c * v @y s * -
		y = v @x s * v @y c * +
	}
}

/// Get perpendicular vector (90° counterclockwise rotation).
/// @return result Vec2 Perpendicular vector
/// @example v perpendicular -> perp
pub fn (v:Vec2) perpendicular( -- result:Vec2) {
	Vec2 {
		x = v @y neg
		y = v @x
	}
}

// ============================================================================
// Vec3 - 3D vector math operations
// ============================================================================

/// 3D vector with x, y, and z components.
/// @field x f64 X component
/// @field y f64 Y component
/// @field z f64 Z component
pub struct Vec3 {
	x:f64
	y:f64
	z:f64
}

/// Create a Vec3 with all components set to zero.
/// @return v Vec3 Zero vector (0, 0, 0)
/// @example math::vec3_zero -> v
pub fn vec3_zero( -- v:Vec3) {
	Vec3 {
		x = 0.0
		y = 0.0
		z = 0.0
	}
}

/// Create a Vec3 with all components set to one.
/// @return v Vec3 One vector (1, 1, 1)
/// @example math::vec3_one -> v
pub fn vec3_one( -- v:Vec3) {
	Vec3 {
		x = 1.0
		y = 1.0
		z = 1.0
	}
}

/// Unit vector along the X axis.
/// @return v Vec3 Unit X vector (1, 0, 0)
/// @example math::vec3_unit_x -> v
pub fn vec3_unit_x( -- v:Vec3) {
	Vec3 {
		x = 1.0
		y = 0.0
		z = 0.0
	}
}

/// Unit vector along the Y axis.
/// @return v Vec3 Unit Y vector (0, 1, 0)
/// @example math::vec3_unit_y -> v
pub fn vec3_unit_y( -- v:Vec3) {
	Vec3 {
		x = 0.0
		y = 1.0
		z = 0.0
	}
}

/// Unit vector along the Z axis.
/// @return v Vec3 Unit Z vector (0, 0, 1)
/// @example math::vec3_unit_z -> v
pub fn vec3_unit_z( -- v:Vec3) {
	Vec3 {
		x = 0.0
		y = 0.0
		z = 1.0
	}
}

/// Add another Vec3 to this vector.
/// @param other Vec3 Vector to add
/// @return result Vec3 Sum of vectors
/// @example other v add -> sum
pub fn (v:Vec3) add(other:Vec3 -- result:Vec3) {
	-> other
	Vec3 {
		x = v @x other @x +
		y = v @y other @y +
		z = v @z other @z +
	}
}

/// Subtract another Vec3 from this vector.
/// @param other Vec3 Vector to subtract
/// @return result Vec3 Difference of vectors
/// @example other v subtract -> diff
pub fn (v:Vec3) subtract(other:Vec3 -- result:Vec3) {
	-> other
	Vec3 {
		x = v @x other @x -
		y = v @y other @y -
		z = v @z other @z -
	}
}

/// Multiply this vector by a scalar.
/// @param s f64 Scalar multiplier
/// @return result Vec3 Scaled vector
/// @example 2.0 v scale -> scaled
pub fn (v:Vec3) scale(s:f64 -- result:Vec3) {
	-> s
	Vec3 {
		x = v @x s *
		y = v @y s *
		z = v @z s *
	}
}

/// Dot product with another Vec3.
/// @param other Vec3 Other vector
/// @return result f64 Dot product
/// @example other v dot -> d
pub fn (v:Vec3) dot(other:Vec3 -- result:f64) {
	-> other
	v @x other @x * v @y other @y * + v @z other @z * +
}

/// Cross product with another Vec3.
/// @param other Vec3 Other vector
/// @return result Vec3 Cross product (v x other)
/// @example other v cross -> c
pub fn (v:Vec3) cross(other:Vec3 -- result:Vec3) {
	-> other
	Vec3 {
		x = v @y other @z * v @z other @y * -
		y = v @z other @x * v @x other @z * -
		z = v @x other @y * v @y other @x * -
	}
}

/// Length (magnitude) of this vector.
/// @return result f64 Length of vector
/// @example v length -> len
pub fn (v:Vec3) length( -- result:f64) {
	v @x v @x * v @y v @y * + v @z v @z * + math::sqrt
}

/// Squared length of this vector (avoids sqrt).
/// @return result f64 Squared length of vector
/// @example v length_sq -> len_sq
pub fn (v:Vec3) length_sq( -- result:f64) {
	v @x v @x * v @y v @y * + v @z v @z * +
}

/// Normalize this vector to unit length.
/// @return result Vec3 Unit vector in same direction
/// @example v normalize -> unit
pub fn (v:Vec3) normalize( -- result:Vec3) {
	v @x v @x * v @y v @y * + v @z v @z * + math::sqrt -> mag
	mag 0.0 gt if {
		1.0 mag / -> inv_mag
		Vec3 {
			x = v @x inv_mag *
			y = v @y inv_mag *
			z = v @z inv_mag *
		}
	} else {
		vec3_zero
	}
}

/// Negate this vector.
/// @return result Vec3 Negated vector
/// @example v neg -> neg_v
pub fn (v:Vec3) neg( -- result:Vec3) {
	Vec3 {
		x = v @x neg
		y = v @y neg
		z = v @z neg
	}
}

/// Linear interpolation to another Vec3.
/// @param other Vec3 End vector
/// @param t f64 Interpolation factor (0.0 to 1.0)
/// @return result Vec3 Interpolated vector
/// @example other 0.5 v lerp -> mid
pub fn (v:Vec3) lerp(other:Vec3 t:f64 -- result:Vec3) {
	-> t
	-> other
	Vec3 {
		x = v @x other @x v @x - t * +
		y = v @y other @y v @y - t * +
		z = v @z other @z v @z - t * +
	}
}

/// Reflect this vector around a normal.
/// @param n Vec3 Normal vector
/// @return result Vec3 Reflected vector
/// @example normal v reflect -> reflected
pub fn (v:Vec3) reflect(n:Vec3 -- result:Vec3) {
	-> n
	v @x n @x * v @y n @y * + v @z n @z * + 2.0 * -> factor
	Vec3 {
		x = v @x n @x factor * -
		y = v @y n @y factor * -
		z = v @z n @z factor * -
	}
}

/// Distance to another Vec3.
/// @param other Vec3 Other point
/// @return result f64 Distance between points
/// @example other v distance -> d
pub fn (v:Vec3) distance(other:Vec3 -- result:f64) {
	-> other
	v @x other @x - dup *
	v @y other @y - dup * +
	v @z other @z - dup * +
	math::sqrt
}

/// Angle between this vector and another.
/// @param other Vec3 Other vector
/// @return result f64 Angle in radians [0, π]
/// @example other v angle_between -> a
pub fn (v:Vec3) angle_between(other:Vec3 -- result:f64) {
	-> other
	v @x other @x * v @y other @y * + v @z other @z * + -> dot_val
	v @x v @x * v @y v @y * + v @z v @z * + math::sqrt -> v_len
	other @x other @x * other @y other @y * + other @z other @z * + math::sqrt -> o_len
	dot_val v_len o_len * / math::acos
}

// ============================================================================
// Vec4 - 4D vector math operations (homogeneous coordinates)
// ============================================================================

/// 4D vector with x, y, z, and w components.
/// @field x f64 X component
/// @field y f64 Y component
/// @field z f64 Z component
/// @field w f64 W component
pub struct Vec4 {
	x:f64
	y:f64
	z:f64
	w:f64
}

/// Create a Vec4 with all components set to zero.
/// @return v Vec4 Zero vector (0, 0, 0, 0)
/// @example math::vec4_zero -> v
pub fn vec4_zero( -- v:Vec4) {
	Vec4 {
		x = 0.0
		y = 0.0
		z = 0.0
		w = 0.0
	}
}

/// Create a Vec4 with all components set to one.
/// @return v Vec4 One vector (1, 1, 1, 1)
/// @example math::vec4_one -> v
pub fn vec4_one( -- v:Vec4) {
	Vec4 {
		x = 1.0
		y = 1.0
		z = 1.0
		w = 1.0
	}
}

/// Add another Vec4 to this vector.
/// @param other Vec4 Vector to add
/// @return result Vec4 Sum of vectors
/// @example other v add -> sum
pub fn (v:Vec4) add(other:Vec4 -- result:Vec4) {
	-> other
	Vec4 {
		x = v @x other @x +
		y = v @y other @y +
		z = v @z other @z +
		w = v @w other @w +
	}
}

/// Subtract another Vec4 from this vector.
/// @param other Vec4 Vector to subtract
/// @return result Vec4 Difference of vectors
/// @example other v subtract -> diff
pub fn (v:Vec4) subtract(other:Vec4 -- result:Vec4) {
	-> other
	Vec4 {
		x = v @x other @x -
		y = v @y other @y -
		z = v @z other @z -
		w = v @w other @w -
	}
}

/// Multiply this vector by a scalar.
/// @param s f64 Scalar multiplier
/// @return result Vec4 Scaled vector
/// @example 2.0 v scale -> scaled
pub fn (v:Vec4) scale(s:f64 -- result:Vec4) {
	-> s
	Vec4 {
		x = v @x s *
		y = v @y s *
		z = v @z s *
		w = v @w s *
	}
}

/// Dot product with another Vec4.
/// @param other Vec4 Other vector
/// @return result f64 Dot product
/// @example other v dot -> d
pub fn (v:Vec4) dot(other:Vec4 -- result:f64) {
	-> other
	v @x other @x * v @y other @y * + v @z other @z * + v @w other @w * +
}

/// Length (magnitude) of this vector.
/// @return result f64 Length of vector
/// @example v length -> len
pub fn (v:Vec4) length( -- result:f64) {
	v @x v @x * v @y v @y * + v @z v @z * + v @w v @w * + math::sqrt
}

/// Normalize this vector to unit length.
/// @return result Vec4 Unit vector in same direction
/// @example v normalize -> unit
pub fn (v:Vec4) normalize( -- result:Vec4) {
	v @x v @x * v @y v @y * + v @z v @z * + v @w v @w * + math::sqrt -> mag
	mag 0.0 gt if {
		1.0 mag / -> inv_mag
		Vec4 {
			x = v @x inv_mag *
			y = v @y inv_mag *
			z = v @z inv_mag *
			w = v @w inv_mag *
		}
	} else {
		vec4_zero
	}
}

/// Squared length of this vector (avoids sqrt).
/// @return result f64 Squared length of vector
/// @example v length_sq -> len_sq
pub fn (v:Vec4) length_sq( -- result:f64) {
	v @x v @x * v @y v @y * + v @z v @z * + v @w v @w * +
}

/// Negate this vector.
/// @return result Vec4 Negated vector
/// @example v neg -> neg_v
pub fn (v:Vec4) neg( -- result:Vec4) {
	Vec4 {
		x = v @x neg
		y = v @y neg
		z = v @z neg
		w = v @w neg
	}
}

/// Linear interpolation to another Vec4.
/// @param other Vec4 End vector
/// @param t f64 Interpolation factor (0.0 to 1.0)
/// @return result Vec4 Interpolated vector
/// @example other 0.5 v lerp -> mid
pub fn (v:Vec4) lerp(other:Vec4 t:f64 -- result:Vec4) {
	-> t
	-> other
	Vec4 {
		x = v @x other @x v @x - t * +
		y = v @y other @y v @y - t * +
		z = v @z other @z v @z - t * +
		w = v @w other @w v @w - t * +
	}
}

// ============================================================================
// Quat - Quaternion math operations for 3D rotations
// ============================================================================

/// Quaternion for representing rotations.
/// Stored as (w, x, y, z) where w is the scalar part.
/// @field w f64 Scalar (real) component
/// @field x f64 X component of vector part
/// @field y f64 Y component of vector part
/// @field z f64 Z component of vector part
pub struct Quat {
	w:f64
	x:f64
	y:f64
	z:f64
}

/// Create identity quaternion (no rotation).
/// @return q Quat Identity quaternion
/// @example math::quat_identity -> q
pub fn quat_identity( -- q:Quat) {
	Quat {
		w = 1.0
		x = 0.0
		y = 0.0
		z = 0.0
	}
}

/// Quaternion multiplication.
/// @param other Quat Quaternion to multiply with
/// @return result Quat Product of this and other
/// @example other q mul -> product
pub fn (q:Quat) mul(other:Quat -- result:Quat) {
	-> other
	Quat {
		w = q @w other @w * q @x other @x * - q @y other @y * - q @z other @z * -
		x = q @w other @x * q @x other @w * + q @y other @z * + q @z other @y * -
		y = q @w other @y * q @y other @w * + q @z other @x * + q @x other @z * -
		z = q @w other @z * q @z other @w * + q @x other @y * + q @y other @x * -
	}
}

/// Conjugate of this quaternion.
/// @return result Quat Conjugate quaternion
/// @example q conjugate -> q_conj
pub fn (q:Quat) conjugate( -- result:Quat) {
	Quat {
		w = q @w
		x = q @x neg
		y = q @y neg
		z = q @z neg
	}
}

/// Length (magnitude) of this quaternion.
/// @return result f64 Length of quaternion
/// @example q length -> len
pub fn (q:Quat) length( -- result:f64) {
	q @w q @w * q @x q @x * + q @y q @y * + q @z q @z * + math::sqrt
}

/// Normalize this quaternion to unit length.
/// @return result Quat Unit quaternion
/// @example q normalize -> unit_q
pub fn (q:Quat) normalize( -- result:Quat) {
	q @w q @w * q @x q @x * + q @y q @y * + q @z q @z * + math::sqrt -> mag
	mag 0.0 gt if {
		1.0 mag / -> inv_mag
		Quat {
			w = q @w inv_mag *
			x = q @x inv_mag *
			y = q @y inv_mag *
			z = q @z inv_mag *
		}
	} else {
		quat_identity
	}
}

/// Dot product with another quaternion.
/// @param other Quat Other quaternion
/// @return result f64 Dot product
/// @example other q dot -> d
pub fn (q:Quat) dot(other:Quat -- result:f64) {
	-> other
	q @w other @w * q @x other @x * + q @y other @y * + q @z other @z * +
}

/// Inverse of this quaternion.
/// @return result Quat Inverse quaternion
/// @example q inverse -> q_inv
pub fn (q:Quat) inverse( -- result:Quat) {
	q @w q @w * q @x q @x * + q @y q @y * + q @z q @z * + -> len_sq
	len_sq 0.0 gt if {
		1.0 len_sq / -> inv_len_sq
		Quat {
			w = q @w inv_len_sq *
			x = q @x neg inv_len_sq *
			y = q @y neg inv_len_sq *
			z = q @z neg inv_len_sq *
		}
	} else {
		quat_identity
	}
}

/// Squared length of quaternion.
/// @return result f64 Squared length
pub fn (q:Quat) length_sq( -- result:f64) {
	q @w q @w * q @x q @x * + q @y q @y * + q @z q @z * +
}

/// Spherical linear interpolation to another quaternion.
/// @param other Quat End quaternion
/// @param t f64 Interpolation factor (0.0 to 1.0)
/// @return result Quat Interpolated quaternion
/// @example other 0.5 q slerp -> mid
pub fn (q:Quat) slerp(other:Quat t:f64 -- result:Quat) {
	-> t
	-> other
	q @w other @w * q @x other @x * + q @y other @y * + q @z other @z * + -> dot_val
	dot_val 0.0 lt if {
		other @w neg other .w
		other @x neg other .x
		other @y neg other .y
		other @z neg other .z
		dot_val neg -> dot_val
	}
	dot_val 0.9995 gt if {
		Quat {
			w = q @w other @w q @w - t * +
			x = q @x other @x q @x - t * +
			y = q @y other @y q @y - t * +
			z = q @z other @z q @z - t * +
		} normalize
	} else {
		dot_val math::acos -> theta
		theta t * -> theta_t
		theta_t math::sin -> sin_t
		theta math::sin -> sin_theta
		theta_t math::cos q @w * sin_t other @w q @w dot_val * - * sin_theta / + -> w_r
		theta_t math::cos q @x * sin_t other @x q @x dot_val * - * sin_theta / + -> x_r
		theta_t math::cos q @y * sin_t other @y q @y dot_val * - * sin_theta / + -> y_r
		theta_t math::cos q @z * sin_t other @z q @z dot_val * - * sin_theta / + -> z_r
		Quat { w = w_r x = x_r y = y_r z = z_r }
	}
}

/// Rotate a Vec3 by this quaternion.
/// @param v Vec3 Vector to rotate
/// @return result Vec3 Rotated vector
/// @example v q rotate_vec3 -> rotated
pub fn (q:Quat) rotate_vec3(v:Vec3 -- result:Vec3) {
	-> v
	q @x 2.0 * -> qx2
	q @y 2.0 * -> qy2
	q @z 2.0 * -> qz2
	q @w qx2 * -> wx2
	q @w qy2 * -> wy2
	q @w qz2 * -> wz2
	q @x qx2 * -> xx2
	q @x qy2 * -> xy2
	q @x qz2 * -> xz2
	q @y qy2 * -> yy2
	q @y qz2 * -> yz2
	q @z qz2 * -> zz2
	Vec3 {
		x = v @x 1.0 yy2 - zz2 - * v @y xy2 wz2 - * + v @z xz2 wy2 + * +
		y = v @x xy2 wz2 + * v @y 1.0 xx2 - zz2 - * + v @z yz2 wx2 - * +
		z = v @x xz2 wy2 - * v @y yz2 wx2 + * + v @z 1.0 xx2 - yy2 - * +
	}
}

/// Create quaternion from axis and angle.
/// @param axis Vec3 Rotation axis (should be normalized)
/// @param angle f64 Rotation angle in radians
/// @return result Quat Rotation quaternion
/// @example axis 1.57 quat_from_axis_angle -> q
pub fn quat_from_axis_angle(axis:Vec3 angle:f64 -- result:Quat) {
	-> angle
	-> axis
	angle 0.5 * -> half_angle
	half_angle math::sin -> s
	Quat {
		w = half_angle math::cos
		x = axis @x s *
		y = axis @y s *
		z = axis @z s *
	}
}

/// Create quaternion from Euler angles (XYZ order).
/// @param pitch f64 Rotation around X axis (radians)
/// @param yaw f64 Rotation around Y axis (radians)
/// @param roll f64 Rotation around Z axis (radians)
/// @return result Quat Rotation quaternion
/// @example 0.0 1.57 0.0 quat_from_euler -> q
pub fn quat_from_euler(pitch:f64 yaw:f64 roll:f64 -- result:Quat) {
	-> roll
	-> yaw
	-> pitch
	pitch 0.5 * -> hp
	yaw 0.5 * -> hy
	roll 0.5 * -> hr
	hp math::cos -> cp
	hp math::sin -> sp
	hy math::cos -> cy
	hy math::sin -> sy
	hr math::cos -> cr
	hr math::sin -> sr
	Quat {
		w = cp cy cr * * sp sy sr * * +
		x = sp cy cr * * cp sy sr * * -
		y = cp sy cr * * sp cy sr * * +
		z = cp cy sr * * sp sy cr * * -
	}
}

// ============================================================================
// Mat4 - 4x4 matrix math operations for 3D transformations
// ============================================================================

/// 4x4 matrix in column-major order (OpenGL compatible).
/// @field m00 f64 Element at row 0, column 0
/// @field m01 f64 Element at row 1, column 0
/// @field m02 f64 Element at row 2, column 0
/// @field m03 f64 Element at row 3, column 0
/// @field m10 f64 Element at row 0, column 1
/// @field m11 f64 Element at row 1, column 1
/// @field m12 f64 Element at row 2, column 1
/// @field m13 f64 Element at row 3, column 1
/// @field m20 f64 Element at row 0, column 2
/// @field m21 f64 Element at row 1, column 2
/// @field m22 f64 Element at row 2, column 2
/// @field m23 f64 Element at row 3, column 2
/// @field m30 f64 Element at row 0, column 3
/// @field m31 f64 Element at row 1, column 3
/// @field m32 f64 Element at row 2, column 3
/// @field m33 f64 Element at row 3, column 3
pub struct Mat4 {
	m00:f64
	m01:f64
	m02:f64
	m03:f64
	m10:f64
	m11:f64
	m12:f64
	m13:f64
	m20:f64
	m21:f64
	m22:f64
	m23:f64
	m30:f64
	m31:f64
	m32:f64
	m33:f64
}

/// Create identity Mat4.
/// @return m Mat4 Identity matrix
/// @example math::mat4_identity -> m
pub fn mat4_identity( -- m:Mat4) {
	Mat4 {
		m00 = 1.0
		m01 = 0.0
		m02 = 0.0
		m03 = 0.0
		m10 = 0.0
		m11 = 1.0
		m12 = 0.0
		m13 = 0.0
		m20 = 0.0
		m21 = 0.0
		m22 = 1.0
		m23 = 0.0
		m30 = 0.0
		m31 = 0.0
		m32 = 0.0
		m33 = 1.0
	}
}

/// Create zero Mat4.
/// @return m Mat4 Zero matrix
/// @example math::mat4_zero -> m
pub fn mat4_zero( -- m:Mat4) {
	Mat4 {
		m00 = 0.0
		m01 = 0.0
		m02 = 0.0
		m03 = 0.0
		m10 = 0.0
		m11 = 0.0
		m12 = 0.0
		m13 = 0.0
		m20 = 0.0
		m21 = 0.0
		m22 = 0.0
		m23 = 0.0
		m30 = 0.0
		m31 = 0.0
		m32 = 0.0
		m33 = 0.0
	}
}

/// Transpose this matrix.
/// @return result Mat4 Transposed matrix
/// @example m transpose -> m_t
pub fn (m:Mat4) transpose( -- result:Mat4) {
	Mat4 {
		m00 = m @m00
		m01 = m @m10
		m02 = m @m20
		m03 = m @m30
		m10 = m @m01
		m11 = m @m11
		m12 = m @m21
		m13 = m @m31
		m20 = m @m02
		m21 = m @m12
		m22 = m @m22
		m23 = m @m32
		m30 = m @m03
		m31 = m @m13
		m32 = m @m23
		m33 = m @m33
	}
}

/// Create translation Mat4.
/// @param x f64 X translation
/// @param y f64 Y translation
/// @param z f64 Z translation
/// @return m Mat4 Translation matrix
/// @example 1.0 2.0 3.0 math::mat4_translation -> m
pub fn mat4_translation(x:f64 y:f64 z:f64 -- m:Mat4) {
	-> z_v
	-> y_v
	-> x_v
	Mat4 {
		m00 = 1.0
		m01 = 0.0
		m02 = 0.0
		m03 = 0.0
		m10 = 0.0
		m11 = 1.0
		m12 = 0.0
		m13 = 0.0
		m20 = 0.0
		m21 = 0.0
		m22 = 1.0
		m23 = 0.0
		m30 = x_v
		m31 = y_v
		m32 = z_v
		m33 = 1.0
	}
}

/// Create scale Mat4.
/// @param sx f64 X scale factor
/// @param sy f64 Y scale factor
/// @param sz f64 Z scale factor
/// @return m Mat4 Scale matrix
/// @example 2.0 2.0 2.0 math::mat4_scaling -> m
pub fn mat4_scaling(sx:f64 sy:f64 sz:f64 -- m:Mat4) {
	-> sz_v
	-> sy_v
	-> sx_v
	Mat4 {
		m00 = sx_v
		m01 = 0.0
		m02 = 0.0
		m03 = 0.0
		m10 = 0.0
		m11 = sy_v
		m12 = 0.0
		m13 = 0.0
		m20 = 0.0
		m21 = 0.0
		m22 = sz_v
		m23 = 0.0
		m30 = 0.0
		m31 = 0.0
		m32 = 0.0
		m33 = 1.0
	}
}

/// Create rotation Mat4 around X axis.
/// @param angle f64 Rotation angle in radians
/// @return m Mat4 Rotation matrix
/// @example 1.57 math::mat4_rotation_x -> m
pub fn mat4_rotation_x(angle:f64 -- m:Mat4) {
	-> angle
	angle math::cos -> c
	angle math::sin -> s
	Mat4 {
		m00 = 1.0
		m01 = 0.0
		m02 = 0.0
		m03 = 0.0
		m10 = 0.0
		m11 = c
		m12 = s
		m13 = 0.0
		m20 = 0.0
		m21 = s neg
		m22 = c
		m23 = 0.0
		m30 = 0.0
		m31 = 0.0
		m32 = 0.0
		m33 = 1.0
	}
}

/// Create rotation Mat4 around Y axis.
/// @param angle f64 Rotation angle in radians
/// @return m Mat4 Rotation matrix
/// @example 1.57 math::mat4_rotation_y -> m
pub fn mat4_rotation_y(angle:f64 -- m:Mat4) {
	-> angle
	angle math::cos -> c
	angle math::sin -> s
	Mat4 {
		m00 = c
		m01 = 0.0
		m02 = s neg
		m03 = 0.0
		m10 = 0.0
		m11 = 1.0
		m12 = 0.0
		m13 = 0.0
		m20 = s
		m21 = 0.0
		m22 = c
		m23 = 0.0
		m30 = 0.0
		m31 = 0.0
		m32 = 0.0
		m33 = 1.0
	}
}

/// Create rotation Mat4 around Z axis.
/// @param angle f64 Rotation angle in radians
/// @return m Mat4 Rotation matrix
/// @example 1.57 math::mat4_rotation_z -> m
pub fn mat4_rotation_z(angle:f64 -- m:Mat4) {
	-> angle
	angle math::cos -> c
	angle math::sin -> s
	Mat4 {
		m00 = c
		m01 = s
		m02 = 0.0
		m03 = 0.0
		m10 = s neg
		m11 = c
		m12 = 0.0
		m13 = 0.0
		m20 = 0.0
		m21 = 0.0
		m22 = 1.0
		m23 = 0.0
		m30 = 0.0
		m31 = 0.0
		m32 = 0.0
		m33 = 1.0
	}
}

/// Matrix multiplication.
/// @param other Mat4 Matrix to multiply with
/// @return result Mat4 Product of matrices (m * other)
/// @example other m mul -> product
pub fn (m:Mat4) mul(other:Mat4 -- result:Mat4) {
	-> other
	Mat4 {
		m00 = m @m00 other @m00 * m @m10 other @m01 * + m @m20 other @m02 * + m @m30 other @m03 * +
		m01 = m @m01 other @m00 * m @m11 other @m01 * + m @m21 other @m02 * + m @m31 other @m03 * +
		m02 = m @m02 other @m00 * m @m12 other @m01 * + m @m22 other @m02 * + m @m32 other @m03 * +
		m03 = m @m03 other @m00 * m @m13 other @m01 * + m @m23 other @m02 * + m @m33 other @m03 * +
		m10 = m @m00 other @m10 * m @m10 other @m11 * + m @m20 other @m12 * + m @m30 other @m13 * +
		m11 = m @m01 other @m10 * m @m11 other @m11 * + m @m21 other @m12 * + m @m31 other @m13 * +
		m12 = m @m02 other @m10 * m @m12 other @m11 * + m @m22 other @m12 * + m @m32 other @m13 * +
		m13 = m @m03 other @m10 * m @m13 other @m11 * + m @m23 other @m12 * + m @m33 other @m13 * +
		m20 = m @m00 other @m20 * m @m10 other @m21 * + m @m20 other @m22 * + m @m30 other @m23 * +
		m21 = m @m01 other @m20 * m @m11 other @m21 * + m @m21 other @m22 * + m @m31 other @m23 * +
		m22 = m @m02 other @m20 * m @m12 other @m21 * + m @m22 other @m22 * + m @m32 other @m23 * +
		m23 = m @m03 other @m20 * m @m13 other @m21 * + m @m23 other @m22 * + m @m33 other @m23 * +
		m30 = m @m00 other @m30 * m @m10 other @m31 * + m @m20 other @m32 * + m @m30 other @m33 * +
		m31 = m @m01 other @m30 * m @m11 other @m31 * + m @m21 other @m32 * + m @m31 other @m33 * +
		m32 = m @m02 other @m30 * m @m12 other @m31 * + m @m22 other @m32 * + m @m32 other @m33 * +
		m33 = m @m03 other @m30 * m @m13 other @m31 * + m @m23 other @m32 * + m @m33 other @m33 * +
	}
}

/// Matrix determinant.
/// @return result f64 Determinant of matrix
/// @example m determinant -> det
pub fn (m:Mat4) determinant( -- result:f64) {
	// Compute 2x2 determinants for submatrices
	m @m22 m @m33 * m @m23 m @m32 * - -> s0
	m @m21 m @m33 * m @m23 m @m31 * - -> s1
	m @m21 m @m32 * m @m22 m @m31 * - -> s2
	m @m20 m @m33 * m @m23 m @m30 * - -> s3
	m @m20 m @m32 * m @m22 m @m30 * - -> s4
	m @m20 m @m31 * m @m21 m @m30 * - -> s5

	// Compute 3x3 cofactors for first row
	m @m11 s0 * m @m12 s1 * - m @m13 s2 * + -> c0
	m @m10 s0 * m @m12 s3 * - m @m13 s4 * + -> c1
	m @m10 s1 * m @m11 s3 * - m @m13 s5 * + -> c2
	m @m10 s2 * m @m11 s4 * - m @m12 s5 * + -> c3

	// Combine using first row
	m @m00 c0 * m @m01 c1 * - m @m02 c2 * + m @m03 c3 * -
}

/// Matrix inverse.
/// @return result Mat4 Inverse matrix (returns identity if singular)
/// @example m inverse -> m_inv
pub fn (m:Mat4) inverse( -- result:Mat4) {
	// Compute 2x2 determinants for bottom-right
	m @m22 m @m33 * m @m23 m @m32 * - -> s0
	m @m21 m @m33 * m @m23 m @m31 * - -> s1
	m @m21 m @m32 * m @m22 m @m31 * - -> s2
	m @m20 m @m33 * m @m23 m @m30 * - -> s3
	m @m20 m @m32 * m @m22 m @m30 * - -> s4
	m @m20 m @m31 * m @m21 m @m30 * - -> s5

	// Compute 2x2 determinants for top-right and bottom-left
	m @m02 m @m13 * m @m03 m @m12 * - -> t0
	m @m01 m @m13 * m @m03 m @m11 * - -> t1
	m @m01 m @m12 * m @m02 m @m11 * - -> t2
	m @m00 m @m13 * m @m03 m @m10 * - -> t3
	m @m00 m @m12 * m @m02 m @m10 * - -> t4
	m @m00 m @m11 * m @m01 m @m10 * - -> t5

	// Compute cofactors
	m @m11 s0 * m @m12 s1 * - m @m13 s2 * + -> c00
	m @m10 s0 * neg m @m12 s3 * + m @m13 s4 * - -> c01
	m @m10 s1 * m @m11 s3 * - m @m13 s5 * + -> c02
	m @m10 s2 * neg m @m11 s4 * + m @m12 s5 * - -> c03

	m @m01 s0 * neg m @m02 s1 * + m @m03 s2 * - -> c10
	m @m00 s0 * m @m02 s3 * - m @m03 s4 * + -> c11
	m @m00 s1 * neg m @m01 s3 * + m @m03 s5 * - -> c12
	m @m00 s2 * m @m01 s4 * - m @m02 s5 * + -> c13

	m @m31 t0 * m @m32 t1 * - m @m33 t2 * + -> c20
	m @m30 t0 * neg m @m32 t3 * + m @m33 t4 * - -> c21
	m @m30 t1 * m @m31 t3 * - m @m33 t5 * + -> c22
	m @m30 t2 * neg m @m31 t4 * + m @m32 t5 * - -> c23

	m @m21 t0 * neg m @m22 t1 * + m @m23 t2 * - -> c30
	m @m20 t0 * m @m22 t3 * - m @m23 t4 * + -> c31
	m @m20 t1 * neg m @m21 t3 * + m @m23 t5 * - -> c32
	m @m20 t2 * m @m21 t4 * - m @m22 t5 * + -> c33

	// Compute determinant using first row of cofactor matrix
	m @m00 c00 * m @m01 c01 * + m @m02 c02 * + m @m03 c03 * + -> det

	det math::abs 0.000001 lt if {
		mat4_identity
	} else {
		1.0 det / -> inv_det
		Mat4 {
			m00 = c00 inv_det *
			m01 = c10 inv_det *
			m02 = c20 inv_det *
			m03 = c30 inv_det *
			m10 = c01 inv_det *
			m11 = c11 inv_det *
			m12 = c21 inv_det *
			m13 = c31 inv_det *
			m20 = c02 inv_det *
			m21 = c12 inv_det *
			m22 = c22 inv_det *
			m23 = c32 inv_det *
			m30 = c03 inv_det *
			m31 = c13 inv_det *
			m32 = c23 inv_det *
			m33 = c33 inv_det *
		}
	}
}

/// Transform a Vec3 point by this matrix (w=1).
/// @param v Vec3 Point to transform
/// @return result Vec3 Transformed point
/// @example point m transform_point -> transformed
pub fn (m:Mat4) transform_point(v:Vec3 -- result:Vec3) {
	-> v
	m @m00 v @x * m @m10 v @y * + m @m20 v @z * + m @m30 + -> rx
	m @m01 v @x * m @m11 v @y * + m @m21 v @z * + m @m31 + -> ry
	m @m02 v @x * m @m12 v @y * + m @m22 v @z * + m @m32 + -> rz
	m @m03 v @x * m @m13 v @y * + m @m23 v @z * + m @m33 + -> rw
	rw math::abs 0.000001 gt if {
		Vec3 { x = rx rw / y = ry rw / z = rz rw / }
	} else {
		Vec3 { x = rx y = ry z = rz }
	}
}

/// Transform a Vec4 by this matrix.
/// @param v Vec4 Vector to transform
/// @return result Vec4 Transformed vector
/// @example vec m transform_vec4 -> transformed
pub fn (m:Mat4) transform_vec4(v:Vec4 -- result:Vec4) {
	-> v
	Vec4 {
		x = m @m00 v @x * m @m10 v @y * + m @m20 v @z * + m @m30 v @w * +
		y = m @m01 v @x * m @m11 v @y * + m @m21 v @z * + m @m31 v @w * +
		z = m @m02 v @x * m @m12 v @y * + m @m22 v @z * + m @m32 v @w * +
		w = m @m03 v @x * m @m13 v @y * + m @m23 v @z * + m @m33 v @w * +
	}
}

/// Create a look-at view matrix.
/// @param eye Vec3 Camera position
/// @param target Vec3 Point to look at
/// @param up Vec3 Up direction
/// @return m Mat4 View matrix
/// @example eye target up mat4_look_at -> view
pub fn mat4_look_at(eye:Vec3 target:Vec3 up:Vec3 -- m:Mat4) {
	-> up
	-> target
	-> eye
	eye @x target @x - -> fx
	eye @y target @y - -> fy
	eye @z target @z - -> fz
	fx fx * fy fy * + fz fz * + math::sqrt -> f_len
	f_len 0.0 gt if { fx f_len / -> fx fy f_len / -> fy fz f_len / -> fz }
	up @y fz * up @z fy * - -> sx
	up @z fx * up @x fz * - -> sy
	up @x fy * up @y fx * - -> sz
	sx sx * sy sy * + sz sz * + math::sqrt -> s_len
	s_len 0.0 gt if { sx s_len / -> sx sy s_len / -> sy sz s_len / -> sz }
	fy sz * fz sy * - -> ux
	fz sx * fx sz * - -> uy
	fx sy * fy sx * - -> uz
	sx eye @x * sy eye @y * + sz eye @z * + neg -> dot_s_eye
	ux eye @x * uy eye @y * + uz eye @z * + neg -> dot_u_eye
	fx eye @x * fy eye @y * + fz eye @z * + neg -> dot_f_eye
	Mat4 {
		m00 = sx
		m01 = ux
		m02 = fx
		m03 = 0.0
		m10 = sy
		m11 = uy
		m12 = fy
		m13 = 0.0
		m20 = sz
		m21 = uz
		m22 = fz
		m23 = 0.0
		m30 = dot_s_eye
		m31 = dot_u_eye
		m32 = dot_f_eye
		m33 = 1.0
	}
}

/// Create a perspective projection matrix.
/// @param fov f64 Field of view in radians
/// @param aspect f64 Aspect ratio (width/height)
/// @param near f64 Near clipping plane
/// @param far f64 Far clipping plane
/// @return m Mat4 Perspective projection matrix
/// @example 1.047 1.777 0.1 100.0 mat4_perspective -> proj
pub fn mat4_perspective(fov:f64 aspect:f64 near:f64 far:f64 -- m:Mat4) {
	-> far
	-> near
	-> aspect
	-> fov
	fov 0.5 * math::tan -> tan_half_fov
	1.0 tan_half_fov / -> f
	Mat4 {
		m00 = f aspect /
		m01 = 0.0
		m02 = 0.0
		m03 = 0.0
		m10 = 0.0
		m11 = f
		m12 = 0.0
		m13 = 0.0
		m20 = 0.0
		m21 = 0.0
		m22 = far near + near far - /
		m23 = 1.0 neg
		m30 = 0.0
		m31 = 0.0
		m32 = 2.0 far * near * near far - /
		m33 = 0.0
	}
}

/// Create an orthographic projection matrix.
/// @param left f64 Left clipping plane
/// @param right f64 Right clipping plane
/// @param bottom f64 Bottom clipping plane
/// @param top f64 Top clipping plane
/// @param near f64 Near clipping plane
/// @param far f64 Far clipping plane
/// @return m Mat4 Orthographic projection matrix
/// @example -1.0 1.0 -1.0 1.0 0.1 100.0 mat4_orthographic -> proj
pub fn mat4_orthographic(left:f64 right:f64 bottom:f64 top:f64 near:f64 far:f64 -- m:Mat4) {
	-> far
	-> near
	-> top
	-> bottom
	-> right
	-> left
	Mat4 {
		m00 = 2.0 right left - /
		m01 = 0.0
		m02 = 0.0
		m03 = 0.0
		m10 = 0.0
		m11 = 2.0 top bottom - /
		m12 = 0.0
		m13 = 0.0
		m20 = 0.0
		m21 = 0.0
		m22 = 2.0 neg far near - /
		m23 = 0.0
		m30 = right left + right left - / neg
		m31 = top bottom + top bottom - / neg
		m32 = far near + far near - / neg
		m33 = 1.0
	}
}

/// Create rotation matrix from quaternion.
/// @param q Quat Rotation quaternion
/// @return m Mat4 Rotation matrix
/// @example q mat4_from_quat -> rot_mat
pub fn mat4_from_quat(q:Quat -- m:Mat4) {
	-> q
	q @x 2.0 * -> x2
	q @y 2.0 * -> y2
	q @z 2.0 * -> z2
	q @x x2 * -> xx
	q @x y2 * -> xy
	q @x z2 * -> xz
	q @y y2 * -> yy
	q @y z2 * -> yz
	q @z z2 * -> zz
	q @w x2 * -> wx
	q @w y2 * -> wy
	q @w z2 * -> wz
	Mat4 {
		m00 = 1.0 yy - zz -
		m01 = xy wz +
		m02 = xz wy -
		m03 = 0.0
		m10 = xy wz -
		m11 = 1.0 xx - zz -
		m12 = yz wx +
		m13 = 0.0
		m20 = xz wy +
		m21 = yz wx -
		m22 = 1.0 xx - yy -
		m23 = 0.0
		m30 = 0.0
		m31 = 0.0
		m32 = 0.0
		m33 = 1.0
	}
}

/// Sign function.
/// @param x f64 Input value
/// @return result f64 -1 if x < 0, 0 if x == 0, 1 if x > 0
/// @example -5.0 math::sign print  // -1.0
pub fn sign(x:f64 -- result:f64) {
	-> x
	x 0.0 lt if {
		1.0 neg
	} else {
		x 0.0 gt if {
			1.0
		} else {
			0.0
		}
	}
}

// ============================================================================
// Interpolation and Spline Functions
// ============================================================================

/// Smooth step interpolation (cubic Hermite, zero derivatives at edges).
/// @param edge0 f64 Lower edge
/// @param edge1 f64 Upper edge
/// @param x f64 Value to interpolate
/// @return result f64 Smoothly interpolated value [0, 1]
/// @example 0.0 1.0 0.5 math::smoothstep print  // 0.5
pub fn smoothstep(edge0:f64 edge1:f64 x:f64 -- result:f64) {
	-> x_v
	-> edge1
	-> edge0
	// Clamp t to [0, 1]
	x_v edge0 - edge1 edge0 - / -> t
	t 0.0 lt if { 0.0 -> t }
	t 1.0 gt if { 1.0 -> t }
	// Hermite polynomial: 3t² - 2t³
	t t * 3.0 2.0 t * - *
}

/// Smoother step interpolation (quintic, zero first and second derivatives at edges).
/// @param edge0 f64 Lower edge
/// @param edge1 f64 Upper edge
/// @param x f64 Value to interpolate
/// @return result f64 Smoothly interpolated value [0, 1]
/// @example 0.0 1.0 0.5 math::smootherstep print  // 0.5
pub fn smootherstep(edge0:f64 edge1:f64 x:f64 -- result:f64) {
	-> x_v
	-> edge1
	-> edge0
	// Clamp t to [0, 1]
	x_v edge0 - edge1 edge0 - / -> t
	t 0.0 lt if { 0.0 -> t }
	t 1.0 gt if { 1.0 -> t }
	// Quintic polynomial: 6t⁵ - 15t⁴ + 10t³
	t t * t * t 6.0 * 15.0 - t * 10.0 + *
}

/// Cubic Hermite spline interpolation.
/// Interpolates between p1 and p2 using tangents m1 and m2.
/// @param p0 f64 Point before p1 (used to compute tangent)
/// @param p1 f64 Start point
/// @param p2 f64 End point
/// @param p3 f64 Point after p2 (used to compute tangent)
/// @param t f64 Interpolation factor [0, 1]
/// @return result f64 Interpolated value
/// @example 0.0 1.0 4.0 5.0 0.5 math::cubic_hermite print
pub fn cubic_hermite(p0:f64 p1:f64 p2:f64 p3:f64 t:f64 -- result:f64) {
	-> t
	-> p3
	-> p2
	-> p1
	-> p0
	// Catmull-Rom tangents
	p2 p0 - 0.5 * -> m1
	p3 p1 - 0.5 * -> m2
	// Hermite basis functions
	t t * -> t2
	t2 t * -> t3
	2.0 t3 * 3.0 t2 * - 1.0 + -> h00
	t3 2.0 t2 * - t + -> h10
	3.0 t2 * 2.0 t3 * - -> h01
	t3 t2 - -> h11
	// Interpolate
	h00 p1 * h10 m1 * + h01 p2 * + h11 m2 * +
}

/// Evaluate quadratic Bezier curve.
/// @param p0 f64 Start point
/// @param p1 f64 Control point
/// @param p2 f64 End point
/// @param t f64 Parameter [0, 1]
/// @return result f64 Point on curve
/// @example 0.0 1.0 2.0 0.5 math::bezier2 print  // 1.0
pub fn bezier2(p0:f64 p1:f64 p2:f64 t:f64 -- result:f64) {
	-> t
	-> p2
	-> p1
	-> p0
	1.0 t - -> u
	// B(t) = (1-t)²p0 + 2(1-t)tp1 + t²p2
	u u * p0 * 2.0 u * t * p1 * + t t * p2 * +
}

/// Evaluate cubic Bezier curve.
/// @param p0 f64 Start point
/// @param p1 f64 First control point
/// @param p2 f64 Second control point
/// @param p3 f64 End point
/// @param t f64 Parameter [0, 1]
/// @return result f64 Point on curve
/// @example 0.0 0.5 0.5 1.0 0.5 math::bezier3 print
pub fn bezier3(p0:f64 p1:f64 p2:f64 p3:f64 t:f64 -- result:f64) {
	-> t
	-> p3
	-> p2
	-> p1
	-> p0
	1.0 t - -> u
	u u * -> u2
	t t * -> t2
	// B(t) = (1-t)³p0 + 3(1-t)²tp1 + 3(1-t)t²p2 + t³p3
	u2 u * p0 * 3.0 u2 * t * p1 * + 3.0 u * t2 * p2 * + t2 t * p3 * +
}

/// Evaluate quadratic Bezier curve for Vec2.
/// @param p0 Vec2 Start point
/// @param p1 Vec2 Control point
/// @param p2 Vec2 End point
/// @param t f64 Parameter [0, 1]
/// @return result Vec2 Point on curve
pub fn bezier2_vec2(p0:Vec2 p1:Vec2 p2:Vec2 t:f64 -- result:Vec2) {
	-> t
	-> p2
	-> p1
	-> p0
	1.0 t - -> u
	u u * -> u2
	t t * -> t2
	Vec2 {
		x = u2 p0 @x * 2.0 u * t * p1 @x * + t2 p2 @x * +
		y = u2 p0 @y * 2.0 u * t * p1 @y * + t2 p2 @y * +
	}
}

/// Evaluate cubic Bezier curve for Vec2.
/// @param p0 Vec2 Start point
/// @param p1 Vec2 First control point
/// @param p2 Vec2 Second control point
/// @param p3 Vec2 End point
/// @param t f64 Parameter [0, 1]
/// @return result Vec2 Point on curve
pub fn bezier3_vec2(p0:Vec2 p1:Vec2 p2:Vec2 p3:Vec2 t:f64 -- result:Vec2) {
	-> t
	-> p3
	-> p2
	-> p1
	-> p0
	1.0 t - -> u
	u u * -> u2
	t t * -> t2
	u2 u * -> u3
	t2 t * -> t3
	Vec2 {
		x = u3 p0 @x * 3.0 u2 * t * p1 @x * + 3.0 u * t2 * p2 @x * + t3 p3 @x * +
		y = u3 p0 @y * 3.0 u2 * t * p1 @y * + 3.0 u * t2 * p2 @y * + t3 p3 @y * +
	}
}

/// Evaluate cubic Bezier curve for Vec3.
/// @param p0 Vec3 Start point
/// @param p1 Vec3 First control point
/// @param p2 Vec3 Second control point
/// @param p3 Vec3 End point
/// @param t f64 Parameter [0, 1]
/// @return result Vec3 Point on curve
pub fn bezier3_vec3(p0:Vec3 p1:Vec3 p2:Vec3 p3:Vec3 t:f64 -- result:Vec3) {
	-> t
	-> p3
	-> p2
	-> p1
	-> p0
	1.0 t - -> u
	u u * -> u2
	t t * -> t2
	u2 u * -> u3
	t2 t * -> t3
	Vec3 {
		x = u3 p0 @x * 3.0 u2 * t * p1 @x * + 3.0 u * t2 * p2 @x * + t3 p3 @x * +
		y = u3 p0 @y * 3.0 u2 * t * p1 @y * + 3.0 u * t2 * p2 @y * + t3 p3 @y * +
		z = u3 p0 @z * 3.0 u2 * t * p1 @z * + 3.0 u * t2 * p2 @z * + t3 p3 @z * +
	}
}

/// Inverse lerp - find t given a value between a and b.
/// @param a f64 Start value
/// @param b f64 End value
/// @param v f64 Value to find t for
/// @return result f64 Interpolation factor t where lerp(a, b, t) = v
/// @example 0.0 10.0 5.0 math::inverse_lerp print  // 0.5
pub fn inverse_lerp(a:f64 b:f64 v:f64 -- result:f64) {
	-> v
	-> b
	-> a
	b a - -> diff
	diff math::abs 0.000001 lt if {
		0.0
	} else {
		v a - diff /
	}
}

/// Remap a value from one range to another.
/// @param in_min f64 Input range minimum
/// @param in_max f64 Input range maximum
/// @param out_min f64 Output range minimum
/// @param out_max f64 Output range maximum
/// @param v f64 Value to remap
/// @return result f64 Remapped value
/// @example 0.0 10.0 0.0 100.0 5.0 math::remap print  // 50.0
pub fn remap(in_min:f64 in_max:f64 out_min:f64 out_max:f64 v:f64 -- result:f64) {
	-> v
	-> out_max
	-> out_min
	-> in_max
	-> in_min
	v in_min - in_max in_min - / -> t
	out_min out_max out_min - t * +
}
