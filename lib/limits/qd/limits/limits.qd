/// Numeric limits and constants.
/// Provides minimum and maximum values for numeric types.

// ============================================================
// Native Type Limits (i64, f64)
// ============================================================

/// Minimum value for i64 (Quadrate's native integer type).
/// Note: -9223372036854775808 cannot be a literal (parser overflows), so we compute it.
pub fn I64Min( -- result:i64) {
	-9223372036854775807 1 -
}

/// Maximum value for i64 (Quadrate's native integer type).
pub const I64Max = 9223372036854775807

/// Smallest positive normalized f64 value.
pub const F64Min = 2.2250738585072014e-308

/// Largest finite f64 value.
pub const F64Max = 1.7976931348623157e+308

/// Machine epsilon for f64 (smallest x such that 1.0 + x != 1.0).
pub const F64Epsilon = 2.220446049250313e-16

// ============================================================
// C FFI / Bit Manipulation Limits
// These are useful when interfacing with C libraries or
// working with binary data formats.
// ============================================================

/// Maximum value for 8-bit signed integer (C: int8_t).
pub const I8Max = 127

/// Minimum value for 8-bit signed integer (C: int8_t).
pub const I8Min = -128

/// Maximum value for 16-bit signed integer (C: int16_t).
pub const I16Max = 32767

/// Minimum value for 16-bit signed integer (C: int16_t).
pub const I16Min = -32768

/// Maximum value for 32-bit signed integer (C: int32_t).
pub const I32Max = 2147483647

/// Minimum value for 32-bit signed integer (C: int32_t).
pub const I32Min = -2147483648

/// Maximum value for 8-bit unsigned integer (C: uint8_t).
pub const U8Max = 255

/// Maximum value for 16-bit unsigned integer (C: uint16_t).
pub const U16Max = 65535

/// Maximum value for 32-bit unsigned integer (C: uint32_t).
pub const U32Max = 4294967295

// ============================================================
// Size Constants
// ============================================================

/// Size of a pointer in bytes (64-bit platform).
pub const PtrSize = 8

/// Size of i64 in bytes.
pub const I64Size = 8

/// Size of f64 in bytes.
pub const F64Size = 8

// ============================================================
// Range Check Functions
// ============================================================

/// Check if value fits in i8 range.
/// @param v i64 Value to check
/// @return fits i64 1 if in range, 0 otherwise
/// @example 100 limits::fits_i8 print  // 1
pub fn fits_i8(v:i64 -- fits:i64) {
	v I8Min >= v I8Max <= and
}

/// Check if value fits in i16 range.
/// @param v i64 Value to check
/// @return fits i64 1 if in range, 0 otherwise
/// @example 30000 limits::fits_i16 print  // 1
pub fn fits_i16(v:i64 -- fits:i64) {
	v I16Min >= v I16Max <= and
}

/// Check if value fits in i32 range.
/// @param v i64 Value to check
/// @return fits i64 1 if in range, 0 otherwise
/// @example 2000000000 limits::fits_i32 print  // 1
pub fn fits_i32(v:i64 -- fits:i64) {
	v I32Min >= v I32Max <= and
}

/// Check if value fits in u8 range.
/// @param v i64 Value to check
/// @return fits i64 1 if in range, 0 otherwise
/// @example 200 limits::fits_u8 print  // 1
pub fn fits_u8(v:i64 -- fits:i64) {
	v 0 >= v U8Max <= and
}

/// Check if value fits in u16 range.
/// @param v i64 Value to check
/// @return fits i64 1 if in range, 0 otherwise
/// @example 50000 limits::fits_u16 print  // 1
pub fn fits_u16(v:i64 -- fits:i64) {
	v 0 >= v U16Max <= and
}

/// Check if value fits in u32 range.
/// @param v i64 Value to check
/// @return fits i64 1 if in range, 0 otherwise
/// @example 3000000000 limits::fits_u32 print  // 1
pub fn fits_u32(v:i64 -- fits:i64) {
	v 0 >= v U32Max <= and
}

/// Clamp value to i8 range.
/// @param v i64 Value to clamp
/// @return clamped i64 Value clamped to [-128, 127]
/// @example 200 limits::clamp_i8 print  // 127
pub fn clamp_i8(v:i64 -- clamped:i64) {
	I8Min -> lo
	I8Max -> hi
	v lo < if { lo } else {
		v hi > if { hi } else { v }
	}
}

/// Clamp value to i16 range.
/// @param v i64 Value to clamp
/// @return clamped i64 Value clamped to [-32768, 32767]
/// @example 50000 limits::clamp_i16 print  // 32767
pub fn clamp_i16(v:i64 -- clamped:i64) {
	I16Min -> lo
	I16Max -> hi
	v lo < if { lo } else {
		v hi > if { hi } else { v }
	}
}

/// Clamp value to u8 range.
/// @param v i64 Value to clamp
/// @return clamped i64 Value clamped to [0, 255]
/// @example 300 limits::clamp_u8 print  // 255
pub fn clamp_u8(v:i64 -- clamped:i64) {
	v 0 < if { 0 } else {
		v U8Max > if { U8Max } else { v }
	}
}

/// Clamp value to u16 range.
/// @param v i64 Value to clamp
/// @return clamped i64 Value clamped to [0, 65535]
/// @example 70000 limits::clamp_u16 print  // 65535
pub fn clamp_u16(v:i64 -- clamped:i64) {
	v 0 < if { 0 } else {
		v U16Max > if { U16Max } else { v }
	}
}
