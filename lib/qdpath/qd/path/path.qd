/// File path manipulation functions.
/// POSIX-style paths with forward slash separator.
use str

/// Path separator constant.
pub const Sep = "/"

/// Find last occurrence of slash in string.
fn find_last_slash(s:str -- idx:i64) {
	-> s
	s str::len -> slen
	-1 -> result
	0 slen 1 for it {
		it -> i
		s i str::char_at! 47 == if {
			i -> result
		}
	}
	result
}

/// Find last occurrence of dot in string.
fn find_last_dot(s:str -- idx:i64) {
	-> s
	s str::len -> slen
	-1 -> result
	0 slen 1 for it {
		it -> i
		s i str::char_at! 46 == if {
			i -> result
		}
	}
	result
}

/// Get the directory part of a path.
/// @param path str File path
/// @return dir str Directory component
/// @example "/home/user/file.txt" path::dirname -> "/home/user"
pub fn dirname(path:str -- dir:str) {
	-> path
	path find_last_slash -> last_slash
	"." -> result
	last_slash 0 == if {
		"/" -> result
	}
	last_slash 0 > if {
		path 0 last_slash str::substring! -> result
	}
	result
}

/// Get the filename part of a path.
/// @param path str File path
/// @return name str Filename component
/// @example "/home/user/file.txt" path::basename -> "file.txt"
pub fn basename(path:str -- name:str) {
	-> path
	path find_last_slash -> last_slash
	path -> result
	last_slash -1 != if {
		path str::len -> pathlen
		last_slash 1 + -> start
		start pathlen < if {
			path start pathlen start - str::substring! -> result
		} else {
			"" -> result
		}
	}
	result
}

/// Get the file extension (including dot).
/// @param path str File path
/// @return ext str Extension including dot, empty if none
/// @example "file.txt" path::ext -> ".txt"
pub fn ext(path:str -- ext:str) {
	-> path
	// Inline basename logic to avoid type inference issues
	path find_last_slash -> last_slash
	path -> name
	last_slash -1 != if {
		path str::len -> plen
		last_slash 1 + -> pstart
		pstart plen < if {
			path pstart plen pstart - str::substring! -> name
		} else {
			"" -> name
		}
	}
	// Now find extension in name
	name find_last_dot -> last_dot
	"" -> result
	last_dot 0 > if {
		name str::len -> nlen
		name last_dot nlen last_dot - str::substring! -> result
	}
	result
}

/// Get filename without extension.
/// @param path str File path
/// @return stem str Filename without extension
/// @example "file.txt" path::stem -> "file"
pub fn stem(path:str -- stem:str) {
	-> path
	// Inline basename logic to avoid type inference issues
	path find_last_slash -> last_slash
	path -> name
	last_slash -1 != if {
		path str::len -> plen
		last_slash 1 + -> pstart
		pstart plen < if {
			path pstart plen pstart - str::substring! -> name
		} else {
			"" -> name
		}
	}
	// Now find stem in name
	name find_last_dot -> last_dot
	name -> result
	last_dot 0 > if {
		name 0 last_dot str::substring! -> result
	}
	result
}

/// Join two path components.
/// @param p1 str First path
/// @param p2 str Second path
/// @return joined str Joined path
/// @example "/home" "user" path::join -> "/home/user"
pub fn join(p1:str p2:str -- joined:str) {
	-> p2
	-> p1
	p1 -> result
	p2 "/" str::starts_with if {
		p2 -> result
	} else {
		p1 str::len -> len1
		len1 0 == if {
			p2 -> result
		} else {
			p1 len1 1 - str::char_at! 47 == if {
				p1 p2 str::concat -> result
			} else {
				p1 "/" str::concat p2 str::concat -> result
			}
		}
	}
	result
}

/// Check if path is absolute.
/// @param path str File path
/// @return result i64 1 if absolute, 0 otherwise
/// @example "/home/user" path::is_absolute -> 1
pub fn is_absolute(path:str -- result:i64) {
	-> path
	path "/" str::starts_with
}

/// Normalize a path (remove redundant separators).
/// @param path str File path
/// @return norm str Normalized path
/// @example "/home//user/" path::normalize -> "/home/user"
pub fn normalize(path:str -- norm:str) {
	-> path
	path "//" "/" str::replace! -> result
	result str::len -> rlen
	rlen 1 > if {
		result rlen 1 - str::char_at! 47 == if {
			result 0 rlen 1 - str::substring! -> result
		}
	}
	result
}
