// Unit tests for the path module
use path
use testing

test "path::dirname" {
	"/home/user/file.txt" path::dirname "/home/user" testing::assert_eq
	"/file.txt" path::dirname "/" testing::assert_eq
	"file.txt" path::dirname "." testing::assert_eq
	"/home/user/" path::dirname "/home/user" testing::assert_eq
}

test "path::basename" {
	"/home/user/file.txt" path::basename "file.txt" testing::assert_eq
	"/file.txt" path::basename "file.txt" testing::assert_eq
	"file.txt" path::basename "file.txt" testing::assert_eq
	"/home/user/" path::basename "" testing::assert_eq
}

test "path::ext" {
	"file.txt" path::ext ".txt" testing::assert_eq
	"/home/user/file.txt" path::ext ".txt" testing::assert_eq
	"file.tar.gz" path::ext ".gz" testing::assert_eq
	"file" path::ext "" testing::assert_eq
	".hidden" path::ext "" testing::assert_eq
}

test "path::stem" {
	"file.txt" path::stem "file" testing::assert_eq
	"/home/user/file.txt" path::stem "file" testing::assert_eq
	"file.tar.gz" path::stem "file.tar" testing::assert_eq
	"file" path::stem "file" testing::assert_eq
}

test "path::join" {
	"/home" "user" path::join "/home/user" testing::assert_eq
	"/home/" "user" path::join "/home/user" testing::assert_eq
	"" "file.txt" path::join "file.txt" testing::assert_eq
	"/home" "/etc" path::join "/etc" testing::assert_eq
}

test "path::is_absolute" {
	"/home/user" path::is_absolute testing::assert_true
	"home/user" path::is_absolute testing::assert_false
	"/" path::is_absolute testing::assert_true
	"." path::is_absolute testing::assert_false
}

test "path::normalize" {
	"/home//user" path::normalize "/home/user" testing::assert_eq
	"/home/user/" path::normalize "/home/user" testing::assert_eq
	"/home//user/" path::normalize "/home/user" testing::assert_eq
	// Bug #29: Triple+ slashes should also be normalized
	"///home///user" path::normalize "/home/user" testing::assert_eq
	"/home////user" path::normalize "/home/user" testing::assert_eq
}

test "path::with_ext" {
	"file.txt" ".md" path::with_ext "file.md" testing::assert_eq
	"file.txt" "md" path::with_ext "file.md" testing::assert_eq
	"file" ".txt" path::with_ext "file.txt" testing::assert_eq
	"/home/user/file.txt" ".md" path::with_ext "/home/user/file.md" testing::assert_eq
}

test "path::has_ext" {
	"file.txt" path::has_ext testing::assert_true
	"file" path::has_ext testing::assert_false
	"/home/user/file.txt" path::has_ext testing::assert_true
	".hidden" path::has_ext testing::assert_false
}

test "path::parent" {
	"/home/user/file.txt" path::parent "/home/user" testing::assert_eq
	"/file.txt" path::parent "/" testing::assert_eq
	"file.txt" path::parent "." testing::assert_eq
}

test "path::is_relative" {
	"home/user" path::is_relative testing::assert_true
	"." path::is_relative testing::assert_true
	"file.txt" path::is_relative testing::assert_true
	"/home/user" path::is_relative testing::assert_false
	"/" path::is_relative testing::assert_false
}

test "path::has_extension" {
	"file.txt" "txt" path::has_extension testing::assert_true
	"file.txt" ".txt" path::has_extension testing::assert_true
	"file.txt" "md" path::has_extension testing::assert_false
	"file" "txt" path::has_extension testing::assert_false
	"/home/user/file.txt" "txt" path::has_extension testing::assert_true
}

test "path::depth" {
	"/home/user/file.txt" path::depth 3 testing::assert_eq
	"/home/user" path::depth 2 testing::assert_eq
	"/file.txt" path::depth 1 testing::assert_eq
	"file.txt" path::depth 1 testing::assert_eq
	"/" path::depth 0 testing::assert_eq
	"" path::depth 0 testing::assert_eq
}

test "path::starts_with" {
	"/home/user/file.txt" "/home" path::starts_with testing::assert_true
	"/home/user/file.txt" "/home/user" path::starts_with testing::assert_true
	"/home/user" "/home/user" path::starts_with testing::assert_true
	"/home/user" "/home/other" path::starts_with testing::assert_false
	"/home/user" "/etc" path::starts_with testing::assert_false
}

test "path::strip_prefix" {
	"/home/user/file.txt" "/home" path::strip_prefix "user/file.txt" testing::assert_eq
	"/home/user/file.txt" "/home/user" path::strip_prefix "file.txt" testing::assert_eq
	"/home/user" "/home/user" path::strip_prefix "" testing::assert_eq
	"/home/user" "/etc" path::strip_prefix "/home/user" testing::assert_eq
}
