/// 4D vector math operations (homogeneous coordinates).
use math

/// 4D vector with x, y, z, and w components.
/// @field x f64 X component
/// @field y f64 Y component
/// @field z f64 Z component
/// @field w f64 W component
pub struct Vec4 {
	x:f64
	y:f64
	z:f64
	w:f64
}

/// Create a new Vec4.
/// @param x f64 X component
/// @param y f64 Y component
/// @param z f64 Z component
/// @param w f64 W component
/// @return v Vec4 New 4D vector
/// @example 1.0 2.0 3.0 4.0 vec4::new -> v
pub fn new(x:f64 y:f64 z:f64 w:f64 -- v:Vec4) {
	-> w_v
	-> z_v
	-> y_v
	-> x_v
	Vec4 {
		x = x_v
		y = y_v
		z = z_v
		w = w_v
	}
}

/// Create a Vec4 with all components set to zero.
/// @return v Vec4 Zero vector (0, 0, 0, 0)
/// @example vec4::zero -> v
pub fn zero( -- v:Vec4) {
	Vec4 {
		x = 0.0
		y = 0.0
		z = 0.0
		w = 0.0
	}
}

/// Create a Vec4 with all components set to one.
/// @return v Vec4 One vector (1, 1, 1, 1)
/// @example vec4::one -> v
pub fn one( -- v:Vec4) {
	Vec4 {
		x = 1.0
		y = 1.0
		z = 1.0
		w = 1.0
	}
}

/// Add two Vec4 vectors.
/// @param a Vec4 First vector
/// @param b Vec4 Second vector
/// @return result Vec4 Sum of a and b
/// @example v1 v2 vec4::add -> v3
pub fn add(a:Vec4 b:Vec4 -- result:Vec4) {
	-> b
	-> a
	Vec4 {
		x = a @x b @x +
		y = a @y b @y +
		z = a @z b @z +
		w = a @w b @w +
	}
}

/// Subtract two Vec4 vectors.
/// @param a Vec4 First vector
/// @param b Vec4 Second vector
/// @return result Vec4 Difference of a and b
/// @example v1 v2 vec4::subtract -> v3
pub fn subtract(a:Vec4 b:Vec4 -- result:Vec4) {
	-> b
	-> a
	Vec4 {
		x = a @x b @x -
		y = a @y b @y -
		z = a @z b @z -
		w = a @w b @w -
	}
}

/// Multiply Vec4 by scalar.
/// @param v Vec4 Vector to scale
/// @param s f64 Scalar multiplier
/// @return result Vec4 Scaled vector
/// @example v 2.0 vec4::scale -> v2
pub fn scale(v:Vec4 s:f64 -- result:Vec4) {
	-> s
	-> v
	Vec4 {
		x = v @x s *
		y = v @y s *
		z = v @z s *
		w = v @w s *
	}
}

/// Dot product of two Vec4 vectors.
/// @param a Vec4 First vector
/// @param b Vec4 Second vector
/// @return result f64 Dot product
/// @example v1 v2 vec4::dot -> d
pub fn dot(a:Vec4 b:Vec4 -- result:f64) {
	-> b
	-> a
	a @x b @x * a @y b @y * + a @z b @z * + a @w b @w * +
}

/// Length (magnitude) of a Vec4.
/// @param v Vec4 Input vector
/// @return result f64 Length of vector
/// @example v vec4::length -> len
pub fn length(v:Vec4 -- result:f64) {
	-> v
	v @x v @x * v @y v @y * + v @z v @z * + v @w v @w * + math::sqrt
}

/// Normalize a Vec4 to unit length.
/// @param v Vec4 Input vector
/// @return result Vec4 Unit vector in same direction
/// @example v vec4::normalize -> unit
pub fn normalize(v:Vec4 -- result:Vec4) {
	-> v
	v length -> mag
	mag 0.0 gt if {
		v 1.0 mag / scale
	} else {
		zero
	}
}
