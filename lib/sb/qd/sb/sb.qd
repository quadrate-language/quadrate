/// StringBuilder - Efficient string building.
/// Avoids O(n²) cost of repeated strings::concat.
use mem
use strings
use unicode

/// Growable string buffer for efficient string building.
/// @field buf ptr Internal buffer
/// @field len i64 Current length
/// @field cap i64 Buffer capacity
pub struct StringBuilder {
	buf: ptr
	len: i64
	cap: i64
}

/// Create a new StringBuilder with default capacity.
/// @return sb ptr New empty builder
/// @example sb::new -> builder
pub fn new( -- sb:ptr) {
	64 -> cap
	cap mem::alloc! -> buf
	StringBuilder {
		buf = buf
		len = 0
		cap = cap
	}
}

/// Create a StringBuilder with specific initial capacity.
/// @param capacity i64 Initial buffer size
/// @return sb ptr New empty builder
/// @example 1024 sb::with_capacity -> builder
pub fn with_capacity(capacity:i64 -- sb:ptr) {
	capacity 16 < if {
		16 -> capacity
	}
	capacity mem::alloc! -> buf
	StringBuilder {
		buf = buf
		len = 0
		cap = capacity
	}
}

/// Append a string to the builder.
/// @param sb ptr Builder to append to
/// @param s str String to append
/// @return sb ptr Updated builder
/// @example builder "hello" sb::append -> builder
pub fn append(sb:ptr s:str -- sb:ptr) {
	sb @buf -> buf
	sb @len -> curlen
	sb @cap -> cap

	s strings::len -> slen

	// Check if we need to grow
	curlen slen + -> newlen
	newlen cap > if {
		// Double capacity until it fits
		loop {
			cap 2 * -> cap
			newlen cap <= if {
				break
			}
		}
		buf cap mem::realloc! -> buf
	}

	// Bulk copy string data using memcpy
	s strings::data -> sdata
	buf curlen mem::ptr_add sdata slen mem::copy

	// Update builder in-place and return
	buf sb.buf
	newlen sb.len
	cap sb.cap
	sb
}

/// Append a single character (by code point).
/// @param sb ptr Builder to append to
/// @param c i64 Character code to append
/// @return sb ptr Updated builder
/// @example builder 65 sb::append_char -> builder
pub fn append_char(sb:ptr c:i64 -- sb:ptr) {
	sb @buf -> buf
	sb @len -> curlen
	sb @cap -> cap

	// Check if we need to grow
	curlen 1 + cap > if {
		cap 2 * -> cap
		buf cap mem::realloc! -> buf
	}

	// Set the byte
	c buf curlen mem::set_byte

	// Update builder in-place
	buf sb.buf
	curlen 1 + sb.len
	cap sb.cap
	sb
}

/// Append an integer as string.
/// @param sb ptr Builder to append to
/// @param n i64 Integer to append
/// @return sb ptr Updated builder
/// @example builder 42 sb::append_int -> builder
pub fn append_int(sb:ptr n:i64 -- sb:ptr) {
	// Handle negative
	n 0 < if {
		sb unicode::minus append_char -> sb
		0 n - -> n
	}

	// Handle zero
	n 0 == if {
		sb unicode::digit0 append_char
	} else {
		// Count digits
		0 -> count
		n -> temp
		loop {
			temp 0 == if {
				break
			}
			count 1 + -> count
			temp 10 / -> temp
		}

		// Get current position
		sb @buf -> buf
		sb @len -> curlen
		sb @cap -> cap

		// Ensure capacity
		curlen count + cap > if {
			loop {
				cap 2 * -> cap
				curlen count + cap <= if {
					break
				}
			}
			buf cap mem::realloc! -> buf
		}

		// Write digits backwards from end position
		curlen count + 1 - -> pos
		loop {
			n 0 == if {
				break
			}
			n 10 mod unicode::digit0 + -> digit
			digit buf pos mem::set_byte
			pos 1 - -> pos
			n 10 / -> n
		}

		// Update builder in-place
		buf sb.buf
		curlen count + sb.len
		cap sb.cap
		sb
	}
}

/// Get current length of builder content.
/// @param sb ptr Builder to check
/// @return sblen i64 Current content length
/// @example builder sb::len -> sblen
pub fn len(sb:ptr -- sblen:i64) {
	sb @len
}

/// Build the final string (does not consume builder).
/// @param sb ptr Builder to convert
/// @return s str Built string
/// @example builder sb::build -> result
pub fn build(sb:ptr -- s:str) {
	sb @buf sb @len mem::to_string
}

/// Free the builder's resources.
/// @param sb ptr Builder to free
/// @example builder sb::free
pub fn free(sb:ptr -- ) {
	sb @buf mem::free
}

/// Build string and free builder in one call.
/// @param sb ptr Builder to finish
/// @return s str Built string
/// @example builder sb::finish -> result
pub fn finish(sb:ptr -- s:str) {
	sb @buf sb @len mem::to_string -> result
	sb @buf mem::free
	result
}

/// Get the current capacity of the builder.
/// @param sb ptr Builder to check
/// @return cap i64 Current buffer capacity
/// @example builder sb::capacity -> cap
pub fn capacity(sb:ptr -- cap:i64) {
	sb @cap
}

/// Check if the builder is empty.
/// @param sb ptr Builder to check
/// @return empty i64 1 if empty, 0 otherwise
/// @example builder sb::is_empty -> empty
pub fn is_empty(sb:ptr -- empty:i64) {
	sb @len 0 ==
}

/// Append a newline character.
/// @param sb ptr Builder to append to
/// @return sb ptr Updated builder
/// @example builder sb::newline -> builder
pub fn newline(ptr -- ptr) {
	unicode::newline append_char
}

/// Append a space character.
/// @param sb ptr Builder to append to
/// @return sb ptr Updated builder
/// @example builder sb::space -> builder
pub fn space(ptr -- ptr) {
	unicode::space append_char
}

