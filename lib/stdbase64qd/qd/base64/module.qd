/// Base64 encoding and decoding.

import "libstdbase64qd_static.a" as "base64" {
	/// Encode binary data to base64 string.
	/// @param data ptr Buffer to encode
	/// @param len i64 Length of data
	/// @return encoded str Base64-encoded string
	/// @example buf 5 base64::encode -> b64
	pub fn encode(data:ptr len:i64 -- encoded:str)

	/// Decode base64 string to binary data.
	/// @param encoded str Base64-encoded string
	/// @return data ptr Decoded buffer (caller must free)
	/// @return data_len i64 Length of decoded data
	/// @error Invalid base64 encoding
	/// @example "SGVsbG8=" base64::decode! -> buf -> len
	pub fn decode(encoded:str -- data:ptr data_len:i64)!
}
