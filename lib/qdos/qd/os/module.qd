/// Operating system interface.
/// Error codes: Ok=1 (success), specific errors start at 2

/// Error: No such file or directory.
pub const ErrNotFound = 2
/// Error: Permission denied.
pub const ErrPermission = 3
/// Error: File already exists.
pub const ErrExists = 4
/// Error: Path is not a directory.
pub const ErrNotDirectory = 5
/// Error: Path is a directory.
pub const ErrIsDirectory = 6
/// Error: I/O error.
pub const ErrIo = 7
/// Error: No space left on device.
pub const ErrNoSpace = 8
/// Error: Read-only file system.
pub const ErrReadOnly = 9
/// Error: File name too long.
pub const ErrNameTooLong = 10
/// Error: Out of memory.
pub const ErrOutOfMemory = 11
/// Error: Invalid argument.
pub const ErrInvalidArg = 12
import "libqdos.a" as "os" {
	/// Exit the program with status code.
	/// @param code i64 Exit status (0 = success)
	/// @example 0 os::exit
	pub fn exit(code:i64 -- )

	/// Execute a shell command.
	/// @param cmd str Command to execute
	/// @return exitcode i64 Command exit status
	/// @example "ls -la" os::system -> code
	pub fn system(cmd:str -- exitcode:i64)

	/// Get environment variable value.
	/// @param name str Variable name
	/// @return value str Variable value (empty if not set)
	/// @example "HOME" os::getenv -> home
	pub fn getenv(name:str -- value:str)

	/// Set environment variable.
	/// @param name str Variable name
	/// @param value str Variable value
	/// @example "MY_VAR" "hello" os::setenv
	pub fn setenv(name:str value:str -- )

	/// Check if path exists.
	/// @param path str File or directory path
	/// @return exists i64 1 if exists, 0 otherwise
	/// @example "/tmp" os::exists .  // 1
	pub fn exists(path:str -- exists:i64)

	/// Delete a file or empty directory.
	/// @param path str Path to delete
	/// @error ErrNotFound File not found
	/// @error ErrPermission Permission denied
	/// @example "/tmp/test.txt" os::delete!
	pub fn delete(path:str -- )!

	/// Rename or move a file.
	/// @param oldpath str Current path
	/// @param newpath str New path
	/// @error ErrNotFound File not found
	/// @error ErrPermission Permission denied
	/// @example "old.txt" "new.txt" os::rename!
	pub fn rename(oldpath:str newpath:str -- )!

	/// Copy a file.
	/// @param srcpath str Source path
	/// @param dstpath str Destination path
	/// @error ErrNotFound File not found
	/// @error ErrPermission Permission denied
	/// @example "src.txt" "dst.txt" os::copy!
	pub fn copy(srcpath:str dstpath:str -- )!

	/// Create a directory.
	/// @param path str Directory path
	/// @error ErrExists File already exists
	/// @error ErrPermission Permission denied
	/// @example "/tmp/newdir" os::mkdir!
	pub fn mkdir(path:str -- )!

	/// List directory contents.
	/// @param path str Directory path
	/// @return entries ptr Array of entry names
	/// @return count i64 Number of entries
	/// @error ErrNotFound File not found
	/// @error ErrNotDirectory Path is not a directory
	/// @example "/tmp" os::list! -> entries -> count
	pub fn list(path:str -- entries:ptr count:i64)!
}
