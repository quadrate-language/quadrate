/// Testing utilities for unit tests.
///
/// Provides assertion functions for writing test cases.
/// Tests are defined using the `test` keyword and assertions
/// check that conditions are met.
///
/// @example
/// use testing
///
/// test "addition works" {
///     2 3 + 5 testing::assert_eq
/// }
import "libtesting.a" as "testing" {
	/// Assert that two values are equal.
	/// Works with any type (i64, f64, str, ptr).
	/// @param a any First value
	/// @param b any Second value (expected)
	/// @example 5 5 testing::assert_eq  // passes
	/// @example "hello" "hello" testing::assert_eq  // passes
	pub fn assert_eq(a:any b:any -- )

	/// Assert that two values are not equal.
	/// Works with any type (i64, f64, str, ptr).
	/// @param a any First value
	/// @param b any Second value
	/// @example 5 6 testing::assert_ne  // passes
	pub fn assert_ne(a:any b:any -- )

	/// Assert that a value is truthy.
	/// Truthy means: non-zero for integers, non-zero for floats,
	/// non-empty for strings, non-null for pointers.
	/// @param v any Value to check
	/// @example 1 testing::assert_true  // passes
	/// @example "hello" testing::assert_true  // passes
	pub fn assert_true(v:any -- )

	/// Assert that a value is falsy.
	/// Falsy means: zero for integers, zero for floats,
	/// empty for strings, null for pointers.
	/// @param v any Value to check
	/// @example 0 testing::assert_false  // passes
	/// @example "" testing::assert_false  // passes
	pub fn assert_false(v:any -- )

	/// Unconditionally fail a test with a message.
	/// @param msg str Failure message
	/// @example "Not implemented" testing::fail
	pub fn fail(msg:str -- )

	/// Assert that two floats are approximately equal within epsilon.
	/// Useful for comparing floating-point numbers which may have rounding errors.
	/// @param a f64 First value
	/// @param b f64 Second value (expected)
	/// @param epsilon f64 Maximum allowed difference
	/// @example 3.14159 3.14160 0.0001 testing::assert_approx_eq  // passes
	pub fn assert_approx_eq(a:f64 b:f64 epsilon:f64 -- )

	/// Assert that a string contains a substring.
	/// @param haystack str String to search in
	/// @param needle str Substring to search for
	/// @example "hello world" "world" testing::assert_contains  // passes
	pub fn assert_contains(haystack:str needle:str -- )

	/// Assert that a string starts with a prefix.
	/// @param s str String to check
	/// @param prefix str Expected prefix
	/// @example "hello world" "hello" testing::assert_starts_with  // passes
	pub fn assert_starts_with(s:str prefix:str -- )

	/// Assert that a string ends with a suffix.
	/// @param s str String to check
	/// @param suffix str Expected suffix
	/// @example "hello world" "world" testing::assert_ends_with  // passes
	pub fn assert_ends_with(s:str suffix:str -- )
}

/// Assert that a is greater than b.
/// @param a i64 First value
/// @param b i64 Second value
/// @example 5 3 testing::assert_gt  // passes
pub fn assert_gt(a:i64 b:i64 -- ) {
	a b > assert_true
}

/// Assert that a is less than b.
/// @param a i64 First value
/// @param b i64 Second value
/// @example 3 5 testing::assert_lt  // passes
pub fn assert_lt(a:i64 b:i64 -- ) {
	a b < assert_true
}

/// Assert that a is greater than or equal to b.
/// @param a i64 First value
/// @param b i64 Second value
/// @example 5 5 testing::assert_ge  // passes
pub fn assert_ge(a:i64 b:i64 -- ) {
	a b >= assert_true
}

/// Assert that a is less than or equal to b.
/// @param a i64 First value
/// @param b i64 Second value
/// @example 5 5 testing::assert_le  // passes
pub fn assert_le(a:i64 b:i64 -- ) {
	a b <= assert_true
}

/// Assert that value is within an inclusive range [min, max].
/// @param value i64 Value to check
/// @param min i64 Minimum value (inclusive)
/// @param max i64 Maximum value (inclusive)
/// @example 5 0 10 testing::assert_in_range  // passes
pub fn assert_in_range(value:i64 min:i64 max:i64 -- ) {
	-> max -> min -> value
	value min >= value max <= and assert_true
}

/// Assert that a float is greater than another.
/// @param a f64 First value
/// @param b f64 Second value
/// @example 5.0 3.0 testing::assert_gt_f  // passes
pub fn assert_gt_f(a:f64 b:f64 -- ) {
	a b gt assert_true
}

/// Assert that a float is less than another.
/// @param a f64 First value
/// @param b f64 Second value
/// @example 3.0 5.0 testing::assert_lt_f  // passes
pub fn assert_lt_f(a:f64 b:f64 -- ) {
	a b lt assert_true
}

/// Assert that value is positive (> 0).
/// @param value i64 Value to check
/// @example 5 testing::assert_positive  // passes
pub fn assert_positive(value:i64 -- ) {
	value 0 > assert_true
}

/// Assert that value is negative (< 0).
/// @param value i64 Value to check
/// @example -5 testing::assert_negative  // passes
pub fn assert_negative(value:i64 -- ) {
	value 0 < assert_true
}

/// Assert that value is zero.
/// @param value i64 Value to check
/// @example 0 testing::assert_zero  // passes
pub fn assert_zero(value:i64 -- ) {
	value 0 == assert_true
}

/// Assert that value is non-zero.
/// @param value i64 Value to check
/// @example 5 testing::assert_nonzero  // passes
pub fn assert_nonzero(value:i64 -- ) {
	value 0 != assert_true
}
