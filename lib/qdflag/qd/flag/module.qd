/// Command-line flag parsing.
use str
use unicode

/// Parsed command-line arguments.
pub struct Flag {
	argc:i64
	argv:str
}

/// Parse arguments from read instruction.
/// @param argc i64 Argument count from read
/// @return Flag struct on stack
/// @example read flag::parse -> f
pub fn parse(argc:i64 -- ) {
	-> argc
	"" -> argv
	"" -> arg
	"" -> old_argv
	"" -> prefix
	0 -> iter

	0 argc 1 for it {
		-> arg
		"\n" arg str::concat -> prefix
		argv -> old_argv
		prefix argv str::concat -> argv
		iter 0 > if {
			old_argv drop
		}
		prefix drop
		iter 1 + -> iter
	}
	argc 0 > if {
		argv -> old_argv
		argv "\n" str::concat -> argv
		old_argv drop
	} else {
		"\n" -> argv
	}

	Flag {
		argc = argc
		argv = argv
	}
}

/// Free a Flag struct and its argv string.
/// @param f ptr Flag struct to free
/// @example f flag::destroy
pub fn destroy(f:ptr -- ) {
	-> f
	f @argv drop
	f free
}

/// Check if a boolean flag exists.
/// @param f ptr Flag struct
/// @param name str Flag name (e.g., "--verbose")
/// @return present i64 1 if found, 0 otherwise
/// @example f "--verbose" flag::boolean if { "verbose" print nl }
pub fn boolean(f:ptr name:str -- present:i64) {
	-> name
	-> f

	"\n" name str::concat -> pattern
	pattern "\n" str::concat -> pattern

	f @argv pattern str::contains
}

/// Get string value of a flag.
/// @param f ptr Flag struct
/// @param name str Flag name
/// @return value str Flag value
/// @error Flag not found
/// @example f "--name" flag::string! -> name
pub fn string(f:ptr name:str -- value:str)! {
	-> name
	-> f
	"" -> value
	"" -> pattern
	"" -> argv
	"" -> tmp
	0 -> idx
	0 -> start
	0 -> end_idx

	"\n" name str::concat -> pattern
	pattern "\n" str::concat -> tmp
	tmp -> pattern

	f @argv pattern str::index_of -> idx
	idx 0 < if {
		"flag not found" 1 panic
	}

	idx 1 + name str::len + 1 + -> start
	f @argv -> argv

	argv "\n" start str::index_of_from -> end_idx
	end_idx 0 < if {
		"value not found" 1 panic
	}

	argv start end_idx start - str::substring! -> value
	value
}

/// Get integer value of a flag.
/// @param f ptr Flag struct
/// @param name str Flag name
/// @return value i64 Flag value as integer
/// @error Flag not found
/// @example f "--count" flag::int! -> count
pub fn int(f:ptr name:str -- value:i64)! {
	-> name
	-> f
	"" -> s

	f name string if {
		-> s
		s parse_int
	} else {
		"flag not found" 1 panic
		0
	}
}

/// Get float value of a flag.
/// @param f ptr Flag struct
/// @param name str Flag name
/// @return value f64 Flag value as float
/// @error Flag not found
/// @example f "--rate" flag::float! -> rate
pub fn float(f:ptr name:str -- value:f64)! {
	-> name
	-> f

	f name string if {
		-> s
		s parse_float
	} else {
		"flag not found" 1 panic
		0.0
	}
}

/// Get positional argument at index.
/// @param f ptr Flag struct
/// @param index i64 Position (0-based)
/// @return value str Positional argument
/// @error Not implemented
pub fn positional(f:ptr index:i64 -- value:str)! {
	-> index
	-> f
	"positional not yet implemented" 1 panic
	""
}

fn parse_int(s:str -- value:i64) {
	-> s
	0 -> value
	0 -> i
	1 -> sign
	s str::len -> len

	len 0 > if {
		s 0 str::char_at unicode::minus == if {
			-1 -> sign
			1 -> i
		}
	}

	loop {
		i len < if {
			s i str::char_at -> ch
			ch unicode::is_digit if {
				value 10 * ch unicode::digit0 - + -> value
				i 1 + -> i
			} else {
				break
			}
		} else {
			break
		}
	}

	value sign *
}

fn parse_float(s:str -- value:f64) {
	-> s
	0.0 -> value
	0 -> i
	1.0 -> sign
	s str::len -> len
	0 -> seen_dot
	1.0 -> decimal_place

	len 0 > if {
		s 0 str::char_at unicode::minus == if {
			-1.0 -> sign
			1 -> i
		}
	}

	loop {
		i len < if {
			s i str::char_at -> ch
			ch unicode::dot == if {
				1 -> seen_dot
				i 1 + -> i
			} else {
				ch unicode::is_digit if {
					seen_dot if {
						decimal_place 10.0 * -> decimal_place
						value ch unicode::digit0 - cast<f64> decimal_place / + -> value
					} else {
						value 10.0 * ch unicode::digit0 - cast<f64> + -> value
					}
					i 1 + -> i
				} else {
					break
				}
			}
		} else {
			break
		}
	}

	value sign *
}
