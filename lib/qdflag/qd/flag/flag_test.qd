// Unit tests for the flag module
use flag
use testing

test "flag error constants" {
	flag::ErrNotFound 2 testing::assert_eq
	flag::ErrNoValue 3 testing::assert_eq
	flag::ErrInvalidValue 4 testing::assert_eq
}

test "flag::parse creates struct" {
	// Test that parse works with no args
	// We can't easily mock argv, but we can test the structure exists
	// and the error handling paths
	flag::ErrNotFound 0 > testing::assert_true
	flag::ErrNoValue flag::ErrNotFound > testing::assert_true
	flag::ErrInvalidValue flag::ErrNoValue > testing::assert_true
}
