/// HTTP client module.
/// Provides HTTP/HTTPS client functionality.
/// Error codes: Ok=1 (success), specific errors start at 2

// HTTP Status Codes - 1xx Informational
pub const StatusContinue = 100
pub const StatusSwitchingProtocols = 101
pub const StatusProcessing = 102
pub const StatusEarlyHints = 103

// HTTP Status Codes - 2xx Success
pub const StatusOK = 200
pub const StatusCreated = 201
pub const StatusAccepted = 202
pub const StatusNonAuthoritativeInfo = 203
pub const StatusNoContent = 204
pub const StatusResetContent = 205
pub const StatusPartialContent = 206
pub const StatusMultiStatus = 207
pub const StatusAlreadyReported = 208
pub const StatusIMUsed = 226

// HTTP Status Codes - 3xx Redirection
pub const StatusMultipleChoices = 300
pub const StatusMovedPermanently = 301
pub const StatusFound = 302
pub const StatusSeeOther = 303
pub const StatusNotModified = 304
pub const StatusUseProxy = 305
pub const StatusTemporaryRedirect = 307
pub const StatusPermanentRedirect = 308

// HTTP Status Codes - 4xx Client Error
pub const StatusBadRequest = 400
pub const StatusUnauthorized = 401
pub const StatusPaymentRequired = 402
pub const StatusForbidden = 403
pub const StatusNotFound = 404
pub const StatusMethodNotAllowed = 405
pub const StatusNotAcceptable = 406
pub const StatusProxyAuthRequired = 407
pub const StatusRequestTimeout = 408
pub const StatusConflict = 409
pub const StatusGone = 410
pub const StatusLengthRequired = 411
pub const StatusPreconditionFailed = 412
pub const StatusPayloadTooLarge = 413
pub const StatusURITooLong = 414
pub const StatusUnsupportedMediaType = 415
pub const StatusRangeNotSatisfiable = 416
pub const StatusExpectationFailed = 417
pub const StatusTeapot = 418
pub const StatusMisdirectedRequest = 421
pub const StatusUnprocessableEntity = 422
pub const StatusLocked = 423
pub const StatusFailedDependency = 424
pub const StatusTooEarly = 425
pub const StatusUpgradeRequired = 426
pub const StatusPreconditionRequired = 428
pub const StatusTooManyRequests = 429
pub const StatusRequestHeaderFieldsTooLarge = 431
pub const StatusUnavailableForLegalReasons = 451

// HTTP Status Codes - 5xx Server Error
pub const StatusInternalServerError = 500
pub const StatusNotImplemented = 501
pub const StatusBadGateway = 502
pub const StatusServiceUnavailable = 503
pub const StatusGatewayTimeout = 504
pub const StatusHTTPVersionNotSupported = 505
pub const StatusVariantAlsoNegotiates = 506
pub const StatusInsufficientStorage = 507
pub const StatusLoopDetected = 508
pub const StatusNotExtended = 510
pub const StatusNetworkAuthRequired = 511

/// HTTP Response structure
pub struct Response {
	status: i64
	headers: str
	body: str
}

import "libqdhttp.a" as "http" {
	/// Connection failed.
	pub const ErrConnect = 2

	/// TLS handshake failed.
	pub const ErrTls = 3

	/// Request timeout.
	pub const ErrTimeout = 4

	/// Response parse error.
	pub const ErrParse = 5

	/// Invalid URL format.
	pub const ErrInvalidUrl = 6

	/// Too many redirects.
	pub const ErrRedirect = 7

	/// Memory allocation failed.
	pub const ErrMemory = 8

	/// Send failed.
	pub const ErrSend = 9

	/// Receive failed.
	pub const ErrReceive = 10

	/// Create new HTTP request builder.
	/// @param url str The request URL (http:// or https://)
	/// @return req ptr Request object
	/// @example "https://example.com" http::new -> req
	pub fn new(url:str -- req:ptr)

	/// Set request HTTP method.
	/// @param req ptr Request object
	/// @param method str HTTP method (GET, POST, PUT, DELETE, etc.)
	/// @example req "POST" http::method
	pub fn method(req:ptr method:str -- )

	/// Add request header.
	/// @param req ptr Request object
	/// @param name str Header name
	/// @param value str Header value
	/// @example req "Content-Type" "application/json" http::header
	pub fn header(req:ptr name:str value:str -- )

	/// Set request body.
	/// @param req ptr Request object
	/// @param body str Request body content
	/// @example req "{\"key\":\"value\"}" http::body
	pub fn body(req:ptr body:str -- )

	/// Set client certificate for mTLS (mutual TLS).
	/// @param req ptr Request object
	/// @param cert_path str Path to PEM client certificate file
	/// @param key_path str Path to PEM client private key file
	/// @example req "/path/client.crt" "/path/client.key" http::cert
	pub fn cert(req:ptr cert_path:str key_path:str -- )

	/// Execute HTTP request.
	/// @param req ptr Request object
	/// @return resp Response Response struct with status, headers, body
	/// @example req http::send! -> resp  resp @status print
	pub fn send(req:ptr -- resp:Response)!

	/// Free request object (call after send).
	/// @param req ptr Request object
	/// @example req http::free_request
	pub fn free_request(req:ptr -- )

	/// Close and free response.
	/// @param resp Response Response object
	/// @example resp http::close
	pub fn close(resp:Response -- )

	/// Simple GET request.
	/// @param url str The request URL
	/// @return resp Response Response struct
	/// @example "https://example.com" http::get! -> resp
	pub fn get(url:str -- resp:Response)!
}
