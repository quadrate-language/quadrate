/// Thread module - threading primitives using C11 threads.
///
/// Provides:
/// - Thread: spawn, join, detach threads
/// - Mutex: mutual exclusion locks
/// - Channel: Go-style channels for thread communication
/// - WaitGroup: wait for multiple threads to complete
///
/// ## Example
///
///     use thread
///
///     fn worker() {
///         "Hello from thread!" print nl
///     }
///
///     fn main() {
///         // Spawn and join a thread
///         &worker thread::spawn! -> t
///         t join!
///
///         // Mutex for synchronization
///         thread::mutex_new! -> m
///         m lock!
///         m unlock!
///         m free
///
///         // Channel for communication
///         10 thread::chan_buffered! -> ch
///         ch 42 send!
///         ch recv! -> val
///         ch free
///
///         // WaitGroup to wait for multiple threads
///         thread::wg_new! -> wg
///         wg 2 add
///         wg done
///         wg done
///         wg wait!
///         wg free
///     }

/// Error: Failed to create thread.
pub const ErrCreate  = 2

/// Error: Failed to join thread.
pub const ErrJoin    = 3

/// Error: Failed to detach thread.
pub const ErrDetach  = 4

/// Error: Mutex operation failed.
pub const ErrMutex   = 5

/// Error: Channel operation failed.
pub const ErrChannel = 6

/// Error: Channel is closed.
pub const ErrClosed  = 7

/// Error: Operation timed out.
pub const ErrTimeout = 8

// Import raw C functions (internal use)
import "libthread.a" as "thread" {
	fn raw_spawn(func:ptr -- thread:ptr)!
	fn raw_join(thread:ptr -- )!
	fn raw_detach(thread:ptr -- )!
	fn raw_is_alive(thread:ptr -- alive:i64)
	fn raw_sleep(ms:i64 -- )
	fn raw_mutex_new( -- mutex:ptr)!
	fn raw_mutex_lock(mutex:ptr -- )!
	fn raw_mutex_unlock(mutex:ptr -- )!
	fn raw_mutex_try_lock(mutex:ptr -- success:i64)
	fn raw_mutex_free(mutex:ptr -- )
	fn raw_chan_new( -- ch:ptr)!
	fn raw_chan_buffered(capacity:i64 -- ch:ptr)!
	fn raw_chan_send(val:i64 ch:ptr -- )!
	fn raw_chan_recv(ch:ptr -- val:i64)!
	fn raw_chan_try_send(val:i64 ch:ptr -- success:i64)
	fn raw_chan_try_recv(ch:ptr -- val:i64 success:i64)
	fn raw_chan_close(ch:ptr -- )
	fn raw_chan_is_closed(ch:ptr -- closed:i64)
	fn raw_chan_len(ch:ptr -- len:i64)
	fn raw_chan_cap(ch:ptr -- cap:i64)
	fn raw_chan_free(ch:ptr -- )
	fn raw_wg_new( -- wg:ptr)!
	fn raw_wg_add(n:i64 wg:ptr -- )
	fn raw_wg_done(wg:ptr -- )
	fn raw_wg_wait(wg:ptr -- )!
	fn raw_wg_free(wg:ptr -- )
	fn raw_once_new( -- once:ptr)!
	fn raw_once_do(func:ptr once:ptr -- )
	fn raw_once_done(once:ptr -- done:i64)
	fn raw_once_free(once:ptr -- )
	fn raw_barrier_new(n:i64 -- barrier:ptr)!
	fn raw_barrier_wait(barrier:ptr -- is_serial:i64)
	fn raw_barrier_free(barrier:ptr -- )
	fn raw_rwlock_new( -- rwlock:ptr)!
	fn raw_rwlock_read_lock(rwlock:ptr -- )!
	fn raw_rwlock_read_unlock(rwlock:ptr -- )!
	fn raw_rwlock_write_lock(rwlock:ptr -- )!
	fn raw_rwlock_write_unlock(rwlock:ptr -- )!
	fn raw_rwlock_try_read(rwlock:ptr -- success:i64)
	fn raw_rwlock_try_write(rwlock:ptr -- success:i64)
	fn raw_rwlock_free(rwlock:ptr -- )
	fn raw_self( -- id:i64)
	fn raw_yield( -- )
	fn raw_cpu_count( -- count:i64)
}

/// Sleep the current thread for the specified duration in milliseconds.
///
/// @param ms i64 Sleep duration in milliseconds
/// @example 1000 thread::sleep  // Sleep 1 second
pub fn sleep(ms:i64 -- ) {
	ms thread::raw_sleep
}

// ============================================================================
// Thread - spawn, join, detach threads
// ============================================================================

/// A thread handle.
pub struct Thread {
	handle: ptr
}

/// Spawn a new thread running the given function.
///
/// @param func ptr Function pointer (use &function_name)
/// @return t Thread Thread handle
/// @error ErrCreate Failed to create thread
/// @example &worker thread::spawn! -> t
pub fn spawn(func:ptr -- t:Thread)! {
	func thread::raw_spawn! -> h
	Thread { handle = h }
}

/// Wait for the thread to complete.
///
/// @example t join!
pub fn (t:Thread) join( -- )! {
	t <<handle thread::raw_join!
}

/// Detach the thread.
///
/// @example t detach!
pub fn (t:Thread) detach( -- )! {
	t <<handle thread::raw_detach!
}

/// Check if the thread is still alive.
///
/// @return alive i64 1 if running, 0 if completed
/// @example t is_alive -> running
pub fn (t:Thread) is_alive( -- alive:i64) {
	t <<handle thread::raw_is_alive
}

// ============================================================================
// Mutex - mutual exclusion locks
// ============================================================================

/// A mutual exclusion lock.
pub struct Mutex {
	handle: ptr
}

/// Create a new mutex.
///
/// @return m Mutex New mutex handle
/// @error ErrMutex Failed to create mutex
/// @example thread::mutex_new! -> m
pub fn mutex_new( -- m:Mutex)! {
	thread::raw_mutex_new! -> h
	Mutex { handle = h }
}

/// Lock the mutex.
///
/// @example m lock!
pub fn (m:Mutex) lock( -- )! {
	m <<handle thread::raw_mutex_lock!
}

/// Unlock the mutex.
///
/// @example m unlock!
pub fn (m:Mutex) unlock( -- )! {
	m <<handle thread::raw_mutex_unlock!
}

/// Try to lock the mutex without blocking.
///
/// @return success i64 1 if locked, 0 if already held
/// @example m try_lock -> got
pub fn (m:Mutex) try_lock( -- success:i64) {
	m <<handle thread::raw_mutex_try_lock
}

/// Free the mutex.
///
/// @example m free
pub fn (m:Mutex) free( -- ) {
	m <<handle thread::raw_mutex_free
}

// ============================================================================
// Channel - Go-style channels for thread communication
// ============================================================================

/// A channel for thread communication.
pub struct Channel {
	handle: ptr
}

/// Create a new unbuffered (synchronous) channel.
///
/// @return ch Channel New channel handle
/// @error ErrChannel Failed to create channel
/// @example thread::chan_new! -> ch
pub fn chan_new( -- ch:Channel)! {
	thread::raw_chan_new! -> h
	Channel { handle = h }
}

/// Create a new buffered channel.
///
/// @param capacity i64 Buffer size
/// @return ch Channel New channel handle
/// @error ErrChannel Failed to create channel
/// @example 10 thread::chan_buffered! -> ch
pub fn chan_buffered(capacity:i64 -- ch:Channel)! {
	capacity thread::raw_chan_buffered! -> h
	Channel { handle = h }
}

/// Send a value on the channel.
///
/// @param val i64 Value to send
/// @error ErrClosed Cannot send on closed channel
/// @example ch 42 send!
pub fn (ch:Channel) send(val:i64 -- )! {
	val ch <<handle thread::raw_chan_send!
}

/// Receive a value from the channel.
///
/// @return val i64 Received value
/// @error ErrClosed Channel closed with no values
/// @example ch recv! -> val
pub fn (ch:Channel) recv( -- val:i64)! {
	ch <<handle thread::raw_chan_recv!
}

/// Try to send without blocking.
///
/// @param val i64 Value to send
/// @return success i64 1 if sent, 0 if would block
/// @example ch 42 try_send -> sent
pub fn (ch:Channel) try_send(val:i64 -- success:i64) {
	val ch <<handle thread::raw_chan_try_send
}

/// Try to receive without blocking.
///
/// @return val i64 Received value (0 if failed)
/// @return success i64 1 if received, 0 if would block
/// @example ch try_recv -> success -> val
pub fn (ch:Channel) try_recv( -- val:i64 success:i64) {
	ch <<handle thread::raw_chan_try_recv
}

/// Close the channel.
///
/// @example ch close
pub fn (ch:Channel) close( -- ) {
	ch <<handle thread::raw_chan_close
}

/// Check if the channel is closed.
///
/// @return closed i64 1 if closed, 0 if open
/// @example ch is_closed -> done
pub fn (ch:Channel) is_closed( -- closed:i64) {
	ch <<handle thread::raw_chan_is_closed
}

/// Get number of values in channel buffer.
///
/// @return n i64 Number of buffered values
/// @example ch len -> n
pub fn (ch:Channel) len( -- n:i64) {
	ch <<handle thread::raw_chan_len
}

/// Get channel capacity.
///
/// @return cap i64 Buffer capacity (0 for unbuffered)
/// @example ch cap -> c
pub fn (ch:Channel) cap( -- c:i64) {
	ch <<handle thread::raw_chan_cap
}

/// Free the channel.
///
/// @example ch free
pub fn (ch:Channel) free( -- ) {
	ch <<handle thread::raw_chan_free
}

// ============================================================================
// WaitGroup - wait for multiple threads to complete
// ============================================================================

/// A WaitGroup waits for a collection of threads to finish.
pub struct WaitGroup {
	handle: ptr
}

/// Create a new WaitGroup.
///
/// @return wg WaitGroup New WaitGroup handle
/// @error ErrCreate Failed to create WaitGroup
/// @example thread::wg_new! -> wg
pub fn wg_new( -- wg:WaitGroup)! {
	thread::raw_wg_new! -> h
	WaitGroup { handle = h }
}

/// Add to the WaitGroup counter.
///
/// @param n i64 Number to add (usually 1 per thread)
/// @example wg 2 add
pub fn (wg:WaitGroup) add(n:i64 -- ) {
	n wg <<handle thread::raw_wg_add
}

/// Mark one unit of work as done.
///
/// @example wg done
pub fn (wg:WaitGroup) done( -- ) {
	wg <<handle thread::raw_wg_done
}

/// Wait for all threads to complete.
///
/// @error ErrCreate Invalid WaitGroup
/// @example wg wait!
pub fn (wg:WaitGroup) wait( -- )! {
	wg <<handle thread::raw_wg_wait!
}

/// Free the WaitGroup.
///
/// @example wg free
pub fn (wg:WaitGroup) free( -- ) {
	wg <<handle thread::raw_wg_free
}

// ============================================================================
// Once - run initialization code exactly once
// ============================================================================

/// A Once ensures a function is executed only once.
pub struct Once {
	handle: ptr
}

/// Create a new Once.
///
/// @return o Once New Once handle
/// @error ErrCreate Failed to create Once
/// @example thread::once_new! -> o
pub fn once_new( -- o:Once)! {
	thread::raw_once_new! -> h
	Once { handle = h }
}

/// Execute the function exactly once.
/// If multiple threads call this concurrently, only one will execute
/// the function; the others will wait until it completes.
///
/// @param func ptr Function to execute once
/// @example o &init_stuff do
pub fn (o:Once) do(func:ptr -- ) {
	func o <<handle thread::raw_once_do
}

/// Check if the function has been executed.
///
/// @return done i64 1 if executed, 0 if not yet
/// @example o is_done -> executed
pub fn (o:Once) is_done( -- done:i64) {
	o <<handle thread::raw_once_done
}

/// Free the Once.
///
/// @example o free
pub fn (o:Once) free( -- ) {
	o <<handle thread::raw_once_free
}

// ============================================================================
// Thread utilities
// ============================================================================

/// Get the current thread's ID.
/// The ID is implementation-defined but can be used for comparison.
///
/// @return id i64 Current thread ID
/// @example thread::self -> id
pub fn self( -- id:i64) {
	thread::raw_self
}

/// Yield the CPU to allow other threads to run.
///
/// @example thread::yield
pub fn yield( -- ) {
	thread::raw_yield
}

/// Get the number of online CPUs/cores.
/// Useful for determining how many threads to spawn.
///
/// @return count i64 Number of CPUs
/// @example thread::cpu_count -> n
pub fn cpu_count( -- count:i64) {
	thread::raw_cpu_count
}

// ============================================================================
// Barrier - synchronize threads at a point
// ============================================================================

/// A Barrier synchronizes multiple threads at a point.
pub struct Barrier {
	handle: ptr
}

/// Create a new Barrier for n threads.
///
/// @param n i64 Number of threads that must reach the barrier
/// @return b Barrier New Barrier handle
/// @error ErrCreate Failed to create Barrier
/// @example 4 thread::barrier_new! -> b
pub fn barrier_new(n:i64 -- b:Barrier)! {
	n thread::raw_barrier_new! -> h
	Barrier { handle = h }
}

/// Wait at the barrier until all threads arrive.
/// Returns 1 for exactly one thread (the "serial thread"),
/// 0 for all other threads. This can be used to have one
/// thread perform serial work after the barrier.
///
/// @return is_serial i64 1 for serial thread, 0 otherwise
/// @example b wait -> serial
pub fn (b:Barrier) wait( -- is_serial:i64) {
	b <<handle thread::raw_barrier_wait
}

/// Free the Barrier.
///
/// @example b free
pub fn (b:Barrier) free( -- ) {
	b <<handle thread::raw_barrier_free
}

// ============================================================================
// RwLock - read-write lock (multiple readers, single writer)
// ============================================================================

/// A RwLock allows multiple readers or one writer.
/// Writers are prioritized to prevent starvation.
pub struct RwLock {
	handle: ptr
}

/// Create a new RwLock.
///
/// @return rw RwLock New RwLock handle
/// @error ErrCreate Failed to create RwLock
/// @example thread::rwlock_new! -> rw
pub fn rwlock_new( -- rw:RwLock)! {
	thread::raw_rwlock_new! -> h
	RwLock { handle = h }
}

/// Acquire a read lock.
/// Multiple threads can hold read locks simultaneously.
/// Blocks if a writer is active or waiting.
///
/// @example rw read_lock!
pub fn (rw:RwLock) read_lock( -- )! {
	rw <<handle thread::raw_rwlock_read_lock!
}

/// Release a read lock.
///
/// @example rw read_unlock!
pub fn (rw:RwLock) read_unlock( -- )! {
	rw <<handle thread::raw_rwlock_read_unlock!
}

/// Acquire a write lock.
/// Only one thread can hold the write lock.
/// Blocks until all readers and writers release.
///
/// @example rw write_lock!
pub fn (rw:RwLock) write_lock( -- )! {
	rw <<handle thread::raw_rwlock_write_lock!
}

/// Release a write lock.
///
/// @example rw write_unlock!
pub fn (rw:RwLock) write_unlock( -- )! {
	rw <<handle thread::raw_rwlock_write_unlock!
}

/// Try to acquire a read lock without blocking.
///
/// @return success i64 1 if acquired, 0 otherwise
/// @example rw try_read -> got
pub fn (rw:RwLock) try_read( -- success:i64) {
	rw <<handle thread::raw_rwlock_try_read
}

/// Try to acquire a write lock without blocking.
///
/// @return success i64 1 if acquired, 0 otherwise
/// @example rw try_write -> got
pub fn (rw:RwLock) try_write( -- success:i64) {
	rw <<handle thread::raw_rwlock_try_write
}

/// Free the RwLock.
///
/// @example rw free
pub fn (rw:RwLock) free( -- ) {
	rw <<handle thread::raw_rwlock_free
}
