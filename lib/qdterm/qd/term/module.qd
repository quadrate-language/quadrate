/// Terminal colors and formatting using ANSI escape codes.
/// Use these constants to colorize terminal output.
/// @example term::Green print "PASS" print term::Reset print nl

/// Reset all formatting.
pub const Reset = "\x1b[0m"

/// Bold text.
pub const Bold = "\x1b[1m"
/// Dim text.
pub const Dim = "\x1b[2m"
/// Italic text.
pub const Italic = "\x1b[3m"
/// Underline text.
pub const Underline = "\x1b[4m"

/// Black foreground.
pub const Black = "\x1b[30m"
/// Red foreground.
pub const Red = "\x1b[31m"
/// Green foreground.
pub const Green = "\x1b[32m"
/// Yellow foreground.
pub const Yellow = "\x1b[33m"
/// Blue foreground.
pub const Blue = "\x1b[34m"
/// Magenta foreground.
pub const Magenta = "\x1b[35m"
/// Cyan foreground.
pub const Cyan = "\x1b[36m"
/// White foreground.
pub const White = "\x1b[37m"

/// Bright black (gray) foreground.
pub const BrightBlack = "\x1b[90m"
/// Bright red foreground.
pub const BrightRed = "\x1b[91m"
/// Bright green foreground.
pub const BrightGreen = "\x1b[92m"
/// Bright yellow foreground.
pub const BrightYellow = "\x1b[93m"
/// Bright blue foreground.
pub const BrightBlue = "\x1b[94m"
/// Bright magenta foreground.
pub const BrightMagenta = "\x1b[95m"
/// Bright cyan foreground.
pub const BrightCyan = "\x1b[96m"
/// Bright white foreground.
pub const BrightWhite = "\x1b[97m"

/// Black background.
pub const BgBlack = "\x1b[40m"
/// Red background.
pub const BgRed = "\x1b[41m"
/// Green background.
pub const BgGreen = "\x1b[42m"
/// Yellow background.
pub const BgYellow = "\x1b[43m"
/// Blue background.
pub const BgBlue = "\x1b[44m"
/// Magenta background.
pub const BgMagenta = "\x1b[45m"
/// Cyan background.
pub const BgCyan = "\x1b[46m"
/// White background.
pub const BgWhite = "\x1b[47m"
