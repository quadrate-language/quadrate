{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quadrate",
  "scopeName": "source.quadrate",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#builtins" },
    { "include": "#types" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.quadrate",
          "match": "//.*$"
        },
        {
          "name": "comment.block.quadrate",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.quadrate",
          "match": "\\b(if|else|loop|for|break|continue|defer)\\b"
        },
        {
          "name": "keyword.other.quadrate",
          "match": "\\b(fn|use|const|pub|struct|import|as)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.quadrate",
          "match": "->"
        },
        {
          "name": "punctuation.separator.namespace.quadrate",
          "match": "::"
        },
        {
          "name": "keyword.operator.signature.quadrate",
          "match": "--"
        },
        {
          "name": "keyword.operator.error.quadrate",
          "match": "!"
        },
        {
          "name": "keyword.operator.colon.quadrate",
          "match": ":"
        },
        {
          "name": "keyword.operator.deref.quadrate",
          "match": "\\$"
        },
        {
          "name": "keyword.operator.ref.quadrate",
          "match": "&"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.quadrate",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.quadrate",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.quadrate",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.quadrate",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.quadrate",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.stack.quadrate",
          "match": "\\b(dup|dup2|dupd|swap|swap2|swapd|drop|drop2|over|over2|overd|rot|nip|nipd|tuck|pick|roll|depth|clear|len|nth|free)\\b"
        },
        {
          "name": "support.function.arithmetic.quadrate",
          "match": "\\b(add|sub|mul|div|mod|neg|inc|dec)\\b"
        },
        {
          "name": "support.function.math.quadrate",
          "match": "\\b(abs|sqrt|sq|cb|cbrt|pow|inv|fac|sin|cos|tan|asin|acos|atan|ln|log10|ceil|floor|round|min|max)\\b"
        },
        {
          "name": "support.function.comparison.quadrate",
          "match": "\\b(eq|neq|lt|gt|lte|gte|within)\\b"
        },
        {
          "name": "support.function.array.quadrate",
          "match": "\\b(append|makef|makei|makep|makes|set)\\b"
        },
        {
          "name": "support.function.cast.quadrate",
          "match": "\\b(castf|casti|casts)\\b"
        },
        {
          "name": "support.function.io.quadrate",
          "match": "\\b(print|prints|printv|printsv|nl|read|call)\\b"
        },
        {
          "name": "support.function.thread.quadrate",
          "match": "\\b(spawn|wait|detach)\\b"
        },
        {
          "name": "support.function.error.quadrate",
          "match": "\\b(error)\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.quadrate",
      "match": "\\b(i64|f64|str|ptr|any)\\b"
    }
  }
}
