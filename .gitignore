.tmp*
.out/
qd_*/
.failed_tests

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Shared libraries (built artifacts)
*.so

# AI assistant context (local only)
CLAUDE.md

# Standalone binary artifacts
main

# Meson subprojects (downloaded dependencies)
subprojects/*/
!subprojects/*.wrap
!subprojects/packagefiles/
subprojects/.wraplock

# Benchmark artifacts
benchmarks/arithmetic_qd_typeaware
benchmarks/arithmetic_v8_specialized

# Command binaries (built in-place)
cmd/quadmcp/quadmcp

# Fuzzer artifacts
crash-*
vgcore.*
oom-*
slow-unit-*
# `fuzz/` matched any directory of that name, so it swallowed tests/fuzz -- which is
# source, and is why two of the targets tests/fuzz/meson.build names were never
# committed. `build` above already covers the fuzz build directory. The corpus has its
# own .gitignore keeping the edge_* seeds; a rule here would override that negation.
/benchmarks/csharp/bin
/benchmarks/csharp/obj
/benchmarks/mat4x4_rust
/benchmarks/mat4x4_qd
/benchmarks/mat4x4_go
/benchmarks/mat4x4_c
/*.tar.gz

# Kernel example build artifacts
examples/kernel/*.o
examples/kernel/*.elf
examples/kernel/*.iso
examples/kernel/isodir/
