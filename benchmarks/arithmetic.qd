use fmt
use time

// Benchmark: tight arithmetic loop
fn benchmark_arithmetic(iterations:i64 -- result:i64) {
	0 -> sum
	0 iterations 1 for it {
		sum it + it * 3 + 7 % -> sum
	}
	sum
}

// Benchmark: recursive fibonacci
fn fib(n:i64 -- result:i64) {
	n 2 lt if {
		n
	} else {
		n 1 - fib
		n 2 - fib
		+
	}
}

fn main() {
	"=== Quadrate Benchmarks ===\n" fmt::printf

	// Benchmark 1: Arithmetic loop (10 million iterations)
	10000000 -> iterations
	iterations benchmark_arithmetic drop // warmup
	9999999999 -> best
	0 -> result
	0 3 1 for run {
		time::now -> start
		iterations benchmark_arithmetic -> r
		time::now start - -> elapsed
		elapsed best lt if {
			elapsed -> best
			r -> result
		}
	}
	iterations "Arithmetic loop (%d iterations):\n" fmt::printf
	best 1000000 / "  Time: %d ms\n" fmt::printf
	result "  Result: %d\n" fmt::printf

	// Benchmark 2: Recursive fibonacci
	35 -> n
	n fib drop // warmup
	9999999999 -> best
	0 3 1 for run {
		time::now -> start
		n fib -> r
		time::now start - -> elapsed
		elapsed best lt if {
			elapsed -> best
			r -> result
		}
	}
	n "Fibonacci (n=%d):\n" fmt::printf
	best 1000000 / "  Time: %d ms\n" fmt::printf
	result "  Result: %d\n" fmt::printf
}
