fn mcp_tools_list(id:str -- response:str) {
	"quadrate_list_modules"
	"List all available Quadrate standard library modules (returns JSON with name, description, function count)"
	"" "" build_tool -> tool1

	"name" "Module name (e.g., 'math', 'strings', 'io')" build_string_prop json::kv_raw json::obj -> props
	"name" json::encode json::arr -> req
	"quadrate_get_module"
	"Get full documentation for a specific Quadrate module including all functions, constants, and structs"
	props req build_tool -> tool2

	"module" "Module name" build_string_prop json::kv_raw
	"function" "Function name" build_string_prop json::kv_raw json::join
	json::obj -> props
	"module" json::encode "function" json::encode json::join json::arr -> req
	"quadrate_get_function"
	"Get detailed documentation for a specific Quadrate function (searches module JSON for function)"
	props req build_tool -> tool3

	"query" "Search query (case-insensitive)" build_string_prop json::kv_raw json::obj -> props
	"query" json::encode json::arr -> req
	"quadrate_search"
	"Search Quadrate documentation. Returns builtins.json, then module files containing the query."
	props req build_tool -> tool4

	"quadrate_get_builtins"
	"Get all Quadrate builtin instructions organized by category (stack ops, arithmetic, comparison, etc.)"
	"" "" build_tool -> tool5

	"name" "Instruction name or alias (e.g., 'dup', 'swap', 'add', '+', '==')" build_string_prop json::kv_raw json::obj -> props
	"name" json::encode json::arr -> req
	"quadrate_get_builtin"
	"Get documentation for a specific builtin instruction. Search the builtins JSON for the name."
	props req build_tool -> tool6

	"quadrate_get_syntax"
	"Get Quadrate language syntax reference: types, keywords, operators, and common patterns"
	"" "" build_tool -> tool7

	"name" "Keyword name (e.g., 'fn', 'if', 'for', 'struct', 'enum', 'use', 'loop')" build_string_prop json::kv_raw json::obj -> props
	"name" json::encode json::arr -> req
	"quadrate_get_keyword"
	"Get documentation for a specific Quadrate keyword. Search language.json keywords array."
	props req build_tool -> tool8

	"name" "Operator symbol or alias (e.g., '+', 'add', '==', 'eq', '->')" build_string_prop json::kv_raw json::obj -> props
	"name" json::encode json::arr -> req
	"quadrate_get_operator"
	"Get documentation for a specific Quadrate operator. Search language.json operators array."
	props req build_tool -> tool9

	"query" "Function name to search for (fuzzy matching, e.g., 'readfile' finds 'read_file')" build_string_prop json::kv_raw
	"module" "Optional: limit search to specific module" build_string_prop json::kv_raw json::join
	json::obj -> props
	"query" json::encode json::arr -> req
	"quadrate_find_function"
	"Find functions by name using fuzzy matching. Handles typos and partial names."
	props req build_tool -> tool10

	"signature" "Signature pattern (e.g., 'str -- i64', 'f64 f64 -- f64')" build_string_prop json::kv_raw json::obj -> props
	"signature" json::encode json::arr -> req
	"quadrate_search_by_signature"
	"Find functions by their type signature pattern. Useful for discovering functions."
	props req build_tool -> tool11

	"module" "Module name" build_string_prop json::kv_raw
	"error" "Error constant name (e.g., 'ErrNotFound', 'ErrInvalidArg')" build_string_prop json::kv_raw json::join
	json::obj -> props
	"module" json::encode "error" json::encode json::join json::arr -> req
	"quadrate_get_error"
	"Get documentation for a module error constant including description and handling tips."
	props req build_tool -> tool12

	"code" "Quadrate code to trace (e.g., '1 2 + dup')" build_string_prop json::kv_raw json::obj -> props
	"code" json::encode json::arr -> req
	"quadrate_trace_stack"
	"Simulate stack operations step-by-step. Shows stack state after each operation. Essential for understanding stack-based code."
	props req build_tool -> tool13

	"template" "Template name: file-read, file-write, json-parse, http-get, cli-args, struct-crud, error-handling, loop-array" build_string_prop json::kv_raw json::obj -> props
	"template" json::encode json::arr -> req
	"quadrate_generate_template"
	"Generate boilerplate code for common tasks. Returns ready-to-use code templates."
	props req build_tool -> tool14

	"signature" "Function signature (e.g., 'a:str b:i64 -- result:ptr count:i64')" build_string_prop json::kv_raw json::obj -> props
	"signature" json::encode json::arr -> req
	"quadrate_explain_signature"
	"Explain a Quadrate function signature in plain English. Describes inputs, outputs, and stack behavior."
	props req build_tool -> tool15

	"from" "Source type (i64, f64, str, ptr, bool)" build_string_prop json::kv_raw
	"to" "Target type (i64, f64, str, ptr, bool)" build_string_prop json::kv_raw json::join json::obj -> props
	"from" json::encode "to" json::encode json::join json::arr -> req
	"quadrate_type_conversion"
	"Explain how to convert between Quadrate types. Shows conversion functions, patterns, and common pitfalls."
	props req build_tool -> tool16

	tool1
	tool2 json::join
	tool3 json::join
	tool4 json::join
	tool5 json::join
	tool6 json::join
	tool7 json::join
	tool8 json::join
	tool9 json::join
	tool10 json::join
	tool11 json::join
	tool12 json::join
	tool13 json::join
	tool14 json::join
	tool15 json::join
	tool16 json::join
	json::arr -> tools_arr

	"tools" tools_arr json::kv_raw json::obj -> result
	id result rpc_result
}

const MODULE_LIST = "bits,bytes,ct,flag,fmt,hof,io,limits,math,mem,net,os,path,rand,sb,signal,sort,str,strconv,term,testing,thread,time,unicode"

fn module_entry(ds:ptr name:str -- entry:str) {
	ds name load_module -> m

	m "description" json::get_string -> _ -> desc

	m "functions" json::get_array -> found -> funcs
	found if { funcs json::array_len } else { 0 } -> func_count

	m "constants" json::get_array -> found -> consts
	found if { consts json::array_len } else { 0 } -> const_count

	"name" name json::kv
	"description" desc json::kv json::join
	"functions" func_count json::kv_int json::join
	"constants" const_count json::kv_int json::join
	json::obj
}

fn tool_list_modules(ds:ptr -- result:str) {
	ds "bits" module_entry
	ds "bytes" module_entry json::join
	ds "ct" module_entry json::join
	ds "flag" module_entry json::join
	ds "fmt" module_entry json::join
	ds "hof" module_entry json::join
	ds "io" module_entry json::join
	ds "limits" module_entry json::join
	ds "math" module_entry json::join
	ds "mem" module_entry json::join
	ds "net" module_entry json::join
	ds "os" module_entry json::join
	ds "path" module_entry json::join
	ds "rand" module_entry json::join
	ds "sb" module_entry json::join
	ds "signal" module_entry json::join
	ds "sort" module_entry json::join
	ds "strings" module_entry json::join
	ds "strconv" module_entry json::join
	ds "term" module_entry json::join
	ds "testing" module_entry json::join
	ds "thread" module_entry json::join
	ds "time" module_entry json::join
	ds "tty" module_entry json::join
	ds "unicode" module_entry json::join
	json::arr tool_text_result
}

fn tool_get_module(ds:ptr args:str -- result:str) {
	args "name" json::get_string -> found -> mod_name
	found 0 == if {
		"Missing required parameter: name" tool_error_result
	} else {
		ds mod_name load_module -> mod_json
		mod_json "name" json::get_string -> found -> _
		found 0 == if {
			"Module '" mod_name strings::concat "' not found. Available: " strings::concat MODULE_LIST strings::concat tool_error_result
		} else {
			mod_json tool_text_result
		}
	}
}

fn find_in_array(arr:str name:str -- item:str found:i64) {
	arr json::array_len -> len
	0 -> i
	"" -> result
	0 -> found
	loop {
		i len < found 0 == * 0 == if { break }
		arr i json::array_get_object -> ok -> obj
		ok if {
			obj "name" json::get_string -> ok -> obj_name
			ok obj_name name strings::compare 0 == * if {
				obj -> result
				1 -> found
			}
		}
		i 1 + -> i
	}
	result found
}

fn find_related_functions(funcs:str current_name:str -- related:str) {
	funcs json::array_len -> len
	"" -> result
	0 -> count

	0 -> i
	loop {
		i len >= count 5 >= or if { break }
		funcs i json::array_get_object -> ok -> func
		ok if {
			func "name" json::get_string -> ok -> name
			ok if {
				name current_name strings::compare 0 != if {
					current_name name fuzzy::score 100 > if {
						count 0 > if {
							result ", " strings::concat -> result
						}
						result name strings::concat -> result
						count 1 + -> count
					}
				}
			}
		}
		i 1 + -> i
	}
	result
}

fn tool_get_function(ds:ptr args:str -- result:str) {
	args "module" json::get_string -> found -> mod_name
	found 0 == if {
		"Missing required parameter: module" tool_error_result
	} else {
		args "function" json::get_string -> found -> fn_name
		found 0 == if {
			"Missing required parameter: function" tool_error_result
		} else {
			ds mod_name load_module -> mod_json
			mod_json "functions" json::get_array -> found -> funcs
			found 0 == if {
				"Module '" mod_name strings::concat "' not found" strings::concat tool_error_result
			} else {
				funcs fn_name find_in_array -> found -> func_obj
				found if {
					funcs fn_name find_related_functions -> related
					related strings::len 0 > if {
						"Function found:\n" func_obj strings::concat "\n\nRelated functions in " strings::concat mod_name strings::concat ": " strings::concat related strings::concat tool_text_result
					} else {
						func_obj tool_text_result
					}
				} else {
					"Function '" fn_name strings::concat "' not found in module '" strings::concat mod_name strings::concat "'" strings::concat tool_error_result
				}
			}
		}
	}
}

fn search_module(ds:ptr name:str query:str result:str -- new_result:str) {
	ds name load_module -> m
	m query fuzzy::contains_ci if {
		result "=== " strings::concat name strings::concat " module ===\n" strings::concat m strings::concat "\n\n" strings::concat
	} else {
		result
	}
}

fn tool_search(ds:ptr args:str -- result:str) {
	args "query" json::get_string -> found -> query
	found 0 == if {
		"Missing required parameter: query" tool_error_result
	} else {
		"Search results for: " query strings::concat "\n\n" strings::concat -> r

		ds @builtins query fuzzy::contains_ci if {
			r "=== Builtins ===\n" strings::concat ds @builtins strings::concat "\n\n" strings::concat -> r
		}

		ds @language query fuzzy::contains_ci if {
			r "=== Language Reference ===\n" strings::concat ds @language strings::concat "\n\n" strings::concat -> r
		}

		ds "bits" query r search_module -> r
		ds "bytes" query r search_module -> r
		ds "ct" query r search_module -> r
		ds "flag" query r search_module -> r
		ds "fmt" query r search_module -> r
		ds "hof" query r search_module -> r
		ds "io" query r search_module -> r
		ds "limits" query r search_module -> r
		ds "math" query r search_module -> r
		ds "mem" query r search_module -> r
		ds "net" query r search_module -> r
		ds "os" query r search_module -> r
		ds "path" query r search_module -> r
		ds "rand" query r search_module -> r
		ds "sb" query r search_module -> r
		ds "signal" query r search_module -> r
		ds "sort" query r search_module -> r
		ds "strings" query r search_module -> r
		ds "strconv" query r search_module -> r
		ds "term" query r search_module -> r
		ds "testing" query r search_module -> r
		ds "thread" query r search_module -> r
		ds "time" query r search_module -> r
		ds "tty" query r search_module -> r
		ds "unicode" query r search_module -> r

		r tool_text_result
	}
}

fn tool_get_builtins(ds:ptr -- result:str) {
	ds @builtins dup strings::len 2 > if {
		tool_text_result
	} else {
		drop "Builtins documentation not available" tool_error_result
	}
}

fn find_builtin(builtins:str name:str -- item:str found:i64) {
	builtins "categories" json::get_array -> ok -> cats
	ok 0 == if {
		"" 0
	} else {
		cats json::array_len -> num_cats
		0 -> i
		"" -> result
		0 -> found
		loop {
			i num_cats < found 0 == * 0 == if { break }
			cats i json::array_get_object -> ok -> cat
			ok if {
				cat "instructions" json::get_array -> ok -> instrs
				ok if {
					instrs json::array_len -> num_instrs
					0 -> j
					loop {
						j num_instrs < found 0 == * 0 == if { break }
						instrs j json::array_get_object -> ok -> instr
						ok if {
							instr "name" json::get_string -> ok -> instr_name
							ok instr_name name strings::compare 0 == * if {
								instr -> result
								1 -> found
							} else {
								instr "alias" json::get_string -> ok -> alias
								ok alias name strings::compare 0 == * if {
									instr -> result
									1 -> found
								}
							}
						}
						j 1 + -> j
					}
				}
			}
			i 1 + -> i
		}
		result found
	}
}

fn tool_get_builtin(ds:ptr args:str -- result:str) {
	args "name" json::get_string -> found -> name
	found 0 == if {
		"Missing required parameter: name" tool_error_result
	} else {
		ds @builtins name find_builtin -> found -> builtin_obj
		found if {
			builtin_obj tool_text_result
		} else {
			"Builtin '" name strings::concat "' not found. Try: dup, swap, add, +, ==, etc." strings::concat tool_error_result
		}
	}
}

fn tool_get_syntax(ds:ptr -- result:str) {
	ds @language dup strings::len 2 > if {
		tool_text_result
	} else {
		drop "Language reference not available" tool_error_result
	}
}

fn tool_get_keyword(ds:ptr args:str -- result:str) {
	args "name" json::get_string -> found -> name
	found 0 == if {
		"Missing required parameter: name" tool_error_result
	} else {
		ds @language "keywords" json::get_array -> found -> keywords
		found 0 == if {
			"Language reference not available" tool_error_result
		} else {
			keywords name find_in_array -> found -> kw_obj
			found if {
				kw_obj tool_text_result
			} else {
				"Keyword '" name strings::concat "' not found. Try: fn, if, else, loop, for, struct, use, const, pub" strings::concat tool_error_result
			}
		}
	}
}

fn find_with_alias(arr:str name:str -- item:str found:i64) {
	arr json::array_len -> len
	0 -> i
	"" -> result
	0 -> found
	loop {
		i len < found 0 == * 0 == if { break }
		arr i json::array_get_object -> ok -> obj
		ok if {
			obj "name" json::get_string -> ok -> obj_name
			ok obj_name name strings::compare 0 == * if {
				obj -> result
				1 -> found
			} else {
				obj "alias" json::get_string -> ok -> alias
				ok alias name strings::compare 0 == * if {
					obj -> result
					1 -> found
				}
			}
		}
		i 1 + -> i
	}
	result found
}

fn tool_get_operator(ds:ptr args:str -- result:str) {
	args "name" json::get_string -> found -> name
	found 0 == if {
		"Missing required parameter: name" tool_error_result
	} else {
		ds @language "operators" json::get_array -> found -> operators
		found 0 == if {
			"Language reference not available" tool_error_result
		} else {
			operators name find_with_alias -> found -> op_obj
			found if {
				op_obj tool_text_result
			} else {
				"Operator '" name strings::concat "' not found. Try: +, -, *, /, %, ==, !=, <, >, ->" strings::concat tool_error_result
			}
		}
	}
}

fn fuzzy_find_in_module(ds:ptr mod_name:str query:str results:str count:i64 -- new_results:str new_count:i64) {
	count 10 >= if {
		results count
	} else {
		ds mod_name load_module -> mod_json
		mod_json "functions" json::get_array -> found -> funcs
		found 0 == if {
			results count
		} else {
			funcs json::array_len -> len
			0 -> i
			loop {
				i len >= count 10 >= or if { break }
				funcs i json::array_get_object -> ok -> func
				ok if {
					func "name" json::get_string -> ok -> name
					ok if {
						query name fuzzy::score -> score
						score 150 > if {
							func "signature" json::get_string -> _ -> sig
							count 0 > if {
								results "\n" strings::concat -> results
							}
							results mod_name strings::concat "::" strings::concat name strings::concat " " strings::concat sig strings::concat " (score: " strings::concat score strconv::itoa strings::concat ")" strings::concat -> results
							count 1 + -> count
						}
					}
				}
				i 1 + -> i
			}
			results count
		}
	}
}

fn tool_find_function(ds:ptr args:str -- result:str) {
	args "query" json::get_string -> found -> query
	found 0 == if {
		"Missing required parameter: query" tool_error_result
	} else {
		args "module" json::get_string -> has_mod -> specific_mod

		"Fuzzy search results for: " query strings::concat "\n\n" strings::concat -> r
		0 -> count

		has_mod if {
			ds specific_mod query r count fuzzy_find_in_module -> count -> r
		} else {
			ds "bits" query r count fuzzy_find_in_module -> count -> r
			ds "bytes" query r count fuzzy_find_in_module -> count -> r
			ds "ct" query r count fuzzy_find_in_module -> count -> r
			ds "flag" query r count fuzzy_find_in_module -> count -> r
			ds "fmt" query r count fuzzy_find_in_module -> count -> r
			ds "hof" query r count fuzzy_find_in_module -> count -> r
			ds "io" query r count fuzzy_find_in_module -> count -> r
			ds "limits" query r count fuzzy_find_in_module -> count -> r
			ds "math" query r count fuzzy_find_in_module -> count -> r
			ds "mem" query r count fuzzy_find_in_module -> count -> r
			ds "net" query r count fuzzy_find_in_module -> count -> r
			ds "os" query r count fuzzy_find_in_module -> count -> r
			ds "path" query r count fuzzy_find_in_module -> count -> r
			ds "rand" query r count fuzzy_find_in_module -> count -> r
			ds "sb" query r count fuzzy_find_in_module -> count -> r
			ds "signal" query r count fuzzy_find_in_module -> count -> r
			ds "sort" query r count fuzzy_find_in_module -> count -> r
			ds "strings" query r count fuzzy_find_in_module -> count -> r
			ds "strconv" query r count fuzzy_find_in_module -> count -> r
			ds "term" query r count fuzzy_find_in_module -> count -> r
			ds "testing" query r count fuzzy_find_in_module -> count -> r
			ds "thread" query r count fuzzy_find_in_module -> count -> r
			ds "time" query r count fuzzy_find_in_module -> count -> r
			ds "tty" query r count fuzzy_find_in_module -> count -> r
			ds "unicode" query r count fuzzy_find_in_module -> count -> r
		}

		count 0 == if {
			r "No functions found matching '" strings::concat query strings::concat "'" strings::concat -> r
		}

		r tool_text_result
	}
}

fn sig_matches_pattern(sig:str pattern:str -- matches:i64) {
	sig pattern fuzzy::contains_ci
}

fn search_by_sig_in_module(ds:ptr mod_name:str pattern:str results:str count:i64 -- new_results:str new_count:i64) {
	count 15 >= if {
		results count
	} else {
		ds mod_name load_module -> mod_json
		mod_json "functions" json::get_array -> found -> funcs
		found 0 == if {
			results count
		} else {
			funcs json::array_len -> len
			0 -> i
			loop {
				i len >= count 15 >= or if { break }
				funcs i json::array_get_object -> ok -> func
				ok if {
					func "signature" json::get_string -> ok -> sig
					ok if {
						sig pattern sig_matches_pattern if {
							func "name" json::get_string -> _ -> name
							count 0 > if {
								results "\n" strings::concat -> results
							}
							results mod_name strings::concat "::" strings::concat name strings::concat " " strings::concat sig strings::concat -> results
							count 1 + -> count
						}
					}
				}
				i 1 + -> i
			}
			results count
		}
	}
}

fn tool_search_by_signature(ds:ptr args:str -- result:str) {
	args "signature" json::get_string -> found -> pattern
	found 0 == if {
		"Missing required parameter: signature" tool_error_result
	} else {
		"Functions matching signature pattern '" pattern strings::concat "':\n\n" strings::concat -> r
		0 -> count

		ds "bits" pattern r count search_by_sig_in_module -> count -> r
		ds "bytes" pattern r count search_by_sig_in_module -> count -> r
		ds "ct" pattern r count search_by_sig_in_module -> count -> r
		ds "flag" pattern r count search_by_sig_in_module -> count -> r
		ds "fmt" pattern r count search_by_sig_in_module -> count -> r
		ds "hof" pattern r count search_by_sig_in_module -> count -> r
		ds "io" pattern r count search_by_sig_in_module -> count -> r
		ds "limits" pattern r count search_by_sig_in_module -> count -> r
		ds "math" pattern r count search_by_sig_in_module -> count -> r
		ds "mem" pattern r count search_by_sig_in_module -> count -> r
		ds "net" pattern r count search_by_sig_in_module -> count -> r
		ds "os" pattern r count search_by_sig_in_module -> count -> r
		ds "path" pattern r count search_by_sig_in_module -> count -> r
		ds "rand" pattern r count search_by_sig_in_module -> count -> r
		ds "sb" pattern r count search_by_sig_in_module -> count -> r
		ds "signal" pattern r count search_by_sig_in_module -> count -> r
		ds "sort" pattern r count search_by_sig_in_module -> count -> r
		ds "strings" pattern r count search_by_sig_in_module -> count -> r
		ds "strconv" pattern r count search_by_sig_in_module -> count -> r
		ds "term" pattern r count search_by_sig_in_module -> count -> r
		ds "testing" pattern r count search_by_sig_in_module -> count -> r
		ds "thread" pattern r count search_by_sig_in_module -> count -> r
		ds "time" pattern r count search_by_sig_in_module -> count -> r
		ds "tty" pattern r count search_by_sig_in_module -> count -> r
		ds "unicode" pattern r count search_by_sig_in_module -> count -> r

		count 0 == if {
			r "No functions found with signature matching '" strings::concat pattern strings::concat "'\n\nTry patterns like: 'str -- i64', 'f64 -- f64', 'ptr'" strings::concat -> r
		}

		r tool_text_result
	}
}

fn tool_get_error(ds:ptr args:str -- result:str) {
	args "module" json::get_string -> found -> mod_name
	found 0 == if {
		"Missing required parameter: module" tool_error_result
	} else {
		args "error" json::get_string -> found -> err_name
		found 0 == if {
			"Missing required parameter: error" tool_error_result
		} else {
			ds mod_name load_module -> mod_json
			mod_json "constants" json::get_array -> found -> consts
			found 0 == if {
				"Module '" mod_name strings::concat "' not found or has no constants" strings::concat tool_error_result
			} else {
				consts err_name find_in_array -> found -> const_obj
				found if {
					"Error constant " mod_name strings::concat "::" strings::concat err_name strings::concat ":\n\n" strings::concat const_obj strings::concat "\n\nHandling tip: Use switch/match on failable functions to handle this error." strings::concat tool_text_result
				} else {
					"Error '" err_name strings::concat "' not found in module '" strings::concat mod_name strings::concat "'.\n\nAvailable constants in " strings::concat mod_name strings::concat ":\n" strings::concat -> r
					consts json::array_len -> len
					0 -> i
					loop {
						i len >= if { break }
						consts i json::array_get_object -> ok -> c
						ok if {
							c "name" json::get_string -> ok -> cname
							ok if {
								r "  - " strings::concat cname strings::concat "\n" strings::concat -> r
							}
						}
						i 1 + -> i
					}
					r tool_error_result
				}
			}
		}
	}
}

fn tool_trace_stack(args:str -- result:str) {
	args "code" json::get_string -> found -> code
	found 0 == if {
		"Missing required parameter: code" tool_error_result
	} else {
		"Stack Trace for: " code strings::concat "\n" strings::concat -> output
		output "=" strings::concat code strings::len 17 + 0 1 for _ { "=" strings::concat } "\n\n" strings::concat -> output

		output "Common Operations Reference:\n\n" strings::concat -> output

		output "LITERALS:\n" strings::concat -> output
		output "  42        ( -- 42)      push integer\n" strings::concat -> output
		output "  3.14      ( -- 3.14)    push float\n" strings::concat -> output
		output "  'text'    ( -- str)     push string\n\n" strings::concat -> output

		output "STACK MANIPULATION:\n" strings::concat -> output
		output "  dup       (a -- a a)           duplicate top\n" strings::concat -> output
		output "  dup2      (a b -- a b a b)     duplicate top two\n" strings::concat -> output
		output "  drop      (a -- )              remove top\n" strings::concat -> output
		output "  swap      (a b -- b a)         swap top two\n" strings::concat -> output
		output "  over      (a b -- a b a)       copy second to top\n" strings::concat -> output
		output "  rot       (a b c -- b c a)     rotate: bottom to top\n" strings::concat -> output
		output "  nip       (a b -- b)           remove second\n" strings::concat -> output
		output "  tuck      (a b -- b a b)       copy top under second\n\n" strings::concat -> output

		output "ARITHMETIC:\n" strings::concat -> output
		output "  + / add   (a b -- a+b)   addition\n" strings::concat -> output
		output "  - / sub   (a b -- a-b)   subtraction\n" strings::concat -> output
		output "  * / mul   (a b -- a*b)   multiplication\n" strings::concat -> output
		output "  / / div   (a b -- a/b)   division\n" strings::concat -> output
		output "  % / mod   (a b -- a%b)   modulo\n" strings::concat -> output
		output "  ++ / inc  (a -- a+1)     increment\n" strings::concat -> output
		output "  -- / dec  (a -- a-1)     decrement\n" strings::concat -> output
		output "  neg       (a -- -a)      negate\n\n" strings::concat -> output

		output "COMPARISON (result: 0=false, 1=true):\n" strings::concat -> output
		output "  == / eq   (a b -- bool)  equal\n" strings::concat -> output
		output "  != / neq  (a b -- bool)  not equal\n" strings::concat -> output
		output "  < / lt    (a b -- bool)  less than\n" strings::concat -> output
		output "  > / gt    (a b -- bool)  greater than\n" strings::concat -> output
		output "  <= / le   (a b -- bool)  less or equal\n" strings::concat -> output
		output "  >= / ge   (a b -- bool)  greater or equal\n" strings::concat -> output
		output "  and       (a b -- bool)  logical and\n" strings::concat -> output
		output "  or        (a b -- bool)  logical or\n" strings::concat -> output
		output "  not       (a -- bool)    logical not\n\n" strings::concat -> output

		output "BINDING:\n" strings::concat -> output
		output "  -> x      (a -- )        pop top, bind to variable x\n" strings::concat -> output
		output "  -> _      (a -- )        pop and discard (same as drop)\n" strings::concat -> output
		output "  x         ( -- val)      push value of variable x\n\n" strings::concat -> output

		output "I/O:\n" strings::concat -> output
		output "  print     (a -- )        print value (no newline)\n" strings::concat -> output
		output "  nl        ( -- )         print newline\n\n" strings::concat -> output

		output "FUNCTION CALLS:\n" strings::concat -> output
		output "  mod::fn   (args -- results)  call function (see fn signature)\n" strings::concat -> output
		output "  mod::fn!  abort on error (failable functions)\n" strings::concat -> output
		output "  mod::fn?  propagate error to caller (failable functions)\n\n" strings::concat -> output

		output "Example trace for '1 2 + dup *':\n" strings::concat -> output
		output "  1    : ( -- 1)           Stack: [1]\n" strings::concat -> output
		output "  2    : ( -- 2)           Stack: [1 2]\n" strings::concat -> output
		output "  +    : (1 2 -- 3)        Stack: [3]\n" strings::concat -> output
		output "  dup  : (3 -- 3 3)        Stack: [3 3]\n" strings::concat -> output
		output "  *    : (3 3 -- 9)        Stack: [9]\n" strings::concat -> output

		output tool_text_result
	}
}

fn tool_generate_template(args:str -- result:str) {
	args "template" json::get_string -> found -> template
	found 0 == if {
		"Missing required parameter: template" tool_error_result
	} else {
		template "file-read" strings::compare 0 == if {
			"FILE READ TEMPLATE\n==================\nuse io\n\nfn read_safely(path:str -- content:str) {\n    path io::read_file switch {\n        Ok { -> content content }\n        Err { -> _ -> msg msg print nl default }\n    }\n}\n\n// Or panic on error:\n//   path io::read_file!" tool_text_result
		} else {
			template "file-write" strings::compare 0 == if {
				"FILE WRITE TEMPLATE\n===================\nuse io\n\n// Write (overwrites):\n//   path content io::write_file!\n\n// Append:\n//   path content io::append_file!\n\n// With error handling:\nfn write_safely(path:str content:str -- ok:i64) {\n    path content io::write_file switch {\n        Ok { 1 }\n        Err { -> _ -> _ 0 }\n    }\n}" tool_text_result
			} else {
				template "json-parse" strings::compare 0 == if {
					"JSON PARSE TEMPLATE\n===================\nuse json\n\nfn parse_json(data:str -- obj:str) {\n    data json::parse! -> obj\n    \n    // Get string: obj key json::get_string -> found -> value\n    // Get int:    obj key json::get_int -> found -> value\n    // Get bool:   obj key json::get_bool -> found -> value\n    // Get object: obj key json::get_object -> found -> value\n    // Get array:  obj key json::get_array -> found -> arr\n    \n    obj\n}" tool_text_result
				} else {
					template "http-get" strings::compare 0 == if {
						"HTTP GET TEMPLATE\n=================\nuse http\n\nfn fetch(url:str -- body:str) {\n    url http::get switch {\n        Ok { -> resp\n            resp @status 200 == if {\n                resp @body\n            } else { empty }\n        }\n        Err { -> _ -> _ empty }\n    }\n}" tool_text_result
					} else {
						template "cli-args" strings::compare 0 == if {
							"CLI ARGS TEMPLATE\n=================\nuse os\n\nfn main() {\n    os::args -> args\n    args len -> argc\n    \n    1 -> i\n    loop {\n        i argc >= if { break }\n        args i nth -> arg\n        arg print nl\n        i 1 + -> i\n    }\n}" tool_text_result
						} else {
							template "struct-crud" strings::compare 0 == if {
								"STRUCT CRUD TEMPLATE\n====================\n\nstruct Item {\n    id: i64\n    name: str\n    count: i64\n}\n\n// Create\nfn new_item(id:i64 name:str -- item:Item) {\n    Item { id = id name = name count = 0 }\n}\n\n// Read: item @field_name\n// Update: item value #field_name\n\nfn main() {\n    1 name new_item -> item\n    item @name print nl\n    item 10 #count -> item\n    item @count print nl\n}" tool_text_result
							} else {
								template "error-handling" strings::compare 0 == if {
									"ERROR HANDLING TEMPLATE\n=======================\nuse io\n\n// Method 1: Panic with !\n//   path io::read_file!\n\n// Method 2: Propagate with ? (caller must be fallible !)\nfn read_file(path:str -- content:str)! {\n    path io::read_file? -> content\n    content\n}\n\n// Method 3: Switch on result\nfn try_read(path:str -- content:str ok:i64) {\n    path io::read_file switch {\n        Ok { -> content content 1 }\n        _ { empty 0 }\n    }\n}\n\n// Method 4: Default on error\nfn read_or(path:str default:str -- content:str) {\n    path io::read_file switch {\n        Ok { -> content content }\n        _ { default }\n    }\n}" tool_text_result
								} else {
									template "loop-array" strings::compare 0 == if {
										"LOOP AND ARRAY TEMPLATE\n=======================\n\n// Create array of n integers\nfn make_array(n:i64 -- arr:ptr) {\n    n makei -> arr\n    0 n 1 for i {\n        arr i i set -> arr\n    }\n    arr\n}\n\n// Sum with for loop\nfn sum(arr:ptr -- total:i64) {\n    0 -> total\n    0 arr len 1 for i {\n        total arr i nth + -> total\n    }\n    total\n}\n\n// Find with loop/break\nfn find(arr:ptr val:i64 -- idx:i64) {\n    0 1 negate -> idx\n    0 -> i\n    loop {\n        i arr len >= if { break }\n        arr i nth val == if { i -> idx break }\n        i 1 + -> i\n    }\n    idx\n}" tool_text_result
									} else {
										"Unknown template. Available: file-read, file-write, json-parse, http-get, cli-args, struct-crud, error-handling, loop-array" tool_error_result
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

fn tool_explain_signature(args:str -- result:str) {
	args "signature" json::get_string -> found -> sig
	found 0 == if {
		"Missing required parameter: signature" tool_error_result
	} else {
		"Signature Explanation\n" -> output
		output "=====================\n\n" strings::concat -> output
		output "Signature: (" strings::concat sig strings::concat ")\n\n" strings::concat -> output

		// Check if it has --
		sig "--" strings::contains if {
			output "This signature has INPUTS and OUTPUTS separated by '--'\n\n" strings::concat -> output
		} else {
			output "Note: No '--' found. Signatures should be: (inputs -- outputs)\n\n" strings::concat -> output
		}

		// Explain the format
		output "FORMAT EXPLANATION:\n" strings::concat -> output
		output "==================\n" strings::concat -> output
		output "  (inputs -- outputs)\n\n" strings::concat -> output
		output "  INPUTS (left of --): Values the function CONSUMES from the stack\n" strings::concat -> output
		output "  OUTPUTS (right of --): Values the function PUSHES onto the stack\n\n" strings::concat -> output

		output "READING THE SIGNATURE:\n" strings::concat -> output
		output "======================\n" strings::concat -> output
		output "  - Each parameter has format: name:type\n" strings::concat -> output
		output "  - Multiple parameters are space-separated\n" strings::concat -> output
		output "  - Rightmost input is TOP of stack (pushed last)\n" strings::concat -> output
		output "  - Rightmost output is TOP of stack after call\n\n" strings::concat -> output

		output "COMMON TYPES:\n" strings::concat -> output
		output "=============\n" strings::concat -> output
		output "  i64  - 64-bit integer\n" strings::concat -> output
		output "  f64  - 64-bit float\n" strings::concat -> output
		output "  str  - string\n" strings::concat -> output
		output "  ptr  - pointer (arrays, structs, raw memory)\n" strings::concat -> output
		output "  bool - boolean (actually i64: 0=false, 1=true)\n\n" strings::concat -> output

		output "EXAMPLES:\n" strings::concat -> output
		output "=========\n" strings::concat -> output
		output "  (a:i64 b:i64 -- sum:i64)\n" strings::concat -> output
		output "    Takes 2 integers, returns 1 integer\n" strings::concat -> output
		output "    Call: 3 5 add  ->  8 on stack\n\n" strings::concat -> output

		output "  (s:str -- len:i64)\n" strings::concat -> output
		output "    Takes 1 string, returns its length\n" strings::concat -> output
		output "    Call: mystr strings::len  ->  5 on stack\n\n" strings::concat -> output

		output "  (path:str -- content:str found:i64)\n" strings::concat -> output
		output "    Takes 1 string, returns 2 values\n" strings::concat -> output
		output "    'found' is on TOP (check it first)\n" strings::concat -> output
		output "    Call: path read -> found -> content\n\n" strings::concat -> output

		output "  ( -- timestamp:i64)\n" strings::concat -> output
		output "    Takes nothing, returns 1 integer\n" strings::concat -> output
		output "    Call: time::now  ->  timestamp on stack\n\n" strings::concat -> output

		output "  (val:i64 -- )\n" strings::concat -> output
		output "    Takes 1 integer, returns nothing\n" strings::concat -> output
		output "    Call: 42 print  ->  nothing on stack\n\n" strings::concat -> output

		output "CALLING CONVENTION:\n" strings::concat -> output
		output "===================\n" strings::concat -> output
		output "  1. Push inputs LEFT to RIGHT\n" strings::concat -> output
		output "  2. Call the function\n" strings::concat -> output
		output "  3. Pop outputs RIGHT to LEFT (top first)\n\n" strings::concat -> output

		output "  Example for (a:str b:i64 -- x:ptr y:i64):\n" strings::concat -> output
		output "    mystr 42 func -> y -> x\n" strings::concat -> output
		output "    // y is popped first (was on top)\n" strings::concat -> output

		output tool_text_result
	}
}

fn tool_type_conversion(args:str -- result:str) {
	args "from" json::get_string -> found_from -> from_type
	args "to" json::get_string -> found_to -> to_type
	found_from 0 == found_to 0 == or if {
		"Missing required parameters: from and to" tool_error_result
	} else {
		from_type strings::lower -> from_type
		to_type strings::lower -> to_type

		from_type "i64" strings::compare 0 == if {
			to_type "f64" strings::compare 0 == if {
				"i64 to f64 CONVERSION\n=====================\n\nMethod: cast<f64>\n\nExample:\n    42 cast<f64>  // Result: 42.0 on stack\n\nNotes:\n- Lossless for integers within f64 precision\n- Large integers may lose precision" tool_text_result
			} else {
				to_type "str" strings::compare 0 == if {
					"i64 to str CONVERSION\n=====================\n\nMethod: strconv::itoa\n\nExample:\n    42 strconv::itoa  // Result: the string 42 on stack\n\nFor formatted output:\n    use fmt\n    42 fmt::int  // Formatted integer string" tool_text_result
				} else {
					to_type "bool" strings::compare 0 == if {
						"i64 to bool CONVERSION\n======================\n\nMethod: Comparison or direct use\n\nQuadrate uses i64 for booleans (0=false, nonzero=true)\n\nExamples:\n    x 0 != -> is_nonzero   // Explicit: 1 if x!=0\n    x if { ... }           // Direct: any nonzero is truthy\n\nNotes:\n- No explicit conversion needed\n- 0 is false, everything else is true" tool_text_result
					} else {
						to_type "ptr" strings::compare 0 == if {
							"i64 to ptr CONVERSION\n=====================\n\nMethod: cast<ptr> (unsafe)\n\nExample:\n    addr cast<ptr>  // Interpret integer as memory address\n\nWARNING: This is unsafe!\n- Only use for FFI or low-level memory operations\n- Ensure the address is valid\n- Prefer using mem:: functions instead" tool_text_result
						} else {
							"Unknown target type. Valid types: i64, f64, str, ptr, bool" tool_error_result
						}
					}
				}
			}
		} else {
			from_type "f64" strings::compare 0 == if {
				to_type "i64" strings::compare 0 == if {
					"f64 to i64 CONVERSION\n=====================\n\nMethod: cast<i64>\n\nExample:\n    3.7 cast<i64>  // Result: 3 (truncates toward zero)\n\nRounding options:\n    x math::floor cast<i64>  // Round down\n    x math::ceil cast<i64>   // Round up\n    x math::round cast<i64>  // Round to nearest\n\nNotes:\n- Truncates decimal part (no rounding by default)\n- Overflow behavior is undefined for huge values" tool_text_result
				} else {
					to_type "str" strings::compare 0 == if {
						"f64 to str CONVERSION\n=====================\n\nMethod: strconv::ftoa\n\nExample:\n    3.14159 strconv::ftoa  // Result: string representation\n\nFor formatted output:\n    use fmt\n    3.14159 2 fmt::float  // 2 decimal places" tool_text_result
					} else {
						to_type "bool" strings::compare 0 == if {
							"f64 to bool CONVERSION\n======================\n\nMethod: Comparison\n\nExamples:\n    x 0.0 != -> is_nonzero\n    x 0.0 > -> is_positive\n\nNotes:\n- Compare against 0.0 for boolean conversion\n- Be careful with floating point equality" tool_text_result
						} else {
							"Unknown target type. Valid types: i64, f64, str, bool" tool_error_result
						}
					}
				}
			} else {
				from_type "str" strings::compare 0 == if {
					to_type "i64" strings::compare 0 == if {
						"str to i64 CONVERSION\n=====================\n\nMethod: strconv::atoi (failable)\n\nExample:\n    s strconv::atoi switch {\n        Ok { -> val val }\n        Err { -> _ -> _ 0 }  // default on error\n    }\n\nOr panic on invalid:\n    s strconv::atoi!\n\nNotes:\n- Returns error for non-numeric strings\n- Handles negative numbers\n- Leading/trailing whitespace may cause errors" tool_text_result
					} else {
						to_type "f64" strings::compare 0 == if {
							"str to f64 CONVERSION\n=====================\n\nMethod: strconv::atof (failable)\n\nExample:\n    s strconv::atof switch {\n        Ok { -> val val }\n        Err { -> _ -> _ 0.0 }  // default on error\n    }\n\nOr panic on invalid:\n    s strconv::atof!\n\nNotes:\n- Handles scientific notation\n- Returns error for non-numeric strings" tool_text_result
						} else {
							to_type "ptr" strings::compare 0 == if {
								"str to ptr CONVERSION\n=====================\n\nStrings ARE pointers in Quadrate!\n\nA str is already a ptr to character data.\nNo conversion needed for most operations.\n\nTo get raw bytes:\n    s strings::bytes -> ptr  // Get byte array\n\nTo get length:\n    s strings::len -> len" tool_text_result
							} else {
								to_type "bool" strings::compare 0 == if {
									"str to bool CONVERSION\n======================\n\nMethod: Check length or content\n\nExamples:\n    s strings::len 0 > -> not_empty\n    s strings::len 0 == -> is_empty\n\nFor parsing bool strings:\n    s strings::lower -> s\n    s strings::compare 0 == -> is_true  // compare with expected" tool_text_result
								} else {
									"Unknown target type. Valid types: i64, f64, ptr, bool" tool_error_result
								}
							}
						}
					}
				} else {
					from_type "ptr" strings::compare 0 == if {
						to_type "i64" strings::compare 0 == if {
							"ptr to i64 CONVERSION\n=====================\n\nMethod: cast<i64> (unsafe)\n\nExample:\n    p cast<i64>  // Get memory address as integer\n\nMore commonly, get array length:\n    arr len -> count\n\nOr access array elements:\n    arr i nth -> element\n\nNotes:\n- Direct ptr to i64 cast gives memory address\n- Usually you want len or nth instead" tool_text_result
						} else {
							to_type "str" strings::compare 0 == if {
								"ptr to str CONVERSION\n=====================\n\nFor byte arrays:\n    bytes strings::from_bytes -> s\n\nFor C strings (null-terminated):\n    cstr strings::from_cstr -> s\n\nNotes:\n- Ensure valid UTF-8 encoding\n- from_cstr stops at first null byte\n- from_bytes uses entire array" tool_text_result
							} else {
								"Unknown target type. Valid types: i64, str" tool_error_result
							}
						}
					} else {
						from_type "bool" strings::compare 0 == if {
							to_type "i64" strings::compare 0 == if {
								"bool to i64 CONVERSION\n======================\n\nNo conversion needed!\n\nQuadrate bools ARE i64 values:\n- false = 0\n- true = 1 (or any nonzero)\n\nExample:\n    x y == -> result  // result is 0 or 1\n    result 10 * -> scaled  // Use directly in math" tool_text_result
							} else {
								to_type "str" strings::compare 0 == if {
									"bool to str CONVERSION\n======================\n\nMethod: Conditional or strconv\n\nExample:\n    flag if { 1 } else { 0 } strconv::itoa\n\nOr use conditional strings:\n    flag if { val1 } else { val2 } -> s" tool_text_result
								} else {
									"Unknown target type. Valid types: i64, str" tool_error_result
								}
							}
						} else {
							"Unknown source type. Valid types: i64, f64, str, ptr, bool" tool_error_result
						}
					}
				}
			}
		}
	}
}

fn mcp_tools_call(ds:ptr id:str body:str -- response:str) {
	body "params" json::get_object -> found -> params
	params "name" json::get_string -> found -> tool_name
	params "arguments" json::get_object -> found -> args
	found 0 == if {
		"{}" -> args
	}

	tool_name switch {
		"quadrate_list_modules"       { ds tool_list_modules }
		"quadrate_get_module"         { ds args tool_get_module }
		"quadrate_get_function"       { ds args tool_get_function }
		"quadrate_search"             { ds args tool_search }
		"quadrate_get_builtins"       { ds tool_get_builtins }
		"quadrate_get_builtin"        { ds args tool_get_builtin }
		"quadrate_get_syntax"         { ds tool_get_syntax }
		"quadrate_get_keyword"        { ds args tool_get_keyword }
		"quadrate_get_operator"       { ds args tool_get_operator }
		"quadrate_find_function"      { ds args tool_find_function }
		"quadrate_search_by_signature" { ds args tool_search_by_signature }
		"quadrate_get_error"          { ds args tool_get_error }
		"quadrate_trace_stack"        { args tool_trace_stack }
		"quadrate_generate_template"  { args tool_generate_template }
		"quadrate_explain_signature"  { args tool_explain_signature }
		"quadrate_type_conversion"    { args tool_type_conversion }
		_                             { "Unknown tool" tool_error_result }
	} -> result
	id result rpc_result
}
