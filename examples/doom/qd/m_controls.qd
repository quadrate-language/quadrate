/// Control bindings — keyboard / mouse / joystick scancodes.
///
/// Ported from doomgeneric/m_controls.c. Each key_* is a mutable module
/// global holding the current binding; callers check `if event_key == key_fire`.
/// Default values come from doomkeys.h's DOS-era scancode constants.
///
/// M_BindBaseControls / M_BindMenuControls / ... are no-ops here: the
/// C version registered each global's address with m_config so .cfg save
/// files could update them. Our m_config port (pending) will read .cfg
/// keys and mutate these vars directly by name.

// ---- Doom-specific key constants (from doomkeys.h) ----

pub const KEY_RIGHTARROW = 0xae
pub const KEY_LEFTARROW = 0xac
pub const KEY_UPARROW = 0xad
pub const KEY_DOWNARROW = 0xaf
pub const KEY_STRAFE_L = 0xa0
pub const KEY_STRAFE_R = 0xa1
pub const KEY_USE = 0xa2
pub const KEY_FIRE = 0xa3
pub const KEY_ESCAPE = 27
pub const KEY_ENTER = 13
pub const KEY_TAB = 9
pub const KEY_F1 = 0xbb
pub const KEY_F2 = 0xbc
pub const KEY_F3 = 0xbd
pub const KEY_F4 = 0xbe
pub const KEY_F5 = 0xbf
pub const KEY_F6 = 0xc0
pub const KEY_F7 = 0xc1
pub const KEY_F8 = 0xc2
pub const KEY_F9 = 0xc3
pub const KEY_F10 = 0xc4
pub const KEY_F11 = 0xd7
pub const KEY_F12 = 0xd8
pub const KEY_BACKSPACE = 0x7f
pub const KEY_PAUSE = 0xff
pub const KEY_EQUALS = 0x3d
pub const KEY_MINUS = 0x2d
pub const KEY_RSHIFT = 0xb6
pub const KEY_RCTRL = 0x9d
pub const KEY_RALT = 0xb8

