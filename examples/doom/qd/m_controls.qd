// ---- Bind functions — no-ops here. When m_config lands, it will
// ---- re-read .cfg values and mutate the vars above directly.

pub fn M_BindBaseControls( -- ) { }
pub fn M_BindWeaponControls( -- ) { }
pub fn M_BindMapControls( -- ) { }
pub fn M_BindMenuControls( -- ) { }
pub fn M_BindChatControls(num_players:i64 -- ) { num_players drop }
pub fn M_ApplyPlatformDefaults( -- ) { }
