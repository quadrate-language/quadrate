use "r_draw.qd"
use "i_video.qd"
use "doomdef.qd"
use mem

fn main() {
	// Allocate a 320×200 mock framebuffer (replacing i_video's SDL path
	// since we don't need a window for unit tests).
	SCREENWIDTH SCREENHEIGHT mul mem::alloc! -> fb
	fb SCREENWIDTH SCREENHEIGHT mul mem::zero
	fb -> I_VideoBuffer

	// Initialise offset tables for a full-width, full-height view.
	SCREENWIDTH SCREENHEIGHT R_InitBuffer
	"viewwindowx: " print viewwindowx print nl                          // 0
	"ylookup[0]: " print ylookup 0 mem::get_i64 print nl                // 0
	"ylookup[1]: " print ylookup 8 mem::get_i64 print nl                // 320
	"columnofs[5]: " print columnofs 5 8 mul mem::get_i64 print nl      // 5

	// Install a trivial colormap (identity) and a dc_source column.
	256 mem::alloc! -> cmap
	0 256 1 for i { i cmap i mem::set_u8 }
	128 mem::alloc! -> src
	0 128 1 for i { i 255 and src i mem::set_u8 }

	cmap -> dc_colormap
	src -> dc_source
	10 -> dc_x
	0 -> dc_yl
	3 -> dc_yh
	0x10000 -> dc_iscale          // step 1.0
	0 -> dc_texturemid
	100 -> centery

	R_DrawColumn

	// Pixel (x=10, y=0): texel = dc_source[(texturemid + (0-100)*iscale) >> 16 & 127]
	// = ((-100<<16) >> 16) & 127 = (-100) & 127 = 28. Source[28] = 28.
	"fb[0*320+10]: " print fb 0 SCREENWIDTH mul 10 add mem::get_u8 print nl  // 28
	"fb[1*320+10]: " print fb 1 SCREENWIDTH mul 10 add mem::get_u8 print nl  // 29
	"fb[2*320+10]: " print fb 2 SCREENWIDTH mul 10 add mem::get_u8 print nl  // 30
	"fb[3*320+10]: " print fb 3 SCREENWIDTH mul 10 add mem::get_u8 print nl  // 31
	"fb[0*320+11]: " print fb 0 SCREENWIDTH mul 11 add mem::get_u8 print nl  // 0 (untouched)

	// --- R_DrawSpan: draw a 4-wide horizontal span at y=50, x1=20..x2=23
	// with ds_source being a 64×64 flat where pixel (u,v) = u + v*64.
	64 64 mul mem::alloc! -> flat
	0 64 1 for v {
		0 64 1 for u {
			u v 64 mul add 255 and flat v 64 mul u add mem::set_u8
		}
	}

	flat -> ds_source
	cmap -> ds_colormap
	50 -> ds_y
	20 -> ds_x1
	23 -> ds_x2
	0 -> ds_xfrac
	0 -> ds_yfrac
	0x10000 -> ds_xstep   // +1 in u per pixel
	0 -> ds_ystep

	R_DrawSpan
	"fb[50*320+20]: " print fb 50 SCREENWIDTH mul 20 add mem::get_u8 print nl   // 0 (u=0,v=0)
	"fb[50*320+21]: " print fb 50 SCREENWIDTH mul 21 add mem::get_u8 print nl   // 1
	"fb[50*320+22]: " print fb 50 SCREENWIDTH mul 22 add mem::get_u8 print nl   // 2
	"fb[50*320+23]: " print fb 50 SCREENWIDTH mul 23 add mem::get_u8 print nl   // 3
	"fb[50*320+24]: " print fb 50 SCREENWIDTH mul 24 add mem::get_u8 print nl   // 0 (untouched)

	// --- R_InitTranslationTables: check green → gray mapping.
	R_InitTranslationTables
	"xlate[0x70]: " print translationtables 0 256 mul 0x70 add mem::get_u8 print nl   // 0x60
	"xlate[0x75]: " print translationtables 0 256 mul 0x75 add mem::get_u8 print nl   // 0x65
	"xlate[0x80]: " print translationtables 0 256 mul 0x80 add mem::get_u8 print nl   // 0x80 (passthrough)
	"xlate_brown[0x72]: " print translationtables 1 256 mul 0x72 add mem::get_u8 print nl // 0x42

	flat mem::free
	src mem::free
	cmap mem::free
	fb mem::free

	"done" print nl
}
