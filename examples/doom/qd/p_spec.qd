/// Level specials: switches, doors, platforms, lights, teleports, stairs.
///
/// Ported from doomgeneric/p_spec.c + p_ceilng.c + p_doors.c + p_floor.c
/// + p_plats.c + p_switch.c + p_telept.c + p_lights.c — ~2,500 lines
/// spread across 8 files. Each special type (door, platform, etc.) has
/// a spawn function (P_Spawn*), an event function (EV_*), and a thinker
/// (T_*) that ticks its animation per frame.
///
/// All of these run against sector_t + line_t + mobj_t which aren't
/// pinned yet. Ship symbol stubs so info.qd's state dispatcher, g_game's
/// line-triggers, and P_UpdateSpecials can link; real T_* thinkers land
/// with the mobj pass.

// ---- p_spec.c orchestrator + line-event handling ----

pub fn P_InitPicAnims( -- ) { }
pub fn P_SpawnSpecials( -- ) { }
pub fn P_UpdateSpecials( -- ) { }

pub fn P_FindSectorFromLineTag(line:ptr start:i64 -- idx:i64) {
	line drop start drop -1
}
pub fn P_FindMinSurroundingLight(sector:ptr max:i64 -- min:i64) {
	sector drop max drop 0
}
pub fn P_CrossSpecialLine(linenum:i64 side:i64 thing:ptr -- ) {
	linenum drop side drop thing drop
}
pub fn P_ShootSpecialLine(thing:ptr line:ptr -- ) {
	thing drop line drop
}
pub fn P_UseSpecialLine(thing:ptr line:ptr side:i64 -- ok:i64) {
	thing drop line drop side drop 0
}
pub fn P_PlayerInSpecialSector(player:ptr -- ) { player drop }
pub fn twoSided(sector:i64 line:i64 -- ok:i64) {
	sector drop line drop 0
}

// ---- p_switch.c ----

pub fn P_InitSwitchList( -- ) { }
pub fn P_StartButton(line:ptr type:i64 texture:i64 time:i64 -- ) {
	line drop type drop texture drop time drop
}
pub fn P_ChangeSwitchTexture(line:ptr useAgain:i64 -- ) {
	line drop useAgain drop
}

