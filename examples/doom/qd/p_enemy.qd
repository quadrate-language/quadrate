/// Monster AI + A_* action bodies.
///
/// Ported from doomgeneric/p_enemy.c — 2,000 lines of per-monster logic:
/// P_CheckSight targets, P_NewChaseDir pathfinding, P_Move step-and-slide,
/// plus ~50 A_* action callbacks driven by info.qd's state table
/// (A_Look, A_Chase, A_FaceTarget, per-monster attacks, boss cues).
///
/// Each monster's state machine in info.qd calls one of the A_* entries
/// per tic via an integer dispatch tag. We ship every one as an
/// argument-accepting no-op so the link surface is complete; bodies
/// land one-at-a-time once mobjs + p_map are live (tasks #40, #42).

pub fn P_RecursiveSound(sec:ptr soundblocks:i64 -- ) {
	sec drop soundblocks drop
}

pub fn P_NoiseAlert(target:ptr emmiter:ptr -- ) {
	target drop emmiter drop
}

pub fn P_CheckMeleeRange(actor:ptr -- ok:i64) { actor drop 0 }
pub fn P_CheckMissileRange(actor:ptr -- ok:i64) { actor drop 0 }

pub fn P_Move(actor:ptr -- ok:i64) { actor drop 0 }
pub fn P_TryWalk(actor:ptr -- ok:i64) { actor drop 0 }
pub fn P_NewChaseDir(actor:ptr -- ) { actor drop }
pub fn P_LookForPlayers(actor:ptr allaround:i64 -- ok:i64) {
	actor drop allaround drop 0
}

/// A_* monster actions — driven by info.qd's state-table dispatcher.
pub fn A_Fall(actor:ptr -- ) { actor drop }
