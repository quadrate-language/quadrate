pub fn A_FatRaise(actor:ptr -- ) { actor drop }
pub fn A_FatAttack1(actor:ptr -- ) { actor drop }
pub fn A_FatAttack2(actor:ptr -- ) { actor drop }
pub fn A_FatAttack3(actor:ptr -- ) { actor drop }
pub fn A_SkullAttack(actor:ptr -- ) { actor drop }
pub fn A_PainShootSkull(actor:ptr angle:i64 -- ) {
	actor drop angle drop
}
pub fn A_PainAttack(actor:ptr -- ) { actor drop }
pub fn A_PainDie(actor:ptr -- ) { actor drop }
pub fn A_Scream(actor:ptr -- ) { actor drop }
