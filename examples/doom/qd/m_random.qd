fn ensure_init( -- ) {
	rndtable mem::is_null if {
		init_rndtable
	}
}

/// Deterministic random used by game logic (demo replay, AI).
pub fn P_Random( -- v:i64) {
	ensure_init
	prndindex 1 + 0xff and -> prndindex
	rndtable prndindex mem::get_u8
}

/// Random for non-gameplay effects (menu animations, etc).
pub fn M_Random( -- v:i64) {
	ensure_init
	rndindex 1 + 0xff and -> rndindex
	rndtable rndindex mem::get_u8
}

/// Reset both RNG indices. Called when starting a new game.
pub fn M_ClearRandom( -- ) {
	0 -> rndindex
	0 -> prndindex
}
