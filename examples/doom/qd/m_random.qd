/// Random number LUT.
///
/// Ported from doomgeneric/m_random.c. The original keeps rndtable as a
/// `static const unsigned char[256]` in .rodata; Quadrate doesn't yet have
/// const array literals, so we lazily allocate and fill the table on first
/// use. P_Random is the deterministic one used by game logic; M_Random is
/// for non-gameplay randomness.

use mem

/// Offset into rndtable for M_Random.
var rndindex:i64 = 0
/// Offset into rndtable for P_Random (deterministic path).
var prndindex:i64 = 0
/// Pointer to the 256-byte table. Allocated on first use.
var rndtable:ptr = 0

/// Populate rndtable with the 256 values from the original Doom source.
/// Called exactly once, on the first random-number request.
fn init_rndtable( -- ) {
	256 mem::alloc! -> rndtable

	0 rndtable 0 mem::set_u8
	8 rndtable 1 mem::set_u8
	109 rndtable 2 mem::set_u8
	220 rndtable 3 mem::set_u8
	222 rndtable 4 mem::set_u8
	241 rndtable 5 mem::set_u8
	149 rndtable 6 mem::set_u8
