use "tables.qd"

fn main() {
	// finesine[0] — sin(0.5 * pi/4096) ≈ 0.000383, * 65536 ≈ 25.
	0 finesine_at print nl

	// finesine[2048] — sin(2048.5 * pi/4096) ≈ cos(0.000383) ≈ 1.0, * 65536 ≈ 65535.
	2048 finesine_at print nl

	// finesine[4096] — sin(4096.5 * pi/4096) ≈ -0.000383, * 65536 ≈ -25.
	4096 finesine_at print nl

	// finetangent[2048] — tan(0.5 * pi/4096) ≈ 0.000383, * 65536 ≈ 25.
	2048 finetangent_at print nl

	// finetangent[0] — tan((-2048.5) * pi/4096) ≈ -2608, * 65536 ≈ -170907648 (≈ C's -170910304).
	0 finetangent_at print nl

	// tantoangle[0] — atan(0) = 0.
	0 tantoangle_at print nl

	// tantoangle[2048] — atan(1) = pi/4 = BAM 0x20000000 = 536870912.
	2048 tantoangle_at print nl

	// gammatable[0][127] — identity-ish, around 128.
	0 127 gamma_at print nl
	// gammatable[0][0] — floor at 1.
	0 0 gamma_at print nl

	// SlopeDiv spot checks.
	1024 256 SlopeDiv print nl        // 2048 (den<512 → SLOPERANGE)
	1024 1024 SlopeDiv print nl       // tan ratio 1 → SLOPERANGE
	512 1024 SlopeDiv print nl        // 1024 (mid-range)
}
