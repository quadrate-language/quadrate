// Example demonstrating defer for cleanup operations
//
// defer schedules a block to run when the function exits,
// regardless of how the function exits (normal return or error).
// Multiple defers execute in LIFO order (last-in, first-out).
// A simple resource struct
struct Resource {
	id: i64
	value: i64
}

fn create_resource(id:i64 -- r:ptr) {
	Resource {
		id = id
		value = id 100 *
	}
}

fn destroy_resource(r:ptr -- ) {
	"  Destroying resource " print r <<id print nl
	r free
}

// Basic defer example
fn basic_defer() {
	"Basic defer:" print nl
	"  Start of function" print nl

	defer {
		"  Deferred cleanup runs at end" print nl
	}

	"  Middle of function" print nl
	"  End of function" print nl
}

// Multiple defers execute in reverse order (LIFO)
fn multiple_defers() {
	"Multiple defers (LIFO order):" print nl
	"  Registering defers..." print nl

	defer {
		"  Third defer (registered first)" print nl
	}
	defer {
		"  Second defer (registered second)" print nl
	}
	defer {
		"  First defer (registered last)" print nl
	}

	"  Function body done" print nl
	"  Now defers will run:" print nl
}

// Practical example: resource cleanup
fn resource_cleanup() {
	"Resource cleanup with defer:" print nl

	// Create resources
	1 create_resource -> r1
	"  Created resource 1" print nl

	// Register cleanup immediately after creation
	defer {
		r1 destroy_resource
	}

	2 create_resource -> r2
	"  Created resource 2" print nl
	defer {
		r2 destroy_resource
	}

	3 create_resource -> r3
	"  Created resource 3" print nl
	defer {
		r3 destroy_resource
	}

	// Do some work with resources
	"  Working with resources..." print nl
	"  new Resource IDs: " print r1 <<id print ", " print r2 <<id print ", " print r3 <<id print nl

	"  Function ending, defers will clean up:" print nl
	// Resources are automatically freed in reverse order (3, 2, 1)
}

// Defer with early return - defer runs regardless of how function exits
fn early_return_yes() {
	"Early return (yes):" print nl

	defer {
		"  Cleanup runs even with early return" print nl
	}

	"  Returning early!" print nl
	return
	"  This line is never reached" print nl
}

fn early_return_no() {
	"Early return (no):" print nl

	defer {
		"  Cleanup runs at normal exit too" print nl
	}

	"  Normal execution path" print nl
}

fn main() {
	basic_defer
	nl

	multiple_defers
	nl

	resource_cleanup
	nl

	early_return_yes
	nl

	early_return_no
}
