// links-api — A bookmark store as a JSON HTTP API
//
// Demonstrates: http server with routing, json building,
// string builder, path parameters, query parameters, switch.
//
// Usage:
//   quad run links-api.qd
//
// Endpoints:
//   GET  /              — service info
//   GET  /links         — list all links
//   GET  /links/:id     — get a link by id
//   GET  /search?q=...  — search links by title
//   POST /echo          — echo request body (demonstrates http::request_body)

use http
use json
use strconv
use strings

// The data store: the links' ids, and for each its url and title
fn ids( -- a:[]i64) { [0 1 2 3] }

fn get_url(id:i64 -- url:str) {
	switch {
		0 { "https://quad.r8.rs" }
		1 { "https://sr.ht" }
		2 { "https://llvm.org" }
		3 { "https://en.wikipedia.org/wiki/Forth_(programming_language)" }
		_ { "" }
	}
}

fn get_title(id:i64 -- title:str) {
	switch {
		0 { "Quadrate docs" }
		1 { "Sourcehut" }
		2 { "LLVM Project" }
		3 { "Forth on Wikipedia" }
		_ { "" }
	}
}

fn link_json(id:i64 -- s:str) {
	"id" over json::kv_int
	"url" pick get_url json::kv json::join
	"title" rot get_title json::kv json::join
	json::obj
}

fn links_json(ids:[]i64 -- s:str) { fn { link_json } map "," strings::join! json::arr }

// The ids whose title holds q, which is already lower case
fn matching(q:str -- found:[]i64) {
	[]i64 ids fn { pick over get_title strings::lower swap strings::contains if { append } else { drop } } each nip
}

// Each handler takes the request context and answers it

fn handle_root(c:http::Ctx -- ) {
	200
	"service" "links-api" json::kv
	"version" "1.0" json::kv json::join
	"links" ids len json::kv_int json::join
	json::obj http::json
}

fn handle_list(c:http::Ctx -- ) { 200 ids links_json http::json }

fn handle_get_one(c:http::Ctx -- ) {
	dup "id" http::param 10 strconv::parse_int!
	dup 0 ids len 1 - within if {
		link_json 200 swap http::json
	} else {
		drop 404 "{\"error\":\"not found\"}" http::json
	}
}

fn handle_search(c:http::Ctx -- ) {
	dup "q" http::query_param dup len 0 == if {
		drop 400 "{\"error\":\"missing q parameter\"}" http::json
	} else {
		strings::lower matching links_json 200 swap http::json
	}
}

fn handle_echo(c:http::Ctx -- ) {
	dup http::request_body dup len 0 == if {
		drop 400 "{\"error\":\"empty body\"}" http::json
	} else {
		200 swap http::json
	}
}

fn main() {
	http::engine
	dup "/" &handle_root http::GET
	dup "/links" &handle_list http::GET
	dup "/links/:id" &handle_get_one http::GET
	dup "/search" &handle_search http::GET
	dup "/echo" &handle_echo http::POST

	"Links API listening on :8080" print nl
	"  GET  /              - service info" print nl
	"  GET  /links         - list all links" print nl
	"  GET  /links/:id     - get a link" print nl
	"  GET  /search?q=...  - search by title" print nl
	"  POST /echo          - echo JSON body back" print nl

	dup ":8080" http::run!
	http::free_engine
}
