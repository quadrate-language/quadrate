// Classic ASCII spinning donut in Quadrate
// Port of donut.c by Andy Sloane (https://www.a1k0n.net/2011/07/20/donut-math.html)
//
// Run: quadc donut.qd -r
// Press Ctrl+C to stop
use math
use time

fn main() {
	0.5 -> A  // X rotation
	0.3 -> B  // Z rotation
	1760 makef -> z  // Z-buffer (80x22 screen)
	1760 makei -> o  // Output buffer (char indices)

	"\x1b[2J" print "\x1b[?25l" print  // Clear screen, hide cursor

	loop {
		// Reset buffers
		0 1760 1 for it {
			z it 0.0 set  o it 12 set
		}

		// Precompute rotation matrix components
		A math::sin A math::cos -> g -> e
		B math::sin B math::cos -> m -> n

		// Render torus: j=theta (tube), i=phi (ring)
		0.0 -> j
		0 90 1 for it {
			j math::sin j math::cos -> d -> f

			0.0 -> i
			0 314 1 for it {
				i math::sin i math::cos -> l -> c
				d 2.0 + -> h  // h = R2 + R1*cos(theta)

				// Perspective projection
				c h * e * f g * + 5.0 + -> W  // 1/z
				1.0 W / -> D

				// Rotation
				c h * g * f e * - -> t

				// Project to screen (80x22)
				l h * m * t n * - D * 30.0 * 40.0 + cast<i64> -> x
				l h * n * t m * + D * 15.0 * 12.0 + cast<i64> -> y
				x y 80 * + -> q

				// Luminance from surface normal
				f e * c d * g * - m * c d * e * - f g * - l d * n * - 8.0 * -> N

				// Z-buffer test and update
				y 0 > y 22 < and x 0 > and x 80 < and if {
					D z q nth > if {
						z q D set
						N cast<i64> -> k
						k 0 < if {
							0 -> k
						}
						k 11 > if {
							11 -> k
						}
						o q k set
					}
				}

				i 0.02 + -> i
			}
			j 0.07 + -> j
		}

		// Render frame
		"\x1b[H" print  // Cursor home
		0 1761 1 for it {
			it 80 mod 0 != if {
				o it nth switch {
					0 {
						"." print
					}
					1 {
						"," print
					}
					2 {
						"-" print
					}
					3 {
						"~" print
					}
					4 {
						":" print
					}
					5 {
						";" print
					}
					6 {
						"=" print
					}
					7 {
						"!" print
					}
					8 {
						"*" print
					}
					9 {
						"#" print
					}
					10 {
						"$" print
					}
					11 {
						"@" print
					}
					_ {
						" " print
					}
				}
			} else {
				nl
			}
		}

		A 0.04 + -> A
		B 0.02 + -> B

		30 time::Millisecond * time::sleep  // ~33 fps
	}

	"\x1b[?25h" print  // Show cursor
}
