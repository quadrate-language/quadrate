/// Simple HTTP server example using the http module.
/// Run with: quadc examples/web-server/web-server.qd -r
/// Then visit http://localhost:8080 in your browser.
use http

// Handler for the root path
fn handle_home(c:ptr -- ) {
	c http::StatusOK "<h1>Welcome to Quadrate!</h1><p>Try these routes:</p><ul><li><a href='/hello'>/hello</a></li><li><a href='/json'>/json</a></li><li><a href='/users/42'>/users/42</a></li></ul>" http::html
}

// Handler for /hello
fn handle_hello(c:ptr -- ) {
	c http::StatusOK "Hello, World!" http::string
}

// Handler for /json - returns JSON response
fn handle_json(c:ptr -- ) {
	c http::StatusOK "{}" http::json
}

// Handler with path parameter: /users/:id
fn handle_user(c:ptr -- ) {
	c "id" http::param -> id
	c http::StatusOK id http::string
}

fn main() {
	"Starting server on http://localhost:8080/" print nl

	// Create HTTP engine
	http::engine -> e

	// Register routes
	e "/" &handle_home http::GET
	e "/hello" &handle_hello http::GET
	e "/json" &handle_json http::GET
	e "/users/:id" &handle_user http::GET

	// Start server (blocking)
	e ":8080" http::run!

	// Cleanup (unreachable in this example)
	e http::free_engine
}
