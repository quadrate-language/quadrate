use net

fn main() {
	"Serving on http://localhost:8080/" print nl

	// Create server socket on port 8080
	8080 net::listen! -> server

	// Loop forever accepting connections
	loop {
		server net::accept! -> client

		// Read the request (ignore it)
		client 1024 net::receive! drop drop

		// Send HTTP response
		client
		"HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 6\r\n\r\nHello!" net::send!
		drop
		client net::close
	}
}
