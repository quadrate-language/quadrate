// dc - desk calculator clone
// A reverse-polish notation calculator
//
// Usage: dc [options]
//
// dc is a reverse-polish desk calculator which supports unlimited
// precision arithmetic. It uses a stack-based approach where numbers
// are pushed onto a stack and operations pop operands and push results.
use bits
use flag
use io
use math
use mem
use os
use str
use strconv
use unicode

fn print_version( -- ) {
	"dc 0.1.0 (Quadrate)" . nl
}

fn print_help( -- ) {
	"Usage: dc [OPTION] [file ...]" . nl
	"  -e, --expression=EXPR    evaluate expression" . nl
	"  -f, --file=FILE          evaluate contents of file" . nl
	"  -h, --help               display this help and exit" . nl
	"  -V, --version            output version information and exit" . nl
	nl
	"Email bug reports to:  ~klahr/quadrate@lists.sr.ht" . nl
}

fn is_number(tok:str -- result:i64) {
	-> tok
	0 -> first
	0 -> second
	0 -> result
	tok str::len 0 > if {
		tok 0 str::char_at -> first
		first unicode::is_digit if {
			1 -> result
		} else {
			first unicode::underscore == first unicode::minus == bits::or if {
				tok str::len 1 > if {
					tok 1 str::char_at -> second
					second unicode::is_digit -> result
				}
			}
		}
	}
	result
}

fn process_token(tok:str -- ) {
	-> tok
	0 -> first
	tok is_number if {
		tok 0 str::char_at -> first
		first unicode::underscore == if {
			tok 1 tok str::len 1 - str::substring! castf 0 swap sub
		} else {
			tok castf
		}
	} else {
		tok str::len 0 > if { tok process_operator }
	}
}

fn process_operator(op:str -- ) {
	-> op
	0 -> n
	0.0 -> a
	0.0 -> b
	0.0 -> q
	0.0 -> r
	"" -> octal
	op 0 str::char_at switch {
		unicode::plus {
			depth 2 >= if {
				add
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::minus {
			depth 2 >= if {
				sub
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::asterisk {
			depth 2 >= if {
				mul
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::slash {
			depth 2 >= if {
				dup 0 != if {
					div
				} else {
					"dc: divide by zero" . nl
				}
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::percent {
			depth 2 >= if {
				dup 0 != if {
					// Remainder for floats: a - floor(a/b)*b
					-> b -> a
					a a b div math::floor b mul sub
				} else {
					"dc: remainder by zero" . nl
				}
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::caret {
			depth 2 >= if {
				// Check if exponent is non-integer, floor it if so
				dup dup math::floor != if {
					"Runtime warning: non-zero scale in exponent" . nl
					math::floor
				}
				math::pow
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::v {
			dup 0 >= if {
				math::sqrt
			} else {
				"dc: square root of negative number" . nl
			}
		}
		unicode::p {
			dup . nl
		}
		unicode::n {
			print
		}
		unicode::f {
			// Print full stack from top to bottom
			depth -> n
			0 n 1 for {
				$ pick . nl
			}
		}
		unicode::z {
			// Push stack depth
			depth
		}
		unicode::tilde {
			// Divmod: push both quotient and remainder
			depth 2 >= if {
				dup 0 != if {
					-> b -> a
					a b div math::floor -> q
					// Remainder = a - q*b
					a q b mul sub -> r
					q r
				} else {
					"dc: divide by zero" . nl
				}
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::c {
			clear
		}
		unicode::d {
			depth 1 >= if {
				dup
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::r {
			depth 2 >= if {
				swap
			}
		}
		unicode::q {
			0 os::exit
		}
		_ {
			op 0 str::char_at 8 strconv::format_int -> octal
			"dc: '" . op . "' (0" . octal . ") unimplemented" . nl
		}
	}
}

fn process_line(input:str -- ) {
	-> input
	0 -> comment_pos
	"" -> trimmed
	"" -> token
	0 -> space_pos
	// Strip comments (everything from # to end of line)
	input "#" str::index_of -> comment_pos
	comment_pos 0 >= if {
		input 0 comment_pos str::substring! -> input
	}
	input str::trim -> trimmed

	// Process space-separated tokens
	loop {
		trimmed str::len 0 <= if {
			break
		}
		trimmed " " str::index_of -> space_pos
		space_pos 0 < if {
			// No more spaces - process remaining as last token
			trimmed process_token
			break
		} else {
			// Extract token before space
			trimmed 0 space_pos str::substring! -> token
			token str::len 0 > if {
				token process_token
			}
			// Skip past space and continue
			trimmed space_pos 1 + trimmed str::len space_pos - 1 - str::substring! -> trimmed
		}
	}
}

fn run_file(path:str -- ) {
	-> path
	0 -> bytes_read
	"" -> content
	"" -> line
	0 -> newline_pos

	// Allocate 64KB buffer for file content
	65536 mem::alloc -> buf

	path io::Read io::open! if {
		-> file
		file buf 65536 io::read! if {
			-> bytes_read
			file io::close
			buf bytes_read mem::to_string -> content
		} else {
			drop
			file io::close
			"dc: could not read file: " . path . nl
			buf mem::free
			1 os::exit
		}
	} else {
		drop
		"dc: could not open file: " . path . nl
		buf mem::free
		1 os::exit
	}

	buf mem::free

	// Process content line by line
	loop {
		content str::len 0 <= if {
			break
		}
		content "\n" str::index_of -> newline_pos
		newline_pos 0 < if {
			// No more newlines - process remaining as last line
			content process_line
			break
		} else {
			// Extract line before newline
			content 0 newline_pos str::substring! -> line
			line process_line
			// Skip past newline and continue
			content newline_pos 1 + content str::len newline_pos - 1 - str::substring! -> content
		}
	}
}

fn repl( -- ) {
	"" -> input
	loop {
		io::readline! if {
			-> input
			input process_line
			input drop
		} else {
			// EOF or error - exit
			0 os::exit
		}
	}
}

fn main( -- ) {
	read flag::parse -> f
	defer {
		f flag::destroy
	}

	f "--help" flag::bool if {
		print_help
		0 os::exit
	}
	f "-h" flag::bool if {
		print_help
		0 os::exit
	}

	f "--version" flag::bool if {
		print_version
		0 os::exit
	}
	f "-V" flag::bool if {
		print_version
		0 os::exit
	}

	// Check for -e / --expression
	"" -> expr
	f "-e" flag::bool if {
		f "-e" flag::string! -> expr
		expr process_line
		0 os::exit
	}
	f "--expression" flag::bool if {
		f "--expression" flag::string! -> expr
		expr process_line
		0 os::exit
	}

	// Check for -f / --file
	"" -> filepath
	f "-f" flag::bool if {
		f "-f" flag::string! -> filepath
		filepath run_file
		0 os::exit
	}
	f "--file" flag::bool if {
		f "--file" flag::string! -> filepath
		filepath run_file
		0 os::exit
	}

	repl
}
