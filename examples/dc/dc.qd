// dc - desk calculator clone
// A reverse-polish notation calculator
//
// Usage: dc [options]
//
// dc is a reverse-polish desk calculator which supports unlimited
// precision arithmetic. It uses a stack-based approach where numbers
// are pushed onto a stack and operations pop operands and push results.
use flag
use io
use math
use os
use strconv
use strings
use unicode

const Capacity = 1024

// The calculator's stack: its cells, and how many are in use. A global cannot hold an array
// itself, so it holds this.
struct Cells {
	at: []f64 = [1024]f64
}

var cells = Cells {}
var depth:i64 = 0

fn push(v:f64 -- ) { depth Capacity >= if { drop "dc: stack overflow" print nl } else { cells <<at depth rot set depth 1 + -> depth } }
fn pop( -- v:f64) { depth 0 <= if { "dc: stack empty" print nl 0.0 } else { depth 1 - -> depth cells <<at depth nth } }
fn top( -- v:f64) { cells <<at depth 1 - nth }
fn nth_down(i:i64 -- v:f64) { cells <<at swap depth 1 - swap - nth }
fn operands( -- a:f64 b:f64) { pop pop swap }

// Whether there are n values to work on, saying so when there are not
fn enough(n:i64 -- ok:i64) { depth swap >= dup not if { "dc: stack empty" print nl } }

// Whether the top value is fit to work on, saying msg when it is not
fn nonzero(msg:str -- ok:i64) { top 0.0 != dup if { nip } else { swap print nl } }
fn nonneg(msg:str -- ok:i64) { top 0.0 >= dup if { nip } else { swap print nl } }

fn version() { "dc 0.1.0 (Quadrate)" print nl }

fn help() {
	"Usage: dc [OPTION] [file ...]" print nl
	"  -e, --expression=EXPR    evaluate expression" print nl
	"  -f, --file=FILE          evaluate contents of file" print nl
	"  -h, --help               display this help and exit" print nl
	"  -V, --version            output version information and exit" print nl
	nl
	"Report bugs at:  https://github.com/quadrate-language/quadrate/issues" print nl
}

// Operators: each a line, and `known` whether there is one for c

fn modulo(a:f64 b:f64 -- r:f64) { dup2 / math::floor * - }

fn power(a:f64 b:f64 -- r:f64) {
	dup dup math::floor != if { "Runtime warning: non-zero scale in exponent" print nl math::floor }
	math::pow
}

fn divmod(a:f64 b:f64 -- ) { dup2 / math::floor dup push * - push }
fn show_all() { 0 depth fn { dup nth_down print nl 1 + } times drop }

fn known(c:i64 -- yes:i64) {
	switch {
		unicode::plus { 2 enough if { operands + push } 1 }
		unicode::minus { 2 enough if { operands - push } 1 }
		unicode::asterisk { 2 enough if { operands * push } 1 }
		unicode::slash { 2 enough if { "dc: divide by zero" nonzero if { operands / push } } 1 }
		unicode::percent { 2 enough if { "dc: remainder by zero" nonzero if { operands modulo push } } 1 }
		unicode::caret { 2 enough if { operands power push } 1 }
		unicode::v { 1 enough if { "dc: square root of negative number" nonneg if { pop math::sqrt push } } 1 }
		unicode::p { 1 enough if { top print nl } 1 }
		unicode::n { 1 enough if { pop print } 1 }
		unicode::f { show_all 1 }
		unicode::z { depth cast<f64> push 1 }
		unicode::tilde { 2 enough if { "dc: divide by zero" nonzero if { operands divmod } } 1 }
		unicode::c { 0 -> depth 1 }
		unicode::d { 1 enough if { top push } 1 }
		unicode::r { 2 enough if { pop pop swap push push } 1 }
		unicode::q { 0 os::exit 1 }
		_ { 0 }
	}
}

fn unimplemented(op:str -- ) {
	"dc: '" print dup print "' (0" print 0 strings::char_at 8 strconv::format_int print ") unimplemented" print nl
}

fn operator(op:str -- ) { dup 0 strings::char_at known if { drop } else { unimplemented } }

// Tokens: a number is a digit first, or an _ or - and then a digit; _ makes it negative

fn digit_at(tok:str i:i64 -- yes:i64) { over len over > if { strings::char_at unicode::is_digit } else { drop2 0 } }
fn signed(tok:str -- yes:i64) { 0 strings::char_at dup unicode::underscore == swap unicode::minus == or }

fn is_number(tok:str -- yes:i64) {
	dup 0 digit_at if { drop 1 } else { dup len 1 > if { dup signed swap 1 digit_at and } else { drop 0 } }
}

fn number(tok:str -- ) {
	dup 0 strings::char_at unicode::underscore == if {
		1 over len 1 - strings::substring! strconv::parse_float! 0.0 swap -
	} else {
		strconv::parse_float!
	}
	push
}

fn token(tok:str -- ) { dup is_number if { number } else { dup len 0 > if { operator } else { drop } } }

// Lines: everything from # on is a comment, and tokens are separated by spaces

fn uncomment(input:str -- input:str) { dup "#" strings::index_of dup 0 >= if { 0 swap strings::substring! } else { drop } }
fn line(input:str -- ) { uncomment strings::trim " " strings::split! fn { token } each }

fn run_file(path:str -- ) {
	dup io::read_file switch {
		Ok { nip strings::lines! fn { line } each }
		io::ErrRead { drop "dc: could not read file: " print print nl 1 os::exit }
		_ { drop "dc: could not open file: " print print nl 1 os::exit }
	}
}

fn repl() {
	loop {
		io::readline switch {
			Ok { if { line } else { drop 0 os::exit } }
			_ { drop2 1 os::exit }
		}
	}
}

fn main() {
	os::args flag::parse
	dup "-h" "--help" flag::either if { help 0 os::exit }
	dup "-V" "--version" flag::either if { version 0 os::exit }
	dup "-e" flag::boolean if { dup "-e" flag::string! line 0 os::exit }
	dup "--expression" flag::boolean if { dup "--expression" flag::string! line 0 os::exit }
	dup "-f" flag::boolean if { dup "-f" flag::string! run_file 0 os::exit }
	dup "--file" flag::boolean if { dup "--file" flag::string! run_file 0 os::exit }
	flag::destroy
	repl
}
