// dc - desk calculator clone
// A reverse-polish notation calculator
//
// Usage: dc [options]
//
// dc is a reverse-polish desk calculator which supports unlimited
// precision arithmetic. It uses a stack-based approach where numbers
// are pushed onto a stack and operations pop operands and push results.
use flag
use io
use math
use mem
use os
use str
use strconv
use unicode

// Calculator stack - using an explicit array
pub struct Stack {
	data: ptr
	size: i64
	capacity: i64
}

fn stack_new( -- s:ptr) {
	1024 -> cap
	cap 8 * mem::alloc -> data
	Stack { data = data, size = 0, capacity = cap }
}

fn stack_free(s:ptr -- ) {
	-> s
	s @data mem::free
}

fn stack_push(s:ptr val:f64 -- ) {
	-> val
	-> s
	s @size -> sz
	s @capacity -> cap
	sz cap >= if {
		// Stack overflow - just ignore for now
		"dc: stack overflow" print nl
	} else {
		val s @data sz 8 * mem::set_f64
		sz 1 + s.size
	}
}

fn stack_pop(s:ptr -- val:f64) {
	-> s
	s @size -> sz
	sz 0 <= if {
		"dc: stack empty" print nl
		0.0
	} else {
		sz 1 - -> sz
		sz s.size
		s @data sz 8 * mem::get_f64
	}
}

fn stack_peek(s:ptr -- val:f64) {
	-> s
	s @size -> sz
	sz 0 <= if {
		0.0
	} else {
		s @data sz 1 - 8 * mem::get_f64
	}
}

fn stack_depth(s:ptr -- n:i64) {
	-> s
	s @size
}

fn stack_clear(s:ptr -- ) {
	-> s
	0 s.size
}

fn stack_dup(s:ptr -- ) {
	-> s
	s @size -> sz
	sz 0 <= if {
		"dc: stack empty" print nl
	} else {
		s @data sz 1 - 8 * mem::get_f64 -> val
		s val stack_push
	}
}

fn stack_swap(s:ptr -- ) {
	-> s
	s @size -> sz
	sz 2 < if {
		"dc: stack empty" print nl
	} else {
		s @data sz 1 - 8 * mem::get_f64 -> a
		s @data sz 2 - 8 * mem::get_f64 -> b
		b s @data sz 1 - 8 * mem::set_f64
		a s @data sz 2 - 8 * mem::set_f64
	}
}

fn stack_pick(s:ptr n:i64 -- val:f64) {
	-> n
	-> s
	s @size -> sz
	n sz >= n 0 < or if {
		0.0
	} else {
		s @data sz 1 - n - 8 * mem::get_f64
	}
}

fn print_version( -- ) {
	"dc 0.1.0 (Quadrate)" print nl
}

fn print_help( -- ) {
	"Usage: dc [OPTION] [file ...]" print nl
	"  -e, --expression=EXPR    evaluate expression" print nl
	"  -f, --file=FILE          evaluate contents of file" print nl
	"  -h, --help               display this help and exit" print nl
	"  -V, --version            output version information and exit" print nl
	nl
	"Email bug reports to:  ~klahr/quadrate@lists.sr.ht" print nl
}

fn is_number(tok:str -- result:i64) {
	-> tok
	0 -> first
	0 -> second
	0 -> result
	tok str::len 0 > if {
		tok 0 str::char_at -> first
		first unicode::is_digit if {
			1 -> result
		} else {
			first unicode::underscore == first unicode::minus == or if {
				tok str::len 1 > if {
					tok 1 str::char_at -> second
					second unicode::is_digit -> result
				}
			}
		}
	}
	result
}

fn process_token(s:ptr tok:str -- ) {
	-> tok
	-> s
	0 -> first
	tok is_number if {
		tok 0 str::char_at -> first
		first unicode::underscore == if {
			tok 1 tok str::len 1 - str::substring! castf -> val
			s 0.0 val sub stack_push
		} else {
			tok castf -> val
			s val stack_push
		}
	} else {
		tok str::len 0 > if {
			s tok process_operator
		}
	}
}

fn process_operator(s:ptr op:str -- ) {
	-> op
	-> s
	0 -> n
	0.0 -> a
	0.0 -> b
	0.0 -> q
	0.0 -> r
	"" -> octal
	op 0 str::char_at switch {
		unicode::plus {
			s stack_depth 2 >= if {
				s stack_pop -> b
				s stack_pop -> a
				s a b add stack_push
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::minus {
			s stack_depth 2 >= if {
				s stack_pop -> b
				s stack_pop -> a
				s a b sub stack_push
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::asterisk {
			s stack_depth 2 >= if {
				s stack_pop -> b
				s stack_pop -> a
				s a b mul stack_push
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::slash {
			s stack_depth 2 >= if {
				s stack_peek 0.0 != if {
					s stack_pop -> b
					s stack_pop -> a
					s a b div stack_push
				} else {
					"dc: divide by zero" print nl
				}
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::percent {
			s stack_depth 2 >= if {
				s stack_peek 0.0 != if {
					s stack_pop -> b
					s stack_pop -> a
					// Remainder for floats: a - floor(a/b)*b
					a a b div math::floor b mul sub -> r
					s r stack_push
				} else {
					"dc: remainder by zero" print nl
				}
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::caret {
			s stack_depth 2 >= if {
				s stack_pop -> b
				s stack_pop -> a
				// Check if exponent is non-integer, floor it if so
				b b math::floor != if {
					"Runtime warning: non-zero scale in exponent" print nl
					b math::floor -> b
				}
				a b math::pow -> r
				s r stack_push
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::v {
			s stack_depth 1 >= if {
				s stack_peek 0.0 >= if {
					s stack_pop -> a
					a math::sqrt -> r
					s r stack_push
				} else {
					"dc: square root of negative number" print nl
				}
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::p {
			s stack_depth 1 >= if {
				s stack_peek print nl
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::n {
			s stack_depth 1 >= if {
				s stack_pop print
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::f {
			// Print full stack from top to bottom
			s stack_depth -> n
			0 n 1 for it {
				s it stack_pick print nl
			}
		}
		unicode::z {
			// Push stack depth
			s stack_depth castf -> a
			s a stack_push
		}
		unicode::tilde {
			// Divmod: push both quotient and remainder
			s stack_depth 2 >= if {
				s stack_peek 0.0 != if {
					s stack_pop -> b
					s stack_pop -> a
					a b div math::floor -> q
					// Remainder = a - q*b
					a q b mul sub -> r
					s q stack_push
					s r stack_push
				} else {
					"dc: divide by zero" print nl
				}
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::c {
			s stack_clear
		}
		unicode::d {
			s stack_depth 1 >= if {
				s stack_dup
			} else {
				"dc: stack empty" print nl
			}
		}
		unicode::r {
			s stack_depth 2 >= if {
				s stack_swap
			}
		}
		unicode::q {
			0 os::exit
		}
		_ {
			op 0 str::char_at 8 strconv::format_int -> octal
			"dc: '" print op print "' (0" print octal print ") unimplemented" print nl
		}
	}
}

fn process_line(s:ptr input:str -- ) {
	-> input
	-> s
	0 -> comment_pos
	"" -> trimmed
	"" -> token
	0 -> space_pos
	// Strip comments (everything from # to end of line)
	input "#" str::index_of -> comment_pos
	comment_pos 0 >= if {
		input 0 comment_pos str::substring! -> input
	}
	input str::trim -> trimmed

	// Process space-separated tokens
	loop {
		trimmed str::len 0 <= if {
			break
		}
		trimmed " " str::index_of -> space_pos
		space_pos 0 < if {
			// No more spaces - process remaining as last token
			s trimmed process_token
			break
		} else {
			// Extract token before space
			trimmed 0 space_pos str::substring! -> token
			token str::len 0 > if {
				s token process_token
			}
			// Skip past space and continue
			trimmed space_pos 1 + trimmed str::len space_pos - 1 - str::substring! -> trimmed
		}
	}
}

fn run_file(s:ptr path:str -- ) {
	-> path
	-> s
	0 -> bytes_read
	"" -> content
	"" -> line
	0 -> newline_pos

	// Allocate 64KB buffer for file content
	65536 mem::alloc -> buf

	path io::Read io::open if {
		-> file
		file buf 65536 io::read if {
			-> bytes_read
			file io::close
			buf bytes_read mem::to_string -> content
		} else {
			drop
			file io::close
			"dc: could not read file: " print path print nl
			buf mem::free
			1 os::exit
		}
	} else {
		drop
		"dc: could not open file: " print path print nl
		buf mem::free
		1 os::exit
	}

	buf mem::free

	// Process content line by line
	loop {
		content str::len 0 <= if {
			break
		}
		content "\n" str::index_of -> newline_pos
		newline_pos 0 < if {
			// No more newlines - process remaining as last line
			s content process_line
			break
		} else {
			// Extract line before newline
			content 0 newline_pos str::substring! -> line
			s line process_line
			// Skip past newline and continue
			content newline_pos 1 + content str::len newline_pos - 1 - str::substring! -> content
		}
	}
}

fn repl(s:ptr -- ) {
	-> s
	"" -> input
	loop {
		io::readline! if {
			-> input
			s input process_line
			input drop
		} else {
			// EOF or error - exit
			0 os::exit
		}
	}
}

fn main( -- ) {
	stack_new -> s
	defer {
		s stack_free
	}

	read flag::parse -> f
	defer {
		f flag::destroy
	}

	f "--help" flag::boolean if {
		print_help
		0 os::exit
	}
	f "-h" flag::boolean if {
		print_help
		0 os::exit
	}

	f "--version" flag::boolean if {
		print_version
		0 os::exit
	}
	f "-V" flag::boolean if {
		print_version
		0 os::exit
	}

	// Check for -e / --expression
	"" -> expr
	f "-e" flag::boolean if {
		f "-e" flag::string! -> expr
		s expr process_line
		0 os::exit
	}
	f "--expression" flag::boolean if {
		f "--expression" flag::string! -> expr
		s expr process_line
		0 os::exit
	}

	// Check for -f / --file
	"" -> filepath
	f "-f" flag::boolean if {
		f "-f" flag::string! -> filepath
		s filepath run_file
		0 os::exit
	}
	f "--file" flag::boolean if {
		f "--file" flag::string! -> filepath
		s filepath run_file
		0 os::exit
	}

	s repl
}
