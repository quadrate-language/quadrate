// dc - desk calculator clone
// A reverse-polish notation calculator
//
// Usage: dc [options]
//
// dc is a reverse-polish desk calculator which supports unlimited
// precision arithmetic. It uses a stack-based approach where numbers
// are pushed onto a stack and operations pop operands and push results.
use flag
use io
use math
use os
use str
use strconv
use unicode

fn print_version( -- ) {
	"dc 0.1.0 (Quadrate port)" . nl
}

fn print_help( -- ) {
	"Usage: dc [OPTION] [file ...]" . nl
	nl
	"  -e, --expression=EXPR  evaluate expression" . nl
	"  -f, --file=FILE        evaluate contents of file" . nl
	"  -h, --help             display this help and exit" . nl
	"  -V, --version          output version information and exit" . nl
	nl
	"Email bug reports to: ~klahr/quadrate@lists.sr.ht" . nl
}

fn process_token(tok:str -- ) {
	-> tok
	0 -> first_char
	0 -> second_char
	"" -> num_str
	// Check for numbers first
	tok str::len 0 > if {
		tok 0 str::char_at -> first_char

		// Check if it starts with digit
		first_char unicode::is_digit if {
			tok castf
		} else {
			// Check if starts with underscore (dc negative prefix)
			first_char unicode::underscore == if {
				tok str::len 1 > if {
					tok 1 str::char_at -> second_char
					second_char unicode::is_digit if {
						// Parse as negative: skip underscore, negate result
						"" -> num_str
						tok 1 tok str::len 1 - str::substring! -> num_str
						num_str castf 0 swap sub
					} else {
						tok process_operator
					}
				} else {
					tok process_operator
				}
			} else {
				// Check if starts with minus and has more chars
				first_char unicode::minus == if {
					tok str::len 1 > if {
						tok 1 str::char_at -> second_char
						second_char unicode::is_digit if {
							tok castf
						} else {
							tok process_operator
						}
					} else {
						tok process_operator
					}
				} else {
					tok process_operator
				}
			}
		}
	}
}

fn process_operator(op:str -- ) {
	-> op
	0 -> n
	0.0 -> a
	0.0 -> b
	0.0 -> q
	0.0 -> r
	"" -> octal
	op 0 str::char_at switch {
		unicode::plus {
			depth 2 >= if {
				add
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::minus {
			depth 2 >= if {
				sub
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::asterisk {
			depth 2 >= if {
				mul
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::slash {
			depth 2 >= if {
				dup 0 != if {
					div
				} else {
					"dc: remainder by zero" . nl
				}
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::percent {
			depth 2 >= if {
				dup 0 != if {
					// Remainder for floats: a - floor(a/b)*b
					-> b -> a
					a a b div math::floor b mul sub
				} else {
					"dc: remainder by zero" . nl
				}
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::caret {
			depth 2 >= if {
				// Check if exponent is non-integer, floor it if so
				dup dup math::floor != if {
					"Runtime warning: non-zero scale in exponent" . nl
					math::floor
				}
				math::pow
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::v {
			dup 0 >= if {
				math::sqrt
			} else {
				"dc: square root of negative number" . nl
			}
		}
		unicode::p {
			dup . nl
		}
		unicode::n {
			print
		}
		unicode::f {
			// Print full stack from top to bottom
			depth -> n
			0 n 1 for {
				$ pick . nl
			}
		}
		unicode::z {
			// Push stack depth
			depth
		}
		unicode::tilde {
			// Divmod: push both quotient and remainder
			depth 2 >= if {
				dup 0 != if {
					-> b -> a
					a b div math::floor -> q
					// Remainder = a - q*b
					a q b mul sub -> r
					q r
				} else {
					"dc: remainder by zero" . nl
				}
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::c {
			clear
		}
		unicode::d {
			depth 1 >= if {
				dup
			} else {
				"dc: stack empty" . nl
			}
		}
		unicode::r {
			depth 2 >= if {
				swap
			}
		}
		unicode::q {
			0 os::exit
		}
		_ {
			op 0 str::char_at 8 strconv::format_int -> octal
			"dc: '" . op . "' (0" . octal . ") unimplemented" . nl
		}
	}
}

fn process_line(input:str -- ) {
	-> input
	0 -> comment_pos
	"" -> trimmed
	// Strip comments (everything from # to end of line)
	input "#" str::index_of -> comment_pos
	comment_pos 0 >= if {
		input 0 comment_pos str::substring! -> input
	}
	input str::trim -> trimmed
	trimmed str::len 0 > if {
		trimmed process_token
	}
}

fn repl( -- ) {
	loop {
		io::readline! if {
			-> input
			input process_line
		} else {
			// EOF or error - exit
			0 os::exit
		}
	}
}

fn main( -- ) {
	read flag::parse -> f
	defer {
		f flag::destroy
	}

	f "--help" flag::bool if {
		print_help
		0 os::exit
	}
	f "-h" flag::bool if {
		print_help
		0 os::exit
	}

	f "--version" flag::bool if {
		print_version
		0 os::exit
	}
	f "-V" flag::bool if {
		print_version
		0 os::exit
	}

	repl
}
