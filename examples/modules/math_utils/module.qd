// Math utilities module
// Demonstrates how to create and use modules in Quadrate
// Constants - using pub const for module-level constants
pub const Pi = 3.141592653589793
pub const Tau = 6.283185307179586
pub const E = 2.718281828459045

// Utility functions that push commonly used values
pub fn get_hundred( -- result:f64) {
	100.0
}

pub fn get_zero( -- result:f64) {
	0.0
}

pub fn get_one( -- result:f64) {
	1.0
}
