// Example demonstrating the module system in Quadrate
// This program imports the math_utils module

use math_utils

fn main( -- ) {
	// The module system is working!
	// - Module file is discovered (./math_utils/module.qd)
	// - Module is transpiled to C (math_utils/module.qd.c)
	// - Header file is generated (math_utils/module.h)
	// - Module functions and constants are accessible with full type checking

	// Access module constants with pub const
	math_utils::Pi print nl
	math_utils::Tau print nl
	math_utils::E print nl

	// Call module functions
	math_utils::get_hundred print nl
	math_utils::get_zero print nl
	math_utils::get_one print nl
}
