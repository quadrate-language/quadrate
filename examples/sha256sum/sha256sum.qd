use crypto
use flag
use io
use os
use strings

const VERSION = "1.0.0"

// What the flags asked for, read once at startup
var binary_mode:i64 = 0
var tag_mode:i64 = 0
var zero_mode:i64 = 0
var check_mode:i64 = 0
var quiet:i64 = 0
var status_mode:i64 = 0
var warn_mode:i64 = 0
var ignore_missing:i64 = 0
var strict:i64 = 0

// Checksums that did not hold, over every file checked
var failures:i64 = 0

fn help() {
	"Usage: sha256sum [OPTION]... [FILE]..." print nl
	"Print or check SHA256 (256-bit) checksums." print nl
	nl
	"With no FILE, or when FILE is -, read standard input." print nl
	"  -b, --binary          read in binary mode" print nl
	"  -c, --check           read checksums from the FILEs and check them" print nl
	"      --tag             create a BSD-style checksum" print nl
	"  -t, --text            read in text mode (default)" print nl
	"  -z, --zero            end each output line with NUL, not newline" print nl
	nl
	"The following options are useful only when verifying checksums:" print nl
	"      --ignore-missing  don't fail or report status for missing files" print nl
	"      --quiet           don't print OK for each successfully verified file" print nl
	"      --status          don't output anything, status code shows success" print nl
	"      --strict          exit non-zero for improperly formatted checksum lines" print nl
	"  -w, --warn            warn about improperly formatted checksum lines" print nl
	nl
	"      --help            display this help and exit" print nl
	"      --version         output version information and exit" print nl
	nl
	"The sums are computed as described in FIPS-180-2." print nl
	"When checking, the input should be a former output of this program." print nl
}

fn version() {
	"sha256sum (quadrate) " print VERSION print nl
}

// The SHA-256 of a file's bytes, and whether it could be read
fn digest(path:str -- hash:str ok:i64) { io::read_file switch { Ok { crypto::sha256! 1 } _ { drop "" 0 } } }

fn miss() { failures 1 + -> failures }
fn line_end() { zero_mode if { 0 strings::from_char print } else { nl } }
fn missing(path:str -- ) { "sha256sum: " print print ": No such file or directory" print nl }

// Hashing

fn show(path:str hash:str -- ) {
	tag_mode if {
		"SHA256 (" print swap print ") = " print print
	} else {
		print binary_mode if { " *" } else { "  " } print print
	}
	line_end
}

fn hash_file(path:str -- ) { dup digest if { show } else { drop missing miss } }

// Checking: each line of a checksum file is a hash, a separator and a file name

fn well_formed(line:str -- yes:i64) { dup len 67 >= if { 64 strings::char_at dup 32 == swap 42 == or } else { drop 0 } }
fn expected(line:str -- hash:str) { 0 64 strings::substring! }
fn named(line:str -- file:str) { 66 over len 66 - strings::substring! }

fn passed(file:str -- ) { status_mode quiet or if { drop } else { print ": OK" print nl } }
fn failed(file:str -- ) { miss status_mode if { drop } else { print ": FAILED" print nl } }
fn absent(file:str -- ) { ignore_missing if { drop } else { miss status_mode if { drop } else { missing } } }

fn verify(line:str -- ) {
	dup named swap expected
	over digest if { strings::compare 0 == if { passed } else { failed } } else { drop drop absent }
}

// The n-th line that is not empty, of the checksum file at path, did not parse
fn malformed(path:str n:i64 -- ) {
	warn_mode status_mode not and if {
		"sha256sum: " print swap print ":" print print ": improperly formatted SHA256 checksum line" print nl
	} else {
		drop2
	}
	strict if { miss }
}

fn check_line(path:str n:i64 line:str -- ) { dup well_formed if { nip nip verify } else { drop malformed } }

fn check_file(path:str -- ) {
	dup io::read_file switch {
		Ok { strings::lines! fn { len 0 > } filter 1 swap fn { pick pick rot check_line 1 + } each drop2 }
		_ { drop status_mode if { drop } else { missing } miss }
	}
}

// Running

fn options(f:flag::Flag -- ) {
	dup "-b" "--binary" flag::either -> binary_mode
	dup "-t" "--text" flag::either if { 0 -> binary_mode }
	dup "--tag" flag::boolean -> tag_mode
	dup "-z" "--zero" flag::either -> zero_mode
	dup "-c" "--check" flag::either -> check_mode
	dup "-q" "--quiet" flag::either -> quiet
	dup "--status" flag::boolean -> status_mode
	dup "-w" "--warn" flag::either -> warn_mode
	dup "--ignore-missing" flag::boolean -> ignore_missing
	dup "--strict" flag::boolean -> strict
	flag::destroy
}

fn files( -- names:[]str) { os::args fn { "-" strings::starts_with not } filter }

fn run() {
	files dup len 0 == check_mode not and if {
		"sha256sum: missing file operand" print nl
		"Try 'sha256sum --help' for more information." print nl
	}
	check_mode if { fn { check_file } each } else { fn { hash_file } each }
	check_mode failures 0 > and status_mode not and if {
		"sha256sum: WARNING: " print failures print " computed checksum did NOT match" print nl
	}
}

fn main() {
	os::args flag::parse
	dup "-h" "--help" flag::either if {
		help flag::destroy
	} else {
		dup "--version" flag::boolean if { version flag::destroy } else { options run }
	}
	// A file that could not be read or did not match fails the run, as GNU sha256sum's does
	failures 0 > if { 1 os::exit }
}
