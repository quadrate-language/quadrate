// wc - word, line, byte, and character counter
//
// A clone of the classic Unix `wc` tool. Reads each named file (or stdin
// if none given) and prints counts of newlines, words, and bytes.
//
// Demonstrates: stack code without named locals, combinators over a
// string, global variables, file I/O, command-line flags.
//
// Usage:
//   wc [-l] [-w] [-c] [FILE]...
//   wc < input.txt
//
//   -l, --lines    print the newline counts
//   -w, --words    print the word counts
//   -c, --bytes    print the byte counts
//   -h, --help     show this help
//
// With no count flags, all three counts are printed.
// With multiple files, totals are printed at the end.

use flag
use io
use os
use strconv
use strings

const VERSION = "1.0.0"

// What the flags asked for, read once at startup. Each column is the word
// that prints its count, `column` or `skip`, so a row tests nothing.
var asked_help:i64 = 0
var asked_version:i64 = 0
var col_l:fn(i64 --) = &column
var col_w:fn(i64 --) = &column
var col_c:fn(i64 --) = &column

// Running totals over every file read.
var total_l:i64 = 0
var total_w:i64 = 0
var total_c:i64 = 0

// Set when a file could not be read
var unreadable:i64 = 0

fn help() {
	"Usage: wc [OPTION]... [FILE]..." print nl
	"Print newline, word, and byte counts for each FILE." print nl
	"With no FILE, read standard input." print nl
	nl
	"  -l, --lines    print the newline counts" print nl
	"  -w, --words    print the word counts" print nl
	"  -c, --bytes    print the byte counts" print nl
	"  -h, --help     display this help and exit" print nl
	"      --version  output version information and exit" print nl
}

fn version() { "wc (quadrate) " print VERSION print nl }

// Counting. A word is a maximal run of non-whitespace, as POSIX wc has it.

fn blank(c:i64 -- yes:i64) { dup 32 == swap 9 13 within or }

// One character of a word count: w words so far, p whether the last
// character was whitespace. A word starts where p meets non-whitespace.
fn word(w:i64 p:i64 c:i64 -- w:i64 p:i64) { blank tuck not and rot + swap }
fn lines(s:str -- n:i64) { 0 swap fn { 10 == + } each }
fn words(s:str -- n:i64) { 0 1 rot fn { word } each drop }
fn bytes(s:str -- n:i64) { strings::byte_len }
fn counts(s:str -- l:i64 w:i64 c:i64) { fn { lines } fn { words } fn { bytes } tri }

fn tally(l:i64 w:i64 c:i64 -- l:i64 w:i64 c:i64) {
	dup total_c + -> total_c
	over total_w + -> total_w
	pick total_l + -> total_l
}

// Printing

fn column(n:i64 -- ) { strconv::itoa 7 " " strings::pad_left print " " print }
fn skip(n:i64 -- ) { drop }
fn columns(l:i64 w:i64 c:i64 -- ) { col_l col_w col_c tri_star }
fn row(name:str l:i64 w:i64 c:i64 -- ) { columns print nl }
fn totals() { "total" total_l total_w total_c row }

// One file: its row, labelled name, from the contents of path.
fn report(name:str path:str -- ) {
	io::read_file switch {
		Ok { counts tally row }
		_ { drop "wc: " print print ": cannot read file" print nl 1 -> unreadable }
	}
}

fn file(name:str -- ) { dup report }
fn stdin() { "" "/dev/stdin" report }

// Flags

// No count asked for means all three
fn all_if_none(l:i64 w:i64 c:i64 -- l:i64 w:i64 c:i64) { pick pick pick or or not if { drop2 drop 1 1 1 } }
fn shown(yes:i64 -- word:fn(i64 --)) { if { &column } else { &skip } }

// Read every flag once, then let go of them
fn options(f:flag::Flag -- ) {
	dup "-h" "--help" flag::either -> asked_help
	dup "--version" flag::boolean -> asked_version
	dup "-l" "--lines" flag::either
	over "-w" "--words" flag::either
	pick "-c" "--bytes" flag::either
	all_if_none fn { shown } fn { shown } fn { shown } tri_star
	-> col_c -> col_w -> col_l
	flag::destroy
}

fn files( -- names:[]str) { os::args fn { "-" strings::starts_with not } filter }

fn count() {
	files dup len switch {
		0 { drop stdin }
		1 { fn { file } each }
		_ { fn { file } each totals }
	}
}

fn main() {
	os::args flag::parse options
	asked_help if {
		help
	} else {
		asked_version if { version } else { count }
	}
	// A file that could not be read fails the run, as GNU wc's does
	unreadable if { 1 os::exit }
}
