// Example demonstrating structs and constants in Quadrate

use math

// Constants for configuration
const MaxPoints = 100
const OriginX = 0.0
const OriginY = 0.0

// Define a Point struct with x and y coordinates
struct Point {
	x:f64
	y:f64
}

// Create a new point at origin
fn new_origin( -- p:ptr) {
	OriginX OriginY Point
}

// Create a point at given coordinates
fn new_point(x:f64 y:f64 -- p:ptr) {
	Point
}

// Calculate distance from origin using Pythagorean theorem
fn distance_from_origin(p:ptr -- dist:f64) {
	-> p
	p @x dup *
	p @y dup *
	+
	math::sqrt
}

// Calculate distance between two points
fn distance(p1:ptr p2:ptr -- dist:f64) {
	-> p2 -> p1
	p2 @x p1 @x - dup *
	p2 @y p1 @y - dup *
	+
	math::sqrt
}

// Print a point as (x, y)
fn print_point(p:ptr -- ) {
	-> p
	"(" . p @x print ", " . p @y print ")" .
}

fn main( -- ) {
	"=== Structs and Constants Example ===" . nl
	nl

	// Show constants
	"Max points allowed: " . MaxPoints . nl
	nl

	// Create points using struct constructor
	// Syntax: value1 value2 StructName -> variable
	"Creating points:" . nl
	new_origin -> p1
	3.0 4.0 new_point -> p2
	6.0 8.0 new_point -> p3

	"  p1 (origin) = " . p1 print_point nl
	"  p2 = " . p2 print_point nl
	"  p3 = " . p3 print_point nl
	nl

	// Access struct fields with @fieldname syntax
	"Field access:" . nl
	"  p2.x = " . p2 @x print nl
	"  p2.y = " . p2 @y print nl
	nl

	// Calculate distances
	"Distances:" . nl
	"  p1 to origin: " . p1 distance_from_origin print nl
	"  p2 to origin: " . p2 distance_from_origin print " (3-4-5 triangle)" . nl
	"  p1 to p2: " . p1 p2 distance print nl
	"  p2 to p3: " . p2 p3 distance print nl
	nl

	// Clean up - free allocated structs
	p1 free
	p2 free
	p3 free

	"Done!" . nl
}
