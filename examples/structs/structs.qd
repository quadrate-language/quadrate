// Example demonstrating structs and methods in Quadrate
use math

// Constants for configuration
const MaxPoints = 100
const OriginX = 0.0
const OriginY = 0.0

// Define a new Point struct with x and y coordinates
struct Point {
	x: f64
	y: f64
}

// Method: Calculate distance from origin using Pythagorean theorem
fn (p:Point) distance_from_origin( -- dist:f64) {
	p @x dup *
	p @y dup *
	+
	math::sqrt
}

// Method: Calculate distance to another point
fn (p:Point) distance_to(other:Point -- dist:f64) {
	-> other
	other @x p @x - dup *
	other @y p @y - dup *
	+
	math::sqrt
}

// Method: Print a point as (x, y)
fn (p:Point) print_point() {
	"(" print p @x print ", " print p @y print ")" print
}

// Factory function: Create a point at origin
// Note: Return type should be the struct name (Point) to enable method calls
fn new_origin( -- p:Point) {
	Point {
		x = OriginX
		y = OriginY
	}
}

// Factory function: Create a point at given coordinates
fn new_point(x:f64 y:f64 -- p:Point) {
	-> y -> x
	Point {
		x = x
		y = y
	}
}

fn main() {
	"=== Structs and Methods Example ===" print nl
	nl

	// Show constants
	"Max points allowed: " print MaxPoints print nl
	nl

	// Create points using struct constructor
	// Syntax = StructName { field = value ... } -> variable
	"Creating points:" print nl
	new_origin -> p1
	3.0 4.0 new_point -> p2
	6.0 8.0 new_point -> p3

	"  p1 (origin) = " print p1 print_point nl
	"  p2 = " print p2 print_point nl
	"  p3 = " print p3 print_point nl
	nl

	// Access struct fields with @fieldname syntax
	"Field access:" print nl
	"  p2.x = " print p2 @x print nl
	"  p2.y = " print p2 @y print nl
	nl

	// Calculate distances using methods
	"Distances (using methods):" print nl
	"  p1 to origin: " print p1 distance_from_origin print nl
	"  p2 to origin: " print p2 distance_from_origin print " (3-4-5 triangle)" print nl
	"  p1 to p2: " print p2 p1 distance_to print nl
	"  p2 to p3: " print p3 p2 distance_to print nl
	nl

	// Methods work on inline struct construction too
	"Inline struct method call:" print nl
	"  Point{5,12} to origin: " print Point {
		x = 5.0 y = 12.0
	}
	distance_from_origin print nl
	nl

	"Done!" print nl
}
