/// REST API example demonstrating route groups and middleware.
///
/// This example shows how to build a structured API with:
/// - Route groups for organizing endpoints
/// - Middleware for logging and headers
/// - Different response types (JSON, plain text)
/// - Path and query parameters
///
/// Run with: quad run rest-api.qd
///
/// Try these endpoints:
///   curl http://localhost:3000/
///   curl http://localhost:3000/api/users
///   curl http://localhost:3000/api/users/123
///   curl http://localhost:3000/api/posts
///   curl http://localhost:3000/search?q=hello
use http

fn logger_middleware(c:ptr -- ) {
}

fn api_middleware(c:ptr -- ) {
}

fn handle_root(c:ptr -- ) {
	c http::StatusOK "Welcome to the REST API. Try /api/users or /api/posts" http::string
}

fn handle_search(c:ptr -- ) {
	c "q" http::query_param -> query
	c http::StatusOK query http::string
}

fn handle_list_users(c:ptr -- ) {
	c http::StatusOK "[]" http::json
}

fn handle_get_user(c:ptr -- ) {
	c "id" http::param -> id
	c http::StatusOK id http::json
}

fn handle_create_user(c:ptr -- ) {
	c http::StatusCreated "{}" http::json
}

fn handle_delete_user(c:ptr -- ) {
	c "id" http::param -> id
	c http::StatusOK "{}" http::json
}

fn handle_list_posts(c:ptr -- ) {
	c http::StatusOK "[]" http::json
}

fn handle_get_post(c:ptr -- ) {
	c "id" http::param -> id
	c http::StatusOK id http::json
}

fn main() {
	"REST API Server" print nl
	"================" print nl
	nl
	"Endpoints:" print nl
	"  GET  /                  - Welcome message" print nl
	"  GET  /search?q=...      - Search" print nl
	"  GET  /api/users         - List users" print nl
	"  GET  /api/users/:id     - Get user by ID" print nl
	"  POST /api/users         - Create user" print nl
	"  DELETE /api/users/:id   - Delete user" print nl
	"  GET  /api/posts         - List posts" print nl
	"  GET  /api/posts/:id     - Get post by ID" print nl
	nl
	"Starting on http://localhost:3000" print nl

	http::engine -> e
	e &logger_middleware http::use

	e "/" &handle_root http::GET
	e "/search" &handle_search http::GET

	e "/api" http::group -> api
	api &api_middleware http::group_use

	api "/users" &handle_list_users http::group_GET
	api "/users/:id" &handle_get_user http::group_GET
	api "/users" &handle_create_user http::group_POST
	api "/users/:id" &handle_delete_user http::group_DELETE

	api "/posts" &handle_list_posts http::group_GET
	api "/posts/:id" &handle_get_post http::group_GET

	e ":3000" http::run!
	e http::free_engine
}
