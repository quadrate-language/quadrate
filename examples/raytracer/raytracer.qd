// Sphere raytracer — renders 4 spheres with diffuse lighting and shadows
// Outputs PPM P3 image to stdout (800x800)
//
// Run: quadc raytracer.qd -r > image.ppm
use fmt
use math
use testing

// Ray-sphere intersection (half-b optimization)
// Returns closest t > 0.001, or -1.0 if no hit
fn hit(origin:math::Vec3 dir:math::Vec3 center:math::Vec3 rad:f64 -- t:f64) {
	origin center subtract -> oc
	dir oc dot -> half_b
	half_b half_b * oc length_sq - rad rad * + -> disc
	disc 0.0 < if {
		-1.0
	} else {
		disc math::sqrt -> sq
		half_b -1.0 * sq - -> t0
		t0 0.001 > if {
			t0
		} else {
			half_b -1.0 * sq + -> t1
			t1 0.001 > if {
				t1
			} else {
				-1.0
			}
		}
	}
}

// Clamp float to [0, 255] integer
fn to_byte(v:f64 -- b:i64) {
	v 0.0 < if {
		0
	} else {
		v 1.0 > if {
			255
		} else {
			v 255.0 * cast<i64>
		}
	}
}

// --- Tests (run with: quadc raytracer.qd --test -r) ---
test "hit: direct hit along -z axis" {
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = 0.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -1.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -5.0
	}
	1.0 hit
	4.0 0.001 testing::assert_approx_eq
}

test "hit: ray misses sphere" {
	math::Vec3 {
		x = 0.0
		y = 5.0
		z = 0.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -1.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -5.0
	}
	1.0 hit
	-1.0 0.001 testing::assert_approx_eq
}

test "hit: origin inside sphere returns exit point" {
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -5.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -1.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -5.0
	}
	1.0 hit
	1.0 0.001 testing::assert_approx_eq
}

test "hit: ray pointing away from sphere" {
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = 0.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = 1.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -5.0
	}
	1.0 hit
	-1.0 0.001 testing::assert_approx_eq
}

test "hit: tangent ray" {
	math::Vec3 {
		x = 1.0
		y = 0.0
		z = 0.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -1.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -5.0
	}
	1.0 hit
	5.0 0.001 testing::assert_approx_eq
}

test "hit: off-center hit" {
	math::Vec3 {
		x = 0.3
		y = 0.0
		z = 0.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -1.0
	}
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -5.0
	}
	0.5 hit
	4.6 0.001 testing::assert_approx_eq
}

test "hit: large sphere (ground plane)" {
	math::Vec3 {
		x = 0.0
		y = 0.5
		z = 2.0
	}
	math::Vec3 {
		x = 0.0
		y = -0.2425
		z = -0.9701
	}
	math::Vec3 {
		x = 0.0
		y = -100.5
		z = -1.0
	}
	100.0 hit -> t
	t 0.0 > testing::assert_true
}

test "to_byte: mid-range value" {
	0.5 to_byte 127 testing::assert_eq
}

test "to_byte: negative clamped to 0" {
	-0.5 to_byte 0 testing::assert_eq
}

test "to_byte: above 1.0 clamped to 255" {
	1.5 to_byte 255 testing::assert_eq
}

test "to_byte: zero maps to 0" {
	0.0 to_byte 0 testing::assert_eq
}

test "to_byte: one maps to 255" {
	1.0 to_byte 255 testing::assert_eq
}

fn main() {
	800 -> w
	800 -> h

	math::Vec3 {
		x = 0.0
		y = 0.5
		z = 2.0
	} -> cam
	2.0 -> vp_w
	w cast<f64> h cast<f64> / vp_w * -> vp_h
	math::Vec3 {
		x = -0.5
		y = 0.8
		z = 0.6
	} normalize -> light

	// Sphere centers
	math::Vec3 {
		x = 0.0
		y = -100.5
		z = -1.0
	} -> sc0
	math::Vec3 {
		x = 0.0
		y = 0.0
		z = -1.2
	} -> sc1
	math::Vec3 {
		x = -1.1
		y = 0.0
		z = -1.5
	} -> sc2
	math::Vec3 {
		x = 1.1
		y = 0.0
		z = -1.5
	} -> sc3

	// PPM header
	"P3" print nl
	w h "%d %d\n" fmt::printf
	"255" print nl

	0 h 1 for row {
		0 w 1 for col {
			col cast<f64> 0.5 + w cast<f64> / vp_w * vp_w 2.0 / - -> px
			vp_h 2.0 / row cast<f64> 0.5 + h cast<f64> / vp_h * - -> py
			math::Vec3 {
				x = px
				y = py
				z = 0.0
			} cam subtract normalize -> dir

			-1.0 -> best_t
			0 -> best_id

			// Sphere 0: Ground
			cam dir sc0 100.0 hit -> t
			t 0.0 > if {
				best_t 0.0 < t best_t < or if {
					t -> best_t   0 -> best_id
				}
			}

			// Sphere 1: Red
			cam dir sc1 0.5 hit -> t
			t 0.0 > best_t 0.0 < t best_t < or and if {
				t -> best_t   1 -> best_id
			}

			// Sphere 2: Green
			cam dir sc2 0.5 hit -> t
			t 0.0 > best_t 0.0 < t best_t < or and if {
				t -> best_t   2 -> best_id
			}

			// Sphere 3: Blue
			cam dir sc3 0.5 hit -> t
			t 0.0 > best_t 0.0 < t best_t < or and if {
				t -> best_t   3 -> best_id
			}

			best_t 0.0 > if {
				// Hit point and normal
				cam dir best_t scale add -> hp

				math::vec3_zero -> center   0.0 -> rad
				best_id 0 == if {
					sc0 -> center  100.0 -> rad
				}
				best_id 1 == if {
					sc1 -> center  0.5 -> rad
				}
				best_id 2 == if {
					sc2 -> center  0.5 -> rad
				}
				best_id 3 == if {
					sc3 -> center  0.5 -> rad
				}
				hp center subtract 1.0 rad / scale -> normal

				// Diffuse lighting
				normal light dot -> diff
				diff 0.0 < if { 0.0 -> diff }

				// Shadow test
				hp normal 0.001 scale add -> shadow_org
				0 -> in_shadow
				shadow_org light sc1 0.5 hit 0.0 > if { 1 -> in_shadow }
				shadow_org light sc2 0.5 hit 0.0 > if { 1 -> in_shadow }
				shadow_org light sc3 0.5 hit 0.0 > if { 1 -> in_shadow }
				in_shadow 1 == if { 0.1 -> diff }

				// Material color
				math::vec3_zero -> mat
				best_id 0 == if {
					hp <<x math::floor cast<i64> hp <<z math::floor cast<i64> + 2 mod 0 == if {
						math::Vec3 {
							x = 0.9
							y = 0.9
							z = 0.9
						} -> mat
					} else {
						math::Vec3 {
							x = 0.4
							y = 0.4
							z = 0.4
						} -> mat
					}
				}
				best_id 1 == if { math::Vec3 { x = 0.9 y = 0.15 z = 0.15 } -> mat }
				best_id 2 == if { math::Vec3 { x = 0.15 y = 0.9 z = 0.15 } -> mat }
				best_id 3 == if { math::Vec3 { x = 0.15 y = 0.15 z = 0.9 } -> mat }

				// Ambient + diffuse
				mat 0.1 diff 0.9 * + scale -> color
				color <<x to_byte
				color <<y to_byte
				color <<z to_byte
				"%d %d %d\n" fmt::printf
			} else {
				// Sky gradient
				dir <<y 0.5 * 0.5 + -> sky_t
				1.0 sky_t - sky_t 0.5 * + to_byte
				1.0 sky_t - sky_t 0.7 * + to_byte
				255
				"%d %d %d\n" fmt::printf
			}
		}
	}
}
