// csvcut - extract columns from a CSV file
//
// A small `cut`-like tool for CSV. Reads a CSV file (or stdin), parses
// each row according to RFC-4180-ish rules (commas separate fields,
// double-quoted fields may contain commas and escaped quotes ""), and
// prints the selected columns.
//
// Usage:
//   csvcut COLUMNS [FILE]
//   csvcut 1,3 data.csv
//   csvcut 2 < data.csv
//   csvcut -d ';' 1,3 data.csv
//
// Args:
//   COLUMNS       comma-separated 1-based column indices (required)
//   FILE          input CSV (default: stdin)
//
// Flags:
//   -d CHAR       field delimiter (default ',')
//   -h, --help    show this help
//   --version     print version
//
// Demonstrates: CSV parsing with quote handling as stack code over a cursor
// in globals, argument parsing as a fold, file I/O, stdin fallback.

use io
use os
use strconv
use strings

const VERSION = "1.0.0"

// What the arguments asked for: the columns to print, 0-based, and the rest
var columns = []i64
var spec:str = ""
var path:str = "-"
var delim:i64 = 44
var asked_help:i64 = 0
var asked_version:i64 = 0
var got_spec:i64 = 0
var got_file:i64 = 0

// The input; the cursor in it; where the row it is in ends, and where the next one starts
var text:str = ""
var size:i64 = 0
var pos:i64 = 0
var limit:i64 = 0
var stop:i64 = 0

fn help() {
	"Usage: csvcut [OPTION]... COLUMNS [FILE]" print nl
	"Extract selected columns from a CSV input." print nl
	"With no FILE, or when FILE is -, read standard input." print nl
	nl
	"Args:" print nl
	"  COLUMNS       comma-separated 1-based column indices (required)" print nl
	"  FILE          input CSV (default: stdin)" print nl
	nl
	"Options:" print nl
	"  -d CHAR       field delimiter (default ',')" print nl
	"  -h, --help    display this help and exit" print nl
	"      --version output version information and exit" print nl
}

fn version() { "csvcut (quadrate) " print VERSION print nl }

// Arguments, as a fold whose value says what the next one is: an option or an operand (0),
// the -d character (1), or an operand whatever it looks like, after `--` (2)

fn operand(a:str -- ) { got_spec if { got_file if { drop } else { -> path 1 -> got_file } } else { -> spec 1 -> got_spec } }
fn delimiter(a:str -- ) { dup len 0 > if { 0 strings::char_at -> delim } else { drop } }

fn option(a:str -- mode:i64) {
	dup switch {
		"-h" { drop 1 -> asked_help 0 }
		"--help" { drop 1 -> asked_help 0 }
		"--version" { drop 1 -> asked_version 0 }
		"-d" { drop 1 }
		"--" { drop 2 }
		"-" { operand 0 }
		_ { dup "-" strings::starts_with if { "csvcut: unknown option: " print print nl } else { operand } 0 }
	}
}

fn argument(mode:i64 a:str -- mode:i64) {
	swap switch {
		1 { delimiter 0 }
		2 { dup len 0 > if { operand } else { drop } 2 }
		_ { dup len 0 > if { option } else { drop 0 } }
	}
}

// The column spec, "1,3": the digits of each part, 1-based, that has any
fn digits(s:str -- d:str) { "" swap fn { dup 48 57 within if { strings::from_char strings::concat } else { drop } } each }
fn columns_of(spec:str -- picked:[]i64) { "," strings::split! fn { digits } map fn { len 0 > } filter fn { 10 strconv::parse_int! 1 - } map }
fn picked(i:i64 -- yes:i64) { 0 columns fn { pick == or } each nip }

// Rows. A newline in quotes is not the end of one, and "" in quotes is a quote

fn quote_after( -- yes:i64) { stop 1 + size < if { text stop 1 + strings::char_at 34 == } else { 0 } }

// From pos, where the row ends: stop is past its newline, or the end of the input
fn row_end() {
	pos -> stop
	0
	loop {
		stop size < while
		text stop strings::char_at
		dup 34 == if {
			drop dup quote_after and if { stop 2 + -> stop continue } not 34
		}
		10 == over not and if { stop 1 + -> stop break }
		stop 1 + -> stop
	}
	drop
}

// Fields, read with the cursor up to limit

fn in_row( -- yes:i64) { pos limit < }
fn ch( -- c:i64) { text pos strings::char_at }
fn at(c:i64 -- yes:i64) { in_row if { ch == } else { drop 0 } }
fn next() { pos 1 + -> pos }
fn to_delim() { loop { in_row while ch delim == until next } }
fn since(start:i64 -- s:str) { text swap pos over - strings::substring! }
fn escaped( -- yes:i64) { pos 1 + limit < if { text pos 1 + strings::char_at 34 == } else { 0 } }

// To the closing quote, past each "" pair
fn closing() { loop { in_row while 34 at if { escaped if { next } else { break } } next } }

fn plain( -- field:str) { pos to_delim since }
fn quoted( -- field:str) { next pos closing since "\"\"" "\"" strings::replace! 34 at if { next } to_delim }
fn field( -- f:str) { 34 at if { quoted } else { plain } }

// The row from pos to limit: its picked fields, in the order they come, then a newline
fn row() {
	0 0
	loop {
		in_row while
		field pick picked if { swap if { delim strings::from_char print } print 1 } else { drop }
		delim at if { next }
		swap 1 + swap
	}
	drop2 nl
}

fn rows() {
	loop {
		pos size < while
		row_end
		text stop 1 - strings::char_at 10 == if { stop 1 - } else { stop } -> limit
		row
		stop -> pos
	}
}

// The input as one string: the file, or stdin for -
fn slurp(path:str -- text:str ok:i64) {
	dup "-" strings::compare 0 == if { drop "/dev/stdin" } io::read_file switch { Ok { 1 } _ { drop "" 0 } }
}

fn run() {
	spec columns_of dup len 0 == if {
		drop "csvcut: invalid column spec: " print spec print nl
	} else {
		-> columns
		path slurp if {
			dup -> text len -> size
			rows
		} else {
			drop "csvcut: " print path print ": cannot read file" print nl
		}
	}
}

fn main() {
	os::args 0 fn { argument } fold drop
	asked_help if {
		help
	} else {
		asked_version if {
			version
		} else {
			spec len 0 == if {
				"csvcut: missing required COLUMNS argument" print nl
				"Try 'csvcut --help' for more information." print nl
			} else {
				run
			}
		}
	}
}
