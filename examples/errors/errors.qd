// Example demonstrating fallible functions and error handling
fn division(i64 i64 -- i64)! {
	dup 0 == if {
		drop drop
		"division by zero" -1 panic
	}
	/
}

fn main() {
	// Call fallible function with error check using 'if'
	// Success: 'if' branch is taken, result is on stack
	// Error: 'else' branch is taken; the function produced nothing, so the
	// stack is as it was before the call. Use 'err' to read the message and code.

	// Attempt division by zero
	1 0 division if {
		// Success - print result
		"1 / 0 = " print print nl
	} else {
		// Error - nothing was produced; report it
		err drop drop
		"Error: Division by zero!" print nl
	}

	// Successful division
	10 2 division if {
		"10 / 2 = " print print nl
	} else {
		"Unexpected error" print nl
	}

	// Call with '!' to propagate/crash on error
	// Uncomment to see crash behavior:
	// 1 0 division!
}
