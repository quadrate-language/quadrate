// Example demonstrating fallible functions and error handling
fn division(a:i64 b:i64 -- result:i64)! {
	dup 0 == if {
		drop drop
		0
		-1 "division by zero" panic
	}
	div
}

fn main() {
	// Call fallible function with error check using 'if'
	// Success: 'if' branch is taken, result is on stack
	// Error: 'else' branch is taken, error value is on stack

	// Attempt division by zero
	1 0 division if {
		// Success - print result
		"1 / 0 = " print print nl
	} else {
		// Error - drop error value and print message
		drop
		"Error: Division by zero!" print nl
	}

	// Successful division
	10 2 division if {
		"10 / 2 = " print print nl
	} else {
		drop
		"Unexpected error" print nl
	}

	// Call with '!' to propagate/crash on error
	// Uncomment to see crash behavior:
	// 1 0 division!
}
