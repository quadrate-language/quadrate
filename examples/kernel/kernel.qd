// Bare-metal i686 multiboot kernel.
// Writes "Hello, Quadrate kernel!" to VGA text mode, then halts.

use mem
use sys

const VGA_BASE = 0xB8000
const ATTR_W = 0x0F
const ATTR_HI = 0x0F00

fn put(row:i64 col:i64 ch:i64 -- ) {
	row 80 * col + 2 * -> off
	ch VGA_BASE cast<ptr> off mem::set_byte
	ATTR_W VGA_BASE cast<ptr> off 1 + mem::set_byte
}

fn clear_screen() {
	0 -> i
	loop {
		i 80 25 * >= if { break }
		VGA_BASE cast<ptr> i 2 * 32 ATTR_HI or sys::st16
		i 1 + -> i
	}
}

fn _start() {
	clear_screen
	0 0 72 put
	0 1 101 put
	0 2 108 put
	0 3 108 put
	0 4 111 put
	0 5 44 put
	0 6 32 put
	0 7 81 put
	0 8 117 put
	0 9 97 put
	0 10 100 put
	0 11 114 put
	0 12 97 put
	0 13 116 put
	0 14 101 put
	0 15 32 put
	0 16 107 put
	0 17 101 put
	0 18 114 put
	0 19 110 put
	0 20 101 put
	0 21 108 put
	0 22 33 put
}
