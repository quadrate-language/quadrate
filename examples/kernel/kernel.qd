// Bare-metal x86_64 multiboot kernel with interrupt support.
// Demonstrates: GDT, IDT, PIC remapping, PIT timer, PS/2 keyboard.

use sys

// ---------------------------------------------------------------------------
// FFI: assembly helpers (interrupts.S)
// ---------------------------------------------------------------------------
import "interrupts.o" as "hw" {
	pub fn lgdt(addr:i64 --)
	pub fn lidt(addr:i64 --)
	pub fn gdt_addr( -- addr:i64)
	pub fn gdt_desc_addr( -- addr:i64)
	pub fn idt_addr( -- addr:i64)
	pub fn idt_desc_addr( -- addr:i64)
	pub fn isr_table_addr( -- addr:i64)
	pub fn int_num_addr( -- addr:i64)
	pub fn tick_addr( -- addr:i64)
	pub fn cursor_col_addr( -- addr:i64)
	pub fn cursor_row_addr( -- addr:i64)
}

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
const VGA_BASE = 0xB8000
const VGA_COLS = 80
const VGA_ROWS = 25
const ATTR_WHITE = 0x0F
const ATTR_HI = 0x0F00
const BLANK = 0x0F20

const PIC1_CMD = 0x20
const PIC1_DATA = 0x21
const PIC2_CMD = 0xA0
const PIC2_DATA = 0xA1
const PIC_EOI = 0x20
const ICW1_INIT = 0x11
const ICW4_8086 = 0x01

const SEG_KCODE = 0x08
const IDT_PRESENT_INT32 = 0x8E

// Scancodes
const SC_BACKSPACE = 0x0E
const SC_ENTER = 0x1C

// ---------------------------------------------------------------------------
// VGA text mode
// ---------------------------------------------------------------------------
fn vga_put(row:i64 col:i64 ch:i64 -- ) {
	VGA_BASE row VGA_COLS * col + 2 * + 0 ch sys::st8
	VGA_BASE row VGA_COLS * col + 2 * + 1 ATTR_WHITE sys::st8
}

fn vga_clear() {
	0 -> i
	loop {
		i VGA_COLS VGA_ROWS * >= if { break }
		VGA_BASE i 2 * + 0 BLANK sys::st16
		i 1 + -> i
	}
}

fn vga_scroll() {
	// Copy rows 1-24 to rows 0-23
	0 -> dst
	loop {
		dst VGA_COLS VGA_ROWS 1 - * >= if { break }
		VGA_BASE dst 2 * + VGA_COLS 2 * + 0 sys::ld16 -> ch
		VGA_BASE dst 2 * + 0 ch sys::st16
		dst 1 + -> dst
	}
	// Clear last row
	0 -> col
	loop {
		col VGA_COLS >= if { break }
		VGA_BASE VGA_ROWS 1 - VGA_COLS * col + 2 * + 0 BLANK sys::st16
		col 1 + -> col
	}
}

fn vga_print_str(row:i64 col:i64 s_addr:i64 len:i64 -- ) {
	0 -> i
	loop {
		i len >= if { break }
		s_addr i + 0 sys::ld8 -> ch
		row col i + ch vga_put
		i 1 + -> i
	}
}

// ---------------------------------------------------------------------------
// Cursor helpers
// ---------------------------------------------------------------------------
fn cursor_get_row( -- row:i64) {
	hw::cursor_row_addr 0 sys::ld64
}

fn cursor_get_col( -- col:i64) {
	hw::cursor_col_addr 0 sys::ld64
}

fn cursor_set(row:i64 col:i64 -- ) {
	hw::cursor_row_addr 0 row sys::st64
	hw::cursor_col_addr 0 col sys::st64
}

fn cursor_advance() {
	cursor_get_row -> row
	cursor_get_col -> col
	col 1 + -> col
	col VGA_COLS >= if {
		0 -> col
		row 1 + -> row
	}
	row VGA_ROWS >= if {
		vga_scroll
		VGA_ROWS 1 - -> row
	}
	row col cursor_set
}

fn cursor_newline() {
	cursor_get_row 1 + -> row
	row VGA_ROWS >= if {
		vga_scroll
		VGA_ROWS 1 - -> row
	}
	row 0 cursor_set
}

// ---------------------------------------------------------------------------
// GDT setup
// ---------------------------------------------------------------------------
fn gdt_set_entry(base:i64 idx:i64 seg_base:i64 seg_limit:i64 access:i64 flags:i64 -- ) {
	base idx 8 * + -> off
	off 0 + 0 seg_limit 0xFF and sys::st8
	off 1 + 0 seg_limit 8 shr 0xFF and sys::st8
	off 2 + 0 seg_base 0xFF and sys::st8
	off 3 + 0 seg_base 8 shr 0xFF and sys::st8
	off 4 + 0 seg_base 16 shr 0xFF and sys::st8
	off 5 + 0 access sys::st8
	off 6 + 0 seg_limit 16 shr 0x0F and flags 4 shl or sys::st8
	off 7 + 0 seg_base 24 shr 0xFF and sys::st8
}

fn setup_gdt() {
	hw::gdt_addr -> gdt
	hw::gdt_desc_addr -> desc
	gdt 0 0 0 0 0 gdt_set_entry
	gdt 1 0 0xFFFFF 0x9A 0x0A gdt_set_entry
	gdt 2 0 0xFFFFF 0x92 0x0A gdt_set_entry
	desc 0 23 sys::st16
	desc 2 + 0 gdt sys::st64
	desc hw::lgdt
}

// ---------------------------------------------------------------------------
// IDT setup (x86_64: 16-byte entries)
// ---------------------------------------------------------------------------
fn idt_set_entry(base:i64 idx:i64 handler:i64 selector:i64 type_attr:i64 -- ) {
	base idx 16 * + -> off
	off 0 + 0 handler 0xFFFF and sys::st16
	off 2 + 0 selector sys::st16
	off 4 + 0 0 sys::st8
	off 5 + 0 type_attr sys::st8
	off 6 + 0 handler 16 shr 0xFFFF and sys::st16
	off 8 + 0 handler 32 shr 0xFFFFFFFF and sys::st32
	off 12 + 0 0 sys::st32
}

fn setup_idt() {
	hw::idt_addr -> idt
	hw::idt_desc_addr -> desc
	hw::isr_table_addr -> isrs
	0 -> i
	loop {
		i 48 >= if { break }
		isrs i 8 * sys::ld64 -> handler
		idt i handler SEG_KCODE IDT_PRESENT_INT32 idt_set_entry
		i 1 + -> i
	}
	desc 0 4095 sys::st16
	desc 2 + 0 idt sys::st64
	desc hw::lidt
}

// ---------------------------------------------------------------------------
// PIC remapping
// ---------------------------------------------------------------------------
fn remap_pic() {
	PIC1_CMD ICW1_INIT sys::port_out8
	PIC2_CMD ICW1_INIT sys::port_out8
	PIC1_DATA 32 sys::port_out8
	PIC2_DATA 40 sys::port_out8
	PIC1_DATA 4 sys::port_out8
	PIC2_DATA 2 sys::port_out8
	PIC1_DATA ICW4_8086 sys::port_out8
	PIC2_DATA ICW4_8086 sys::port_out8
	PIC1_DATA 0xFC sys::port_out8
	PIC2_DATA 0xFF sys::port_out8
}

// ---------------------------------------------------------------------------
// Interrupt handler
// ---------------------------------------------------------------------------
pub fn handle_interrupt() {
	hw::int_num_addr 0 sys::ld64 -> int_no
	int_no 32 == if { handle_timer }
	int_no 33 == if { handle_keyboard }
	int_no 40 >= if { PIC2_CMD PIC_EOI sys::port_out8 }
	int_no 32 >= if { PIC1_CMD PIC_EOI sys::port_out8 }
}

// ---------------------------------------------------------------------------
// Timer
// ---------------------------------------------------------------------------
fn handle_timer() {
	hw::tick_addr -> addr
	addr 0 sys::ld64 1 + -> ticks
	addr 0 ticks sys::st64
}

// ---------------------------------------------------------------------------
// Keyboard
// ---------------------------------------------------------------------------
fn scancode_to_ascii(sc:i64 -- ch:i64) {
	sc 0x02 == if { 49 return }
	sc 0x03 == if { 50 return }
	sc 0x04 == if { 51 return }
	sc 0x05 == if { 52 return }
	sc 0x06 == if { 53 return }
	sc 0x07 == if { 54 return }
	sc 0x08 == if { 55 return }
	sc 0x09 == if { 56 return }
	sc 0x0A == if { 57 return }
	sc 0x0B == if { 48 return }
	sc 0x0C == if { 45 return }
	sc 0x0D == if { 61 return }
	sc 0x10 == if { 113 return }
	sc 0x11 == if { 119 return }
	sc 0x12 == if { 101 return }
	sc 0x13 == if { 114 return }
	sc 0x14 == if { 116 return }
	sc 0x15 == if { 121 return }
	sc 0x16 == if { 117 return }
	sc 0x17 == if { 105 return }
	sc 0x18 == if { 111 return }
	sc 0x19 == if { 112 return }
	sc 0x1E == if { 97 return }
	sc 0x1F == if { 115 return }
	sc 0x20 == if { 100 return }
	sc 0x21 == if { 102 return }
	sc 0x22 == if { 103 return }
	sc 0x23 == if { 104 return }
	sc 0x24 == if { 106 return }
	sc 0x25 == if { 107 return }
	sc 0x26 == if { 108 return }
	sc 0x27 == if { 59 return }
	sc 0x2C == if { 122 return }
	sc 0x2D == if { 120 return }
	sc 0x2E == if { 99 return }
	sc 0x2F == if { 118 return }
	sc 0x30 == if { 98 return }
	sc 0x31 == if { 110 return }
	sc 0x32 == if { 109 return }
	sc 0x33 == if { 44 return }
	sc 0x34 == if { 46 return }
	sc 0x35 == if { 47 return }
	sc 0x39 == if { 32 return }
	0
}

fn handle_keyboard() {
	0x60 sys::port_in8 -> scancode
	scancode 0x80 and 0 != if { return }

	// Backspace
	scancode SC_BACKSPACE == if {
		cursor_get_row -> row
		cursor_get_col -> col
		col 0 > if {
			col 1 - -> col
			row col 32 vga_put
			row col cursor_set
		}
		return
	}

	// Enter
	scancode SC_ENTER == if {
		cursor_newline
		print_prompt
		return
	}

	scancode scancode_to_ascii -> ch
	ch 0 == if { return }

	cursor_get_row -> row
	cursor_get_col -> col
	row col ch vga_put
	cursor_advance
}

// ---------------------------------------------------------------------------
// Prompt
// ---------------------------------------------------------------------------
fn print_prompt() {
	cursor_get_row -> row
	cursor_get_col -> col
	row col 62 vga_put
	col 1 + -> col
	row col 32 vga_put
	col 1 + col cursor_get_row swap cursor_set
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------
fn _start() {
	sys::cli
	vga_clear
	setup_gdt
	setup_idt
	remap_pic

	// Banner
	0xB8000 0  0x0F48 sys::st16
	0xB8000 2  0x0F65 sys::st16
	0xB8000 4  0x0F6C sys::st16
	0xB8000 6  0x0F6C sys::st16
	0xB8000 8  0x0F6F sys::st16
	0xB8000 10 0x0F2C sys::st16
	0xB8000 12 0x0F20 sys::st16
	0xB8000 14 0x0F51 sys::st16
	0xB8000 16 0x0F75 sys::st16
	0xB8000 18 0x0F61 sys::st16
	0xB8000 20 0x0F64 sys::st16
	0xB8000 22 0x0F72 sys::st16
	0xB8000 24 0x0F61 sys::st16
	0xB8000 26 0x0F74 sys::st16
	0xB8000 28 0x0F65 sys::st16
	0xB8000 30 0x0F20 sys::st16
	0xB8000 32 0x0F6B sys::st16
	0xB8000 34 0x0F65 sys::st16
	0xB8000 36 0x0F72 sys::st16
	0xB8000 38 0x0F6E sys::st16
	0xB8000 40 0x0F65 sys::st16
	0xB8000 42 0x0F6C sys::st16
	0xB8000 44 0x0F21 sys::st16

	// Prompt on row 2
	2 0 cursor_set
	print_prompt

	sys::sti
	loop { sys::hlt }
}
