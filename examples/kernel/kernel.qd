// Bare-metal x86_64 multiboot kernel with interrupt support.
// Demonstrates: GDT, IDT, PIC remapping, PIT timer, PS/2 keyboard.

use bits
use sys

// ---------------------------------------------------------------------------
// FFI: assembly helpers (interrupts.S)
// ---------------------------------------------------------------------------
import "interrupts.o" as "hw" {
	pub fn lgdt(addr:i64 --)
	pub fn lidt(addr:i64 --)
	pub fn gdt_addr( -- addr:i64)
	pub fn gdt_desc_addr( -- addr:i64)
	pub fn idt_addr( -- addr:i64)
	pub fn idt_desc_addr( -- addr:i64)
	pub fn isr_table_addr( -- addr:i64)
	pub fn int_num_addr( -- addr:i64)
	pub fn tick_addr( -- addr:i64)
	pub fn cursor_col_addr( -- addr:i64)
	pub fn cursor_row_addr( -- addr:i64)
}

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
const VGA_BASE = 0xB8000
const VGA_COLS = 80
const VGA_ROWS = 25
const ATTR_WHITE = 0x0F
const BLANK = 0x0F20

const PIC1_CMD = 0x20
const PIC1_DATA = 0x21
const PIC2_CMD = 0xA0
const PIC2_DATA = 0xA1
const PIC_EOI = 0x20
const ICW1_INIT = 0x11
const ICW4_8086 = 0x01

const SEG_KCODE = 0x08
const IDT_PRESENT_INT32 = 0x8E

// Scancodes
const SC_BACKSPACE = 0x0E
const SC_ENTER = 0x1C

// ---------------------------------------------------------------------------
// VGA text mode: 80x25 cells of a character byte and an attribute byte
// ---------------------------------------------------------------------------
fn at(row:i64 col:i64 -- i:i64) { swap VGA_COLS * + }
fn cell(i:i64 -- addr:i64) { 2 * VGA_BASE + }
fn vga_put(row:i64 col:i64 ch:i64 -- ) { rrot at cell tuck 0 rot sys::st8 1 ATTR_WHITE sys::st8 }
fn blank(i:i64 -- ) { cell 0 BLANK sys::st16 }
fn vga_clear() { 0 VGA_COLS VGA_ROWS * fn { dup blank 1 + } times drop }

// The cell a row below, moved up into this one
fn lift(i:i64 -- ) { dup VGA_COLS + cell 0 sys::ld16 swap cell 0 rot sys::st16 }
fn vga_scroll() {
	0 VGA_COLS VGA_ROWS 1 - * fn { dup lift 1 + } times drop
	VGA_ROWS 1 - VGA_COLS * VGA_COLS fn { dup blank 1 + } times drop
}

// ---------------------------------------------------------------------------
// Cursor, kept where the interrupt stubs can see it
// ---------------------------------------------------------------------------
fn cursor_get_row( -- row:i64) { hw::cursor_row_addr 0 sys::ld64 }
fn cursor_get_col( -- col:i64) { hw::cursor_col_addr 0 sys::ld64 }
fn cursor( -- row:i64 col:i64) { cursor_get_row cursor_get_col }
fn cursor_set(row:i64 col:i64 -- ) { hw::cursor_col_addr 0 rot sys::st64 hw::cursor_row_addr 0 rot sys::st64 }

// A row past the last scrolls the screen up, and is the last
fn on_screen(row:i64 -- row:i64) { dup VGA_ROWS >= if { drop vga_scroll VGA_ROWS 1 - } }
fn cursor_advance() { cursor 1 + dup VGA_COLS >= if { drop 1 + 0 } swap on_screen swap cursor_set }
fn cursor_newline() { cursor_get_row 1 + on_screen 0 cursor_set }

// ---------------------------------------------------------------------------
// Descriptor tables. Each entry is built as the 64-bit words it is, and the
// table's pointer is its size less one and its address.
// ---------------------------------------------------------------------------
fn table_pointer(table:i64 size:i64 desc:i64 -- desc:i64) { tuck 0 rot sys::st16 tuck 2 + 0 rot sys::st64 }

// A GDT segment descriptor: limit 0-15, base 0-23, access, limit 16-19 with the flags, base 24-31
fn limit_bits(limit:i64 -- d:i64) { dup 0xFFFF bits::and swap 16 bits::shr 0x0F bits::and 48 bits::shl bits::or }
fn base_bits(base:i64 -- d:i64) { dup 0xFFFFFF bits::and 16 bits::shl swap 24 bits::shr 0xFF bits::and 56 bits::shl bits::or }
fn descriptor(base:i64 limit:i64 access:i64 flags:i64 -- d:i64) { 52 bits::shl swap 40 bits::shl bits::or rot base_bits bits::or swap limit_bits bits::or }
fn gdt_entry(gdt:i64 idx:i64 d:i64 -- ) { rrot 8 * + 0 rot sys::st64 }

fn setup_gdt() {
	hw::gdt_addr
	dup 0 0 0 0 0 descriptor gdt_entry
	dup 1 0 0xFFFFF 0x9A 0x0A descriptor gdt_entry
	dup 2 0 0xFFFFF 0x92 0x0A descriptor gdt_entry
	23 hw::gdt_desc_addr table_pointer hw::lgdt
}

// An x86_64 interrupt gate, 16 bytes: offset 0-15, selector, type, offset 16-31; then offset 32-63
fn gate_low(handler:i64 -- d:i64) {
	dup 0xFFFF bits::and swap 16 bits::shr 0xFFFF bits::and 48 bits::shl bits::or
	SEG_KCODE 16 bits::shl bits::or IDT_PRESENT_INT32 40 bits::shl bits::or
}
fn gate_high(handler:i64 -- d:i64) { 32 bits::shr 0xFFFFFFFF bits::and }
fn idt_entry(handler:i64 addr:i64 -- ) { over gate_low over 0 rot sys::st64 swap gate_high swap 8 + 0 rot sys::st64 }

fn setup_idt() {
	0 48 fn { dup hw::isr_table_addr swap 8 * sys::ld64 over 16 * hw::idt_addr + idt_entry 1 + } times drop
	hw::idt_addr 4095 hw::idt_desc_addr table_pointer hw::lidt
}

// ---------------------------------------------------------------------------
// PIC remapping
// ---------------------------------------------------------------------------
fn remap_pic() {
	PIC1_CMD ICW1_INIT sys::outb
	PIC2_CMD ICW1_INIT sys::outb
	PIC1_DATA 32 sys::outb
	PIC2_DATA 40 sys::outb
	PIC1_DATA 4 sys::outb
	PIC2_DATA 2 sys::outb
	PIC1_DATA ICW4_8086 sys::outb
	PIC2_DATA ICW4_8086 sys::outb
	PIC1_DATA 0xFC sys::outb
	PIC2_DATA 0xFF sys::outb
}

// ---------------------------------------------------------------------------
// Interrupt handler
// ---------------------------------------------------------------------------
pub fn handle_interrupt() {
	hw::int_num_addr 0 sys::ld64
	dup 32 == if { handle_timer }
	dup 33 == if { handle_keyboard }
	dup 40 >= if { PIC2_CMD PIC_EOI sys::outb }
	32 >= if { PIC1_CMD PIC_EOI sys::outb }
}

// ---------------------------------------------------------------------------
// Timer
// ---------------------------------------------------------------------------
fn handle_timer() { hw::tick_addr 0 over 0 sys::ld64 1 + sys::st64 }

// ---------------------------------------------------------------------------
// Keyboard
// ---------------------------------------------------------------------------
fn ascii(sc:i64 -- ch:i64) {
	switch {
		0x02 { 49 }
		0x03 { 50 }
		0x04 { 51 }
		0x05 { 52 }
		0x06 { 53 }
		0x07 { 54 }
		0x08 { 55 }
		0x09 { 56 }
		0x0A { 57 }
		0x0B { 48 }
		0x0C { 45 }
		0x0D { 61 }
		0x10 { 113 }
		0x11 { 119 }
		0x12 { 101 }
		0x13 { 114 }
		0x14 { 116 }
		0x15 { 121 }
		0x16 { 117 }
		0x17 { 105 }
		0x18 { 111 }
		0x19 { 112 }
		0x1E { 97 }
		0x1F { 115 }
		0x20 { 100 }
		0x21 { 102 }
		0x22 { 103 }
		0x23 { 104 }
		0x24 { 106 }
		0x25 { 107 }
		0x26 { 108 }
		0x27 { 59 }
		0x2C { 122 }
		0x2D { 120 }
		0x2E { 99 }
		0x2F { 118 }
		0x30 { 98 }
		0x31 { 110 }
		0x32 { 109 }
		0x33 { 44 }
		0x34 { 46 }
		0x35 { 47 }
		0x39 { 32 }
		_ { 0 }
	}
}

fn backspace() { cursor dup 0 > if { 1 - dup2 32 vga_put cursor_set } else { drop2 } }
fn type_char(ch:i64 -- ) { cursor rot vga_put cursor_advance }

fn key(sc:i64 -- ) {
	dup switch {
		SC_BACKSPACE { drop backspace }
		SC_ENTER { drop cursor_newline print_prompt }
		_ { ascii dup 0 == if { drop } else { type_char } }
	}
}

// A key's release has the high bit set, and is not a key
fn handle_keyboard() { 0x60 sys::inb dup 0x80 bits::and 0 == if { key } else { drop } }

// ---------------------------------------------------------------------------
// Prompt and banner
// ---------------------------------------------------------------------------
fn print_prompt() { cursor dup2 62 vga_put 1 + dup2 32 vga_put 1 + cursor_set }

// A character of the top row, at col, and the next col
fn say(col:i64 ch:i64 -- col:i64) { over 0 swap rot vga_put 1 + }

fn banner() {
	0 72 say 101 say 108 say 108 say 111 say 44 say 32 say
	81 say 117 say 97 say 100 say 114 say 97 say 116 say 101 say 32 say
	107 say 101 say 114 say 110 say 101 say 108 say 33 say drop
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------
fn _start() {
	sys::cli
	vga_clear
	setup_gdt
	setup_idt
	remap_pic
	banner

	// Prompt on row 2
	2 0 cursor_set
	print_prompt

	sys::sti
	loop { sys::hlt }
}
