// Threading example - demonstrates concurrent execution
use thread

fn alpha() {
	0 10 1 for it {
		10 thread::sleep
		"alpha" print nl
	}
}

fn bravo() {
	0 10 1 for it {
		25 thread::sleep
		"bravo" print nl
	}
}

fn main() {
	// Spawn two threads
	&alpha thread::spawn! -> t1
	&bravo thread::spawn! -> t2

	// Wait for both to complete
	t1 join!
	t2 join!

	"done" print nl
}
