// Threading example - demonstrates concurrent execution
use thread

fn alpha() {
	10 fn {
		10 thread::sleep
		"alpha" print nl
	} times
}

fn bravo() {
	10 fn {
		25 thread::sleep
		"bravo" print nl
	} times
}

fn main() {
	// Spawn two threads, then wait for both to complete, the first first
	&alpha thread::spawn! &bravo thread::spawn!
	swap join! join!

	"done" print nl
}
