// Falcon 9 3D Rocket Simulation - Realtime Display
// Earth-Centered Inertial (ECI) coordinate system
//
// Uses directory-based namespace: all .qd files in this directory
// are automatically merged (no explicit imports needed)
use fmt
use io
use math
use strings
use term
use time

// Cursor control escape codes
const CursorUp2 = "\x1b[2A"
const ClearLine = "\x1b[K"
// Simulation speed: real milliseconds per simulated second
const MsPerSimSec = 50
// Update interval in simulated seconds
const PrintInterval = 10
const PrintIntervalF = 10.0
const Payload = 15000.0

// Stage 1: 9 Merlin 1D engines
var stage1 = Stage {
	dry_mass = 22200.0
	fuel_mass = 395700.0
	eng = Engine {
		thrust = 845000.0
		isp_vac = 311.0
		isp_sl = 282.0
		mass = 470.0
	}
	eng_count = 9.0
	diameter = 3.7
	cd = 0.3
}

// Stage 2: Merlin Vacuum
var stage2 = Stage {
	dry_mass = 4000.0
	fuel_mass = 107500.0
	eng = Engine {
		thrust = 981000.0
		isp_vac = 348.0
		isp_sl = 200.0
		mass = 490.0
	}
	eng_count = 1.0
	diameter = 3.7
	cd = 0.3
}

// The vehicle, and when the display last showed it
var state = State {
	t = 0.0
	pos = math::Vec3 { x = 0.0 y = 0.0 z = 0.0 }
	vel = math::Vec3 { x = 0.0 y = 0.0 z = 0.0 }
	mass = 0.0
	fuel = 0.0
	pitch = 0.0
}
var last_display:f64 = 0.0
var first_print:i64 = 1

fn at_most(x:f64 hi:f64 -- x:f64) { dup2 > if { nip } else { drop } }
fn at_least(x:f64 lo:f64 -- x:f64) { dup2 < if { nip } else { drop } }
fn set_pitch(p:f64 -- ) { state swap >>pitch drop }

// ---------------------------------------------------------------------------
// Display
// ---------------------------------------------------------------------------

fn bar(filled:i64 rest:i64 -- s:str) { "-" swap strings::repeat swap "#" swap strings::repeat swap strings::concat "[" swap strings::concat "]" strings::concat }

// A bar of width cells, pct percent of them filled
fn progress_bar(pct:f64 width:f64 -- bar:str) {
	swap over * 100.0 / math::floor 0.0 at_least over at_most
	swap over - cast<i64> swap cast<i64> swap bar
}

fn header(msg:str -- ) { nl term::Bold print term::BrightYellow print "=== " print print " ===" print term::Reset print nl nl }
fn alt_color(km:f64 -- ) { dup 100.0 < if { term::Yellow print } 100.0 >= if { term::Green print } }
fn fuel_color(pct:f64 -- ) { dup 20.0 < if { term::Red print } dup 20.0 >= over 50.0 < and if { term::Yellow print } 50.0 >= if { term::Green print } }

// Stage, time, altitude, velocity and pitch
fn flight_line(name:str -- ) {
	first_print 0 == if { CursorUp2 print }
	"\r" print term::Bold print term::Cyan print print term::Reset print
	state <<t "  T+%5.0fs" fmt::sprintf print
	" | Alt: " print state altitude 1000.0 / dup alt_color "%6.1f km" fmt::sprintf print term::Reset print
	" | Vel: " print term::BrightWhite print state speed "%5.0f m/s" fmt::sprintf print term::Reset print
	" | Pitch: " print state <<pitch math::rad_to_deg "%4.1f deg" fmt::sprintf print
	ClearLine print nl
}

// The fuel left, of max_fuel, as a bar
fn fuel_line(max_fuel:f64 -- ) {
	state <<fuel swap / 100.0 *
	"       Fuel: " print dup fuel_color dup 20.0 progress_bar print term::Reset print
	state <<fuel 1000.0 / " %5.1f%% (%5.1f t)" fmt::printf
	ClearLine print io::flush
}

// Every PrintInterval simulated seconds, the telemetry, then a pause for the realtime effect
fn show(name:str max_fuel:f64 -- ) {
	state <<t last_display - PrintIntervalF >= if {
		swap flight_line fuel_line
		0 -> first_print
		state <<t -> last_display
		MsPerSimSec PrintInterval * time::Millisecond * time::sleep
	} else {
		drop2
	}
}

// T+, altitude and velocity, under a title
fn event(format:str -- ) {
	nl term::Bold print term::BrightRed print
	fn { state <<t state altitude 1000.0 / state speed } dip fmt::sprintf print
	term::Reset print nl
}

// ---------------------------------------------------------------------------
// Flight
// ---------------------------------------------------------------------------

fn fly(stage:Stage -- ) { state step -> state }

// Stage 1: pitch over from 90 degrees after 1 km, by 80 degrees over the next 60 km, to no less than 10
fn gravity_turn() {
	state altitude dup 1000.0 > if { 1000.0 - 60000.0 / 80.0 * 90.0 swap - 10.0 at_least math::deg_to_rad set_pitch } else { drop }
}

fn stage1_burn() {
	loop {
		state <<fuel 0.0 > state <<t 300.0 <= and while
		gravity_turn
		stage1 fly
		"S1" stage1 <<fuel_mass show
	}
}

// Stage 2 above 80 km: pitch for the vertical acceleration that brings the radial velocity to
// zero at burnout, between 5 and 45 degrees
fn radial_velocity( -- v:f64) { state <<pos normalize state <<vel dot }
fn engine_accel( -- a:f64) { stage2 <<eng <<thrust state <<mass / }
fn local_g( -- g:f64) { MuEarth state <<pos length dup * / }

fn time_left( -- t:f64) {
	state <<fuel stage2 <<eng dup <<thrust swap <<isp_vac G0 * / / 10.0 at_least
}

fn guidance() {
	state altitude 80000.0 > if {
		engine_accel
		radial_velocity -1.0 * time_left / local_g +
		over at_most over -1.0 * at_least
		swap / 1.0 at_most -1.0 at_least math::asin
		5.0 math::deg_to_rad at_least 45.0 math::deg_to_rad at_most
		set_pitch
	}
}

fn stage2_burn() {
	loop {
		state <<fuel 0.0 > state <<t 700.0 <= and while
		guidance
		stage2 fly
		"S2" stage2 <<fuel_mass show
	}
}

// ---------------------------------------------------------------------------
// Orbit analysis
// ---------------------------------------------------------------------------

fn horizontal_velocity( -- v:f64) { state <<vel length dup * radial_velocity dup * - math::sqrt }
fn apo( -- m:f64) { state apoapsis }
fn peri( -- m:f64) { state periapsis }
fn inc_deg( -- d:f64) { state inclination math::rad_to_deg }
fn warn(msg:str color:str -- ) { print print term::Reset print nl }

fn orbit_status() {
	peri 100000.0 > if {
		term::Bold print "*** STABLE ORBIT ACHIEVED! ***" term::BrightGreen warn
		term::Green print
		apo 1000.0 / peri 1000.0 / inc_deg "Orbit: %.0f x %.0f km @ %.1f deg" fmt::sprintf print
		term::Reset print nl
	}
	peri 100000.0 <= apo 0.0 >= and if {
		peri 0.0 > if { "WARNING: Periapsis in atmosphere" term::BrightYellow warn }
		peri 0.0 <= if { "WARNING: Suborbital trajectory!" term::BrightRed warn }
	}
	apo 0.0 < if { "Escape trajectory - no orbit" term::BrightYellow warn }
}

fn orbit_analysis() {
	nl term::Bold print term::BrightMagenta print "=== ORBIT ANALYSIS ===" print term::Reset print nl nl
	term::Dim print
	horizontal_velocity "Horizontal velocity: %.0f m/s\n" fmt::printf
	radial_velocity "Radial velocity: %.0f m/s\n" fmt::printf
	term::Reset print nl
	state eccentricity "Eccentricity: %.4f\n" fmt::printf
	inc_deg "Inclination: %.2f deg\n" fmt::printf
	nl
	apo 0.0 < if {
		"ESCAPE TRAJECTORY" term::BrightYellow warn
	} else {
		apo 1000.0 / "Apoapsis: %.1f km\n" fmt::printf
		peri 1000.0 / "Periapsis: %.1f km\n" fmt::printf
	}
	nl
	orbit_status
	nl
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

fn launch_mass( -- m:f64) { stage1 stage_wet stage2 stage_wet + Payload + }

fn main() {
	term::Bold print term::BrightCyan print "=== Falcon 9 3D Simulation ===" print term::Reset print nl
	term::Dim print "Earth-Centered Inertial coordinates | Realtime display" print term::Reset print nl nl

	stage1 stage_thrust 1000.0 / "Stage 1: %.0f kN (9x Merlin 1D)\n" fmt::printf
	stage2 stage_thrust 1000.0 / "Stage 2: %.0f kN (1x Merlin Vac)\n" fmt::printf
	nl
	launch_mass 1000.0 / "Launch mass: %.1f tons" fmt::sprintf print nl
	EarthRotVel "Earth rotation boost: %.1f m/s" fmt::sprintf print nl

	// On the equator at +X, moving in +Y with the Earth's rotation, pointing straight up
	0.0 EarthRadius 0.0 0.0 math::Vec3 0.0 EarthRotVel 0.0 math::Vec3 launch_mass stage1 <<fuel_mass 90.0 math::deg_to_rad State
	-> state

	"STAGE 1 IGNITION" header
	stage1_burn
	"T+%.0fs  === MECO ===  Alt: %.1f km  Vel: %.0f m/s" event
	time::Second 2 * time::sleep

	"STAGE SEPARATION" header
	state state <<mass stage1 stage_dry - >>mass stage2 <<fuel_mass >>fuel drop
	time::Second time::sleep

	"STAGE 2 IGNITION" header
	0.0 -> last_display
	1 -> first_print
	stage2_burn
	"T+%.0fs  === SECO ===  Alt: %.1f km  Vel: %.0f m/s" event
	time::Second 2 * time::sleep

	orbit_analysis
}
