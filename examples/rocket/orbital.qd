// Orbital mechanics analysis
// (uses directory-based namespace - no explicit local imports needed)
use math

// Specific orbital energy: v²/2 - μ/r
fn orbital_energy(state:State -- energy:f64) { dup <<vel length dup * 2.0 / swap <<pos length MuEarth swap / - }

// |(v × (r × v)) / μ - r / |r||
fn eccentricity(state:State -- ecc:f64) {
	dup <<pos swap <<vel    // r v
	over over cross         // r v h
	cross 1.0 MuEarth / scale
	swap normalize subtract length
}

fn semi_major(state:State -- a:f64) { orbital_energy dup 0.0 >= if { drop -1.0 } else { MuEarth swap -2.0 * / } }

pub fn apoapsis(state:State -- alt:f64) {
	dup eccentricity dup 1.0 >= if { drop2 -1.0 } else { swap semi_major swap 1.0 swap + * EarthRadius - }
}

pub fn periapsis(state:State -- alt:f64) {
	dup eccentricity swap semi_major dup 0.0 < if { drop2 -1.0 } else { swap 1.0 swap - * EarthRadius - }
}

pub fn inclination(state:State -- inc:f64) { fn { <<pos } fn { <<vel } bi cross dup <<z swap length / math::acos }
