// Engine and Stage definitions
struct Engine {
	thrust:  f64
	isp_vac: f64
	isp_sl:  f64
	mass:    f64
}

struct Stage {
	dry_mass:  f64
	fuel_mass: f64
	eng:       Engine
	eng_count: f64
	diameter:  f64
	cd:        f64
}

pub fn stage_thrust(s:Stage -- t:f64) { fn { <<eng <<thrust } fn { <<eng_count } bi * }

// The stage's own mass and its engines', with and without its fuel
pub fn stage_dry(s:Stage -- m:f64) { dup <<dry_mass over <<eng <<mass rot <<eng_count * + }
pub fn stage_wet(s:Stage -- m:f64) { dup stage_dry swap <<fuel_mass + }
