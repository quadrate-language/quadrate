// Physics: atmosphere and derivatives
// (uses directory-based namespace - no explicit local imports needed)
use math

fn atm_density(alt:f64 -- rho:f64) {
	-> alt
	alt 0.0 < if {
		AtmRho0
	} else {
		alt AtmHeight >= if {
			0.0
		} else {
			alt AtmScale / -1.0 * math::exp AtmRho0 *
		}
	}
}

struct Deriv {
	dp: math::Vec3
	dv: math::Vec3
	dm: f64
}

pub fn compute_deriv(stage:Stage state:State -- d:Deriv) {
	-> state -> stage

	state @pos -> pos
	state @vel -> vel
	state @mass -> mass
	state @fuel -> fuel
	state @pitch -> pitch

	state altitude -> alt
	vel length -> vmag
	pos length -> r

	// Gravity: g = -mu/r³ * pos
	pos MuEarth r r * r * / -1.0 * scale -> g_accel

	// Up vector (normalized position)
	pos normalize -> up

	// Radial velocity component
	up vel dot -> v_rad

	// Horizontal velocity (perpendicular to radial)
	vel up v_rad scale subtract -> v_horiz
	v_horiz length -> h_mag

	// Thrust direction
	math::vec3_zero -> thrust_dir
	h_mag 0.001 > if {
		// East unit vector (horizontal direction)
		v_horiz normalize -> east
		// thrust = sin(pitch)*up + cos(pitch)*east
		up pitch math::sin scale
		east pitch math::cos scale
		add normalize -> thrust_dir
	} else {
		up -> thrust_dir
	}

	// Thrust acceleration
	math::vec3_zero -> thrust_accel
	fuel 0.0 > if {
		thrust_dir stage stage_thrust mass / scale -> thrust_accel
	}

	// Drag
	math::vec3_zero -> drag_accel
	alt atm_density -> rho
	vmag 0.001 > rho 0.0 > and if {
		stage @diameter 2.0 / -> rad
		math::Pi rad rad * * -> area
		0.5 rho * vmag vmag * * stage @cd * area * -> drag_mag
		vel normalize -> vel_unit
		vel_unit neg -> drag_dir
		drag_dir drag_mag mass / scale -> drag_accel
	}

	// Total acceleration
	g_accel thrust_accel add drag_accel add -> accel

	// Mass flow
	0.0 -> dm
	fuel 0.0 > if {
		stage @eng -> e
		stage stage_thrust e @isp_vac G0 * / -1.0 * -> dm
	}

	Deriv {
		dp = vel
		dv = accel
		dm = dm
	}
}
