// Physics: atmosphere and derivatives
// (uses directory-based namespace - no explicit local imports needed)
use math

fn atm_density(alt:f64 -- rho:f64) {
	dup 0.0 < if { drop AtmRho0 } else { dup AtmHeight >= if { drop 0.0 } else { AtmScale / -1.0 * math::exp AtmRho0 * } }
}

struct Deriv {
	dp: math::Vec3
	dv: math::Vec3
	dm: f64
}

// Gravity: -μ/r³ toward the centre
fn gravity(pos:math::Vec3 -- g:math::Vec3) { dup length dup dup * * MuEarth swap / -1.0 * scale }

// The velocity less its radial part
fn horizontal(pos:math::Vec3 vel:math::Vec3 -- vh:math::Vec3) { swap normalize tuck over dot rot swap scale subtract }

// sin(pitch) up and cos(pitch) east, or straight up while there is no east to speak of
fn thrust_dir(state:State -- dir:math::Vec3) {
	dup <<pos normalize swap
	dup <<pos over <<vel horizontal
	dup length 0.001 > if {
		normalize swap <<pitch
		rot over math::sin scale
		rrot math::cos scale add normalize
	} else {
		drop2
	}
}

fn thrust_accel(stage:Stage state:State -- a:math::Vec3) {
	dup <<fuel 0.0 > if { dup thrust_dir rot stage_thrust rot <<mass / scale } else { drop2 math::vec3_zero }
}

fn area(stage:Stage -- a:f64) { <<diameter 2.0 / dup * math::Pi swap * }

// ½ρv² Cd A
fn drag_force(stage:Stage rho:f64 vmag:f64 -- f:f64) { dup * swap 0.5 swap * swap * over <<cd * swap area * }

fn drag_accel(stage:Stage state:State -- a:math::Vec3) {
	dup altitude atm_density over <<vel length
	dup 0.001 > pick 0.0 > and if {
		fn { swap } dip2 drag_force swap
		dup <<vel normalize neg rot rot <<mass / scale
	} else {
		drop2 drop2 math::vec3_zero
	}
}

fn accel(stage:Stage state:State -- a:math::Vec3) {
	dup <<pos gravity rrot dup2 thrust_accel rrot drag_accel fn { add } dip add
}

fn mass_flow(stage:Stage state:State -- dm:f64) {
	<<fuel 0.0 > if { dup stage_thrust swap <<eng <<isp_vac G0 * / -1.0 * } else { drop 0.0 }
}

pub fn compute_deriv(stage:Stage state:State -- d:Deriv) { dup2 accel rrot dup2 mass_flow rot drop swap <<vel rrot Deriv }
