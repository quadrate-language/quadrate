// Euler integrator for simulation stepping
// (uses directory-based namespace - no explicit imports needed)

// Seconds simulated per step
const Dt = 0.1

// The state Dt later: each quantity advanced by its rate of change, the fuel never below empty
pub fn step(stage:Stage state:State -- new:State) {
	tuck compute_deriv swap clone
	dup <<t Dt + >>t
	dup <<pos pick <<dp Dt scale add >>pos
	dup <<vel pick <<dv Dt scale add >>vel
	dup <<mass pick <<dm Dt * + >>mass
	dup <<fuel pick <<dm Dt * + dup 0.0 < if { drop 0.0 } >>fuel
	nip
}
