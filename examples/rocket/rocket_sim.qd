// Rocket Physics Simulation
// Realistic physics for suborbital flight
// Uses RK4 (Runge-Kutta 4th order) integration

use math
use fmt

// ============================================================================
// Constants
// ============================================================================

const G = 6.67430e-11           // Gravitational constant (m³/(kg·s²))
const G0 = 9.80665              // Standard gravity (m/s²)
const EARTH_MASS = 5.972e24     // Earth mass (kg)
const EARTH_RADIUS = 6.371e6    // Earth radius (m)
const ATM_RHO0 = 1.225          // Sea level air density (kg/m³)
const ATM_SCALE = 8500.0        // Atmospheric scale height (m)
const ATM_HEIGHT = 100000.0     // Karman line (m)
const PI = 3.14159265359

// ============================================================================
// Vector Math (2D)
// ============================================================================

struct Vec2 {
    x:f64
    y:f64
}

fn vec2(x:f64 y:f64 -- v:Vec2) {
    -> y -> x
    Vec2 { x = x, y = y }
}

fn vec2_zero(-- v:Vec2) {
    Vec2 { x = 0.0, y = 0.0 }
}

fn vec2_add(a:Vec2 b:Vec2 -- c:Vec2) {
    -> b -> a
    a @x b @x + -> cx
    a @y b @y + -> cy
    Vec2 { x = cx, y = cy }
}

fn vec2_scale(v:Vec2 s:f64 -- r:Vec2) {
    -> s -> v
    v @x s * -> rx
    v @y s * -> ry
    Vec2 { x = rx, y = ry }
}

fn vec2_mag(v:Vec2 -- m:f64) {
    -> v
    v @x v @x * v @y v @y * + math::sqrt
}

fn vec2_normalize(v:Vec2 -- n:Vec2) {
    -> v
    v vec2_mag -> m
    m 0.0 > if {
        v 1.0 m / vec2_scale
    } else {
        vec2_zero
    }
}

// ============================================================================
// Celestial Body
// ============================================================================

struct Body {
    mass:f64
    radius:f64
    atm_height:f64
    atm_scale:f64
    atm_rho0:f64
}

fn earth(-- body:Body) {
    Body {
        mass = EARTH_MASS,
        radius = EARTH_RADIUS,
        atm_height = ATM_HEIGHT,
        atm_scale = ATM_SCALE,
        atm_rho0 = ATM_RHO0
    }
}

// ============================================================================
// Engine
// ============================================================================

struct Engine {
    thrust:f64
    isp_vac:f64
    isp_sl:f64
    engine_mass:f64
}

// Interpolate Isp based on altitude
fn engine_isp(e:Engine alt:f64 atm_h:f64 -- isp:f64) {
    -> atm_h -> alt -> e
    alt atm_h >= if {
        e @isp_vac
    } else {
        alt atm_h / -> ratio
        e @isp_sl e @isp_vac e @isp_sl - ratio * +
    }
}

// Merlin 1D (sea level, first stage)
fn merlin_1d(-- e:Engine) {
    Engine {
        thrust = 845000.0,
        isp_vac = 311.0,
        isp_sl = 282.0,
        engine_mass = 470.0
    }
}

// Merlin 1D Vacuum (second stage)
fn merlin_vac(-- e:Engine) {
    Engine {
        thrust = 981000.0,
        isp_vac = 348.0,
        isp_sl = 200.0,
        engine_mass = 490.0
    }
}

// ============================================================================
// Rocket Stage
// ============================================================================

struct Stage {
    name:str
    eng:Engine
    eng_count:i64
    dry_mass:f64
    fuel_mass:f64
    diameter:f64
    cd:f64
}

fn stage_total_thrust(s:Stage -- t:f64) {
    -> s
    s @eng -> e
    e @thrust s @eng_count 1.0 * *
}

fn stage_area(s:Stage -- a:f64) {
    -> s
    s @diameter 2.0 / -> r
    PI r r * *
}

fn stage_wet_mass(s:Stage -- m:f64) {
    -> s
    s @eng -> e
    s @dry_mass e @engine_mass s @eng_count 1.0 * * + s @fuel_mass +
}

fn stage_dry_mass(s:Stage -- m:f64) {
    -> s
    s @eng -> e
    s @dry_mass e @engine_mass s @eng_count 1.0 * * +
}

// Tsiolkovsky delta-v
fn stage_delta_v(s:Stage -- dv:f64) {
    -> s
    s stage_wet_mass -> m_wet
    s stage_dry_mass -> m_dry
    s @eng -> e
    // dv = Isp * g0 * ln(m_wet / m_dry)
    e @isp_vac G0 * m_wet m_dry / math::ln *
}

// ============================================================================
// Simulation State
// ============================================================================

struct State {
    time:f64
    px:f64
    py:f64
    vx:f64
    vy:f64
    mass:f64
    fuel:f64
    throttle:f64
    angle:f64
}

// ============================================================================
// Physics Functions
// ============================================================================

// Gravitational acceleration at altitude
fn gravity_accel(body:Body alt:f64 -- g:f64) {
    -> alt -> body
    body @radius alt + -> r
    G body @mass * r r * /
}

// Atmospheric density (exponential model)
fn atm_density(body:Body alt:f64 -- rho:f64) {
    -> alt -> body
    alt 0.0 < if {
        body @atm_rho0
    } else {
        alt body @atm_height >= if {
            0.0
        } else {
            alt body @atm_scale / -1.0 * math::exp body @atm_rho0 *
        }
    }
}

// ============================================================================
// Derivatives (for RK4)
// ============================================================================

// Derivative: dpx=vx, dpy=vy, dvx=ax, dvy=ay, dm=mass flow
struct Deriv {
    dpx:f64
    dpy:f64
    dvx:f64
    dvy:f64
    dm:f64
}

// Compute derivatives at a given state
fn compute_deriv(body:Body stage:Stage state:State -- d:Deriv) {
    -> state -> stage -> body

    state @py -> alt
    state @vx -> vx
    state @vy -> vy
    state @mass -> mass
    state @fuel -> fuel
    state @throttle -> throttle
    state @angle -> angle

    // Velocity magnitude
    vx vx * vy vy * + math::sqrt -> vmag

    // Gravity (negative y)
    body alt gravity_accel -> g
    0.0 -> gx
    g -1.0 * -> gy

    // Drag
    body alt atm_density -> rho
    0.0 -> drag_ax
    0.0 -> drag_ay
    vmag 0.0 > if {
        0.5 rho * vmag * vmag * stage @cd * stage stage_area * -> drag_mag
        vx vmag / -1.0 * drag_mag * mass / -> drag_ax
        vy vmag / -1.0 * drag_mag * mass / -> drag_ay
    }

    // Thrust
    0.0 -> thrust_ax
    0.0 -> thrust_ay
    fuel 0.0 > throttle 0.0 > and if {
        stage stage_total_thrust throttle * -> thrust_mag
        angle math::sin thrust_mag * mass / -> thrust_ax
        angle math::cos thrust_mag * mass / -> thrust_ay
    }

    // Net acceleration
    gx drag_ax + thrust_ax + -> ax
    gy drag_ay + thrust_ay + -> ay

    // Mass flow
    0.0 -> dm
    fuel 0.0 > throttle 0.0 > and if {
        stage @eng -> eng
        eng alt body @atm_height engine_isp -> isp
        stage stage_total_thrust throttle * isp G0 * / -1.0 * -> dm
    }

    Deriv {
        dpx = vx,
        dpy = vy,
        dvx = ax,
        dvy = ay,
        dm = dm
    }
}

// Apply derivative to state: state + deriv * dt
fn apply_deriv(state:State d:Deriv dt:f64 -- new:State) {
    -> dt -> d -> state

    state @px d @dpx dt * + -> new_px
    state @py d @dpy dt * + -> new_py
    state @vx d @dvx dt * + -> new_vx
    state @vy d @dvy dt * + -> new_vy
    state @mass d @dm dt * + -> new_mass
    state @fuel d @dm dt * + -> new_fuel

    new_fuel 0.0 < if { 0.0 -> new_fuel }

    State {
        time = state @time dt +,
        px = new_px,
        py = new_py,
        vx = new_vx,
        vy = new_vy,
        mass = new_mass,
        fuel = new_fuel,
        throttle = state @throttle,
        angle = state @angle
    }
}

// ============================================================================
// RK4 Integration
// ============================================================================

fn step_rk4(body:Body stage:Stage state:State dt:f64 -- new:State) {
    -> dt -> state -> stage -> body

    // k1 = f(t, y)
    body stage state compute_deriv -> k1

    // k2 = f(t + dt/2, y + k1*dt/2)
    state k1 dt 2.0 / apply_deriv -> s2
    body stage s2 compute_deriv -> k2

    // k3 = f(t + dt/2, y + k2*dt/2)
    state k2 dt 2.0 / apply_deriv -> s3
    body stage s3 compute_deriv -> k3

    // k4 = f(t + dt, y + k3*dt)
    state k3 dt apply_deriv -> s4
    body stage s4 compute_deriv -> k4

    // Combine: y_new = y + (k1 + 2*k2 + 2*k3 + k4) * dt/6
    dt 6.0 / -> dt6

    // Position
    k1 @dpx k2 @dpx 2.0 * + k3 @dpx 2.0 * + k4 @dpx + dt6 * -> dpx
    k1 @dpy k2 @dpy 2.0 * + k3 @dpy 2.0 * + k4 @dpy + dt6 * -> dpy

    // Velocity
    k1 @dvx k2 @dvx 2.0 * + k3 @dvx 2.0 * + k4 @dvx + dt6 * -> dvx
    k1 @dvy k2 @dvy 2.0 * + k3 @dvy 2.0 * + k4 @dvy + dt6 * -> dvy

    // Mass
    k1 @dm k2 @dm 2.0 * + k3 @dm 2.0 * + k4 @dm + dt6 * -> dm

    state @px dpx + -> new_px
    state @py dpy + -> new_py
    state @vx dvx + -> new_vx
    state @vy dvy + -> new_vy
    state @mass dm + -> new_mass
    state @fuel dm + -> new_fuel

    new_fuel 0.0 < if { 0.0 -> new_fuel }

    State {
        time = state @time dt +,
        px = new_px,
        py = new_py,
        vx = new_vx,
        vy = new_vy,
        mass = new_mass,
        fuel = new_fuel,
        throttle = state @throttle,
        angle = state @angle
    }
}

// ============================================================================
// Euler Integration (simpler, less accurate)
// ============================================================================

fn step_euler(body:Body stage:Stage state:State dt:f64 -- new:State) {
    -> dt -> state -> stage -> body
    body stage state compute_deriv -> d
    state d dt apply_deriv
}

// ============================================================================
// Utility
// ============================================================================

fn deg_to_rad(d:f64 -- r:f64) {
    -> d
    d PI * 180.0 /
}

fn twr(stage:Stage mass:f64 g:f64 -- ratio:f64) {
    -> g -> mass -> stage
    stage stage_total_thrust mass g * /
}

fn vel_mag(state:State -- v:f64) {
    -> state
    state @vx state @vx * state @vy state @vy * + math::sqrt
}

// ============================================================================
// Main Simulation (Two-Stage Falcon 9)
// ============================================================================

fn print_stage_info(s:Stage -- ) {
    -> s
    "  " print s @name print ":" print nl
    s stage_total_thrust 1000.0 / "    Thrust: %.0f kN\n" fmt::printf
    s @fuel_mass 1000.0 / "    Propellant: %.1f tons\n" fmt::printf
    s stage_wet_mass 1000.0 / "    Wet mass: %.1f tons\n" fmt::printf
    s stage_delta_v "    Delta-v: %.0f m/s\n" fmt::printf
}

fn main() {
    "=== Falcon 9 Two-Stage Simulation ===" print nl
    "RK4 integration with staging" print nl
    nl

    // Setup celestial body
    earth -> body

    // First stage: 9x Merlin 1D
    merlin_1d -> m1d
    Stage {
        name = "Stage 1",
        eng = m1d,
        eng_count = 9,
        dry_mass = 22200.0,
        fuel_mass = 395700.0,
        diameter = 3.7,
        cd = 0.3
    } -> stage1

    // Second stage: 1x Merlin Vacuum
    merlin_vac -> mvac
    Stage {
        name = "Stage 2",
        eng = mvac,
        eng_count = 1,
        dry_mass = 4000.0,
        fuel_mass = 107500.0,
        diameter = 3.7,
        cd = 0.4
    } -> stage2

    // Payload mass (Falcon 9 can lift ~15 tons to LEO)
    15000.0 -> payload

    // Stats
    "Vehicle Configuration:" print nl
    stage1 print_stage_info
    stage2 print_stage_info
    payload "  Payload: %.0f kg\n" fmt::printf
    nl

    // Total delta-v
    stage1 stage_delta_v stage2 stage_delta_v + "Total delta-v: %.0f m/s\n" fmt::printf
    nl

    // Initial state (includes both stages + payload)
    stage1 stage_wet_mass stage2 stage_wet_mass + payload + -> init_mass
    State {
        time = 0.0,
        px = 0.0,
        py = 0.0,
        vx = 0.0,
        vy = 0.0,
        mass = init_mass,
        fuel = stage1 @fuel_mass,
        throttle = 1.0,
        angle = 0.0
    } -> state

    stage1 init_mass body 0.0 gravity_accel twr "Initial TWR: %.2f\n" fmt::printf
    nl

    "=== Stage 1 Ignition ===" print nl

    // Simulation parameters
    0.1 -> dt
    0.0 -> last_print
    1 -> current_stage
    0 -> staged

    // Stage 1 burn
    loop {
        state @fuel 0.0 <= state @time 300.0 > or if { break }

        // Gravity turn - pitch over starting at 3km
        state @py 3000.0 > if {
            // More aggressive pitch: reach 65 deg by 70km
            state @py 3000.0 - 67000.0 / 65.0 * -> target_deg
            target_deg 65.0 > if { 65.0 -> target_deg }
            target_deg deg_to_rad -> new_angle

            State {
                time = state @time,
                px = state @px,
                py = state @py,
                vx = state @vx,
                vy = state @vy,
                mass = state @mass,
                fuel = state @fuel,
                throttle = state @throttle,
                angle = new_angle
            } -> state
        }

        body stage1 state dt step_rk4 -> state

        state @time last_print - 20.0 >= if {
            state @time state @py 1000.0 / state vel_mag state @fuel 1000.0 /
            "T+%.0fs [S1] Alt: %.1f km  Vel: %.0f m/s  Fuel: %.1f t\n" fmt::printf
            state @time -> last_print
        }
    }

    // MECO
    nl
    state @time state @py 1000.0 / state vel_mag
    "T+%.0fs  === MECO === Alt: %.1f km  Vel: %.0f m/s\n" fmt::printf

    // Stage separation - drop stage 1 dry mass
    state @mass stage1 stage_dry_mass - -> sep_mass
    nl
    "=== Stage Separation ===" print nl
    stage1 stage_dry_mass 1000.0 / "Jettisoned %.1f tons\n" fmt::printf
    nl
    "=== Stage 2 Ignition ===" print nl

    // Reset state for stage 2
    State {
        time = state @time,
        px = state @px,
        py = state @py,
        vx = state @vx,
        vy = state @vy,
        mass = sep_mass,
        fuel = stage2 @fuel_mass,
        throttle = 1.0,
        angle = state @angle
    } -> state

    stage2 sep_mass body state @py gravity_accel twr "Stage 2 TWR: %.2f\n" fmt::printf
    nl

    // Stage 2 burn
    loop {
        state @fuel 0.0 <= state @time 700.0 > or if { break }

        // Zero-vy guidance: pitch to achieve zero vertical velocity at burnout
        state @py 80000.0 > if {
            state @vy -> vy_now
            state @mass -> mass_now
            state @fuel -> fuel_now

            // Estimate time to burnout based on fuel remaining
            stage2 @eng -> eng2
            eng2 @thrust eng2 @isp_vac G0 * / -> mdot
            fuel_now mdot / -> t_remain
            t_remain 10.0 < if { 10.0 -> t_remain }  // Min 10s to avoid div by 0

            // Current thrust acceleration
            eng2 @thrust mass_now / -> accel

            // Gravity at current altitude
            body state @py gravity_accel -> g_now

            // To zero vy at burnout: a_vertical = (0 - vy) / t_remain + g
            // a_vertical = -vy / t_remain + g
            vy_now -1.0 * t_remain / g_now + -> a_vert_needed

            // Clamp vertical acceleration to available thrust
            a_vert_needed accel > if { accel -> a_vert_needed }
            a_vert_needed accel -1.0 * < if { accel -1.0 * -> a_vert_needed }

            // Horizontal acceleration from remaining thrust: sqrt(accel^2 - a_vert^2)
            accel accel * a_vert_needed a_vert_needed * - -> a_horiz_sq
            a_horiz_sq 0.0 < if { 0.0 -> a_horiz_sq }
            a_horiz_sq math::sqrt -> a_horiz

            // Pitch angle from vertical = atan2(a_horiz, a_vert)
            a_horiz a_vert_needed math::atan2 -> target_angle

            // Clamp to reasonable range
            target_angle 50.0 deg_to_rad < if { 50.0 deg_to_rad -> target_angle }
            target_angle 88.0 deg_to_rad > if { 88.0 deg_to_rad -> target_angle }

            State {
                time = state @time,
                px = state @px,
                py = state @py,
                vx = state @vx,
                vy = state @vy,
                mass = state @mass,
                fuel = state @fuel,
                throttle = state @throttle,
                angle = target_angle
            } -> state
        }

        body stage2 state dt step_rk4 -> state

        state @time last_print - 20.0 >= if {
            state @time state @py 1000.0 / state vel_mag state @fuel 1000.0 /
            "T+%.0fs [S2] Alt: %.1f km  Vel: %.0f m/s  Fuel: %.1f t\n" fmt::printf
            state @time -> last_print
        }
    }

    nl
    "=== SECO (Stage 2 Engine Cutoff) ===" print nl
    state @time state @py 1000.0 / state vel_mag
    "T+%.0fs  Alt: %.1f km  Vel: %.0f m/s\n" fmt::printf
    nl

    // Orbital analysis
    "Orbit Analysis:" print nl
    state @py 1000.0 / "  Current altitude: %.1f km\n" fmt::printf
    state @px 1000.0 / "  Downrange: %.1f km\n" fmt::printf
    state vel_mag -> final_vel
    final_vel "  Velocity: %.0f m/s\n" fmt::printf
    state @vx "  Horizontal (vx): %.0f m/s\n" fmt::printf
    state @vy "  Vertical (vy): %.0f m/s\n" fmt::printf
    nl

    // Orbital parameters
    body state orbital_energy -> energy
    energy 1000000.0 / "  Specific orbital energy: %.2f MJ/kg\n" fmt::printf

    body state eccentricity -> ecc
    ecc "  Eccentricity: %.4f\n" fmt::printf

    body state apoapsis -> apo
    body state periapsis -> peri

    apo 0.0 < if {
        "  Trajectory: ESCAPE (hyperbolic)" print nl
        body state @py escape_velocity -> v_esc
        final_vel v_esc / 100.0 * "  Velocity is %.1f%% of escape velocity\n" fmt::printf
    } else {
        apo 1000.0 / "  Apoapsis: %.1f km\n" fmt::printf
        peri 1000.0 / "  Periapsis: %.1f km\n" fmt::printf
        body state orbital_period -> period
        period 60.0 / "  Orbital period: %.1f minutes\n" fmt::printf

        // Check if orbit is valid (periapsis above surface)
        peri 100000.0 > if {
            nl
            "*** STABLE ORBIT ACHIEVED! ***" print nl
            apo 1000.0 / peri 1000.0 / "Orbit: %.0f x %.0f km\n" fmt::printf
        } else {
            peri 0.0 > if {
                nl
                "WARNING: Periapsis in atmosphere (%.0f km)" print nl
                peri 1000.0 / "Orbit will decay due to drag.\n" fmt::printf
            } else {
                nl
                "WARNING: Suborbital trajectory!" print nl
                "Vehicle will impact Earth." print nl
            }
        }
    }
}

// Orbital velocity for circular orbit
fn orbital_velocity(body:Body alt:f64 -- v:f64) {
    -> alt -> body
    body @radius alt + -> r
    G body @mass * r / math::sqrt
}

// Escape velocity at altitude
fn escape_velocity(body:Body alt:f64 -- v:f64) {
    -> alt -> body
    body @radius alt + -> r
    2.0 G * body @mass * r / math::sqrt
}

// Specific orbital energy (negative = bound orbit)
fn orbital_energy(body:Body state:State -- energy:f64) {
    -> state -> body
    state @vx state @vx * state @vy state @vy * + -> v2
    body @radius state @py + -> r
    G body @mass * -> mu
    v2 2.0 / mu r / -
}

// Semi-major axis from orbital energy
fn semi_major_axis(body:Body energy:f64 -- a:f64) {
    -> energy -> body
    G body @mass * -> mu
    mu -1.0 * 2.0 energy * /
}

// Specific angular momentum (simplified 2D)
fn angular_momentum(body:Body state:State -- h:f64) {
    -> state -> body
    body @radius state @py + -> r
    // h = r * v_tangential (horizontal velocity)
    // For more accuracy, h = |r × v| = r*vx - 0 (since we measure from surface)
    r state @vx * math::abs
}

// Calculate eccentricity
fn eccentricity(body:Body state:State -- e:f64) {
    -> state -> body
    body state orbital_energy -> energy
    body state angular_momentum -> h
    G body @mass * -> mu

    // e = sqrt(1 + 2*energy*h²/μ²)
    2.0 energy * h * h * mu mu * / 1.0 + -> e2
    e2 0.0 > if {
        e2 math::sqrt
    } else {
        0.0
    }
}

// Calculate apoapsis altitude (highest point)
fn apoapsis(body:Body state:State -- alt:f64) {
    -> state -> body
    body state orbital_energy -> energy

    energy 0.0 >= if {
        // Escape trajectory - no apoapsis
        -1.0
    } else {
        body energy semi_major_axis -> a
        body state eccentricity -> e
        // ra = a * (1 + e)
        a 1.0 e + * body @radius -
    }
}

// Calculate periapsis altitude (lowest point)
fn periapsis(body:Body state:State -- alt:f64) {
    -> state -> body
    body state orbital_energy -> energy

    energy 0.0 >= if {
        // Escape trajectory - periapsis is current closest approach
        state @py
    } else {
        body energy semi_major_axis -> a
        body state eccentricity -> e
        // rp = a * (1 - e)
        a 1.0 e - * body @radius -
    }
}

// Orbital period (seconds)
fn orbital_period(body:Body state:State -- t:f64) {
    -> state -> body
    body state orbital_energy -> energy

    energy 0.0 >= if {
        // Escape trajectory - no period
        -1.0
    } else {
        body energy semi_major_axis -> a
        G body @mass * -> mu
        // T = 2π * sqrt(a³/μ)
        2.0 PI * a a * a * mu / math::sqrt *
    }
}
