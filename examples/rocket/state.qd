// Simulation state with 3D vectors
// (uses directory-based namespace - no explicit local imports needed)
use math

struct State {
	t:     f64
	pos:   math::Vec3
	vel:   math::Vec3
	mass:  f64
	fuel:  f64
	pitch: f64
}

pub fn altitude(state:State -- alt:f64) {
	state @pos -> p
	p length EarthRadius -
}

pub fn speed(state:State -- spd:f64) {
	state @vel -> v
	v length
}

pub fn pos_magnitude(state:State -- r:f64) {
	state @pos -> p
	p length
}
