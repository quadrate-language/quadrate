use signal
use time

fn main() {
	signal::SIGINT signal::trap
	"Press Ctrl+C to exit gracefully..." print nl
	nl

	0 -> count
	loop {
		signal::SIGINT signal::pending if {
			nl
			"Caught Ctrl+C! Shutting down gracefully." print nl
			"Goodbye!" print nl
			break
		}

		count 1 + -> count
		"Working... [" print count print "]" print nl

		time::Second time::sleep
	}
}
